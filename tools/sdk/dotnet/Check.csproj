<Project Sdk="Microsoft.NET.Sdk">
  <!-- The AWS SDK for .NET against `cosmostore serve` (M3 SDK matrix): tools/sdk/dotnet.sh runs Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.Extensions.CrtIntegration" Version="4.0.100.24" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.11" />
  </ItemGroup>
</Project>
