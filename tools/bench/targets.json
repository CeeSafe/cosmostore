{
  "machine": "reference machine: Apple M1, internal SSD with F_FULLFSYNC, loopback (docs/targets.md)",
  "baseline": "../../docs/benchmarks/2026-11-09-baseline.json",
  "matrix": [
    { "target": "T1", "what": "tiny PUT at concurrency 32 ≥ 3,000 ops/s", "ops": ["put"], "sizes": [0, 128, 1024, 4096], "concurrency": 32, "min": { "opsPerSec": 3000 } },
    { "target": "T2", "what": "≤ 70 syncs per 1,000 tiny PUTs at concurrency 32", "ops": ["put"], "sizes": [0, 128, 1024, 4096], "concurrency": 32, "max": { "syncsPer1kOps": 70 } },
    { "target": "T3", "what": "tiny PUT p99 at concurrency 32 ≤ 25 ms", "ops": ["put"], "sizes": [0, 128, 1024, 4096], "concurrency": 32, "max": { "p99ms": 25 } },
    { "target": "T4", "what": "tiny PUT at concurrency 1 no worse than the baseline", "ops": ["put"], "sizes": [0, 128, 1024, 4096], "concurrency": 1, "notBelowBaseline": ["opsPerSec"] },
    { "target": "T5", "what": "tiny GET at concurrency 32 ≥ 15,000 ops/s, p99 ≤ 5 ms", "ops": ["get"], "sizes": [128, 1024, 4096], "concurrency": 32, "min": { "opsPerSec": 15000 }, "max": { "p99ms": 5 } },
    { "target": "T6", "what": "HEAD at concurrency 32 ≥ 20,000 ops/s", "ops": ["head"], "concurrency": 32, "min": { "opsPerSec": 20000 } },
    { "target": "T7", "what": "p99.9 ≤ 50 ms for small objects at concurrency 8", "ops": ["put", "get", "head", "overwrite", "delete"], "maxSize": 65536, "concurrency": 8, "max": { "p999ms": 50 } },
    { "target": "T8", "what": "1 MiB at concurrency 32 not below the baseline", "ops": ["put", "get"], "sizes": [1048576], "concurrency": 32, "notBelowBaseline": ["mibPerSec"] },
    { "target": "T12", "what": "write amplification for small objects ≤ 1.2, over the run", "ops": ["put", "overwrite"], "sizes": [1024, 4096, 16384, 65536], "weightedMax": { "writeAmplification": 1.2 } }
  ],
  "scale": { "maxBytesPerObject": 400, "maxGrowth": 0.02, "maxListP99ms": 20, "maxRecoverySeconds": 3 }
}
