// Bucket replication (ADR-0077): the configuration's XML and which events a rule takes.
import web_core;
import web_transport;
import web_http;
import web_server;

@test
fn replicationConfigurationXml() -> Result<void, TestFailure> {
    let xml =
        "<ReplicationConfiguration><Role>arn:aws:iam::1:role/r</Role><Rule><ID>logs</ID><Priority>2</Priority><Filter><Prefix>logs/</Prefix></Filter><Status>Enabled</Status><Destination><Bucket>arn:aws:s3:::backup</Bucket></Destination><DeleteMarkerReplication><Status>Disabled</Status></DeleteMarkerReplication></Rule><Rule><ID>all</ID><Priority>1</Priority><Filter><Prefix></Prefix></Filter><Status>Disabled</Status><Destination><Bucket>arn:aws:s3:::other</Bucket></Destination><DeleteMarkerReplication><Status>Enabled</Status></DeleteMarkerReplication></Rule></ReplicationConfiguration>";
    let rules = parseReplication(xml.bytes())!;
    Check.equalU64(2, rules.length as u64)?;
    Check.equalBytes("backup".bytes(), rules[0].destination.view())?;
    Check.isTrue(rules[0].enabled && !rules[0].deleteMarkers, "the first rule")?;
    Check.isTrue(!rules[1].enabled && rules[1].deleteMarkers, "the second rule")?;
    var stored = Vector<u8>.create();
    encodeReplication(rules.view(), mut stored)!;
    let back = decodeReplication(stored.view())!;
    var out = Vector<u8>.create();
    replicationXml(back.view(), mut out)!;
    let again = parseReplication(out.view())!;
    Check.equalBytes("logs/".bytes(), again[0].prefix.view())?;
    Check.equalU64(2, again[0].priority as u64)?;
    // What a rule takes: new objects and uploads under its prefix; markers if it says so; never a removal.
    Check.isTrue(replicationTakes(borrow back[0], EVENT_PUT, "logs/a".bytes()), "a put")?;
    Check.isTrue(replicationTakes(borrow back[0], EVENT_COMPLETE, "logs/a".bytes()), "an upload")?;
    Check.isTrue(!replicationTakes(borrow back[0], EVENT_PUT, "img/a".bytes()), "another prefix")?;
    Check.isTrue(!replicationTakes(borrow back[0], EVENT_MARKER, "logs/a".bytes()), "no markers")?;
    Check.isTrue(!replicationTakes(borrow back[0], EVENT_DELETE, "logs/a".bytes()), "no removals")?;
    Check.isTrue(!replicationTakes(borrow back[1], EVENT_PUT, "x".bytes()), "disabled")?;
    let target = replicationTarget("backup".bytes())!;
    Check.isTrue(isReplicationTarget(target.view()) && !isReplicationTarget("hook".bytes()), "targets")?;
    // Tags and existing objects are NotImplemented; a rule needs a destination ARN.
    Check.isTrue(
        parseReplication(
            "<ReplicationConfiguration><Rule><Status>Enabled</Status><Filter><Tag><Key>a</Key><Value>b</Value></Tag></Filter><Destination><Bucket>arn:aws:s3:::b</Bucket></Destination></Rule></ReplicationConfiguration>".bytes(),
        ).isErr(),
        "tags",
    )?;
    Check.isTrue(
        parseReplication(
            "<ReplicationConfiguration><Rule><Status>Enabled</Status><Destination><Bucket>b</Bucket></Destination></Rule></ReplicationConfiguration>".bytes(),
        ).isErr(),
        "no ARN",
    )?;
    return Ok();
}

@test
fn replicationToOtherEndpoints() -> Result<void, TestFailure> {
    let file =
        "# id url access secret [region]\nbackup https://s3.example.com/ AKIAX secret/key eu-west-1\nlocal http://127.0.0.1:9001 a b\n";
    let targets = parseReplicationTargets(file.bytes())!!;
    Check.equalU64(2, targets.length as u64)?;
    Check.equalBytes("https://s3.example.com".bytes(), targets[0].url.view())?;
    Check.equalBytes("eu-west-1".bytes(), targets[0].region.view())?;
    Check.equalBytes("us-east-1".bytes(), targets[1].region.view())?;
    Check.isTrue(parseReplicationTargets("x ftp://h a b".bytes())!.isNull(), "a scheme")?;
    Check.isTrue(parseReplicationTargets("x http://h a".bytes())!.isNull(), "no secret")?;
    Check.isTrue(parseReplicationTargets("x http://h a b\nx http://h a b".bytes())!.isNull(), "an id twice")?;
    // A remote destination's ARN, kept as `<target>:<bucket>` and given back.
    let xml =
        "<ReplicationConfiguration><Rule><Status>Enabled</Status><Destination><Bucket>arn:cosmostore:s3::backup:photos</Bucket></Destination></Rule></ReplicationConfiguration>";
    let rules = parseReplication(xml.bytes())!;
    Check.equalBytes("backup:photos".bytes(), rules[0].destination.view())?;
    Check.isTrue(isRemoteDestination(rules[0].destination.view()) && !isRemoteDestination("photos".bytes()), "remote")?;
    var out = Vector<u8>.create();
    replicationXml(rules.view(), mut out)!;
    Check.isTrue(findBytes(out.view(), "arn:cosmostore:s3::backup:photos".bytes(), 0).isSome(), "given back")?;
    Check.isTrue(
        parseReplication(
            "<ReplicationConfiguration><Rule><Status>Enabled</Status><Destination><Bucket>arn:cosmostore:s3::backup</Bucket></Destination></Rule></ReplicationConfiguration>".bytes(),
        ).isErr(),
        "no bucket",
    )?;
    // Failures: noted once each, the newest kept.
    var a = Vector<u8>.create();
    failuresWith("".bytes(), "k".bytes(), [1u8; 16], mut a)!;
    var b = Vector<u8>.create();
    failuresWith(a.view(), "k".bytes(), [1u8; 16], mut b)!;
    Check.equalBytes(a.view(), b.view())?;
    Check.isTrue(
        failuresHave(b.view(), "k".bytes(), [1u8; 16]) && !failuresHave(b.view(), "k".bytes(), [2u8; 16]),
        "have",
    )?;
    Check.isTrue(isFailuresValue(b.view()) && !isFailuresValue(b.view()[0..b.length - 1]), "valid")?;
    var many = Vector<u8>.create();
    for (i in 0..1005) {
        var id = [0u8; 16];
        id[0] = truncate<u8>(i);
        id[1] = truncate<u8>(i / 256);
        var next = Vector<u8>.create();
        failuresWith(many.view(), "k".bytes(), id, mut next)!;
        many = next;
    }
    Check.equalU64(1000, many.view().readLE<u16>(1) as u64)?;
    Check.isTrue(!failuresHave(many.view(), "k".bytes(), [0u8; 16]), "the oldest dropped")?;
    return Ok();
}

fn ruleXml(
    id: StringView,
    priority: StringView,
    prefix: StringView,
    markers: StringView,
    destination: StringView,
) -> String {
    var x = textOf("<Rule><ID>");
    let _ = x.append(id);
    let _ = x.append("</ID><Priority>");
    let _ = x.append(priority);
    let _ = x.append("</Priority><Filter><Prefix>");
    let _ = x.append(prefix);
    let _ = x.append("</Prefix></Filter><Status>Enabled</Status><DeleteMarkerReplication><Status>");
    let _ = x.append(markers);
    let _ = x.append("</Status></DeleteMarkerReplication><Destination><Bucket>arn:aws:s3:::");
    let _ = x.append(destination);
    let _ = x.append("</Bucket></Destination></Rule>");
    return x;
}

fn configOf(rules: Slice<StringView>) -> String {
    var x = textOf("<ReplicationConfiguration><Role>r</Role>");
    for (r in rules) { let _ = x.append(r); }
    let _ = x.append("</ReplicationConfiguration>");
    return x;
}

/// A3 of the M7 review: at one destination the highest-priority rule that takes a key decides, its delete-marker
/// setting too; two rules of one given priority are refused; A2: a storage class other than STANDARD is refused, and
/// a delete-marker status is Enabled or Disabled.
@test
fn replicationRulePriorities() -> Result<void, TestFailure> {
    let low = ruleXml("all", "1", "", "Enabled", "backup");
    let high = ruleXml("logs", "5", "logs/", "Disabled", "backup");
    let elsewhere = ruleXml("copy", "3", "", "Enabled", "other");
    let config = configOf([low.view(), high.view(), elsewhere.view()][..]);
    let rules = parseReplication(config.view().bytes())!;
    // logs/a: rule "logs" (5) decides for backup, so no marker goes there; "copy" still decides for other.
    Check.isTrue(!replicationRuleDecides(rules.view(), 0, "logs/a".bytes()), "the lower rule, under logs/")?;
    Check.isTrue(replicationRuleDecides(rules.view(), 1, "logs/a".bytes()), "the higher rule")?;
    Check.isTrue(!replicationTakes(borrow rules[1], EVENT_MARKER, "logs/a".bytes()), "its markers off")?;
    Check.isTrue(replicationRuleDecides(rules.view(), 2, "logs/a".bytes()), "another destination's rule")?;
    // img/a: only "all" takes it at backup.
    Check.isTrue(replicationRuleDecides(rules.view(), 0, "img/a".bytes()), "the lower rule, elsewhere")?;
    Check.isTrue(!replicationRuleDecides(rules.view(), 1, "img/a".bytes()), "a rule that does not take it")?;
    let twice = ruleXml("again", "5", "x/", "Enabled", "third");
    Check.isTrue(
        parseReplication(configOf([high.view(), twice.view()][..]).view().bytes()).isErr(),
        "a priority twice",
    )?;
    let typo = ruleXml("t", "1", "", "Enabeld", "backup");
    Check.isTrue(parseReplication(configOf([typo.view()][..]).view().bytes()).isErr(), "a marker status typo")?;
    let huge = ruleXml("h", "4294967296", "", "Enabled", "backup");
    Check.isTrue(parseReplication(configOf([huge.view()][..]).view().bytes()).isErr(), "a priority past u32")?;
    let glacier =
        "<ReplicationConfiguration><Rule><Status>Enabled</Status><Destination><Bucket>arn:aws:s3:::b</Bucket><StorageClass>PLATINUM</StorageClass></Destination></Rule></ReplicationConfiguration>";
    Check.isTrue(parseReplication(glacier.bytes()).isErr(), "a class not kept here")?;
    let standard =
        "<ReplicationConfiguration><Rule><Status>Enabled</Status><Destination><Bucket>arn:aws:s3:::b</Bucket><StorageClass>STANDARD</StorageClass></Destination></Rule></ReplicationConfiguration>";
    Check.isTrue(parseReplication(standard.bytes()).isOk(), "STANDARD")?;
    return Ok();
}

/// A rule's elements in any order: the Go SDK writes them alphabetically, the rule's Status after
/// DeleteMarkerReplication's (found by the SDK matrix, 18 Nov 2026).
@test
fn replicationRuleInAnyOrder() -> Result<void, TestFailure> {
    let alphabetical =
        "<ReplicationConfiguration xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><Role>arn:aws:iam::000000000000:role/r</Role><Rule><DeleteMarkerReplication><Status>Enabled</Status></DeleteMarkerReplication><Destination><Bucket>arn:aws:s3:::d</Bucket></Destination><Filter><Prefix>p/</Prefix></Filter><ID>all</ID><Priority>1</Priority><Status>Disabled</Status></Rule></ReplicationConfiguration>";
    let rules = parseReplication(alphabetical.bytes())!;
    Check.isFalse(rules[0].enabled, "the rule's own Status, after the marker's")?;
    Check.isTrue(rules[0].deleteMarkers, "the marker's Status")?;
    Check.equalBytes("p/".bytes(), rules[0].prefix.view())?;
    let unclosed =
        "<ReplicationConfiguration><Rule><DeleteMarkerReplication><Status>Enabled</Status><Status>Enabled</Status><Destination><Bucket>arn:aws:s3:::d</Bucket></Destination></Rule></ReplicationConfiguration>";
    return Check.isTrue(parseReplication(unclosed.bytes()).isErr(), "an unclosed DeleteMarkerReplication");
}
