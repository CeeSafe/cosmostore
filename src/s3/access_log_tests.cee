// Server access logs (ADR-0072): the configuration's XML, a request's line, the operation names, a log object's key.
import web_core;
import web_transport;
import web_http;
import web_server;

@test
fn loggingConfigurationXml() -> Result<void, TestFailure> {
    let on =
        "<BucketLoggingStatus xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><LoggingEnabled><TargetBucket>logs</TargetBucket><TargetPrefix>web/</TargetPrefix></LoggingEnabled></BucketLoggingStatus>";
    let t = parseLogging(on.bytes())!!;
    Check.equalBytes("logs".bytes(), t.bucket.view())?;
    Check.equalBytes("web/".bytes(), t.prefix.view())?;
    // Stored and read back.
    var stored = Vector<u8>.create();
    encodeLogging(borrow t, mut stored)!;
    let back = decodeLogging(stored.view())!;
    Check.equalBytes("web/".bytes(), back.prefix.view())?;
    var xml = Vector<u8>.create();
    let some: LoggingTarget? = Some(back);
    loggingXml(borrow some, mut xml)!;
    Check.isTrue(
        findBytes(xml.view(), "<TargetBucket>logs</TargetBucket><TargetPrefix>web/</TargetPrefix>".bytes(), 0).isSome(),
        "written back",
    )?;
    // Off: no LoggingEnabled.
    Check.isTrue(parseLogging("<BucketLoggingStatus/>".bytes())!.isNull(), "off")?;
    // Grants and partitioned keys are NotImplemented, a document without its element MalformedXML.
    let grants =
        "<BucketLoggingStatus><LoggingEnabled><TargetBucket>l</TargetBucket><TargetGrants></TargetGrants></LoggingEnabled></BucketLoggingStatus>";
    Check.isTrue(parseLogging(grants.bytes()).isErr(), "grants")?;
    Check.isTrue(parseLogging("<Other/>".bytes()).isErr(), "not one")?;
    Check.isTrue(decodeLogging("".bytes()).isNull() && isLoggingValue("".bytes()), "none")?;
    return Ok();
}

fn operationOf(method: StringView, hasKey: bool, query: StringView) -> Vector<u8> {
    var out = Vector<u8>.create();
    appendOperation(mut out, method.bytes(), hasKey, query.bytes())!;
    return out;
}

@test
fn accessLogLineFormat() -> Result<void, TestFailure> {
    Check.equalBytes("REST.GET.OBJECT".bytes(), operationOf("GET", true, "").view())?;
    Check.equalBytes("REST.GET.BUCKET".bytes(), operationOf("GET", false, "list-type=2&prefix=a").view())?;
    Check.equalBytes("REST.PUT.LOGGING_STATUS".bytes(), operationOf("PUT", false, "logging").view())?;
    Check.equalBytes("REST.GET.OBJECT_TAGGING".bytes(), operationOf("GET", true, "tagging").view())?;
    Check.equalBytes("REST.POST.UPLOADS".bytes(), operationOf("POST", true, "uploads").view())?;
    Check.equalBytes("REST.PUT.OBJECT_LEGAL_HOLD".bytes(), operationOf("PUT", true, "legal-hold").view())?;
    var facts = AuditFacts {
        access: AccessFacts {
            bucket: copyBytes("site".bytes())!,
            key: copyBytes("a b.txt".bytes())!,
            referrer: Vector<u8>.create(),
            userAgent: copyBytes("aws-cli/2.15 \"x\"".bytes())!,
            host: copyBytes("127.0.0.1:9000".bytes())!,
            authType: ACCESS_AUTH_QUERY,
            tables: false,
            operation: Vector<u8>.create(),
            tableArn: Vector<u8>.create(),
            nsName: Vector<u8>.create(),
            tableName: Vector<u8>.create(),
            errorName: Vector<u8>.create(),
        },
        requester: copyBytes("AKIAEXAMPLE".bytes())!,
        code: Some(S3Code.NoSuchKey),
        aborted: false,
    };
    var line = Vector<u8>.create();
    accessLogLine(
        mut line,
        1549411238000, // 06 Feb 2019 00:00:38 UTC
        borrow facts.access,
        borrow facts,
        SocketAddress.V4([192u8, 0, 2, 3], 5555),
        "3E57427F3E".bytes(),
        "GET".bytes(),
        "/site/a%20b.txt".bytes(),
        "versionId=1&X-Amz-Signature=secret".bytes(),
        404,
        7300,
    )!;
    Check.equalBytes(
        "cosmostore site [06/Feb/2019:00:00:38 +0000] 192.0.2.3 AKIAEXAMPLE 3E57427F3E REST.GET.OBJECT a%20b.txt \"GET /site/a%20b.txt?versionId&X-Amz-Signature HTTP/1.1\" 404 NoSuchKey - - 7 - \"-\" \"aws-cli/2.15%20%22x%22\" - - SigV4 - QueryString 127.0.0.1:9000 - - -\n".bytes(),
        line.view(),
    )?;
    // A log object's key: the prefix, the time, a random part.
    var key = Vector<u8>.create();
    logObjectKey("web/".bytes(), 1549411238000, mut key)!;
    Check.isTrue(startsWithBytes(key.view(), "web/2019-02-06-00-00-38-".bytes()) && key.length == 24 + 16, "key")?;
    return Ok();
}

/// Partitioned log keys (ADR-0130 §3): S3's `PartitionedPrefix` taken and answered; the configuration kept with its
/// format; a batch's key `<prefix><account>/<region>/<source>/YYYY/MM/DD/YYYY-MM-DD-hh-mm-ss-<random>`, dated by its
/// first line or by its delivery.
@test
fn partitionedLogKeys() -> Result<void, TestFailure> {
    let xml =
        "<BucketLoggingStatus><LoggingEnabled><TargetBucket>logs</TargetBucket><TargetPrefix>in/</TargetPrefix><TargetObjectKeyFormat><PartitionedPrefix PartitionDateSource=\"DeliveryTime\"/></TargetObjectKeyFormat></LoggingEnabled></BucketLoggingStatus>";
    let t = parseLogging(xml.bytes())!!;
    Check.equalU64(LOG_KEYS_DELIVERY_TIME as u64, t.keys as u64)?;
    var answered = Vector<u8>.create();
    loggingXml(borrow Some(cloneTarget(borrow t)), mut answered)!;
    Check.isTrue(findBytes(answered.view(), "PartitionDateSource=\"DeliveryTime\"".bytes(), 0).isSome(), "answered")?;
    let plain = parseLogging(
        "<BucketLoggingStatus><LoggingEnabled><TargetBucket>logs</TargetBucket><TargetObjectKeyFormat><PartitionedPrefix/></TargetObjectKeyFormat></LoggingEnabled></BucketLoggingStatus>".bytes(),
    )!!;
    Check.equalU64(LOG_KEYS_EVENT_TIME as u64, plain.keys as u64)?;
    // Kept (version 3), with an empty requester or one.
    for (who in ["", "user AIDA1"]) {
        var kept = cloneTarget(borrow t);
        kept.requester = copyBytes(who.bytes())!;
        var blob = Vector<u8>.create();
        encodeLogging(borrow kept, mut blob)!;
        Check.equalU64(3, blob[0] as u64)?;
        let back = decodeLogging(blob.view())!;
        Check.equalBytes(who.bytes(), back.requester.view())?;
        Check.equalU64(LOG_KEYS_DELIVERY_TIME as u64, back.keys as u64)?;
    }
    // The keys: 2019-02-06 00:00:38 for the first line, 2019-03-01 12:00:00 at delivery.
    for (keys in [LOG_KEYS_EVENT_TIME, LOG_KEYS_DELIVERY_TIME]) {
        let batch = AccessLogBatch {
            target: copyBytes("logs".bytes())!,
            prefix: copyBytes("in/".bytes())!,
            bytes: Vector<u8>.create(),
            since: 1549411238000,
            requester: Vector<u8>.create(),
            source: copyBytes("lake".bytes())!,
            keys: keys,
        };
        var key = Vector<u8>.create();
        batchKey(borrow batch, 1551441600000, mut key)!;
        let want = if (keys == LOG_KEYS_EVENT_TIME) "in/000000000000/us-east-1/lake/2019/02/06/2019-02-06-00-00-38-"
            else "in/000000000000/us-east-1/lake/2019/03/01/2019-03-01-12-00-00-";
        Check.isTrue(startsWithBytes(key.view(), want.bytes()), "a partitioned key")?;
        Check.equalU64((want.length + 16) as u64, key.length as u64)?;
    }
    return Ok();
}

fn cloneTarget(t: borrow LoggingTarget) -> LoggingTarget => LoggingTarget {
    bucket: copyBytes(t.bucket.view())!,
    prefix: copyBytes(t.prefix.view())!,
    requester: copyBytes(t.requester.view())!,
    keys: t.keys,
};

/// PutTableBucketLogging's body (ADR-0130 §1): partitioned only (EventTime by default), a general purpose target;
/// `{}` turns it off.
@test
fn tableLoggingBodies() -> Result<void, TestFailure> {
    let on = tableLoggingTargetOf(
        "{\"tableBucketLoggingStatus\":{\"loggingEnabled\":{\"targetBucket\":\"logs\",\"targetPrefix\":\"t/\"}}}".bytes(),
    )!!;
    Check.equalU64(LOG_KEYS_EVENT_TIME as u64, on.keys as u64)?;
    Check.equalBytes("t/".bytes(), on.prefix.view())?;
    let delivery = tableLoggingTargetOf(
        "{\"tableBucketLoggingStatus\":{\"loggingEnabled\":{\"targetBucket\":\"logs\",\"targetObjectKeyFormat\":{\"partitionedPrefix\":{\"partitionDateSource\":\"DeliveryTime\"}}}}}".bytes(),
    )!!;
    Check.equalU64(LOG_KEYS_DELIVERY_TIME as u64, delivery.keys as u64)?;
    Check.isTrue(tableLoggingTargetOf("{\"tableBucketLoggingStatus\":{}}".bytes())!.isNull(), "off")?;
    for (body in [
        "{}",
        "{\"tableBucketLoggingStatus\":{\"loggingEnabled\":{\"targetBucket\":\"logs\",\"targetObjectKeyFormat\":{\"simplePrefix\":{}}}}}",
        "{\"tableBucketLoggingStatus\":{\"loggingEnabled\":{\"targetBucket\":\"lake--table-s3\"}}}",
        "{\"tableBucketLoggingStatus\":{\"loggingEnabled\":{\"targetBucket\":\"d--usw2-az1--x-s3\"}}}",
        "{\"tableBucketLoggingStatus\":{\"loggingEnabled\":{\"targetBucket\":\"\"}}}",
        "{\"tableBucketLoggingStatus\":{\"loggingEnabled\":{\"targetBucket\":\"logs\",\"targetObjectKeyFormat\":{\"partitionedPrefix\":{\"partitionDateSource\":\"Never\"}}}}}",
    ]) {
        match (tableLoggingTargetOf(body.bytes())) {
            Err(TablesError.BadRequest) => {}
            _ => { return Err(TestFailure.create("refused")); }
        }
    }
    return Ok();
}

fn tablesFacts(tables: bool, key: StringView, operation: StringView, error: StringView) -> AuditFacts => AuditFacts {
    access: AccessFacts {
        bucket: copyBytes("lake--table-s3".bytes())!,
        key: copyBytes(key.bytes())!,
        referrer: Vector<u8>.create(),
        userAgent: copyBytes("aws-cli/2.34".bytes())!,
        host: copyBytes("127.0.0.1:9000".bytes())!,
        authType: ACCESS_AUTH_HEADER,
        tables: tables,
        operation: copyBytes(operation.bytes())!,
        tableArn: if (tables) copyBytes(
            "arn:aws:s3tables:us-east-1:000000000000:bucket/lake/table/c0c0c0c0-1111-4222-8333-444444444444".bytes(),
        )! else Vector<u8>.create(),
        nsName: copyBytes((if (tables) "sales" else "").bytes())!,
        tableName: copyBytes((if (tables) "orders" else "").bytes())!,
        errorName: copyBytes(error.bytes())!,
    },
    requester: copyBytes("AKIAEXAMPLE".bytes())!,
    code: null,
    aborted: false,
};

/// A table bucket's log records (ADR-0130 §2): AWS's 25 fields, for an S3 Tables call and for its warehouse's object
/// request (its table its key's id's, its namespace and name `-`).
@test
fn tableLogRecords() -> Result<void, TestFailure> {
    let call = tablesFacts(true, "", "S3Tables.GetTable", "NotFoundException");
    var line = Vector<u8>.create();
    tablesLogLine(
        mut line,
        1549411238000,
        borrow call.access,
        borrow call,
        null,
        "3E57427F3E".bytes(),
        "GET".bytes(),
        "".bytes(),
        404,
        7300,
    )!;
    Check.equalBytes(
        "arn:aws:s3tables:us-east-1:000000000000:bucket/lake [06/Feb/2019:00:00:38 +0000] arn:aws:s3tables:us-east-1:000000000000:bucket/lake/table/c0c0c0c0-1111-4222-8333-444444444444 sales orders - - - AKIAEXAMPLE 3E57427F3E S3Tables.GetTable 404 NotFoundException - 7 - \"-\" \"aws-cli/2.34\" SigV4 - AuthHeader 127.0.0.1:9000 - 2019-02-06T00:00:38.000Z us-east-1\n".bytes(),
        line.view(),
    )?;
    let data = tablesFacts(false, "c0c0c0c0-1111-4222-8333-444444444444/data/a.parquet", "", "");
    var dataLine = Vector<u8>.create();
    tablesLogLine(
        mut dataLine,
        1549411238000,
        borrow data.access,
        borrow data,
        null,
        "3E57427F3F".bytes(),
        "GET".bytes(),
        "".bytes(),
        200,
        2000,
    )!;
    Check.equalBytes(
        "arn:aws:s3tables:us-east-1:000000000000:bucket/lake [06/Feb/2019:00:00:38 +0000] arn:aws:s3tables:us-east-1:000000000000:bucket/lake/table/c0c0c0c0-1111-4222-8333-444444444444 - - c0c0c0c0-1111-4222-8333-444444444444/data/a.parquet - - AKIAEXAMPLE 3E57427F3F REST.GET.OBJECT 200 - - 2 - \"-\" \"aws-cli/2.34\" SigV4 - AuthHeader 127.0.0.1:9000 - 2019-02-06T00:00:38.000Z us-east-1\n".bytes(),
        dataLine.view(),
    )?;
    return Ok();
}
