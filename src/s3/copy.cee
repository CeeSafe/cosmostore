// CopyObject and UploadPartCopy (ADR-0010). The source is read through a pinned reader and written to a new writer,
// a step at a time on worker threads without the store's lock, so a copy is a GET and a PUT that never leave the
// server. Only the plan (source, conditions, admission) and the commit take the lock.
import web_core;
import web_http;
import web_server;

/// `x-amz-copy-source`: `bucket/key` or `/bucket/key`, URL-encoded, with an optional `?versionId=` naming the
/// version to copy (ADR-0041).
struct CopySource {
    bucket: String;
    key: String;
    versionId: [u8; 16]?;
}

fn copySourceOf(req: borrow S3Request) -> Result<CopySource, S3Fail> {
    let raw = headerOf(req, "x-amz-copy-source") ?? "".bytes();
    var end = raw.length;
    var versionId: [u8; 16]? = null;
    match (findBytes(raw, "?".bytes(), 0)) {
        Some(q) => {
            end = q;
            let name = "?versionId=".bytes();
            let rest = raw[q..];
            if (rest.length < name.length || rest[0..name.length] != name) {
                return Err(S3Fail.Code(S3Code.InvalidArgument));
            }
            versionId = match (parseVersionId(rest[name.length..])) {
                Some(id) => id,
                null => { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            };
        }
        null => {}
    }
    var decoded = Vector<u8>.create();
    if (!percentDecodeInto(mut decoded, raw[0..end], false)?) { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
    let path = if (decoded.length > 0 && decoded[0] == '/') decoded.view()[1..] else decoded.view();
    let slash = pieceEnd(path, 0, '/');
    if (slash == 0 || slash + 1 >= path.length) { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
    var bucket = String.create();
    var key = String.create();
    appendUtf8(mut bucket, path[0..slash])?;
    appendUtf8(mut key, path[slash + 1..])?;
    if (key.length > MAX_KEY_BYTES) { return Err(S3Fail.Code(S3Code.KeyTooLongError)); }
    return Ok(CopySource { bucket: bucket, key: key, versionId: versionId });
}

/// The `x-amz-copy-source-if-*` conditions. Every failure is PreconditionFailed, as S3 answers for a copy.
fn checkCopyConditions(req: borrow S3Request, info: borrow ObjectInfo, directory: bool) -> Result<void, S3Code> {
    return match (checkConditions(
        req,
        info,
        directory,
        "x-amz-copy-source-if-match",
        "x-amz-copy-source-if-unmodified-since",
        "x-amz-copy-source-if-none-match",
        "x-amz-copy-source-if-modified-since",
    )) {
        Ok() => Ok(),
        Err(_) => Err(S3Code.PreconditionFailed),
    };
}

/// `x-amz-copy-source-range: bytes=first-last`, both given: InvalidArgument if it does not read so, InvalidRange if
/// it is not within a source of `size` bytes, as S3 answers.
fn parseCopyRange(text: Slice<u8>, size: u64) -> Result<RangeSpan, S3Code> {
    let t = trimSpaces(text);
    let unit = "bytes=".bytes();
    if (t.length <= unit.length || t[0..unit.length] != unit) { return Err(S3Code.InvalidArgument); }
    let spec = t[unit.length..];
    let dash = pieceEnd(spec, 0, '-');
    if (dash == 0 || dash + 1 >= spec.length) { return Err(S3Code.InvalidArgument); }
    let first = parseDecimal(spec[0..dash]);
    let last = parseDecimal(spec[dash + 1..]);
    if (first.isNull() || last.isNull()) { return Err(S3Code.InvalidArgument); }
    let a = first ?? 0;
    let b = last ?? 0;
    if (a > b) { return Err(S3Code.InvalidArgument); }
    if (b >= size) { return Err(S3Code.InvalidRange); }
    return Ok(RangeSpan { from: a, to: b + 1 });
}

/// Where a copy goes: a new version of a key, or a part of an upload.
enum CopyTarget {
    Object,
    Part(u32),
}

/// What a copy will do, decided under the lock.
struct CopyPlan {
    source: ObjectInfo;
    reader: ObjectReader?;
    writer: ObjectWriter;
    size: u64;
    /// The checksum the copy gets (ADR-0015).
    algorithm: ChecksumAlgorithm;
    /// A sealed source (ADR-0046 §3): its envelope, the stored range read, and its first part's salt when that range
    /// starts after the part's header.
    sourceEnvelope: Vector<u8>;
    sse: SseRange?;
    salt: Vector<u8>;
    /// UploadPartCopy into a sealed upload: the upload's envelope; empty otherwise.
    uploadEnvelope: Vector<u8>;
}

/// A finished copy and its checksum, raw.
struct CopyResult {
    finished: FinishedObject;
    algorithm: ChecksumAlgorithm;
    checksum: Vector<u8>;
}

/// Under the lock: the source exists and meets its conditions, the range is in it, the size is admitted at the
/// destination (whose bucket, or upload, exists), and a reader that pins the source's extents.
fn planCopy(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    src: borrow CopySource,
    target: CopyTarget,
    uploadId: [u8; 16],
) -> Result<CopyPlan, S3Fail> {
    let info = match (store.headObjectOf(src.bucket.view(), src.key.view(), src.versionId)) {
        Ok(i) => i,
        Err(e) => { return Err(storeFail(e, src.key.length)); }
    };
    match (checkCopyConditions(req, borrow info, inDirectoryBucket(src.bucket.view()))) {
        Ok() => {}
        Err(code) => { return Err(S3Fail.Code(code)); }
    }
    var start: u64 = 0;
    var end = info.size;
    match (target) {
        CopyTarget.Part(_) => {
            match (headerOf(req, "x-amz-copy-source-range")) {
                Some(t) => {
                    match (parseCopyRange(t, info.size)) {
                        Ok(r) => {
                            start = r.from;
                            end = r.to;
                        }
                        Err(code) => { return Err(S3Fail.Code(code)); }
                    }
                }
                null => {}
            }
        }
        CopyTarget.Object => {}
    }
    let size = end - start;
    if (size > MAX_PUT_BYTES) { return Err(S3Fail.Code(S3Code.InvalidRequest)); }
    let bucket = req.bucket.view();
    let key = req.key.view();
    var uploadEnvelope = Vector<u8>.create();
    match (target) {
        CopyTarget.Part(_) => { uploadEnvelope = store.uploadEnvelope(uploadId)?; }
        CopyTarget.Object => {}
    }
    let made = match (target) {
        CopyTarget.Object => beginPut(store, bucket, size),
        CopyTarget.Part(number) => beginPart(store, bucket, key, uploadId, number, size),
    };
    let writer = match (made) {
        Ok(w) => w,
        Err(e) => { return Err(storeFail(e, key.length)); }
    };
    let extras = match (decodeExtras(info.extras.view())) {
        Ok(e) => e,
        Err(_) => { return Err(S3Fail.Code(S3Code.InternalError)); }
    };
    // A sealed source is read as the whole chunks under its range, and opened (ADR-0046 §2, §3).
    var sourceEnvelope = Vector<u8>.create();
    match (metadataFind(info.metadata.view(), SSE_FIELD.bytes())) {
        Some(f) => { sourceEnvelope.extend(f)?; }
        null => {}
    }
    var sse: SseRange? = null;
    var salt = Vector<u8>.create();
    var reader: ObjectReader? = null;
    if (size > 0) {
        var from = start;
        var to = end;
        if (sourceEnvelope.length > 0) {
            if (info.parts > 0 && extras.partSizes.length == 0) { return Err(S3Fail.Code(S3Code.InternalError)); }
            let r = sseRange(info.size, extras.partSizes.view(), start, end);
            from = r.storedFrom;
            to = r.storedTo;
            match (r.headerAt) {
                Some(at) => {
                    // This runs on a worker thread: the first part's salt is read here.
                    var header = match (store.prepareReaderOf(
                        src.bucket.view(),
                        src.key.view(),
                        src.versionId,
                        at,
                        at + SSE_PART_HEADER,
                    )) {
                        Ok(p) => p,
                        Err(e) => { return Err(storeFail(e, src.key.length)); }
                    };
                    salt = match (readHeader(mut header)) {
                        Ok(b) => b,
                        Err(e) => { return Err(storeFail(e, src.key.length)); }
                    };
                }
                null => {}
            }
            sse = r;
        }
        var prepared = match (store.prepareReaderOf(src.bucket.view(), src.key.view(), src.versionId, from, to)) {
            Ok(p) => p,
            Err(e) => { return Err(storeFail(e, src.key.length)); }
        };
        reader = match (prepared.open()) {
            Ok(r) => r,
            Err(e) => { return Err(storeFail(e, src.key.length)); }
        };
    }
    // A part takes its upload's algorithm. An object takes the one the request names, else the source's (if it is one
    // part), else CRC64NVME, as S3 does.
    var algorithm = ChecksumAlgorithm.Crc64Nvme;
    match (target) {
        CopyTarget.Part(_) => { algorithm = store.uploadAlgorithm(uploadId); }
        CopyTarget.Object => {
            match (headerOf(req, "x-amz-checksum-algorithm")) {
                Some(t) => {
                    algorithm = match (checksumFromName(t)) {
                        Ok(a) => a,
                        Err(code) => { return Err(S3Fail.Code(code)); }
                    };
                }
                null => {
                    match (extras.algorithm) {
                        ChecksumAlgorithm.None => {}
                        _ => {
                            if (extras.partSizes.length == 0) { algorithm = extras.algorithm; }
                        }
                    }
                }
            }
        }
    }
    return Ok(CopyPlan {
        source: info,
        reader: reader,
        writer: writer,
        size: size,
        algorithm: algorithm,
        sourceEnvelope: sourceEnvelope,
        sse: sse,
        salt: salt,
        uploadEnvelope: uploadEnvelope,
    });
}

async fn openCopy(
    app: borrow S3App,
    req: borrow S3Request,
    src: borrow CopySource,
    target: CopyTarget,
    uploadId: [u8; 16],
) -> Result<CopyPlan, S3Fail> {
    var guard = await lockStore(app)?;
    let store = guard.data();
    return await Async.blocking(() => planCopy(store, req, src, target, uploadId));
}

/// How a copy's bytes pass from its source to its destination (ADR-0046 §3): opened when the source is sealed,
/// sealed when the destination is, and hashed as plaintext between.
struct CopyPipe {
    opener: SseStream?;
    sealer: SseSealer?;
    /// Plaintext bytes of the first chunk opened that are before the range, and the plaintext still to give.
    skip: u64;
    left: u64;
    plain: Vector<u8>;
    sealed: Vector<u8>;
    md5: Md5;
}

/// The source's opener for a copy: its data key from the master keys or the copy source's SSE-C key; null for a
/// source in the clear, which takes no key.
async fn sourceOpener(
    app: borrow S3App,
    req: borrow S3Request,
    plan: borrow CopyPlan,
) -> Result<SseStream?, S3Fail> {
    let key = sseCustomerKeyOf(req, true)?;
    if (plan.sourceEnvelope.length == 0) {
        if (key.isSome()) { return Err(S3Fail.Code(S3Code.InvalidRequest)); }
        return Ok(null);
    }
    var dataKey = await sealedDataKey(app, plan.sourceEnvelope.view(), key)?;
    var opener: SseStream? = null;
    match (plan.sse.asBorrow()) {
        Some(r) => {
            opener = if (plan.source.parts == 0) {
                SseStream.single(borrow dataKey, plan.source.size, r.chunk)
            } else {
                let sizes = match (decodeExtras(plan.source.extras.view())) {
                    Ok(e) => e.partSizes,
                    Err(_) => { return Err(S3Fail.Code(S3Code.InternalError)); }
                };
                SseStream.multipart(borrow dataKey, sizes.view()[r.part..], r.chunk, plan.salt.view())?
            };
            if (opener.isNull()) { return Err(S3Fail.Code(S3Code.InternalError)); }
        }
        null => {}
    }
    for (i in 0..32) { dataKey[i] = 0; }
    return Ok(opener);
}

/// One step of a copy, on a worker thread: read from the source, opened if it is sealed, written to the destination,
/// sealed if it is; 0 at the end.
fn copyStep(
    reader: borrow mut ObjectReader,
    writer: borrow mut ObjectWriter,
    sum: borrow mut RunningChecksum,
    pipe: borrow mut CopyPipe,
    buf: SliceMut<u8>,
) -> Result<usize, StoreError> {
    let n = reader.read(buf)?;
    let opening = pipe.opener.isSome();
    if (n == 0) {
        let whole = match (pipe.opener.asBorrow()) {
            Some(o) => o.isWhole(),
            null => true,
        };
        if (!whole) { return Err(StoreError.DataCorrupt); }
        return Ok(0);
    }
    pipe.plain.clear();
    if (opening) {
        let opened = match (pipe.opener.asBorrowMut()) {
            Some(o) => o.feed(buf[0..n], mut pipe.plain)?,
            null => false,
        };
        if (!opened) { return Err(StoreError.DataCorrupt); }
        let from = if (pipe.skip > pipe.plain.length as u64) pipe.plain.length else pipe.skip as usize;
        pipe.skip -= from as u64;
        let have = (pipe.plain.length - from) as u64;
        let take = if (have > pipe.left) pipe.left else have;
        let piece = copyBytes(pipe.plain.view()[from..from + take as usize])?;
        pipe.plain = piece;
    } else {
        pipe.plain.extend(buf[0..n])?;
    }
    let length = pipe.plain.length as u64;
    pipe.left -= if (length > pipe.left) pipe.left else length;
    sum.update(pipe.plain.view());
    pipe.md5.update(pipe.plain.view());
    match (pipe.sealer.asBorrowMut()) {
        Some(s) => {
            pipe.sealed.clear();
            s.feed(pipe.plain.view(), mut pipe.sealed)?;
            sio(writer.write(pipe.sealed.view()))?;
        }
        null => { sio(writer.write(pipe.plain.view()))?; }
    }
    return Ok(n);
}

/// The destination's last chunk, on a worker thread, and the writer finished.
fn finishCopy(writer: borrow mut ObjectWriter, pipe: borrow mut CopyPipe) -> Result<FinishedObject, StoreError> {
    match (pipe.sealer.asBorrowMut()) {
        Some(s) => {
            pipe.sealed.clear();
            s.finish(mut pipe.sealed)?;
            sio(writer.write(pipe.sealed.view()))?;
        }
        null => {}
    }
    return sio(writer.finish());
}

/// Streams the planned bytes into the writer, through `opener` and `sealer`, and finishes it. The reader (and its
/// pins) goes when this returns. The copy's size and MD5 are its plaintext's, except an SSE-C destination's ETag,
/// which is the MD5 of what is stored (ADR-0046 §6).
async fn runCopy(plan: CopyPlan, opener: SseStream?, sealer: SseSealer?) -> Result<CopyResult, S3Fail> {
    var p = plan;
    var writer = p.writer;
    var sum = RunningChecksum.create(p.algorithm);
    let sealing = sealer.isSome();
    var pipe = CopyPipe {
        opener: opener,
        sealer: sealer,
        skip: match (p.sse.asBorrow()) {
            Some(r) => r.skip,
            null => 0,
        },
        left: p.size,
        plain: Vector<u8>.create(),
        sealed: Vector<u8>.create(),
        md5: Md5.create(),
    };
    match (p.reader.asBorrowMut()) {
        Some(reader) => {
            var buf = Vector<u8>.create();
            buf.resize(bodyStep(p.size + SSE_CHUNK), 0)?;
            while (true) {
                let chunk = buf.viewMut();
                let step = await Async.blocking(() => copyStep(reader, mut writer, mut sum, mut pipe, chunk));
                let n = match (step) {
                    Ok(n) => n,
                    Err(e) => { return Err(storeFail(e, 0)); }
                };
                if (n == 0) { break; }
            }
            if (pipe.left != 0) { return Err(S3Fail.Code(S3Code.InternalError)); }
        }
        null => {}
    }
    var finished = match (await Async.blocking(() => finishCopy(mut writer, mut pipe))) {
        Ok(f) => f,
        Err(e) => { return Err(storeFail(e, 0)); }
    };
    if (sealing) {
        finished.size = p.size;
        let md5 = pipe.md5.finish();
        match (pipe.sealer.asBorrow()) {
            Some(s) => { finished.md5 = sealedEtag(s, md5); }
            null => {}
        }
    }
    var checksum = Vector<u8>.create();
    sum.finishInto(mut checksum)?;
    return Ok(CopyResult { finished: finished, algorithm: p.algorithm, checksum: checksum });
}

/// `<CopyObjectResult>` or `<CopyPartResult>`: the new ETag and modification time.
async fn sendCopyResult(
    exchange: borrow mut Exchange,
    element: StringView,
    md5: borrow [u8; 16],
    directory: bool,
    extras: Slice<u8>,
) -> Result<void, S3Fail> {
    var body = Vector<u8>.create();
    xmlHead(mut body, element)?;
    body.extend("<LastModified>".bytes())?;
    appendIso8601(mut body, Clock.unixMillis())?;
    body.extend("</LastModified>".bytes())?;
    xmlEtag(mut body, md5, 0, directory)?;
    xmlChecksum(mut body, extras)?;
    body.extend("</".bytes())?;
    body.extend(element.bytes())?;
    body.extend(">".bytes())?;
    return await sendXml(exchange, borrow body);
}

/// A copy's source is read: `s3:GetObject` (or `s3:GetObjectVersion`) on it, by its own bucket's policy (ADR-0043 §5).
async fn authorizeSource(
    app: borrow S3App,
    req: borrow S3Request,
    who: borrow Requester,
    src: borrow CopySource,
) -> Result<void, S3Fail> {
    // A table bucket's catalog is read by its API only, whatever bucket a copy of it would go to (ADR-0083 §2).
    if (catalogObject(src.bucket.bytes(), src.key.bytes())) { return Err(S3Fail.Code(S3Code.AccessDenied)); }
    // A table's file is its table's data, read by its policies' leave (ADR-0084 §4).
    if (isTableWarehouseShaped(src.bucket.bytes())) {
        let id = match (tableIdOfKey(src.key.bytes(), false)) {
            Some(i) => i,
            null => { return Err(S3Fail.Code(S3Code.AccessDenied)); }
        };
        if (!await tableDataAllowed(app, req, who, "s3tables:GetTableData", src.bucket.bytes(), id)?) {
            return Err(S3Fail.Code(S3Code.AccessDenied));
        }
    }
    let action = if (src.versionId.isSome()) "s3:GetObjectVersion" else "s3:GetObject";
    return await authorizeVersion(app, req, who, action, src.bucket.view(), src.key.view().bytes(), src.versionId);
}

async fn copyObject(
    app: borrow S3App,
    req: borrow S3Request,
    who: borrow Requester,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    // If-Match / If-None-Match on the destination, checked with the commit as for PUT (ADR-0017).
    var etags = Vector<u8>.create();
    let condition = putConditionOf(req, mut etags)?;
    let src = copySourceOf(req)?;
    let replace = match (headerOf(req, "x-amz-metadata-directive")) {
        Some(t) => {
            if (t == "REPLACE".bytes()) {
                true
            } else if (t == "COPY".bytes()) {
                false
            } else {
                return Err(S3Fail.Code(S3Code.InvalidArgument));
            }
        }
        null => false,
    };
    // The destination's encryption: the request's, else the bucket's default (ADR-0046 §3). A copy onto itself may
    // change only that, which is how an object is sealed again under the newest master key.
    let fields = sseRequestOf(req)?;
    let resealing = match (fields) {
        SseRequest.None => false,
        _ => true,
    };
    // A copy's storage class is the request's, STANDARD if it names none, never the source's, as on S3 (ADR-0090 §1).
    let classAsked = headerOf(req, STORAGE_CLASS_FIELD) ?? "".bytes();
    let classStored = classAsked.length > 0 && storesStorageClass(req.bucket.bytes(), classAsked)?;
    // A copy onto itself must change something: its metadata, its encryption or its storage class.
    if (!replace && !resealing && classAsked.length == 0 && src.bucket.view() == req.bucket.view() &&
        src.key.view() == req.key.view()) {
        return Err(S3Fail.Code(S3Code.InvalidRequest));
    }
    await authorizeSource(app, req, who, borrow src)?;
    let plan = await openCopy(app, req, borrow src, CopyTarget.Object, [0u8; 16])?;
    let opener = await sourceOpener(app, req, borrow plan)?;
    let asked = if (resealing) fields else await bucketDefaultSse(app, req.bucket.view())?;
    // The source's version, when its bucket has versioning (ADR-0041).
    if (plan.source.versioned) { versionHeader(exchange, "x-amz-copy-source-version-id", plan.source.versionId)?; }
    var contentType = String.create();
    var metadata = Vector<u8>.create();
    if (replace) {
        contentTypeOf(req, mut contentType)?;
        metadata = metadataOf(req)?;
    } else {
        appendUtf8(mut contentType, plan.source.contentType.view())?;
        metadata.extend(plan.source.metadata.view())?;
    }
    metadata = match (metadataReplace(
        metadata.view(),
        STORAGE_CLASS_FIELD.bytes(),
        if (classStored) classAsked else "".bytes(),
    )) {
        Ok(b) => b,
        Err(_) => { return Err(S3Fail.Code(S3Code.InternalError)); }
    };
    // Tags follow `x-amz-tagging-directive`, apart from the metadata directive: COPY (the default) keeps the source's,
    // REPLACE takes `x-amz-tagging` (ADR-0017).
    let tagsReplaced = match (headerOf(req, "x-amz-tagging-directive")) {
        Some(t) => {
            if (t == "REPLACE".bytes()) {
                true
            } else if (t == "COPY".bytes()) {
                false
            } else {
                return Err(S3Fail.Code(S3Code.InvalidArgument));
            }
        }
        null => false,
    };
    let tags = if (tagsReplaced) requestTags(req)? else match (metadataValue(
        plan.source.metadata.view(),
        TAGS_FIELD.bytes(),
    )) {
        Ok(t) => t,
        Err(_) => { return Err(S3Fail.Code(S3Code.InternalError)); }
    };
    // The source's tags, copied: reading them and writing them are calls of their own, as on AWS (the M11 second
    // reading's #5). Tags the request gives were authorized with its other fields.
    if (!tagsReplaced && tags.length > 0) {
        await authorize(app, req, who, "s3:GetObjectTagging", src.bucket.view(), src.key.bytes())?;
        await authorize(app, req, who, "s3:PutObjectTagging", req.bucket.view(), req.key.view().bytes())?;
    }
    // A directory bucket holds no tags: a copy that would give it some is NotImplemented, as S3 answers (ADR-0080 §6).
    if (tags.length > 0 && inDirectoryBucket(req.bucket.view())) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
    metadata = match (metadataReplace(metadata.view(), TAGS_FIELD.bytes(), tags.view())) {
        Ok(b) => b,
        Err(_) => { return Err(S3Fail.Code(S3Code.InternalError)); }
    };
    // A copy never has its source's ACL: the request's, or the private one (ADR-0045 §3).
    metadata = await withRequestAcl(app, req, metadata)?;
    // Nor its lock: the request's, or the bucket's default (ADR-0047 §2).
    metadata = await withRequestLock(app, req, metadata)?;
    // Nor its envelope: sealed again as asked, or in the clear (ADR-0046 §3).
    metadata = match (metadataReplace(metadata.view(), SSE_FIELD.bytes(), "".bytes())) {
        Ok(b) => b,
        Err(_) => { return Err(S3Fail.Code(S3Code.InternalError)); }
    };
    var envelope = Vector<u8>.create();
    var sealer: SseSealer? = null;
    match (newSeal(app.sseKeys.view(), app.kmsKeys.view(), borrow asked)?) {
        Some(seal) => {
            metadataAdd(mut metadata, SSE_FIELD.bytes(), seal.field.view())?;
            envelope.extend(seal.field.view())?;
            sealer = Some(sealerOf(borrow seal, plan.size, customerKeyOf(borrow asked))?);
        }
        null => {}
    }
    let sealing = sealer.isSome();
    let copied = await runCopy(plan, opener, sealer)?;
    var extras = Vector<u8>.create();
    singlePartExtras(copied.algorithm, copied.checksum.view(), mut extras)?;
    let outcome = await commitPut(
        app,
        req.bucket.view(),
        req.key.view(),
        contentType.view(),
        metadata.view(),
        extras.view(),
        borrow copied.finished,
        condition,
        etags.view(),
    )?;
    writtenVersionHeader(exchange, borrow outcome)?;
    if (sealing) { sseAnswerOf(exchange, envelope.view(), customerKeyOf(borrow asked))?; }
    let directory = inDirectoryBucket(req.bucket.view());
    return await sendCopyResult(exchange, "CopyObjectResult", borrow outcome.md5, directory, outcome.extras.view());
}

async fn uploadPartCopy(
    app: borrow S3App,
    req: borrow S3Request,
    who: borrow Requester,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    let number = partNumberOf(req)?;
    let id = uploadIdOf(req)?;
    let src = copySourceOf(req)?;
    await authorizeSource(app, req, who, borrow src)?;
    let plan = await openCopy(app, req, borrow src, CopyTarget.Part(number), id)?;
    if (plan.source.versioned) { versionHeader(exchange, "x-amz-copy-source-version-id", plan.source.versionId)?; }
    let opener = await sourceOpener(app, req, borrow plan)?;
    // Into a sealed upload, the part is sealed as UploadPart seals one: under the key of a salt of its own
    // (ADR-0046 §2); an SSE-C upload's key comes with the request.
    let customer = sseCustomerKeyOf(req, false)?;
    checkPartFields(req, plan.uploadEnvelope.view())?;
    var sealer: SseSealer? = null;
    if (plan.uploadEnvelope.length > 0) {
        var dataKey = await sealedDataKey(app, plan.uploadEnvelope.view(), customer)?;
        var salt = [0u8; 16];
        if (Random.fill(mut salt[..]).isErr()) { return Err(S3Fail.Code(S3Code.InternalError)); }
        sealer = SseSealer.createPart(borrow dataKey, salt, plan.size)?;
        match (sealer.asBorrowMut()) {
            Some(s) => {
                if (isCustomerEnvelope(plan.uploadEnvelope.view())) { s.etagKey = customer; }
                if (isKmsEnvelope(plan.uploadEnvelope.view())) { s.etagKey = Some(dataKey); }
            }
            null => { return Err(S3Fail.Code(S3Code.InternalError)); }
        }
        for (i in 0..32) { dataKey[i] = 0; }
    } else if (customer.isSome()) {
        return Err(S3Fail.Code(S3Code.InvalidRequest));
    }
    let sealing = sealer.isSome();
    var envelope = Vector<u8>.create();
    envelope.extend(plan.uploadEnvelope.view())?;
    let copied = await runCopy(plan, opener, sealer)?;
    if (sealing) { sseAnswerOf(exchange, envelope.view(), customer)?; }
    let md5 = await commitPart(
        app,
        req.bucket.view(),
        req.key.view(),
        id,
        number,
        copied.checksum.view(),
        borrow copied.finished,
    )?;
    // A part's checksum, alone: COMPOSITE parts have no type of their own to show.
    var extras = Vector<u8>.create();
    singlePartExtras(copied.algorithm, copied.checksum.view(), mut extras)?;
    return await sendCopyResult(exchange, "CopyPartResult", borrow md5, false, extras.view()); // a part's
}
