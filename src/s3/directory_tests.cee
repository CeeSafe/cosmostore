// Directory buckets in the S3 layer (ADR-0080): the configuration CreateBucket takes, the headers it refuses, and
// the signature's service and region; CreateSession's tokens and what a session reaches.
import web_core;
import web_transport;
import web_http;
import web_server;

fn directoryConfig(locationType: StringView, zone: StringView, redundancy: StringView, kind: StringView) -> String {
    var x = textOf("<CreateBucketConfiguration xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><Location><Type>");
    let _ = x.append(locationType);
    let _ = x.append("</Type><Name>");
    let _ = x.append(zone);
    let _ = x.append("</Name></Location><Bucket><DataRedundancy>");
    let _ = x.append(redundancy);
    let _ = x.append("</DataRedundancy><Type>");
    let _ = x.append(kind);
    let _ = x.append("</Type></Bucket></CreateBucketConfiguration>");
    return x;
}

fn invalid(r: Result<void, S3Fail>) -> bool => match (r) {
    Err(S3Fail.Code(S3Code.InvalidArgument)) => true,
    _ => false,
};

@test
fn directoryBucketConfigurations() -> Result<void, TestFailure> {
    let zone = "local-az1".bytes();
    let good = directoryConfig("AvailabilityZone", "local-az1", "SingleAvailabilityZone", "Directory");
    Check.isTrue(asksDirectory(good.view().bytes()), "a directory configuration")?;
    Check.isTrue(checkDirectoryConfig(good.view().bytes(), zone).isOk(), "taken")?;
    let general =
        "<CreateBucketConfiguration><LocationConstraint>eu-west-1</LocationConstraint></CreateBucketConfiguration>";
    Check.isFalse(asksDirectory(general.bytes()), "a general-purpose bucket's")?;
    Check.isFalse(asksDirectory("".bytes()), "no body")?;
    let other = directoryConfig("AvailabilityZone", "usw2-az1", "SingleAvailabilityZone", "Directory");
    Check.isTrue(invalid(checkDirectoryConfig(other.view().bytes(), zone)), "another zone")?;
    let local = directoryConfig("LocalZone", "local-az1", "SingleLocalZone", "Directory");
    Check.isTrue(invalid(checkDirectoryConfig(local.view().bytes(), zone)), "a Local Zone")?;
    let kind = directoryConfig("AvailabilityZone", "local-az1", "SingleAvailabilityZone", "General");
    Check.isTrue(invalid(checkDirectoryConfig(kind.view().bytes(), zone)), "not Directory")?;
    var both = textOf("<CreateBucketConfiguration><LocationConstraint>x</LocationConstraint>");
    let _ = both.append(
        "<Location><Type>AvailabilityZone</Type><Name>local-az1</Name></Location><Bucket><DataRedundancy>SingleAvailabilityZone</DataRedundancy><Type>Directory</Type></Bucket></CreateBucketConfiguration>",
    );
    Check.isTrue(invalid(checkDirectoryConfig(both.view().bytes(), zone)), "with a LocationConstraint")?;
    let noBucket =
        "<CreateBucketConfiguration><Location><Type>AvailabilityZone</Type><Name>local-az1</Name></Location></CreateBucketConfiguration>";
    Check.isTrue(invalid(checkDirectoryConfig(noBucket.bytes(), zone)), "no Bucket")?;
    return Ok();
}

@test
fn directoryRequestFields() -> Result<void, TestFailure> {
    var req = bareRequest();
    req.headers.push(policyHeader(
        "authorization",
        "AWS4-HMAC-SHA256 Credential=AKIA/20261118/eu-north-1/s3express/aws4_request, SignedHeaders=host, Signature=00",
    ))!;
    Check.isTrue(signedForExpress(borrow req), "signed for s3express")?;
    Check.equalBytes("eu-north-1".bytes(), scopeField(borrow req, 2) ?? "".bytes())?;
    var arn = Vector<u8>.create();
    directoryArn(borrow req, "data--local-az1--x-s3".bytes(), mut arn)!;
    Check.equalBytes("arn:aws:s3express:eu-north-1:000000000000:bucket/data--local-az1--x-s3".bytes(), arn.view())?;
    Check.isFalse(refusedDirectoryHeader(borrow req), "nothing refused")?;
    req.headers.push(policyHeader("x-amz-grant-read", "id=x"))!;
    Check.isTrue(refusedDirectoryHeader(borrow req), "a grant")?;
    var plain = bareRequest();
    plain.headers.push(policyHeader(
        "authorization",
        "AWS4-HMAC-SHA256 Credential=AKIA/20261118/us-east-1/s3/aws4_request, SignedHeaders=host, Signature=00",
    ))!;
    Check.isFalse(signedForExpress(borrow plain), "signed for s3")?;
    let unsigned = bareRequest();
    Check.isFalse(signedForExpress(borrow unsigned), "unsigned")?;
    return Ok();
}

fn expressSession(bucket: StringView, mode: u8) -> ExpressSession => ExpressSession {
    accessKey: copyBytes("ASIAEXPRESS0000000001".bytes())!,
    secret: copyBytes("secret".bytes())!,
    parent: copyBytes("AKIAPARENT".bytes())!,
    bucket: copyBytes(bucket.bytes())!,
    mode: mode,
    expiresMs: 1700000000000,
};

@test
fn expressTokensAreTheirOwn() -> Result<void, TestFailure> {
    var keys = Vector<MasterKey>.create();
    keys.push(stsKey("k1", 7))!;
    let s = expressSession("data--local-az1--x-s3", EXPRESS_READ_ONLY);
    var token = Vector<u8>.create();
    Check.isTrue(sealExpressToken(keys.view(), borrow s, mut token)!, "sealed")?;
    let opened = openExpressToken(keys.view(), token.view())!!;
    Check.equalBytes("data--local-az1--x-s3".bytes(), opened.bucket.view())?;
    Check.equalBytes("AKIAPARENT".bytes(), opened.parent.view())?;
    Check.equalU64(EXPRESS_READ_ONLY as u64, opened.mode as u64)?;
    Check.isTrue(opened.expiresMs == 1700000000000, "its expiry")?;
    // Not an STS token, and an STS token is not one of these.
    Check.isTrue(openStsToken(keys.view(), token.view())!.isNull(), "not an STS token")?;
    let sts = StsSession {
        accessKey: copyBytes("ASIASTS".bytes())!,
        secret: copyBytes("s".bytes())!,
        parent: copyBytes("AKIAPARENT".bytes())!,
        role: Vector<u8>.create(),
        name: Vector<u8>.create(),
        policy: Vector<u8>.create(),
        expiresMs: 1,
    };
    var stsToken = Vector<u8>.create();
    Check.isTrue(sealStsToken(keys.view(), borrow sts, mut stsToken)!, "an STS token")?;
    Check.isTrue(openExpressToken(keys.view(), stsToken.view())!.isNull(), "an STS token is not a session's")?;
    // Another key, or a changed byte.
    var other = Vector<MasterKey>.create();
    other.push(stsKey("k1", 8))!;
    Check.isTrue(openExpressToken(other.view(), token.view())!.isNull(), "another key")?;
    var raw = Vector<u8>.create();
    let _ = decodeBase64(token.view(), mut raw)!;
    raw[raw.length - 20] = raw[raw.length - 20] ^ 1;
    var changed = Vector<u8>.create();
    appendBase64(mut changed, raw.view())!;
    Check.isTrue(openExpressToken(keys.view(), changed.view())!.isNull(), "a changed token")?;
    return Ok();
}

fn sessionRequest(method: Method, bucket: StringView, key: StringView, param: StringView) -> S3Request {
    var req = bareRequest();
    req.method = method;
    let _ = req.bucket.append(bucket);
    let _ = req.key.append(key);
    if (param.length > 0) {
        req.query.push(QueryParam { name: copyBytes(param.bytes())!, value: copyBytes("2".bytes())! })!;
    }
    return req;
}

fn deniedBySession(req: borrow S3Request, s: borrow ExpressSession) -> bool =>
    match (checkExpressSession(req, s)) {
        Err(S3Fail.Code(S3Code.AccessDenied)) => true,
        _ => false,
    };

@test
fn expressSessionsReachTheirBucketAndMode() -> Result<void, TestFailure> {
    let bucket = "data--local-az1--x-s3";
    let readOnly = expressSession(bucket, EXPRESS_READ_ONLY);
    let readWrite = expressSession(bucket, EXPRESS_READ_WRITE);
    let get = sessionRequest(Method.Get, bucket, "k", "");
    let head = sessionRequest(Method.Head, bucket, "k", "");
    let list = sessionRequest(Method.Get, bucket, "", "list-type");
    let uploads = sessionRequest(Method.Get, bucket, "", "uploads");
    let put = sessionRequest(Method.Put, bucket, "k", "");
    let delete = sessionRequest(Method.Delete, bucket, "k", "");
    let policy = sessionRequest(Method.Get, bucket, "", "policy");
    Check.isTrue(checkExpressSession(borrow get, borrow readOnly).isOk(), "GetObject, ReadOnly")?;
    Check.isTrue(checkExpressSession(borrow head, borrow readOnly).isOk(), "HeadObject, ReadOnly")?;
    Check.isTrue(checkExpressSession(borrow list, borrow readOnly).isOk(), "ListObjectsV2, ReadOnly")?;
    Check.isTrue(checkExpressSession(borrow uploads, borrow readOnly).isOk(), "ListMultipartUploads, ReadOnly")?;
    Check.isTrue(deniedBySession(borrow put, borrow readOnly), "PutObject, not ReadOnly")?;
    Check.isTrue(deniedBySession(borrow delete, borrow readOnly), "DeleteObject, not ReadOnly")?;
    Check.isTrue(deniedBySession(borrow policy, borrow readOnly), "GetBucketPolicy, not ReadOnly")?;
    Check.isTrue(checkExpressSession(borrow put, borrow readWrite).isOk(), "PutObject, ReadWrite")?;
    Check.isTrue(checkExpressSession(borrow policy, borrow readWrite).isOk(), "GetBucketPolicy, ReadWrite")?;
    let elsewhere = sessionRequest(Method.Get, "other--local-az1--x-s3", "k", "");
    Check.isTrue(deniedBySession(borrow elsewhere, borrow readWrite), "another bucket")?;
    return Ok();
}
