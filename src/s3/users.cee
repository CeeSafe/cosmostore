// Users (ADR-0088 §1): the users file names the account's keys and each user, its access keys and its identity
// policy. It is read with the credentials file, and each key's place in a credential set then carries its user's name
// and parsed policy. A key the file names neither as the account's nor a user's is refused: removing a user, or its
// line, takes its keys away rather than giving them the account (fail closed, the M11 exit review's A2).

/// One user of the file: its name, its id, keys and identity policy's text.
struct UserEntry {
    name: Vector<u8>;
    /// Unique in the file and for the user's life: a user removed and made again with its name is given a new one, so
    /// policies that named the old user do not name it (as AWS's unique ids).
    id: Vector<u8>;
    keys: Vector<Vector<u8>>;
    policyText: Vector<u8>;
}

/// A users file: the account's keys (its `account` lines) and its users.
struct UsersFile {
    account: Vector<Vector<u8>>;
    users: Vector<UserEntry>;
}

/// An IAM user name: 1 to 64 of `A-Za-z0-9+=,.@_-`. `account` (in any case) names the account's line, not a user.
fn userNameOk(name: Slice<u8>) -> bool {
    if (name.length < 1 || name.length > 64) { return false; }
    for (c in name) {
        let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '+' || c == '=' ||
            c == ',' || c == '.' || c == '@' || c == '_' || c == '-';
        if (!ok) { return false; }
    }
    return !sameNameIgnoringCase(name, "account".bytes());
}

/// Whether two names are the same but for ASCII case: IAM's user names are unique ignoring case.
fn sameNameIgnoringCase(a: Slice<u8>, b: Slice<u8>) -> bool {
    if (a.length != b.length) { return false; }
    for (i in 0..a.length) {
        if (lowerAscii(a[i]) != lowerAscii(b[i])) { return false; }
    }
    return true;
}

/// A user's id: 1 to 128 of `A-Za-z0-9`.
fn userIdOk(id: Slice<u8>) -> bool {
    if (id.length < 1 || id.length > 128) { return false; }
    for (c in id) {
        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) { return false; }
    }
    return true;
}

/// Why a users file is refused, with its line (1-based).
fn usersFault(line: usize, why: StringView) -> String {
    var m = String.create();
    let _ = m.append("the users file, line ");
    let _ = m.appendNumber(line as u64);
    let _ = m.append(": ");
    let _ = m.append(why);
    return m;
}

/// Why a users file is refused for one key, named.
fn usersKeyFault(line: usize, why: StringView, key: Slice<u8>) -> String {
    var m = usersFault(line, why);
    let _ = m.append(": ");
    let _ = m.append(StringView.fromUtf8(key) ?? "?");
    return m;
}

/// Whether `file` already names `key`, as the account's or a user's.
fn namesKey(file: borrow UsersFile, key: Slice<u8>) -> bool {
    for (k in 0..file.account.length) {
        if (file.account[k].view() == key) { return true; }
    }
    for (u in 0..file.users.length) {
        for (k in 0..file.users[u].keys.length) {
            if (file.users[u].keys[k].view() == key) { return true; }
        }
    }
    return false;
}

/// The keys of a `<key>[,<key>…]` list, each new to `file` and to the list; out-param `keys`.
fn parseKeyList(
    file: borrow UsersFile,
    number: usize,
    list: Slice<u8>,
    keys: borrow mut Vector<Vector<u8>>,
) -> Result<void, String> {
    let text = StringView.fromUtf8(list) ?? { return Err(usersFault(number, "a key list is not UTF-8")); };
    for (key in text.split(",")) {
        if (key.length == 0) { return Err(usersFault(number, "an empty key")); }
        if (namesKey(file, key.bytes())) { return Err(usersKeyFault(number, "a key named twice", key.bytes())); }
        for (k in 0..keys.length) {
            if (keys[k].view() == key.bytes()) {
                return Err(usersKeyFault(number, "a key named twice", key.bytes()));
            }
        }
        if (keys.push(copyBytes(key.bytes()).ok() ?? { return Err(textOf("out of memory")); }).isErr()) {
            return Err(textOf("out of memory"));
        }
    }
    return Ok();
}

/// Parses a users file: `account <key>[,<key>…]` lines for the account's keys, `<name>:<id> <key>[,<key>…]
/// <identity policy JSON>` a user, `#` lines for comments. A key is named once in the file, an id once.
fn parseUsersFile(text: Slice<u8>) -> Result<UsersFile, String> {
    var out = UsersFile { account: Vector<Vector<u8>>.create(), users: Vector<UserEntry>.create() };
    var at: usize = 0;
    var number: usize = 0;
    while (at < text.length) {
        let end = pieceEnd(text, at, '\n');
        let raw = trimSpaces(text[at..end]);
        at = end + 1;
        number += 1;
        let line = if (raw.length > 0 && raw[raw.length - 1] == '\r') raw[0..raw.length - 1] else raw;
        if (line.length == 0 || line[0] == '#') { continue; }
        let space = pieceEnd(line, 0, ' ');
        if (space == line.length) { return Err(usersFault(number, "a user is `<name> <keys> <policy>`")); }
        let head = line[0..space];
        let rest = trimSpaces(line[space + 1..]);
        if (head == "account".bytes()) {
            if (pieceEnd(rest, 0, ' ') != rest.length) {
                return Err(usersFault(number, "the account's keys are `account <key>[,<key>…]`"));
            }
            var keys = Vector<Vector<u8>>.create();
            parseKeyList(borrow out, number, rest, borrow mut keys)?;
            for (k in 0..keys.length) {
                if (out.account.push(
                    copyBytes(keys[k].view()).ok() ?? { return Err(textOf("out of memory")); },
                ).isErr()) {
                    return Err(textOf("out of memory"));
                }
            }
            continue;
        }
        // `<name>:<id>`.
        let colon = pieceEnd(head, 0, ':');
        if (colon == head.length || !userIdOk(head[colon + 1..])) {
            return Err(usersFault(number, "a user is `<name>:<id>`, its id 1 to 128 of A-Za-z0-9"));
        }
        let id = head[colon + 1..];
        let name = head[0..colon];
        if (!userNameOk(name)) {
            return Err(usersFault(number, "a user's name is 1 to 64 of A-Za-z0-9+=,.@_-, and not `account`"));
        }
        for (i in 0..out.users.length) {
            if (out.users[i].id.view() == id) { return Err(usersFault(number, "two users with one id")); }
        }
        let space2 = pieceEnd(rest, 0, ' ');
        if (space2 == rest.length) { return Err(usersFault(number, "a user is `<name> <keys> <policy>`")); }
        let policy = trimSpaces(rest[space2 + 1..]);
        match (parseIdentityPolicy(policy)) {
            Ok(_) => {}
            Err(S3Fail.OutOfMemory(_)) => { return Err(textOf("out of memory")); }
            Err(_) => { return Err(usersFault(number, "the identity policy does not parse")); }
        }
        for (i in 0..out.users.length) {
            if (sameNameIgnoringCase(out.users[i].name.view(), name)) {
                return Err(usersFault(number, "a user named twice (names are unique ignoring case)"));
            }
        }
        var entry = UserEntry {
            name: copyBytes(name).ok() ?? { return Err(textOf("out of memory")); },
            id: copyBytes(id).ok() ?? { return Err(textOf("out of memory")); },
            keys: Vector<Vector<u8>>.create(),
            policyText: copyBytes(policy).ok() ?? { return Err(textOf("out of memory")); },
        };
        parseKeyList(borrow out, number, rest[0..space2], borrow mut entry.keys)?;
        if (out.users.push(entry).isErr()) { return Err(textOf("out of memory")); }
    }
    return Ok(out);
}

/// Gives each key of `set` its place by the users file: the account's, a user's (its name and parsed policy), or,
/// named by neither, refused (revoked in this set; the next reload decides it again). A key the file names that the
/// credentials file does not have is no one's: removing a key from the credentials file revokes it, whatever the
/// users file says (the M11 exit review's A3).
fn applyUsers(set: borrow mut Vector<Credential>, file: borrow UsersFile) -> Result<void, String> {
    for (i in 0..set.length) {
        set[i].user.clear();
        set[i].userKey.clear();
        set[i].policyText.clear();
        set[i].policy = null;
        if (set[i].revoked) { continue; }
        var named = false;
        for (k in 0..file.account.length) {
            if (file.account[k].view() == set[i].accessKey.view()) { named = true; }
        }
        for (u in 0..file.users.length) {
            for (k in 0..file.users[u].keys.length) {
                if (file.users[u].keys[k].view() != set[i].accessKey.view()) { continue; }
                named = true;
                let policy = match (parseIdentityPolicy(file.users[u].policyText.view())) {
                    Ok(p) => p,
                    Err(_) => { return Err(textOf("out of memory")); }
                };
                if (set[i].user.extend(file.users[u].name.view()).isErr() ||
                    set[i].userKey.extend(file.users[u].name.view()).isErr() || set[i].userKey.push(' ').isErr() ||
                    set[i].userKey.extend(file.users[u].id.view()).isErr() ||
                    set[i].policyText.extend(file.users[u].policyText.view()).isErr()) {
                    return Err(textOf("out of memory"));
                }
                set[i].policy = Some(policy);
            }
        }
        if (!named) { set[i].revoked = true; }
    }
    return Ok();
}

/// Reads and parses the users file at `path`.
fn readUsers(path: StringView) -> Result<UsersFile, String> {
    let text = readSmallFile(path, "users file")?;
    return parseUsersFile(text.view());
}

/// The user a requester's key belongs to, with its identity policy; null for the account's keys and anonymous
/// requests (ADR-0088 §2). A key revoked since its request was authenticated is returned too, with no user and no
/// policy, so that no caller takes it for the account's: what it asks is refused (the M11 second reading's #6).
fn userOfRequester<region a>(credentials: Slice<a, Credential>, who: borrow Requester) -> borrow(a) Credential? {
    let i = who.key ?? { return null; };
    if (i >= credentials.length) { return null; }
    if (credentials[i].user.length == 0 && !credentials[i].revoked) { return null; }
    return Some(borrow credentials[i]);
}
