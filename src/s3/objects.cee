// PutObject and GetObject/HeadObject (ADR-0008 §3, §6-10): bodies stream through `Async.blocking` without the store's
// lock, every check runs before the commit, and a conditional PUT is decided under the lock.
import web_core;
import web_http;
import web_server;

/// A checksum in base64, as S3 writes it.
fn encodedChecksum(sum: borrow RunningChecksum, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    var raw = Vector<u8>.create();
    sum.finishInto(mut raw)?;
    out.clear();
    appendBase64(out, raw.view())?;
    return Ok();
}

/// The algorithm's name in S3's fields and elements: `CRC32`, `CRC32C`, `CRC64NVME`, `SHA256`.
fn checksumNameUpper(a: ChecksumAlgorithm) -> StringView => match (a) {
    ChecksumAlgorithm.Crc32 => "CRC32",
    ChecksumAlgorithm.Crc32c => "CRC32C",
    ChecksumAlgorithm.Crc64Nvme => "CRC64NVME",
    ChecksumAlgorithm.Sha256 => "SHA256",
    ChecksumAlgorithm.None => "",
};

fn checksumTypeName(t: ChecksumType) -> StringView => match (t) {
    ChecksumType.FullObject => "FULL_OBJECT",
    ChecksumType.Composite => "COMPOSITE",
};

/// `x-amz-checksum-algorithm`'s value; SHA-1 is NotImplemented (CEESAFE_GAPS G26), anything else InvalidRequest.
fn checksumFromName(text: Slice<u8>) -> Result<ChecksumAlgorithm, S3Code> {
    let t = trimSpaces(text);
    if (equalsIgnoreCase(t, "CRC32".bytes())) { return Ok(ChecksumAlgorithm.Crc32); }
    if (equalsIgnoreCase(t, "CRC32C".bytes())) { return Ok(ChecksumAlgorithm.Crc32c); }
    if (equalsIgnoreCase(t, "CRC64NVME".bytes())) { return Ok(ChecksumAlgorithm.Crc64Nvme); }
    if (equalsIgnoreCase(t, "SHA256".bytes())) { return Ok(ChecksumAlgorithm.Sha256); }
    if (equalsIgnoreCase(t, "SHA1".bytes())) { return Err(S3Code.NotImplemented); }
    return Err(S3Code.InvalidRequest);
}

/// `x-amz-checksum-<name>: <value>` and `x-amz-checksum-type` for a stored checksum, if there is one.
fn sendChecksumHeaders(exchange: borrow mut Exchange, e: borrow ObjectExtras) -> Result<void, S3Fail> {
    match (e.algorithm) {
        ChecksumAlgorithm.None => { return Ok(); }
        _ => {}
    }
    var name = Vector<u8>.create();
    appendChecksumName(mut name, e.algorithm)?;
    var value = Vector<u8>.create();
    e.display(mut value)?;
    match (StringView.fromUtf8(name.view())) {
        Some(n) => { exchange.header(n, value.view())?; }
        null => {}
    }
    exchange.header("x-amz-checksum-type", checksumTypeName(e.kind).bytes())?;
    return Ok();
}

/// The checksum named by a field `x-amz-checksum-<name>` (lowercase): its kind, or NotImplemented for SHA-1.
fn checksumKindOf(field: Slice<u8>) -> Result<ChecksumAlgorithm?, S3Code> {
    if (field == "x-amz-checksum-crc32".bytes()) { return Ok(ChecksumAlgorithm.Crc32); }
    if (field == "x-amz-checksum-crc32c".bytes()) { return Ok(ChecksumAlgorithm.Crc32c); }
    if (field == "x-amz-checksum-crc64nvme".bytes()) { return Ok(ChecksumAlgorithm.Crc64Nvme); }
    if (field == "x-amz-checksum-sha256".bytes()) { return Ok(ChecksumAlgorithm.Sha256); }
    if (field == "x-amz-checksum-sha1".bytes()) { return Err(S3Code.NotImplemented); }
    return Ok(null);
}

/// An ETag as a client sends it (`"hex"` or `"hex-N"`, quotes optional): its MD5 and part count (0 for none), or
/// null.
fn parseEtag(text: Slice<u8>) -> ParsedEtag? {
    let t = trimSpaces(text);
    let inner = if (t.length >= 2 && t[0] == '"' && t[t.length - 1] == '"') t[1..t.length - 1] else t;
    if (inner.length < 32) { return null; }
    var parts: u32 = 0;
    if (inner.length > 32) {
        if (inner[32] != '-') { return null; }
        match (parseDecimal(inner[33..])) {
            Some(n) => {
                if (n == 0 || n > MAX_PART_NUMBER as u64) { return null; }
                parts = truncate<u32>(n);
            }
            null => { return null; }
        }
    }
    var md5 = [0u8; 16];
    for (i in 0..16) {
        let hi = hexValue(inner[i * 2]);
        let lo = hexValue(inner[i * 2 + 1]);
        if (hi.isNull() || lo.isNull()) { return null; }
        md5[i] = ((hi ?? 0) << 4) | (lo ?? 0);
    }
    return ParsedEtag { md5: md5, parts: parts };
}

struct ParsedEtag {
    md5: [u8; 16];
    parts: u32;
}

/// Whether `header` (an If-Match or If-None-Match list) names the ETag of `md5` and `parts`, or is `*`.
fn etagListMatches(header: Slice<u8>, md5: borrow [u8; 16], parts: u32) -> bool {
    var at: usize = 0;
    while (at < header.length) {
        let end = pieceEnd(header, at, ',');
        let one = trimSpaces(header[at..end]);
        at = end + 1;
        if (one == "*".bytes()) { return true; }
        match (parseEtag(one)) {
            Some(e) => {
                if (e.md5[..] == md5[..] && e.parts == parts) { return true; }
            }
            null => {}
        }
    }
    return false;
}

/// `"hex"`, or `"hex-N"` for a multipart object of N parts.
fn appendEtag(out: borrow mut Vector<u8>, md5: borrow [u8; 16], parts: u32) -> Result<void, AllocError> {
    out.push('"')?;
    appendHexBytes(out, md5[..])?;
    if (parts > 0) {
        out.push('-')?;
        appendDecimal(out, parts as u64)?;
    }
    out.push('"')?;
    return Ok();
}

/// A PUT's precondition.
enum PutIf {
    None,
    /// If-None-Match: *
    Absent,
    /// If-Match: the current version's ETag must be one of these (`*`: any version).
    Matches,
    /// If-None-Match with ETags: the key may be absent, or its current ETag must be none of these (ADR-0014).
    NoneMatch,
}

/// A write's If-Match / If-None-Match, and the ETag list it names, from the request.
fn putConditionOf(req: borrow S3Request, etags: borrow mut Vector<u8>) -> Result<PutIf, S3Fail> {
    var condition = PutIf.None;
    match (headerOf(req, "if-none-match")) {
        Some(t) => {
            if (trimSpaces(t) == "*".bytes()) {
                condition = PutIf.Absent;
            } else {
                etags.extend(t)?;
                condition = PutIf.NoneMatch;
            }
        }
        null => {}
    }
    match (headerOf(req, "if-match")) {
        Some(t) => {
            match (condition) {
                PutIf.None => {}
                _ => { return Err(S3Fail.Code(S3Code.NotImplemented)); } // both at once
            }
            etags.extend(t)?;
            condition = PutIf.Matches;
        }
        null => {}
    }
    return Ok(condition);
}

/// Under the lock: the store's condition for a write, read from the key's current version so that nothing can come
/// between the check and the commit (ADR-0008 §9).
fn resolveCondition(
    store: borrow ObjectStore,
    bucket: StringView,
    key: StringView,
    condition: PutIf,
    etags: Slice<u8>,
) -> Result<PutCondition, StoreError> {
    return match (condition) {
        PutIf.None => Ok(PutCondition.None),
        PutIf.Absent => Ok(PutCondition.IfAbsent),
        PutIf.Matches => match (store.headObject(bucket, key)) {
            Ok(info) => {
                if (!etagListMatches(etags, borrow info.md5, info.parts)) {
                    Err(StoreError.PreconditionFailed)
                } else {
                    Ok(PutCondition.IfGeneration(info.generation))
                }
            }
            // If-Match on a key with no object is 404 NoSuchKey, as AWS documents for conditional writes.
            Err(StoreError.NoSuchKey) => Err(StoreError.NoSuchKey),
            Err(e) => Err(e),
        },
        PutIf.NoneMatch => match (store.headObject(bucket, key)) {
            Ok(info) => {
                if (etagListMatches(etags, borrow info.md5, info.parts)) {
                    Err(StoreError.PreconditionFailed)
                } else {
                    Ok(PutCondition.IfGeneration(info.generation))
                }
            }
            Err(StoreError.NoSuchKey) => Ok(PutCondition.IfAbsent),
            Err(e) => Err(e),
        },
    };
}

// ---- PutObject ----

/// What a PUT or UploadPart body must be and match, from the request's fields (ADR-0008 §6-7).
struct BodySpec {
    size: u64;
    chunked: bool;
    md5Expected: [u8; 16]?;
    checksumKind: ChecksumAlgorithm;
    checksumExpected: Vector<u8>;
    checksumInTrailer: bool;
    trailerName: Vector<u8>;
}

fn bodySpec(req: borrow S3Request, auth: borrow Authenticated) -> Result<BodySpec, S3Fail> {
    let chunked = match (auth.payload) {
        PayloadMode.Chunked => true,
        _ => false,
    };
    let sizeField = if (chunked) headerOf(req, "x-amz-decoded-content-length") else headerOf(req, "content-length");
    let size = match (sizeField) {
        Some(t) => {
            match (parseDecimal(t)) {
                Some(v) => v,
                null => { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            }
        }
        null => { return Err(S3Fail.Code(S3Code.MissingContentLength)); }
    };
    if (size > MAX_PUT_BYTES) { return Err(S3Fail.Code(S3Code.EntityTooLarge)); }
    var md5Expected: [u8; 16]? = null;
    match (headerOf(req, "content-md5")) {
        Some(t) => {
            var raw = Vector<u8>.create();
            if (!decodeBase64(trimSpaces(t), mut raw)? || raw.length != 16) {
                return Err(S3Fail.Code(S3Code.InvalidDigest));
            }
            var d = [0u8; 16];
            d[..].copyFrom(raw.view());
            md5Expected = d;
        }
        null => {}
    }
    var checksumKind = ChecksumAlgorithm.None;
    var checksumExpected = Vector<u8>.create();
    var checksumInTrailer = false;
    for (i in 0..req.headers.length) {
        let name = req.headers[i].name.view();
        match (checksumKindOf(name)) {
            Ok(Some(k)) => {
                checksumKind = k;
                checksumExpected.clear();
                checksumExpected.extend(trimSpaces(req.headers[i].value.view()))?;
            }
            Ok(null) => {}
            Err(code) => { return Err(S3Fail.Code(code)); }
        }
    }
    var trailerName = Vector<u8>.create();
    match (headerOf(req, "x-amz-trailer")) {
        Some(t) => {
            if (!chunked) { return Err(S3Fail.Code(S3Code.InvalidRequest)); }
            for (k in 0..t.length) { trailerName.push(lowerAscii(t[k]))?; }
            match (checksumKindOf(trimSpaces(trailerName.view()))) {
                Ok(Some(k)) => {
                    checksumKind = k;
                    checksumInTrailer = true;
                }
                Ok(null) => { return Err(S3Fail.Code(S3Code.InvalidRequest)); }
                Err(code) => { return Err(S3Fail.Code(code)); }
            }
        }
        null => {}
    }
    return Ok(BodySpec {
        size: size,
        chunked: chunked,
        md5Expected: md5Expected,
        checksumKind: checksumKind,
        checksumExpected: checksumExpected,
        checksumInTrailer: checksumInTrailer,
        trailerName: trailerName,
    });
}

/// A body that was received whole and passed every check: its finished bytes, and its checksum as computed.
struct ReceivedBody {
    finished: FinishedObject;
    /// The checksum the client named, and its value in base64.
    checksumKind: ChecksumAlgorithm;
    computed: Vector<u8>;
    /// The checksum to store (ADR-0015), raw: the client's algorithm, else the one the caller asked for.
    storedAlgorithm: ChecksumAlgorithm;
    stored: Vector<u8>;
}

/// Streams the body into `writer` without the store's lock, a step at a time: decoded if aws-chunked, hashed, and
/// written on a worker thread. Every check runs before the caller commits, and a refused body's extents are removed.
async fn receiveBody(
    app: borrow S3App,
    auth: Authenticated,
    spec: borrow mut BodySpec,
    writer: ObjectWriter,
    exchange: borrow mut Exchange,
    storedAlgorithm: ChecksumAlgorithm,
) -> Result<ReceivedBody, S3Fail> {
    var w = writer;
    // A second checksum only when the one to store is not the client's.
    let separate = !sameAlgorithm(storedAlgorithm, spec.checksumKind);
    var storedSum = RunningChecksum.create(if (separate) storedAlgorithm else ChecksumAlgorithm.None);
    let expectedSha: [u8; 32]? = match (auth.payload) {
        PayloadMode.Hashed(h) => Some(h),
        _ => null,
    };
    let hashing = expectedSha.isSome();
    let chunked = spec.chunked;
    let size = spec.size;
    var sha = Sha256.create();
    var checksum = RunningChecksum.create(spec.checksumKind);
    var decoder = ChunkDecoder.create(auth.signer);
    var buf = Vector<u8>.create();
    buf.resize(bodyStep(size), 0)?;
    var decoded = Vector<u8>.create();
    var received: u64 = 0;
    while (true) {
        let n = await exchange.read(mut buf.viewMut()[..])?;
        if (n == 0) { break; }
        if (chunked) {
            decoded.clear();
            match (decoder.feed(buf.view()[0..n], mut decoded)) {
                Ok() => {}
                Err(ChunkFault.BadSignature) => { return Err(S3Fail.Code(S3Code.SignatureDoesNotMatch)); }
                Err(ChunkFault.Malformed) => { return Err(S3Fail.Code(S3Code.IncompleteBody)); }
                Err(ChunkFault.OutOfMemory(_)) => { return Err(S3Fail.Code(S3Code.InternalError)); }
            }
        }
        let data = if (chunked) decoded.view() else buf.view()[0..n];
        received += data.length as u64;
        if (received > size) { return Err(S3Fail.Code(S3Code.IncompleteBody)); }
        if (data.length == 0) { continue; }
        let wrote = await Async.blocking(() => writeStep(mut w, mut sha, mut checksum, mut storedSum, hashing, data));
        match (wrote) {
            Ok() => {}
            Err(f) => { return Err(storeFail(StoreError.Io(f), 0)); }
        }
    }
    if (received != size || (chunked && !decoder.isDone())) { return Err(S3Fail.Code(S3Code.IncompleteBody)); }
    let finished = match (await Async.blocking(() => w.finish())) {
        Ok(f) => f,
        Err(f) => { return Err(storeFail(StoreError.Io(f), 0)); }
    };

    var refusal: S3Code? = null;
    match (expectedSha) {
        Some(expected) => {
            if (sha.finish()[..] != expected[..]) { refusal = S3Code.XAmzContentSHA256Mismatch; }
        }
        null => {}
    }
    match (spec.md5Expected) {
        Some(m) => {
            if (m[..] != finished.md5[..]) { refusal = S3Code.BadDigest; }
        }
        null => {}
    }
    if (spec.checksumInTrailer) {
        spec.checksumExpected.clear();
        if (!trailerValue(
            decoder.trailers(),
            StringView.fromUtf8(trimSpaces(spec.trailerName.view())) ?? "",
            mut spec.checksumExpected,
        )?) {
            refusal = S3Code.IncompleteBody;
        }
    }
    var computed = Vector<u8>.create();
    encodedChecksum(borrow checksum, mut computed)?;
    var stored = Vector<u8>.create();
    if (separate) { storedSum.finishInto(mut stored)?; } else { checksum.finishInto(mut stored)?; }
    match (spec.checksumKind) {
        ChecksumAlgorithm.None => {}
        _ => {
            if (refusal.isNull() && computed.view() != spec.checksumExpected.view()) { refusal = S3Code.BadDigest; }
        }
    }
    match (refusal) {
        Some(code) => {
            await discardPut(app, borrow finished)?;
            return Err(S3Fail.Code(code));
        }
        null => {}
    }
    return Ok(ReceivedBody {
        finished: finished,
        checksumKind: spec.checksumKind,
        computed: computed,
        storedAlgorithm: if (separate) storedAlgorithm else spec.checksumKind,
        stored: stored,
    });
}

/// A stored body's response: its ETag and the checksum the client named, then 200.
async fn sendStored(
    exchange: borrow mut Exchange,
    md5: borrow [u8; 16],
    parts: u32,
    body: borrow ReceivedBody,
) -> Result<void, S3Fail> {
    var etag = Vector<u8>.create();
    appendEtag(mut etag, md5, parts)?;
    exchange.header("etag", etag.view())?;
    // The stored checksum too, when it is not the client's (S3's default CRC64NVME).
    if (!sameAlgorithm(body.storedAlgorithm, body.checksumKind)) {
        var e = ObjectExtras.none();
        e.algorithm = body.storedAlgorithm;
        e.value.extend(body.stored.view())?;
        sendChecksumHeaders(exchange, borrow e)?;
    }
    match (body.checksumKind) {
        ChecksumAlgorithm.None => {}
        _ => {
            var name = Vector<u8>.create();
            appendChecksumName(mut name, body.checksumKind)?;
            match (StringView.fromUtf8(name.view())) {
                Some(n) => { exchange.header(n, body.computed.view())?; }
                null => {}
            }
        }
    }
    await exchange.send(Status.ok(), "".bytes())?;
    return Ok();
}

async fn putObject(
    app: borrow S3App,
    req: borrow S3Request,
    auth: Authenticated,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    var spec = bodySpec(req, borrow auth)?;
    var ifMatch = Vector<u8>.create();
    let condition = putConditionOf(req, mut ifMatch)?;
    var contentType = String.create();
    contentTypeOf(req, mut contentType)?;
    let metadata = withRequestTags(req, metadataOf(req)?)?; // refused before the body is read
    let writer = await startPut(app, req.bucket.view(), spec.size)?;
    // Every object gets a checksum: the client's, else CRC64NVME, as S3 does (ADR-0015).
    let storeAs = match (spec.checksumKind) {
        ChecksumAlgorithm.None => ChecksumAlgorithm.Crc64Nvme,
        _ => spec.checksumKind,
    };
    let body = await receiveBody(app, auth, mut spec, writer, exchange, storeAs)?;
    var extras = Vector<u8>.create();
    singlePartExtras(body.storedAlgorithm, body.stored.view(), mut extras)?;
    let outcome = await commitPut(
        app,
        req.bucket.view(),
        req.key.view(),
        contentType.view(),
        metadata.view(),
        extras.view(),
        borrow body.finished,
        condition,
        ifMatch.view(),
    )?;
    return await sendStored(exchange, borrow outcome.md5, 0, borrow body);
}

/// The headers S3 stores with an object and returns on GET and HEAD, besides Content-Type (ADR-0012).
const STORED_HEADERS: StringView = "content-encoding,content-disposition,cache-control,content-language,expires";

/// Whether `name` is in a comma-separated `list`.
fn listed(list: StringView, name: Slice<u8>) -> bool {
    let l = list.bytes();
    var at: usize = 0;
    while (at < l.length) {
        let end = pieceEnd(l, at, ',');
        if (l[at..end] == name) { return true; }
        at = end + 1;
    }
    return false;
}

/// The request's stored fields as a metadata blob: every `x-amz-meta-*` field and the STORED_HEADERS. The
/// `aws-chunked` coding is the transfer's, not the object's, so it is dropped from Content-Encoding, as S3 does.
/// User metadata over 2 KiB is MetadataTooLarge.
fn metadataOf(req: borrow S3Request) -> Result<Vector<u8>, S3Fail> {
    var blob = Vector<u8>.create();
    var userBytes: usize = 0;
    let prefix = "x-amz-meta-".bytes();
    for (i in 0..req.headers.length) {
        let name = req.headers[i].name.view();
        let value = trimSpaces(req.headers[i].value.view());
        if (startsWithBytes(name, prefix)) {
            if (name.length == prefix.length) { continue; }
            userBytes += name.length - prefix.length + value.length;
            metadataAdd(mut blob, name, value)?;
        } else if (name == "content-encoding".bytes()) {
            var kept = Vector<u8>.create();
            var at: usize = 0;
            while (at < value.length) {
                let end = pieceEnd(value, at, ',');
                let coding = trimSpaces(value[at..end]);
                at = end + 1;
                if (coding.length == 0 || equalsIgnoreCase(coding, "aws-chunked".bytes())) { continue; }
                if (kept.length > 0) { kept.extend(", ".bytes())?; }
                kept.extend(coding)?;
            }
            if (kept.length > 0) { metadataAdd(mut blob, name, kept.view())?; }
        } else if (listed(STORED_HEADERS, name)) {
            metadataAdd(mut blob, name, value)?;
        }
    }
    if (userBytes > MAX_USER_METADATA || blob.length > MAX_METADATA_BYTES) {
        return Err(S3Fail.Code(S3Code.MetadataTooLarge));
    }
    return Ok(blob);
}

/// The request's Content-Type, or S3's default.
fn contentTypeOf(req: borrow S3Request, out: borrow mut String) -> Result<void, S3Fail> {
    match (headerOf(req, "content-type")) {
        Some(t) => { appendUtf8(out, t)?; }
        null => { out.append("binary/octet-stream")?; }
    }
    return Ok();
}

/// A single PUT's extras: its checksum, FULL_OBJECT, and no parts.
fn singlePartExtras(
    algorithm: ChecksumAlgorithm,
    value: Slice<u8>,
    out: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    var e = ObjectExtras.none();
    e.algorithm = algorithm;
    e.value.extend(value)?;
    return e.encode(out);
}

/// One step of a PUT body, on a worker thread: hashed, checksummed and written.
fn writeStep(
    writer: borrow mut ObjectWriter,
    sha: borrow mut Sha256,
    checksum: borrow mut RunningChecksum,
    stored: borrow mut RunningChecksum,
    hashing: bool,
    data: Slice<u8>,
) -> Result<void, IoFailure> {
    if (hashing) { sha.update(data); }
    checksum.update(data);
    stored.update(data);
    return writer.write(data);
}

fn appendChecksumName(out: borrow mut Vector<u8>, kind: ChecksumAlgorithm) -> Result<void, AllocError> {
    out.extend("x-amz-checksum-".bytes())?;
    out.extend(match (kind) {
        ChecksumAlgorithm.Crc32 => "crc32".bytes(),
        ChecksumAlgorithm.Crc32c => "crc32c".bytes(),
        ChecksumAlgorithm.Crc64Nvme => "crc64nvme".bytes(),
        ChecksumAlgorithm.Sha256 => "sha256".bytes(),
        ChecksumAlgorithm.None => "".bytes(),
    })?;
    return Ok();
}

/// Under the lock: the bucket exists, the declared size is admitted (ADR-0006), and a writer for it.
async fn startPut(app: borrow S3App, bucket: StringView, size: u64) -> Result<ObjectWriter, S3Fail> {
    var guard = await lockStore(app)?;
    let store = guard.data();
    return match (await Async.blocking(() => beginPut(store, bucket, size))) {
        Ok(w) => Ok(w),
        Err(e) => Err(storeFail(e, 0)),
    };
}

fn beginPut(store: borrow ObjectStore, bucket: StringView, size: u64) -> Result<ObjectWriter, StoreError> {
    if (!store.bucketExists(bucket)?) { return Err(StoreError.NoSuchBucket); }
    store.admit(size)?;
    return store.newWriter();
}

async fn discardPut(app: borrow S3App, finished: borrow FinishedObject) -> Result<void, S3Fail> {
    var guard = await lockStore(app)?;
    let store = guard.data();
    await Async.blocking(() => store.discardFinished(finished));
    return Ok();
}

/// The precondition and the staging under the lock (ADR-0008 §9), then the wait for group commit (ADR-0022).
async fn commitPut(
    app: borrow S3App,
    bucket: StringView,
    key: StringView,
    contentType: StringView,
    metadata: Slice<u8>,
    extras: Slice<u8>,
    finished: borrow FinishedObject,
    condition: PutIf,
    ifMatch: Slice<u8>,
) -> Result<PutOutcome, S3Fail> {
    let outcome = await stagePut(app, bucket, key, contentType, metadata, extras, finished, condition, ifMatch)?;
    await awaitPublished(app, outcome.generation)?;
    return Ok(outcome);
}

async fn stagePut(
    app: borrow S3App,
    bucket: StringView,
    key: StringView,
    contentType: StringView,
    metadata: Slice<u8>,
    extras: Slice<u8>,
    finished: borrow FinishedObject,
    condition: PutIf,
    ifMatch: Slice<u8>,
) -> Result<PutOutcome, S3Fail> {
    var guard = await lockStore(app)?;
    let store = guard.data();
    return match (await Async.blocking(
        () => commitWith(store, bucket, key, contentType, metadata, extras, finished, condition, ifMatch),
    )) {
        Ok(o) => Ok(o),
        Err(e) => Err(storeFail(e, key.length)),
    };
}

fn commitWith(
    store: borrow mut ObjectStore,
    bucket: StringView,
    key: StringView,
    contentType: StringView,
    metadata: Slice<u8>,
    extras: Slice<u8>,
    finished: borrow FinishedObject,
    condition: PutIf,
    ifMatch: Slice<u8>,
) -> Result<PutOutcome, StoreError> {
    let cond = match (resolveCondition(store, bucket, key, condition, ifMatch)) {
        Ok(c) => c,
        Err(e) => {
            store.discardFinished(finished);
            return Err(e);
        }
    };
    return store.putFinishedDeferred(bucket, key, contentType, metadata, extras, finished, cond);
}

// ---- GetObject and HeadObject ----

/// What a GET will send.
struct GetPlan {
    info: ObjectInfo;
    reader: ObjectReader?;
    start: u64;
    end: u64;
    partial: bool;
    /// If-None-Match or If-Modified-Since held: a 304, which still carries the ETag and Last-Modified.
    notModified: bool;
    /// `?partNumber=N` of a multipart object: N (0 otherwise), for x-amz-mp-parts-count and the part's checksum.
    partNumber: u32;
    extras: ObjectExtras;
}

/// `Range: bytes=a-b | a- | -n` against `size`: the half-open range, null for no (or an unreadable) range, or
/// InvalidRange when it cannot be satisfied.
fn parseRange(text: Slice<u8>, size: u64) -> Result<RangeSpan?, S3Code> {
    let t = trimSpaces(text);
    let unit = "bytes=".bytes();
    if (t.length <= unit.length || t[0..unit.length] != unit) { return Ok(null); }
    let spec = t[unit.length..];
    if (pieceEnd(spec, 0, ',') != spec.length) { return Ok(null); } // several ranges: the whole object, as S3
    let dash = pieceEnd(spec, 0, '-');
    if (dash == spec.length) { return Ok(null); }
    let first = spec[0..dash];
    let last = spec[dash + 1..];
    if (first.length == 0) {
        let n = match (parseDecimal(last)) {
            Some(v) => v,
            null => { return Ok(null); }
        };
        if (n == 0 || size == 0) { return Err(S3Code.InvalidRange); }
        let from = if (n >= size) 0 else size - n;
        return Ok(RangeSpan { from: from, to: size });
    }
    let from = match (parseDecimal(first)) {
        Some(v) => v,
        null => { return Ok(null); }
    };
    if (from >= size) { return Err(S3Code.InvalidRange); }
    if (last.length == 0) { return Ok(RangeSpan { from: from, to: size }); }
    let lastByte = match (parseDecimal(last)) {
        Some(v) => v,
        null => { return Ok(null); }
    };
    if (lastByte < from) { return Ok(null); }
    let to = if (lastByte + 1 > size) size else lastByte + 1;
    return Ok(RangeSpan { from: from, to: to });
}

struct RangeSpan {
    from: u64;
    to: u64;
}

/// RFC 9110 §13.2.2's order: If-Match, If-Unmodified-Since, If-None-Match, If-Modified-Since.
fn checkGetConditions(req: borrow S3Request, info: borrow ObjectInfo) -> Result<void, S3Code> =>
    checkConditions(req, info, "if-match", "if-unmodified-since", "if-none-match", "if-modified-since");

/// The four conditionals under the given field names, in RFC 9110's order. A failed If-None-Match or
/// If-Modified-Since is NotModified, which a copy turns into PreconditionFailed.
fn checkConditions(
    req: borrow S3Request,
    info: borrow ObjectInfo,
    ifMatch: StringView,
    ifUnmodifiedSince: StringView,
    ifNoneMatch: StringView,
    ifModifiedSince: StringView,
) -> Result<void, S3Code> {
    let modified = info.mtimeMillis / 1000;
    match (headerOf(req, ifMatch)) {
        Some(t) => {
            if (!etagListMatches(t, borrow info.md5, info.parts)) { return Err(S3Code.PreconditionFailed); }
        }
        null => {
            match (headerOf(req, ifUnmodifiedSince)) {
                Some(t) => {
                    match (parseHttpDate(trimSpaces(t))) {
                        Some(since) => {
                            if (modified > since) { return Err(S3Code.PreconditionFailed); }
                        }
                        null => {}
                    }
                }
                null => {}
            }
        }
    }
    match (headerOf(req, ifNoneMatch)) {
        Some(t) => {
            if (etagListMatches(t, borrow info.md5, info.parts)) { return Err(S3Code.NotModified); }
        }
        null => {
            match (headerOf(req, ifModifiedSince)) {
                Some(t) => {
                    match (parseHttpDate(trimSpaces(t))) {
                        Some(since) => {
                            if (modified <= since) { return Err(S3Code.NotModified); }
                        }
                        null => {}
                    }
                }
                null => {}
            }
        }
    }
    return Ok();
}

/// Under the lock, with no I/O: the object's metadata, its conditions and its range. `openGet` adds the reader.
fn planGet(store: borrow ObjectStore, req: borrow S3Request) -> Result<GetPlan, S3Fail> {
    let bucket = req.bucket.view();
    let key = req.key.view();
    let info = match (store.headObject(bucket, key)) {
        Ok(i) => i,
        Err(e) => { return Err(storeFail(e, key.length)); }
    };
    match (checkGetConditions(req, borrow info)) {
        Ok() => {}
        Err(S3Code.NotModified) => {
            return Ok(GetPlan {
                info: info,
                reader: null,
                start: 0,
                end: 0,
                partial: false,
                notModified: true,
                partNumber: 0,
                extras: ObjectExtras.none(),
            });
        }
        Err(code) => { return Err(S3Fail.Code(code)); }
    }
    var start: u64 = 0;
    var end = info.size;
    var partial = false;
    match (headerOf(req, "range")) {
        Some(t) => {
            match (parseRange(t, info.size)) {
                Ok(Some(r)) => {
                    start = r.from;
                    end = r.to;
                    partial = true;
                }
                Ok(null) => {}
                Err(code) => { return Err(S3Fail.Code(code)); }
            }
        }
        null => {}
    }
    let extras = match (decodeExtras(info.extras.view())) {
        Ok(e) => e,
        Err(_) => { return Err(S3Fail.Code(S3Code.InternalError)); }
    };
    // `?partNumber=N`: that part of a multipart object, or, for one PUT, the whole object as part 1 (ADR-0015).
    var partNumber: u32 = 0;
    match (paramOf(req, "partNumber")) {
        Some(t) => {
            if (partial) { return Err(S3Fail.Code(S3Code.InvalidRequest)); } // not with Range
            let n = match (parseDecimal(t)) {
                Some(v) => v,
                null => { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            };
            if (n < 1 || n > MAX_PART_NUMBER as u64) { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            if (info.parts == 0) {
                if (n != 1) { return Err(S3Fail.Code(S3Code.InvalidPart)); }
            } else {
                // A multipart version written before ADR-0015 kept no part layout.
                if (extras.partSizes.length == 0) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
                if (n > extras.partSizes.length as u64) { return Err(S3Fail.Code(S3Code.InvalidPart)); }
                for (i in 0..truncate<usize>(n - 1)) { start += extras.partSizes[i]; }
                end = start + extras.partSizes[truncate<usize>(n - 1)];
                partial = true;
                partNumber = truncate<u32>(n);
            }
        }
        null => {}
    }
    return Ok(GetPlan {
        info: info,
        reader: null,
        start: start,
        end: end,
        partial: partial,
        notModified: false,
        partNumber: partNumber,
        extras: extras,
    });
}

async fn openGet(app: borrow S3App, req: borrow S3Request, withBody: bool) -> Result<GetPlan, S3Fail> {
    var guard = await lockStore(app)?;
    let store = guard.data();
    // The plan is an index lookup, on the event loop. Only a body's reader may do I/O (an inline record's read, or
    // an extent reader's open), so only a GET with bytes to send takes a worker thread (ADR-0023).
    var plan = planGet(store, req)?;
    if (withBody && !plan.notModified && plan.end > plan.start) {
        let bucket = req.bucket.view();
        let key = req.key.view();
        let start = plan.start;
        let end = plan.end;
        plan.reader = match (await Async.blocking(() => store.openReader(bucket, key, start, end))) {
            Ok(r) => r,
            Err(e) => { return Err(storeFail(e, key.length)); }
        };
    }
    return Ok(plan);
}

async fn getObject(app: borrow S3App, req: borrow S3Request, exchange: borrow mut Exchange) -> Result<void, S3Fail> {
    let withBody = !isMethod(req.method, Method.Head);
    var plan = await openGet(app, req, withBody)?;
    var field = Vector<u8>.create();
    appendEtag(mut field, borrow plan.info.md5, plan.info.parts)?;
    exchange.header("etag", field.view())?;
    field.clear();
    appendHttpDate(mut field, plan.info.mtimeMillis / 1000)?;
    exchange.header("last-modified", field.view())?;
    if (plan.notModified) {
        await exchange.send(statusOf(304), "".bytes())?;
        return Ok();
    }
    exchange.header("accept-ranges", "bytes".bytes())?;
    if (plan.partNumber > 0) {
        field.clear();
        appendDecimal(mut field, plan.info.parts as u64)?;
        exchange.header("x-amz-mp-parts-count", field.view())?;
    }
    // Checksums only when asked for, and only for what they cover: the whole object, or a part's own (ADR-0015).
    let checksums = equalsIgnoreCase(trimSpaces(headerOf(req, "x-amz-checksum-mode") ?? "".bytes()), "ENABLED".bytes());
    if (checksums) {
        if (plan.partNumber > 0) {
            let n = checksumLength(plan.extras.algorithm);
            let i = (plan.partNumber - 1) as usize;
            if (n > 0 && plan.extras.partChecksums.length >= (i + 1) * n) {
                var part = ObjectExtras.none();
                part.algorithm = plan.extras.algorithm;
                part.kind = plan.extras.kind;
                part.value.extend(plan.extras.partChecksums.view()[i * n..(i + 1) * n])?;
                sendChecksumHeaders(exchange, borrow part)?;
            }
        } else if (!plan.partial) {
            sendChecksumHeaders(exchange, borrow plan.extras)?;
        }
    }
    match (paramOf(req, "response-content-type")) {
        Some(t) => { exchange.header("content-type", t)?; }
        null => {
            if (plan.info.contentType.length > 0) {
                exchange.header("content-type", plan.info.contentType.view())?;
            }
        }
    }
    // Stored fields, except those a `response-*` parameter overrides.
    match (metadataPairs(plan.info.metadata.view())) {
        Ok(pairs) => {
            var param = Vector<u8>.create();
            for (i in 0..pairs.length) {
                let name = pairs[i].name.view();
                param.clear();
                param.extend("response-".bytes())?;
                param.extend(name)?;
                let overridden = match (StringView.fromUtf8(param.view())) {
                    Some(p) => listed(STORED_HEADERS, name) && paramOf(req, p).isSome(),
                    null => false,
                };
                if (overridden) { continue; }
                // Tags are not headers: their count is (ADR-0017).
                if (name == TAGS_FIELD.bytes()) {
                    var count = Vector<u8>.create();
                    appendDecimal(mut count, tagCount(pairs[i].value.view()))?;
                    exchange.header("x-amz-tagging-count", count.view())?;
                    continue;
                }
                match (StringView.fromUtf8(name)) {
                    Some(n) => { exchange.header(n, pairs[i].value.view())?; }
                    null => {}
                }
            }
        }
        Err(_) => { return Err(S3Fail.Code(S3Code.InternalError)); }
    }
    responseOverride(req, exchange, "response-content-language", "content-language")?;
    responseOverride(req, exchange, "response-expires", "expires")?;
    responseOverride(req, exchange, "response-cache-control", "cache-control")?;
    responseOverride(req, exchange, "response-content-disposition", "content-disposition")?;
    responseOverride(req, exchange, "response-content-encoding", "content-encoding")?;
    if (plan.partial) {
        field.clear();
        field.extend("bytes ".bytes())?;
        appendDecimal(mut field, plan.start)?;
        field.push('-')?;
        appendDecimal(mut field, plan.end - 1)?;
        field.push('/')?;
        appendDecimal(mut field, plan.info.size)?;
        exchange.header("content-range", field.view())?;
        exchange.setStatus(statusOf(206));
    } else {
        exchange.setStatus(Status.ok());
    }
    exchange.setContentLength(plan.end - plan.start);
    match (plan.reader.asBorrowMut()) {
        Some(reader) => {
            // An inline object is already in memory: sent as it is, without a worker thread per read.
            match (reader.takeInline()) {
                Some(bytes) => {
                    await exchange.write(bytes.view())?;
                    await exchange.finish()?;
                    return Ok();
                }
                null => {}
            }
            var buf = Vector<u8>.create();
            buf.resize(bodyStep(plan.end - plan.start), 0)?;
            while (true) {
                let chunk = buf.viewMut();
                let got = await Async.blocking(() => reader.read(chunk));
                let n = match (got) {
                    Ok(n) => n,
                    Err(e) => { return Err(storeFail(e, 0)); }
                };
                if (n == 0) { break; }
                await exchange.write(buf.view()[0..n])?;
            }
        }
        null => {}
    }
    await exchange.finish()?;
    return Ok();
}

/// A `response-*` query parameter sets its response field.
fn responseOverride(
    req: borrow S3Request,
    exchange: borrow mut Exchange,
    param: StringView,
    field: StringView,
) -> Result<void, S3Fail> {
    match (paramOf(req, param)) {
        Some(v) => { exchange.header(field, v)?; }
        null => {}
    }
    return Ok();
}

// ---- GetObjectAttributes (ADR-0015) ----

/// GetObjectAttributes: `x-amz-object-attributes` names any of ETag, Checksum, ObjectParts, StorageClass and
/// ObjectSize. ObjectParts (a multipart object's) pages with `x-amz-max-parts` and `x-amz-part-number-marker`.
async fn getObjectAttributes(
    app: borrow S3App,
    req: borrow S3Request,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    let wanted = match (headerOf(req, "x-amz-object-attributes")) {
        Some(t) => t,
        null => { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
    };
    var maxParts: u64 = 1000;
    match (headerOf(req, "x-amz-max-parts")) {
        Some(t) => {
            match (parseDecimal(trimSpaces(t))) {
                Some(v) => { maxParts = v.min(1000); }
                null => { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            }
        }
        null => {}
    }
    var marker: u64 = 0;
    match (headerOf(req, "x-amz-part-number-marker")) {
        Some(t) => {
            match (parseDecimal(trimSpaces(t))) {
                Some(v) => { marker = v; }
                null => { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            }
        }
        null => {}
    }
    let info = await objectInfo(app, req.bucket.view(), req.key.view())?;
    let extras = match (decodeExtras(info.extras.view())) {
        Ok(e) => e,
        Err(_) => { return Err(S3Fail.Code(S3Code.InternalError)); }
    };
    var field = Vector<u8>.create();
    appendHttpDate(mut field, info.mtimeMillis / 1000)?;
    exchange.header("last-modified", field.view())?;
    var body = Vector<u8>.create();
    xmlHead(mut body, "GetObjectAttributesResponse")?;
    let names = StringView.fromUtf8(wanted) ?? "";
    if (listedTrimmed(names, "ETag")) {
        var etag = Vector<u8>.create();
        appendEtag(mut etag, borrow info.md5, info.parts)?;
        xmlElement(mut body, "ETag", etag.view()[1..etag.length - 1], false)?; // without its quotes, as S3 sends it
    }
    if (listedTrimmed(names, "Checksum")) {
        match (extras.algorithm) {
            ChecksumAlgorithm.None => {}
            _ => {
                body.extend("<Checksum>".bytes())?;
                xmlChecksum(mut body, info.extras.view())?;
                body.extend("</Checksum>".bytes())?;
            }
        }
    }
    if (listedTrimmed(names, "ObjectParts") && info.parts > 0 && extras.partSizes.length > 0) {
        let count = extras.partSizes.length as u64;
        let n = checksumLength(extras.algorithm);
        body.extend("<ObjectParts>".bytes())?;
        xmlDecimal(mut body, "PartsCount", count)?;
        xmlDecimal(mut body, "PartNumberMarker", marker)?;
        var last: u64 = marker;
        var shown: u64 = 0;
        var parts = Vector<u8>.create();
        var number = marker + 1;
        while (number <= count && shown < maxParts) {
            let i = truncate<usize>(number - 1);
            parts.extend("<Part>".bytes())?;
            xmlDecimal(mut parts, "PartNumber", number)?;
            xmlDecimal(mut parts, "Size", extras.partSizes[i])?;
            if (n > 0 && extras.partChecksums.length >= (i + 1) * n) {
                xmlPartChecksum(mut parts, extras.algorithm, extras.partChecksums.view()[i * n..(i + 1) * n])?;
            }
            parts.extend("</Part>".bytes())?;
            last = number;
            shown += 1;
            number += 1;
        }
        if (shown > 0) { xmlDecimal(mut body, "NextPartNumberMarker", last)?; }
        xmlDecimal(mut body, "MaxParts", maxParts)?;
        xmlBool(mut body, "IsTruncated", last < count)?;
        body.extend(parts.view())?;
        body.extend("</ObjectParts>".bytes())?;
    }
    if (listedTrimmed(names, "StorageClass")) { body.extend("<StorageClass>STANDARD</StorageClass>".bytes())?; }
    if (listedTrimmed(names, "ObjectSize")) { xmlDecimal(mut body, "ObjectSize", info.size)?; }
    body.extend("</GetObjectAttributesResponse>".bytes())?;
    return await sendXml(exchange, borrow body);
}

/// Whether a comma-separated list names `name`, ignoring spaces around the items.
fn listedTrimmed(list: StringView, name: StringView) -> bool {
    let l = list.bytes();
    var at: usize = 0;
    while (at < l.length) {
        let end = pieceEnd(l, at, ',');
        if (trimSpaces(l[at..end]) == name.bytes()) { return true; }
        at = end + 1;
    }
    return false;
}
