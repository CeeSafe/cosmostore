// Iceberg views (ADR-0134 §2, §3).
import web_core;
import web_http;

fn viewSegments(names: Slice<StringView>) -> Vector<Vector<u8>> {
    var out = Vector<Vector<u8>>.create();
    for (n in names) { out.push(copyBytes(n.bytes())!)!; }
    return out;
}

const VIEW_BODY: StringView =
    "{\"name\":\"v\",\"schema\":{\"type\":\"struct\",\"schema-id\":0,\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"}]},\"view-version\":{\"version-id\":1,\"schema-id\":0,\"timestamp-ms\":1000,\"summary\":{},\"default-namespace\":[\"ns\"],\"representations\":[{\"type\":\"sql\",\"sql\":\"select a from t\",\"dialect\":\"spark\"}]},\"properties\":{\"comment\":\"one\"}}";

/// A view made, loaded, listed, replaced by a commit (a new version made current), refused a commit whose
/// requirement does not hold, its name refused to a table and a table's to it, renamed, and dropped.
@test
fn icebergViewsLifecycle() -> Result<void, TestFailure> {
    let dir = scratchDirectory("iceberg-views");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    let hidden = tableWarehouseBucket("cat".bytes())!;
    s.createBucket(catalogText(hidden.view()))!;
    let none = Vector<MasterKey>.create();
    let noKeys = WarehouseKeys { sse: none.view(), kms: none.view() };
    let caller = tablesCaller("AKIAVIEWS");
    let _ = icebergCreateNamespace(mut s, "cat".bytes(), "{\"namespace\":[\"ns\"]}".bytes())!;
    let views = viewSegments(["views"][..]);
    let made = icebergViews(
        mut s,
        Method.Post,
        "cat".bytes(),
        "ns".bytes(),
        views.view(),
        VIEW_BODY.bytes(),
        borrow caller,
        borrow noKeys,
    )!;
    Check.equalU64(200, made.status as u64)?;
    let first = parseJson(made.body.view())!!;
    let uuid = copyBytes(jsonMemberText(jsonMember(borrow first, "metadata")!, "view-uuid")!)!;
    // Its name is taken: a view again, or a table.
    Check.equalU64(
        409,
        icebergViews(
            mut s,
            Method.Post,
            "cat".bytes(),
            "ns".bytes(),
            views.view(),
            VIEW_BODY.bytes(),
            borrow caller,
            borrow noKeys,
        )!.status as u64,
    )?;
    let table = icebergCreateTable(
        mut s,
        "cat".bytes(),
        "ns".bytes(),
        "{\"name\":\"v\",\"schema\":{\"type\":\"struct\",\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"}]}}".bytes(),
        borrow noKeys,
    )!;
    Check.equalU64(409, table.status as u64)?;
    // Listed and loaded.
    let listed = parseJson(
        icebergViews(
            mut s,
            Method.Get,
            "cat".bytes(),
            "ns".bytes(),
            views.view(),
            "".bytes(),
            borrow caller,
            borrow noKeys,
        )!.body.view(),
    )!!;
    Check.equalU64(1, arrayLength(borrow listed, "identifiers") as u64)?;
    let one = viewSegments(["views", "v"][..]);
    let loaded = parseJson(
        icebergViews(
            mut s,
            Method.Get,
            "cat".bytes(),
            "ns".bytes(),
            one.view(),
            "".bytes(),
            borrow caller,
            borrow noKeys,
        )!.body.view(),
    )!!;
    Check.equalBytes(uuid.view(), jsonMemberText(jsonMember(borrow loaded, "metadata")!, "view-uuid")!)?;
    // A new version, made current.
    var commit = copyBytes("{\"requirements\":[{\"type\":\"assert-view-uuid\",\"uuid\":\"".bytes())!;
    commit.extend(uuid.view())!;
    commit.extend(
        "\"}],\"updates\":[{\"action\":\"add-view-version\",\"view-version\":{\"version-id\":-1,\"schema-id\":0,\"timestamp-ms\":2000,\"summary\":{},\"default-namespace\":[\"ns\"],\"representations\":[{\"type\":\"sql\",\"sql\":\"select a from t where a > 1\",\"dialect\":\"spark\"}]}},{\"action\":\"set-current-view-version\",\"view-version-id\":-1},{\"action\":\"set-properties\",\"updates\":{\"comment\":\"two\"}}]}".bytes(),
    )!;
    let committed = icebergViews(
        mut s,
        Method.Post,
        "cat".bytes(),
        "ns".bytes(),
        one.view(),
        commit.view(),
        borrow caller,
        borrow noKeys,
    )!;
    Check.equalU64(200, committed.status as u64)?;
    let after = parseJson(committed.body.view())!!;
    let meta = jsonMember(borrow after, "metadata")!;
    Check.equalU64(2, truncate<u64>(jsonMemberI64(meta, "current-version-id")!))?;
    Check.equalU64(2, arrayLength(meta, "versions") as u64)?;
    Check.equalU64(2, arrayLength(meta, "version-log") as u64)?;
    Check.equalBytes("two".bytes(), jsonMemberText(jsonMember(meta, "properties")!, "comment")!)?;
    Check.isTrue(
        findBytes(jsonMemberText(borrow after, "metadata-location")!, "/metadata/00001-".bytes(), 0).isSome(),
        "version 1",
    )?;
    // A requirement that does not hold.
    let stale =
        "{\"requirements\":[{\"type\":\"assert-view-uuid\",\"uuid\":\"00000000-0000-4000-8000-000000000000\"}],\"updates\":[]}";
    Check.equalU64(
        409,
        icebergViews(
            mut s,
            Method.Post,
            "cat".bytes(),
            "ns".bytes(),
            one.view(),
            stale.bytes(),
            borrow caller,
            borrow noKeys,
        )!.status as u64,
    )?;
    // A namespace with a view is not dropped.
    match (deleteNamespace(mut s, "cat".bytes(), "ns".bytes())) {
        Err(TablesError.Conflict) => {}
        _ => { return Err(TestFailure.create("a namespace with a view dropped")); }
    }
    // Renamed, then dropped.
    let rename =
        "{\"source\":{\"namespace\":[\"ns\"],\"name\":\"v\"},\"destination\":{\"namespace\":[\"ns\"],\"name\":\"w\"}}";
    Check.equalU64(204, icebergRenameView(mut s, "cat".bytes(), rename.bytes(), borrow caller)!.status as u64)?;
    Check.isFalse(viewExists(borrow s, hidden.view(), "ns".bytes(), "v".bytes())!, "the old name gone")?;
    let renamed = viewSegments(["views", "w"][..]);
    let dropped = icebergViews(
        mut s,
        Method.Delete,
        "cat".bytes(),
        "ns".bytes(),
        renamed.view(),
        "".bytes(),
        borrow caller,
        borrow noKeys,
    )!;
    Check.equalU64(204, dropped.status as u64)?;
    Check.isTrue(dropped.purgeId.length > 0, "its files purged after")?;
    Check.equalU64(
        404,
        icebergViews(
            mut s,
            Method.Get,
            "cat".bytes(),
            "ns".bytes(),
            renamed.view(),
            "".bytes(),
            borrow caller,
            borrow noKeys,
        )!.status as u64,
    )?;
    removeTree(dir.view());
    return Ok();
}

/// Views are authorized on `<bucket>/view/<id>` by their own actions (ADR-0134 §4): a Deny on views refuses them and
/// not tables, a table's Deny does not reach a view, and a user's Allow of tables is not one of views.
@test
fn viewsAuthorizedOnTheirOwn() -> Result<void, TestFailure> {
    let dir = scratchDirectory("views-authorized");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    s.createBucket("sales--table-s3")!;
    let view = "11111111-2222-4333-8444-555555555555";
    let one = tablesCaller("AKIAONE");
    Check.isTrue(
        checkTablesView(borrow s, borrow one, "s3tables:GetView", "sales".bytes(), view.bytes()).isOk(),
        "no policy",
    )?;
    putPolicy(
        mut s,
        TABLE_BUCKET_POLICY_KEY,
        "{\"Statement\":[{\"Effect\":\"Deny\",\"Principal\":\"*\",\"Action\":\"s3tables:*\",\"Resource\":\"arn:aws:s3tables:us-east-1:0:bucket/sales/view/*\"},{\"Effect\":\"Deny\",\"Principal\":\"*\",\"Action\":\"s3tables:GetTable\",\"Resource\":\"arn:aws:s3tables:us-east-1:0:bucket/sales/table/*\"}]}",
    );
    Check.isFalse(
        checkTablesView(borrow s, borrow one, "s3tables:GetView", "sales".bytes(), view.bytes()).isOk(),
        "a view's Deny",
    )?;
    Check.isTrue(
        checkTables(borrow s, borrow one, "s3tables:GetTableMetadataLocation", "sales".bytes(), view.bytes()).isOk(),
        "not a table's",
    )?;
    putPolicy(
        mut s,
        TABLE_BUCKET_POLICY_KEY,
        "{\"Statement\":{\"Effect\":\"Deny\",\"Principal\":\"*\",\"Action\":\"s3tables:*\",\"Resource\":\"arn:aws:s3tables:us-east-1:0:bucket/sales/table/*\"}}",
    );
    Check.isTrue(
        checkTablesView(borrow s, borrow one, "s3tables:GetView", "sales".bytes(), view.bytes()).isOk(),
        "a table's Deny is not a view's",
    )?;
    let _ = s.deleteObject("sales--table-s3", TABLE_BUCKET_POLICY_KEY)!;
    let tables = identityCaller(
        "analyst",
        "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3tables:*\",\"Resource\":\"arn:aws:s3tables:*:*:bucket/sales/table/*\"}}",
        false,
        "",
    );
    Check.isFalse(
        checkTablesView(borrow s, borrow tables, "s3tables:GetView", "sales".bytes(), view.bytes()).isOk(),
        "a tables' Allow",
    )?;
    let views = identityCaller(
        "analyst",
        "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3tables:GetView\",\"Resource\":\"arn:aws:s3tables:*:*:bucket/sales/view/*\"}}",
        false,
        "",
    );
    Check.isTrue(
        checkTablesView(borrow s, borrow views, "s3tables:GetView", "sales".bytes(), view.bytes()).isOk(),
        "a views' Allow",
    )?;
    removeTree(dir.view());
    return Ok();
}

fn tablesPathRequest(path: StringView) -> S3Request {
    var req = bareRequest();
    req.rawPath = copyBytes(path.bytes())!;
    return req;
}

/// A nested namespace's table is renamed by the catalog, within it and out of it (the M34 exit review's M1); S3
/// Tables' own API names one level only, as AWS (its M2).
@test
fn nestedNamespacesAtTheEdges() -> Result<void, TestFailure> {
    let dir = scratchDirectory("nested-edges");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    let hidden = tableWarehouseBucket("cat".bytes())!;
    s.createBucket(catalogText(hidden.view()))!;
    let none = Vector<MasterKey>.create();
    let noKeys = WarehouseKeys { sse: none.view(), kms: none.view() };
    let caller = tablesCaller("AKIANESTED");
    let _ = icebergCreateNamespace(mut s, "cat".bytes(), "{\"namespace\":[\"a\"]}".bytes())!;
    let _ = icebergCreateNamespace(mut s, "cat".bytes(), "{\"namespace\":[\"a\",\"b\"]}".bytes())!;
    let made = icebergCreateTable(
        mut s,
        "cat".bytes(),
        [0x61u8, 0x1F, 0x62][..],
        "{\"name\":\"t\",\"schema\":{\"type\":\"struct\",\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"}]}}".bytes(),
        borrow noKeys,
    )!;
    Check.equalU64(200, made.status as u64)?;
    let within =
        "{\"source\":{\"namespace\":[\"a\",\"b\"],\"name\":\"t\"},\"destination\":{\"namespace\":[\"a\",\"b\"],\"name\":\"u\"}}";
    Check.equalU64(204, icebergRename(mut s, "cat".bytes(), within.bytes(), borrow caller)!.status as u64)?;
    let out =
        "{\"source\":{\"namespace\":[\"a\",\"b\"],\"name\":\"u\"},\"destination\":{\"namespace\":[\"a\"],\"name\":\"u\"}}";
    Check.equalU64(204, icebergRename(mut s, "cat".bytes(), out.bytes(), borrow caller)!.status as u64)?;
    let tableKey = catalogKey(CATALOG_TABLES, "a".bytes(), "u".bytes())!;
    Check.isTrue(readRecord(borrow s, hidden.view(), tableKey.view())!.isSome(), "renamed into a")?;
    // S3 Tables' API: a nested namespace's name is BadRequest.
    let creds = Vector<Credential>.create();
    let arn = "arn%3Aaws%3As3tables%3Aus-east-1%3A000000000000%3Abucket%2Fcat";
    for (path in ["/namespaces/", "/tables/"]) {
        var p = copyBytes(path.bytes())!;
        p.extend(arn.bytes())!;
        p.extend("/a%1Fb".bytes())!;
        let req = tablesPathRequest(StringView.fromUtf8(p.view()) ?? "");
        match (routeTablesSync(mut s, borrow req, "".bytes(), borrow caller, creds.view(), borrow noKeys)) {
            Err(TablesError.BadRequest) => {}
            _ => { return Err(TestFailure.create("a nested namespace through S3 Tables' API")); }
        }
    }
    removeTree(dir.view());
    return Ok();
}

/// S3 Tables' ListNamespaces of one page: its namespaces' names, and its token or none.
fn namespacesPage(
    s: borrow mut ObjectStore,
    max: StringView,
    token: Slice<u8>,
) -> Result<Json, TestFailure> {
    var req = tablesPathRequest("/namespaces/arn%3Aaws%3As3tables%3Aus-east-1%3A000000000000%3Abucket%2Fcat");
    req.query.push(policyParam("maxNamespaces", max))!;
    if (token.length > 0) { req.query.push(policyParam("continuationToken", StringView.fromUtf8(token) ?? ""))!; }
    let none = Vector<MasterKey>.create();
    let noKeys = WarehouseKeys { sse: none.view(), kms: none.view() };
    let creds = Vector<Credential>.create();
    let caller = tablesCaller("AKIAPAGES");
    return match (routeTablesSync(s, borrow req, "".bytes(), borrow caller, creds.view(), borrow noKeys)) {
        Ok(a) => Ok(parseJson(a.body.view())!!),
        Err(_) => Err(TestFailure.create("ListNamespaces failed")),
    };
}

/// The first namespace's name in a page, and how many it has.
fn pageNames(page: borrow Json, out: borrow mut Vector<u8>) -> usize {
    match (jsonMember(page, "namespaces")) {
        Some(Json.Array(items)) => {
            for (i in 0..items.length) {
                match (jsonMember(borrow items[i], "namespace")) {
                    Some(Json.Array(levels)) => {
                        match (borrow levels[0]) {
                            Json.Text(t) => {
                                out.extend(t.view())!;
                                out.push(',')!;
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
            return items.length;
        }
        _ => { return 0; }
    }
}

/// S3 Tables' ListNamespaces pages are full, or the last, past the nested namespaces they skip (M34's B4,
/// ADR-0136 §1).
@test
fn namespacePagesSkipNested() -> Result<void, TestFailure> {
    let dir = scratchDirectory("namespace-pages");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    let hidden = tableWarehouseBucket("cat".bytes())!;
    s.createBucket(catalogText(hidden.view()))!;
    let _ = icebergCreateNamespace(mut s, "cat".bytes(), "{\"namespace\":[\"a\"]}".bytes())!;
    for (child in ["b1", "b2", "b3"]) {
        var body = copyBytes("{\"namespace\":[\"a\",\"".bytes())!;
        body.extend(child.bytes())!;
        body.extend("\"]}".bytes())!;
        let _ = icebergCreateNamespace(mut s, "cat".bytes(), body.view())!;
    }
    let _ = icebergCreateNamespace(mut s, "cat".bytes(), "{\"namespace\":[\"z\"]}".bytes())!;
    // One page of two: both, and no token.
    let whole = namespacesPage(mut s, "2", "".bytes())?;
    var names = Vector<u8>.create();
    Check.equalU64(2, pageNames(borrow whole, mut names) as u64)?;
    Check.equalBytes("a,z,".bytes(), names.view())?;
    Check.isTrue(jsonMember(borrow whole, "continuationToken").isNull(), "no token on the last page")?;
    // Pages of one: a, then z, then no token.
    let first = namespacesPage(mut s, "1", "".bytes())?;
    var one = Vector<u8>.create();
    Check.equalU64(1, pageNames(borrow first, mut one) as u64)?;
    Check.equalBytes("a,".bytes(), one.view())?;
    let token = copyBytes(jsonMemberText(borrow first, "continuationToken")!)!;
    let second = namespacesPage(mut s, "1", token.view())?;
    var two = Vector<u8>.create();
    Check.equalU64(1, pageNames(borrow second, mut two) as u64)?;
    Check.equalBytes("z,".bytes(), two.view())?;
    Check.isTrue(jsonMember(borrow second, "continuationToken").isNull(), "z's page is the last")?;
    removeTree(dir.view());
    return Ok();
}

/// A view commit's edges (the M34 exit review's L2, L3): no updates write no file, the current version made current
/// again logs nothing, and its location stays its warehouse.
@test
fn viewCommitEdges() -> Result<void, TestFailure> {
    let dir = scratchDirectory("view-commits");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    let hidden = tableWarehouseBucket("cat".bytes())!;
    s.createBucket(catalogText(hidden.view()))!;
    let none = Vector<MasterKey>.create();
    let noKeys = WarehouseKeys { sse: none.view(), kms: none.view() };
    let caller = tablesCaller("AKIAEDGES");
    let _ = icebergCreateNamespace(mut s, "cat".bytes(), "{\"namespace\":[\"ns\"]}".bytes())!;
    let views = viewSegments(["views"][..]);
    let made = icebergViews(
        mut s,
        Method.Post,
        "cat".bytes(),
        "ns".bytes(),
        views.view(),
        VIEW_BODY.bytes(),
        borrow caller,
        borrow noKeys,
    )!;
    let first = parseJson(made.body.view())!!;
    let location = copyBytes(jsonMemberText(borrow first, "metadata-location")!)!;
    let one = viewSegments(["views", "v"][..]);
    let empty = icebergViews(
        mut s,
        Method.Post,
        "cat".bytes(),
        "ns".bytes(),
        one.view(),
        "{\"updates\":[]}".bytes(),
        borrow caller,
        borrow noKeys,
    )!;
    Check.equalBytes(location.view(), jsonMemberText(borrow parseJson(empty.body.view())!!, "metadata-location")!)?;
    let again = "{\"updates\":[{\"action\":\"set-current-view-version\",\"view-version-id\":1}]}";
    let same = parseJson(
        icebergViews(
            mut s,
            Method.Post,
            "cat".bytes(),
            "ns".bytes(),
            one.view(),
            again.bytes(),
            borrow caller,
            borrow noKeys,
        )!.body.view(),
    )!!;
    Check.equalU64(1, arrayLength(jsonMember(borrow same, "metadata")!, "version-log") as u64)?;
    let moved = "{\"updates\":[{\"action\":\"set-location\",\"location\":\"s3://elsewhere/x\"}]}";
    Check.equalU64(
        400,
        icebergViews(
            mut s,
            Method.Post,
            "cat".bytes(),
            "ns".bytes(),
            one.view(),
            moved.bytes(),
            borrow caller,
            borrow noKeys,
        )!.status as u64,
    )?;
    removeTree(dir.view());
    return Ok();
}

/// One view call on `cat`'s namespace `ns`, as `AKIABUILDER`.
fn viewCall(
    s: borrow mut ObjectStore,
    m: Method,
    names: Slice<StringView>,
    body: StringView,
    keys: borrow WarehouseKeys,
) -> TablesAnswer {
    let caller = tablesCaller("AKIABUILDER");
    let segs = viewSegments(names);
    return icebergViews(s, m, "cat".bytes(), "ns".bytes(), segs.view(), body.bytes(), borrow caller, keys)!;
}

/// A commit to view `v`: its metadata, or its status when it is not 200.
fn viewCommit(s: borrow mut ObjectStore, body: StringView, keys: borrow WarehouseKeys) -> Result<Json, u64> {
    let a = viewCall(s, Method.Post, ["views", "v"][..], body, keys);
    if (a.status != 200) { return Err(a.status as u64); }
    let j = parseJson(a.body.view())!!;
    return Ok(cloneJson(jsonMember(borrow j, "metadata")!)!);
}

fn viewStatus(s: borrow mut ObjectStore, body: StringView, keys: borrow WarehouseKeys) -> u64 => match (viewCommit(
    s,
    body,
    keys,
)) {
    Ok(_) => 200,
    Err(status) => status,
};

/// A view's commits as Iceberg Java's `ViewMetadata.Builder` makes them (M34's B1, ADR-0136 §2): an equal schema and
/// an equal version reused, the log at the version's time, old versions expired past `version.history.num-entries`
/// and the log cut at the first one kept after them, a version without a summary refused.
@test
fn viewMetadataAsJavaBuilds() -> Result<void, TestFailure> {
    let dir = scratchDirectory("view-builder");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    let hidden = tableWarehouseBucket("cat".bytes())!;
    s.createBucket(catalogText(hidden.view()))!;
    let none = Vector<MasterKey>.create();
    let noKeys = WarehouseKeys { sse: none.view(), kms: none.view() };
    let _ = icebergCreateNamespace(mut s, "cat".bytes(), "{\"namespace\":[\"ns\"]}".bytes())!;
    let made = viewCall(mut s, Method.Post, ["views"][..], VIEW_BODY, borrow noKeys);
    Check.equalU64(200, made.status as u64)?;
    let created = parseJson(made.body.view())!!;
    let log0 = jsonMember(jsonMember(borrow created, "metadata")!, "version-log")!;
    match (log0) {
        Json.Array(es) => { Check.isTrue(jsonMemberI64(borrow es[0], "timestamp-ms") == Some(1000), "at its time")?; }
        _ => { return Err(TestFailure.create("no version log")); }
    }
    // The same schema again, and a new version on it: one schema, two versions, logged at the version's time.
    let replace =
        "{\"updates\":[{\"action\":\"add-schema\",\"schema\":{\"type\":\"struct\",\"schema-id\":-1,\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"}]}},{\"action\":\"add-view-version\",\"view-version\":{\"version-id\":-1,\"schema-id\":-1,\"timestamp-ms\":2000,\"summary\":{},\"default-namespace\":[\"ns\"],\"representations\":[{\"type\":\"sql\",\"sql\":\"select a from t where a > 1\",\"dialect\":\"spark\"}]}},{\"action\":\"set-current-view-version\",\"view-version-id\":-1}]}";
    let second = match (viewCommit(mut s, replace, borrow noKeys)) {
        Ok(m) => m,
        Err(status) => { return Err(TestFailure.create("the replace was refused")); }
    };
    Check.equalU64(1, arrayLength(borrow second, "schemas") as u64)?;
    Check.equalU64(2, arrayLength(borrow second, "versions") as u64)?;
    Check.isTrue(jsonMemberI64(borrow second, "current-version-id") == Some(2), "version 2 current")?;
    Check.isTrue(versionTime(borrow second, 2, 0) == 2000, "its time kept")?;
    match (jsonMember(borrow second, "version-log")!) {
        Json.Array(es) => {
            Check.isTrue(jsonMemberI64(borrow es[es.length - 1], "timestamp-ms") == Some(2000), "logged at it")?;
        }
        _ => { return Err(TestFailure.create("no version log")); }
    }
    // The same version again, at another time: reused, nothing new current.
    let again =
        "{\"updates\":[{\"action\":\"add-view-version\",\"view-version\":{\"version-id\":-1,\"schema-id\":0,\"timestamp-ms\":3000,\"summary\":{},\"default-namespace\":[\"ns\"],\"representations\":[{\"type\":\"sql\",\"sql\":\"select a from t where a > 1\",\"dialect\":\"spark\"}]}},{\"action\":\"set-current-view-version\",\"view-version-id\":-1}]}";
    let third = match (viewCommit(mut s, again, borrow noKeys)) {
        Ok(m) => m,
        Err(_) => { return Err(TestFailure.create("the same version was refused")); }
    };
    Check.equalU64(2, arrayLength(borrow third, "versions") as u64)?;
    Check.equalU64(2, arrayLength(borrow third, "version-log") as u64)?;
    // A history of 2: a third version expires the first, and the log keeps 2 and 3.
    let two = "{\"updates\":[{\"action\":\"set-properties\",\"updates\":{\"version.history.num-entries\":\"2\"}}]}";
    Check.equalU64(200, viewStatus(mut s, two, borrow noKeys))?;
    let next =
        "{\"updates\":[{\"action\":\"add-view-version\",\"view-version\":{\"version-id\":-1,\"schema-id\":0,\"timestamp-ms\":4000,\"summary\":{\"engine-name\":\"spark\"},\"default-namespace\":[\"ns\"],\"representations\":[{\"type\":\"sql\",\"sql\":\"select 3\",\"dialect\":\"spark\"}]}},{\"action\":\"set-current-view-version\",\"view-version-id\":-1}]}";
    let fourth = match (viewCommit(mut s, next, borrow noKeys)) {
        Ok(m) => m,
        Err(_) => { return Err(TestFailure.create("version 3 was refused")); }
    };
    Check.equalU64(2, arrayLength(borrow fourth, "versions") as u64)?;
    Check.isTrue(!holdsMember(borrow fourth, "versions", "version-id", 1), "version 1 expired")?;
    Check.isTrue(holdsMember(borrow fourth, "versions", "version-id", 3), "version 3 kept")?;
    Check.equalU64(2, arrayLength(borrow fourth, "version-log") as u64)?;
    Check.isTrue(!holdsMember(borrow fourth, "version-log", "version-id", 1), "its log entry gone")?;
    // A history that is not a positive integer, and a version without a summary: refused.
    let zero = "{\"updates\":[{\"action\":\"set-properties\",\"updates\":{\"version.history.num-entries\":\"0\"}}]}";
    Check.equalU64(400, viewStatus(mut s, zero, borrow noKeys))?;
    let bare =
        "{\"updates\":[{\"action\":\"add-view-version\",\"view-version\":{\"version-id\":-1,\"schema-id\":0,\"timestamp-ms\":5000,\"default-namespace\":[\"ns\"],\"representations\":[{\"type\":\"sql\",\"sql\":\"select 4\",\"dialect\":\"spark\"}]}}]}";
    Check.equalU64(400, viewStatus(mut s, bare, borrow noKeys))?;
    removeTree(dir.view());
    return Ok();
}

/// Each view update on its own, and a commit that lost a race (the M34 exit review's missing tests): `assign-uuid`
/// of another uuid refused, `remove-properties` removing, `add-schema` of -1 given the next id, a commit made on a
/// record another commit replaced refused with CommitFailed.
@test
fn viewUpdatesEachAlone() -> Result<void, TestFailure> {
    let dir = scratchDirectory("view-updates");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    let hidden = tableWarehouseBucket("cat".bytes())!;
    s.createBucket(catalogText(hidden.view()))!;
    let none = Vector<MasterKey>.create();
    let noKeys = WarehouseKeys { sse: none.view(), kms: none.view() };
    let _ = icebergCreateNamespace(mut s, "cat".bytes(), "{\"namespace\":[\"ns\"]}".bytes())!;
    Check.equalU64(200, viewCall(mut s, Method.Post, ["views"][..], VIEW_BODY, borrow noKeys).status as u64)?;
    let other = "{\"updates\":[{\"action\":\"assign-uuid\",\"uuid\":\"00000000-0000-4000-8000-000000000000\"}]}";
    Check.equalU64(400, viewStatus(mut s, other, borrow noKeys))?;
    let removal = "{\"updates\":[{\"action\":\"remove-properties\",\"removals\":[\"comment\"]}]}";
    let removed = match (viewCommit(mut s, removal, borrow noKeys)) {
        Ok(m) => m,
        Err(_) => { return Err(TestFailure.create("remove-properties was refused")); }
    };
    Check.isTrue(jsonMemberText(jsonMember(borrow removed, "properties")!, "comment").isNull(), "comment removed")?;
    let schema =
        "{\"updates\":[{\"action\":\"add-schema\",\"schema\":{\"type\":\"struct\",\"schema-id\":-1,\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"},{\"id\":2,\"name\":\"b\",\"required\":false,\"type\":\"string\"}]}}]}";
    let added = match (viewCommit(mut s, schema, borrow noKeys)) {
        Ok(m) => m,
        Err(_) => { return Err(TestFailure.create("add-schema was refused")); }
    };
    Check.isTrue(holdsMember(borrow added, "schemas", "schema-id", 1), "the next schema id")?;
    // A commit on the record as it was before another commit: CommitFailed, nothing written over the other.
    let key = viewKey("ns".bytes(), "v".bytes())!;
    let stale = readRecord(borrow s, hidden.view(), key.view())!!;
    let props = "{\"updates\":[{\"action\":\"set-properties\",\"updates\":{\"k\":\"1\"}}]}";
    Check.equalU64(200, viewStatus(mut s, props, borrow noKeys))?;
    let lost = commitView(mut s, hidden.view(), key.view(), stale, props.bytes(), borrow noKeys)!;
    Check.equalU64(409, lost.status as u64)?;
    removeTree(dir.view());
    return Ok();
}

/// A view in a table bucket whose encryption is KMS (the M34 exit review's missing test): its metadata files sealed
/// under the key, made, replaced and loaded with the server's keys, and not loaded without them.
@test
fn viewsInAnEncryptedTableBucket() -> Result<void, TestFailure> {
    let dir = scratchDirectory("view-sealed");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    let hidden = tableWarehouseBucket("cat".bytes())!;
    s.createBucket(catalogText(hidden.view()))!;
    var kms = Vector<MasterKey>.create();
    kms.push(testKey("orders", 90))!;
    let none = Vector<MasterKey>.create();
    let keys = WarehouseKeys { sse: none.view(), kms: kms.view() };
    let noKeys = WarehouseKeys { sse: none.view(), kms: none.view() };
    let config = parseJson(
        "{\"encryption\":{\"sseAlgorithm\":\"aws:kms\",\"kmsKeyArn\":\"arn:aws:kms:us-east-1:000000000000:key/orders\"}}".bytes(),
    )!!;
    writeTablesConfig(mut s, hidden.view(), TABLE_BUCKET_CONFIG_KEY.bytes(), borrow config)!;
    let _ = icebergCreateNamespace(mut s, "cat".bytes(), "{\"namespace\":[\"ns\"]}".bytes())!;
    Check.equalU64(200, viewCall(mut s, Method.Post, ["views"][..], VIEW_BODY, borrow keys).status as u64)?;
    let key = viewKey("ns".bytes(), "v".bytes())!;
    let rec = readRecord(borrow s, hidden.view(), key.view())!!;
    let location = copyBytes(jsonMemberText(borrow rec.json, "metadataLocation")!)!;
    Check.isTrue(readMetadataWith(borrow s, hidden.view(), location.view(), borrow noKeys).isErr(), "sealed")?;
    let replace =
        "{\"updates\":[{\"action\":\"add-view-version\",\"view-version\":{\"version-id\":-1,\"schema-id\":0,\"timestamp-ms\":2000,\"summary\":{},\"default-namespace\":[\"ns\"],\"representations\":[{\"type\":\"sql\",\"sql\":\"select 2\",\"dialect\":\"spark\"}]}},{\"action\":\"set-current-view-version\",\"view-version-id\":-1}]}";
    Check.equalU64(200, viewStatus(mut s, replace, borrow keys))?;
    let next = readRecord(borrow s, hidden.view(), key.view())!!;
    let nextLocation = copyBytes(jsonMemberText(borrow next.json, "metadataLocation")!)!;
    Check.isTrue(nextLocation.view() != location.view(), "a new metadata file")?;
    let opened = readMetadataWith(borrow s, hidden.view(), nextLocation.view(), borrow keys)!;
    Check.isTrue(jsonMemberI64(borrow opened, "current-version-id") == Some(2), "replaced, opened with the keys")?;
    Check.isTrue(readMetadataWith(borrow s, hidden.view(), nextLocation.view(), borrow noKeys).isErr(), "sealed")?;
    Check.equalU64(200, viewCall(mut s, Method.Get, ["views", "v"][..], "", borrow keys).status as u64)?;
    removeTree(dir.view());
    return Ok();
}

/// A staged create's commit refused once a view was made at its name after its stage (the M35 exit review's M1): the
/// stage's check was an earlier call's, so the commit makes it again.
@test
fn stagedCommitAfterAViewAtItsName() -> Result<void, TestFailure> {
    let dir = scratchDirectory("staged-view");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    s.createBucket(catalogText(tableWarehouseBucket("cat".bytes())!.view()))!;
    let none = Vector<MasterKey>.create();
    let noKeys = WarehouseKeys { sse: none.view(), kms: none.view() };
    let _ = icebergCreateNamespace(mut s, "cat".bytes(), "{\"namespace\":[\"ns\"]}".bytes())!;
    let staged = icebergCreateTable(
        mut s,
        "cat".bytes(),
        "ns".bytes(),
        "{\"name\":\"v\",\"stage-create\":true,\"schema\":{\"type\":\"struct\",\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"}]}}".bytes(),
        borrow noKeys,
    )!;
    let answer = parseJson(staged.body.view())!!;
    let location = copyBytes(jsonMemberText(jsonMember(borrow answer, "metadata")!, "location")!)!;
    Check.equalU64(200, viewCall(mut s, Method.Post, ["views"][..], VIEW_BODY, borrow noKeys).status as u64)?;
    let body = parseJson(createCommitBody(location.view()).view())!!;
    let refused = icebergCommitCreate(mut s, "cat".bytes(), "ns".bytes(), "v".bytes(), borrow body, borrow noKeys)!;
    Check.equalU64(409, refused.status as u64)?;
    Check.isTrue(currentTable(borrow s, "cat".bytes(), "ns".bytes(), "v".bytes())!.isNull(), "no table at the name")?;
    removeTree(dir.view());
    return Ok();
}

/// A table's `write.*.path` in its warehouse stays under its own id (the M35 exit review's M2): one under another id
/// is refused, at the create and by a commit; one elsewhere is the engine's.
@test
fn writePathsStayUnderTheirId() -> Result<void, TestFailure> {
    let dir = scratchDirectory("write-paths");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    s.createBucket(catalogText(tableWarehouseBucket("cat".bytes())!.view()))!;
    let none = Vector<MasterKey>.create();
    let noKeys = WarehouseKeys { sse: none.view(), kms: none.view() };
    let _ = icebergCreateNamespace(mut s, "cat".bytes(), "{\"namespace\":[\"ns\"]}".bytes())!;
    let schema =
        "\"schema\":{\"type\":\"struct\",\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"}]}";
    var inside = copyBytes("{\"name\":\"t\",".bytes())!;
    inside.extend(schema.bytes())!;
    inside.extend(
        ",\"properties\":{\"write.data.path\":\"s3://cat--table-s3/0f0f0f0f-0000-4000-8000-000000000009/data\"}}".bytes(),
    )!;
    let refused = icebergCreateTable(mut s, "cat".bytes(), "ns".bytes(), inside.view(), borrow noKeys);
    Check.isTrue(
        match (refused) {
            Ok(a) => a.status == 400,
            Err(TablesError.BadRequest) => true,
            _ => false,
        },
        "a write path under another id refused at the create",
    )?;
    var elsewhere = copyBytes("{\"name\":\"t\",".bytes())!;
    elsewhere.extend(schema.bytes())!;
    elsewhere.extend(",\"properties\":{\"write.data.path\":\"s3://elsewhere/data\"}}".bytes())!;
    Check.equalU64(
        200,
        icebergCreateTable(mut s, "cat".bytes(), "ns".bytes(), elsewhere.view(), borrow noKeys)!.status as u64,
    )?;
    let moved =
        "{\"requirements\":[],\"updates\":[{\"action\":\"set-properties\",\"updates\":{\"write.metadata.path\":\"s3://cat--table-s3/0f0f0f0f-0000-4000-8000-000000000009\"}}]}";
    Check.isTrue(
        match (icebergCommit(mut s, "cat".bytes(), "ns".bytes(), "t".bytes(), moved.bytes(), borrow noKeys)) {
            Ok(a) => a.status == 400,
            Err(TablesError.BadRequest) => true,
            _ => false,
        },
        "and by a commit",
    )?;
    removeTree(dir.view());
    return Ok();
}
