// The IAM API, a subset (ADR-0104): users, their access keys and inline policies, through a `POST /` signed for `iam`
// (Query protocol, XML answers). Its records are one record of the hidden bucket `_cosmostore-iam` (`iam.cee`),
// changed under the store's lock by a conditional write; the credential sets take them at the next round (§4).
import web_core;
import web_http;
import web_server;

const IAM_XMLNS: StringView = "https://iam.amazonaws.com/doc/2010-05-08/";
const IAM_ACCOUNT_ARN: StringView = "arn:aws:iam::000000000000:";

/// An IAM error answered.
async fn iamError(
    exchange: borrow mut Exchange,
    status: u16,
    code: StringView,
    message: StringView,
    requestId: Slice<u8>,
) -> Result<void, S3Fail> {
    var body = Vector<u8>.create();
    body.extend("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ErrorResponse xmlns=\"".bytes())?;
    body.extend(IAM_XMLNS.bytes())?;
    // The caller's fault, or the server's (ADR-0106 §5): IAM's ServiceFailure is a Receiver error.
    body.extend(
        if (status >= 500) "\"><Error><Type>Receiver</Type><Code>".bytes()
            else "\"><Error><Type>Sender</Type><Code>".bytes(),
    )?;
    body.extend(code.bytes())?;
    body.extend("</Code><Message>".bytes())?;
    appendXmlEscaped(mut body, message.bytes())?;
    body.extend("</Message></Error><RequestId>".bytes())?;
    body.extend(requestId)?;
    body.extend("</RequestId></ErrorResponse>".bytes())?;
    exchange.header("content-type", "text/xml".bytes())?;
    await exchange.send(statusOf(status), body.view())?;
    return Ok();
}

/// A call's answer: `<Action>Response`, its result (empty for none), and the request id.
async fn iamAnswer(
    exchange: borrow mut Exchange,
    action: Slice<u8>,
    result: Slice<u8>,
    requestId: Slice<u8>,
) -> Result<void, S3Fail> {
    var out = Vector<u8>.create();
    out.extend("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<".bytes())?;
    out.extend(action)?;
    out.extend("Response xmlns=\"".bytes())?;
    out.extend(IAM_XMLNS.bytes())?;
    out.extend("\">".bytes())?;
    // UpdateRole's answer has a result with nothing in it, which the SDKs read (botocore asks for `UpdateRoleResult`);
    // a change with no answer has none.
    if (result.length > 0 || action == "UpdateRole".bytes()) {
        out.push('<')?;
        out.extend(action)?;
        out.extend("Result>".bytes())?;
        out.extend(result)?;
        out.extend("</".bytes())?;
        out.extend(action)?;
        out.extend("Result>".bytes())?;
    }
    out.extend("<ResponseMetadata><RequestId>".bytes())?;
    out.extend(requestId)?;
    out.extend("</RequestId></ResponseMetadata></".bytes())?;
    out.extend(action)?;
    out.extend("Response>".bytes())?;
    exchange.header("content-type", "text/xml".bytes())?;
    await exchange.send(Status.ok(), out.view())?;
    Secret.wipe(mut out[..]); // a new key's secret may be in it
    return Ok();
}

/// `<User>…</User>`.
fn appendUser(out: borrow mut Vector<u8>, name: Slice<u8>, id: Slice<u8>, createdMs: i64) -> Result<void, AllocError> =>
    appendUserAt(out, name, id, "/".bytes(), createdMs);

/// `<User>…</User>`'s inside for a user with a path (ADR-0108 §3), shown in its ARN.
fn appendUserAt(
    out: borrow mut Vector<u8>,
    name: Slice<u8>,
    id: Slice<u8>,
    path: Slice<u8>,
    createdMs: i64,
) -> Result<void, AllocError> {
    xmlTextElement(out, "Path", path)?;
    xmlTextElement(out, "UserName", name)?;
    xmlTextElement(out, "UserId", id)?;
    out.extend("<Arn>".bytes())?;
    out.extend(IAM_ACCOUNT_ARN.bytes())?;
    out.extend("user".bytes())?;
    appendXmlEscaped(out, path)?;
    appendXmlEscaped(out, name)?;
    out.extend("</Arn><CreateDate>".bytes())?;
    appendIso8601(out, createdMs)?;
    out.extend("</CreateDate>".bytes())?;
    return Ok();
}

/// A path and a name, as an ARN ends.
fn pathAndName(path: Slice<u8>, name: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var out = copyBytes(path)?;
    out.extend(name)?;
    return Ok(out);
}

/// `n` characters of `alphabet`, at random.
fn randomText(out: borrow mut Vector<u8>, n: usize, alphabet: StringView) -> Result<bool, AllocError> {
    var raw = Vector<u8>.create();
    raw.resize(n, 0)?;
    if (Random.fill(raw.viewMut()).isErr()) { return Ok(false); }
    let chars = alphabet.bytes();
    for (i in 0..n) { out.push(chars[(raw[i] as usize) % chars.length])?; }
    Secret.wipe(mut raw[..]);
    return Ok(true);
}

const IAM_ID_CHARS: StringView = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
const IAM_SECRET_CHARS: StringView = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

// ---- A change, under the store's lock ----

/// A change the IAM API asks.
enum IamCall {
    /// A user's name, path and tags.
    CreateUser(Vector<u8>, Vector<u8>, Vector<IamTag>),
    DeleteUser(Vector<u8>),
    CreateAccessKey(Vector<u8>),
    /// A user's key, made active or not.
    UpdateAccessKey(Vector<u8>, Vector<u8>, bool),
    DeleteAccessKey(Vector<u8>, Vector<u8>),
    /// A user's policy, by name, and its document.
    PutUserPolicy(Vector<u8>, Vector<u8>, Vector<u8>),
    DeleteUserPolicy(Vector<u8>, Vector<u8>),
    /// A role, its trust policy, its sessions' longest (MaxSessionDuration), its path, description and tags.
    CreateRole(Vector<u8>, Vector<u8>, u64, Vector<u8>, Vector<u8>, Vector<IamTag>),
    DeleteRole(Vector<u8>),
    PutRolePolicy(Vector<u8>, Vector<u8>, Vector<u8>),
    DeleteRolePolicy(Vector<u8>, Vector<u8>),
    /// A managed policy's change or an attachment's (`iam_managed.cee`, ADR-0108 §3).
    Managed(ManagedCall),
    /// A group's change (`iam_groups.cee`).
    Group(GroupCall),
    /// A tag's change or a role's update (`iam_tags.cee`).
    Tags(TagCall),
}

/// What a change came to.
enum IamOutcome {
    /// Done: the user it was about, as it is now (for CreateUser and CreateAccessKey's answers), the key made, and the
    /// role made (CreateRole's answer: on a cluster the record is not read back until it commits), and the managed
    /// policy made or changed (CreatePolicy's and CreatePolicyVersion's), and the group made (CreateGroup's).
    Done(IamUser?, IamKey?, IamRole?, IamManagedPolicy?, IamGroup?),
    /// The records' bucket is not made yet (a cluster's shard leader makes it, ADR-0104 §3): try again.
    NotReady,
    NoSuchEntity,
    EntityAlreadyExists,
    LimitExceeded,
    DeleteConflict,
    MalformedPolicyDocument,
    /// The record changed between its read and its write: tried again by the caller.
    Conflict,
}

/// Whether `names` holds `name`, case aside (IAM's names are unique so).
fn namedIn(names: Slice<Vector<u8>>, name: Slice<u8>) -> bool {
    for (i in 0..names.length) {
        if (sameNameIgnoringCase(names[i].view(), name)) { return true; }
    }
    return false;
}

fn roleAtIam(state: borrow IamState, name: Slice<u8>) -> usize? {
    for (i in 0..state.roles.length) {
        if (sameNameIgnoringCase(state.roles[i].name.view(), name)) { return Some(i); }
    }
    return null;
}

fn policyNameOk(name: Slice<u8>) -> bool {
    if (name.length < 1 || name.length > 128) { return false; }
    for (c in name) {
        let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '+' || c == '=' ||
            c == ',' || c == '.' || c == '@' || c == '_' || c == '-';
        if (!ok) { return false; }
    }
    return true;
}

fn userAt(state: borrow IamState, name: Slice<u8>) -> usize? {
    for (i in 0..state.users.length) {
        if (sameNameIgnoringCase(state.users[i].name.view(), name)) { return Some(i); }
    }
    return null;
}

fn copyUser(u: borrow IamUser) -> Result<IamUser, AllocError> {
    var keys = Vector<IamKey>.create();
    for (k in 0..u.keys.length) {
        keys.push(IamKey {
            accessKey: copyBytes(u.keys[k].accessKey.view())?,
            secret: copyBytes(u.keys[k].secret.view())?,
            active: u.keys[k].active,
            createdMs: u.keys[k].createdMs,
        })?;
    }
    return Ok(
        IamUser {
            name: copyBytes(u.name.view())?,
            id: copyBytes(u.id.view())?,
            createdMs: u.createdMs,
            keys: keys,
            policies: copyPolicies(u.policies.view())?,
            path: copyBytes(u.path.view())?,
            tags: copyTags(u.tags.view())?,
            attached: copyNames(u.attached.view())?,
        },
    );
}

/// Applies a change to the store's record: read, changed, written back on the generation it was read at (a new record
/// only if there is none). `fileNames` are the users the files hold, which the API neither makes again nor changes.
fn applyIamCall(
    store: borrow mut ObjectStore,
    call: borrow IamCall,
    fileNames: Slice<Vector<u8>>,
    fileRoles: Slice<Vector<u8>>,
    nowMs: i64,
) -> Result<IamOutcome, StoreError> {
    let snapshot = iamSnapshotOf(store) ?? { return Err(StoreError.DataCorrupt); };
    var state = snapshot.state;
    var made: IamKey? = null;
    var madeRole: IamRole? = null;
    // Whose joined policies are not a policy before the change: a change that adds one is refused (the M21 exit review's
    // finding 1), and one that leaves those as they were is not.
    let unjoinable = unjoinableEntities(borrow state)?;
    var madePolicy: IamManagedPolicy? = null;
    var madeGroup: IamGroup? = null;
    var about: usize? = null;
    match (call) {
        IamCall.CreateUser(name, path, tags) => {
            if (userAt(borrow state, name.view()).isSome() || namedIn(fileNames, name.view())) {
                return Ok(IamOutcome.EntityAlreadyExists);
            }
            var id = copyBytes("AIDA".bytes())?;
            if (!randomText(mut id, 17, IAM_ID_CHARS)?) { return Err(StoreError.DataCorrupt); }
            state.users.push(IamUser {
                name: copyBytes(name.view())?,
                id: id,
                createdMs: nowMs,
                keys: Vector<IamKey>.create(),
                policies: Vector<IamPolicy>.create(),
                path: copyBytes(path.view())?,
                tags: copyTags(tags.view())?,
                attached: Vector<Vector<u8>>.create(),
            })?;
            about = Some(state.users.length - 1);
        }
        IamCall.DeleteUser(name) => {
            let u = userAt(borrow state, name.view()) ?? { return Ok(IamOutcome.NoSuchEntity); };
            // As on AWS: its keys, inline and attached policies, and groups go first.
            if (state.users[u].keys.length > 0 ||
                state.users[u].policies.length > 0 || state.users[u].attached.length > 0) {
                return Ok(IamOutcome.DeleteConflict);
            }
            for (g in 0..state.groups.length) {
                if (groupHolds(
                    borrow state.groups[g],
                    state.users[u].name.view(),
                )) { return Ok(IamOutcome.DeleteConflict); }
            }
            let _ = state.users.remove(u);
        }
        IamCall.CreateAccessKey(name) => {
            let u = userAt(borrow state, name.view()) ?? { return Ok(IamOutcome.NoSuchEntity); };
            if (state.users[u].keys.length >= IAM_MAX_KEYS) { return Ok(IamOutcome.LimitExceeded); }
            var key = copyBytes("AKIA".bytes())?;
            if (!randomText(mut key, 16, IAM_ID_CHARS)?) { return Err(StoreError.DataCorrupt); }
            var secret = Vector<u8>.create();
            if (!randomText(mut secret, 40, IAM_SECRET_CHARS)?) { return Err(StoreError.DataCorrupt); }
            let fresh = IamKey { accessKey: key, secret: secret, active: true, createdMs: nowMs };
            made = Some(IamKey {
                accessKey: copyBytes(fresh.accessKey.view())?,
                secret: copyBytes(fresh.secret.view())?,
                active: true,
                createdMs: nowMs,
            });
            state.users[u].keys.push(fresh)?;
            about = Some(u);
        }
        IamCall.UpdateAccessKey(name, key, active) => {
            let u = userAt(borrow state, name.view()) ?? { return Ok(IamOutcome.NoSuchEntity); };
            var found = false;
            for (k in 0..state.users[u].keys.length) {
                if (state.users[u].keys[k].accessKey.view() == key.view()) {
                    state.users[u].keys[k].active = *active;
                    found = true;
                }
            }
            if (!found) { return Ok(IamOutcome.NoSuchEntity); }
        }
        IamCall.DeleteAccessKey(name, key) => {
            let u = userAt(borrow state, name.view()) ?? { return Ok(IamOutcome.NoSuchEntity); };
            var at: usize? = null;
            for (k in 0..state.users[u].keys.length) {
                if (state.users[u].keys[k].accessKey.view() == key.view()) { at = Some(k); }
            }
            let _ = state.users[u].keys.remove(at ?? { return Ok(IamOutcome.NoSuchEntity); });
        }
        IamCall.PutUserPolicy(name, policy, text) => {
            let u = userAt(borrow state, name.view()) ?? { return Ok(IamOutcome.NoSuchEntity); };
            match (parseIdentityPolicy(text.view())) {
                Ok(_) => {}
                Err(S3Fail.OutOfMemory(e)) => { return Err(StoreError.OutOfMemory(e)); }
                Err(_) => { return Ok(IamOutcome.MalformedPolicyDocument); }
            }
            var replaced = false;
            for (p in 0..state.users[u].policies.length) {
                if (state.users[u].policies[p].name.view() == policy.view()) {
                    state.users[u].policies[p].text = copyBytes(text.view())?;
                    replaced = true;
                }
            }
            if (!replaced) {
                state.users[u].policies.push(
                    IamPolicy { name: copyBytes(policy.view())?, text: copyBytes(text.view())? },
                )?;
            }
            // The user's policies joined must still be a policy (statements past its size, say).
            let texts = userPolicyTexts(borrow state, u)?;
            match (joinedPolicy(texts.view())?) {
                Some(j) => {
                    match (parseIdentityPolicy(j.view())) {
                        Ok(_) => {}
                        Err(S3Fail.OutOfMemory(e)) => { return Err(StoreError.OutOfMemory(e)); }
                        Err(_) => { return Ok(IamOutcome.LimitExceeded); }
                    }
                }
                null => { return Ok(IamOutcome.MalformedPolicyDocument); }
            }
        }
        IamCall.DeleteUserPolicy(name, policy) => {
            let u = userAt(borrow state, name.view()) ?? { return Ok(IamOutcome.NoSuchEntity); };
            var at: usize? = null;
            for (p in 0..state.users[u].policies.length) {
                if (state.users[u].policies[p].name.view() == policy.view()) { at = Some(p); }
            }
            let _ = state.users[u].policies.remove(at ?? { return Ok(IamOutcome.NoSuchEntity); });
        }
        IamCall.CreateRole(name, trust, seconds, path, description, tags) => {
            if (roleAtIam(borrow state, name.view()).isSome() || namedIn(fileRoles, name.view())) {
                return Ok(IamOutcome.EntityAlreadyExists);
            }
            // A trust policy is a policy document with statements (checked at AssumeRole, ADR-0104 §7).
            let doc = parseJson(trust.view())? ?? { return Ok(IamOutcome.MalformedPolicyDocument); };
            if (!trustSupported(borrow doc)) { return Ok(IamOutcome.MalformedPolicyDocument); }
            var id = copyBytes("AROA".bytes())?;
            if (!randomText(mut id, 17, IAM_ID_CHARS)?) { return Err(StoreError.DataCorrupt); }
            madeRole = Some(IamRole {
                name: copyBytes(name.view())?,
                id: copyBytes(id.view())?,
                createdMs: nowMs,
                trust: copyBytes(trust.view())?,
                policies: Vector<IamPolicy>.create(),
                maxSeconds: *seconds,
                path: copyBytes(path.view())?,
                tags: copyTags(tags.view())?,
                attached: Vector<Vector<u8>>.create(),
                description: copyBytes(description.view())?,
            });
            state.roles.push(IamRole {
                name: copyBytes(name.view())?,
                id: id,
                createdMs: nowMs,
                trust: copyBytes(trust.view())?,
                policies: Vector<IamPolicy>.create(),
                maxSeconds: *seconds,
                path: copyBytes(path.view())?,
                tags: copyTags(tags.view())?,
                attached: Vector<Vector<u8>>.create(),
                description: copyBytes(description.view())?,
            })?;
        }
        IamCall.DeleteRole(name) => {
            let r = roleAtIam(borrow state, name.view()) ?? { return Ok(IamOutcome.NoSuchEntity); };
            if (state.roles[r].policies.length > 0 || state.roles[r].attached.length > 0) {
                return Ok(IamOutcome.DeleteConflict);
            }
            let _ = state.roles.remove(r);
        }
        IamCall.PutRolePolicy(name, policy, text) => {
            let r = roleAtIam(borrow state, name.view()) ?? { return Ok(IamOutcome.NoSuchEntity); };
            match (parseIdentityPolicy(text.view())) {
                Ok(_) => {}
                Err(S3Fail.OutOfMemory(e)) => { return Err(StoreError.OutOfMemory(e)); }
                Err(_) => { return Ok(IamOutcome.MalformedPolicyDocument); }
            }
            // One inline policy a role (ADR-0104 §1): a new name replaces the one it had.
            state.roles[r].policies.clear();
            state.roles[r].policies.push(IamPolicy { name: copyBytes(policy.view())?, text: copyBytes(text.view())? })?;
        }
        IamCall.DeleteRolePolicy(name, policy) => {
            let r = roleAtIam(borrow state, name.view()) ?? { return Ok(IamOutcome.NoSuchEntity); };
            var at: usize? = null;
            for (p in 0..state.roles[r].policies.length) {
                if (state.roles[r].policies[p].name.view() == policy.view()) { at = Some(p); }
            }
            let _ = state.roles[r].policies.remove(at ?? { return Ok(IamOutcome.NoSuchEntity); });
        }
        IamCall.Managed(m) => {
            match (applyManagedCall(mut state, m, nowMs)?) {
                ManagedApplied.Refused(o) => { return Ok(o); }
                ManagedApplied.Changed(p) => { madePolicy = p; }
            }
        }
        IamCall.Group(g) => {
            match (applyGroupCall(mut state, g, nowMs)?) {
                GroupApplied.Refused(o) => { return Ok(o); }
                GroupApplied.Changed(groupMade) => { madeGroup = groupMade; }
            }
        }
        IamCall.Tags(t) => {
            match (applyTagCall(mut state, t)?) {
                Some(o) => { return Ok(o); }
                null => {}
            }
        }
    }
    let unjoinableAfter = unjoinableEntities(borrow state)?;
    for (i in 0..unjoinableAfter.length) {
        if (!namedExactly(unjoinable.view(), unjoinableAfter[i].view())) { return Ok(IamOutcome.LimitExceeded); }
    }
    var bytes = encodeIamState(borrow state)?;
    // On `serve` the bucket is made here; on a cluster its shard's leader makes it (ADR-0104 §3), as a bucket made in
    // this request would not be seen by its write: until then, try again.
    if (!store.bucketExists(IAM_BUCKET)?) {
        if (store.appliesOnCommit()) { return Ok(IamOutcome.NotReady); }
        store.createBucket(IAM_BUCKET)?;
    }
    let condition = if (snapshot.generation == 0) PutCondition.IfAbsent else PutCondition.IfGeneration(
        snapshot.generation,
    );
    let put = store.putObject(IAM_BUCKET, IAM_STATE_KEY, "application/json", bytes.view(), condition);
    Secret.wipe(mut bytes[..]); // the record holds every key's secret (the M21 exit review's finding 8)
    match (put) {
        Ok(_) => {}
        Err(StoreError.PreconditionFailed) => { return Ok(IamOutcome.Conflict); }
        Err(e) => { return Err(e); }
    }
    let user = match (about) {
        Some(u) => Some(copyUser(borrow state.users[u])?),
        null => null,
    };
    return Ok(IamOutcome.Done(user, made, madeRole, madePolicy, madeGroup));
}

// ---- The calls ----

/// The users the files hold, from the credential set as it is now: their names and ids, not the API's.
fn fileUsersOf(
    credentials: Slice<Credential>,
    fileKeys: Slice<Vector<u8>>,
    state: borrow IamState,
) -> Result<Vector<Vector<u8>>, AllocError> {
    var out = Vector<Vector<u8>>.create();
    for (i in 0..credentials.length) {
        let c = borrow credentials[i];
        if (c.revoked || c.fromIam || c.user.length == 0 || userAt(state, c.user.view()).isSome()) { continue; }
        var known = false;
        for (k in 0..out.length) {
            if (out[k].view() == c.userKey.view()) { known = true; }
        }
        if (!known) { out.push(copyBytes(c.userKey.view())?)?; } // `<name> <id>`
    }
    // The users file's users with no live key too (ADR-0106 §1.6, the M19 exit review's B2): their names are the
    // file's all the same.
    for (i in 0..fileKeys.length) {
        if (userAt(state, nameOfUserKey(fileKeys[i].view())).isSome()) { continue; }
        var known = false;
        for (k in 0..out.length) {
            if (sameNameIgnoringCase(nameOfUserKey(out[k].view()), nameOfUserKey(fileKeys[i].view()))) { known = true; }
        }
        if (!known) { out.push(copyBytes(fileKeys[i].view())?)?; }
    }
    return Ok(out);
}

/// The name part of a `<name> <id>`.
fn nameOfUserKey(userKey: Slice<u8>) -> Slice<u8> {
    for (i in 0..userKey.length) {
        if (userKey[i] == ' ') { return userKey[0..i]; }
    }
    return userKey;
}

fn idOfUserKey(userKey: Slice<u8>) -> Slice<u8> {
    for (i in 0..userKey.length) {
        if (userKey[i] == ' ') { return userKey[i + 1..]; }
    }
    return "".bytes();
}

/// A form value; empty when absent.
fn formText(body: Slice<u8>, name: StringView) -> Result<Vector<u8>, AllocError> {
    var out = Vector<u8>.create();
    let _ = formValue(body, name, mut out)?;
    return Ok(out);
}

/// `POST /` signed for `iam` (ADR-0104 §1, §2): authenticated, then decided (the account, or a user its identity
/// policy lets; never a session), then the call.
async fn serveIam(
    app: borrow S3App,
    req: borrow S3Request,
    exchange: borrow mut Exchange,
    requestId: Slice<u8>,
) -> Result<void, S3Fail> {
    let unsigned = Authenticated { payload: PayloadMode.Unsigned, signer: null, key: null, session: null };
    let body = await readSmallBody(unsigned, exchange, 131072)?;
    var hash = Vector<u8>.create();
    appendHexBytes(mut hash, Sha256.of(body.view())[..])?;
    if (req.isAnonymous()) {
        return await iamError(
            exchange,
            403,
            "MissingAuthenticationToken",
            "Request is missing a signature.",
            requestId,
        );
    }
    let now = Clock.unixMillis() / 1000;
    let auth = match (req.authenticate(
        app.credentials.get().view(),
        app.stsKeys.get().view(),
        now,
        "iam",
        Some(hash.view()),
    )) {
        Ok(a) => a,
        Err(code) => { return await iamError(exchange, 403, stsCodeOf(code), s3Message(code), requestId); }
    };
    if (auth.session.isSome()) {
        return await iamError(exchange, 403, "AccessDenied", "Temporary credentials cannot call IAM.", requestId);
    }
    let caller = match (auth.key) {
        Some(k) => k,
        null => { return await iamError(exchange, 403, "AccessDenied", "Access denied.", requestId); }
    };
    let action = formText(body.view(), "Action")?;
    let target = formText(body.view(), "UserName")?;
    let known = [
        "CreateUser", "GetUser", "ListUsers", "DeleteUser", "CreateAccessKey", "ListAccessKeys", "UpdateAccessKey",
        "DeleteAccessKey", "PutUserPolicy", "GetUserPolicy", "ListUserPolicies", "DeleteUserPolicy", "CreateRole",
        "GetRole", "ListRoles", "DeleteRole", "PutRolePolicy", "GetRolePolicy", "DeleteRolePolicy",
    ];
    var taken = isManagedAction(action.view()) || isGroupAction(action.view()) || isTagAction(action.view());
    for (k in known) {
        if (action.view() == k.bytes()) { taken = true; }
    }
    if (!taken) {
        return await iamError(exchange, 400, "InvalidAction", "This IAM action is not implemented here.", requestId);
    }
    // A policy's name, when the call takes one: 1 to 128 of IAM's characters (the M19 exit review).
    let policyName = formText(body.view(), "PolicyName")?;
    // Not the managed calls' (a PolicyArn) nor the tag calls' (TagPolicy, UpdateAssumeRolePolicy: no PolicyName).
    let namesPolicy = action.view().endsWith("Policy".bytes()) && !isManagedAction(action.view()) &&
        !isTagAction(action.view());
    if (namesPolicy && !policyNameOk(policyName.view())) {
        return await iamError(
            exchange,
            400,
            "ValidationError",
            "PolicyName is 1 to 128 of A-Z a-z 0-9 + = , . @ _ -.",
            requestId,
        );
    }
    // A user's call is its identity policy's to allow, `iam:<Action>` on the user it is about.
    let credentials = app.credentials.get().view();
    let who = requesterOf(Some(caller), null);
    let callerUser = match (userOfRequester(credentials, borrow who)) {
        Some(c) => Some(copyBytes(c.user.view())?),
        null => null,
    };
    // A managed policy's call or an attachment's is decided on the policy, or what it is attached to.
    if (isManagedAction(action.view())) {
        return await serveIamManaged(
            app,
            req,
            exchange,
            action.view(),
            body.view(),
            borrow who,
            callerUser.isSome(),
            requestId,
        );
    }
    if (isTagAction(action.view())) {
        let callerName = match (borrow callerUser) {
            Some(n) => copyBytes(n.view())?,
            null => Vector<u8>.create(),
        };
        return await serveIamTags(
            app,
            req,
            exchange,
            action.view(),
            body.view(),
            borrow who,
            callerName.view(),
            callerUser.isSome(),
            requestId,
        );
    }
    if (isGroupAction(action.view())) {
        return await serveIamGroup(
            app,
            req,
            exchange,
            action.view(),
            body.view(),
            borrow who,
            callerUser.isSome(),
            requestId,
        );
    }
    // A role's call is about the role it names (`iam:role/<name>`), a user's about the user.
    let roleCall = action.view() == "ListRoles".bytes() || action.view().endsWith("Role".bytes()) ||
        action.view().endsWith("RolePolicy".bytes());
    let roleName = formText(body.view(), "RoleName")?;
    let aboutName = if (roleCall) (if (roleName.length > 0) roleName.view() else "*".bytes())
        else if (target.length > 0) target.view() else match (borrow callerUser) {
            Some(n) => n.view(),
            null => "*".bytes(),
        };
    if (callerUser.isSome()) {
        var iamAction = copyBytes("iam:".bytes())?;
        iamAction.extend(action.view())?;
        var resource = copyBytes(if (roleCall) "iam:role".bytes() else "iam:user".bytes())?;
        // A list is about every user or role; anything else about the record's own name, as names match ignoring
        // case (the M19 exit review: a policy on `user/BOB` allowed acting on `bob`, and ListUsers on oneself listed
        // everyone).
        let listing = action.view() == "ListUsers".bytes() || action.view() == "ListRoles".bytes();
        if (listing) {
            resource.extend("/*".bytes())?;
        } else {
            let snapshot = await readIamSnapshot(borrow app.store) ?? {
                return await iamError(exchange, 500, "ServiceFailure", "The IAM records do not read.", requestId);
            };
            // The record's path and name (ADR-0108 §3): a policy names a user or role by its ARN, path and all.
            let found = if (roleCall) match (roleAtIam(borrow snapshot.state, aboutName)) {
                Some(i) => Some(pathAndName(snapshot.state.roles[i].path.view(), snapshot.state.roles[i].name.view())?),
                null => null,
            } else match (userAt(borrow snapshot.state, aboutName)) {
                Some(i) => Some(pathAndName(snapshot.state.users[i].path.view(), snapshot.state.users[i].name.view())?),
                null => null,
            };
            match (found) {
                Some(n) => { resource.extend(n.view())?; }
                null => {
                    // One not there yet: CreateUser's and CreateRole's at the Path given (the M21 exit review's
                    // finding 3: a Deny on `user/admin/*` had not stopped making `user/admin/boss`).
                    let given = formText(body.view(), "Path")?;
                    let making = action.view() == "CreateUser".bytes() || action.view() == "CreateRole".bytes();
                    if (making && given.length > 0) {
                        resource.extend(given.view())?;
                    } else {
                        resource.push('/')?;
                    }
                    resource.extend(aboutName)?;
                }
            }
        }
        if (!sessionAllows(app, req, borrow who, StringView.fromUtf8(iamAction.view()) ?? "", resource.view())?) {
            return await iamError(
                exchange,
                403,
                "AccessDenied",
                "Not authorized to perform this IAM action.",
                requestId,
            );
        }
    }
    let name = copyBytes(aboutName)?;
    let a = action.view();
    if (roleCall) { return await serveIamRole(app, exchange, a, name.view(), body.view(), requestId); }
    // The reads.
    if (a == "GetUser".bytes() ||
        a == "ListUsers".bytes() || a == "ListAccessKeys".bytes() || a == "GetUserPolicy".bytes() ||
        a == "ListUserPolicies".bytes()) {
        let snapshot = await readIamSnapshot(borrow app.store) ?? {
            return await iamError(exchange, 500, "ServiceFailure", "The IAM records do not read.", requestId);
        };
        let files = fileUsersOf(credentials, app.credentials.get().fileUserKeys(), borrow snapshot.state)?;
        var accountKeys = Vector<Vector<u8>>.create();
        for (i in 0..credentials.length) {
            let c = borrow credentials[i];
            if (!c.revoked && !c.fromIam && c.user.length == 0) { accountKeys.push(copyBytes(c.accessKey.view())?)?; }
        }
        return await iamRead(
            exchange,
            a,
            name.view(),
            body.view(),
            borrow snapshot.state,
            files.view(),
            callerUser.isNull() && target.length == 0,
            accountKeys.view(),
            requestId,
        );
    }
    // The changes.
    let path = formText(body.view(), "Path")?;
    let givenPath = if (path.length == 0) copyBytes("/".bytes())? else path;
    let tags = formTags(body.view())? ?? {
        return await iamError(
            exchange,
            400,
            "ValidationError",
            "Tags are 50 at most, each a key of 1 to 128 characters and a value of 256 at most.",
            requestId,
        );
    };
    if (!iamPathOk(givenPath.view())) {
        return await iamError(exchange, 400, "ValidationError", "Path is / or /…/, 1 to 512 characters.", requestId);
    }
    let call = if (a == "CreateUser".bytes()) IamCall.CreateUser(name, givenPath, tags)
        else if (a == "DeleteUser".bytes()) IamCall.DeleteUser(name)
        else if (a == "CreateAccessKey".bytes()) IamCall.CreateAccessKey(name)
        else if (a == "UpdateAccessKey".bytes()) {
            let status = formText(body.view(), "Status")?;
            if (status.view() != "Active".bytes() && status.view() != "Inactive".bytes()) {
                return await iamError(exchange, 400, "ValidationError", "Status is Active or Inactive.", requestId);
            }
            IamCall.UpdateAccessKey(name, formText(body.view(), "AccessKeyId")?, status.view() == "Active".bytes())
        } else if (a == "DeleteAccessKey".bytes()) IamCall.DeleteAccessKey(name, formText(body.view(), "AccessKeyId")?)
            else if (a == "PutUserPolicy".bytes()) IamCall.PutUserPolicy(
                name,
                formText(body.view(), "PolicyName")?,
                formText(body.view(), "PolicyDocument")?,
            )
            else IamCall.DeleteUserPolicy(name, formText(body.view(), "PolicyName")?);
    // Names are checked as the users file's are.
    if (!userNameOk(aboutName) || aboutName == "*".bytes()) {
        return await iamError(
            exchange,
            400,
            "ValidationError",
            "UserName is 1 to 64 of A-Z a-z 0-9 + = , . @ _ -.",
            requestId,
        );
    }
    var outcome = IamOutcome.Conflict;
    for (attempt in 0..3) {
        let snapshotFiles = match (await readIamSnapshot(borrow app.store)) {
            Some(s) => fileUsersOf(credentials, app.credentials.get().fileUserKeys(), borrow s.state)?,
            null => Vector<Vector<u8>>.create(),
        };
        var names = Vector<Vector<u8>>.create();
        for (i in 0..snapshotFiles.length) { names.push(copyBytes(nameOfUserKey(snapshotFiles[i].view()))?)?; }
        var guard = await lockStore(app)?;
        let store = guard.data();
        let nowMs = Clock.unixMillis();
        let c = borrow call;
        let n = names.view();
        let none = Vector<Vector<u8>>.create();
        let noRoles = none.view();
        outcome = match (await Async.blocking(() => applyIamCall(store, c, n, noRoles, nowMs))) {
            Ok(o) => o,
            Err(e) => { return Err(storeFail(e, 0)); }
        };
        match (outcome) {
            IamOutcome.Conflict => {}
            _ => { break; }
        }
    }
    return match (outcome) {
        IamOutcome.Done(user, key, _, _, _) => await iamDone(exchange, a, user, key, requestId),
        IamOutcome.NotReady => await iamError(
            exchange,
            503,
            "ServiceUnavailable",
            "The IAM records are not ready yet; try again.",
            requestId,
        ),
        IamOutcome.NoSuchEntity => await iamError(
            exchange,
            404,
            "NoSuchEntity",
            "The user, key or policy named is not the API's.",
            requestId,
        ),
        IamOutcome.EntityAlreadyExists => await iamError(
            exchange,
            409,
            "EntityAlreadyExists",
            "A user with this name already exists.",
            requestId,
        ),
        IamOutcome.LimitExceeded => await iamError(
            exchange,
            409,
            "LimitExceeded",
            "Cannot exceed the quota for this user.",
            requestId,
        ),
        IamOutcome.DeleteConflict => await iamError(
            exchange,
            409,
            "DeleteConflict",
            "Delete the user's access keys and policies first.",
            requestId,
        ),
        IamOutcome.MalformedPolicyDocument => await iamError(
            exchange,
            400,
            "MalformedPolicyDocument",
            "The policy document is not one taken here.",
            requestId,
        ),
        IamOutcome.Conflict => await iamError(
            exchange,
            409,
            "ConcurrentModification",
            "The IAM records changed meanwhile; try again.",
            requestId,
        ),
    };
}

/// A change's answer.
async fn iamDone(
    exchange: borrow mut Exchange,
    action: Slice<u8>,
    user: IamUser?,
    key: IamKey?,
    requestId: Slice<u8>,
) -> Result<void, S3Fail> {
    var result = Vector<u8>.create();
    match (user) {
        Some(u) => {
            match (key) {
                Some(k) => {
                    result.extend("<AccessKey>".bytes())?;
                    xmlTextElement(mut result, "UserName", u.name.view())?;
                    xmlTextElement(mut result, "AccessKeyId", k.accessKey.view())?;
                    result.extend("<Status>Active</Status>".bytes())?;
                    xmlTextElement(mut result, "SecretAccessKey", k.secret.view())?;
                    result.extend("<CreateDate>".bytes())?;
                    appendIso8601(mut result, k.createdMs)?;
                    result.extend("</CreateDate></AccessKey>".bytes())?;
                }
                null => {
                    result.extend("<User>".bytes())?;
                    appendUserAt(mut result, u.name.view(), u.id.view(), u.path.view(), u.createdMs)?;
                    appendTags(mut result, u.tags.view())?;
                    result.extend("</User>".bytes())?;
                }
            }
        }
        null => {}
    }
    await iamAnswer(exchange, action, result.view(), requestId)?;
    Secret.wipe(mut result[..]);
    return Ok();
}

/// The reads: GetUser, ListUsers, ListAccessKeys, GetUserPolicy, ListUserPolicies. The files' users are listed and
/// got by their names and ids; their keys and policies are the operator's, not the API's (ADR-0104 §5).
async fn iamRead(
    exchange: borrow mut Exchange,
    action: Slice<u8>,
    name: Slice<u8>,
    body: Slice<u8>,
    state: borrow IamState,
    files: Slice<Vector<u8>>,
    root: bool,
    accountKeys: Slice<Vector<u8>>,
    requestId: Slice<u8>,
) -> Result<void, S3Fail> {
    var result = Vector<u8>.create();
    if (action == "ListAccessKeys".bytes() && root) {
        // The account's keys, no user named: the root's keys, as AWS lists them (ADR-0106 §5), their ids only.
        result.extend("<AccessKeyMetadata>".bytes())?;
        for (i in 0..accountKeys.length) {
            result.extend("<member>".bytes())?;
            xmlTextElement(mut result, "AccessKeyId", accountKeys[i].view())?;
            result.extend("<Status>Active</Status><CreateDate>".bytes())?;
            appendIso8601(mut result, 0)?;
            result.extend("</CreateDate></member>".bytes())?;
        }
        result.extend("</AccessKeyMetadata><IsTruncated>false</IsTruncated>".bytes())?;
        return await iamAnswer(exchange, action, result.view(), requestId);
    }
    if (action == "ListUsers".bytes()) {
        // PathPrefix, as on AWS (the M21 exit review's finding 10): the files' users are at `/`.
        let prefix = formText(body, "PathPrefix")?;
        let filesShown = prefix.length == 0 || prefix.view() == "/".bytes();
        result.extend("<IsTruncated>false</IsTruncated><Users>".bytes())?;
        for (i in 0..files.length) {
            if (!filesShown) { continue; }
            result.extend("<member>".bytes())?;
            appendUser(mut result, nameOfUserKey(files[i].view()), idOfUserKey(files[i].view()), 0)?;
            result.extend("</member>".bytes())?;
        }
        for (i in 0..state.users.length) {
            if (prefix.length > 0 && !startsWithBytes(state.users[i].path.view(), prefix.view())) { continue; }
            result.extend("<member>".bytes())?;
            appendUserAt(
                mut result,
                state.users[i].name.view(),
                state.users[i].id.view(),
                state.users[i].path.view(),
                state.users[i].createdMs,
            )?;
            result.extend("</member>".bytes())?;
        }
        result.extend("</Users>".bytes())?;
        return await iamAnswer(exchange, action, result.view(), requestId);
    }
    if (action == "GetUser".bytes() && root) {
        // The account's keys, no user named: the account's root user, as AWS answers.
        result.extend(
            "<User><UserId>000000000000</UserId><Arn>arn:aws:iam::000000000000:root</Arn><CreateDate>".bytes(),
        )?;
        appendIso8601(mut result, 0)?;
        result.extend("</CreateDate></User>".bytes())?;
        return await iamAnswer(exchange, action, result.view(), requestId);
    }
    let u = match (userAt(state, name)) {
        Some(u) => u,
        null => {
            // A file's user: got by name, with no keys or policies the API shows.
            for (i in 0..files.length) {
                if (!sameNameIgnoringCase(nameOfUserKey(files[i].view()), name)) { continue; }
                if (action == "GetUser".bytes()) {
                    result.extend("<User>".bytes())?;
                    appendUser(mut result, nameOfUserKey(files[i].view()), idOfUserKey(files[i].view()), 0)?;
                    result.extend("</User>".bytes())?;
                    return await iamAnswer(exchange, action, result.view(), requestId);
                }
                if (action == "ListAccessKeys".bytes()) {
                    result.extend("<AccessKeyMetadata></AccessKeyMetadata><IsTruncated>false</IsTruncated>".bytes())?;
                    return await iamAnswer(exchange, action, result.view(), requestId);
                }
                if (action == "ListUserPolicies".bytes()) {
                    result.extend("<PolicyNames></PolicyNames><IsTruncated>false</IsTruncated>".bytes())?;
                    return await iamAnswer(exchange, action, result.view(), requestId);
                }
            }
            return await iamError(
                exchange,
                404,
                "NoSuchEntity",
                "The user with the name given cannot be found.",
                requestId,
            );
        }
    };
    let user = borrow state.users[u];
    if (action == "GetUser".bytes()) {
        result.extend("<User>".bytes())?;
        appendUserAt(mut result, user.name.view(), user.id.view(), user.path.view(), user.createdMs)?;
        appendTags(mut result, user.tags.view())?;
        result.extend("</User>".bytes())?;
    } else if (action == "ListAccessKeys".bytes()) {
        result.extend("<AccessKeyMetadata>".bytes())?;
        for (k in 0..user.keys.length) {
            result.extend("<member>".bytes())?;
            xmlTextElement(mut result, "UserName", user.name.view())?;
            xmlTextElement(mut result, "AccessKeyId", user.keys[k].accessKey.view())?;
            result.extend(
                if (user.keys[k].active) "<Status>Active</Status>".bytes() else "<Status>Inactive</Status>".bytes(),
            )?;
            result.extend("<CreateDate>".bytes())?;
            appendIso8601(mut result, user.keys[k].createdMs)?;
            result.extend("</CreateDate></member>".bytes())?;
        }
        result.extend("</AccessKeyMetadata><IsTruncated>false</IsTruncated>".bytes())?;
    } else if (action == "ListUserPolicies".bytes()) {
        result.extend("<PolicyNames>".bytes())?;
        for (p in 0..user.policies.length) {
            result.extend("<member>".bytes())?;
            appendXmlEscaped(mut result, user.policies[p].name.view())?;
            result.extend("</member>".bytes())?;
        }
        result.extend("</PolicyNames><IsTruncated>false</IsTruncated>".bytes())?;
    } else {
        // GetUserPolicy: the document URL-encoded, as IAM answers it.
        let policyName = formText(body, "PolicyName")?;
        var found: usize? = null;
        for (p in 0..user.policies.length) {
            if (user.policies[p].name.view() == policyName.view()) { found = Some(p); }
        }
        let p = found ?? {
            return await iamError(exchange, 404, "NoSuchEntity", "The user has no policy with this name.", requestId);
        };
        xmlTextElement(mut result, "UserName", user.name.view())?;
        xmlTextElement(mut result, "PolicyName", user.policies[p].name.view())?;
        var encoded = Vector<u8>.create();
        appendUriEncoded(mut encoded, user.policies[p].text.view(), false)?;
        xmlTextElement(mut result, "PolicyDocument", encoded.view())?;
    }
    return await iamAnswer(exchange, action, result.view(), requestId);
}

// ---- Roles (ADR-0104 §1, §7) ----

/// The roles the roles file holds, from the role set as it is now: not the API's.
fn fileRolesOf(roles: Slice<StsRole>, state: borrow IamState) -> Result<Vector<Vector<u8>>, AllocError> {
    var out = Vector<Vector<u8>>.create();
    for (i in 0..roles.length) {
        // An API role has an id, a file's none (ADR-0106 §1.5): one just deleted, still in the set until the next round,
        // is not taken for a file's.
        if (roles[i].removed || roles[i].id.length > 0 || roleAtIam(state, roles[i].name.view()).isSome()) { continue; }
        out.push(copyBytes(roles[i].name.view())?)?;
    }
    return Ok(out);
}

/// `<Role>…</Role>`'s inside.
fn appendRole(out: borrow mut Vector<u8>, r: borrow IamRole) -> Result<void, AllocError> {
    xmlTextElement(out, "Path", r.path.view())?;
    xmlTextElement(out, "RoleName", r.name.view())?;
    xmlTextElement(out, "RoleId", r.id.view())?;
    out.extend("<Arn>".bytes())?;
    out.extend(IAM_ACCOUNT_ARN.bytes())?;
    out.extend("role".bytes())?;
    appendXmlEscaped(out, r.path.view())?;
    appendXmlEscaped(out, r.name.view())?;
    out.extend("</Arn><CreateDate>".bytes())?;
    appendIso8601(out, r.createdMs)?;
    out.extend("</CreateDate>".bytes())?;
    var encoded = Vector<u8>.create();
    appendUriEncoded(mut encoded, r.trust.view(), false)?;
    xmlTextElement(out, "AssumeRolePolicyDocument", encoded.view())?;
    out.extend("<MaxSessionDuration>".bytes())?;
    appendDecimal(out, r.maxSeconds)?;
    out.extend("</MaxSessionDuration>".bytes())?;
    if (r.description.length > 0) { xmlTextElement(out, "Description", r.description.view())?; }
    appendTags(out, r.tags.view())?;
    out.extend("<RoleLastUsed></RoleLastUsed>".bytes())?;
    return Ok();
}

/// `<Role>…</Role>`'s inside for a roles file's role: no id or trust policy to show, as the file has neither.
fn appendFileRole(out: borrow mut Vector<u8>, name: Slice<u8>, maxSeconds: u64) -> Result<void, AllocError> {
    out.extend("<Path>/</Path>".bytes())?;
    xmlTextElement(out, "RoleName", name)?;
    out.extend("<RoleId></RoleId><Arn>".bytes())?;
    out.extend(IAM_ACCOUNT_ARN.bytes())?;
    out.extend("role/".bytes())?;
    appendXmlEscaped(out, name)?;
    out.extend("</Arn><CreateDate>".bytes())?;
    appendIso8601(out, 0)?;
    out.extend("</CreateDate><MaxSessionDuration>".bytes())?;
    appendDecimal(out, maxSeconds)?;
    out.extend("</MaxSessionDuration>".bytes())?;
    return Ok();
}

/// A role's call, decided already: the reads (GetRole, ListRoles, GetRolePolicy) from the record, the changes through
/// `applyIamCall`.
async fn serveIamRole(
    app: borrow S3App,
    exchange: borrow mut Exchange,
    a: Slice<u8>,
    name: Slice<u8>,
    body: Slice<u8>,
    requestId: Slice<u8>,
) -> Result<void, S3Fail> {
    let snapshot = await readIamSnapshot(borrow app.store) ?? {
        return await iamError(exchange, 500, "ServiceFailure", "The IAM records do not read.", requestId);
    };
    var result = Vector<u8>.create();
    if (a == "ListRoles".bytes()) {
        result.extend("<IsTruncated>false</IsTruncated><Roles>".bytes())?;
        // The roles file's too (ADR-0106 §5), as ListUsers lists the users file's users.
        let roles = app.roles.get().view();
        let prefix = formText(body, "PathPrefix")?;
        let filesShown = prefix.length == 0 || prefix.view() == "/".bytes();
        for (i in 0..roles.length) {
            if (!filesShown) { continue; }
            if (roles[i].removed || roles[i].id.length > 0 || roleAtIam(
                borrow snapshot.state,
                roles[i].name.view(),
            ).isSome()) {
                continue;
            }
            result.extend("<member>".bytes())?;
            appendFileRole(mut result, roles[i].name.view(), roles[i].maxSeconds)?;
            result.extend("</member>".bytes())?;
        }
        for (i in 0..snapshot.state.roles.length) {
            let path = snapshot.state.roles[i].path.view();
            if (prefix.length > 0 && !startsWithBytes(path, prefix.view())) { continue; }
            result.extend("<member>".bytes())?;
            appendRole(mut result, borrow snapshot.state.roles[i])?;
            result.extend("</member>".bytes())?;
        }
        result.extend("</Roles>".bytes())?;
        return await iamAnswer(exchange, a, result.view(), requestId);
    }
    if (!roleNameOk(name) || name == "*".bytes()) {
        return await iamError(exchange, 400, "ValidationError", "RoleName is 1 to 64 of \\w+=,.@-.", requestId);
    }
    if (a == "GetRole".bytes() && roleAtIam(borrow snapshot.state, name).isNull()) {
        // A roles file's role: its name and session length; its policy is the operator's (ADR-0106 §5).
        let roles = app.roles.get().view();
        for (i in 0..roles.length) {
            if (roles[i].removed || roles[i].id.length > 0 || roles[i].name.view() != name) { continue; }
            result.extend("<Role>".bytes())?;
            appendFileRole(mut result, roles[i].name.view(), roles[i].maxSeconds)?;
            result.extend("</Role>".bytes())?;
            return await iamAnswer(exchange, a, result.view(), requestId);
        }
    }
    if (a == "GetRole".bytes() || a == "GetRolePolicy".bytes()) {
        let r = roleAtIam(borrow snapshot.state, name) ?? {
            return await iamError(
                exchange,
                404,
                "NoSuchEntity",
                "The role with the name given cannot be found.",
                requestId,
            );
        };
        let role = borrow snapshot.state.roles[r];
        if (a == "GetRole".bytes()) {
            result.extend("<Role>".bytes())?;
            appendRole(mut result, role)?;
            result.extend("</Role>".bytes())?;
        } else {
            let policyName = formText(body, "PolicyName")?;
            var found: usize? = null;
            for (p in 0..role.policies.length) {
                if (role.policies[p].name.view() == policyName.view()) { found = Some(p); }
            }
            let p = found ?? {
                return await iamError(
                    exchange,
                    404,
                    "NoSuchEntity",
                    "The role has no policy with this name.",
                    requestId,
                );
            };
            xmlTextElement(mut result, "RoleName", role.name.view())?;
            xmlTextElement(mut result, "PolicyName", role.policies[p].name.view())?;
            var encoded = Vector<u8>.create();
            appendUriEncoded(mut encoded, role.policies[p].text.view(), false)?;
            xmlTextElement(mut result, "PolicyDocument", encoded.view())?;
        }
        return await iamAnswer(exchange, a, result.view(), requestId);
    }
    let owned = copyBytes(name)?;
    let call = if (a == "CreateRole".bytes()) {
        let trust = formText(body, "AssumeRolePolicyDocument")?;
        let given = formText(body, "MaxSessionDuration")?;
        var seconds: u64 = 3600;
        if (given.length > 0) {
            seconds = parseDecimal(given.view()) ?? 0;
            if (seconds < 3600 || seconds > 43200) {
                return await iamError(
                    exchange,
                    400,
                    "ValidationError",
                    "MaxSessionDuration is 3600 to 43200.",
                    requestId,
                );
            }
        }
        let path = formText(body, "Path")?;
        let givenPath = if (path.length == 0) copyBytes("/".bytes())? else path;
        if (!iamPathOk(givenPath.view())) {
            return await iamError(
                exchange,
                400,
                "ValidationError",
                "Path is / or /…/, 1 to 512 characters.",
                requestId,
            );
        }
        let description = formText(body, "Description")?;
        if (description.length > 1000) {
            return await iamError(
                exchange,
                400,
                "ValidationError",
                "Description is 1,000 characters at most.",
                requestId,
            );
        }
        let tags = formTags(body)? ?? {
            return await iamError(
                exchange,
                400,
                "ValidationError",
                "Tags are 50 at most, each a key of 1 to 128 characters and a value of 256 at most.",
                requestId,
            );
        };
        IamCall.CreateRole(owned, trust, seconds, givenPath, description, tags)
    } else if (a == "DeleteRole".bytes()) IamCall.DeleteRole(owned)
        else if (a == "PutRolePolicy".bytes()) IamCall.PutRolePolicy(
            owned,
            formText(body, "PolicyName")?,
            formText(body, "PolicyDocument")?,
        )
        else IamCall.DeleteRolePolicy(owned, formText(body, "PolicyName")?);
    let fileRoles = fileRolesOf(app.roles.get().view(), borrow snapshot.state)?;
    var outcome = IamOutcome.Conflict;
    for (attempt in 0..3) {
        var guard = await lockStore(app)?;
        let store = guard.data();
        let nowMs = Clock.unixMillis();
        let c = borrow call;
        let none = Vector<Vector<u8>>.create();
        let users = none.view();
        let roles = fileRoles.view();
        outcome = match (await Async.blocking(() => applyIamCall(store, c, users, roles, nowMs))) {
            Ok(o) => o,
            Err(e) => { return Err(storeFail(e, 0)); }
        };
        match (outcome) {
            IamOutcome.Conflict => {}
            _ => { break; }
        }
    }
    return match (outcome) {
        IamOutcome.Done(_, _, role, _, _) => {
            match (role) {
                Some(r) => {
                    result.extend("<Role>".bytes())?;
                    appendRole(mut result, borrow r)?;
                    result.extend("</Role>".bytes())?;
                }
                null => {}
            }
            await iamAnswer(exchange, a, result.view(), requestId)
        },
        IamOutcome.NotReady => await iamError(
            exchange,
            503,
            "ServiceUnavailable",
            "The IAM records are not ready yet; try again.",
            requestId,
        ),
        IamOutcome.NoSuchEntity => await iamError(
            exchange,
            404,
            "NoSuchEntity",
            "The role or policy named is not the API's.",
            requestId,
        ),
        IamOutcome.EntityAlreadyExists => await iamError(
            exchange,
            409,
            "EntityAlreadyExists",
            "A role with this name already exists.",
            requestId,
        ),
        IamOutcome.LimitExceeded => await iamError(
            exchange,
            409,
            "LimitExceeded",
            "Cannot exceed the quota for this role.",
            requestId,
        ),
        IamOutcome.DeleteConflict => await iamError(
            exchange,
            409,
            "DeleteConflict",
            "Delete the role's policy first.",
            requestId,
        ),
        IamOutcome.MalformedPolicyDocument => await iamError(
            exchange,
            400,
            "MalformedPolicyDocument",
            "The policy document is not one taken here.",
            requestId,
        ),
        IamOutcome.Conflict => await iamError(
            exchange,
            409,
            "ConcurrentModification",
            "The IAM records changed meanwhile; try again.",
            requestId,
        ),
    };
}
