// S3's error codes, their HTTP statuses and messages (ADR-0008 §11), and the StoreError mapping.

enum S3Code {
    AccessDenied,
    AuthorizationHeaderMalformed,
    AuthorizationQueryParametersError,
    BadDigest,
    BucketAlreadyOwnedByYou,
    BucketNotEmpty,
    EntityTooLarge,
    EntityTooSmall,
    IncompleteBody,
    InsufficientStorage,
    InternalError,
    InvalidAccessKeyId,
    InvalidArgument,
    InvalidBucketName,
    InvalidDigest,
    InvalidPart,
    InvalidPartOrder,
    InvalidRange,
    InvalidRequest,
    InvalidToken,
    KeyTooLongError,
    MalformedXML,
    MetadataTooLarge,
    MethodNotAllowed,
    MissingContentLength,
    NoSuchBucket,
    NoSuchKey,
    NoSuchUpload,
    NotImplemented,
    NotModified,
    PreconditionFailed,
    RequestTimeTooSkewed,
    ServiceUnavailable,
    SignatureDoesNotMatch,
    XAmzContentSHA256Mismatch,
}

fn s3Status(code: S3Code) -> u16 => match (code) {
    S3Code.AccessDenied => 403,
    S3Code.AuthorizationHeaderMalformed => 400,
    S3Code.AuthorizationQueryParametersError => 400,
    S3Code.BadDigest => 400,
    S3Code.BucketAlreadyOwnedByYou => 409,
    S3Code.BucketNotEmpty => 409,
    S3Code.EntityTooLarge => 400,
    S3Code.EntityTooSmall => 400,
    S3Code.IncompleteBody => 400,
    S3Code.InsufficientStorage => 507,
    S3Code.InternalError => 500,
    S3Code.InvalidAccessKeyId => 403,
    S3Code.InvalidArgument => 400,
    S3Code.InvalidBucketName => 400,
    S3Code.InvalidDigest => 400,
    S3Code.InvalidPart => 400,
    S3Code.InvalidPartOrder => 400,
    S3Code.InvalidRange => 416,
    S3Code.InvalidRequest => 400,
    S3Code.InvalidToken => 400,
    S3Code.KeyTooLongError => 400,
    S3Code.MalformedXML => 400,
    S3Code.MetadataTooLarge => 400,
    S3Code.MethodNotAllowed => 405,
    S3Code.MissingContentLength => 411,
    S3Code.NoSuchBucket => 404,
    S3Code.NoSuchKey => 404,
    S3Code.NoSuchUpload => 404,
    S3Code.NotImplemented => 501,
    S3Code.NotModified => 304,
    S3Code.PreconditionFailed => 412,
    S3Code.RequestTimeTooSkewed => 403,
    S3Code.ServiceUnavailable => 503,
    S3Code.SignatureDoesNotMatch => 403,
    S3Code.XAmzContentSHA256Mismatch => 400,
};

fn s3CodeName(code: S3Code) -> StringView => match (code) {
    S3Code.AccessDenied => "AccessDenied",
    S3Code.AuthorizationHeaderMalformed => "AuthorizationHeaderMalformed",
    S3Code.AuthorizationQueryParametersError => "AuthorizationQueryParametersError",
    S3Code.BadDigest => "BadDigest",
    S3Code.BucketAlreadyOwnedByYou => "BucketAlreadyOwnedByYou",
    S3Code.BucketNotEmpty => "BucketNotEmpty",
    S3Code.EntityTooLarge => "EntityTooLarge",
    S3Code.EntityTooSmall => "EntityTooSmall",
    S3Code.IncompleteBody => "IncompleteBody",
    S3Code.InsufficientStorage => "InsufficientStorage",
    S3Code.InternalError => "InternalError",
    S3Code.InvalidAccessKeyId => "InvalidAccessKeyId",
    S3Code.InvalidArgument => "InvalidArgument",
    S3Code.InvalidBucketName => "InvalidBucketName",
    S3Code.InvalidDigest => "InvalidDigest",
    S3Code.InvalidPart => "InvalidPart",
    S3Code.InvalidPartOrder => "InvalidPartOrder",
    S3Code.InvalidRange => "InvalidRange",
    S3Code.InvalidRequest => "InvalidRequest",
    S3Code.InvalidToken => "InvalidToken",
    S3Code.KeyTooLongError => "KeyTooLongError",
    S3Code.MalformedXML => "MalformedXML",
    S3Code.MetadataTooLarge => "MetadataTooLarge",
    S3Code.MethodNotAllowed => "MethodNotAllowed",
    S3Code.MissingContentLength => "MissingContentLength",
    S3Code.NoSuchBucket => "NoSuchBucket",
    S3Code.NoSuchKey => "NoSuchKey",
    S3Code.NoSuchUpload => "NoSuchUpload",
    S3Code.NotImplemented => "NotImplemented",
    S3Code.NotModified => "NotModified",
    S3Code.PreconditionFailed => "PreconditionFailed",
    S3Code.RequestTimeTooSkewed => "RequestTimeTooSkewed",
    S3Code.ServiceUnavailable => "ServiceUnavailable",
    S3Code.SignatureDoesNotMatch => "SignatureDoesNotMatch",
    S3Code.XAmzContentSHA256Mismatch => "XAmzContentSHA256Mismatch",
};

fn s3Message(code: S3Code) -> StringView => match (code) {
    S3Code.AccessDenied => "Access Denied",
    S3Code.AuthorizationHeaderMalformed => "The authorization header is malformed.",
    S3Code.AuthorizationQueryParametersError =>
        "Query-string authentication requires the X-Amz-Algorithm, X-Amz-Credential, X-Amz-Signature, X-Amz-Date, X-Amz-SignedHeaders, and X-Amz-Expires parameters.",
    S3Code.BadDigest => "The checksum you specified did not match what we received.",
    S3Code.BucketAlreadyOwnedByYou =>
        "Your previous request to create the named bucket succeeded and you already own it.",
    S3Code.BucketNotEmpty => "The bucket you tried to delete is not empty.",
    S3Code.EntityTooLarge => "Your proposed upload exceeds the maximum allowed object size.",
    S3Code.EntityTooSmall => "Your proposed upload is smaller than the minimum allowed object size.",
    S3Code.IncompleteBody => "You did not provide the number of bytes specified by the Content-Length HTTP header.",
    S3Code.InsufficientStorage => "The store has no room for this object.",
    S3Code.InternalError => "We encountered an internal error. Please try again.",
    S3Code.InvalidAccessKeyId => "The AWS access key ID you provided does not exist in our records.",
    S3Code.InvalidArgument => "Invalid Argument",
    S3Code.InvalidBucketName => "The specified bucket is not valid.",
    S3Code.InvalidDigest => "The Content-MD5 or checksum value you specified is not valid.",
    S3Code.InvalidPart =>
        "One or more of the specified parts could not be found. The part may not have been uploaded, or the specified entity tag may not match the part's entity tag.",
    S3Code.InvalidPartOrder => "The list of parts was not in ascending order. Parts must be ordered by part number.",
    S3Code.InvalidRange => "The requested range is not satisfiable",
    S3Code.InvalidRequest => "Invalid Request",
    S3Code.InvalidToken => "The provided token is malformed or otherwise invalid.",
    S3Code.KeyTooLongError => "Your key is too long.",
    S3Code.MalformedXML => "The XML you provided was not well-formed or did not validate against our published schema.",
    S3Code.MetadataTooLarge => "Your metadata headers exceed the maximum allowed metadata size.",
    S3Code.MethodNotAllowed => "The specified method is not allowed against this resource.",
    S3Code.MissingContentLength => "You must provide the Content-Length HTTP header.",
    S3Code.NoSuchBucket => "The specified bucket does not exist.",
    S3Code.NoSuchKey => "The specified key does not exist.",
    S3Code.NoSuchUpload =>
        "The specified multipart upload does not exist. The upload ID may be invalid, or the upload may have been aborted or completed.",
    S3Code.NotImplemented => "A header or query you provided implies functionality that is not implemented.",
    S3Code.NotModified => "Not Modified",
    S3Code.PreconditionFailed => "At least one of the preconditions you specified did not hold.",
    S3Code.RequestTimeTooSkewed => "The difference between the request time and the current time is too large.",
    S3Code.ServiceUnavailable => "Please reduce your request rate.",
    S3Code.SignatureDoesNotMatch =>
        "The request signature we calculated does not match the signature you provided. Check your key and signing method.",
    S3Code.XAmzContentSHA256Mismatch => "The provided 'x-amz-content-sha256' header does not match what was computed.",
};

/// The S3 code of a store failure. `key` decides between a key that is too long and one that is empty.
fn codeOfStore(e: StoreError, keyLength: usize) -> S3Code => match (e) {
    StoreError.NoSuchBucket => S3Code.NoSuchBucket,
    StoreError.NoSuchKey => S3Code.NoSuchKey,
    StoreError.BucketAlreadyExists => S3Code.BucketAlreadyOwnedByYou,
    StoreError.BucketNotEmpty => S3Code.BucketNotEmpty,
    StoreError.InvalidBucketName => S3Code.InvalidBucketName,
    StoreError.InvalidKey => if (keyLength > MAX_KEY_BYTES) S3Code.KeyTooLongError else S3Code.InvalidArgument,
    StoreError.EntityTooLarge => S3Code.EntityTooLarge,
    StoreError.PreconditionFailed => S3Code.PreconditionFailed,
    StoreError.InsufficientStorage => S3Code.InsufficientStorage,
    StoreError.NoSuchUpload => S3Code.NoSuchUpload,
    StoreError.InvalidPart => S3Code.InvalidPart,
    StoreError.InvalidPartOrder => S3Code.InvalidPartOrder,
    StoreError.EntityTooSmall => S3Code.EntityTooSmall,
    StoreError.InvalidPartNumber => S3Code.InvalidArgument,
    StoreError.MetadataTooLarge => S3Code.MetadataTooLarge,
    StoreError.Journal(_) => S3Code.ServiceUnavailable,
    _ => S3Code.InternalError,
};
