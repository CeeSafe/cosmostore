// S3's error codes, their HTTP statuses and messages (ADR-0008 §11), and the StoreError mapping.

enum S3Code {
    AccessDenied,
    /// SigV2 (`Authorization: AWS ...`, or `AWSAccessKeyId` in the query): S3's InvalidRequest for it.
    AuthorizationMechanism,
    AuthorizationHeaderMalformed,
    AuthorizationQueryParametersError,
    BadDigest,
    BucketAlreadyOwnedByYou,
    BucketNotEmpty,
    EntityTooLarge,
    EntityTooSmall,
    IncompleteBody,
    InsufficientStorage,
    InternalError,
    InvalidAccessKeyId,
    InvalidArgument,
    InvalidBucketName,
    InvalidDigest,
    InvalidPart,
    InvalidPartOrder,
    InvalidPolicyDocument,
    InvalidRange,
    InvalidRequest,
    InvalidTag,
    InvalidToken,
    ExpiredToken,
    KeyTooLongError,
    MalformedPOSTRequest,
    MalformedPolicy,
    MalformedACLError,
    MissingSecurityHeader,
    UnexpectedContent,
    UnresolvableGrantByEmailAddress,
    MalformedXML,
    MetadataTooLarge,
    MethodNotAllowed,
    MissingContentLength,
    NoSuchBucket,
    NoSuchBucketPolicy,
    NoSuchKey,
    NoSuchLifecycleConfiguration,
    InvalidTargetBucketForLogging,
    NoSuchWebsiteConfiguration,
    NoSuchConfiguration,
    NoSuchAccessPoint,
    NoSuchAccessPointPolicy,
    AccessPointAlreadyOwnedByYou,
    ReplicationConfigurationNotFoundError,
    NoSuchPublicAccessBlockConfiguration,
    NoSuchTagSet,
    NoSuchUpload,
    NoSuchVersion,
    InvalidBucketState,
    AccessForbidden,
    QuotaExceeded,
    NoSuchCORSConfiguration,
    /// GetBucketEncryption of a bucket without a default (ADR-0046 §5).
    ServerSideEncryptionConfigurationNotFoundError,
    InvalidRetentionPeriod,
    NoSuchObjectLockConfiguration,
    ObjectLockConfigurationNotFoundError,
    NotImplemented,
    NotModified,
    PreconditionFailed,
    RequestTimeTooSkewed,
    ServiceUnavailable,
    SlowDown,
    SignatureDoesNotMatch,
    XAmzContentSHA256Mismatch,
}

fn s3Status(code: S3Code) -> u16 => match (code) {
    S3Code.AccessDenied => 403,
    S3Code.AuthorizationMechanism => 400,
    S3Code.AuthorizationHeaderMalformed => 400,
    S3Code.AuthorizationQueryParametersError => 400,
    S3Code.BadDigest => 400,
    S3Code.BucketAlreadyOwnedByYou => 409,
    S3Code.BucketNotEmpty => 409,
    S3Code.EntityTooLarge => 400,
    S3Code.EntityTooSmall => 400,
    S3Code.IncompleteBody => 400,
    S3Code.InsufficientStorage => 507,
    S3Code.InternalError => 500,
    S3Code.InvalidAccessKeyId => 403,
    S3Code.InvalidArgument => 400,
    S3Code.InvalidBucketName => 400,
    S3Code.InvalidDigest => 400,
    S3Code.InvalidPart => 400,
    S3Code.InvalidPartOrder => 400,
    S3Code.InvalidPolicyDocument => 400,
    S3Code.InvalidRange => 416,
    S3Code.InvalidRequest => 400,
    S3Code.InvalidTag => 400,
    S3Code.InvalidToken => 400,
    S3Code.ExpiredToken => 400,
    S3Code.KeyTooLongError => 400,
    S3Code.MalformedPOSTRequest => 400,
    S3Code.MalformedXML => 400,
    S3Code.MetadataTooLarge => 400,
    S3Code.MethodNotAllowed => 405,
    S3Code.MissingContentLength => 411,
    S3Code.NoSuchBucket => 404,
    S3Code.NoSuchKey => 404,
    S3Code.NoSuchLifecycleConfiguration => 404,
    S3Code.InvalidTargetBucketForLogging => 400,
    S3Code.NoSuchWebsiteConfiguration => 404,
    S3Code.NoSuchConfiguration => 404,
    S3Code.NoSuchAccessPoint => 404,
    S3Code.NoSuchAccessPointPolicy => 404,
    S3Code.AccessPointAlreadyOwnedByYou => 409,
    S3Code.ReplicationConfigurationNotFoundError => 404,
    S3Code.NoSuchPublicAccessBlockConfiguration => 404,
    S3Code.NoSuchTagSet => 404,
    S3Code.NoSuchUpload => 404,
    S3Code.NoSuchBucketPolicy => 404,
    S3Code.MalformedPolicy => 400,
    S3Code.MalformedACLError => 400,
    S3Code.MissingSecurityHeader => 400,
    S3Code.UnexpectedContent => 400,
    S3Code.UnresolvableGrantByEmailAddress => 400,
    S3Code.NoSuchVersion => 404,
    S3Code.InvalidBucketState => 409,
    S3Code.AccessForbidden => 403,
    S3Code.QuotaExceeded => 403,
    S3Code.NoSuchCORSConfiguration => 404,
    S3Code.ServerSideEncryptionConfigurationNotFoundError => 404,
    S3Code.InvalidRetentionPeriod => 400,
    S3Code.NoSuchObjectLockConfiguration => 404,
    S3Code.ObjectLockConfigurationNotFoundError => 404,
    S3Code.NotImplemented => 501,
    S3Code.NotModified => 304,
    S3Code.PreconditionFailed => 412,
    S3Code.RequestTimeTooSkewed => 403,
    S3Code.ServiceUnavailable => 503,
    S3Code.SlowDown => 503,
    S3Code.SignatureDoesNotMatch => 403,
    S3Code.XAmzContentSHA256Mismatch => 400,
};

