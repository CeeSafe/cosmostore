// The stats endpoint (ADR-0021): `GET /_cosmostore/stats`, SigV4-authenticated like any request, returns the store's
// state and cumulative counters as JSON, for benchmarks (syncs per 1,000 PUTs, write amplification) and monitoring.
// `_cosmostore` cannot be a bucket (`_` is not allowed in bucket names), so the path never shadows one.
import web_core;
import web_http;
import web_server;

const STATS_BUCKET: StringView = "_cosmostore";

/// The numbers, read under the lock.
struct StoreStats {
    objects: u64;
    segments: u64;
    uploads: u64;
    usedBytes: u64;
    journalBytes: u64;
    journalSyncs: u64;
    journalRotationFailures: u64;
    journalSyncHandleFallbacks: u64;
    volumeBytes: u64;
    volumeAvailableBytes: u64;
    recordsApplied: u64;
    deferredExtents: u64;
    pinnedExtents: u64;
    counters: StoreCounters;
    debt: UpkeepDebt;
    /// The event outbox (ADR-0048): waiting, queued, delivered, dropped, failed deliveries.
    events: [u64; 5];
}

fn readStats(store: borrow ObjectStore) -> StoreStats => StoreStats {
    objects: store.objectCount() as u64,
    segments: store.segmentCount() as u64,
    uploads: store.uploadCount() as u64,
    usedBytes: store.usedBytes(),
    journalBytes: store.journalBytes(),
    journalSyncs: store.journalSyncs(),
    journalRotationFailures: store.journalRotationFailures(),
    journalSyncHandleFallbacks: store.journalSyncHandleFallbacks(),
    volumeBytes: match (store.volumeSpace()) {
        Some(v) => v.total,
        null => 0,
    },
    volumeAvailableBytes: match (store.volumeSpace()) {
        Some(v) => v.available,
        null => 0,
    },
    recordsApplied: store.recordsApplied(),
    deferredExtents: store.deferredExtentCount() as u64,
    pinnedExtents: store.pinnedExtentCount() as u64,
    counters: store.counters(),
    debt: store.upkeepDebt(),
    events: store.outboxCounts(),
};

fn jsonField(out: borrow mut Vector<u8>, name: StringView, value: u64, last: bool) -> Result<void, AllocError> {
    out.push('"')?;
    out.extend(name.bytes())?;
    out.extend("\": ".bytes())?;
    appendDecimal(out, value)?;
    out.extend(if (last) "\n".bytes() else ",\n  ".bytes())?;
    return Ok();
}

/// `<name>Count`, and `<name>P50Micros`, `P99Micros` and `P999Micros`, each the top of its histogram bucket (ADR-0033).
fn latencyFields(
    out: borrow mut Vector<u8>,
    l: borrow Latencies,
    name: StringView,
    kind: u8,
) -> Result<void, AllocError> {
    let suffixes = ["Count", "P50Micros", "P99Micros", "P999Micros"];
    let perMillion = [0u64, 500000, 990000, 999000];
    for (i in 0..4) {
        var field = String.create();
        field.append(name)?;
        field.append(suffixes[i])?;
        let value = if (i == 0) l.count(kind) else l.percentile(kind, perMillion[i]);
        jsonField(out, field.view(), value, false)?;
    }
    return Ok();
}

async fn statsOf(app: borrow S3App) -> Result<StoreStats, S3Fail> {
    var guard = await lockStore(app)?;
    let store = guard.data();
    return Ok(await Async.blocking(() => readStats(store)));
}

/// `"sealedByKey": {"s3": {<id>: n, …}, "kms": {…}}` (ADR-0100 §3): for each master key of the current sets, how
/// many versions and uploads it seals; `null` for a count not known. A key whose count is 0 can be removed.
async fn sealedByKey(app: borrow S3App) -> Result<Vector<u8>, S3Fail> {
    var guard = await lockStore(app)?;
    let store = guard.data();
    var out = Vector<u8>.create();
    out.extend("\"sealedByKey\": {".bytes())?;
    for (mode in ["s3", "kms"]) {
        if (mode == "kms") { out.extend(", ".bytes())?; }
        out.push('"')?;
        out.extend(mode.bytes())?;
        out.extend("\": {".bytes())?;
        let keys = if (mode == "s3") app.sseKeys.get().view() else app.kmsKeys.get().view();
        for (i in 0..keys.length) {
            if (i > 0) { out.extend(", ".bytes())?; }
            writeJsonText(mut out, keys[i].id.view())?;
            out.extend(": ".bytes())?;
            var prefix = copyBytes("v1.".bytes())?;
            prefix.extend(mode.bytes())?;
            prefix.push('.')?;
            prefix.extend(keys[i].id.view())?;
            prefix.push('.')?;
            match (store.sealedCount(prefix.view())) {
                Some(n) => { appendDecimal(mut out, n)?; }
                null => { out.extend("null".bytes())?; }
            }
        }
        out.push('}')?;
    }
    out.extend("},\n  ".bytes())?;
    return Ok(out);
}

async fn serveStats(app: borrow S3App, req: borrow S3Request, exchange: borrow mut Exchange) -> Result<void, S3Fail> {
    if (!isMethod(req.method, Method.Get)) { return Err(S3Fail.Code(S3Code.NoSuchKey)); }
    if (req.key.view() == "buckets") { return await serveBuckets(app, exchange); } // the admin API (ADR-0054)
    if (req.key.view() != "stats") { return Err(S3Fail.Code(S3Code.NoSuchKey)); }
    let s = await statsOf(app)?;
    var body = Vector<u8>.create();
    body.extend("{\n  ".bytes())?;
    jsonField(mut body, "objects", s.objects, false)?;
    jsonField(mut body, "segments", s.segments, false)?;
    jsonField(mut body, "uploads", s.uploads, false)?;
    jsonField(mut body, "usedBytes", s.usedBytes, false)?;
    jsonField(mut body, "journalBytes", s.journalBytes, false)?;
    body.extend((await sealedByKey(app)?).view())?;
    match (borrow app.audit) {
        Some(audit) => { jsonField(mut body, "auditLinesDropped", audit.dropped.load(), false)?; }
        null => {}
    }
    jsonField(mut body, "rateLimited", app.rates.limited.load(), false)?;
    jsonField(mut body, "eventsPending", s.events[0], false)?;
    jsonField(mut body, "eventsQueued", s.events[1], false)?;
    jsonField(mut body, "eventsDelivered", s.events[2], false)?;
    jsonField(mut body, "eventsDropped", s.events[3], false)?;
    jsonField(mut body, "eventDeliveryFailures", s.events[4], false)?;
    jsonField(mut body, "journalSyncs", s.journalSyncs, false)?;
    jsonField(mut body, "journalRotationFailures", s.journalRotationFailures, false)?;
    jsonField(mut body, "journalSyncHandleFallbacks", s.journalSyncHandleFallbacks, false)?;
    jsonField(mut body, "volumeBytes", s.volumeBytes, false)?;
    jsonField(mut body, "volumeAvailableBytes", s.volumeAvailableBytes, false)?;
    jsonField(mut body, "recordsApplied", s.recordsApplied, false)?;
    jsonField(mut body, "deferredExtents", s.deferredExtents, false)?;
    jsonField(mut body, "pinnedExtents", s.pinnedExtents, false)?;
    jsonField(mut body, "payloadBytes", s.counters.payloadBytes, false)?;
    jsonField(mut body, "journalBytesWritten", s.counters.journalBytesWritten, false)?;
    jsonField(mut body, "extentBytesWritten", s.counters.extentBytesWritten, false)?;
    jsonField(mut body, "checkpointBytesWritten", s.counters.checkpointBytesWritten, false)?;
    jsonField(mut body, "compactionBytesCopied", s.counters.compactionBytesCopied, false)?;
    jsonField(mut body, "segmentsCompacted", s.counters.segmentsCompacted, false)?;
    jsonField(mut body, "checkpoints", s.counters.checkpoints, false)?;
    jsonField(mut body, "upkeepHolds", s.counters.upkeepHolds, false)?;
    jsonField(mut body, "upkeepSlowHolds", s.counters.upkeepSlowHolds, false)?;
    jsonField(mut body, "upkeepLongestMicros", s.counters.upkeepLongestMicros, false)?;
    jsonField(mut body, "compactionDebtBytes", s.debt.compactionFrees, false)?;
    jsonField(mut body, "compactionDebtCopyBytes", s.debt.compactionCopies, false)?;
    jsonField(mut body, "uncheckpointedBytes", s.debt.uncheckpointed, false)?;
    latencyFields(mut body, borrow app.latencies, "putObject", LATENCY_PUT)?;
    latencyFields(mut body, borrow app.latencies, "getObject", LATENCY_GET)?;
    latencyFields(mut body, borrow app.latencies, "headObject", LATENCY_HEAD)?;
    latencyFields(mut body, borrow app.latencies, "deleteObject", LATENCY_DELETE)?;
    latencyFields(mut body, borrow app.latencies, "otherRequests", LATENCY_OTHER)?;
    jsonField(mut body, "requests", app.requests.load(), true)?;
    body.extend("}\n".bytes())?;
    exchange.header("content-type", "application/json".bytes())?;
    await exchange.send(Status.ok(), body.view())?;
    return Ok();
}
