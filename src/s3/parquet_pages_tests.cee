/// Every column of a file read, whatever its bytes: a value or a refusal, never a panic. How many were read.
fn readAllColumns(bytes: Slice<u8>) -> usize {
    if (bytes.length < 12) { return 0; }
    let n = parquetFooterLength(bytes[bytes.length - 8..], bytes.length as u64) ?? { return 0; };
    let start = bytes.length - 8 - n as usize;
    let footer = match (parseParquetFooter(bytes[start..bytes.length - 8], bytes.length as u64)) {
        Ok(Some(f)) => f,
        _ => { return 0; }
    };
    let leaves = match (schemaLeaves(borrow footer.meta)) {
        Ok(Some(l)) => l,
        _ => { return 0; }
    };
    let groups = structItems(borrow footer.meta, PQ_FILE_ROW_GROUPS) ?? { return 0; };
    var read: usize = 0;
    for (g in 0..groups.length) {
        let group = match (borrow groups[g]) {
            ThriftValue.Struct(f) => f,
            _ => { continue; }
        };
        let columns = structItems(group, PQ_GROUP_COLUMNS) ?? { continue; };
        for (c in 0..columns.length) {
            if (c >= leaves.length) { break; }
            let chunk = match (borrow columns[c]) {
                ThriftValue.Struct(f) => f,
                _ => { continue; }
            };
            match (readColumnChunk(bytes, chunk, borrow leaves[c])) {
                Ok(Some(_)) => { read += 1; }
                _ => {}
            }
        }
    }
    return read;
}

/// Hostile bytes are refused, not trusted (ADR-0112 §5): each fixture with a byte changed at each of many places, or
/// cut short, reads or is refused, and never panics.
@test
fn pagesRefuseWhatDoesNotAddUp() -> Result<void, TestFailure> {
    var tried: u64 = 0;
    for (fixture in [
        PAGES_FLAT_V1_DICT[..],
        PAGES_FLAT_V2_DICT_GZIP[..],
        PAGES_FLAT_V2_DELTA[..],
        PAGES_NESTED_V1[..],
    ]) {
        let good = fixtureBytes(fixture);
        let whole = readAllColumns(good.view());
        Check.isTrue(whole > 0, "the fixture reads")?;
        var x: u32 = 2463534242;
        // The data's bytes (the footer's are the footer reader's): each changed by a pseudo-random amount.
        for (at in 4..good.length - 8) {
            x = x ^ (x << 13);
            x = x ^ (x >> 17);
            x = x ^ (x << 5);
            var bad = copyBytes(good.view())!;
            bad[at] = bad[at] ^ truncate<u8>(x | 1);
            let _ = readAllColumns(bad.view());
            tried += 1;
        }
        for (cut in [good.length / 2, good.length - 9, good.length - 1]) {
            let _ = readAllColumns(good.view()[0..cut]);
        }
    }
    Check.isTrue(tried > 5000, "thousands of changed files")?;
    return Ok();
}

