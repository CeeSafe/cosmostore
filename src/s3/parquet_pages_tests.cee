@test
fn pagesFlatRenamed() -> Result<void, TestFailure> =>
    checkFixture("FLAT_IDS_RENAMED", PAGES_FLAT_IDS_RENAMED[..], PAGES_FLAT_IDS_RENAMED_EXPECTED[..]);

/// Leaves are keyed by field id (ADR-0112 §2): the renamed file's columns, in the other order, are the first's.
@test
fn leavesMatchByFieldId() -> Result<void, TestFailure> {
    let first = fixtureLeaves(PAGES_FLAT_IDS[..]);
    let renamed = fixtureLeaves(PAGES_FLAT_IDS_RENAMED[..]);
    let order = leafOrder(first.view(), renamed.view())! ?? { return Err(TestFailure.create("matched")); };
    for (k in 0..order.length) { Check.equalU64((order.length - 1 - k) as u64, order[k] as u64)?; }
    let firstKey = mergeKeyOf(first.view())!;
    let renamedKey = mergeKeyOf(renamed.view())!;
    Check.isTrue(firstKey.view() == renamedKey.view(), "one merge key")?;
    // Without ids, names key them: other names are other columns.
    let plain = fixtureLeaves(PAGES_FLAT_V1_DICT[..]);
    Check.isTrue(leafOrder(plain.view(), renamed.view())!.isNull(), "names differ")?;
    Check.isTrue(leafOrder(plain.view(), first.view())!.isNull(), "ids against none")?;
    return Ok();
}

fn fixtureLeaves(chunks: Slice<StringView>) -> Vector<PageLeaf> {
    let bytes = fixtureBytes(chunks);
    let n = parquetFooterLength(bytes.view()[bytes.length - 8..], bytes.length as u64)!;
    let start = bytes.length - 8 - n as usize;
    let footer = parseParquetFooter(bytes.view()[start..bytes.length - 8], bytes.length as u64)!!;
    return schemaLeaves(borrow footer.meta)!!;
}

/// An RLE run's value wider than its bit width is refused (found by the page fuzzer: a BOOLEAN run of 7).
@test
fn hybridRefusesARunWiderThanItsWidth() -> Result<void, TestFailure> {
    var out = Vector<u64>.create();
    Check.isTrue(readHybrid([2u8, 1][..], 0, 2, 1, 1, mut out)!, "a run of one 1")?;
    Check.equalU64(1, out[0])?;
    Check.isTrue(!readHybrid([2u8, 7][..], 0, 2, 1, 1, mut out)!, "a run of one 7, at width 1")?;
    Check.isTrue(!readHybrid([2u8, 0x10][..], 0, 2, 4, 1, mut out)!, "a run of one 16, at width 4")?;
    Check.isTrue(readHybrid([2u8, 0x0F][..], 0, 2, 4, 1, mut out)!, "a run of one 15, at width 4")?;
    return Ok();
}

/// A chunk whose first value continues a row is refused (found by the page fuzzer): merged, it would join another
/// file's last row.
@test
fn chunkStartingWithinARowRefused() -> Result<void, TestFailure> {
    let read = readFixture(fixtureBytes(PAGES_NESTED_V1[..]).view())?;
    var k: usize = 0;
    while (read.leaves[k].maxRep == 0) { k += 1; }
    let leaf = borrow read.leaves[k];
    var one = Vector<PageLeaf>.create();
    one.push(PageLeaf {
        path: copyBytes(leaf.path.view())!,
        key: copyBytes(leaf.key.view())!,
        physical: leaf.physical,
        typeLength: leaf.typeLength,
        maxDef: leaf.maxDef,
        maxRep: leaf.maxRep,
    })!;
    for (first in [0u8, 1]) {
        var columns = Vector<ColumnValues>.create();
        columns.push(emptyValues())!;
        Check.isTrue(appendValues(mut columns[0], borrow read.columns[k])!, "copied")?;
        columns[0].reps[0] = first;
        let g = encodeRowGroup(4, one.view(), columns.view(), read.rows, PQ_CODEC_UNCOMPRESSED)!!;
        var file = copyBytes(PARQUET_MAGIC.bytes())!;
        file.extend(g.bytes.view())!;
        let group = match (borrow g.group) {
            ThriftValue.Struct(f) => f,
            _ => { return Err(TestFailure.create("a group")); }
        };
        let chunks = structItems(group, PQ_GROUP_COLUMNS) ?? { return Err(TestFailure.create("chunks")); };
        let chunk = match (borrow chunks[0]) {
            ThriftValue.Struct(f) => f,
            _ => { return Err(TestFailure.create("a chunk")); }
        };
        let back = readColumnChunk(file.view(), chunk, leaf)!;
        Check.isTrue(back.isSome() == (first == 0), "read only when it starts a row")?;
    }
    return Ok();
}
