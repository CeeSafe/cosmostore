// Parquet's page reader (ADR-0112 slice 3): each fixture pyarrow wrote read column by column, its levels and values
// those tools/parquet_page_fixtures.py shredded from the rows that made it.

/// A column read, as the fixtures' expected lines are written.
fn renderedColumn(leaf: borrow PageLeaf, v: borrow ColumnValues) -> String {
    var line = String.create();
    line.append(StringView.fromUtf8(leaf.path.view()) ?? "?")!;
    line.append("|")!;
    line.appendNumber(leaf.maxDef as i64)!;
    line.append("|")!;
    line.appendNumber(leaf.maxRep as i64)!;
    line.append("|")!;
    for (r in v.reps.view()) { line.appendNumber(r as i64)!; }
    line.append("|")!;
    for (d in v.defs.view()) { line.appendNumber(d as i64)!; }
    line.append("|")!;
    for (i in 0..v.count) {
        if (i > 0) { line.append(",")!; }
        let bytes = valueAt(v, leaf, i);
        if (leaf.physical == PQ_INT32) {
            line.appendNumber(truncate<i32>(bytes.readLE<u32>(0)) as i64)!;
        } else if (leaf.physical == PQ_INT64) {
            line.appendNumber(truncate<i64>(bytes.readLE<u64>(0)))!;
        } else if (leaf.physical == PQ_BOOLEAN) {
            line.appendNumber(bytes[0] as i64)!;
        } else {
            var hex = Vector<u8>.create();
            appendHexBytes(mut hex, bytes)!;
            line.append(StringView.fromUtf8(hex.view()) ?? "?")!;
        }
    }
    return line;
}

/// Every column of a fixture's first row group read, and as its expected lines say.
fn checkFixture(name: StringView, chunks: Slice<StringView>, expected: Slice<StringView>) -> Result<void, TestFailure> {
    let bytes = fixtureBytes(chunks);
    let n = parquetFooterLength(bytes.view()[bytes.length - 8..], bytes.length as u64) ?? {
        return Err(TestFailure.create("a footer"));
    };
    let start = bytes.length - 8 - n as usize;
    let footer = parseParquetFooter(bytes.view()[start..bytes.length - 8], bytes.length as u64)!!;
    let leaves = schemaLeaves(borrow footer.meta)! ?? { return Err(TestFailure.create("a schema read")); };
    Check.equalU64(expected.length as u64, leaves.length as u64)?;
    let groups = structItems(borrow footer.meta, PQ_FILE_ROW_GROUPS) ?? {
        return Err(TestFailure.create("row groups"));
    };
    let group = match (borrow groups[0]) {
        ThriftValue.Struct(f) => f,
        _ => { return Err(TestFailure.create("a row group")); }
    };
    let columns = structItems(group, PQ_GROUP_COLUMNS) ?? { return Err(TestFailure.create("columns")); };
    for (c in 0..columns.length) {
        let chunk = match (borrow columns[c]) {
            ThriftValue.Struct(f) => f,
            _ => { return Err(TestFailure.create("a column chunk")); }
        };
        let values = match (readColumnChunk(bytes.view(), chunk, borrow leaves[c])!) {
            Some(v) => v,
            null => {
                var why = textOf(name);
                why.append(": a column chunk not read: ")!;
                why.append(StringView.fromUtf8(leaves[c].path.view()) ?? "?")!;
                return Err(TestFailure.create(why.view()));
            }
        };
        let got = renderedColumn(borrow leaves[c], borrow values);
        Check.equalText(expected[c], got.view())?;
    }
    return Ok();
}

@test
fn pagesFlatV1Dictionary() -> Result<void, TestFailure> =>
    checkFixture("FLAT_V1_DICT", PAGES_FLAT_V1_DICT[..], PAGES_FLAT_V1_DICT_EXPECTED[..]);

