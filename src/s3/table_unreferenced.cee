// Unreferenced file removal (ADR-0086 §3): what a table's committed metadata references (its metadata files, every
// snapshot's manifest list, their manifests, the data and delete files those name, its statistics files), and the
// objects of its warehouse that nothing references, noted when first found and deleted once they stay so for
// `unreferencedDays + nonCurrentDays`. A run that cannot read a manifest ends Failed and deletes nothing.
import web_core;
import web_transport;
import web_http;
import web_server;

const MAINTENANCE_UNREFERENCED: StringView = ".s3tables/maintenance/unreferenced/";
/// A manifest list's or manifest's size at most, as read for a run.
const MANIFEST_MAX_BYTES: usize = 268435456;

fn unreferencedNotesKey(id: Slice<u8>) -> Result<Vector<u8>, AllocError> =>
    catalogKey(MAINTENANCE_UNREFERENCED, id, "".bytes());

/// Inserts `key` into sorted `keys`; false if it was there.
fn sortedInsert(keys: borrow mut Vector<Vector<u8>>, key: Slice<u8>) -> Result<bool, AllocError> {
    var low: usize = 0;
    var high = keys.length;
    while (low < high) {
        let mid = low + (high - low) / 2;
        let c = compareBytes(keys[mid].view(), key);
        if (c == 0) { return Ok(false); }
        if (c < 0) { low = mid + 1; } else { high = mid; }
    }
    keys.insert(low, copyBytes(key)?)?;
    return Ok(true);
}

/// What a run starts from, read under the store.
struct UnreferencedRun {
    hidden: Vector<u8>;
    id: Vector<u8>;
    metadata: Json;
    location: Vector<u8>;
    /// `unreferencedDays + nonCurrentDays`, in days.
    days: i64;
}

/// A run's start for a table, or null when its table bucket's removal is disabled or it has no metadata yet.
fn unreferencedRun(store: borrow ObjectStore, t: borrow MaintainedTable) -> Result<UnreferencedRun?, TablesError> {
    let hidden = tableWarehouseBucket(t.bucket.view())?;
    let rec = tableRecord(store, t.bucket.view(), t.ns.view(), t.name.view())?;
    let id = copyBytes(jsonMemberText(borrow rec.json, "id") ?? "".bytes())?;
    if (!uuidShaped(id.view())) { return Ok(null); }
    let document = maintenanceDocument(store, hidden.view(), MAINTENANCE_BUCKET_KEY.bytes())?;
    let value = maintenanceValue(borrow document, UNREFERENCED_REMOVAL)?;
    if (!maintenanceEnabled(borrow value)) { return Ok(null); }
    let location = copyBytes(jsonMemberText(borrow rec.json, "metadataLocation") ?? "".bytes())?;
    if (location.length == 0) { return Ok(null); }
    let metadata = readMetadata(store, hidden.view(), location.view())?;
    let days = (maintenanceSetting(borrow value, UNREFERENCED_REMOVAL, "unreferencedDays") ?? 3) +
        (maintenanceSetting(borrow value, UNREFERENCED_REMOVAL, "nonCurrentDays") ?? 10);
    return Ok(Some(UnreferencedRun { hidden: hidden, id: id, metadata: metadata, location: location, days: days }));
}

/// An object's bytes, read under the store; null if it is not there.
fn warehouseObject(store: borrow ObjectStore, hidden: Slice<u8>, key: Slice<u8>) -> Result<Vector<u8>?, TablesError> {
    return match (store.getObject(catalogText(hidden), catalogText(key))) {
        Ok(b) => if (b.length > MANIFEST_MAX_BYTES) Err(TablesError.Internal) else Ok(Some(b)),
        Err(StoreError.NoSuchKey) => Ok(null),
        Err(e) => Err(tablesStoreFail(e)),
    };
}

/// Adds the key a path names in the hidden bucket (`s3://<hidden>/<key>`); a path elsewhere names nothing here.
fn addReferenced(
    referenced: borrow mut Vector<Vector<u8>>,
    hidden: Slice<u8>,
    path: Slice<u8>,
) -> Result<bool, AllocError> {
    return match (metadataKey(path, hidden)) {
        Some(k) => sortedInsert(referenced, k),
        null => Ok(false),
    };
}

/// Every `<member>` path of the objects in an array member of `m` (statistics files, the metadata log).
fn addPathsOf(
    referenced: borrow mut Vector<Vector<u8>>,
    hidden: Slice<u8>,
    m: borrow Json,
    array: StringView,
    member: StringView,
) -> Result<void, AllocError> {
    let items = memberItems(m, array) ?? { return Ok(); };
    for (i in 0..items.length) {
        match (jsonMemberText(borrow items[i], member)) {
            Some(p) => { let _ = addReferenced(referenced, hidden, p)?; }
            null => {}
        }
    }
    return Ok();
}

/// What the metadata itself references (its file, the metadata log, statistics files, each snapshot's manifest
/// list), added to `referenced`; the manifest lists, to read.
fn metadataReferences(
    m: borrow Json,
    hidden: Slice<u8>,
    location: Slice<u8>,
    referenced: borrow mut Vector<Vector<u8>>,
) -> Result<Vector<Vector<u8>>, AllocError> {
    var lists = Vector<Vector<u8>>.create();
    let _ = addReferenced(referenced, hidden, location)?;
    addPathsOf(referenced, hidden, m, "metadata-log", "metadata-file")?;
    addPathsOf(referenced, hidden, m, "statistics", "statistics-path")?;
    addPathsOf(referenced, hidden, m, "partition-statistics", "statistics-path")?;
    let snaps = memberItems(m, "snapshots") ?? { return Ok(lists); };
    for (i in 0..snaps.length) {
        match (jsonMemberText(borrow snaps[i], "manifest-list")) {
            Some(p) => {
                if (addReferenced(referenced, hidden, p)?) { lists.push(copyBytes(p)?)?; }
            }
            null => {}
        }
    }
    return Ok(lists);
}

/// Why a run failed, for its job status.
fn avroCodecFailure(e: borrow AvroError) -> bool => match (e) {
    AvroError.Codec(_) => true,
    _ => false,
};

/// The files a manifest list or manifest names (`field`, or `data_file.file_path`), added to `referenced`, and
/// returned for a list (its manifests, to read next).
fn manifestPaths(
    bytes: Slice<u8>,
    hidden: Slice<u8>,
    referenced: borrow mut Vector<Vector<u8>>,
    isList: bool,
) -> Result<Vector<Vector<u8>>, AvroError> {
    let file = readAvro(bytes)?;
    var next = Vector<Vector<u8>>.create();
    for (i in 0..file.records.length) {
        let r = borrow file.records[i];
        let path = if (isList) jsonMemberText(r, "manifest_path") else match (jsonMember(r, "data_file")) {
            Some(d) => jsonMemberText(d, "file_path"),
            null => null,
        };
        match (path) {
            Some(p) => {
                if (addReferenced(referenced, hidden, p)? && isList) { next.push(copyBytes(p)?)?; }
            }
            null => { return Err(AvroError.Malformed); } // a record that names nothing: not a manifest read here
        }
    }
    return Ok(next);
}

/// The sweep, under the store: each object of the warehouse nothing references is noted, or deleted once its note
/// is `days` old; notes of files referenced again go. Then the job's status.
fn sweepUnreferenced(
    store: borrow mut ObjectStore,
    run: borrow UnreferencedRun,
    referenced: borrow Vector<Vector<u8>>,
    nowMs: i64,
    dayMs: i64,
) -> Result<void, TablesError> {
    var prefix = copyBytes(run.id.view())?;
    prefix.push('/')?;
    let objects = catalogKeys(store, run.hidden.view(), prefix.view(), "".bytes(), 0)?;
    let notesKey = unreferencedNotesKey(run.id.view())?;
    let notes = maintenanceDocument(store, run.hidden.view(), notesKey.view())?;
    var kept = Vector<JsonMember>.create();
    var doomed = Vector<Vector<u8>>.create();
    for (i in 0..objects.length) {
        let key = objects[i].view();
        if (!sortedHolds(referenced, key)) { continue; } // referenced (`sortedHolds` is true when absent)
        let first = jsonMemberI64(borrow notes, textOfRef(key)) ?? nowMs;
        if (nowMs - first >= run.days * dayMs) {
            doomed.push(copyBytes(key)?)?;
        } else {
            kept.push(JsonMember { key: copyBytes(key)?, value: jsonInteger(first)? })?;
        }
    }
    // Deleted only now: the committed metadata read for this run references none of them (ADR-0001's order).
    var at: usize = 0;
    while (at < doomed.length) {
        let end = if (doomed.length - at > 1000) at + 1000 else doomed.length;
        match (store.deleteObjects(catalogText(run.hidden.view()), doomed.view()[at..end])) {
            Ok(_) => {}
            Err(e) => { return Err(tablesStoreFail(e)); }
        }
        at = end;
    }
    if (kept.length == 0) {
        match (store.deleteObject(catalogText(run.hidden.view()), catalogText(notesKey.view()))) {
            Ok() => {}
            Err(StoreError.NoSuchKey) => {}
            Err(e) => { return Err(tablesStoreFail(e)); }
        }
    } else {
        let document = Json.Object(kept);
        let _ = writeRecord(store, run.hidden.view(), notesKey.view(), borrow document, PutCondition.None)?;
    }
    writeJobStatus(store, run.hidden.view(), run.id.view(), UNREFERENCED_REMOVAL, "Successful", "", nowMs)?;
    return Ok();
}

/// Unreferenced file removal for one table (ADR-0086 §3): the store held for each read and for the sweep, the
/// manifests decoded between.
async fn removeUnreferenced(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    t: borrow MaintainedTable,
    nowMs: i64,
    dayMs: i64,
) -> Result<void, NetError> {
    var started: UnreferencedRun? = null;
    {
        var guard = match (await store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NetError.Closed); }
        };
        let st = guard.data();
        started = match (await Async.blocking(() => unreferencedRun(st, t))) {
            Ok(r) => r,
            Err(_) => { return Ok(); } // the table went, or its metadata does not read: next pass
        };
    }
    let run = match (started) {
        Some(r) => r,
        null => { return Ok(); }
    };
    var referenced = Vector<Vector<u8>>.create();
    var failure: StringView = "";
    {
        let hidden = run.hidden.view();
        let m = borrow run.metadata;
        let lists = match (metadataReferences(m, hidden, run.location.view(), mut referenced)) {
            Ok(l) => l,
            Err(_) => { return Ok(); }
        };
        // Each manifest list, then each manifest it names: read under the store, decoded outside it.
        var queue = Vector<Vector<u8>>.create();
        for (i in 0..lists.length) {
            if (queue.push(copyBytes(lists[i].view()).ok() ?? Vector<u8>.create()).isErr()) { return Ok(); }
        }
        var listsLeft = lists.length;
        var at: usize = 0;
        while (at < queue.length && failure.length == 0) {
            let path = copyBytes(queue[at].view()).ok() ?? Vector<u8>.create();
            let isList = at < listsLeft;
            at += 1;
            let key = metadataKey(path.view(), hidden) ?? { continue; };
            var bytes: Vector<u8>? = null;
            {
                var guard = match (await store.get().lock()) {
                    Ok(g) => g,
                    Err(_) => { return Err(NetError.Closed); }
                };
                let st = guard.data();
                bytes = match (await Async.blocking(() => warehouseObject(st, hidden, key))) {
                    Ok(b) => b,
                    Err(_) => {
                        failure = "A manifest could not be read; nothing was deleted.";
                        null
                    }
                };
            }
            let b = match (bytes) {
                Some(b) => b,
                null => {
                    if (failure.length == 0) {
                        failure = "A manifest the metadata names is missing; nothing was deleted.";
                    }
                    continue;
                }
            };
            let bv = b.view();
            match (await Async.blocking(() => manifestPaths(bv, hidden, mut referenced, isList))) {
                Ok(next) => {
                    for (k in 0..next.length) {
                        if (queue.push(copyBytes(next[k].view()).ok() ?? Vector<u8>.create()).isErr()) { return Ok(); }
                    }
                }
                Err(e) => {
                    failure = if (avroCodecFailure(
                        borrow e,
                    )) "A manifest's codec is not one read here (null and deflate are); nothing was deleted."
                        else "A manifest could not be read; nothing was deleted.";
                }
            }
        }
        let _ = listsLeft;
    }
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NetError.Closed); }
    };
    let st = guard.data();
    if (failure.length > 0) {
        let hidden = run.hidden.view();
        let id = run.id.view();
        let message = failure;
        let _ = await Async.blocking(
            () => writeJobStatus(st, hidden, id, UNREFERENCED_REMOVAL, "Failed", message, nowMs),
        );
        return Ok();
    }
    let r = borrow run;
    let refs = borrow referenced;
    let _ = await Async.blocking(() => sweepUnreferenced(st, r, refs, nowMs, dayMs));
    return Ok();
}
