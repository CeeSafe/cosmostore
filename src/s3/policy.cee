// Bucket policies (ADR-0043): the document, checked when it is put and parsed again when it is used; the decision
// for a request; who a request is; and the policy calls.
import web_core;
import web_http;
import web_server;

/// A condition key a policy may test (ADR-0043 §3).
enum PolicyKey {
    SecureTransport,
    SourceIp,
    Referer,
    UserAgent,
    Prefix,
    Delimiter,
    MaxKeys,
    /// The request's encryption fields (ADR-0046): `s3:x-amz-server-side-encryption`, `...-aws-kms-key-id` and
    /// `...-customer-algorithm`, as the request gives them (a bucket's default is not the request's).
    SseAlgorithm,
    SseKmsKeyId,
    SseCustomerAlgorithm,
}

/// A condition operator, without its `Not`: `PolicyTest.negated` says whether it had one.
enum PolicyOp {
    StringEquals,
    StringEqualsIgnoreCase,
    StringLike,
    Bool,
    IpAddress,
    NumericEquals,
    NumericLessThan,
    NumericLessThanEquals,
    NumericGreaterThan,
    NumericGreaterThanEquals,
    Null,
}

/// An IPv4 or IPv6 range: the address (IPv4 in the first four bytes) and its prefix's bits.
struct IpRange {
    v6: bool;
    bytes: [u8; 16];
    bits: u32;
}

/// One operator on one key, with its values: any value may match.
struct PolicyTest {
    op: PolicyOp;
    /// A negated operator (`StringNotEquals`, `NotIpAddress`, `NumericNotEquals`...): it holds where the plain one
    /// fails, and when the request does not have the key.
    negated: bool;
    key: PolicyKey;
    /// String values (lower case for the `IgnoreCase` operators, `true` or `false` for `Bool` and `Null`).
    values: Vector<Vector<u8>>;
    ranges: Vector<IpRange>;
    numbers: Vector<u64>;
}

struct PolicyStatement {
    allow: bool;
    /// The access keys it names; `anyone` for `*`. With `notPrincipal` it is for every requester but those.
    keys: Vector<Vector<u8>>;
    /// The users it names (`arn:aws:iam::<account>:user/<name>`, ADR-0088 §3).
    users: Vector<Vector<u8>>;
    anyone: bool;
    notPrincipal: bool;
    /// Patterns with `*` and `?`: actions in lower case, matched without regard to case; resources after
    /// `arn:aws:s3:::`, matched as they are.
    actions: Vector<Vector<u8>>;
    notAction: bool;
    resources: Vector<Vector<u8>>;
    notResource: bool;
    tests: Vector<PolicyTest>;
}

/// A parsed bucket policy.
struct BucketPolicy {
    statements: Vector<PolicyStatement>;
    /// Some statement is a Deny: a key's requests to the bucket must read it (ADR-0043 §8).
    denies: bool;
}

fn malformedPolicy() -> S3Fail => S3Fail.Code(S3Code.MalformedPolicy);

fn cloneVectors(v: borrow Vector<Vector<u8>>) -> Result<Vector<Vector<u8>>, AllocError> {
    var out = Vector<Vector<u8>>.create();
    for (i in 0..v.length) { out.push(copyBytes(v[i].view())?)?; }
    return Ok(out);
}

/// A copy of a parsed policy, for a check that runs on a worker thread (ADR-0088 §2).
fn clonePolicy(p: borrow BucketPolicy) -> Result<BucketPolicy, AllocError> {
    var statements = Vector<PolicyStatement>.create();
    for (i in 0..p.statements.length) {
        let st = borrow p.statements[i];
        var tests = Vector<PolicyTest>.create();
        for (t in 0..st.tests.length) {
            let test = borrow st.tests[t];
            var ranges = Vector<IpRange>.create();
            for (r in 0..test.ranges.length) {
                let range = borrow test.ranges[r];
                ranges.push(IpRange { v6: range.v6, bytes: range.bytes, bits: range.bits })?;
            }
            var numbers = Vector<u64>.create();
            numbers.extend(test.numbers.view())?;
            tests.push(PolicyTest {
                op: test.op,
                negated: test.negated,
                key: test.key,
                values: cloneVectors(borrow test.values)?,
                ranges: ranges,
                numbers: numbers,
            })?;
        }
        statements.push(PolicyStatement {
            allow: st.allow,
            keys: cloneVectors(borrow st.keys)?,
            users: cloneVectors(borrow st.users)?,
            anyone: st.anyone,
            notPrincipal: st.notPrincipal,
            actions: cloneVectors(borrow st.actions)?,
            notAction: st.notAction,
            resources: cloneVectors(borrow st.resources)?,
            notResource: st.notResource,
            tests: tests,
        })?;
    }
    return Ok(BucketPolicy { statements: statements, denies: p.denies });
}

fn notImplemented() -> S3Fail => S3Fail.Code(S3Code.NotImplemented);

// ---- The document ----

/// A JSON string, or a non-empty array of them, appended to `out`.
fn policyStrings<region a>(r: borrow mut JsonReader<a>, out: borrow mut Vector<Vector<u8>>) -> Result<void, S3Fail> {
    var s = Vector<u8>.create();
    if (r.peek() != '[') {
        if (!r.string(mut s)?) { return Err(malformedPolicy()); }
        out.push(copyBytes(s.view())?)?;
        return Ok();
    }
    let _ = r.take('[');
    if (r.take(']')) { return Err(malformedPolicy()); }
    while (true) {
        if (!r.string(mut s)?) { return Err(malformedPolicy()); }
        out.push(copyBytes(s.view())?)?;
        if (r.take(',')) { continue; }
        if (r.take(']')) { return Ok(); }
        return Err(malformedPolicy());
    }
    return Ok();
}

/// A condition value: a JSON string, or a bare `true`, `false` or non-negative integer, as its text.
fn policyScalar<region a>(r: borrow mut JsonReader<a>, out: borrow mut Vector<u8>) -> Result<bool, AllocError> {
    out.clear();
    if (r.peek() == '"') { return r.string(out); }
    let start = r.at;
    while (r.at < r.text.length) {
        let c = r.text[r.at];
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9'))) { break; }
        r.at += 1;
    }
    if (r.at == start) { return Ok(false); }
    out.extend(r.text[start..r.at])?;
    let t = out.view();
    return Ok(t == "true".bytes() || t == "false".bytes() || parseDecimal(t).isSome());
}

/// A condition's values: one scalar, or a non-empty array of them.
fn policyScalars<region a>(r: borrow mut JsonReader<a>, out: borrow mut Vector<Vector<u8>>) -> Result<void, S3Fail> {
    var s = Vector<u8>.create();
    if (r.peek() != '[') {
        if (!policyScalar(r, mut s)?) { return Err(malformedPolicy()); }
        out.push(copyBytes(s.view())?)?;
        return Ok();
    }
    let _ = r.take('[');
    if (r.take(']')) { return Err(malformedPolicy()); }
    while (true) {
        if (!policyScalar(r, mut s)?) { return Err(malformedPolicy()); }
        out.push(copyBytes(s.view())?)?;
        if (r.take(',')) { continue; }
        if (r.take(']')) { return Ok(); }
        return Err(malformedPolicy());
    }
    return Ok();
}

/// Whether `key` is one of the configured access keys.
fn configuredKey(credentials: Slice<Credential>, key: Slice<u8>) -> bool {
    for (i in 0..credentials.length) {
        if (!credentials[i].revoked && credentials[i].accessKey.view() == key) { return true; }
    }
    return false;
}

const POLICY_USER_ARN: StringView = "arn:aws:iam:::user/";
/// The one account's id, in the ARNs of its users (ADR-0088 §3) and of STS's sessions.
const POLICY_ACCOUNT: StringView = "000000000000";

/// Whether the requester's key was revoked since its request was authenticated (a reload between the two): its
/// place has no user any more, so it is refused rather than read as the account's (the M11 exit review's B6).
fn revokedRequester(credentials: Slice<Credential>, who: borrow Requester) -> bool {
    let i = who.key ?? { return false; };
    return i >= credentials.length || credentials[i].revoked;
}

/// Whether a key of `credentials` belongs to the user `name`.
fn configuredUser(credentials: Slice<Credential>, name: Slice<u8>) -> bool {
    for (i in 0..credentials.length) {
        if (!credentials[i].revoked && credentials[i].user.view() == name) { return true; }
    }
    return false;
}
const POLICY_S3_ARN: StringView = "arn:aws:s3:::";

/// `Principal` or `NotPrincipal`: `"*"`, or `{"AWS": ...}` with `*` and user ARNs naming access keys (ADR-0043 §3).
fn parsePrincipal<region a>(
    r: borrow mut JsonReader<a>,
    st: borrow mut PolicyStatement,
    credentials: Slice<Credential>,
    checkKeys: bool,
) -> Result<void, S3Fail> {
    var text = Vector<u8>.create();
    if (r.peek() == '"') {
        if (!r.string(mut text)?) { return Err(malformedPolicy()); }
        if (text.view() != "*".bytes()) { return Err(malformedPolicy()); }
        st.anyone = true;
        return Ok();
    }
    if (!r.take('{') || r.take('}')) { return Err(malformedPolicy()); }
    var aws = false;
    while (true) {
        if (!r.string(mut text)?) { return Err(malformedPolicy()); }
        if (!r.take(':')) { return Err(malformedPolicy()); }
        let kind = text.view();
        if (kind == "CanonicalUser".bytes() || kind == "Service".bytes() || kind == "Federated".bytes()) {
            return Err(notImplemented());
        }
        if (kind != "AWS".bytes() || aws) { return Err(malformedPolicy()); }
        aws = true;
        var values = Vector<Vector<u8>>.create();
        policyStrings(r, mut values)?;
        let prefix = POLICY_USER_ARN.bytes();
        for (i in 0..values.length) {
            let v = values[i].view();
            if (v == "*".bytes()) {
                st.anyone = true;
                continue;
            }
            // A user of the account (ADR-0088 §3): `arn:aws:iam::000000000000:user/<name>`. Another account's is not
            // one, and a user the users file does not have is refused when the policy is put, as AWS refuses an
            // unknown principal (the M11 exit review's B2).
            let iam = "arn:aws:iam::".bytes();
            if (startsWithBytes(v, iam) && !startsWithBytes(v, prefix)) {
                let colon = pieceEnd(v, iam.length, ':');
                let tail = if (colon < v.length) v[colon + 1..] else "".bytes();
                let user = "user/".bytes();
                if (startsWithBytes(tail, user) && userNameOk(tail[user.length..])) {
                    // Checked when a policy is put: one stored before this rule still reads (it names no user here).
                    if (checkKeys && v[iam.length..colon] != POLICY_ACCOUNT.bytes()) { return Err(malformedPolicy()); }
                    if (v[iam.length..colon] != POLICY_ACCOUNT.bytes()) { continue; }
                    if (checkKeys && !configuredUser(credentials, tail[user.length..])) {
                        return Err(malformedPolicy());
                    }
                    st.users.push(copyBytes(tail[user.length..])?)?;
                    continue;
                }
            }
            if (!startsWithBytes(v, prefix) || v.length == prefix.length) {
                // Accounts, roles and the like are principals CosmoStore has not; anything else is not one.
                if (startsWithBytes(v, "arn:aws:iam:".bytes())) { return Err(notImplemented()); }
                return Err(malformedPolicy());
            }
            let key = v[prefix.length..];
            if (checkKeys && !configuredKey(credentials, key)) { return Err(malformedPolicy()); }
            st.keys.push(copyBytes(key)?)?;
        }
        if (r.take(',')) { continue; }
        if (r.take('}')) { return Ok(); }
        return Err(malformedPolicy());
    }
    return Ok();
}

/// An action pattern: `*`, or `s3:` and a name of letters with `*` and `?`; kept in lower case. A table bucket's or
/// table's policy (`tables`) takes `s3tables:` actions only (ADR-0084 §1).
fn actionPattern(text: Slice<u8>, tables: bool, identity: bool) -> Result<Vector<u8>, S3Fail> {
    var out = Vector<u8>.create();
    if (text == "*".bytes()) {
        out.push('*')?;
        return Ok(out);
    }
    // An identity policy (a role's, a user's: ADR-0088 §3) names the actions of every service it reaches.
    if (identity) {
        var service: usize = 0;
        for (prefix in ["s3:", "s3express:", "s3tables:", "sts:", "iam:"]) {
            let b = prefix.bytes();
            if (text.length > b.length && equalsIgnoreCase(text[0..b.length], b)) { service = b.length; }
        }
        if (service == 0) { return Err(malformedPolicy()); }
        for (c in text) { out.push(lowerAscii(c))?; }
        for (c in out.view()[service..]) {
            if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '*' || c == '?')) {
                return Err(malformedPolicy());
            }
        }
        return Ok(out);
    }
    let tablesService = "s3tables:".bytes();
    let isTables = text.length > tablesService.length && equalsIgnoreCase(text[0..tablesService.length], tablesService);
    if (tables != isTables) { return Err(malformedPolicy()); }
    // `s3:`, or `s3express:` for a directory bucket's CreateSession and ListAllMyDirectoryBuckets (ADR-0080 §3).
    let express = "s3express:".bytes();
    let service: usize = if (tables) tablesService.length else if (text.length > express.length && equalsIgnoreCase(
        text[0..express.length],
        express,
    )) express.length else 3;
    if (text.length <= service || !(service > 3 || equalsIgnoreCase(text[0..3], "s3:".bytes()))) {
        return Err(malformedPolicy());
    }
    for (c in text) {
        let lower = lowerAscii(c);
        out.push(lower)?;
    }
    for (c in out.view()[service..]) {
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '*' || c == '?')) {
            return Err(malformedPolicy());
        }
    }
    return Ok(out);
}

/// The text before a pattern's first wildcard.
fn literalPrefix(pattern: Slice<u8>) -> Slice<u8> {
    for (i in 0..pattern.length) {
        if (pattern[i] == '*' || pattern[i] == '?') { return pattern[0..i]; }
    }
    return pattern;
}

/// A resource ARN's bucket or objects part: after `arn:aws:s3:::`, or after a directory bucket's
/// `arn:aws:s3express:<region>:<account>:bucket/` (ADR-0080 §3); null for another ARN.
fn policyArnTail(text: Slice<u8>) -> Slice<u8>? {
    let arn = POLICY_S3_ARN.bytes();
    if (startsWithBytes(text, arn)) { return Some(text[arn.length..]); }
    let express = "arn:aws:s3express:".bytes();
    if (!startsWithBytes(text, express)) { return null; }
    let region = match (findBytes(text, ":".bytes(), express.length)) {
        Some(c) => c,
        null => { return null; }
    };
    let account = match (findBytes(text, ":".bytes(), region + 1)) {
        Some(c) => c,
        null => { return null; }
    };
    let kind = "bucket/".bytes();
    let rest = text[account + 1..];
    if (!startsWithBytes(rest, kind)) { return null; }
    return Some(rest[kind.length..]);
}

/// A resource of a table bucket's or table's policy (ADR-0084 §1): `arn:aws:s3tables:<region>:<account>:bucket/`
/// and this table bucket's name, or its tables' (`<name>/table/<id>`), with wildcards; kept after `bucket/`.
fn tablesResourcePattern(text: Slice<u8>, bucket: Slice<u8>) -> Result<Vector<u8>, S3Fail> {
    let head = "arn:aws:s3tables:".bytes();
    if (!startsWithBytes(text, head)) { return Err(malformedPolicy()); }
    if (findBytes(text, "${".bytes(), 0).isSome()) { return Err(notImplemented()); } // policy variables
    // The region and the account: any, as CosmoStore has one of each.
    var at = head.length;
    for (field in 0..2) {
        let colon = pieceEnd(text, at, ':');
        if (colon == text.length) { return Err(malformedPolicy()); }
        at = colon + 1;
    }
    let kind = "bucket/".bytes();
    let rest = text[at..];
    if (!startsWithBytes(rest, kind)) { return Err(malformedPolicy()); }
    let pattern = rest[kind.length..];
    var tables = copyBytes(bucket)?;
    tables.extend("/table/".bytes())?;
    let fixed = literalPrefix(pattern);
    let ours = pattern == bucket || startsWithBytes(fixed, tables.view()) ||
        (fixed.length < pattern.length && startsWithBytes(tables.view(), fixed));
    if (!ours) { return Err(malformedPolicy()); }
    return Ok(copyBytes(pattern)?);
}

/// A resource pattern of this bucket, after `arn:aws:s3:::`: the bucket, or objects in it (ADR-0043 §3). A pattern
/// that could name nothing in the bucket is MalformedPolicy, as S3 answers.
fn resourcePattern(text: Slice<u8>, bucket: Slice<u8>) -> Result<Vector<u8>, S3Fail> {
    let pattern = match (policyArnTail(text)) {
        Some(t) => t,
        null => { return Err(malformedPolicy()); }
    };
    if (findBytes(text, "${".bytes(), 0).isSome()) { return Err(notImplemented()); } // policy variables
    var objects = copyBytes(bucket)?;
    objects.push('/')?;
    let fixed = literalPrefix(pattern);
    let ofBucket = pattern == bucket || startsWithBytes(fixed, objects.view()) ||
        (fixed.length < pattern.length && startsWithBytes(objects.view(), fixed));
    if (!ofBucket) { return Err(malformedPolicy()); }
    return Ok(copyBytes(pattern)?);
}

/// A condition operator's name: the operator and whether it is negated; null for one CosmoStore does not evaluate.
fn policyOpOf(name: Slice<u8>) -> PolicyTest? {
    let ops = [
        "StringEquals",
        "StringNotEquals",
        "StringEqualsIgnoreCase",
        "StringNotEqualsIgnoreCase",
        "StringLike",
        "StringNotLike",
        "Bool",
        "IpAddress",
        "NotIpAddress",
        "NumericEquals",
        "NumericNotEquals",
        "NumericLessThan",
        "NumericLessThanEquals",
        "NumericGreaterThan",
        "NumericGreaterThanEquals",
        "Null",
    ];
    var found: usize? = null;
    for (i in 0..ops.length) {
        if (ops[i].bytes() == name) { found = Some(i); }
    }
    let i = match (found) {
        Some(i) => i,
        null => { return null; }
    };
    let op = match (i) {
        0 | 1 => PolicyOp.StringEquals,
        2 | 3 => PolicyOp.StringEqualsIgnoreCase,
        4 | 5 => PolicyOp.StringLike,
        6 => PolicyOp.Bool,
        7 | 8 => PolicyOp.IpAddress,
        9 | 10 => PolicyOp.NumericEquals,
        11 => PolicyOp.NumericLessThan,
        12 => PolicyOp.NumericLessThanEquals,
        13 => PolicyOp.NumericGreaterThan,
        14 => PolicyOp.NumericGreaterThanEquals,
        _ => PolicyOp.Null,
    };
    return PolicyTest {
        op: op,
        negated: i == 1 || i == 3 || i == 5 || i == 8 || i == 10,
        key: PolicyKey.Referer,
        values: Vector<Vector<u8>>.create(),
        ranges: Vector<IpRange>.create(),
        numbers: Vector<u64>.create(),
    };
}

/// A condition key's name, without regard to case; null for one CosmoStore does not have.
fn policyKeyOf(name: Slice<u8>) -> PolicyKey? {
    if (equalsIgnoreCase(name, "aws:SecureTransport".bytes())) { return PolicyKey.SecureTransport; }
    if (equalsIgnoreCase(name, "aws:SourceIp".bytes())) { return PolicyKey.SourceIp; }
    if (equalsIgnoreCase(name, "aws:Referer".bytes())) { return PolicyKey.Referer; }
    if (equalsIgnoreCase(name, "aws:UserAgent".bytes())) { return PolicyKey.UserAgent; }
    if (equalsIgnoreCase(name, "s3:prefix".bytes())) { return PolicyKey.Prefix; }
    if (equalsIgnoreCase(name, "s3:delimiter".bytes())) { return PolicyKey.Delimiter; }
    if (equalsIgnoreCase(name, "s3:max-keys".bytes())) { return PolicyKey.MaxKeys; }
    if (equalsIgnoreCase(name, "s3:x-amz-server-side-encryption".bytes())) { return PolicyKey.SseAlgorithm; }
    if (equalsIgnoreCase(name, "s3:x-amz-server-side-encryption-aws-kms-key-id".bytes())) {
        return PolicyKey.SseKmsKeyId;
    }
    if (equalsIgnoreCase(name, "s3:x-amz-server-side-encryption-customer-algorithm".bytes())) {
        return PolicyKey.SseCustomerAlgorithm;
    }
    return null;
}

/// Whether CosmoStore evaluates this operator on this key (ADR-0043 §3): IP operators on `aws:SourceIp`, `Bool` on
/// `aws:SecureTransport`, numeric operators on `s3:max-keys`, string operators on the text keys, `Null` on all.
fn opFitsKey(op: PolicyOp, key: PolicyKey) -> bool => match (op) {
    PolicyOp.Null => true,
    PolicyOp.IpAddress => match (key) {
        PolicyKey.SourceIp => true,
        _ => false,
    },
    PolicyOp.Bool => match (key) {
        PolicyKey.SecureTransport => true,
        _ => false,
    },
    PolicyOp.NumericEquals | PolicyOp.NumericLessThan | PolicyOp.NumericLessThanEquals | PolicyOp.NumericGreaterThan | PolicyOp.NumericGreaterThanEquals =>
        match (key) {
            PolicyKey.MaxKeys => true,
            _ => false,
        },
    _ => match (key) {
        PolicyKey.Referer | PolicyKey.UserAgent | PolicyKey.Prefix | PolicyKey.Delimiter => true,
        PolicyKey.SseAlgorithm | PolicyKey.SseKmsKeyId | PolicyKey.SseCustomerAlgorithm => true,
        _ => false,
    },
};

/// `Condition`: operators, each with keys and their values (ADR-0043 §3).
fn parseCondition<region a>(r: borrow mut JsonReader<a>, tests: borrow mut Vector<PolicyTest>) -> Result<void, S3Fail> {
    if (!r.take('{')) { return Err(malformedPolicy()); }
    if (r.take('}')) { return Ok(); }
    var name = Vector<u8>.create();
    while (true) {
        if (!r.string(mut name)?) { return Err(malformedPolicy()); }
        if (!r.take(':')) { return Err(malformedPolicy()); }
        // `...IfExists`, `ForAllValues:`, `ForAnyValue:` and the operators of other types (dates, ARNs, binary)
        // are valid in S3 and not evaluated here: refused, never ignored.
        let template = match (policyOpOf(name.view())) {
            Some(t) => t,
            null => { return Err(notImplemented()); }
        };
        if (!r.take('{') || r.take('}')) { return Err(malformedPolicy()); }
        while (true) {
            if (!r.string(mut name)?) { return Err(malformedPolicy()); }
            if (!r.take(':')) { return Err(malformedPolicy()); }
            let key = match (policyKeyOf(name.view())) {
                Some(k) => k,
                null => { return Err(notImplemented()); }
            };
            if (!opFitsKey(template.op, key)) { return Err(notImplemented()); }
            var raw = Vector<Vector<u8>>.create();
            policyScalars(r, mut raw)?;
            var test = PolicyTest {
                op: template.op,
                negated: template.negated,
                key: key,
                values: Vector<Vector<u8>>.create(),
                ranges: Vector<IpRange>.create(),
                numbers: Vector<u64>.create(),
            };
            for (i in 0..raw.length) {
                let v = raw[i].view();
                match (test.op) {
                    PolicyOp.IpAddress => {
                        match (parseIpRange(v)) {
                            Some(range) => { test.ranges.push(range)?; }
                            null => { return Err(malformedPolicy()); }
                        }
                    }
                    PolicyOp.Bool | PolicyOp.Null => {
                        var lower = Vector<u8>.create();
                        for (c in v) { lower.push(lowerAscii(c))?; }
                        if (lower.view() != "true".bytes() && lower.view() != "false".bytes()) {
                            return Err(malformedPolicy());
                        }
                        test.values.push(lower)?;
                    }
                    PolicyOp.StringEquals | PolicyOp.StringEqualsIgnoreCase | PolicyOp.StringLike => {
                        if (findBytes(v, "${".bytes(), 0).isSome()) { return Err(notImplemented()); }
                        var kept = Vector<u8>.create();
                        let ignoreCase = match (test.op) {
                            PolicyOp.StringEqualsIgnoreCase => true,
                            _ => false,
                        };
                        for (c in v) { kept.push(if (ignoreCase) lowerAscii(c) else c)?; }
                        test.values.push(kept)?;
                    }
                    _ => {
                        match (parseDecimal(v)) {
                            Some(n) => { test.numbers.push(n)?; }
                            null => { return Err(malformedPolicy()); }
                        }
                    }
                }
            }
            tests.push(test)?;
            if (r.take(',')) { continue; }
            if (r.take('}')) { break; }
            return Err(malformedPolicy());
        }
        if (r.take(',')) { continue; }
        if (r.take('}')) { return Ok(); }
        return Err(malformedPolicy());
    }
    return Ok();
}

/// One statement (ADR-0043 §3): an Effect, a principal, actions and resources (each or its `Not`), and conditions.
fn parseStatement<region a>(
    r: borrow mut JsonReader<a>,
    bucket: Slice<u8>,
    credentials: Slice<Credential>,
    checkKeys: bool,
    identity: bool,
    accessPoint: Slice<u8>,
    tables: bool,
) -> Result<PolicyStatement, S3Fail> {
    var st = PolicyStatement {
        allow: false,
        keys: Vector<Vector<u8>>.create(),
        users: Vector<Vector<u8>>.create(),
        anyone: false,
        notPrincipal: false,
        actions: Vector<Vector<u8>>.create(),
        notAction: false,
        resources: Vector<Vector<u8>>.create(),
        notResource: false,
        tests: Vector<PolicyTest>.create(),
    };
    if (!r.take('{') || r.take('}')) { return Err(malformedPolicy()); }
    let fields = [
        "Sid",
        "Effect",
        "Principal",
        "NotPrincipal",
        "Action",
        "NotAction",
        "Resource",
        "NotResource",
        "Condition",
    ];
    var seen: u32 = 0;
    var name = Vector<u8>.create();
    var text = Vector<u8>.create();
    while (true) {
        if (!r.string(mut name)?) { return Err(malformedPolicy()); }
        if (!r.take(':')) { return Err(malformedPolicy()); }
        var field: u32 = 99;
        for (i in 0..fields.length) {
            if (fields[i].bytes() == name.view()) { field = truncate<u32>(i); }
        }
        if (field == 99 || (seen & (1u32 << field)) != 0) { return Err(malformedPolicy()); }
        seen |= 1u32 << field;
        if (field == 0) {
            if (!r.string(mut text)?) { return Err(malformedPolicy()); }
        } else if (field == 1) {
            if (!r.string(mut text)?) { return Err(malformedPolicy()); }
            if (text.view() == "Allow".bytes()) {
                st.allow = true;
            } else if (text.view() != "Deny".bytes()) {
                return Err(malformedPolicy());
            }
        } else if (field == 2 || field == 3) {
            // An identity policy (a role's, a session's: ADR-0075) is its holder's: it names no principal.
            if (identity) { return Err(malformedPolicy()); }
            // `Allow` with `NotPrincipal` grants to everyone else, anonymous requests too: S3 refuses it.
            if (field == 3 && st.allow) { return Err(malformedPolicy()); }
            st.notPrincipal = field == 3;
            parsePrincipal(r, mut st, credentials, checkKeys)?;
        } else if (field == 4 || field == 5) {
            st.notAction = field == 5;
            var raw = Vector<Vector<u8>>.create();
            policyStrings(r, mut raw)?;
            for (i in 0..raw.length) { st.actions.push(actionPattern(raw[i].view(), tables, identity)?)?; }
        } else if (field == 6 || field == 7) {
            st.notResource = field == 7;
            var raw = Vector<Vector<u8>>.create();
            policyStrings(r, mut raw)?;
            for (i in 0..raw.length) {
                let pattern = if (tables) tablesResourcePattern(
                    raw[i].view(),
                    bucket,
                )? else if (identity) identityResourcePattern(
                    raw[i].view(),
                )? else if (accessPoint.length > 0) accessPointResourcePattern(
                    raw[i].view(),
                    accessPoint,
                    bucket,
                )? else resourcePattern(raw[i].view(), bucket)?;
                st.resources.push(pattern)?;
            }
        } else {
            parseCondition(r, mut st.tests)?;
        }
        if (r.take(',')) { continue; }
        if (r.take('}')) { break; }
        return Err(malformedPolicy());
    }
    // An Effect, and exactly one of each pair: a bucket policy names its principals; an identity policy's are
    // whoever holds it.
    let pairs = [12u32, 48u32, 192u32];
    if ((seen & 2) == 0 || (st.allow && st.notPrincipal)) { return Err(malformedPolicy()); }
    for (p in pairs) {
        if (identity && p == 12) {
            st.anyone = true;
            continue;
        }
        if ((seen & p) == 0 || (seen & p) == p) { return Err(malformedPolicy()); }
    }
    return Ok(st);
}

/// A bucket policy's JSON (ADR-0043 §3). With `checkKeys`, as when it is put, a user ARN must name a configured key;
/// without, as when a stored policy is used, one that does not just matches nothing.
fn parseBucketPolicy(
    json: Slice<u8>,
    bucket: Slice<u8>,
    credentials: Slice<Credential>,
    checkKeys: bool,
) -> Result<BucketPolicy, S3Fail> => parsePolicyDocument(
    json,
    bucket,
    credentials,
    checkKeys,
    false,
    "".bytes(),
    false,
);

/// A table bucket's or a table's policy (ADR-0084 §1): a bucket policy's grammar, its actions `s3tables:`, its
/// resources table bucket `bucket`'s ARN and its tables', kept after `bucket/` (`<name>`, `<name>/table/<id>`).
fn parseTablesPolicy(
    json: Slice<u8>,
    bucket: Slice<u8>,
    credentials: Slice<Credential>,
    checkKeys: bool,
) -> Result<BucketPolicy, S3Fail> => parsePolicyDocument(json, bucket, credentials, checkKeys, false, "".bytes(), true);

/// An identity policy's JSON (ADR-0075 §2): a role's, or a session's; no `Principal`, resources in any bucket.
fn parseIdentityPolicy(json: Slice<u8>) -> Result<BucketPolicy, S3Fail> {
    let none = Vector<Credential>.create();
    return parsePolicyDocument(json, "".bytes(), none.view(), false, true, "".bytes(), false);
}

/// An access point's policy (ADR-0076 §3): a bucket policy's grammar, its resources the access point's ARN
/// (`arn:aws:s3:<region>:<account>:accesspoint/<name>`) and its objects' (`…/object/<key pattern>`), read as the
/// bucket's and its objects'.
fn parseAccessPointPolicy(
    json: Slice<u8>,
    name: Slice<u8>,
    bucket: Slice<u8>,
    credentials: Slice<Credential>,
    checkKeys: bool,
) -> Result<BucketPolicy, S3Fail> => parsePolicyDocument(json, bucket, credentials, checkKeys, false, name, false);

/// An access point policy's resource as a bucket policy's: `<bucket>` or `<bucket>/<key pattern>`. A directory
/// bucket's access point is named by an `arn:aws:s3express:` ARN (ADR-0082 §2).
fn accessPointResourcePattern(text: Slice<u8>, name: Slice<u8>, bucket: Slice<u8>) -> Result<Vector<u8>, S3Fail> {
    let express = "arn:aws:s3express:".bytes();
    let arn = if (startsWithBytes(text, express)) express else "arn:aws:s3:".bytes();
    if (!startsWithBytes(text, arn)) { return Err(malformedPolicy()); }
    // The region and the account: any, as CosmoStore has one of each.
    var at = arn.length;
    for (field in 0..2) {
        let colon = pieceEnd(text, at, ':');
        if (colon == text.length) { return Err(malformedPolicy()); }
        at = colon + 1;
    }
    let rest = text[at..];
    var ours = copyBytes("accesspoint/".bytes())?;
    ours.extend(name)?;
    if (!startsWithBytes(rest, ours.view())) { return Err(malformedPolicy()); }
    let tail = rest[ours.length..];
    var out = copyBytes(bucket)?;
    if (tail.length == 0) { return Ok(out); }
    let objects = "/object/".bytes();
    if (!startsWithBytes(tail, objects)) { return Err(malformedPolicy()); }
    out.push('/')?;
    out.extend(tail[objects.length..])?;
    return Ok(out);
}

/// A resource of an identity policy: `*`, or `arn:aws:s3:::` and a bucket or objects pattern, kept after the prefix.
/// A resource of an identity policy (ADR-0088 §3): `*`, or an ARN kept as `<service>:<tail>`, any region and account:
/// - `arn:aws:s3:::<bucket>[/<key>]` and `arn:aws:s3express:<r>:<a>:bucket/<name>[/<key>]`: `s3:<bucket>[/<key>]`, one
///   namespace, as bucket names are;
/// - `arn:aws:s3tables:<r>:<a>:bucket/<name>[/table/<id>]`: `s3tables:<name>[/table/<id>]`;
/// - `arn:aws:iam::<a>:role/<name>` and `…:user/<name>`: `iam:role/<name>`, `iam:user/<name>`.
fn identityResourcePattern(text: Slice<u8>) -> Result<Vector<u8>, S3Fail> {
    if (text == "*".bytes()) { return Ok(copyBytes(text)?); }
    if (findBytes(text, "${".bytes(), 0).isSome()) { return Err(notImplemented()); } // policy variables
    var out = Vector<u8>.create();
    // An access point: `arn:aws:s3:<region>:<account>:accesspoint/<name>`, kept as `s3ap:<name>`.
    let s3 = "arn:aws:s3:".bytes();
    if (startsWithBytes(text, s3) && !startsWithBytes(text, POLICY_S3_ARN.bytes())) {
        var at = s3.length;
        for (field in 0..2) {
            let colon = pieceEnd(text, at, ':');
            if (colon == text.length) { return Err(malformedPolicy()); }
            at = colon + 1;
        }
        let kind = "accesspoint/".bytes();
        let rest = text[at..];
        if (!startsWithBytes(rest, kind) || rest.length == kind.length) { return Err(malformedPolicy()); }
        out.extend("s3ap:".bytes())?;
        out.extend(rest[kind.length..])?;
        return Ok(out);
    }
    // A general purpose bucket's, `s3:`; a directory bucket's (`arn:aws:s3express:…:bucket/…`), `s3express:`, which
    // matches only directory buckets (the M11 exit review's A5).
    if (startsWithBytes(text, POLICY_S3_ARN.bytes())) {
        let tail = text[POLICY_S3_ARN.length..];
        if (tail.length == 0) { return Err(malformedPolicy()); }
        out.extend("s3:".bytes())?;
        out.extend(tail)?;
        return Ok(out);
    }
    // A directory bucket's access point: `arn:aws:s3express:<region>:<account>:accesspoint/<name>`, kept as
    // `s3expressap:<name>`.
    let expressHead = "arn:aws:s3express:".bytes();
    if (startsWithBytes(text, expressHead)) {
        var at = expressHead.length;
        for (field in 0..2) {
            let colon = pieceEnd(text, at, ':');
            if (colon == text.length) { return Err(malformedPolicy()); }
            at = colon + 1;
        }
        let kind = "accesspoint/".bytes();
        let rest = text[at..];
        if (startsWithBytes(rest, kind)) {
            if (rest.length == kind.length) { return Err(malformedPolicy()); }
            out.extend("s3expressap:".bytes())?;
            out.extend(rest[kind.length..])?;
            return Ok(out);
        }
    }
    match (policyArnTail(text)) {
        Some(tail) => {
            if (tail.length == 0) { return Err(malformedPolicy()); }
            out.extend("s3express:".bytes())?;
            out.extend(tail)?;
            return Ok(out);
        }
        null => {}
    }
    for (service in ["s3tables", "iam"]) {
        var head = copyBytes("arn:aws:".bytes())?;
        head.extend(service.bytes())?;
        head.push(':')?;
        if (!startsWithBytes(text, head.view())) { continue; }
        // The region and the account: any, as CosmoStore has one of each.
        var at = head.length;
        for (field in 0..2) {
            let colon = pieceEnd(text, at, ':');
            if (colon == text.length) { return Err(malformedPolicy()); }
            at = colon + 1;
        }
        let rest = text[at..];
        // IAM's: a role's or, for the IAM API's calls (ADR-0104 §2), a user's.
        let kind = if (service == "iam" && startsWithBytes(rest, "user/".bytes())) "user/".bytes() else if (service ==
            "iam") "role/".bytes() else "bucket/".bytes();
        if (!startsWithBytes(rest, kind) || rest.length == kind.length) { return Err(malformedPolicy()); }
        out.extend(service.bytes())?;
        out.push(':')?;
        out.extend(if (service == "iam") rest else rest[kind.length..])?;
        return Ok(out);
    }
    return Err(malformedPolicy());
}

/// A stored resource policy is its document as written, then, when it names users, a NUL (which JSON cannot hold)
/// and a `<name> <id>` line for each, the ids those users had when it was put (the owner's choice after M11's exit
/// review: a user principal is the user it named, not whoever has the name later). The document as written.
fn storedPolicyText(stored: Slice<u8>) -> Slice<u8> => stored[0..pieceEnd(stored, 0, 0)];

/// A document, as it is stored: with the ids of the users its statements name, as `credentials` have them now.
fn withUserIds(
    json: Slice<u8>,
    policy: borrow BucketPolicy,
    credentials: Slice<Credential>,
) -> Result<Vector<u8>, AllocError> {
    var out = copyBytes(json)?;
    var lines = Vector<u8>.create();
    for (s in 0..policy.statements.length) {
        for (u in 0..policy.statements[s].users.length) {
            let name = policy.statements[s].users[u].view();
            for (i in 0..credentials.length) {
                if (credentials[i].revoked || credentials[i].user.view() != name) { continue; }
                let key = credentials[i].userKey.view();
                if (findLine(lines.view(), key)) { break; }
                lines.extend(key)?;
                lines.push('\n')?;
                break;
            }
        }
    }
    if (lines.length > 0) {
        out.push(0)?;
        out.extend(lines.view())?;
    }
    return Ok(out);
}

/// Whether `lines` (each ended by `\n`) holds `line`.
fn findLine(lines: Slice<u8>, line: Slice<u8>) -> bool {
    var at: usize = 0;
    while (at < lines.length) {
        let end = pieceEnd(lines, at, '\n');
        if (lines[at..end] == line) { return true; }
        at = end + 1;
    }
    return false;
}

fn parsePolicyDocument(
    stored: Slice<u8>,
    bucket: Slice<u8>,
    credentials: Slice<Credential>,
    checkKeys: bool,
    identity: bool,
    accessPoint: Slice<u8>,
    tables: bool,
) -> Result<BucketPolicy, S3Fail> {
    let json = storedPolicyText(stored);
    var policy = parsePolicyText(json, bucket, credentials, checkKeys, identity, accessPoint, tables)?;
    // Each user principal becomes `<name> <id>`, by the ids stored with it; one with none (a policy being put, or one
    // put before ids) stays a bare name, which no requester's `<name> <id>` matches.
    let ids = if (json.length < stored.length) stored[json.length + 1..] else "".bytes();
    for (s in 0..policy.statements.length) {
        for (u in 0..policy.statements[s].users.length) {
            var at: usize = 0;
            while (at < ids.length) {
                let end = pieceEnd(ids, at, '\n');
                let line = ids[at..end];
                let space = pieceEnd(line, 0, ' ');
                if (line[0..space] == policy.statements[s].users[u].view()) {
                    policy.statements[s].users[u].clear();
                    policy.statements[s].users[u].extend(line)?;
                    break;
                }
                at = end + 1;
            }
        }
    }
    return Ok(policy);
}

fn parsePolicyText(
    json: Slice<u8>,
    bucket: Slice<u8>,
    credentials: Slice<Credential>,
    checkKeys: bool,
    identity: bool,
    accessPoint: Slice<u8>,
    tables: bool,
) -> Result<BucketPolicy, S3Fail> {
    var policy = BucketPolicy { statements: Vector<PolicyStatement>.create(), denies: false };
    if (json.length == 0 || json.length > MAX_POLICY_BYTES) { return Err(malformedPolicy()); }
    var r = JsonReader { text: json, at: 0 };
    if (!r.take('{') || r.take('}')) { return Err(malformedPolicy()); }
    var seen: u32 = 0;
    var name = Vector<u8>.create();
    var text = Vector<u8>.create();
    while (true) {
        if (!r.string(mut name)?) { return Err(malformedPolicy()); }
        if (!r.take(':')) { return Err(malformedPolicy()); }
        let field: u32 =
            if (name.view() == "Version".bytes()) 1
                else if (name.view() == "Id".bytes()) 2
                else if (name.view() == "Statement".bytes()) 4
                else 0;
        if (field == 0 || (seen & field) != 0) { return Err(malformedPolicy()); }
        seen |= field;
        if (field == 1) {
            if (!r.string(mut text)?) { return Err(malformedPolicy()); }
            if (text.view() != "2012-10-17".bytes() && text.view() != "2008-10-17".bytes()) {
                return Err(malformedPolicy());
            }
        } else if (field == 2) {
            if (!r.string(mut text)?) { return Err(malformedPolicy()); }
        } else if (r.peek() == '[') {
            let _ = r.take('[');
            if (r.take(']')) { return Err(malformedPolicy()); }
            while (true) {
                policy.statements.push(
                    parseStatement(mut r, bucket, credentials, checkKeys, identity, accessPoint, tables)?,
                )?;
                if (r.take(',')) { continue; }
                if (r.take(']')) { break; }
                return Err(malformedPolicy());
            }
        } else {
            policy.statements.push(
                parseStatement(mut r, bucket, credentials, checkKeys, identity, accessPoint, tables)?,
            )?;
        }
        if (r.take(',')) { continue; }
        if (r.take('}')) { break; }
        return Err(malformedPolicy());
    }
    r.skipSpace();
    if (r.at != json.length || (seen & 4) == 0) { return Err(malformedPolicy()); }
    for (i in 0..policy.statements.length) {
        if (!policy.statements[i].allow) { policy.denies = true; }
    }
    return Ok(policy);
}

// ---- Addresses ----

/// A decimal octet, 0 to 255.
fn octetOf(text: Slice<u8>) -> u8? {
    if (text.length == 0 || text.length > 3) { return null; }
    return match (parseDecimal(text)) {
        Some(v) => if (v <= 255) Some(truncate<u8>(v)) else null,
        null => null,
    };
}

/// `a.b.c.d` into `out[0..4]`.
fn parseIpv4(text: Slice<u8>, out: borrow mut [u8; 16], at: usize) -> bool {
    var start: usize = 0;
    for (i in 0..4) {
        let end = pieceEnd(text, start, '.');
        if (i < 3 && end == text.length) { return false; }
        match (octetOf(text[start..end])) {
            Some(v) => { out[at + i] = v; }
            null => { return false; }
        }
        start = end + 1;
    }
    return start == text.length + 1;
}

/// An IPv6 address: hex groups with at most one `::`, and an IPv4 address as its last 32 bits if it ends with one.
fn parseIpv6(text: Slice<u8>, out: borrow mut [u8; 16]) -> bool {
    var head = Vector<u16>.create();
    var tail = Vector<u16>.create();
    var gap = false;
    var v4 = false;
    var at: usize = 0;
    if (startsWithBytes(text, "::".bytes())) {
        gap = true;
        at = 2;
    }
    while (at < text.length) {
        let end = pieceEnd(text, at, ':');
        let group = text[at..end];
        if (group.length == 0) {
            // `::` in the middle or at the end: one gap only.
            if (gap || end != at) { return false; }
            gap = true;
            at = end + 1;
            continue;
        }
        if (end == text.length && findBytes(group, ".".bytes(), 0).isSome()) {
            var four = [0u8; 16];
            if (!parseIpv4(group, mut four, 0)) { return false; }
            let hi = ((four[0] as u16) << 8) | four[1] as u16;
            let lo = ((four[2] as u16) << 8) | four[3] as u16;
            let into = if (gap) borrow mut tail else borrow mut head;
            if (into.push(hi).isErr() || into.push(lo).isErr()) { return false; }
            v4 = true;
            at = end + 1;
            break;
        }
        if (group.length > 4) { return false; }
        var v: u16 = 0;
        for (c in group) {
            match (hexValue(c)) {
                Some(d) => { v = (v << 4) | d as u16; }
                null => { return false; }
            }
        }
        let into = if (gap) borrow mut tail else borrow mut head;
        if (into.push(v).isErr()) { return false; }
        // A `::` right after this group starts the gap.
        if (end + 1 < text.length && text[end + 1] == ':') {
            if (gap) { return false; }
            gap = true;
            at = end + 2;
            continue;
        }
        at = end + 1;
    }
    if (at < text.length && !v4) { return false; }
    let total = head.length + tail.length;
    if ((gap && total > 7) || (!gap && total != 8)) { return false; }
    for (i in 0..16) { out[i] = 0; }
    for (i in 0..head.length) {
        out[i * 2] = truncate<u8>(head[i] >> 8);
        out[i * 2 + 1] = truncate<u8>(head[i]);
    }
    let from = 8 - tail.length;
    for (i in 0..tail.length) {
        out[(from + i) * 2] = truncate<u8>(tail[i] >> 8);
        out[(from + i) * 2 + 1] = truncate<u8>(tail[i]);
    }
    return true;
}

/// An address or CIDR range, IPv4 or IPv6.
fn parseIpRange(text: Slice<u8>) -> IpRange? {
    let slash = pieceEnd(text, 0, '/');
    let address = text[0..slash];
    var range = IpRange { v6: false, bytes: [0u8; 16], bits: 0 };
    if (findBytes(address, ":".bytes(), 0).isSome()) {
        range.v6 = true;
        if (!parseIpv6(address, mut range.bytes)) { return null; }
    } else if (!parseIpv4(address, mut range.bytes, 0)) {
        return null;
    }
    let most: u64 = if (range.v6) 128 else 32;
    range.bits = truncate<u32>(most);
    if (slash < text.length) {
        let bits = text[slash + 1..];
        if (bits.length == 0 || bits.length > 3) { return null; }
        match (parseDecimal(bits)) {
            Some(b) => {
                if (b > most) { return null; }
                range.bits = truncate<u32>(b);
            }
            null => { return null; }
        }
    }
    return range;
}

/// Whether the first `bits` bits of `a` and `b` are the same.
fn samePrefix(a: Slice<u8>, b: Slice<u8>, bits: u32) -> bool {
    var left = bits;
    var i: usize = 0;
    while (left >= 8) {
        if (a[i] != b[i]) { return false; }
        i += 1;
        left -= 8;
    }
    if (left == 0) { return true; }
    let mask = truncate<u8>(0xFF00u32 >> left);
    return (a[i] & mask) == (b[i] & mask);
}

/// Whether the range holds the peer. An IPv4 client seen as an IPv4-mapped IPv6 address (`::ffff:a.b.c.d`) is that
/// IPv4 address, and an IPv4 client is its mapped address to an IPv6 range.
fn rangeHolds(range: borrow IpRange, peer: SocketAddress) -> bool {
    var mapped = [0u8; 16];
    mapped[10] = 0xFF;
    mapped[11] = 0xFF;
    match (peer) {
        SocketAddress.V4(a, _) => {
            if (!range.v6) { return samePrefix(range.bytes[0..4], a[..], range.bits); }
            for (i in 0..4) { mapped[12 + i] = a[i]; }
            return samePrefix(range.bytes[..], mapped[..], range.bits);
        }
        SocketAddress.V6(a, _, _) => {
            if (range.v6) { return samePrefix(range.bytes[..], a[..], range.bits); }
            if (a[0..12] != mapped[0..12]) { return false; }
            return samePrefix(range.bytes[0..4], a[12..16], range.bits);
        }
    }
}

// ---- The decision ----

/// `*` and `?` wildcards; without regard to ASCII case when `ignoreCase`.
fn wildMatch(pattern: Slice<u8>, text: Slice<u8>, ignoreCase: bool) -> bool {
    var p: usize = 0;
    var t: usize = 0;
    var star: usize? = null;
    var mark: usize = 0;
    while (t < text.length) {
        if (p < pattern.length && pattern[p] == '*') {
            star = Some(p);
            mark = t;
            p += 1;
            continue;
        }
        if (p < pattern.length) {
            let a = if (ignoreCase) lowerAscii(pattern[p]) else pattern[p];
            let b = if (ignoreCase) lowerAscii(text[t]) else text[t];
            if (pattern[p] == '?' || a == b) {
                p += 1;
                t += 1;
                continue;
            }
        }
        match (star) {
            Some(s) => {
                p = s + 1;
                mark += 1;
                t = mark;
            }
            null => { return false; }
        }
    }
    while (p < pattern.length && pattern[p] == '*') { p += 1; }
    return p == pattern.length;
}

/// What a request brings to a policy's conditions (ADR-0043 §6); null for a key it does not have.
struct PolicyFacts {
    secure: bool;
    peer: SocketAddress?;
    referer: Vector<u8>?;
    userAgent: Vector<u8>?;
    prefix: Vector<u8>?;
    delimiter: Vector<u8>?;
    maxKeys: Vector<u8>?;
    sseAlgorithm: Vector<u8>?;
    sseKmsKeyId: Vector<u8>?;
    sseCustomerAlgorithm: Vector<u8>?;
    /// A write the server makes for a configuration (ADR-0094 §2): it has no client, so a condition on a client's
    /// facts holds for it in no way, and its statement neither allows nor denies (the M14 exit review's B1).
    noClient: bool;
}

fn ownedOf(v: Slice<u8>?) -> Result<Vector<u8>?, AllocError> => match (v) {
    Some(b) => Ok(Some(copyBytes(b)?)),
    null => Ok(null),
};

/// The facts of `req`; the listing keys only for a listing's action.
fn policyFacts(
    req: borrow S3Request,
    listing: bool,
    secure: bool,
    peer: SocketAddress?,
) -> Result<PolicyFacts, AllocError> {
    var facts = PolicyFacts {
        secure: secure,
        peer: peer,
        referer: ownedOf(headerOf(req, "referer"))?,
        userAgent: ownedOf(headerOf(req, "user-agent"))?,
        prefix: null,
        delimiter: null,
        maxKeys: null,
        sseAlgorithm: ownedOf(headerOf(req, "x-amz-server-side-encryption"))?,
        sseKmsKeyId: ownedOf(headerOf(req, "x-amz-server-side-encryption-aws-kms-key-id"))?,
        sseCustomerAlgorithm: ownedOf(headerOf(req, "x-amz-server-side-encryption-customer-algorithm"))?,
        noClient: false,
    };
    if (listing) {
        facts.prefix = copyBytes(paramOf(req, "prefix") ?? "".bytes())?;
        facts.delimiter = ownedOf(paramOf(req, "delimiter"))?;
        facts.maxKeys = ownedOf(paramOf(req, "max-keys"))?;
    }
    return Ok(facts);
}

/// The text of a string key, when the request has it.
fn factText(facts: borrow PolicyFacts, key: PolicyKey) -> Slice<u8>? => match (key) {
    PolicyKey.Referer => match (facts.referer.asBorrow()) {
        Some(v) => Some(v.view()),
        null => null,
    },
    PolicyKey.UserAgent => match (facts.userAgent.asBorrow()) {
        Some(v) => Some(v.view()),
        null => null,
    },
    PolicyKey.Prefix => match (facts.prefix.asBorrow()) {
        Some(v) => Some(v.view()),
        null => null,
    },
    PolicyKey.Delimiter => match (facts.delimiter.asBorrow()) {
        Some(v) => Some(v.view()),
        null => null,
    },
    PolicyKey.MaxKeys => match (facts.maxKeys.asBorrow()) {
        Some(v) => Some(v.view()),
        null => null,
    },
    PolicyKey.SseAlgorithm => match (facts.sseAlgorithm.asBorrow()) {
        Some(v) => Some(v.view()),
        null => null,
    },
    PolicyKey.SseKmsKeyId => match (facts.sseKmsKeyId.asBorrow()) {
        Some(v) => Some(v.view()),
        null => null,
    },
    PolicyKey.SseCustomerAlgorithm => match (facts.sseCustomerAlgorithm.asBorrow()) {
        Some(v) => Some(v.view()),
        null => null,
    },
    PolicyKey.SecureTransport => if (facts.secure) Some("true".bytes()) else Some("false".bytes()),
    PolicyKey.SourceIp => null,
};

/// Whether the request has the key at all.
fn factPresent(facts: borrow PolicyFacts, key: PolicyKey) -> bool => match (key) {
    PolicyKey.SourceIp => facts.peer.isSome(),
    _ => factText(facts, key).isSome(),
};

/// One condition test (ADR-0043 §3): any value matches; a key the request does not have fails it unless it is
/// negated; `Null` asks whether the key is absent.
fn testHolds(t: borrow PolicyTest, facts: borrow PolicyFacts) -> bool {
    // No client: a test of a client's fact does not hold, whatever its operator (`Not…` and `Null` included), so its
    // statement does not apply. Only whether the server is reached over TLS is the server's own.
    if (facts.noClient) {
        match (t.key) {
            PolicyKey.SecureTransport => {}
            _ => { return false; }
        }
    }
    let present = factPresent(facts, t.key);
    match (t.op) {
        PolicyOp.Null => {
            for (i in 0..t.values.length) {
                let wantsAbsent = t.values[i].view() == "true".bytes();
                if (wantsAbsent != present) { return true; }
            }
            return false;
        }
        _ => {}
    }
    if (!present) { return t.negated; }
    var matched = false;
    match (t.op) {
        PolicyOp.IpAddress => {
            match (facts.peer) {
                Some(peer) => {
                    for (i in 0..t.ranges.length) {
                        if (rangeHolds(borrow t.ranges[i], peer)) { matched = true; }
                    }
                }
                null => {}
            }
        }
        PolicyOp.NumericEquals | PolicyOp.NumericLessThan | PolicyOp.NumericLessThanEquals | PolicyOp.NumericGreaterThan | PolicyOp.NumericGreaterThanEquals => {
            // A value that is not a number matches no number.
            match (parseDecimal(factText(facts, t.key) ?? "".bytes())) {
                Some(n) => {
                    for (i in 0..t.numbers.length) {
                        let v = t.numbers[i];
                        let hit = match (t.op) {
                            PolicyOp.NumericEquals => n == v,
                            PolicyOp.NumericLessThan => n < v,
                            PolicyOp.NumericLessThanEquals => n <= v,
                            PolicyOp.NumericGreaterThan => n > v,
                            _ => n >= v,
                        };
                        if (hit) { matched = true; }
                    }
                }
                null => {}
            }
        }
        _ => {
            let text = factText(facts, t.key) ?? "".bytes();
            for (i in 0..t.values.length) {
                let v = t.values[i].view();
                let hit = match (t.op) {
                    PolicyOp.StringEqualsIgnoreCase | PolicyOp.Bool => equalsIgnoreCase(text, v),
                    PolicyOp.StringLike => wildMatch(v, text, false),
                    _ => text == v,
                };
                if (hit) { matched = true; }
            }
        }
    }
    return matched != t.negated;
}

enum PolicyDecision {
    Allow,
    Deny,
    Neither,
}

/// Whether a statement applies: its principal, action, resource and every condition match.
fn statementApplies(
    st: borrow PolicyStatement,
    who: Slice<u8>?,
    user: Slice<u8>?,
    action: StringView,
    resource: Slice<u8>,
    facts: borrow PolicyFacts,
) -> bool {
    var principal = st.anyone;
    match (who) {
        Some(key) => {
            for (i in 0..st.keys.length) {
                if (st.keys[i].view() == key) { principal = true; }
            }
        }
        null => {}
    }
    match (user) {
        Some(name) => {
            for (i in 0..st.users.length) {
                if (userPrincipalMatches(st.users[i].view(), name, !st.allow)) { principal = true; }
            }
        }
        null => {}
    }
    if (principal == st.notPrincipal) { return false; }
    var acts = false;
    for (i in 0..st.actions.length) {
        if (wildMatch(st.actions[i].view(), action.bytes(), true)) { acts = true; }
    }
    if (acts == st.notAction) { return false; }
    var covers = false;
    for (i in 0..st.resources.length) {
        if (wildMatch(st.resources[i].view(), resource, false)) { covers = true; }
    }
    if (covers == st.notResource) { return false; }
    for (i in 0..st.tests.length) {
        if (!testHolds(borrow st.tests[i], facts)) { return false; }
    }
    return true;
}

/// A policy's answer for a request (ADR-0043 §4): Deny if a Deny applies, else Allow if an Allow does.
fn decidePolicy(
    policy: borrow BucketPolicy,
    who: Slice<u8>?,
    action: StringView,
    resource: Slice<u8>,
    facts: borrow PolicyFacts,
) -> PolicyDecision => decidePolicyFor(policy, who, null, action, resource, facts);

/// `decidePolicy`, for a requester that is also a user (ADR-0088 §3): a statement naming its key or its user applies.
fn decidePolicyFor(
    policy: borrow BucketPolicy,
    who: Slice<u8>?,
    user: Slice<u8>?,
    action: StringView,
    resource: Slice<u8>,
    facts: borrow PolicyFacts,
) -> PolicyDecision {
    var allowed = false;
    for (i in 0..policy.statements.length) {
        let st = borrow policy.statements[i];
        if (!statementApplies(st, who, user, action, resource, facts)) { continue; }
        if (!st.allow) { return PolicyDecision.Deny; }
        allowed = true;
    }
    return if (allowed) PolicyDecision.Allow else PolicyDecision.Neither;
}

/// Whether a statement's conditions keep it to fixed addresses (ADR-0044 §2): an `IpAddress` test on `aws:SourceIp`
/// whose ranges are each no wider than /8 (IPv4) or /32 (IPv6), as S3 draws the line.
fn fixedAddresses(st: borrow PolicyStatement) -> bool {
    for (i in 0..st.tests.length) {
        let t = borrow st.tests[i];
        if (t.negated || t.ranges.length == 0) { continue; }
        let narrow = match (t.op) {
            PolicyOp.IpAddress => match (t.key) {
                PolicyKey.SourceIp => true,
                _ => false,
            },
            _ => false,
        };
        if (!narrow) { continue; }
        var wide = false;
        for (j in 0..t.ranges.length) {
            let least: u32 = if (t.ranges[j].v6) 32 else 8;
            if (t.ranges[j].bits < least) { wide = true; }
        }
        if (!wide) { return true; }
    }
    return false;
}

/// Whether a policy is public (ADR-0044 §2): some Allow is for anyone and is not kept to fixed addresses. What its
/// Deny statements take back is not counted.
fn policyIsPublic(policy: borrow BucketPolicy) -> bool {
    for (i in 0..policy.statements.length) {
        let st = borrow policy.statements[i];
        if (st.allow && st.anyone && !fixedAddresses(st)) { return true; }
    }
    return false;
}

/// Whether a stored public-access block has the setting `bit` on.
fn publicAccessHas(block: Slice<u8>, bit: u8) -> bool => block.length == 1 && (block[0] & bit) != 0;

// ---- Requests ----

/// Who sent a request (ADR-0043 §1): a configured key, by its place in the credentials, or no one; and from where.
struct Requester {
    key: usize?;
    peer: SocketAddress?;
    /// Temporary credentials (ADR-0075): a session's request. With a role, the role's place in `S3App.roles`, and
    /// its session policy: what the key may do is narrowed to what both allow.
    session: bool;
    role: usize?;
    sessionPolicy: BucketPolicy?;
    /// A request through an access point (ADR-0076 §3): its policy, read as the bucket's, and its public-access block.
    accessPoint: bool;
    /// The access point's name, as an identity policy names it (`s3ap:<name>`, ADR-0088 §3); empty without one.
    accessPointName: Vector<u8>;
    accessPointPolicy: BucketPolicy?;
    accessPointBlock: u8;
    /// Through a directory bucket's access point (ADR-0082): its name, which its sessions are of, and its scope
    /// (`scopeAllows`); empty and none otherwise.
    directoryAccessPoint: Vector<u8>;
    scopePrefixes: Vector<Vector<u8>>;
    scopePermissions: u8;
}

/// A requester with a long-term key, or none.
fn requesterOf(key: usize?, peer: SocketAddress?) -> Requester =>
    Requester {
        key: key,
        peer: peer,
        session: false,
        role: null,
        sessionPolicy: null,
        accessPoint: false,
        accessPointName: Vector<u8>.create(),
        accessPointPolicy: null,
        accessPointBlock: 0,
        directoryAccessPoint: Vector<u8>.create(),
        scopePrefixes: Vector<Vector<u8>>.create(),
        scopePermissions: 0,
    };

/// Whether a requester's identity policies let it do `action` on `resource`, as an identity policy names it
/// (`s3:<bucket>[/<key>]`, `s3tables:…`, `iam:role/…`, or `s3:` for the service: ADR-0088 §3):
/// - a role's session: its role's policy and its session policy must each allow it, and neither deny it (ADR-0075 §3);
/// - a user's key, or its session: its identity policy must allow it (ADR-0088 §2). This decides the calls that have
///   no resource policy; a call that has one is decided with it (`gateDecision`).
/// A key of the account is not narrowed.
fn sessionAllows(
    app: borrow S3App,
    req: borrow S3Request,
    who: borrow Requester,
    action: StringView,
    resource: Slice<u8>,
) -> Result<bool, AllocError> {
    if (revokedRequester(app.credentials.get().view(), who)) { return Ok(false); }
    if (who.role.isNull()) {
        match (userOfRequester(app.credentials.get().view(), who)) {
            Some(u) => {
                let policy = match (borrow u.policy) {
                    Some(p) => p,
                    null => { return Ok(false); }
                };
                let facts = policyFacts(req, isListingAction(action), app.secure, who.peer)?;
                return Ok(match (decidePolicy(policy, null, action, resource, borrow facts)) {
                    PolicyDecision.Allow => true,
                    _ => false,
                });
            }
            null => { return Ok(true); }
        }
    }
    let role = match (who.role) {
        Some(r) => r,
        null => { return Ok(true); }
    };
    let roles = app.roles.get().view();
    if (role >= roles.length || roles[role].removed) { return Ok(false); }
    let facts = policyFacts(req, isListingAction(action), app.secure, who.peer)?;
    match (decidePolicy(borrow roles[role].policy, null, action, resource, borrow facts)) {
        PolicyDecision.Allow => {}
        _ => { return Ok(false); }
    }
    match (borrow who.sessionPolicy) {
        Some(p) => {
            match (decidePolicy(p, null, action, resource, borrow facts)) {
                PolicyDecision.Allow => {}
                _ => { return Ok(false); }
            }
        }
        null => {}
    }
    return Ok(true);
}

/// The policy calls, which a key is never refused and an anonymous request always is (ADR-0043 §4).
fn isPolicyAction(action: StringView) -> bool =>
    action == "s3:GetBucketPolicy" || action == "s3:PutBucketPolicy" || action == "s3:DeleteBucketPolicy";

/// The listings, which have the `s3:prefix`, `s3:delimiter` and `s3:max-keys` keys.
fn isListingAction(action: StringView) -> bool => action == "s3:ListBucket" || action == "s3:ListBucketVersions";

/// What a request's checks need of its bucket's policy, read once (DeleteObjects checks every key with it).
enum PolicyGate {
    /// Nothing to read: a key, and no policy has a Deny.
    Open,
    /// Anonymous, and this bucket's public policy is restricted by its public-access block (ADR-0044 §3).
    Closed,
    /// The bucket has no policy, or is not there.
    Absent,
    Read(BucketPolicy),
    /// A stored policy that does not parse (ADR-0043 §9).
    Broken,
}

/// What a request's checks need of its bucket, read once: its policy, and for an anonymous request its ACL.
struct AccessGate {
    policy: PolicyGate;
    /// The bucket's ACL as an anonymous request meets it (ADR-0045 §4): the private one for a key's request, which
    /// needs none, and under `IgnorePublicAcls`.
    acl: [u8; 3];
    /// The bucket's public-access block has `IgnorePublicAcls`: its objects' ACLs open nothing either.
    ignoreAcls: bool;
}

/// The bucket's policy and ACL, as a request by `who` needs them (ADR-0043 §8, ADR-0045 §6).
async fn policyGate(app: borrow S3App, who: borrow Requester, bucket: StringView) -> Result<AccessGate, S3Fail> {
    var gate = AccessGate { policy: PolicyGate.Absent, acl: privateAcl(), ignoreAcls: false };
    let anonymous = who.key.isNull();
    // A user's request reads the policy whatever it holds: an Allow in it may be what lets the user (ADR-0088 §2).
    let user = userOfRequester(app.credentials.get().view(), who).isSome();
    if (!anonymous && !user && app.denyBuckets.load() == 0) {
        gate.policy = PolicyGate.Open;
        return Ok(gate);
    }
    var document = Vector<u8>.create();
    var block = Vector<u8>.create();
    var acl = Vector<u8>.create();
    {
        var guard = await lockStore(app)?;
        let store = guard.data();
        // Index lookups and copies: on the event loop.
        match (store.bucketConfig(bucket, BUCKET_CONFIG_POLICY)) {
            Ok(d) => { document = d; }
            Err(_) => { return Ok(gate); } // no such bucket
        }
        if (anonymous) {
            match (store.bucketConfig(bucket, BUCKET_CONFIG_PUBLIC_ACCESS)) {
                Ok(b) => { block = b; }
                Err(_) => { return Ok(gate); }
            }
            match (store.bucketConfig(bucket, BUCKET_CONFIG_ACL)) {
                Ok(a) => { acl = a; }
                Err(_) => { return Ok(gate); }
            }
        }
    }
    gate.ignoreAcls = publicAccessHas(block.view(), PUBLIC_ACCESS_IGNORE_ACLS);
    if (!gate.ignoreAcls) { gate.acl = aclOf(acl.view()); }
    if (document.length == 0) { return Ok(gate); }
    let policy = match (parseBucketPolicy(document.view(), bucket.bytes(), app.credentials.get().view(), false)) {
        Ok(p) => p,
        Err(S3Fail.OutOfMemory(e)) => { return Err(S3Fail.OutOfMemory(e)); }
        Err(_) => {
            gate.policy = PolicyGate.Broken;
            return Ok(gate);
        }
    };
    // RestrictPublicBuckets: a public policy opens nothing to a requester outside the account (ADR-0044 §3).
    if (publicAccessHas(block.view(), PUBLIC_ACCESS_RESTRICT_BUCKETS) && policyIsPublic(borrow policy)) {
        gate.policy = PolicyGate.Closed;
        return Ok(gate);
    }
    gate.policy = PolicyGate.Read(policy);
    return Ok(gate);
}

/// What the bucket's policy and ACL say of `who` doing `action` on `bucket` or `bucket/key` (`key` empty: the
/// bucket). Neither: an anonymous request that only the object's own ACL could still let in (ADR-0045 §4).
/// A call as an identity policy names it (ADR-0088 §3): `s3:<bucket>[/<key>]` and its action. A directory bucket's is
/// S3 Express's (the M11 exit review's A5, B1): its management calls are `s3express:<call>` on `s3express:<bucket>`,
/// and every other call, of its objects or its listing, is granted by `s3express:CreateSession` on the bucket, as
/// AWS grants them through the session.
struct IdentityCall {
    action: Vector<u8>;
    target: Vector<u8>;
}

/// The management calls of a directory bucket, whose IAM actions are S3 Express's of the same name.
const DIRECTORY_MANAGEMENT: [StringView; 8] = [
    "s3:DeleteBucket",
    "s3:PutBucketPolicy",
    "s3:GetBucketPolicy",
    "s3:DeleteBucketPolicy",
    "s3:PutEncryptionConfiguration",
    "s3:GetEncryptionConfiguration",
    "s3:PutLifecycleConfiguration",
    "s3:GetLifecycleConfiguration",
];

fn identityCallOf(action: StringView, bucket: StringView, key: Slice<u8>) -> Result<IdentityCall, AllocError> {
    var call = IdentityCall { action: Vector<u8>.create(), target: Vector<u8>.create() };
    if (!isDirectoryShaped(bucket.bytes())) {
        call.action.extend(action.bytes())?;
        call.target.extend("s3:".bytes())?;
        call.target.extend(bucket.bytes())?;
        if (key.length > 0) {
            call.target.push('/')?;
            call.target.extend(key)?;
        }
        return Ok(call);
    }
    call.target.extend("s3express:".bytes())?;
    call.target.extend(bucket.bytes())?;
    var managed = false;
    for (m in DIRECTORY_MANAGEMENT) {
        if (m == action) { managed = true; }
    }
    if (managed) {
        call.action.extend("s3express:".bytes())?;
        call.action.extend(action.bytes()["s3:".length..])?;
    } else if (startsWithBytes(action.bytes(), "s3express:".bytes())) {
        call.action.extend(action.bytes())?;
    } else {
        call.action.extend("s3express:CreateSession".bytes())?;
    }
    return Ok(call);
}

fn gateDecision(
    app: borrow S3App,
    gate: borrow AccessGate,
    req: borrow S3Request,
    who: borrow Requester,
    action: StringView,
    bucket: StringView,
    key: Slice<u8>,
) -> Result<PolicyDecision, AllocError> {
    let anonymous = who.key.isNull();
    // A table bucket's warehouse: a user's or a role session's request was decided as its table's data
    // (`s3tables:GetTableData`/`PutTableData`, ADR-0084 §4) before it came here, not as S3's on a hidden bucket.
    if (isTableWarehouseShaped(bucket.bytes()) &&
        (who.role.isSome() || userOfRequester(app.credentials.get().view(), who).isSome())) {
        return Ok(PolicyDecision.Allow);
    }
    // As an identity policy names it (ADR-0088 §3).
    let call = identityCallOf(action, bucket, key)?;
    let identityAction = StringView.fromUtf8(call.action.view()) ?? action;
    let target = call.target.view();
    // A role session first: it may do only what its policies allow, whatever the bucket's say (ADR-0075 §3).
    if (who.role.isSome()) {
        if (!sessionAllows(app, req, who, identityAction, target)?) { return Ok(PolicyDecision.Deny); }
    }
    // A user's identity policy: its Deny refuses; its Allow, or the bucket's policy's, lets it; neither refuses
    // (ADR-0088 §2).
    let credentials = app.credentials.get().view();
    let user = if (who.role.isNull()) userOfRequester(credentials, who) else null;
    var identityAllows = false;
    match (user) {
        Some(u) => {
            match (borrow u.policy) {
                Some(p) => {
                    let facts = policyFacts(req, isListingAction(action), app.secure, who.peer)?;
                    match (decidePolicy(p, null, identityAction, target, borrow facts)) {
                        PolicyDecision.Deny => { return Ok(PolicyDecision.Deny); }
                        PolicyDecision.Allow => { identityAllows = true; }
                        PolicyDecision.Neither => {}
                    }
                }
                null => {}
            }
        }
        null => {}
    }
    let userName: Slice<u8>? = match (user) {
        Some(u) => Some(u.userKey.view()),
        null => null,
    };
    // Through an access point, a user's identity policy is read for it too, `s3ap:<name>[/object/<key>]`: its Deny
    // refuses, and its Allow lets the user through the access point (the M11 exit review's A6).
    var pointIdentityAllows = false;
    if (who.accessPoint) {
        match (user) {
            Some(u) => {
                match (borrow u.policy) {
                    Some(p) => {
                        let express = who.directoryAccessPoint.length > 0;
                        var pointCall = copyBytes(if (express) "s3expressap:".bytes() else "s3ap:".bytes())?;
                        pointCall.extend(who.accessPointName.view())?;
                        // A directory bucket's access point is granted whole, as its bucket is (`CreateSession`).
                        if (key.length > 0 && !express) {
                            pointCall.extend("/object/".bytes())?;
                            pointCall.extend(key)?;
                        }
                        let facts = policyFacts(req, isListingAction(action), app.secure, who.peer)?;
                        match (decidePolicy(p, null, identityAction, pointCall.view(), borrow facts)) {
                            PolicyDecision.Deny => { return Ok(PolicyDecision.Deny); }
                            PolicyDecision.Allow => { pointIdentityAllows = true; }
                            PolicyDecision.Neither => {}
                        }
                    }
                    null => {}
                }
            }
            null => {}
        }
    }
    // Through an access point (ADR-0076 §3): its policy's Deny refuses; an anonymous request needs its Allow, which
    // a public policy under RestrictPublicBuckets does not give; then the bucket's say, as without one.
    if (who.accessPoint) {
        var allowed = false;
        match (borrow who.accessPointPolicy) {
            Some(p) => {
                var pointTarget = copyBytes(bucket.bytes())?;
                if (key.length > 0) {
                    pointTarget.push('/')?;
                    pointTarget.extend(key)?;
                }
                let facts = policyFacts(req, isListingAction(action), app.secure, who.peer)?;
                let principal = match (who.key) {
                    Some(i) => if (i < credentials.length) Some(credentials[i].accessKey.view()) else null,
                    null => null,
                };
                match (decidePolicyFor(p, principal, userName, action, pointTarget.view(), borrow facts)) {
                    PolicyDecision.Deny => { return Ok(PolicyDecision.Deny); }
                    PolicyDecision.Allow => {
                        allowed = !anonymous || !publicAccessHas(
                            [who.accessPointBlock][..],
                            PUBLIC_ACCESS_RESTRICT_BUCKETS,
                        ) ||
                            !policyIsPublic(p);
                    }
                    PolicyDecision.Neither => {}
                }
            }
            null => {}
        }
        if (anonymous && !allowed) { return Ok(PolicyDecision.Deny); }
        // A user needs the access point to let it in, by its identity policy or the access point's, and then the
        // bucket to, below: each side allows, as AWS asks (the M11 exit review's A6).
        if (user.isSome() && !allowed && !pointIdentityAllows) { return Ok(PolicyDecision.Deny); }
        // A role's session: its policies must allow the access point too, as they must the bucket (the M11 second
        // reading's #3).
        if (who.role.isSome()) {
            let express = who.directoryAccessPoint.length > 0;
            var pointCall = copyBytes(if (express) "s3expressap:".bytes() else "s3ap:".bytes())?;
            pointCall.extend(who.accessPointName.view())?;
            if (key.length > 0 && !express) {
                pointCall.extend("/object/".bytes())?;
                pointCall.extend(key)?;
            }
            if (!sessionAllows(app, req, who, identityAction, pointCall.view())?) { return Ok(PolicyDecision.Deny); }
        }
    }
    if (isPolicyAction(action) && user.isNull()) {
        return Ok(if (anonymous) PolicyDecision.Deny else PolicyDecision.Allow);
    }
    match (borrow gate.policy) {
        PolicyGate.Open => {
            if (user.isNull()) { return Ok(PolicyDecision.Allow); }
        }
        PolicyGate.Closed | PolicyGate.Broken => { return Ok(PolicyDecision.Deny); }
        PolicyGate.Absent => {}
        PolicyGate.Read(policy) => {
            var resource = copyBytes(bucket.bytes())?;
            if (key.length > 0) {
                resource.push('/')?;
                resource.extend(key)?;
            }
            let facts = policyFacts(req, isListingAction(action), app.secure, who.peer)?;
            // A key's place is the same in every set of credentials (ADR-0050).
            let principal = match (who.key) {
                Some(i) => if (i < credentials.length) Some(credentials[i].accessKey.view()) else null,
                null => null,
            };
            match (decidePolicyFor(policy, principal, userName, action, resource.view(), borrow facts)) {
                PolicyDecision.Deny => { return Ok(PolicyDecision.Deny); }
                PolicyDecision.Allow => { return Ok(PolicyDecision.Allow); }
                PolicyDecision.Neither => {}
            }
        }
    }
    // No statement applies: a user may if its identity policy lets it (ADR-0088 §2).
    if (user.isSome()) { return Ok(if (identityAllows) PolicyDecision.Allow else PolicyDecision.Deny); }
    // A key of the account may, and an anonymous request may do what the bucket's ACL grants everyone.
    let aclsIgnored = who.accessPoint && publicAccessHas([who.accessPointBlock][..], PUBLIC_ACCESS_IGNORE_ACLS);
    if (!anonymous || (!aclsIgnored && aclGrants(gate.acl[ACL_ALL_USERS], bucketAclNeed(action)))) {
        return Ok(PolicyDecision.Allow);
    }
    return Ok(PolicyDecision.Neither);
}

/// Whether the gate lets `who` do `action` on `bucket` or `bucket/key`, by the bucket's policy and ACL alone.
fn gateAllows(
    app: borrow S3App,
    gate: borrow AccessGate,
    req: borrow S3Request,
    who: borrow Requester,
    action: StringView,
    bucket: StringView,
    key: Slice<u8>,
) -> Result<bool, AllocError> => Ok(match (gateDecision(app, gate, req, who, action, bucket, key)?) {
    PolicyDecision.Allow => true,
    _ => false,
});

/// AccessDenied unless `who` may do `action` on `bucket` or `bucket/key` (ADR-0043 §4).
async fn authorize(
    app: borrow S3App,
    req: borrow S3Request,
    who: borrow Requester,
    action: StringView,
    bucket: StringView,
    key: Slice<u8>,
) -> Result<void, S3Fail> => await authorizeVersion(app, req, who, action, bucket, key, null);

/// Who a configuration is put by, as ADR-0094 §1 records it: `user <name> <id>` for a user or a GetSessionToken
/// session's user, `role <name>` for an AssumeRole session's role (a session is decided as its parent); empty for the
/// account's keys, whose configurations are the account's.
fn requesterText(app: borrow S3App, who: borrow Requester) -> Result<Vector<u8>, AllocError> {
    var out = Vector<u8>.create();
    // A role or a user that cannot be named records a requester no write is allowed as (`role `, `user `): it fails
    // closed, rather than as the account's (the M14 exit review's B3).
    match (who.role) {
        Some(r) => {
            out.extend("role ".bytes())?;
            let roles = app.roles.get().view();
            if (r < roles.length) { out.extend(roles[r].name.view())?; }
            return Ok(out);
        }
        null => {}
    }
    match (userOfRequester(app.credentials.get().view(), who)) {
        Some(u) => {
            out.extend("user ".bytes())?;
            out.extend(u.userKey.view())?;
        }
        null => {}
    }
    return Ok(out);
}

/// A request of no client, for a decision the server makes on its own (ADR-0094 §2): no headers, so no policy
/// condition on a client's address, Referer or User-Agent holds for it.
fn deliveryRequest() -> S3Request => S3Request {
    method: Method.Put,
    methodText: Vector<u8>.create(),
    headers: Vector<HeaderPair>.create(),
    rawPath: Vector<u8>.create(),
    rawQuery: Vector<u8>.create(),
    bucket: String.create(),
    key: String.create(),
    query: Vector<QueryParam>.create(),
};

/// Whether a write the server makes for a configuration is allowed as the requester it records (ADR-0094 §2): as a
/// request of theirs to `action` on `bucket`/`key` would be, with `credentials` and `roles` as they are now and the
/// destination bucket's policy (`policy`, none; `broken`, one that does not parse). The rules are a user's request's
/// (ADR-0088 §2: a Deny in its identity policy or the bucket's refuses, else an Allow in either allows) and a role
/// session's (ADR-0075 §3: its role's policy must allow, and the bucket's may deny). An empty requester is the
/// account's, or a configuration put before M14: allowed. A user no users file has, or a role no roles file has, is
/// refused. A write has no client, so a policy condition on a client's address, Referer or User-Agent holds for none.
fn decideRecorded(
    credentials: Slice<Credential>,
    roles: Slice<StsRole>,
    secure: bool,
    policy: borrow BucketPolicy?,
    broken: bool,
    requester: Slice<u8>,
    action: StringView,
    bucket: StringView,
    key: Slice<u8>,
) -> Result<bool, AllocError> {
    if (requester.length == 0) { return Ok(true); }
    let userHead = "user ".bytes();
    let roleHead = "role ".bytes();
    var user: usize? = null;
    var role: usize? = null;
    if (startsWithBytes(requester, userHead)) {
        let userKey = requester[userHead.length..];
        // An account's key has an empty user key: an empty one names no user.
        if (userKey.length == 0) { return Ok(false); }
        for (i in 0..credentials.length) {
            if (!credentials[i].revoked && credentials[i].userKey.view() == userKey) { user = Some(i); }
        }
    } else if (startsWithBytes(requester, roleHead)) {
        let name = requester[roleHead.length..];
        if (name.length == 0) { return Ok(false); }
        for (r in 0..roles.length) {
            if (!roles[r].removed && roles[r].name.view() == name) { role = Some(r); }
        }
    }
    if (user.isNull() && role.isNull()) { return Ok(false); }
    let req = deliveryRequest();
    var facts = policyFacts(borrow req, false, secure, null)?;
    facts.noClient = true;
    let call = identityCallOf(action, bucket, key)?;
    let identityAction = StringView.fromUtf8(call.action.view()) ?? action;
    var identityAllows = false;
    match (role) {
        Some(r) => {
            match (decidePolicy(borrow roles[r].policy, null, identityAction, call.target.view(), borrow facts)) {
                PolicyDecision.Allow => { identityAllows = true; }
                _ => { return Ok(false); }
            }
        }
        null => {}
    }
    var principal: Slice<u8>? = null;
    var userName: Slice<u8>? = null;
    match (user) {
        Some(i) => {
            principal = Some(credentials[i].accessKey.view());
            userName = Some(credentials[i].userKey.view());
            match (borrow credentials[i].policy) {
                Some(p) => {
                    match (decidePolicy(p, null, identityAction, call.target.view(), borrow facts)) {
                        PolicyDecision.Deny => { return Ok(false); }
                        PolicyDecision.Allow => { identityAllows = true; }
                        PolicyDecision.Neither => {}
                    }
                }
                null => {}
            }
        }
        null => {}
    }
    if (broken) { return Ok(false); }
    match (policy) {
        Some(p) => {
            var resource = copyBytes(bucket.bytes())?;
            if (key.length > 0) {
                resource.push('/')?;
                resource.extend(key)?;
            }
            match (decidePolicyFor(p, principal, userName, action, resource.view(), borrow facts)) {
                PolicyDecision.Deny => { return Ok(false); }
                PolicyDecision.Allow => { return Ok(true); }
                PolicyDecision.Neither => {}
            }
        }
        null => {}
    }
    return Ok(identityAllows);
}

/// What `serve`'s writers decide a configuration's writes with (ADR-0094 §3): the credentials as they are reloaded,
/// the roles, and whether requests come over TLS.
struct RecordedDecider {
    credentials: Arc<CredentialSets>?;
    /// The roles as they are reloaded (ADR-0096 §1).
    roles: Arc<RoleSets>?;
    secure: bool;

    fn none() -> RecordedDecider => RecordedDecider { credentials: null, roles: null, secure: false };
}

/// Copies of the roles, for a writer that decides as them.
fn copyRoles(roles: Slice<StsRole>) -> Result<Vector<StsRole>, AllocError> {
    var out = Vector<StsRole>.create();
    for (r in roles) {
        out.push(
            StsRole {
                name: copyBytes(r.name.view())?,
                maxSeconds: r.maxSeconds,
                policy: clonePolicy(borrow r.policy)?,
                removed: r.removed,
            },
        )?;
    }
    return Ok(out);
}

/// `decideRecorded` under the store's lock, with the destination bucket's policy as the store has it: a write of a
/// configuration (ADR-0094 §3). A bucket that is not there is refused.
fn decidedIn(
    d: borrow RecordedDecider,
    store: borrow ObjectStore,
    requester: Slice<u8>,
    action: StringView,
    bucket: StringView,
    key: Slice<u8>,
) -> Result<bool, AllocError> {
    if (requester.length == 0) { return Ok(true); }
    let sets = match (borrow d.credentials) {
        Some(c) => c,
        null => { return Ok(false); }
    };
    let credentials = sets.get().view();
    let stored = match (store.bucketConfig(bucket, BUCKET_CONFIG_POLICY)) {
        Ok(s) => s,
        Err(_) => { return Ok(false); }
    };
    var policy: BucketPolicy? = null;
    var broken = false;
    if (stored.length > 0) {
        match (parseBucketPolicy(stored.view(), bucket.bytes(), credentials, false)) {
            Ok(p) => { policy = Some(p); }
            Err(S3Fail.OutOfMemory(e)) => { return Err(e); }
            Err(_) => { broken = true; }
        }
    }
    let noRoles = Vector<StsRole>.create();
    let roles = match (borrow d.roles) {
        Some(r) => r.get().view(),
        null => noRoles.view(),
    };
    return decideRecorded(
        credentials,
        roles,
        d.secure,
        policy.asBorrow(),
        broken,
        requester,
        action,
        bucket,
        key,
    );
}

/// `decideRecorded` with the S3 server's own credentials, roles and the destination bucket's policy (a cluster's
/// destination shard, ADR-0094 §4).
async fn allowedAsRecorded(
    app: borrow S3App,
    requester: Slice<u8>,
    action: StringView,
    bucket: StringView,
    key: Slice<u8>,
) -> Result<bool, S3Fail> {
    if (requester.length == 0) { return Ok(true); }
    let stored = await storeBucketConfig(app, bucket, BUCKET_CONFIG_POLICY)?;
    let credentials = app.credentials.get().view();
    var policy: BucketPolicy? = null;
    var broken = false;
    if (stored.length > 0) {
        match (parseBucketPolicy(stored.view(), bucket.bytes(), credentials, false)) {
            Ok(p) => { policy = Some(p); }
            Err(S3Fail.OutOfMemory(e)) => { return Err(S3Fail.OutOfMemory(e)); }
            Err(_) => { broken = true; }
        }
    }
    return Ok(
        decideRecorded(
            credentials,
            app.roles.get().view(),
            app.secure,
            policy.asBorrow(),
            broken,
            requester,
            action,
            bucket,
            key,
        )?,
    );
}

/// Whether a user's or a session's configuration may name `bucket` as where the server writes for it, under `prefix`:
/// replication's destination, an inventory's or the logs' (the M11 exit review's A1). The requester must be allowed
/// `action` on the objects under the prefix, `s3:<bucket>/<prefix>*`, as if it wrote them itself, and no Deny of its
/// policies or the bucket's may reach any key under it, whatever its conditions: what is decided once, when the
/// configuration is put, must hold for every object the server writes later. The account's keys may name any bucket,
/// as before: the account owns them all.
async fn authorizeDestination(
    app: borrow S3App,
    req: borrow S3Request,
    who: borrow Requester,
    action: StringView,
    bucket: Slice<u8>,
    prefix: Slice<u8>,
) -> Result<void, S3Fail> {
    let credentials = app.credentials.get().view();
    let user = userOfRequester(credentials, who);
    if (user.isNull() && !who.session) { return Ok(); }
    let name = StringView.fromUtf8(bucket) ?? { return Err(S3Fail.Code(S3Code.AccessDenied)); };
    var keys = copyBytes(prefix)?;
    keys.push('*')?;
    await authorize(app, req, who, action, name, keys.view())?;
    // A Deny anywhere under the prefix: the requester's own policies, then the bucket's.
    var identityPrefix = copyBytes("s3:".bytes())?;
    identityPrefix.extend(bucket)?;
    identityPrefix.push('/')?;
    identityPrefix.extend(prefix)?;
    var policies = Vector<BucketPolicy>.create();
    match (user) {
        Some(u) => {
            match (borrow u.policy) {
                Some(p) => { policies.push(clonePolicy(p)?)?; }
                null => {}
            }
        }
        null => {}
    }
    match (who.role) {
        Some(r) => {
            let roles = app.roles.get().view();
            if (r < roles.length) { policies.push(clonePolicy(borrow roles[r].policy)?)?; }
        }
        null => {}
    }
    match (borrow who.sessionPolicy) {
        Some(p) => { policies.push(clonePolicy(p)?)?; }
        null => {}
    }
    for (k in 0..policies.length) {
        if (denyReaches(borrow policies[k], null, null, action, identityPrefix.view())) {
            return Err(S3Fail.Code(S3Code.AccessDenied));
        }
    }
    let gate = await policyGate(app, who, name)?;
    match (borrow gate.policy) {
        PolicyGate.Closed | PolicyGate.Broken => { return Err(S3Fail.Code(S3Code.AccessDenied)); }
        PolicyGate.Read(policy) => {
            var resourcePrefix = copyBytes(bucket)?;
            resourcePrefix.push('/')?;
            resourcePrefix.extend(prefix)?;
            let principal = match (who.key) {
                Some(i) => if (i < credentials.length) Some(credentials[i].accessKey.view()) else null,
                null => null,
            };
            let userName: Slice<u8>? = match (user) {
                Some(u) => Some(u.userKey.view()),
                null => null,
            };
            if (denyReaches(policy, principal, userName, action, resourcePrefix.view())) {
                return Err(S3Fail.Code(S3Code.AccessDenied));
            }
        }
        _ => {}
    }
    return Ok();
}

/// Whether a Deny of `policy` that names this requester and action could refuse some resource starting with
/// `prefix`, whatever its conditions (they are taken to hold): a NotResource Deny always could.
fn denyReaches(
    policy: borrow BucketPolicy,
    who: Slice<u8>?,
    user: Slice<u8>?,
    action: StringView,
    prefix: Slice<u8>,
) -> bool {
    for (s in 0..policy.statements.length) {
        let st = borrow policy.statements[s];
        if (st.allow) { continue; }
        var principal = st.anyone;
        match (who) {
            Some(key) => {
                for (i in 0..st.keys.length) {
                    if (st.keys[i].view() == key) { principal = true; }
                }
            }
            null => {}
        }
        match (user) {
            Some(name) => {
                for (i in 0..st.users.length) {
                    if (userPrincipalMatches(st.users[i].view(), name, true)) { principal = true; }
                }
            }
            null => {}
        }
        // An identity policy's statements name no principal: they are the requester's own.
        let identity = !st.anyone && st.keys.length == 0 && st.users.length == 0 && !st.notPrincipal;
        if (!identity && principal == st.notPrincipal) { continue; }
        var acts = false;
        for (i in 0..st.actions.length) {
            if (wildMatch(st.actions[i].view(), action.bytes(), true)) { acts = true; }
        }
        if (acts == st.notAction) { continue; }
        if (st.notResource) { return true; }
        for (i in 0..st.resources.length) {
            if (patternMeetsPrefix(st.resources[i].view(), prefix)) { return true; }
        }
    }
    return false;
}

/// Whether a statement's user principal names the requester `<name> <id>`: the same name and id. A bare name (a
/// policy stored before ids) names no one in an Allow, and every user of that name in a Deny, so neither grants nor
/// lets go of what it did not mean to.
fn userPrincipalMatches(principal: Slice<u8>, requester: Slice<u8>, deny: bool) -> bool {
    if (principal == requester) { return true; }
    if (!deny || pieceEnd(principal, 0, ' ') != principal.length) { return false; }
    return requester.length > principal.length && requester[0..principal.length] == principal &&
        requester[principal.length] == ' ';
}

/// Whether the pattern (`*` and `?`) matches some text that starts with `prefix`.
fn patternMeetsPrefix(pattern: Slice<u8>, prefix: Slice<u8>) -> bool {
    var i: usize = 0;
    while (true) {
        if (i == prefix.length) { return true; }
        if (i == pattern.length) { return false; }
        let c = pattern[i];
        if (c == '*') { return true; }
        if (c != '?' && c != prefix[i]) { return false; }
        i += 1;
    }
    return false;
}

/// A write's fields that are calls of their own in S3's policies (the M11 exit review's A4): an ACL needs
/// `s3:PutObjectAcl`, tags `s3:PutObjectTagging`, a retention `s3:PutObjectRetention` and a legal hold
/// `s3:PutObjectLegalHold`, as well as the write's own action.
async fn authorizeWriteFields(
    app: borrow S3App,
    req: borrow S3Request,
    who: borrow Requester,
    acl: bool,
    tags: bool,
    bucket: StringView,
    key: Slice<u8>,
) -> Result<void, S3Fail> {
    if (acl) { await authorize(app, req, who, "s3:PutObjectAcl", bucket, key)?; }
    if (tags) { await authorize(app, req, who, "s3:PutObjectTagging", bucket, key)?; }
    if (headerOf(
        req,
        "x-amz-object-lock-mode",
    ).isSome() || headerOf(req, "x-amz-object-lock-retain-until-date").isSome()) {
        await authorize(app, req, who, "s3:PutObjectRetention", bucket, key)?;
    }
    if (headerOf(req, "x-amz-object-lock-legal-hold").isSome()) {
        await authorize(app, req, who, "s3:PutObjectLegalHold", bucket, key)?;
    }
    return Ok();
}

/// Whether a request's headers give an ACL: `x-amz-acl` or an `x-amz-grant-*`.
fn asksAcl(req: borrow S3Request) -> bool {
    for (name in [
        "x-amz-acl", "x-amz-grant-read", "x-amz-grant-write", "x-amz-grant-read-acp", "x-amz-grant-write-acp",
        "x-amz-grant-full-control",
    ]) {
        if (headerOf(req, name).isSome()) { return true; }
    }
    return false;
}

/// `authorizeWriteFields` for a request's headers, on its own key.
async fn authorizeWriteHeaders(
    app: borrow S3App,
    req: borrow S3Request,
    who: borrow Requester,
) -> Result<void, S3Fail> {
    let tags = headerOf(req, "x-amz-tagging").isSome();
    return await authorizeWriteFields(app, req, who, asksAcl(req), tags, req.bucket.view(), req.key.view().bytes());
}

/// `authorize`, for the version `versionId` of the key when the action is on one: an anonymous request that the
/// bucket's policy and ACL neither let in nor refuse may do what the version's own ACL grants everyone
/// (ADR-0045 §4).
async fn authorizeVersion(
    app: borrow S3App,
    req: borrow S3Request,
    who: borrow Requester,
    action: StringView,
    bucket: StringView,
    key: Slice<u8>,
    versionId: [u8; 16]?,
) -> Result<void, S3Fail> {
    // A key revoked since the request was authenticated has no user to decide it by: refused, not the account's.
    if (revokedRequester(app.credentials.get().view(), who)) { return Err(S3Fail.Code(S3Code.AccessDenied)); }
    if (who.key.isSome() && who.role.isNull() && !who.accessPoint &&
        userOfRequester(app.credentials.get().view(), who).isNull() &&
        (app.denyBuckets.load() == 0 || isPolicyAction(action))) {
        return Ok();
    }
    let gate = await policyGate(app, who, bucket)?;
    match (gateDecision(app, borrow gate, req, who, action, bucket, key)?) {
        PolicyDecision.Allow => { return Ok(); }
        PolicyDecision.Deny => { return Err(S3Fail.Code(S3Code.AccessDenied)); }
        PolicyDecision.Neither => {}
    }
    let need = objectAclNeed(action);
    let aclsIgnored = who.accessPoint && publicAccessHas([who.accessPointBlock][..], PUBLIC_ACCESS_IGNORE_ACLS);
    if (need != 0 && key.length > 0 && !gate.ignoreAcls && !aclsIgnored) {
        match (await storeObjectAcl(app, bucket, key, versionId)?) {
            Some(acl) => {
                if (aclGrants(acl[ACL_ALL_USERS], need)) { return Ok(); }
            }
            null => {
                // Nothing there to have an ACL. A requester who may list the bucket is told so (NoSuchKey, by the
                // call itself), as S3 tells it; any other is refused, and learns nothing of what the bucket holds.
                let none = "".bytes();
                match (gateDecision(app, borrow gate, req, who, "s3:ListBucket", bucket, none)?) {
                    PolicyDecision.Allow => { return Ok(); }
                    _ => {}
                }
            }
        }
    }
    return Err(S3Fail.Code(S3Code.AccessDenied));
}

/// `authorize` for the request's own object, with the action's version form when it names a version.
async fn authorizeObject(
    app: borrow S3App,
    req: borrow S3Request,
    who: borrow Requester,
    action: StringView,
    versionAction: StringView,
) -> Result<void, S3Fail> {
    let versionId = requestVersion(req)?;
    let named = if (versionId.isSome()) versionAction else action;
    return await authorizeVersion(app, req, who, named, req.bucket.view(), req.key.view().bytes(), versionId);
}

/// The counts of ADR-0043 §8, made again from the store: buckets with a policy, and those whose policy has a Deny
/// (or does not parse, so a key's requests read it and are refused).
fn countPolicies(all: borrow BucketPolicies, credentials: Slice<Credential>) -> PolicyCounts {
    var counts = PolicyCounts { policies: 0, denies: 0 };
    for (i in 0..all.names.length) {
        counts.policies += 1;
        let denies = match (parseBucketPolicy(all.documents[i].view(), all.names[i].view(), credentials, false)) {
            Ok(p) => p.denies,
            Err(_) => true,
        };
        if (denies) { counts.denies += 1; }
    }
    return counts;
}

struct PolicyCounts {
    policies: u64;
    denies: u64;
}

/// After a policy is put or deleted, or a bucket deleted: the counts again, before the response (ADR-0043 §8).
async fn recountPolicies(app: borrow S3App) -> Result<void, S3Fail> {
    if (app.cluster) { return Ok(); } // the counts stay at "some" (ADR-0060)
    var all = BucketPolicies { names: Vector<Vector<u8>>.create(), documents: Vector<Vector<u8>>.create() };
    {
        var guard = await lockStore(app)?;
        let store = guard.data();
        all = match (store.bucketPolicies()) {
            Ok(a) => a,
            Err(e) => { return Err(storeFail(e, 0)); }
        };
    }
    let counts = countPolicies(borrow all, app.credentials.get().view());
    app.policyBuckets.store(counts.policies);
    app.denyBuckets.store(counts.denies);
    return Ok();
}

// ---- The policy calls ----

async fn getBucketPolicy(
    app: borrow S3App,
    req: borrow S3Request,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    let document = await storeBucketConfig(app, req.bucket.view(), BUCKET_CONFIG_POLICY)?;
    if (document.length == 0) { return Err(S3Fail.Code(S3Code.NoSuchBucketPolicy)); }
    exchange.header("content-type", "application/json".bytes())?;
    await exchange.send(Status.ok(), storedPolicyText(document.view()))?;
    return Ok();
}

async fn putBucketPolicy(
    app: borrow S3App,
    req: borrow S3Request,
    auth: Authenticated,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    let json = await readSmallBody(auth, exchange, MAX_POLICY_BYTES + 1)?;
    verifySmallBody(req, json.view(), true)?;
    let policy = parseBucketPolicy(json.view(), req.bucket.view().bytes(), app.credentials.get().view(), true)?;
    // BlockPublicPolicy: a public policy is not taken (ADR-0044 §3).
    if (policyIsPublic(borrow policy)) {
        let block = await storeBucketConfig(app, req.bucket.view(), BUCKET_CONFIG_PUBLIC_ACCESS)?;
        if (publicAccessHas(block.view(), PUBLIC_ACCESS_BLOCK_POLICY)) { return Err(S3Fail.Code(S3Code.AccessDenied)); }
    }
    let stored = withUserIds(json.view(), borrow policy, app.credentials.get().view())?;
    await storeSetBucketConfig(app, req.bucket.view(), BUCKET_CONFIG_POLICY, stored.view())?;
    await recountPolicies(app)?;
    await exchange.send(Status.noContent(), "".bytes())?;
    return Ok();
}

async fn deleteBucketPolicy(
    app: borrow S3App,
    req: borrow S3Request,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    await storeSetBucketConfig(app, req.bucket.view(), BUCKET_CONFIG_POLICY, "".bytes())?;
    await recountPolicies(app)?;
    await exchange.send(Status.noContent(), "".bytes())?;
    return Ok();
}

// ---- The policy's status and the public-access block (ADR-0044) ----

/// GetBucketPolicyStatus: whether the bucket's policy is public; a bucket without a policy is not.
async fn getBucketPolicyStatus(
    app: borrow S3App,
    req: borrow S3Request,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    let bucket = req.bucket.view();
    let document = await storeBucketConfig(app, bucket, BUCKET_CONFIG_POLICY)?;
    var isPublic = false;
    if (document.length > 0) {
        match (parseBucketPolicy(document.view(), bucket.bytes(), app.credentials.get().view(), false)) {
            Ok(p) => { isPublic = policyIsPublic(borrow p); }
            Err(S3Fail.OutOfMemory(e)) => { return Err(S3Fail.OutOfMemory(e)); }
            Err(_) => {} // a stored policy that does not parse opens nothing (ADR-0043 §9)
        }
    }
    // A public ACL makes the bucket public too, unless the block has it ignored (ADR-0045 §5).
    if (!isPublic) {
        let acl = await storeBucketConfig(app, bucket, BUCKET_CONFIG_ACL)?;
        if (aclIsPublic(aclOf(acl.view()))) {
            let block = await storeBucketConfig(app, bucket, BUCKET_CONFIG_PUBLIC_ACCESS)?;
            isPublic = !publicAccessHas(block.view(), PUBLIC_ACCESS_IGNORE_ACLS);
        }
    }
    var body = Vector<u8>.create();
    xmlHead(mut body, "PolicyStatus")?;
    xmlElement(mut body, "IsPublic", if (isPublic) "true".bytes() else "false".bytes(), false)?;
    body.extend("</PolicyStatus>".bytes())?;
    return await sendXml(exchange, borrow body);
}

/// The settings a `<PublicAccessBlockConfiguration>` turns on, as the store keeps them: a setting it leaves out is
/// off.
fn parsePublicAccessBlock(xml: Slice<u8>) -> Result<u8, S3Fail> {
    if (findBytes(xml, "<PublicAccessBlockConfiguration".bytes(), 0).isNull()) {
        return Err(S3Fail.Code(S3Code.MalformedXML));
    }
    // The four settings, in the order of their bits.
    let names = ["BlockPublicAcls", "IgnorePublicAcls", "BlockPublicPolicy", "RestrictPublicBuckets"];
    var bits: u8 = 0;
    for (i in 0..names.length) {
        match (elementText(xml, names[i])) {
            Some(v) => {
                if (v == "true".bytes() || v == "TRUE".bytes()) {
                    bits |= 1u8 << truncate<u8>(i);
                } else if (v != "false".bytes() && v != "FALSE".bytes()) {
                    return Err(S3Fail.Code(S3Code.MalformedXML));
                }
            }
            null => {}
        }
    }
    return Ok(bits);
}

/// GetPublicAccessBlock: the four settings, or 404 for a bucket that was given none.
async fn getPublicAccessBlock(
    app: borrow S3App,
    req: borrow S3Request,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    let block = await storeBucketConfig(app, req.bucket.view(), BUCKET_CONFIG_PUBLIC_ACCESS)?;
    if (block.length == 0) { return Err(S3Fail.Code(S3Code.NoSuchPublicAccessBlockConfiguration)); }
    let names = ["BlockPublicAcls", "IgnorePublicAcls", "BlockPublicPolicy", "RestrictPublicBuckets"];
    var body = Vector<u8>.create();
    xmlHead(mut body, "PublicAccessBlockConfiguration")?;
    for (i in 0..names.length) {
        let on = (block[0] & (1u8 << truncate<u8>(i))) != 0;
        xmlElement(mut body, names[i], if (on) "true".bytes() else "false".bytes(), false)?;
    }
    body.extend("</PublicAccessBlockConfiguration>".bytes())?;
    return await sendXml(exchange, borrow body);
}

/// PutPublicAccessBlock. A policy the bucket already has stays; `RestrictPublicBuckets` is what closes it.
async fn putPublicAccessBlock(
    app: borrow S3App,
    req: borrow S3Request,
    auth: Authenticated,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    let xml = await readSmallBody(auth, exchange, 65536)?;
    verifySmallBody(req, xml.view(), true)?;
    let block = [parsePublicAccessBlock(xml.view())?];
    await storeSetBucketConfig(app, req.bucket.view(), BUCKET_CONFIG_PUBLIC_ACCESS, block[..])?;
    await exchange.send(Status.ok(), "".bytes())?;
    return Ok();
}

async fn deletePublicAccessBlock(
    app: borrow S3App,
    req: borrow S3Request,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    await storeSetBucketConfig(app, req.bucket.view(), BUCKET_CONFIG_PUBLIC_ACCESS, "".bytes())?;
    await exchange.send(Status.noContent(), "".bytes())?;
    return Ok();
}
