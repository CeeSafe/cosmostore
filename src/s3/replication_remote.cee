// Replication to other S3 endpoints (ADR-0077 §6): the endpoints of `serve --replication-targets`, the SigV4 requests
// that carry a replica there (PUT, or a multipart upload with the source's part sizes), and the plaintext body they
// stream from the source version's stored bytes.
import web_core;
import web_transport;
import web_http;
import web_server;
import web_client;

/// How much of a replica is read from disk at a time.
const REMOTE_READ_BYTES: usize = 1048576;

/// An endpoint a rule may replicate to: `<id> <http or https url> <access key> <secret key> [region]`.
struct ReplicationTarget {
    id: Vector<u8>;
    url: Vector<u8>;
    accessKey: Vector<u8>;
    secret: Vector<u8>;
    region: Vector<u8>;
    /// The cluster's secret, for a node's own front only: its requests carry `internalStamp` (empty elsewhere).
    internalKey: Vector<u8>;
}

/// What replication to other endpoints needs: the endpoints, and the master keys that open SSE-S3 and SSE-KMS
/// versions (their plaintext is what is sent: another endpoint cannot open this server's envelopes).
struct ReplicaContext {
    targets: Vector<ReplicationTarget>;
    /// The key sets as they are reloaded (ADR-0096 §3), shared with the S3 server.
    sseKeys: Arc<KeySets>;
    kmsKeys: Arc<KeySets>;
}

fn targetIdOk(id: Slice<u8>) -> bool {
    if (id.length == 0 || id.length > 64) { return false; }
    for (c in id) {
        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_')) {
            return false;
        }
    }
    return true;
}

/// The targets file; null for a line that is not one, or an id twice. `#` starts a comment line.
fn parseReplicationTargets(text: Slice<u8>) -> Result<Vector<ReplicationTarget>?, AllocError> {
    var out = Vector<ReplicationTarget>.create();
    var at: usize = 0;
    while (at < text.length) {
        let end = pieceEnd(text, at, '\n');
        let raw = trimSpaces(text[at..end]);
        at = end + 1;
        let line = if (raw.length > 0 && raw[raw.length - 1] == '\r') raw[0..raw.length - 1] else raw;
        if (line.length == 0 || line[0] == '#') { continue; }
        var fields = Vector<Vector<u8>>.create();
        var p: usize = 0;
        while (p < line.length) {
            if (line[p] == ' ' || line[p] == '\t') {
                p += 1;
                continue;
            }
            var q = p;
            while (q < line.length && line[q] != ' ' && line[q] != '\t') { q += 1; }
            fields.push(copyBytes(line[p..q])?)?;
            p = q;
        }
        if (fields.length < 4 || fields.length > 5) { return Ok(null); }
        let url = fields[1].view();
        if (!targetIdOk(fields[0].view()) || endpointAuthority(url).isNull()) { return Ok(null); }
        for (i in 0..out.length) {
            if (out[i].id.view() == fields[0].view()) { return Ok(null); }
        }
        var t = ReplicationTarget {
            id: copyBytes(fields[0].view())?,
            url: copyBytes(if (url[url.length - 1] == '/') url[0..url.length - 1] else url)?,
            accessKey: copyBytes(fields[2].view())?,
            secret: copyBytes(fields[3].view())?,
            region: copyBytes(if (fields.length == 5) fields[4].view() else "us-east-1".bytes())?,
            internalKey: Vector<u8>.create(),
        };
        out.push(t)?;
    }
    return Ok(Some(out));
}

fn copyKeys(keys: Slice<MasterKey>) -> Result<Vector<MasterKey>, AllocError> {
    var out = Vector<MasterKey>.create();
    for (i in 0..keys.length) { out.push(MasterKey { id: copyBytes(keys[i].id.view())?, key: keys[i].key })?; }
    return Ok(out);
}

// ---- SigV4 for the requests ----

/// Signs a request (ADR-0008 §5) over every header in `headers` (lower-case names, `host` among them), with an
/// unsigned payload, and adds `authorization`.
fn signRemote(
    t: borrow ReplicationTarget,
    method: Slice<u8>,
    path: Slice<u8>,
    query: Slice<u8>,
    amzDate: Slice<u8>,
    headers: borrow mut Vector<HeaderPair>,
) -> Result<void, AllocError> {
    headers.sortBy((a, b) => compareBytes(a.name.view(), b.name.view()));
    var signed = Vector<u8>.create();
    for (i in 0..headers.length) {
        if (i > 0) { signed.push(';')?; }
        signed.extend(headers[i].name.view())?;
    }
    var canonical = Vector<u8>.create();
    let _ = canonicalRequest(
        method,
        path,
        query,
        headers.view(),
        signed.view(),
        "UNSIGNED-PAYLOAD".bytes(),
        mut canonical,
    )?;
    var scope = Vector<u8>.create();
    scope.extend(amzDate[0..8])?;
    scope.push('/')?;
    scope.extend(t.region.view())?;
    scope.extend("/s3/aws4_request".bytes())?;
    let key = signingKey(t.secret.view(), amzDate[0..8], t.region.view(), "s3".bytes())?;
    var signature = Vector<u8>.create();
    seedSignature(borrow key, amzDate, scope.view(), canonical.view(), mut signature)?;
    var auth = Vector<u8>.create();
    auth.extend("AWS4-HMAC-SHA256 Credential=".bytes())?;
    auth.extend(t.accessKey.view())?;
    auth.push('/')?;
    auth.extend(scope.view())?;
    auth.extend(", SignedHeaders=".bytes())?;
    auth.extend(signed.view())?;
    auth.extend(", Signature=".bytes())?;
    auth.extend(signature.view())?;
    headers.push(HeaderPair { name: copyBytes("authorization".bytes())?, value: auth })?;
    return Ok();
}

fn remotePair(name: Slice<u8>, value: Slice<u8>) -> Result<HeaderPair, AllocError> =>
    Ok(HeaderPair { name: copyBytes(name)?, value: copyBytes(value)? });

/// An answer from the endpoint: its status (0 when it could not be reached), its ETag and its body.
struct RemoteAnswer {
    status: u16;
    etag: Vector<u8>;
    body: Vector<u8>;
}

/// Sends one signed request to the target; `extra` are the headers besides `host`, `x-amz-date` and
/// `x-amz-content-sha256`.
async fn remoteCall(
    client: borrow Client,
    t: borrow ReplicationTarget,
    method: Method,
    path: Slice<u8>,
    query: Slice<u8>,
    extra: Slice<HeaderPair>,
    body: borrow mut dyn BodySource,
) -> Result<RemoteAnswer, AllocError> {
    var answer = RemoteAnswer { status: 0, etag: Vector<u8>.create(), body: Vector<u8>.create() };
    let host = match (endpointAuthority(t.url.view())) {
        Some(h) => h,
        null => { return Ok(answer); }
    };
    var amzDate = Vector<u8>.create();
    appendAmzDate(mut amzDate, Clock.unixMillis())?;
    var headers = Vector<HeaderPair>.create();
    headers.push(remotePair("host".bytes(), host)?)?;
    headers.push(remotePair("x-amz-date".bytes(), amzDate.view())?)?;
    headers.push(remotePair("x-amz-content-sha256".bytes(), "UNSIGNED-PAYLOAD".bytes())?)?;
    for (i in 0..extra.length) { headers.push(remotePair(extra[i].name.view(), extra[i].value.view())?)?; }
    signRemote(t, Methods.text(method).bytes(), path, query, amzDate.view(), mut headers)?;
    var url = copyBytes(t.url.view())?;
    url.extend(path)?;
    if (query.length > 0) {
        url.push('?')?;
        url.extend(query)?;
    }
    var request = match (ClientRequest.create(method, StringView.fromUtf8(url.view()) ?? "")) {
        Ok(r) => r,
        Err(_) => { return Ok(answer); }
    };
    for (i in 0..headers.length) {
        if (headers[i].name.view() == "host".bytes()) { continue; }
        let name = StringView.fromUtf8(headers[i].name.view()) ?? "";
        if (request.header(name, headers[i].value.view()).isErr()) { return Ok(answer); }
    }
    // A node's own front: its stamp, after the signature and outside it, since the front takes it off.
    if (t.internalKey.length > 0) {
        let stamp = internalStamp(t.internalKey.view(), Methods.text(method).bytes(), path, query, amzDate.view())?;
        if (request.header(INTERNAL_FIELD, stamp.view()).isErr()) { return Ok(answer); }
    }
    var options = ClientOptions.defaults();
    options.totalMs = 0;
    options.retry = RetryPolicy.never();
    var response = match (await client.send(request, body)) {
        Ok(r) => r,
        Err(_) => { return Ok(answer); }
    };
    let status = response.status();
    match (response.header("etag")) {
        Some(e) => { answer.etag = e; }
        null => {}
    }
    if ((await response.readToEnd(mut answer.body, 1048576)).isErr()) { return Ok(answer); }
    let _ = await response.finish(client);
    answer.status = status;
    return Ok(answer);
}

// ---- The body ----

/// A replica's plaintext, read from the source version's stored bytes (opened through `SseStream` when sealed), in
/// pieces of `left` bytes: one PUT's, or one part's.
struct ReplicaBody {
    reader: ObjectReader;
    stream: SseStream?;
    stored: Vector<u8>;
    plain: Vector<u8>;
    at: usize;
    left: u64;
    /// The stored bytes ran out early, or did not open.
    broken: bool;
}

fn readStored(reader: borrow mut ObjectReader, buf: borrow mut Vector<u8>) -> Result<usize, StoreError> {
    buf.resize(REMOTE_READ_BYTES, 0)?;
    return reader.read(buf.viewMut());
}

impl BodySource for ReplicaBody {
    @effects()
    fn length(borrow this) -> u64? => Some(this.left);

    async fn read(borrow mut this, into: SliceMut<u8>) -> Result<usize, NetError> {
        if (this.left == 0 || into.length == 0) { return Ok(0); }
        while (this.at == this.plain.length) {
            this.plain.clear();
            this.at = 0;
            // Disk reads: on a worker thread.
            let n = match (await Async.blocking(() => readStored(mut this.reader, mut this.stored))) {
                Ok(n) => n,
                Err(_) => {
                    this.broken = true;
                    return Err(NetError.Closed);
                }
            };
            if (n == 0) {
                this.broken = true;
                return Err(NetError.Closed);
            }
            match (borrow mut this.stream) {
                Some(s) => {
                    match (s.feed(this.stored.view()[0..n], mut this.plain)) {
                        Ok(true) => {}
                        _ => {
                            this.broken = true;
                            return Err(NetError.Closed);
                        }
                    }
                }
                null => {
                    if (this.plain.extend(this.stored.view()[0..n]).isErr()) { return Err(NetError.OutOfMemory); }
                }
            }
        }
        var n = this.plain.length - this.at;
        if (n > into.length) { n = into.length; }
        if (n as u64 > this.left) { n = truncate<usize>(this.left); }
        let dest = borrow mut into[0..n];
        dest.copyFrom(this.plain.view()[this.at..this.at + n]);
        this.at += n;
        this.left -= n as u64;
        return Ok(n);
    }

    @effects()
    fn rewind(borrow mut this) -> bool => false;

    @effects(alloc)
    fn copyTrailers(borrow this, into: borrow mut HeaderBlock) -> Result<void, AllocError> => Ok();
}

// ---- One replication ----

/// What a remote replication came to: done, to be tried again, or refused for good (noted, FAILED).
enum RemoteOutcome {
    Done,
    Again,
    Refused,
}

/// `outcomeOf`, but a 401 or 403 of the cluster's own front is tried again (the M13 exit review's A3): its node may
/// not have this node's key yet, during a rotation, and a refusal would be for good.
fn outcomeFor(t: borrow ReplicationTarget, a: borrow RemoteAnswer) -> RemoteOutcome {
    // AccessDenied is a decision (a policy's, or the requester's, ADR-0094 §4): FAILED. A key or signature the node
    // does not know yet is tried again.
    let denied = findBytes(a.body.view(), "<Code>AccessDenied</Code>".bytes(), 0).isSome();
    if (t.id.view() == "self".bytes() && (a.status == 401 || a.status == 403) && !denied) {
        return RemoteOutcome.Again;
    }
    return outcomeOf(a.status);
}

fn outcomeOf(status: u16) -> RemoteOutcome {
    if (status >= 200 && status < 300) { return RemoteOutcome.Done; }
    if (status == 0 || status >= 500 || status == 429 || status == 408) { return RemoteOutcome.Again; }
    return RemoteOutcome.Refused;
}

/// `/<bucket>/<key>`, the key URI-encoded as SigV4 has it.
fn remotePath(bucket: Slice<u8>, key: Slice<u8>, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    out.push('/')?;
    appendUriEncoded(out, bucket, false)?;
    out.push('/')?;
    return appendUriEncoded(out, key, true);
}

/// The headers a replica's PUT (or its upload's creation) carries: its content type, user metadata and stored
/// headers, `REPLICA`, and SSE-S3 when the source was sealed.
fn replicaHeaders(
    info: borrow ObjectInfo,
    sealed: bool,
    out: borrow mut Vector<HeaderPair>,
) -> Result<void, AllocError> {
    if (info.contentType.length > 0) { out.push(remotePair("content-type".bytes(), info.contentType.view())?)?; }
    match (metadataPairs(info.metadata.view())) {
        Ok(pairs) => {
            for (i in 0..pairs.length) {
                let name = pairs[i].name.view();
                if (startsWithBytes(name, "x-amz-meta-".bytes()) || listed(STORED_HEADERS, name) ||
                    name == STORAGE_CLASS_FIELD.bytes()) {
                    out.push(remotePair(name, pairs[i].value.view())?)?;
                }
            }
        }
        Err(_) => {}
    }
    out.push(remotePair(REPLICA_FIELD.bytes(), "REPLICA".bytes())?)?;
    if (sealed) { out.push(remotePair("x-amz-server-side-encryption".bytes(), "AES256".bytes())?)?; }
    return Ok();
}

fn pushPair(out: borrow mut Vector<HeaderPair>, name: Slice<u8>, value: Slice<u8>) -> bool => match (remotePair(
    name,
    value,
)) {
    Ok(p) => out.push(p).isOk(),
    Err(_) => false,
};

/// A replica PUT's own fields (ADR-0078 §4): the source's version id, MD5, part count, and its extras when they are
/// short enough for a header.
fn fidelityHeaders(v: borrow ObjectInfo, out: borrow mut Vector<HeaderPair>) -> bool {
    var id = Vector<u8>.create();
    var md5 = Vector<u8>.create();
    var parts = Vector<u8>.create();
    var extras = Vector<u8>.create();
    let made = appendVersionId(mut id, v.versionId).isOk() && appendHexBytes(mut md5, v.md5[..]).isOk() &&
        appendDecimal(mut parts, v.parts as u64).isOk() && appendBase64(mut extras, v.extras.view()).isOk();
    if (!made) { return false; }
    if (!pushPair(
        out,
        REPLICA_VERSION_FIELD.bytes(),
        id.view(),
    ) || !pushPair(out, REPLICA_MD5_FIELD.bytes(), md5.view()) ||
        !pushPair(out, REPLICA_PARTS_FIELD.bytes(), parts.view())) {
        return false;
    }
    if (extras.length > 0 && extras.length <= REPLICA_EXTRAS_MOST) {
        return pushPair(out, REPLICA_EXTRAS_FIELD.bytes(), extras.view());
    }
    return true;
}

/// Replicates one event to `<target>:<bucket>` on another endpoint (ADR-0077 §6). True when done or refused for
/// good (then noted, so the version reads FAILED); false to try again later.
async fn replicateRemote(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    ctx: borrow ReplicaContext,
    client: borrow Client,
    e: borrow OutboxEvent,
    destination: Slice<u8>,
) -> Result<bool, NetError> {
    let colon = pieceEnd(destination, 0, ':');
    let targetId = destination[0..colon];
    let bucket = destination[colon + 1..];
    var target: usize? = null;
    for (i in 0..ctx.targets.length) {
        if (ctx.targets[i].id.view() == targetId) { target = Some(i); }
    }
    let src = StringView.fromUtf8(e.bucket.view()) ?? "";
    let key = StringView.fromUtf8(e.key.view()) ?? "";
    let outcome = match (target) {
        Some(i) => await sendRemote(store, ctx, client, borrow ctx.targets[i], e, src, key, bucket, false),
        null => RemoteOutcome.Refused, // a target the file no longer has
    };
    return match (outcome) {
        RemoteOutcome.Done => Ok(true),
        RemoteOutcome.Again => Ok(false),
        RemoteOutcome.Refused => {
            let _ = await AsyncConsole.writeError("cosmostore: a replica was refused by its remote destination: ");
            let _ = await AsyncConsole.writeError(src);
            let _ = await AsyncConsole.writeError("/");
            let _ = await AsyncConsole.writeError(key);
            let _ = await AsyncConsole.writeError("\n");
            var guard = match (await store.get().lock()) {
                Ok(g) => g,
                Err(err) => { return Err(NetErrors.fromAsync(err)); }
            };
            let s = guard.data();
            let id = e.versionId;
            let k = e.key.view();
            let noted = await Async.blocking(() => s.noteReplicationFailure(src, k, id));
            // Not noted (the journal failed): tried again, rather than reported done.
            Ok(noted.isOk())
        }
    };
}

async fn sendRemote(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    ctx: borrow ReplicaContext,
    client: borrow Client,
    t: borrow ReplicationTarget,
    e: borrow OutboxEvent,
    src: StringView,
    key: StringView,
    bucket: Slice<u8>,
    fidelity: bool,
) -> RemoteOutcome {
    var path = Vector<u8>.create();
    if (remotePath(bucket, key.bytes(), mut path).isErr()) { return RemoteOutcome.Again; }
    // Through the cluster's own front, the rule's requester goes with each write, for the destination's shard to
    // decide it as (ADR-0094 §4); another endpoint decides by its own keys.
    // The requester the event recorded (the M14 exit review's A3), not the configuration's now.
    var requester = Vector<u8>.create();
    if (fidelity) {
        let named = match (replicationTarget(bucket)) {
            Ok(n) => n,
            Err(_) => { return RemoteOutcome.Again; }
        };
        if (requester.extend(eventRequester(e, named.view())).isErr()) { return RemoteOutcome.Again; }
    }
    // A delete marker: a DELETE, which makes one there; with fidelity, one with the source marker's id.
    if (e.kind == EVENT_MARKER) {
        var none = NoBody {};
        var extra = Vector<HeaderPair>.create();
        if (requester.length > 0 && !pushPair(mut extra, REPLICA_REQUESTER_FIELD.bytes(), requester.view())) {
            return RemoteOutcome.Again;
        }
        if (fidelity) {
            var id = Vector<u8>.create();
            let added = appendVersionId(mut id, e.versionId).isOk() && pushPair(
                mut extra,
                REPLICA_VERSION_FIELD.bytes(),
                id.view(),
            );
            if (!added) { return RemoteOutcome.Again; }
        }
        return match (await remoteCall(client, t, Method.Delete, path.view(), "".bytes(), extra.view(), mut none)) {
            Ok(a) => outcomeFor(t, borrow a),
            Err(_) => RemoteOutcome.Again,
        };
    }
    let id = e.versionId;
    var info: ObjectInfo? = null;
    var prepared: PreparedReader? = null;
    {
        var guard = match (await store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return RemoteOutcome.Again; }
        };
        let s = guard.data();
        var found = match (s.headObjectOf(src, key, Some(id))) {
            Ok(i) => i,
            Err(_) => { return RemoteOutcome.Done; } // the version is gone
        };
        if (metadataFind(found.metadata.view(), REPLICA_FIELD.bytes()).isSome()) { return RemoteOutcome.Done; }
        // The rule's storage class for its replicas, sent as the replica's (the M12 exit review's B3). The rule names
        // the destination as `<target>:<bucket>`, or the bucket alone for the cluster's own front.
        var ruleDestination = Vector<u8>.create();
        if (t.id.view() != "self".bytes()) {
            if (ruleDestination.extend(t.id.view()).isErr() || ruleDestination.push(':').isErr()) {
                return RemoteOutcome.Again;
            }
        }
        if (ruleDestination.extend(bucket).isErr()) { return RemoteOutcome.Again; }
        let named = match (s.replicaClassOf(src, e.ruleIds.view(), ruleDestination.view())) {
            Ok(c) => c,
            Err(_) => { return RemoteOutcome.Again; }
        };
        if (named.length > 0) {
            found.metadata = match (metadataReplace(found.metadata.view(), STORAGE_CLASS_FIELD.bytes(), named.view())) {
                Ok(b) => b,
                Err(_) => { return RemoteOutcome.Again; }
            };
        }
        prepared = match (s.prepareReaderOf(src, key, Some(id), 0, 0xFFFFFFFFFFFFFFFF)) {
            Ok(p) => Some(p),
            Err(_) => { return RemoteOutcome.Done; }
        };
        info = Some(found);
    }
    let v = match (info) {
        Some(v) => v,
        null => { return RemoteOutcome.Done; }
    };
    var p = match (prepared) {
        Some(p) => p,
        null => { return RemoteOutcome.Done; }
    };
    let extras = match (decodeExtras(v.extras.view())) {
        Ok(x) => x,
        Err(_) => { return RemoteOutcome.Refused; }
    };
    // A sealed version's plaintext; SSE-C's cannot be opened here (ADR-0077 §6).
    var stream: SseStream? = null;
    let envelope = metadataFind(v.metadata.view(), SSE_FIELD.bytes());
    let sealed = envelope.isSome();
    match (envelope) {
        Some(field) => {
            if (isCustomerEnvelope(field)) { return RemoteOutcome.Refused; }
            // An SSE-KMS source is not replicated through the cluster's own front, where a replica keeps its source's
            // version and ETag (fidelity): sealed otherwise there, it could keep neither its encryption nor its ETag
            // (the M13 exit review's A2). It reads FAILED. To another endpoint, its plaintext goes as before, sealed
            // there by that endpoint's own keys (ADR-0077 §6).
            if (fidelity && isKmsEnvelope(field)) {
                let _ = await AsyncConsole.writeError("cosmostore: an SSE-KMS source is not replicated on a cluster\n");
                return RemoteOutcome.Refused;
            }
            let keys = if (isKmsEnvelope(field)) ctx.kmsKeys.get().view() else ctx.sseKeys.get().view();
            var dataKey = match (managedDataKey(keys, field)) {
                Ok(k) => k,
                Err(_) => {
                    // A master key this node has not: on the cluster's own front, perhaps a key file not yet copied
                    // here; tried again rather than FAILED (A3).
                    if (t.id.view() == "self".bytes()) {
                        let _ = await AsyncConsole.writeError(
                            "cosmostore: a sealed source's master key is not in this node's key file; trying again\n",
                        );
                        return RemoteOutcome.Again;
                    }
                    return RemoteOutcome.Refused;
                }
            };
            stream = if (v.parts == 0) SseStream.single(borrow dataKey, v.size, 0) else match (SseStream.multipart(
                borrow dataKey,
                extras.partSizes.view(),
                0,
                "".bytes(),
            )) {
                Ok(s) => s,
                Err(_) => null,
            };
            for (i in 0..32) { dataKey[i] = 0; }
            if (stream.isNull()) { return RemoteOutcome.Refused; }
        }
        null => {}
    }
    let reader = match (await Async.blocking(() => p.open())) {
        Ok(r) => r,
        Err(_) => { return RemoteOutcome.Again; }
    };
    var body = ReplicaBody {
        reader: reader,
        stream: stream,
        stored: Vector<u8>.create(),
        plain: Vector<u8>.create(),
        at: 0,
        left: 0,
        broken: false,
    };
    var headers = Vector<HeaderPair>.create();
    if (replicaHeaders(borrow v, sealed, mut headers).isErr()) { return RemoteOutcome.Again; }
    if (requester.length > 0 && !pushPair(mut headers, REPLICA_REQUESTER_FIELD.bytes(), requester.view())) {
        return RemoteOutcome.Again;
    }
    // With fidelity (a CosmoStore that takes them, ADR-0078 §4): a single PUT's replica is one PUT with the source's
    // id, MD5 and extras; a multipart one is an upload with its parts, completed as the source's id (below).
    let multipart = v.parts > 0 && extras.partSizes.length == v.parts as usize;
    if (fidelity && !multipart) {
        if (!fidelityHeaders(borrow v, mut headers)) { return RemoteOutcome.Again; }
        body.left = v.size;
        return match (await remoteCall(client, t, Method.Put, path.view(), "".bytes(), headers.view(), mut body)) {
            Ok(a) => if (body.broken && a.status < 400) RemoteOutcome.Again else outcomeFor(t, borrow a),
            Err(_) => RemoteOutcome.Again,
        };
    }
    // One PUT, or a multipart upload with the source's parts, so the ETag is the source's.
    if (v.parts == 0 || extras.partSizes.length != v.parts as usize) {
        body.left = v.size;
        return match (await remoteCall(client, t, Method.Put, path.view(), "".bytes(), headers.view(), mut body)) {
            Ok(a) => if (body.broken && a.status < 400) RemoteOutcome.Again else outcomeFor(t, borrow a),
            Err(_) => RemoteOutcome.Again,
        };
    }
    var none = NoBody {};
    let created = match (await remoteCall(
        client,
        t,
        Method.Post,
        path.view(),
        "uploads=".bytes(),
        headers.view(),
        mut none,
    )) {
        Ok(a) => a,
        Err(_) => { return RemoteOutcome.Again; }
    };
    match (outcomeFor(t, borrow created)) {
        RemoteOutcome.Done => {}
        other => { return other; }
    }
    let uploadId = match (elementText(created.body.view(), "UploadId")) {
        Some(u) => match (copyBytes(u)) {
            Ok(c) => c,
            Err(_) => { return RemoteOutcome.Again; }
        },
        null => { return RemoteOutcome.Again; }
    };
    var complete = Vector<u8>.create();
    let begun = complete.extend("<CompleteMultipartUpload>".bytes());
    if (begun.isErr()) { return RemoteOutcome.Again; }
    let noHeaders = Vector<HeaderPair>.create();
    var failure = RemoteOutcome.Done;
    for (i in 0..extras.partSizes.length) {
        body.left = extras.partSizes[i];
        var query = Vector<u8>.create();
        var number = Vector<u8>.create();
        let built = appendDecimal(mut number, i as u64 + 1).isOk() && query.extend("partNumber=".bytes()).isOk() &&
            query.extend(number.view()).isOk() && query.extend("&uploadId=".bytes()).isOk() &&
            appendUriEncoded(mut query, uploadId.view(), false).isOk();
        if (!built) {
            failure = RemoteOutcome.Again;
            break;
        }
        let sent = match (await remoteCall(
            client,
            t,
            Method.Put,
            path.view(),
            query.view(),
            noHeaders.view(),
            mut body,
        )) {
            Ok(a) => a,
            Err(_) => {
                failure = RemoteOutcome.Again;
                break;
            }
        };
        let o = if (body.broken && sent.status < 400) RemoteOutcome.Again else outcomeFor(t, borrow sent);
        match (o) {
            RemoteOutcome.Done => {}
            other => {
                failure = other;
                break;
            }
        }
        let added = complete.extend("<Part><PartNumber>".bytes()).isOk() && complete.extend(number.view()).isOk() &&
            complete.extend("</PartNumber><ETag>".bytes()).isOk() &&
            appendXmlEscaped(mut complete, sent.etag.view()).isOk() &&
            complete.extend("</ETag></Part>".bytes()).isOk();
        if (!added) {
            failure = RemoteOutcome.Again;
            break;
        }
    }
    var query = Vector<u8>.create();
    let built = query.extend("uploadId=".bytes()).isOk() && appendUriEncoded(mut query, uploadId.view(), false).isOk();
    if (!built) { return RemoteOutcome.Again; }
    match (failure) {
        RemoteOutcome.Done => {}
        other => {
            // The upload is abandoned there, so its parts are not left behind.
            var none2 = NoBody {};
            let _ = await remoteCall(client, t, Method.Delete, path.view(), query.view(), noHeaders.view(), mut none2);
            return other;
        }
    }
    if (complete.extend("</CompleteMultipartUpload>".bytes()).isErr()) { return RemoteOutcome.Again; }
    var xml = match (BytesBody.of(complete.view())) {
        Ok(b) => b,
        Err(_) => { return RemoteOutcome.Again; }
    };
    var completeHeaders = Vector<HeaderPair>.create();
    if (requester.length > 0 && !pushPair(mut completeHeaders, REPLICA_REQUESTER_FIELD.bytes(), requester.view())) {
        return RemoteOutcome.Again;
    }
    if (fidelity) {
        var vid = Vector<u8>.create();
        if (appendVersionId(mut vid, v.versionId).isErr() || !pushPair(
            mut completeHeaders,
            REPLICA_VERSION_FIELD.bytes(),
            vid.view(),
        )) {
            return RemoteOutcome.Again;
        }
    }
    let done = match (await remoteCall(
        client,
        t,
        Method.Post,
        path.view(),
        query.view(),
        completeHeaders.view(),
        mut xml,
    )) {
        Ok(a) => a,
        Err(_) => { return RemoteOutcome.Again; }
    };
    // CompleteMultipartUpload may answer 200 with an error in its body: tried again. An error status is what it says:
    // a 4xx refusal is FAILED, not tried for ever (which held the shard's whole delivery behind it; found with M13's
    // exit review).
    if (done.status == 200 && findBytes(
        done.body.view(),
        "<Error>".bytes(),
        0,
    ).isSome()) { return RemoteOutcome.Again; }
    let outcome = outcomeFor(t, borrow done);
    match (outcome) {
        RemoteOutcome.Refused => {
            // A completion refused (by the destination's shard, as the rule's requester): its upload is abandoned
            // there, so its parts are not left in a bucket it may not write (the M14 exit review's A2).
            var none3 = NoBody {};
            let _ = await remoteCall(client, t, Method.Delete, path.view(), query.view(), noHeaders.view(), mut none3);
        }
        _ => {}
    }
    return outcome;
}
