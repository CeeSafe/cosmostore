// S3 Tables (ADR-0083): table buckets, namespaces and tables through the S3 Tables API (REST-JSON, signed for
// `s3tables`). A table bucket is a hidden store bucket, its warehouse; the catalog is JSON records under `.s3tables/`
// in it, and a table's versionToken is its record's generation, so its compare-and-set is a conditional write.
import web_core;
import web_http;
import web_server;

const TABLES_SERVICE: StringView = "s3tables";
const TABLE_BUCKET_SUFFIX: StringView = "--table-s3";
/// The catalog's keys in a table bucket's hidden bucket: none of S3's calls may touch them.
const CATALOG_PREFIX: StringView = ".s3tables/";
const CATALOG_NAMESPACES: StringView = ".s3tables/namespaces/";
const CATALOG_TABLES: StringView = ".s3tables/tables/";
/// A staged create's reservation of its table's id (ADR-0124): the one a later commit may create the table at.
const CATALOG_STAGED: StringView = ".s3tables/staged/";
const TABLES_ACCOUNT: StringView = "000000000000";
/// A request's body at most: S3 Tables' are small, and an Iceberg commit's a few KiB (ADR-0083 §1).
const TABLES_MAX_BODY: usize = 1048576;
/// A commit's requirements and updates at most, each (ADR-0083 §5).
const ICEBERG_MAX_CHANGES: usize = 1000;

/// S3 Tables' errors (REST-JSON: the type in `x-amzn-ErrorType`, a message in the body).
enum TablesError {
    BadRequest,
    Forbidden,
    NotFound,
    Conflict,
    NotImplemented,
    /// A call S3 Tables does not take for this resource (record expiration on a table one makes, ADR-0130 §5).
    MethodNotAllowed,
    Internal,
    @from OutOfMemory(AllocError),
    @from Failed(S3Fail),
}

fn tablesErrorStatus(e: borrow TablesError) -> u16 => match (e) {
    TablesError.BadRequest => 400,
    TablesError.Forbidden => 403,
    TablesError.NotFound => 404,
    TablesError.Conflict => 409,
    TablesError.NotImplemented => 501,
    TablesError.MethodNotAllowed => 405,
    _ => 500,
};

fn tablesErrorName(e: borrow TablesError) -> StringView => match (e) {
    TablesError.BadRequest => "BadRequestException",
    TablesError.Forbidden => "ForbiddenException",
    TablesError.NotFound => "NotFoundException",
    TablesError.Conflict => "ConflictException",
    TablesError.NotImplemented => "NotImplemented",
    TablesError.MethodNotAllowed => "MethodNotAllowedException",
    _ => "InternalServerErrorException",
};

fn tablesErrorMessage(e: borrow TablesError) -> StringView => match (e) {
    TablesError.BadRequest => "The request is invalid.",
    TablesError.Forbidden => "Access denied.",
    TablesError.NotFound => "The specified resource was not found.",
    TablesError.Conflict => "The request conflicts with the resource's current state.",
    TablesError.NotImplemented => "This part of S3 Tables is not implemented.",
    TablesError.MethodNotAllowed => "Record expiration is for AWS managed tables, not tables one makes.",
    _ => "An internal error occurred.",
};

fn tablesStoreFail(e: StoreError) -> TablesError => match (e) {
    StoreError.NoSuchBucket => TablesError.NotFound,
    StoreError.NoSuchKey => TablesError.NotFound,
    StoreError.PreconditionFailed => TablesError.Conflict,
    StoreError.BucketAlreadyExists => TablesError.Conflict,
    StoreError.BucketNotEmpty => TablesError.Conflict,
    _ => TablesError.Internal,
};

/// An answer: its status and JSON body (empty for none).
struct TablesAnswer {
    status: u16;
    body: Vector<u8>;
    /// A dropped table's warehouse to empty after the answer's work (its hidden bucket and table id), or none.
    purgeBucket: Vector<u8>;
    purgeId: Vector<u8>;
}

fn tablesAnswer(status: u16, body: Vector<u8>) -> TablesAnswer => TablesAnswer {
    status: status,
    body: body,
    purgeBucket: Vector<u8>.create(),
    purgeId: Vector<u8>.create(),
};

fn tablesJson(j: borrow Json) -> Result<TablesAnswer, TablesError> {
    var body = Vector<u8>.create();
    writeJson(mut body, j)?;
    return Ok(tablesAnswer(200, body));
}

fn tablesNoContent() -> TablesAnswer => tablesAnswer(204, Vector<u8>.create());

// ---- Names ----

/// Whether a request is signed for S3 Tables (ADR-0083 §1).
fn signedForTables(req: borrow S3Request) -> bool => match (scopeField(req, 3)) {
    Some(s) => s == TABLES_SERVICE.bytes(),
    null => false,
};

fn isTableWarehouseShaped(name: Slice<u8>) -> bool {
    let suffix = TABLE_BUCKET_SUFFIX.bytes();
    return name.length > suffix.length && name[name.length - suffix.length..] == suffix;
}

/// Whether `key` of `bucket` is a table bucket's catalog record, which only S3 Tables' own calls read or write.
fn catalogObject(bucket: Slice<u8>, key: Slice<u8>) -> bool =>
    isTableWarehouseShaped(bucket) && startsWithBytes(key, CATALOG_PREFIX.bytes());

/// A table bucket's name: 3 to 63 of a-z, 0-9 and `-`, beginning and ending with a letter or digit, without S3's
/// reserved prefixes and suffixes.
fn tableBucketNameOk(name: Slice<u8>) -> bool {
    if (name.length < 3 || name.length > 63 || name[0] == '-' || name[name.length - 1] == '-') { return false; }
    for (c in name) {
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-')) { return false; }
    }
    for (p in ["xn--", "sthree-", "amzn-s3-demo-", "aws"]) {
        if (startsWithBytes(name, p.bytes())) { return false; }
    }
    for (s in ["-s3alias", "--ol-s3", "--x-s3", "--table-s3"]) {
        let b = s.bytes();
        if (name.length >= b.length && name[name.length - b.length..] == b) { return false; }
    }
    return true;
}

/// A namespace's or table's name: 1 to 255 of a-z, 0-9 and `_`, beginning with a letter or digit; a namespace not
/// beginning `aws`.
fn tableNameOk(name: Slice<u8>, isNamespace: bool) -> bool {
    if (name.length < 1 || name.length > 255 || name[0] == '_') { return false; }
    for (c in name) {
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_')) { return false; }
    }
    return !(isNamespace && startsWithBytes(name, "aws".bytes()));
}

/// The hidden store bucket of table bucket `name`: `<name>--table-s3`, its warehouse (ADR-0083 §2). Its name and
/// creation time are the table bucket's, so the table bucket needs no record of its own: one write makes it, which a
/// cluster's shard commits as one (ADR-0083 §7).
fn tableWarehouseBucket(name: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var out = copyBytes(name)?;
    out.extend(TABLE_BUCKET_SUFFIX.bytes())?;
    return Ok(out);
}

/// A table bucket's id: a UUID's form of a hash of its name and creation time, the same on every read.
fn tableBucketId(name: Slice<u8>, createdMs: i64, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    var input = Vector<u8>.create();
    input.extend("cosmostore table bucket ".bytes())?;
    input.extend(name)?;
    input.pushLE(createdMs)?;
    var b = Sha256.of(input.view());
    b[6] = (b[6] & 0x0F) | 0x40;
    b[8] = (b[8] & 0x3F) | 0x80;
    appendHexBytes(out, b[0..4])?;
    out.push('-')?;
    appendHexBytes(out, b[4..6])?;
    out.push('-')?;
    appendHexBytes(out, b[6..8])?;
    out.push('-')?;
    appendHexBytes(out, b[8..10])?;
    out.push('-')?;
    return appendHexBytes(out, b[10..16]);
}

/// A table bucket as its records' readers want it: `{"name","id","createdAt"}`.
fn tableBucketJson(name: Slice<u8>, createdMs: i64) -> Result<Json, AllocError> {
    var id = Vector<u8>.create();
    tableBucketId(name, createdMs, mut id)?;
    var j = jsonObject();
    jsonSet(mut j, "name", jsonString(name)?)?;
    jsonSet(mut j, "id", Json.Text(id))?;
    jsonSet(mut j, "createdAt", jsonInteger(createdMs)?)?;
    return Ok(j);
}

fn tablesRegion(req: borrow S3Request) -> Slice<u8> => scopeField(req, 2) ?? "us-east-1".bytes();

fn tableBucketArn(req: borrow S3Request, name: Slice<u8>, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    out.extend("arn:aws:s3tables:".bytes())?;
    out.extend(tablesRegion(req))?;
    out.push(':')?;
    out.extend(TABLES_ACCOUNT.bytes())?;
    out.extend(":bucket/".bytes())?;
    return out.extend(name);
}

/// The table bucket a table bucket's ARN names (`arn:aws:s3tables:<region>:<account>:bucket/<name>`), and the table
/// id after `/table/` in a table's ARN; null if it is neither.
fn tableBucketOfArn(arn: Slice<u8>, tableId: borrow mut Vector<u8>) -> Result<Vector<u8>?, AllocError> {
    let head = "arn:aws:s3tables:".bytes();
    if (!startsWithBytes(arn, head)) { return Ok(null); }
    let marker = match (findBytes(arn, ":bucket/".bytes(), head.length)) {
        Some(m) => m,
        null => { return Ok(null); }
    };
    let rest = arn[marker + 8..];
    let slash = pieceEnd(rest, 0, '/');
    let name = rest[0..slash];
    if (slash < rest.length) {
        let tail = rest[slash..];
        let table = "/table/".bytes();
        if (!startsWithBytes(tail, table) || tail.length == table.length) { return Ok(null); }
        tableId.extend(tail[table.length..])?;
    }
    if (!tableBucketNameOk(name)) { return Ok(null); }
    return Ok(Some(copyBytes(name)?));
}

/// Whether `id` has a UUID's form (8-4-4-4-12 lowercase hex): what a table's id is, so its warehouse prefix
/// `<id>/` is no other table's and not the catalog's.
fn uuidShaped(id: Slice<u8>) -> bool {
    if (id.length != 36) { return false; }
    for (i in 0..id.length) {
        let c = id[i];
        let dash = i == 8 || i == 13 || i == 18 || i == 23;
        if (dash != (c == '-')) { return false; }
        if (!dash && !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { return false; }
    }
    return true;
}

fn newUuid(out: borrow mut Vector<u8>) -> Result<bool, AllocError> {
    var b = [0u8; 16];
    if (Random.fill(mut b[..]).isErr()) { return Ok(false); }
    b[6] = (b[6] & 0x0F) | 0x40;
    b[8] = (b[8] & 0x3F) | 0x80;
    appendHexBytes(out, b[0..4])?;
    out.push('-')?;
    appendHexBytes(out, b[4..6])?;
    out.push('-')?;
    appendHexBytes(out, b[6..8])?;
    out.push('-')?;
    appendHexBytes(out, b[8..10])?;
    out.push('-')?;
    appendHexBytes(out, b[10..16])?;
    return Ok(true);
}

fn isoText(millis: i64) -> Result<Json, AllocError> {
    var t = Vector<u8>.create();
    appendIso8601(mut t, millis)?;
    return Ok(Json.Text(t));
}

fn versionTokenOf(generation: u64) -> Result<Vector<u8>, AllocError> {
    var t = Vector<u8>.create();
    appendDecimal(mut t, generation)?;
    return Ok(t);
}

fn catalogKey(head: StringView, a: Slice<u8>, b: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var k = copyBytes(head.bytes())?;
    k.extend(a)?;
    if (b.length > 0) {
        k.push('/')?;
        k.extend(b)?;
    }
    return Ok(k);
}

// ---- The store ----

/// A catalog record, and its generation (the versionToken of a table's).
struct CatalogRecord {
    json: Json;
    generation: u64;
}

fn catalogText(b: Slice<u8>) -> StringView => StringView.fromUtf8(b) ?? "";

/// Reads a record under the store; null if there is none.
fn readRecord(store: borrow ObjectStore, bucket: Slice<u8>, key: Slice<u8>) -> Result<CatalogRecord?, TablesError> {
    let info = match (store.headObject(catalogText(bucket), catalogText(key))) {
        Ok(i) => i,
        Err(StoreError.NoSuchKey) => { return Ok(null); }
        Err(StoreError.NoSuchBucket) => { return Ok(null); }
        Err(e) => { return Err(tablesStoreFail(e)); }
    };
    let bytes = match (store.getObject(catalogText(bucket), catalogText(key))) {
        Ok(b) => b,
        Err(e) => { return Err(tablesStoreFail(e)); }
    };
    let json = match (parseJson(bytes.view())?) {
        Some(j) => j,
        null => { return Err(TablesError.Internal); }
    };
    return Ok(Some(CatalogRecord { json: json, generation: info.generation }));
}

fn writeRecord(
    store: borrow mut ObjectStore,
    bucket: Slice<u8>,
    key: Slice<u8>,
    j: borrow Json,
    condition: PutCondition,
) -> Result<u64, TablesError> {
    var body = Vector<u8>.create();
    writeJson(mut body, j)?;
    return match (store.putObject(catalogText(bucket), catalogText(key), "application/json", body.view(), condition)) {
        Ok(o) => Ok(o.generation),
        Err(e) => Err(tablesStoreFail(e)),
    };
}

/// The keys under `prefix` after `after`, at most `max` (0: all).
fn catalogKeys(
    store: borrow ObjectStore,
    bucket: Slice<u8>,
    prefix: Slice<u8>,
    after: Slice<u8>,
    max: usize,
) -> Result<Vector<Vector<u8>>, TablesError> {
    var out = Vector<Vector<u8>>.create();
    var marker = copyBytes(after)?;
    while (true) {
        let page = match (store.listObjects(catalogText(bucket), catalogText(prefix), "", marker.view(), false, 1000)) {
            Ok(p) => p,
            Err(e) => { return Err(tablesStoreFail(e)); }
        };
        for (i in 0..page.keys.length) {
            out.push(copyBytes(page.keys[i].view())?)?;
            if (max > 0 && out.length >= max) { return Ok(out); }
        }
        if (!page.truncated || page.keys.length == 0) { break; }
        marker = copyBytes(page.keys[page.keys.length - 1].view())?;
    }
    return Ok(out);
}

/// A table bucket that exists, as `tableBucketJson`; NotFound otherwise.
fn tableBucketRecord(store: borrow ObjectStore, name: Slice<u8>) -> Result<CatalogRecord, TablesError> {
    let hidden = tableWarehouseBucket(name)?;
    return match (store.bucketCreatedMillis(catalogText(hidden.view()))) {
        Ok(ms) => Ok(CatalogRecord { json: tableBucketJson(name, ms)?, generation: 0 }),
        Err(StoreError.NoSuchBucket) => Err(TablesError.NotFound),
        Err(e) => Err(tablesStoreFail(e)),
    };
}

// ---- Requests ----

/// The path's segments, each URL-decoded (a table bucket's ARN is one segment, its `/` encoded).
fn pathSegments(path: Slice<u8>) -> Result<Vector<Vector<u8>>, TablesError> {
    var out = Vector<Vector<u8>>.create();
    var at: usize = if (path.length > 0 && path[0] == '/') 1 else 0;
    while (at <= path.length) {
        let end = pieceEnd(path, at, '/');
        var s = Vector<u8>.create();
        if (!percentDecodeInto(mut s, path[at..end], false)?) { return Err(TablesError.BadRequest); }
        out.push(s)?;
        at = end + 1;
        if (end == path.length) { break; }
    }
    if (out.length > 0 && out[out.length - 1].length == 0) { let _ = out.pop(); }
    return Ok(out);
}

/// `maxBuckets` and the like: 1 to 1,000, else BadRequest; 1,000 when absent.
fn pageSize(req: borrow S3Request, name: StringView) -> Result<usize, TablesError> {
    return match (paramOf(req, name)) {
        Some(t) => match (parseDecimal(t)) {
            Some(v) => if (v >= 1 && v <= 1000) Ok(v as usize) else Err(TablesError.BadRequest),
            null => Err(TablesError.BadRequest),
        },
        null => Ok(1000),
    };
}

fn continuationOf(req: borrow S3Request) -> Result<Vector<u8>, TablesError> {
    var after = Vector<u8>.create();
    match (paramOf(req, "continuationToken")) {
        Some(t) => {
            if (t.length > 2048 || !decodeBase64(t, mut after)?) { return Err(TablesError.BadRequest); }
        }
        null => {}
    }
    return Ok(after);
}

fn setToken(j: borrow mut Json, last: Slice<u8>) -> Result<void, AllocError> {
    var token = Vector<u8>.create();
    appendBase64(mut token, last)?;
    return jsonSet(j, "continuationToken", Json.Text(token));
}

/// A body's JSON object; BadRequest if it is not one.
fn tablesObject(body: Slice<u8>) -> Result<Json, TablesError> {
    let j = match (parseJson(if (body.length == 0) "{}".bytes() else body)?) {
        Some(j) => j,
        null => { return Err(TablesError.BadRequest); }
    };
    match (borrow j) {
        Json.Object(_) => {}
        _ => { return Err(TablesError.BadRequest); }
    }
    return Ok(j);
}

/// `tablesObject`, where a field S3 Tables has that this does not do is NotImplemented, not ignored.
fn tablesBody(body: Slice<u8>, refused: Slice<StringView>) -> Result<Json, TablesError> {
    let j = tablesObject(body)?;
    for (f in refused) {
        if (jsonMember(borrow j, f).isSome()) { return Err(TablesError.NotImplemented); }
    }
    return Ok(j);
}

/// `["name"]`: a namespace as S3 Tables gives it, one level only.
fn singleNamespace(j: borrow Json) -> Result<Vector<u8>, TablesError> {
    return match (jsonMember(j, "namespace")) {
        Some(v) => match (v) {
            Json.Array(items) => {
                if (items.length != 1) { return Err(TablesError.BadRequest); }
                match (borrow items[0]) {
                    Json.Text(t) => Ok(copyBytes(t.view())?),
                    _ => Err(TablesError.BadRequest),
                }
            },
            _ => Err(TablesError.BadRequest),
        },
        null => Err(TablesError.BadRequest),
    };
}

fn namespaceArray(name: Slice<u8>) -> Result<Json, AllocError> {
    var a = jsonArray();
    jsonPush(mut a, Json.Text(copyBytes(name)?))?;
    return Ok(a);
}

// ---- Table buckets ----

fn bucketView(req: borrow S3Request, rec: borrow Json) -> Result<Json, TablesError> {
    let name = jsonMemberText(rec, "name") ?? "".bytes();
    var j = jsonObject();
    var arn = Vector<u8>.create();
    tableBucketArn(req, name, mut arn)?;
    jsonSet(mut j, "arn", Json.Text(arn))?;
    jsonSet(mut j, "createdAt", isoText(jsonMemberI64(rec, "createdAt") ?? 0)?)?;
    jsonSet(mut j, "name", jsonString(name)?)?;
    jsonSet(mut j, "ownerAccountId", jsonString(TABLES_ACCOUNT.bytes())?)?;
    jsonSet(mut j, "tableBucketId", jsonString(jsonMemberText(rec, "id") ?? "".bytes())?)?;
    jsonSet(mut j, "type", jsonString("customer".bytes())?)?;
    return Ok(j);
}

fn createTableBucket(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    body: Slice<u8>,
    sealing: borrow WarehouseKeys,
) -> Result<TablesAnswer, TablesError> {
    let j = tablesObject(body)?;
    let name = copyBytes(jsonMemberText(borrow j, "name") ?? "".bytes())?;
    if (!tableBucketNameOk(name.view())) { return Err(TablesError.BadRequest); }
    // Its tags, storage class and encryption (ADR-0126 §1 to §3), checked before it is made.
    var config = createdConfigOf(borrow j, "STANDARD".bytes())?;
    match (createdEncryptionOf(borrow j, null, sealing)?) {
        Some(e) => { jsonSet(mut config, "encryption", e)?; }
        null => {}
    }
    let hidden = tableWarehouseBucket(name.view())?;
    // Defaults need no record (one absent reads as them). Others are written into the bucket just made, on a cluster
    // shard too, whose writes take a bucket its request made (ADR-0128 §1, §2).
    let configured = !isDefaultConfig(borrow config);
    match (store.createBucket(catalogText(hidden.view()))) {
        Ok() => {}
        Err(e) => { return Err(tablesStoreFail(e)); }
    }
    if (configured) { writeTablesConfig(store, hidden.view(), TABLE_BUCKET_CONFIG_KEY.bytes(), borrow config)?; }
    var answer = jsonObject();
    var arn = Vector<u8>.create();
    tableBucketArn(req, name.view(), mut arn)?;
    jsonSet(mut answer, "arn", Json.Text(arn))?;
    return tablesJson(borrow answer);
}

fn getTableBucket(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    name: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let rec = tableBucketRecord(store, name)?;
    let view = bucketView(req, borrow rec.json)?;
    return tablesJson(borrow view);
}

fn listTableBuckets(store: borrow mut ObjectStore, req: borrow S3Request) -> Result<TablesAnswer, TablesError> {
    let max = pageSize(req, "maxBuckets")?;
    let after = continuationOf(req)?;
    let prefix = paramOf(req, "prefix") ?? "".bytes();
    let onlyAws = match (paramOf(req, "type")) {
        Some(t) => {
            if (t != "customer".bytes() && t != "aws".bytes()) { return Err(TablesError.BadRequest); }
            t == "aws".bytes()
        }
        null => false,
    };
    var records = Vector<Json>.create();
    if (!onlyAws) {
        let all = match (store.listBucketInfo()) {
            Ok(a) => a,
            Err(e) => { return Err(tablesStoreFail(e)); }
        };
        for (i in 0..all.length) {
            let hidden = all[i].name.view();
            if (!isTableWarehouseShaped(hidden)) { continue; }
            let name = hidden[0..hidden.length - TABLE_BUCKET_SUFFIX.bytes().length];
            if (!startsWithBytes(name, prefix)) { continue; }
            if (after.length > 0 && compareBytes(name, after.view()) <= 0) { continue; }
            records.push(tableBucketJson(name, all[i].createdMillis)?)?;
        }
    }
    records.sortBy(
        (a, b) => compareBytes(jsonMemberText(a, "name") ?? "".bytes(), jsonMemberText(b, "name") ?? "".bytes()),
    );
    var list = jsonArray();
    let shown = if (records.length > max) max else records.length;
    for (i in 0..shown) { jsonPush(mut list, bucketView(req, borrow records[i])?)?; }
    var answer = jsonObject();
    jsonSet(mut answer, "tableBuckets", list)?;
    if (shown < records.length) {
        setToken(mut answer, jsonMemberText(borrow records[shown - 1], "name") ?? "".bytes())?;
    }
    return tablesJson(borrow answer);
}

fn deleteTableBucket(store: borrow mut ObjectStore, name: Slice<u8>) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(name)?;
    let _ = tableBucketRecord(store, name)?;
    // A table bucket with namespaces is not deleted (AWS: delete its tables and namespaces first).
    if (catalogKeys(store, hidden.view(), CATALOG_NAMESPACES.bytes(), "".bytes(), 1)?.length > 0) {
        return Err(TablesError.Conflict);
    }
    // What is left: objects of tables dropped. On a cluster their deletes commit with this request's, so the bucket
    // is still not empty here: ConflictException, and a retry deletes it.
    let rest = catalogKeys(store, hidden.view(), "".bytes(), "".bytes(), 1000)?;
    if (rest.length > 0) {
        match (store.deleteObjects(catalogText(hidden.view()), rest.view())) {
            Ok(_) => {}
            Err(e) => { return Err(tablesStoreFail(e)); }
        }
    }
    match (store.deleteBucket(catalogText(hidden.view()))) {
        Ok() => {}
        Err(e) => { return Err(tablesStoreFail(e)); }
    }
    return Ok(tablesNoContent());
}

// ---- Namespaces ----

fn namespaceView(
    req: borrow S3Request,
    name: Slice<u8>,
    bucketRec: borrow Json,
    rec: borrow Json,
) -> Result<Json, TablesError> {
    var j = jsonObject();
    jsonSet(mut j, "createdAt", isoText(jsonMemberI64(rec, "createdAt") ?? 0)?)?;
    jsonSet(mut j, "createdBy", jsonString(TABLES_ACCOUNT.bytes())?)?;
    jsonSet(mut j, "namespace", namespaceArray(name)?)?;
    jsonSet(mut j, "namespaceId", jsonString(jsonMemberText(rec, "id") ?? "".bytes())?)?;
    jsonSet(mut j, "ownerAccountId", jsonString(TABLES_ACCOUNT.bytes())?)?;
    jsonSet(mut j, "tableBucketId", jsonString(jsonMemberText(bucketRec, "id") ?? "".bytes())?)?;
    let _ = req;
    return Ok(j);
}

fn createNamespace(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    bucketName: Slice<u8>,
    body: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let j = tablesObject(body)?;
    let ns = singleNamespace(borrow j)?;
    if (!tableNameOk(ns.view(), true)) { return Err(TablesError.BadRequest); }
    let hidden = tableWarehouseBucket(bucketName)?;
    var id = Vector<u8>.create();
    if (!newUuid(mut id)?) { return Err(TablesError.Internal); }
    var rec = jsonObject();
    jsonSet(mut rec, "id", Json.Text(id))?;
    jsonSet(mut rec, "createdAt", jsonInteger(Clock.unixMillis())?)?;
    {
        let _ = tableBucketRecord(store, bucketName)?;
        let key = catalogKey(CATALOG_NAMESPACES, ns.view(), "".bytes())?;
        let hiddenView = hidden.view();
        let keyView = key.view();
        let recRef = borrow rec;
        let _ = (writeRecord(store, hiddenView, keyView, recRef, PutCondition.IfAbsent))?;
    }
    var answer = jsonObject();
    jsonSet(mut answer, "namespace", namespaceArray(ns.view())?)?;
    var arn = Vector<u8>.create();
    tableBucketArn(req, bucketName, mut arn)?;
    jsonSet(mut answer, "tableBucketARN", Json.Text(arn))?;
    return tablesJson(borrow answer);
}

fn getNamespace(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    bucketName: Slice<u8>,
    ns: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(bucketName)?;
    let bucketRec = tableBucketRecord(store, bucketName)?;
    let key = catalogKey(CATALOG_NAMESPACES, ns, "".bytes())?;
    let rec = match (readRecord(store, hidden.view(), key.view())?) {
        Some(r) => r,
        null => { return Err(TablesError.NotFound); }
    };
    let view = namespaceView(req, ns, borrow bucketRec.json, borrow rec.json)?;
    return tablesJson(borrow view);
}

fn listNamespaces(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    bucketName: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let max = pageSize(req, "maxNamespaces")?;
    let after = continuationOf(req)?;
    let prefix = paramOf(req, "prefix") ?? "".bytes();
    let hidden = tableWarehouseBucket(bucketName)?;
    let bucketRec = tableBucketRecord(store, bucketName)?;
    let base = catalogKey(CATALOG_NAMESPACES, prefix, "".bytes())?;
    let start = if (after.length > 0) catalogKey(
        CATALOG_NAMESPACES,
        after.view(),
        "".bytes(),
    )? else Vector<u8>.create();
    let keys = catalogKeys(store, hidden.view(), base.view(), start.view(), max + 1)?;
    var list = jsonArray();
    let shown = if (keys.length > max) max else keys.length;
    let head = CATALOG_NAMESPACES.bytes().length;
    for (i in 0..shown) {
        let ns = keys[i].view()[head..];
        // One level, as AWS's (ADR-0134 §1, the owner's choice): a nested namespace is the Iceberg catalog's.
        if (findBytes(ns, [0x1Fu8][..], 0).isSome()) { continue; }
        match (readRecord(store, hidden.view(), keys[i].view())?) {
            Some(r) => { jsonPush(mut list, namespaceView(req, ns, borrow bucketRec.json, borrow r.json)?)?; }
            null => {}
        }
    }
    var answer = jsonObject();
    jsonSet(mut answer, "namespaces", list)?;
    if (shown < keys.length) { setToken(mut answer, keys[shown - 1].view()[head..])?; }
    return tablesJson(borrow answer);
}

fn deleteNamespace(
    store: borrow mut ObjectStore,
    bucketName: Slice<u8>,
    ns: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(bucketName)?;
    let _ = tableBucketRecord(store, bucketName)?;
    let key = catalogKey(CATALOG_NAMESPACES, ns, "".bytes())?;
    if (readRecord(store, hidden.view(), key.view())?.isNull()) { return Err(TablesError.NotFound); }
    let tables = catalogKey(CATALOG_TABLES, ns, "".bytes())?;
    var under = copyBytes(tables.view())?;
    under.push('/')?;
    if (catalogKeys(
        store,
        hidden.view(),
        under.view(),
        "".bytes(),
        1,
    )?.length > 0) { return Err(TablesError.Conflict); }
    // Nor one with views (ADR-0134 §2), or with namespaces nested in it (§1).
    if (namespaceHasViews(store, hidden.view(), ns)?) { return Err(TablesError.Conflict); }
    var children = copyBytes(key.view())?;
    children.push(0x1F)?;
    if (catalogKeys(store, hidden.view(), children.view(), "".bytes(), 1)?.length > 0) {
        return Err(TablesError.Conflict);
    }
    let bucket = catalogText(hidden.view());
    let k = catalogText(key.view());
    match ((store.deleteObject(bucket, k))) {
        Ok() => {}
        Err(e) => { return Err(tablesStoreFail(e)); }
    }
    return Ok(tablesNoContent());
}

// ---- Tables ----

fn tableArn(
    req: borrow S3Request,
    bucketName: Slice<u8>,
    id: Slice<u8>,
    out: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    tableBucketArn(req, bucketName, out)?;
    out.extend("/table/".bytes())?;
    return out.extend(id);
}

fn warehouseOf(bucketName: Slice<u8>, id: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var w = copyBytes("s3://".bytes())?;
    w.extend(tableWarehouseBucket(bucketName)?.view())?;
    w.push('/')?;
    w.extend(id)?;
    return Ok(w);
}

/// A table that exists: its record; NotFound if its bucket, namespace or record is not there.
fn tableRecord(
    store: borrow ObjectStore,
    bucketName: Slice<u8>,
    ns: Slice<u8>,
    name: Slice<u8>,
) -> Result<CatalogRecord, TablesError> {
    let _ = tableBucketRecord(store, bucketName)?;
    let hidden = tableWarehouseBucket(bucketName)?;
    let key = catalogKey(CATALOG_TABLES, ns, name)?;
    return match (readRecord(store, hidden.view(), key.view())?) {
        Some(r) => Ok(r),
        null => Err(TablesError.NotFound),
    };
}

/// A namespace's id, from its record; empty if it has none.
fn namespaceIdOf(store: borrow ObjectStore, hidden: Slice<u8>, ns: Slice<u8>) -> Result<Vector<u8>, TablesError> {
    let key = catalogKey(CATALOG_NAMESPACES, ns, "".bytes())?;
    return match (readRecord(store, hidden, key.view())?) {
        Some(r) => Ok(copyBytes(jsonMemberText(borrow r.json, "id") ?? "".bytes())?),
        null => Ok(Vector<u8>.create()),
    };
}

fn tableView(
    req: borrow S3Request,
    bucketName: Slice<u8>,
    bucketRec: borrow Json,
    ns: Slice<u8>,
    nsId: Slice<u8>,
    name: Slice<u8>,
    rec: borrow CatalogRecord,
    full: bool,
) -> Result<Json, TablesError> {
    let id = jsonMemberText(borrow rec.json, "id") ?? "".bytes();
    var j = jsonObject();
    jsonSet(mut j, "createdAt", isoText(jsonMemberI64(borrow rec.json, "createdAt") ?? 0)?)?;
    jsonSet(mut j, "modifiedAt", isoText(jsonMemberI64(borrow rec.json, "modifiedAt") ?? 0)?)?;
    jsonSet(mut j, "name", jsonString(name)?)?;
    jsonSet(mut j, "namespace", namespaceArray(ns)?)?;
    if (nsId.length > 0) { jsonSet(mut j, "namespaceId", jsonString(nsId)?)?; }
    var arn = Vector<u8>.create();
    tableArn(req, bucketName, id, mut arn)?;
    jsonSet(mut j, "tableARN", Json.Text(arn))?;
    jsonSet(mut j, "type", jsonString("customer".bytes())?)?;
    jsonSet(mut j, "tableBucketId", jsonString(jsonMemberText(bucketRec, "id") ?? "".bytes())?)?;
    if (full) {
        jsonSet(mut j, "createdBy", jsonString(TABLES_ACCOUNT.bytes())?)?;
        jsonSet(mut j, "modifiedBy", jsonString(TABLES_ACCOUNT.bytes())?)?;
        jsonSet(mut j, "ownerAccountId", jsonString(TABLES_ACCOUNT.bytes())?)?;
        jsonSet(mut j, "format", jsonString("ICEBERG".bytes())?)?;
        jsonSet(mut j, "versionToken", Json.Text(versionTokenOf(rec.generation)?))?;
        jsonSet(mut j, "warehouseLocation", Json.Text(warehouseOf(bucketName, id)?))?;
        match (jsonMemberText(borrow rec.json, "metadataLocation")) {
            Some(m) => { jsonSet(mut j, "metadataLocation", jsonString(m)?)?; }
            null => {}
        }
    }
    return Ok(j);
}

fn createTable(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    bucketName: Slice<u8>,
    ns: Slice<u8>,
    body: Slice<u8>,
    sealing: borrow WarehouseKeys,
) -> Result<TablesAnswer, TablesError> {
    // An Iceberg schema given here becomes the table's first metadata file (ADR-0083 §6).
    let j = tablesObject(body)?;
    let name = copyBytes(jsonMemberText(borrow j, "name") ?? "".bytes())?;
    if (!tableNameOk(name.view(), false)) { return Err(TablesError.BadRequest); }
    if (jsonMemberText(borrow j, "format") != Some("ICEBERG".bytes())) { return Err(TablesError.BadRequest); }
    // Its tags, storage class and encryption (ADR-0126 §1 to §3): the bucket's class and encryption when it gives
    // none; its encryption never changed after.
    let warehouseBucket = tableWarehouseBucket(bucketName)?;
    var config = createdConfigOf(borrow j, bucketStorageClass(store, warehouseBucket.view())?.view())?;
    let inherited = bucketEncryption(store, warehouseBucket.view())?;
    match (createdEncryptionOf(borrow j, inherited.asBorrow(), sealing)?) {
        Some(e) => { jsonSet(mut config, "encryption", e)?; }
        null => {}
    }
    let hidden = tableWarehouseBucket(bucketName)?;
    var id = Vector<u8>.create();
    if (!newUuid(mut id)?) { return Err(TablesError.Internal); }
    let now = Clock.unixMillis();
    var rec = jsonObject();
    jsonSet(mut rec, "id", jsonString(id.view())?)?;
    jsonSet(mut rec, "createdAt", jsonInteger(now)?)?;
    jsonSet(mut rec, "modifiedAt", jsonInteger(now)?)?;
    let request: Json? = match (jsonMember(borrow j, "metadata")) {
        Some(md) => Some(createRequestOfMetadata(md)?),
        null => null,
    };
    var generation: u64 = 0;
    {
        let _ = tableBucketRecord(store, bucketName)?;
        let nsKey = catalogKey(CATALOG_NAMESPACES, ns, "".bytes())?;
        if (readRecord(store, hidden.view(), nsKey.view())?.isNull()) { return Err(TablesError.NotFound); }
        let key = catalogKey(CATALOG_TABLES, ns, name.view())?;
        if (readRecord(store, hidden.view(), key.view())?.isSome() || viewExists(
            store,
            hidden.view(),
            ns,
            name.view(),
        )?) {
            return Err(TablesError.Conflict);
        }
        // Its metadata made before anything is written, so that a request refused leaves nothing (ADR-0132, M30's
        // B2); then its configuration, at its new id, with its name (M30's B7), and its metadata sealed with its
        // encryption (ADR-0126 §4).
        let warehouse = warehouseOf(bucketName, id.view())?;
        let made: Json? = match (borrow request) {
            Some(r) => match (newTableMetadata(r, warehouse.view())?) {
                Some(m) => Some(m),
                null => { return Err(TablesError.BadRequest); }
            },
            null => null,
        };
        jsonSet(mut config, "namespace", jsonString(ns)?)?;
        jsonSet(mut config, "name", jsonString(name.view())?)?;
        let configKey = tableConfigKey(id.view())?;
        writeTablesConfig(store, hidden.view(), configKey.view(), borrow config)?;
        match (made.asBorrow()) {
            Some(m) => {
                // Sealed with the encryption just given to its configuration, not read back (a shard's write is not
                // seen in its own request, ADR-0058).
                let encryption: Json? = match (jsonMember(borrow config, "encryption")) {
                    Some(e) => Some(cloneJson(e)?),
                    null => null,
                };
                let location = match (writeMetadataSealedBy(
                    store,
                    hidden.view(),
                    id.view(),
                    0,
                    m,
                    sealing,
                    encryption.asBorrow(),
                )) {
                    Ok(l) => l,
                    Err(e) => {
                        let _ = store.deleteObject(catalogText(hidden.view()), catalogText(configKey.view()));
                        return Err(e);
                    }
                };
                jsonSet(mut rec, "metadataLocation", Json.Text(location))?;
            }
            null => {}
        }
        let hiddenView = hidden.view();
        let keyView = key.view();
        let recRef = borrow rec;
        generation = match (writeRecord(store, hiddenView, keyView, recRef, PutCondition.IfAbsent)) {
            Ok(g) => g,
            Err(e) => {
                // Another create won the name: its first metadata file and its configuration are no table's.
                removeMetadataFile(store, hiddenView, jsonMemberText(recRef, "metadataLocation") ?? "".bytes());
                let _ = store.deleteObject(catalogText(hiddenView), catalogText(configKey.view()));
                return Err(e);
            }
        };
    }
    var answer = jsonObject();
    var arn = Vector<u8>.create();
    tableArn(req, bucketName, id.view(), mut arn)?;
    jsonSet(mut answer, "tableARN", Json.Text(arn))?;
    jsonSet(mut answer, "versionToken", Json.Text(versionTokenOf(generation)?))?;
    return tablesJson(borrow answer);
}

/// GetTable (`/get-table`): by the bucket's ARN, namespace and name, or by the table's ARN.
fn getTable(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    caller: borrow TablesCaller,
) -> Result<TablesAnswer, TablesError> {
    var tableId = Vector<u8>.create();
    var bucketName = Vector<u8>.create();
    var ns = Vector<u8>.create();
    var name = Vector<u8>.create();
    match (paramOf(req, "tableArn")) {
        Some(arn) => {
            bucketName = match (tableBucketOfArn(arn, mut tableId)?) {
                Some(b) => b,
                null => { return Err(TablesError.BadRequest); }
            };
            if (tableId.length == 0) { return Err(TablesError.BadRequest); }
        }
        null => {
            let arn = paramOf(req, "tableBucketARN") ?? "".bytes();
            var none = Vector<u8>.create();
            bucketName = match (tableBucketOfArn(arn, mut none)?) {
                Some(b) => b,
                null => { return Err(TablesError.BadRequest); }
            };
            ns.extend(paramOf(req, "namespace") ?? "".bytes())?;
            name.extend(paramOf(req, "name") ?? "".bytes())?;
            if (ns.length == 0 || name.length == 0 || !oneLevel(ns.view())) { return Err(TablesError.BadRequest); }
        }
    }
    let hidden = tableWarehouseBucket(bucketName.view())?;
    let bucketRec = tableBucketRecord(store, bucketName.view())?;
    // By its ARN: the record with that id.
    if (tableId.length > 0) {
        let keys = catalogKeys(store, hidden.view(), CATALOG_TABLES.bytes(), "".bytes(), 0)?;
        for (i in 0..keys.length) {
            match (readRecord(store, hidden.view(), keys[i].view())?) {
                Some(r) => {
                    if (jsonMemberText(borrow r.json, "id") == Some(tableId.view())) {
                        let rest = keys[i].view()[CATALOG_TABLES.bytes().length..];
                        let slash = pieceEnd(rest, 0, '/');
                        // A nested namespace's table is the Iceberg catalog's alone.
                        if (!oneLevel(rest[0..slash])) { return Err(TablesError.NotFound); }
                        ns.extend(rest[0..slash])?;
                        name.extend(rest[slash + 1..])?;
                        break;
                    }
                }
                null => {}
            }
        }
        if (name.length == 0) { return Err(TablesError.NotFound); }
    }
    let rec = tableRecord(store, bucketName.view(), ns.view(), name.view())?;
    checkTables(
        store,
        caller,
        "s3tables:GetTable",
        bucketName.view(),
        jsonMemberText(borrow rec.json, "id") ?? "".bytes(),
    )?;
    let nsId = namespaceIdOf(store, hidden.view(), ns.view())?;
    let view = tableView(
        req,
        bucketName.view(),
        borrow bucketRec.json,
        ns.view(),
        nsId.view(),
        name.view(),
        borrow rec,
        true,
    )?;
    return tablesJson(borrow view);
}

fn listTables(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    bucketName: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let max = pageSize(req, "maxTables")?;
    let after = continuationOf(req)?;
    let prefix = paramOf(req, "prefix") ?? "".bytes();
    let onlyNs = paramOf(req, "namespace");
    let hidden = tableWarehouseBucket(bucketName)?;
    let bucketRec = tableBucketRecord(store, bucketName)?;
    let base = match (onlyNs) {
        Some(n) => {
            var b = catalogKey(CATALOG_TABLES, n, "".bytes())?;
            b.push('/')?;
            b
        }
        null => copyBytes(CATALOG_TABLES.bytes())?,
    };
    let keys = catalogKeys(store, hidden.view(), base.view(), after.view(), 0)?;
    var list = jsonArray();
    var shown: usize = 0;
    var last = Vector<u8>.create();
    var more = false;
    let head = CATALOG_TABLES.bytes().length;
    // The namespace's id, read once for each run of its tables (keys come in namespace order).
    var nsOfId = Vector<u8>.create();
    var nsId = Vector<u8>.create();
    for (i in 0..keys.length) {
        let rest = keys[i].view()[head..];
        let slash = pieceEnd(rest, 0, '/');
        let ns = rest[0..slash];
        let name = rest[slash + 1..];
        // A nested namespace's tables are the Iceberg catalog's (ADR-0134 §1).
        if (findBytes(ns, [0x1Fu8][..], 0).isSome()) { continue; }
        if (!startsWithBytes(name, prefix)) { continue; }
        if (shown == max) {
            more = true;
            break;
        }
        if (i == 0 || nsOfId.view() != ns) {
            nsOfId = copyBytes(ns)?;
            nsId = namespaceIdOf(store, hidden.view(), ns)?;
        }
        match (readRecord(store, hidden.view(), keys[i].view())?) {
            Some(r) => {
                jsonPush(
                    mut list,
                    tableView(req, bucketName, borrow bucketRec.json, ns, nsId.view(), name, borrow r, false)?,
                )?;
                shown += 1;
                last = copyBytes(keys[i].view())?;
            }
            null => {}
        }
    }
    var answer = jsonObject();
    jsonSet(mut answer, "tables", list)?;
    if (more) { setToken(mut answer, last.view())?; }
    return tablesJson(borrow answer);
}

/// Removes a page of a dropped table's objects (its warehouse prefix) after `after`; the page's last key, or none
/// once there are no more. A cursor, not a fresh listing: on a cluster the deletes are committed with the request,
/// so a listing would show the same keys again.
fn purgePage(
    store: borrow mut ObjectStore,
    hidden: Slice<u8>,
    prefix: Slice<u8>,
    after: Slice<u8>,
) -> Result<Vector<u8>?, TablesError> {
    let keys = catalogKeys(store, hidden, prefix, after, 1000)?;
    if (keys.length == 0) { return Ok(null); }
    let last = copyBytes(keys[keys.length - 1].view())?;
    return match (store.deleteObjects(catalogText(hidden), keys.view())) {
        Ok(_) => Ok(Some(last)),
        Err(e) => Err(tablesStoreFail(e)),
    };
}

/// Removes every object of a table's warehouse prefix (its id), a page at a time, the store let go between pages.
/// Only an id of a UUID's form: the prefix is then this table's alone, never the catalog's or another table's.
async fn purgeWarehouse(app: borrow S3App, hidden: Slice<u8>, id: Slice<u8>) -> Result<void, TablesError> {
    if (!uuidShaped(id)) { return Ok(); }
    var prefix = copyBytes(id)?;
    prefix.push('/')?;
    var after = Vector<u8>.create();
    while (true) {
        var guard = await lockStore(app)?;
        let store = guard.data();
        let view = prefix.view();
        let from = after.view();
        match (await Async.blocking(() => purgePage(store, hidden, view, from))?) {
            Some(last) => { after = last; }
            null => { break; }
        }
    }
    return Ok();
}

fn deleteTable(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    bucketName: Slice<u8>,
    ns: Slice<u8>,
    name: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(bucketName)?;
    var id = Vector<u8>.create();
    {
        let rec = tableRecord(store, bucketName, ns, name)?;
        match (paramOf(req, "versionToken")) {
            Some(t) => {
                if (t != versionTokenOf(rec.generation)?.view()) { return Err(TablesError.Conflict); }
            }
            null => {}
        }
        id.extend(jsonMemberText(borrow rec.json, "id") ?? "".bytes())?;
        let key = catalogKey(CATALOG_TABLES, ns, name)?;
        let bucket = catalogText(hidden.view());
        let k = catalogText(key.view());
        match ((store.deleteObject(bucket, k))) {
            Ok() => {}
            Err(e) => { return Err(tablesStoreFail(e)); }
        }
        // Its policy (ADR-0084 §1) and its maintenance records (ADR-0086) go with it.
        let policy = tablePolicyKey(id.view())?;
        match (store.deleteObject(bucket, catalogText(policy.view()))) {
            Ok() => {}
            Err(StoreError.NoSuchKey) => {}
            Err(e) => { return Err(tablesStoreFail(e)); }
        }
        removeTableMaintenance(store, hidden.view(), id.view())?;
        // A staged create's reservation of the name, if one was left: never a way to make a table at this one's id
        // again (the M29 exit review's L3).
        let stagedKey = catalogKey(CATALOG_STAGED, ns, name)?;
        let _ = store.deleteObject(bucket, catalogText(stagedKey.view()));
        // Its tags and storage class (ADR-0126).
        let configKey = tableConfigKey(id.view())?;
        let _ = store.deleteObject(bucket, catalogText(configKey.view()));
    }
    // Its objects go after the answer's work, a page at a time (`purgeWarehouse`).
    var answer = tablesNoContent();
    answer.purgeBucket = hidden;
    answer.purgeId = id;
    return Ok(answer);
}

/// Whether a namespace is of one level, as S3 Tables' own API names one.
fn oneLevel(ns: Slice<u8>) -> bool {
    for (c in ns) {
        if (c == 0x1F) { return false; }
    }
    return true;
}

fn renameTable(
    store: borrow mut ObjectStore,
    bucketName: Slice<u8>,
    ns: Slice<u8>,
    name: Slice<u8>,
    body: Slice<u8>,
) -> Result<TablesAnswer, TablesError> => renameTableIn(store, bucketName, ns, name, body, false);

/// A rename; `nested` when the Iceberg catalog asks, whose namespaces are 1 to 8 levels (the M34 exit review's M1).
fn renameTableIn(
    store: borrow mut ObjectStore,
    bucketName: Slice<u8>,
    ns: Slice<u8>,
    name: Slice<u8>,
    body: Slice<u8>,
    nested: bool,
) -> Result<TablesAnswer, TablesError> {
    let j = tablesObject(body)?;
    // A rename names a new name, a new namespace or both.
    if (jsonMember(borrow j, "newName").isNull() && jsonMember(borrow j, "newNamespaceName").isNull()) {
        return Err(TablesError.BadRequest);
    }
    let newName = copyBytes(jsonMemberText(borrow j, "newName") ?? name)?;
    let newNs = copyBytes(jsonMemberText(borrow j, "newNamespaceName") ?? ns)?;
    let nsOk = if (nested) levelsOk(newNs.view()) else tableNameOk(newNs.view(), true);
    if (!tableNameOk(newName.view(), false) || !nsOk) { return Err(TablesError.BadRequest); }
    let hidden = tableWarehouseBucket(bucketName)?;
    let rec = tableRecord(store, bucketName, ns, name)?;
    match (jsonMemberText(borrow j, "versionToken")) {
        Some(t) => {
            if (t != versionTokenOf(rec.generation)?.view()) { return Err(TablesError.Conflict); }
        }
        null => {}
    }
    let nsKey = catalogKey(CATALOG_NAMESPACES, newNs.view(), "".bytes())?;
    if (readRecord(store, hidden.view(), nsKey.view())?.isNull()) { return Err(TablesError.NotFound); }
    let to = catalogKey(CATALOG_TABLES, newNs.view(), newName.view())?;
    if (readRecord(store, hidden.view(), to.view())?.isSome() || viewExists(
        store,
        hidden.view(),
        newNs.view(),
        newName.view(),
    )?) {
        return Err(TablesError.Conflict);
    }
    let from = catalogKey(CATALOG_TABLES, ns, name)?;
    let bucket = catalogText(hidden.view());
    let f = catalogText(from.view());
    let t = catalogText(to.view());
    let generation = rec.generation;
    // The record moves whole, by one Rename record (ADR-0081): its id and warehouse stay. The destination must still
    // be absent when the rename is staged: on a cluster another rename to it may be staged and not yet applied.
    match ((store.renameObjectTo(bucket, f, t, generation, "".bytes(), true))) {
        Ok() => {}
        Err(e) => { return Err(tablesStoreFail(e)); }
    }
    // Its configuration keeps its new name, by which its id is found (the M33 exit review's L3).
    let id = copyBytes(jsonMemberText(borrow rec.json, "id") ?? "".bytes())?;
    let configKey = tableConfigKey(id.view())?;
    var config = readTablesConfig(store, hidden.view(), configKey.view())?;
    if (jsonMember(borrow config, "namespace").isSome()) {
        jsonSet(mut config, "namespace", jsonString(newNs.view())?)?;
        jsonSet(mut config, "name", jsonString(newName.view())?)?;
        writeTablesConfig(store, hidden.view(), configKey.view(), borrow config)?;
    }
    return Ok(tablesNoContent());
}

fn getTableMetadataLocation(
    store: borrow mut ObjectStore,
    bucketName: Slice<u8>,
    ns: Slice<u8>,
    name: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let rec = tableRecord(store, bucketName, ns, name)?;
    var answer = jsonObject();
    match (jsonMemberText(borrow rec.json, "metadataLocation")) {
        Some(m) => { jsonSet(mut answer, "metadataLocation", jsonString(m)?)?; }
        null => {}
    }
    jsonSet(mut answer, "versionToken", Json.Text(versionTokenOf(rec.generation)?))?;
    let id = jsonMemberText(borrow rec.json, "id") ?? "".bytes();
    jsonSet(mut answer, "warehouseLocation", Json.Text(warehouseOf(bucketName, id)?))?;
    return tablesJson(borrow answer);
}

/// Whether `location` is `warehouse` itself or lies under `<warehouse>/` (not a sibling like `<warehouse>X`).
fn withinWarehouse(location: Slice<u8>, warehouse: Slice<u8>) -> bool =>
    location == warehouse || (location.length > warehouse.length && startsWithBytes(location, warehouse) &&
        location[warehouse.length] == '/');

/// Whether `location` lies in the table's warehouse and names a metadata file the catalog can read: `.metadata.json`
/// (a gzipped `.metadata.json.gz` is not read here, so it is refused rather than taken and failing on load).
fn metadataLocationOk(location: Slice<u8>, warehouse: Slice<u8>) -> bool {
    if (location == warehouse || !withinWarehouse(location, warehouse)) { return false; }
    let e = ".metadata.json".bytes();
    return location.length > e.length && location[location.length - e.length..] == e;
}

/// UpdateTableMetadataLocation: the compare-and-set (ADR-0083 §3). The record is written only if it is still the
/// generation the versionToken names (If-Match), else ConflictException.
fn updateTableMetadataLocation(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    bucketName: Slice<u8>,
    ns: Slice<u8>,
    name: Slice<u8>,
    body: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let j = tablesObject(body)?;
    let location = copyBytes(jsonMemberText(borrow j, "metadataLocation") ?? "".bytes())?;
    let token = copyBytes(jsonMemberText(borrow j, "versionToken") ?? "".bytes())?;
    if (location.length == 0 || location.length > 2048 || token.length == 0) { return Err(TablesError.BadRequest); }
    let hidden = tableWarehouseBucket(bucketName)?;
    var generation: u64 = 0;
    var id = Vector<u8>.create();
    {
        var rec = tableRecord(store, bucketName, ns, name)?;
        id.extend(jsonMemberText(borrow rec.json, "id") ?? "".bytes())?;
        if (!metadataLocationOk(location.view(), warehouseOf(bucketName, id.view())?.view())) {
            return Err(TablesError.BadRequest);
        }
        if (token.view() != versionTokenOf(rec.generation)?.view()) { return Err(TablesError.Conflict); }
        jsonSet(mut rec.json, "metadataLocation", jsonString(location.view())?)?;
        jsonSet(mut rec.json, "modifiedAt", jsonInteger(Clock.unixMillis())?)?;
        let key = catalogKey(CATALOG_TABLES, ns, name)?;
        let hiddenView = hidden.view();
        let keyView = key.view();
        let recRef = borrow rec.json;
        let current = rec.generation;
        generation = (writeRecord(store, hiddenView, keyView, recRef, PutCondition.IfGeneration(current)))?;
    }
    var answer = jsonObject();
    jsonSet(mut answer, "metadataLocation", Json.Text(location))?;
    jsonSet(mut answer, "name", jsonString(name)?)?;
    jsonSet(mut answer, "namespace", namespaceArray(ns)?)?;
    var arn = Vector<u8>.create();
    tableArn(req, bucketName, id.view(), mut arn)?;
    jsonSet(mut answer, "tableARN", Json.Text(arn))?;
    jsonSet(mut answer, "versionToken", Json.Text(versionTokenOf(generation)?))?;
    return tablesJson(borrow answer);
}

// ---- Dispatch ----

/// The table bucket a path segment's ARN names; BadRequest if it names none.
fn bucketOfSegment(segment: Slice<u8>) -> Result<Vector<u8>, TablesError> {
    var none = Vector<u8>.create();
    return match (tableBucketOfArn(segment, mut none)?) {
        Some(b) => if (none.length == 0) Ok(b) else Err(TablesError.BadRequest),
        null => Err(TablesError.BadRequest),
    };
}

/// The policy method's action name: `Get`, `Put` or `Delete` and `what` (`TableBucketPolicy`, `TablePolicy`).
fn policyActionOf(m: Method, bucketLevel: bool) -> StringView =>
    if (isMethod(m, Method.Put)) (if (bucketLevel) "s3tables:PutTableBucketPolicy" else "s3tables:PutTablePolicy")
        else if (isMethod(
            m,
            Method.Delete,
        )) (if (bucketLevel) "s3tables:DeleteTableBucketPolicy" else "s3tables:DeleteTablePolicy")
        else (if (bucketLevel) "s3tables:GetTableBucketPolicy" else "s3tables:GetTablePolicy");

fn routeTablesSync(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    body: Slice<u8>,
    caller: borrow TablesCaller,
    credentials: Slice<Credential>,
    sealing: borrow WarehouseKeys,
) -> Result<TablesAnswer, TablesError> {
    let segs = pathSegments(req.rawPath.view())?;
    let m = req.method;
    if (segs.length == 0) { return Err(TablesError.NotImplemented); }
    let top = segs[0].view();
    // The Iceberg REST catalog (ADR-0083 §5), its calls authorized as S3 Tables' (ADR-0084 §3).
    if (top == "iceberg".bytes()) { return icebergRoute(store, req, segs.view()[1..], body, caller, sealing); }
    // Each call is authorized by its table bucket's and its table's policies before it runs (ADR-0084 §2).
    // Tags of a table bucket or table, by its ARN (ADR-0126 §1).
    if (top == "tag".bytes() && segs.length == 2) {
        var id = Vector<u8>.create();
        let bucket = tableBucketOfArn(segs[1].view(), mut id)? ?? { return Err(TablesError.BadRequest); };
        let action = if (isMethod(m, Method.Get)) "s3tables:ListTagsForResource"
            else if (isMethod(m, Method.Post)) "s3tables:TagResource"
            else "s3tables:UntagResource";
        checkTables(store, caller, action, bucket.view(), id.view())?;
        return tablesTagCall(store, req, bucket.view(), id.view(), body);
    }
    // Record expiration (ADR-0130 §5): AWS's for its managed tables, which CosmoStore has none of.
    if ((top == "table-record-expiration".bytes() || top == "table-record-expiration-job-status".bytes()) &&
        segs.length == 1) {
        return Err(TablesError.MethodNotAllowed);
    }
    if (top == "get-table".bytes() && segs.length == 1) {
        if (!isMethod(m, Method.Get)) { return Err(TablesError.BadRequest); }
        return getTable(store, req, caller);
    }
    if (top == "buckets".bytes()) {
        // CreateTableBucket and ListTableBuckets name no table bucket: no policy applies.
        if (segs.length == 1) {
            if (isMethod(m, Method.Put)) {
                let j = tablesObject(body)?;
                var named = copyBytes("s3tables:".bytes())?;
                named.extend(jsonMemberText(borrow j, "name") ?? "".bytes())?;
                checkTablesIdentity(caller, "s3tables:CreateTableBucket", named.view())?;
                return createTableBucket(store, req, body, sealing);
            }
            if (isMethod(m, Method.Get)) {
                checkTablesIdentity(caller, "s3tables:ListTableBuckets", "s3tables:".bytes())?;
                return listTableBuckets(store, req);
            }
            return Err(TablesError.BadRequest);
        }
        let bucket = bucketOfSegment(segs[1].view())?;
        if (segs.length == 3 && segs[2].view() == "policy".bytes()) {
            let _ = tableBucketRecord(store, bucket.view())?;
            checkTables(store, caller, policyActionOf(m, true), bucket.view(), "".bytes())?;
            return tablesPolicyCall(store, m, bucket.view(), TABLE_BUCKET_POLICY_KEY.bytes(), body, credentials);
        }
        // Its maintenance (ADR-0086 §1).
        if (segs.length >= 3 && segs[2].view() == "maintenance".bytes()) {
            let _ = tableBucketRecord(store, bucket.view())?;
            if (segs.length == 3 && isMethod(m, Method.Get)) {
                checkTables(
                    store,
                    caller,
                    "s3tables:GetTableBucketMaintenanceConfiguration",
                    bucket.view(),
                    "".bytes(),
                )?;
                return getBucketMaintenance(store, req, bucket.view());
            }
            if (segs.length == 4 && isMethod(m, Method.Put)) {
                let kind = maintenanceKind(segs[3].view(), true) ?? { return Err(TablesError.BadRequest); };
                checkTables(
                    store,
                    caller,
                    "s3tables:PutTableBucketMaintenanceConfiguration",
                    bucket.view(),
                    "".bytes(),
                )?;
                let hidden = tableWarehouseBucket(bucket.view())?;
                return putMaintenance(store, hidden.view(), MAINTENANCE_BUCKET_KEY.bytes(), kind, body);
            }
            return Err(TablesError.BadRequest);
        }
        // Its encryption (ADR-0126 §3).
        if (segs.length == 3 && segs[2].view() == "encryption".bytes()) {
            let _ = tableBucketRecord(store, bucket.view())?;
            let action = if (isMethod(m, Method.Put)) "s3tables:PutTableBucketEncryption"
                else if (isMethod(m, Method.Delete)) "s3tables:DeleteTableBucketEncryption"
                else "s3tables:GetTableBucketEncryption";
            checkTables(store, caller, action, bucket.view(), "".bytes())?;
            return bucketEncryptionCall(store, req, bucket.view(), body, sealing);
        }
        // Its metrics configuration (ADR-0130 §4).
        if (segs.length == 3 && segs[2].view() == "metrics".bytes()) {
            let _ = tableBucketRecord(store, bucket.view())?;
            let action = if (isMethod(m, Method.Put)) "s3tables:PutTableBucketMetricsConfiguration"
                else if (isMethod(m, Method.Delete)) "s3tables:DeleteTableBucketMetricsConfiguration"
                else "s3tables:GetTableBucketMetricsConfiguration";
            checkTables(store, caller, action, bucket.view(), "".bytes())?;
            return bucketMetricsCall(store, req, bucket.view());
        }
        // Its logging (ADR-0130 §1): a Put is taken before the store's work, in `routeTables`.
        if (segs.length == 3 && segs[2].view() == "logging".bytes()) {
            if (!isMethod(m, Method.Get)) { return Err(TablesError.BadRequest); }
            return getTableBucketLogging(store, caller, bucket.view());
        }
        // Its storage class (ADR-0126 §2).
        if (segs.length == 3 && segs[2].view() == "storage-class".bytes()) {
            let _ = tableBucketRecord(store, bucket.view())?;
            let action = if (isMethod(m, Method.Put)) "s3tables:PutTableBucketStorageClass"
                else "s3tables:GetTableBucketStorageClass";
            checkTables(store, caller, action, bucket.view(), "".bytes())?;
            return bucketStorageClassCall(store, req, bucket.view(), body);
        }
        // Its encryption, replication and the rest: not done (ADR-0083 §6).
        if (segs.length > 2) { return Err(TablesError.NotImplemented); }
        if (isMethod(m, Method.Get)) {
            checkTables(store, caller, "s3tables:GetTableBucket", bucket.view(), "".bytes())?;
            return getTableBucket(store, req, bucket.view());
        }
        if (isMethod(m, Method.Delete)) {
            checkTables(store, caller, "s3tables:DeleteTableBucket", bucket.view(), "".bytes())?;
            return deleteTableBucket(store, bucket.view());
        }
        return Err(TablesError.BadRequest);
    }
    if (top == "namespaces".bytes() && segs.length >= 2) {
        let bucket = bucketOfSegment(segs[1].view())?;
        if (segs.length == 2) {
            if (isMethod(m, Method.Put)) {
                checkTables(store, caller, "s3tables:CreateNamespace", bucket.view(), "".bytes())?;
                return createNamespace(store, req, bucket.view(), body);
            }
            if (isMethod(m, Method.Get)) {
                checkTables(store, caller, "s3tables:ListNamespaces", bucket.view(), "".bytes())?;
                return listNamespaces(store, req, bucket.view());
            }
            return Err(TablesError.BadRequest);
        }
        if (segs.length > 3) { return Err(TablesError.NotImplemented); }
        let ns = segs[2].view();
        // One level, as AWS (ADR-0134, the owner's choice; the M34 exit review's M2).
        if (!oneLevel(ns)) { return Err(TablesError.BadRequest); }
        if (isMethod(m, Method.Get)) {
            checkTables(store, caller, "s3tables:GetNamespace", bucket.view(), "".bytes())?;
            return getNamespace(store, req, bucket.view(), ns);
        }
        if (isMethod(m, Method.Delete)) {
            checkTables(store, caller, "s3tables:DeleteNamespace", bucket.view(), "".bytes())?;
            return deleteNamespace(store, bucket.view(), ns);
        }
        return Err(TablesError.BadRequest);
    }
    if (top == "tables".bytes() && segs.length >= 2) {
        let bucket = bucketOfSegment(segs[1].view())?;
        if (segs.length == 2) {
            if (isMethod(m, Method.Get)) {
                checkTables(store, caller, "s3tables:ListTables", bucket.view(), "".bytes())?;
                return listTables(store, req, bucket.view());
            }
            return Err(TablesError.BadRequest);
        }
        let ns = segs[2].view();
        if (!oneLevel(ns)) { return Err(TablesError.BadRequest); }
        if (segs.length == 3) {
            if (isMethod(m, Method.Put)) {
                checkTables(store, caller, "s3tables:CreateTable", bucket.view(), "".bytes())?;
                return createTable(store, req, bucket.view(), ns, body, sealing);
            }
            return Err(TablesError.BadRequest);
        }
        let name = segs[3].view();
        // The calls on one table: its id is its policy's key and its resource's.
        let id = tableIdOf(store, bucket.view(), ns, name)?;
        if (segs.length == 4) {
            if (isMethod(m, Method.Delete)) {
                checkTables(store, caller, "s3tables:DeleteTable", bucket.view(), id.view())?;
                return deleteTable(store, req, bucket.view(), ns, name);
            }
            return Err(TablesError.BadRequest);
        }
        let what = segs[4].view();
        if (segs.length == 5 && what == "rename".bytes() && isMethod(m, Method.Put)) {
            checkTables(store, caller, "s3tables:RenameTable", bucket.view(), id.view())?;
            return renameTable(store, bucket.view(), ns, name, body);
        }
        if (segs.length == 5 && what == "metadata-location".bytes()) {
            if (isMethod(m, Method.Get)) {
                checkTables(store, caller, "s3tables:GetTableMetadataLocation", bucket.view(), id.view())?;
                return getTableMetadataLocation(store, bucket.view(), ns, name);
            }
            if (isMethod(m, Method.Put)) {
                checkTables(store, caller, "s3tables:UpdateTableMetadataLocation", bucket.view(), id.view())?;
                return updateTableMetadataLocation(store, req, bucket.view(), ns, name, body);
            }
        }
        // Its maintenance and job status (ADR-0086 §1).
        if (what == "maintenance".bytes()) {
            if (segs.length == 5 && isMethod(m, Method.Get)) {
                checkTables(store, caller, "s3tables:GetTableMaintenanceConfiguration", bucket.view(), id.view())?;
                return getTableMaintenance(store, req, bucket.view(), id.view());
            }
            if (segs.length == 6 && isMethod(m, Method.Put)) {
                let kind = maintenanceKind(segs[5].view(), false) ?? { return Err(TablesError.BadRequest); };
                checkTables(store, caller, "s3tables:PutTableMaintenanceConfiguration", bucket.view(), id.view())?;
                let hidden = tableWarehouseBucket(bucket.view())?;
                let key = tableMaintenanceKey(id.view())?;
                return putMaintenance(store, hidden.view(), key.view(), kind, body);
            }
            return Err(TablesError.BadRequest);
        }
        if (segs.length == 5 && what == "maintenance-job-status".bytes() && isMethod(m, Method.Get)) {
            checkTables(store, caller, "s3tables:GetTableMaintenanceJobStatus", bucket.view(), id.view())?;
            return getJobStatus(store, req, bucket.view(), id.view());
        }
        if (segs.length == 5 && what == "policy".bytes()) {
            checkTables(store, caller, policyActionOf(m, false), bucket.view(), id.view())?;
            let key = tablePolicyKey(id.view())?;
            return tablesPolicyCall(store, m, bucket.view(), key.view(), body, credentials);
        }
        if (segs.length == 5 && what == "encryption".bytes() && isMethod(m, Method.Get)) {
            checkTables(store, caller, "s3tables:GetTableEncryption", bucket.view(), id.view())?;
            let hidden = tableWarehouseBucket(bucket.view())?;
            let e = tableEncryption(store, hidden.view(), id.view())?;
            return encryptionAnswer(e.asBorrow());
        }
        if (segs.length == 5 && what == "storage-class".bytes() && isMethod(m, Method.Get)) {
            checkTables(store, caller, "s3tables:GetTableStorageClass", bucket.view(), id.view())?;
            let hidden = tableWarehouseBucket(bucket.view())?;
            return storageClassAnswer(tableStorageClass(store, hidden.view(), id.view())?.view());
        }
        // A table's encryption, replication and the rest: not done (ADR-0083 §6).
        return Err(TablesError.NotImplemented);
    }
    return Err(TablesError.NotImplemented);
}

/// `routeTablesSync` with the server's keys as a worker thread holds them.
fn routeTablesKeyed(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    body: Slice<u8>,
    caller: borrow TablesCaller,
    credentials: Slice<Credential>,
    tableKeys: borrow TableKeys,
) -> Result<TablesAnswer, TablesError> {
    let sealing = tableKeys.keys();
    return routeTablesSync(store, req, body, caller, credentials, borrow sealing);
}

/// The S3 Tables API's work under the store, on a worker thread, then a dropped table's objects removed.
async fn routeTables(
    app: borrow S3App,
    req: borrow S3Request,
    body: Slice<u8>,
    who: borrow Requester,
    callerRef: borrow TablesCaller,
) -> Result<TablesAnswer, TablesError> {
    var answer = tablesNoContent();
    // CosmoStore's own call: one table's maintenance job, now (ADR-0086 §5), as a cluster node asks its shards.
    let segs = pathSegments(req.rawPath.view())?;
    if (segs.length == 5 && segs[0].view() == "tables".bytes() && segs[4].view() == "maintenance-run".bytes() &&
        isMethod(req.method, Method.Post)) {
        return await runMaintenance(app, req, callerRef, segs.view());
    }
    // PutTableBucketLogging (ADR-0130 §1): its target authorized as the caller, as S3's PutBucketLogging is.
    if (segs.length == 3 && segs[0].view() == "buckets".bytes() && segs[2].view() == "logging".bytes() &&
        isMethod(req.method, Method.Put)) {
        let bucket = bucketOfSegment(segs[1].view())?;
        return await putTableBucketLogging(app, req, who, callerRef, bucket.view(), body);
    }
    {
        let credentials = app.credentials.get();
        let keys = credentials.view();
        // The server's master keys, to open and seal an encrypted table's metadata (ADR-0126 §4).
        let tableKeys = tableKeysOf(app);
        let tableKeysRef = borrow tableKeys;
        var guard = await lockStore(app)?;
        let store = guard.data();
        answer = await Async.blocking(() => routeTablesKeyed(store, req, body, callerRef, keys, tableKeysRef))?;
    }
    if (answer.purgeId.length > 0) {
        let bucket = replace(mut answer.purgeBucket, Vector<u8>.create());
        let id = replace(mut answer.purgeId, Vector<u8>.create());
        // The table is gone once its record is: a purge cut short leaves objects that DeleteTableBucket removes
        // (ADR-0083 §7), so it does not turn the drop's answer into an error.
        match (await purgeWarehouse(app, bucket.view(), id.view())) {
            Ok() => {}
            Err(TablesError.OutOfMemory(e)) => { return Err(TablesError.OutOfMemory(e)); }
            Err(_) => {}
        }
    }
    return Ok(answer);
}

/// Whether a request may have its body read before its signature is checked (ADR-0083 §1): a SigV4 Authorization
/// field dated within 15 minutes, by one of the server's keys or with a session's token. So a client with no key
/// cannot make the server hold a body.
fn tablesMayRead(req: borrow S3Request, credentials: Slice<Credential>, now: i64) -> bool {
    let value = match (headerOf(req, "authorization")) {
        Some(v) => v,
        null => { return false; }
    };
    let auth = match (parseAuthorization(value)) {
        Ok(a) => a,
        Err(_) => { return false; }
    };
    let when = match (parseAmzDate(headerOf(req, "x-amz-date") ?? "".bytes())) {
        Some(w) => w,
        null => { return false; }
    };
    let skew = if (when > now) when - now else now - when;
    if (skew > 900) { return false; }
    if (headerOf(req, "x-amz-security-token").isSome()) { return true; }
    for (i in 0..credentials.length) {
        if (!credentials[i].revoked && credentials[i].accessKey.view() == auth.accessKey.view()) { return true; }
    }
    return false;
}

/// Whether a request is the Iceberg REST catalog's (`/iceberg/…`), whose errors have its own shape.
fn icebergPath(req: borrow S3Request) -> bool {
    let p = req.rawPath.view();
    let head = "/iceberg".bytes();
    return startsWithBytes(p, head) && (p.length == head.length || p[head.length] == '/');
}

/// An S3 Tables error as the Iceberg REST catalog gives one (`{"error":{…}}`), for a call of its that failed
/// outside its own handlers' answers.
fn icebergErrorOf(e: borrow TablesError) -> Result<TablesAnswer, TablesError> => match (e) {
    TablesError.BadRequest => icebergError(400, "BadRequestException", "The request is invalid."),
    TablesError.Forbidden => icebergError(403, "ForbiddenException", "Access denied."),
    TablesError.NotFound => icebergError(404, "NotFoundException", "The specified resource was not found."),
    TablesError.Conflict => icebergError(409, "CommitFailedException", "The table changed since it was read."),
    TablesError.NotImplemented => icebergUnsupported(),
    _ => icebergError(500, "InternalServerError", "An internal error occurred."),
};

/// A request signed for `s3tables` (ADR-0083 §1): its body read and hashed first, as S3 Tables' clients send no
/// `x-amz-content-sha256`; keys, their `GetSessionToken` sessions, and roles' sessions (ADR-0088 §2).
async fn serveTables(
    app: borrow S3App,
    req: borrow S3Request,
    exchange: borrow mut Exchange,
    facts: borrow mut AuditFacts,
) -> Result<void, S3Fail> {
    if (!tablesMayRead(req, app.credentials.get().view(), Clock.unixMillis() / 1000)) {
        let refused: Result<TablesAnswer, TablesError> = Err(TablesError.Forbidden);
        // Logged when it names a table bucket that logs (ADR-0132, M32's B2), its requester and operation `-`.
        if (app.loggingBuckets.load() > 0) { let _ = tablesRefusalFacts(req, "".bytes(), facts); }
        return await sendTablesAnswer(req, exchange, refused);
    }
    let unsigned = Authenticated { payload: PayloadMode.Unsigned, signer: null, key: null, session: null };
    let body = await readSmallBody(unsigned, exchange, TABLES_MAX_BODY)?;
    var hash = Vector<u8>.create();
    appendHexBytes(mut hash, Sha256.of(body.view())[..])?;
    let now = Clock.unixMillis() / 1000;
    let answer: Result<TablesAnswer, TablesError> = match (req.authenticate(
        app.credentials.get().view(),
        app.stsKeys.get().view(),
        now,
        "s3tables",
        Some(hash.view()),
    )) {
        Ok(auth) => {
            let who = match (borrow auth.session) {
                Some(s) => sessionRequester(app, auth.key, null, s)?,
                null => requesterOf(auth.key, null),
            };
            // A role's session is decided by its policies (ADR-0088 §2), as a user is.
            if (who.key.isNull() || headerOf(req, EXPRESS_TOKEN_FIELD).isSome()) {
                if (app.loggingBuckets.load() > 0) { let _ = tablesRefusalFacts(req, body.view(), facts); }
                Err(TablesError.Forbidden)
            } else {
                let caller = tablesCallerOf(app, req, borrow who, body.view())?;
                let answered = await routeTables(app, req, body.view(), borrow who, borrow caller);
                // Its table bucket's request counts (ADR-0130 §4).
                await countTablesRequest(app, req, body.view(), borrow answered);
                // Its table bucket's log record (ADR-0130 §2): what the hook after the answer queues, if it logs; and
                // who made it, for the audit log too. A failure to note them never fails the answered call (the M32
                // exit review's L5, L6).
                if (app.loggingBuckets.load() > 0 || app.audit.isSome()) {
                    let _ = tablesLogFacts(app, req, body.view(), borrow auth, borrow caller, borrow answered, facts);
                }
                answered
            }
        }
        Err(_) => {
            if (app.loggingBuckets.load() > 0) { let _ = tablesRefusalFacts(req, body.view(), facts); }
            Err(TablesError.Forbidden)
        }
    };
    return await sendTablesAnswer(req, exchange, answer);
}

async fn sendTablesAnswer(
    req: borrow S3Request,
    exchange: borrow mut Exchange,
    result: Result<TablesAnswer, TablesError>,
) -> Result<void, S3Fail> {
    // The Iceberg catalog's errors in its own shape (ADR-0083 §1), whatever part of the call failed.
    let answer: Result<TablesAnswer, TablesError> = match (result) {
        Err(TablesError.OutOfMemory(e)) => Err(TablesError.OutOfMemory(e)),
        Err(e) => if (icebergPath(req)) icebergErrorOf(borrow e) else Err(e),
        Ok(a) => Ok(a),
    };
    match (answer) {
        Ok(a) => {
            if (a.body.length > 0) { exchange.header("content-type", "application/json".bytes())?; }
            await exchange.send(statusOf(a.status), a.body.view())?;
        }
        Err(TablesError.OutOfMemory(e)) => { return Err(S3Fail.OutOfMemory(e)); }
        Err(e) => {
            var b = Vector<u8>.create();
            b.extend("{\"message\":".bytes())?;
            writeJsonText(mut b, tablesErrorMessage(borrow e).bytes())?;
            b.push('}')?;
            exchange.header("content-type", "application/json".bytes())?;
            exchange.header("x-amzn-errortype", tablesErrorName(borrow e).bytes())?;
            await exchange.send(statusOf(tablesErrorStatus(borrow e)), b.view())?;
        }
    }
    return Ok();
}

/// What S3's calls may do in a table bucket's warehouse (ADR-0083 §2, §4): an engine's object calls, a listing
/// within a prefix, HeadBucket and DeleteObjects; never the catalog's `.s3tables/` keys, nor a bucket call
/// (NotImplemented: DeleteBucket and configurations are the table bucket's own API's).
fn tableWarehouseRefusal(req: borrow S3Request) -> Result<void, S3Fail> {
    let catalog = CATALOG_PREFIX.bytes();
    if (startsWithBytes(req.key.bytes(), catalog)) { return Err(S3Fail.Code(S3Code.AccessDenied)); }
    match (headerOf(req, "x-amz-copy-source")) {
        Some(_) => {
            match (copySourceOf(req)) {
                Ok(src) => {
                    if (startsWithBytes(src.key.bytes(), catalog)) { return Err(S3Fail.Code(S3Code.AccessDenied)); }
                }
                Err(e) => { return Err(e); }
            }
        }
        null => {}
    }
    // A table's files are under its id (ADR-0084 §4): another key is no table's, and none is written.
    if (req.key.length > 0) {
        if (tableIdOfKey(req.key.bytes(), false).isNull()) { return Err(S3Fail.Code(S3Code.AccessDenied)); }
        return Ok();
    }
    let m = req.method;
    // CreateBucket of such a name: not S3's to make.
    if (isMethod(m, Method.Put) && req.query.length == 0) { return Err(S3Fail.Code(S3Code.InvalidBucketName)); }
    if (isMethod(m, Method.Head) && req.query.length == 0) { return Ok(); }
    if (isMethod(m, Method.Post) && req.onlyParams("delete")) { return Ok(); }
    if (isMethod(m, Method.Get) && (req.hasParam("list-type") || req.hasParam("uploads"))) {
        // A listing names one table's prefix (ADR-0084 §4), which cannot reach the catalog's keys.
        let prefix = paramOf(req, "prefix") ?? "".bytes();
        if (tableIdOfKey(prefix, true).isNull()) { return Err(S3Fail.Code(S3Code.AccessDenied)); }
        return Ok();
    }
    return Err(S3Fail.Code(S3Code.NotImplemented));
}

/// CreateTable's `metadata` (`{"iceberg":{"schema","partitionSpec","writeOrder","properties"}}`) as an Iceberg
/// CreateTableRequest. Its members are named on the wire as AWS's service model's `locationName`s: a spec's and an
/// order's are Iceberg's own (`spec-id`, `source-id`, `field-id`, `order-id`, `null-order`), not camelCase. `schemaV2`
/// (nested types) is not done.
fn createRequestOfMetadata(md: borrow Json) -> Result<Json, TablesError> {
    let ice = match (jsonMember(md, "iceberg")) {
        Some(i) => i,
        null => { return Err(TablesError.BadRequest); }
    };
    if (jsonMember(ice, "schemaV2").isSome()) { return Err(TablesError.NotImplemented); }
    // Only the members AWS's shapes have (its service model): another is refused, not dropped.
    if (!onlyMembers(md, ["iceberg"][..]) ||
        !onlyMembers(ice, ["schema", "partitionSpec", "writeOrder", "properties"][..])) {
        return Err(TablesError.BadRequest);
    }
    let fields = match (jsonMember(ice, "schema")) {
        Some(s) => {
            if (!onlyMembers(s, ["fields"][..])) { return Err(TablesError.BadRequest); }
            match (jsonMember(s, "fields")) {
                Some(f) => f,
                null => { return Err(TablesError.BadRequest); }
            }
        }
        null => { return Err(TablesError.BadRequest); }
    };
    var out = jsonArray();
    match (fields) {
        Json.Array(items) => {
            for (i in 0..items.length) {
                let f = borrow items[i];
                // SchemaField: `name` and `type` (a string), `id` and `required` optional.
                if (!onlyMembers(f, ["id", "name", "type", "required"][..])) { return Err(TablesError.BadRequest); }
                let name = jsonMemberText(f, "name") ?? "".bytes();
                let kind = jsonMemberText(f, "type") ?? "".bytes();
                if (name.length == 0 || kind.length == 0) { return Err(TablesError.BadRequest); }
                var g = jsonObject();
                jsonSet(mut g, "id", jsonInteger(jsonMemberI64(f, "id") ?? (truncate<i64>(i) + 1))?)?;
                jsonSet(mut g, "name", jsonString(name)?)?;
                var required = false;
                match (jsonMember(f, "required")) {
                    Some(v) => {
                        match (v) {
                            Json.Bool(b) => { required = b; }
                            _ => { return Err(TablesError.BadRequest); }
                        }
                    }
                    null => {}
                }
                jsonSet(mut g, "required", Json.Bool(required))?;
                jsonSet(mut g, "type", jsonString(kind)?)?;
                jsonPush(mut out, g)?;
            }
        }
        _ => { return Err(TablesError.BadRequest); }
    }
    var schema = jsonObject();
    jsonSet(mut schema, "type", jsonString("struct".bytes())?)?;
    jsonSet(mut schema, "fields", out)?;
    var request = jsonObject();
    jsonSet(mut request, "schema", schema)?;
    match (jsonMember(ice, "partitionSpec")) {
        Some(ps) => {
            // The table's first spec is spec 0, whatever else `specId` would name.
            if (!onlyMembers(ps, ["fields", "spec-id"][..]) || (jsonMemberI64(ps, "spec-id") ?? 0) != 0 ||
                (jsonMember(ps, "spec-id").isSome() && jsonMemberI64(ps, "spec-id").isNull())) {
                return Err(TablesError.BadRequest);
            }
            var specFields = jsonArray();
            match (jsonMember(ps, "fields")) {
                Some(fs) => {
                    match (fs) {
                        Json.Array(items) => {
                            for (i in 0..items.length) {
                                let f = borrow items[i];
                                if (!onlyMembers(f, ["source-id", "transform", "name", "field-id"][..]) ||
                                    jsonMemberI64(f, "source-id").isNull() || jsonMemberText(f, "transform").isNull() ||
                                    jsonMemberText(f, "name").isNull()) {
                                    return Err(TablesError.BadRequest);
                                }
                                var g = jsonObject();
                                jsonSet(mut g, "source-id", jsonInteger(jsonMemberI64(f, "source-id") ?? 0)?)?;
                                jsonSet(
                                    mut g,
                                    "field-id",
                                    jsonInteger(jsonMemberI64(f, "field-id") ?? (1000 + truncate<i64>(i)))?,
                                )?;
                                jsonSet(mut g, "name", jsonString(jsonMemberText(f, "name") ?? "".bytes())?)?;
                                jsonSet(
                                    mut g,
                                    "transform",
                                    jsonString(jsonMemberText(f, "transform") ?? "identity".bytes())?,
                                )?;
                                jsonPush(mut specFields, g)?;
                            }
                        }
                        _ => { return Err(TablesError.BadRequest); }
                    }
                }
                null => {}
            }
            var spec = jsonObject();
            jsonSet(mut spec, "fields", specFields)?;
            jsonSet(mut request, "partition-spec", spec)?;
        }
        null => {}
    }
    match (jsonMember(ice, "writeOrder")) {
        Some(wo) => {
            if (!onlyMembers(wo, ["order-id", "fields"][..]) || jsonMemberI64(wo, "order-id").isNull()) {
                return Err(TablesError.BadRequest);
            }
            var orderFields = jsonArray();
            match (jsonMember(wo, "fields")) {
                Some(fs) => {
                    match (fs) {
                        Json.Array(items) => {
                            for (i in 0..items.length) {
                                let f = borrow items[i];
                                if (!onlyMembers(f, ["source-id", "transform", "direction", "null-order"][..]) ||
                                    jsonMemberI64(f, "source-id").isNull() || jsonMemberText(f, "transform").isNull() ||
                                    jsonMemberText(
                                        f,
                                        "direction",
                                    ).isNull() || jsonMemberText(f, "null-order").isNull()) {
                                    return Err(TablesError.BadRequest);
                                }
                                var g = jsonObject();
                                jsonSet(mut g, "source-id", jsonInteger(jsonMemberI64(f, "source-id") ?? 0)?)?;
                                jsonSet(
                                    mut g,
                                    "transform",
                                    jsonString(jsonMemberText(f, "transform") ?? "identity".bytes())?,
                                )?;
                                jsonSet(
                                    mut g,
                                    "direction",
                                    jsonString(jsonMemberText(f, "direction") ?? "asc".bytes())?,
                                )?;
                                jsonSet(
                                    mut g,
                                    "null-order",
                                    jsonString(jsonMemberText(f, "null-order") ?? "nulls-first".bytes())?,
                                )?;
                                jsonPush(mut orderFields, g)?;
                            }
                        }
                        _ => { return Err(TablesError.BadRequest); }
                    }
                }
                null => {}
            }
            var order = jsonObject();
            let orderId = jsonMemberI64(wo, "order-id") ?? 0;
            jsonSet(mut order, "order-id", jsonInteger(orderId)?)?;
            jsonSet(mut order, "fields", orderFields)?;
            jsonSet(mut request, "write-order", order)?;
        }
        null => {}
    }
    match (jsonMember(ice, "properties")) {
        Some(p) => { jsonSet(mut request, "properties", cloneJson(p)?)?; }
        null => {}
    }
    return Ok(request);
}

/// Whether object `j` has no member but `allowed`'s (true for no object: its own check says what it must be).
fn onlyMembers(j: borrow Json, allowed: Slice<StringView>) -> bool {
    match (j) {
        Json.Object(ms) => {
            for (i in 0..ms.length) {
                var known = false;
                for (a in allowed) {
                    if (ms[i].key.view() == a.bytes()) { known = true; }
                }
                if (!known) { return false; }
            }
        }
        _ => {}
    }
    return true;
}

// ---- A table bucket's log record (ADR-0130 §2) ----

/// The table bucket a call names: by its body (CreateTableBucket), an ARN in its path, GetTable's or another call's
/// query, or the Iceberg catalog's `warehouse` or `prefix`; null for none (ListTableBuckets).
fn tablesBucketOfRequest(req: borrow S3Request, body: Slice<u8>) -> Result<Vector<u8>?, TablesError> {
    let segs = pathSegments(req.rawPath.view())?;
    if (segs.length == 0) { return Ok(null); }
    let top = segs[0].view();
    var id = Vector<u8>.create();
    if (top == "buckets".bytes() && segs.length == 1) {
        if (!isMethod(req.method, Method.Put)) { return Ok(null); }
        let j = parseJson(body)? ?? { return Ok(null); };
        let name = jsonMemberText(borrow j, "name") ?? { return Ok(null); };
        return Ok(if (tableBucketNameOk(name)) Some(copyBytes(name)?) else null);
    }
    if ((top == "buckets".bytes() || top == "namespaces".bytes() || top == "tables".bytes() ||
        top == "tag".bytes()) && segs.length >= 2) {
        return Ok(tableBucketOfArn(segs[1].view(), mut id)?);
    }
    if (top == "iceberg".bytes() && segs.length >= 3 && segs[1].view() == "v1".bytes()) {
        if (segs[2].view() == "config".bytes()) {
            let w = paramOf(req, "warehouse") ?? { return Ok(null); };
            return Ok(tableBucketOfArn(w, mut id)?);
        }
        return Ok(tableBucketOfArn(segs[2].view(), mut id)?);
    }
    for (name in ["tableArn", "tableBucketARN"]) {
        match (paramOf(req, name)) {
            Some(a) => { return Ok(tableBucketOfArn(a, mut id)?); }
            null => {}
        }
    }
    return Ok(null);
}

/// The namespace and table a call names by its path or query, for its log record; empty where it names none.
fn tablesNamesOf(
    req: borrow S3Request,
    ns: borrow mut Vector<u8>,
    name: borrow mut Vector<u8>,
) -> Result<void, TablesError> {
    let segs = pathSegments(req.rawPath.view())?;
    if (segs.length >= 3 && (segs[0].view() == "tables".bytes() || segs[0].view() == "namespaces".bytes())) {
        ns.extend(segs[2].view())?;
        if (segs[0].view() == "tables".bytes() && segs.length >= 4) { name.extend(segs[3].view())?; }
        return Ok();
    }
    if (segs.length >= 1 && segs[0].view() == "iceberg".bytes()) {
        // `.../namespaces/{ns}/tables/{name}`, by position: a namespace or table named `tables` is not taken for the
        // path's word, and `tables/rename` names no table (the M32 exit review's L2).
        if (segs.length >= 5 && segs[3].view() == "namespaces".bytes()) {
            ns.extend(segs[4].view())?;
            if (segs.length >= 7 && segs[5].view() == "tables".bytes()) { name.extend(segs[6].view())?; }
        }
        return Ok();
    }
    match (paramOf(req, "namespace")) {
        Some(n) => { ns.extend(n)?; }
        null => {}
    }
    match (paramOf(req, "name")) {
        Some(n) => { name.extend(n)?; }
        null => {}
    }
    return Ok();
}

/// A call's facts for its table bucket's log record: its bucket the table bucket's warehouse (whose logging it goes
/// to), its operation the action it was first authorized for, its table, and who made it.
fn tablesLogFacts(
    app: borrow S3App,
    req: borrow S3Request,
    body: Slice<u8>,
    auth: borrow Authenticated,
    caller: borrow TablesCaller,
    answered: borrow Result<TablesAnswer, TablesError>,
    facts: borrow mut AuditFacts,
) -> Result<void, AllocError> {
    let bucket = match (tablesBucketOfRequest(req, body)) {
        Ok(Some(b)) => b,
        Ok(null) => { return Ok(); }
        Err(TablesError.OutOfMemory(e)) => { return Err(e); }
        Err(_) => { return Ok(); }
    };
    facts.access.bucket.clear();
    facts.access.bucket.extend(bucket.view())?;
    facts.access.bucket.extend(TABLE_BUCKET_SUFFIX.bytes())?;
    facts.access.tables = true;
    facts.access.operation.clear();
    let at = caller.action.load();
    if (at > 0) {
        facts.access.operation.extend("S3Tables.".bytes())?;
        facts.access.operation.extend(TABLES_ACTIONS[truncate<usize>(at - 1)].bytes()["s3tables:".length..])?;
    }
    facts.access.tableArn = notedTableArn(caller, bucket.view())?;
    let _ = tablesNamesOf(req, mut facts.access.nsName, mut facts.access.tableName);
    match (answered) {
        Err(e) => { facts.access.errorName.extend(tablesErrorName(e).bytes())?; }
        Ok(_) => {}
    }
    match (headerOf(req, "referer")) {
        Some(v) => { facts.access.referrer.extend(trimBlank(v))?; }
        null => {}
    }
    match (headerOf(req, "user-agent")) {
        Some(v) => { facts.access.userAgent.extend(trimBlank(v))?; }
        null => {}
    }
    match (headerOf(req, "host")) {
        Some(v) => { facts.access.host.extend(trimBlank(v))?; }
        null => {}
    }
    facts.access.authType = if (headerOf(req, "authorization").isSome()) ACCESS_AUTH_HEADER else ACCESS_AUTH_QUERY;
    facts.requester.clear();
    let credentials = app.credentials.get().view();
    match (borrow auth.session) {
        Some(s) => { facts.requester.extend(s.accessKey.view())?; }
        null => {
            match (auth.key) {
                Some(i) => { facts.requester.extend(credentials[i].accessKey.view())?; }
                null => { facts.requester.extend("anonymous".bytes())?; }
            }
        }
    }
    return Ok();
}

/// A request refused before its caller is known (no key, a signature that does not check, an Express token): its
/// table bucket's log record, its requester and operation `-` (ADR-0132, M32's B2), as AWS logs a refused request.
fn tablesRefusalFacts(
    req: borrow S3Request,
    body: Slice<u8>,
    facts: borrow mut AuditFacts,
) -> Result<void, AllocError> {
    let bucket = match (tablesBucketOfRequest(req, body)) {
        Ok(Some(b)) => b,
        Ok(null) => { return Ok(); }
        Err(TablesError.OutOfMemory(e)) => { return Err(e); }
        Err(_) => { return Ok(); }
    };
    facts.access.bucket.clear();
    facts.access.bucket.extend(bucket.view())?;
    facts.access.bucket.extend(TABLE_BUCKET_SUFFIX.bytes())?;
    facts.access.tables = true;
    facts.access.operation.clear();
    facts.access.errorName.clear();
    facts.access.errorName.extend("ForbiddenException".bytes())?;
    let _ = tablesNamesOf(req, mut facts.access.nsName, mut facts.access.tableName);
    match (headerOf(req, "user-agent")) {
        Some(v) => { facts.access.userAgent.extend(trimBlank(v))?; }
        null => {}
    }
    match (headerOf(req, "host")) {
        Some(v) => { facts.access.host.extend(trimBlank(v))?; }
        null => {}
    }
    return Ok();
}
