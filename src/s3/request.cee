// One S3 request as the handlers see it (ADR-0008): its fields with lowercase names, the bucket and key decoded from
// the path, the decoded query, and SigV4 authentication.
import web_http;

/// An access key and its secret, from the credentials file.
struct Credential {
    accessKey: Vector<u8>;
    secret: Vector<u8>;
}

/// Parses a credentials file: one `access-key secret-key` pair per line; `#` starts a comment.
fn parseCredentials(text: Slice<u8>) -> Result<Vector<Credential>, AllocError> {
    var out = Vector<Credential>.create();
    var at: usize = 0;
    while (at < text.length) {
        let end = pieceEnd(text, at, '\n');
        let raw = text[at..end];
        at = end + 1;
        let hash = pieceEnd(raw, 0, '#');
        let line = trimSpaces(raw[0..hash]);
        let trimmed = if (line.length > 0 && line[line.length - 1] == '\r') line[0..line.length - 1] else line;
        if (trimmed.length == 0) { continue; }
        let space = pieceEnd(trimmed, 0, ' ');
        if (space == trimmed.length) { continue; }
        var c = Credential { accessKey: Vector<u8>.create(), secret: Vector<u8>.create() };
        c.accessKey.extend(trimmed[0..space])?;
        c.secret.extend(trimSpaces(trimmed[space + 1..]))?;
        out.push(c)?;
    }
    return Ok(out);
}

/// How the body is covered by the signature (x-amz-content-sha256, ADR-0008 §6).
enum PayloadMode {
    Unsigned,
    /// The body's SHA-256, to be checked before the commit.
    Hashed([u8; 32]),
    /// aws-chunked; with a signer its chunks are signed.
    Chunked,
}

/// What authentication found.
struct Authenticated {
    payload: PayloadMode;
    signer: ChunkSigner?;
}

struct S3Request {
    method: Method;
    methodText: Vector<u8>;
    headers: Vector<HeaderPair>;
    rawPath: Vector<u8>;
    rawQuery: Vector<u8>;
    /// Decoded; empty for the service (`/`) and for a bucket's own requests.
    bucket: String;
    key: String;
    query: Vector<QueryParam>;

    /// The request's parts, or InvalidArgument for a path or query that does not decode to UTF-8.
    fn of(request: borrow Request) -> Result<S3Request, S3Fail> {
        var r = S3Request {
            method: request.method(),
            methodText: Vector<u8>.create(),
            headers: Vector<HeaderPair>.create(),
            rawPath: Vector<u8>.create(),
            rawQuery: Vector<u8>.create(),
            bucket: String.create(),
            key: String.create(),
            query: Vector<QueryParam>.create(),
        };
        r.methodText.extend(request.methodToken())?;
        let fields = request.headers();
        for (i in 0..fields.count()) {
            var p = HeaderPair { name: Vector<u8>.create(), value: Vector<u8>.create() };
            let name = fields.nameBytes(i);
            for (k in 0..name.length) { p.name.push(lowerAscii(name[k]))?; }
            p.value.extend(fields.value(i))?;
            r.headers.push(p)?;
        }
        let path = request.path().bytes();
        r.rawPath.extend(path)?;
        match (request.query()) {
            Some(q) => { r.rawQuery.extend(q.bytes())?; }
            null => {}
        }
        // /bucket/key: the key is everything after the bucket's slash, slashes included.
        let start: usize = if (path.length > 0 && path[0] == '/') 1 else 0;
        let slash = pieceEnd(path, start, '/');
        var decoded = Vector<u8>.create();
        if (!percentDecodeInto(mut decoded, path[start..slash], false)?) {
            return Err(S3Fail.Code(S3Code.InvalidArgument));
        }
        appendUtf8(mut r.bucket, decoded.view())?;
        if (slash < path.length) {
            decoded.clear();
            if (!percentDecodeInto(mut decoded, path[slash + 1..], false)?) {
                return Err(S3Fail.Code(S3Code.InvalidArgument));
            }
            appendUtf8(mut r.key, decoded.view())?;
        }
        let raw = r.rawQuery.view();
        var at: usize = 0;
        while (at < raw.length) {
            let end = pieceEnd(raw, at, '&');
            let part = raw[at..end];
            at = end + 1;
            if (part.length == 0) { continue; }
            let eq = pieceEnd(part, 0, '=');
            var p = QueryParam { name: Vector<u8>.create(), value: Vector<u8>.create() };
            if (!percentDecodeInto(mut p.name, part[0..eq], true)?) { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            if (eq < part.length && !percentDecodeInto(mut p.value, part[eq + 1..], true)?) {
                return Err(S3Fail.Code(S3Code.InvalidArgument));
            }
            r.query.push(p)?;
        }
        return Ok(r);
    }

    fn hasParam(borrow this, name: StringView) -> bool {
        for (i in 0..this.query.length) {
            if (this.query[i].name.view() == name.bytes()) { return true; }
        }
        return false;
    }

    /// Whether every query parameter is among `allowed` (comma-separated) or one S3 ignores (`x-id`).
    fn onlyParams(borrow this, allowed: StringView) -> bool {
        for (i in 0..this.query.length) {
            let name = this.query[i].name.view();
            if (name == "x-id".bytes()) { continue; }
            var found = false;
            let list = allowed.bytes();
            var at: usize = 0;
            while (at < list.length) {
                let end = pieceEnd(list, at, ',');
                if (list[at..end] == name) { found = true; }
                at = end + 1;
            }
            if (!found) { return false; }
        }
        return true;
    }

    /// The SigV4 check (ADR-0008 §5).
    fn authenticate(borrow this, credentials: Slice<Credential>, now: i64) -> Result<Authenticated, S3Code> {
        let value = match (headerOf(this, "authorization")) {
            Some(v) => v,
            null => { return Err(S3Code.AccessDenied); }
        };
        let auth = match (parseAuthorization(value)) {
            Ok(a) => a,
            Err(_) => { return Err(S3Code.AuthorizationHeaderMalformed); }
        };
        if (auth.service.view() != "s3".bytes()) { return Err(S3Code.AuthorizationHeaderMalformed); }
        var secret: Slice<u8>? = null;
        for (i in 0..credentials.length) {
            if (sameSignature(credentials[i].accessKey.view(), auth.accessKey.view())) {
                secret = Some(credentials[i].secret.view());
            }
        }
        let key = match (secret) {
            Some(s) => s,
            null => { return Err(S3Code.InvalidAccessKeyId); }
        };
        let amzDate = match (headerOf(this, "x-amz-date")) {
            Some(d) => d,
            null => { return Err(S3Code.AccessDenied); }
        };
        let when = match (parseAmzDate(amzDate)) {
            Some(t) => t,
            null => { return Err(S3Code.AccessDenied); }
        };
        let skew = if (when > now) when - now else now - when;
        if (skew > 900) { return Err(S3Code.RequestTimeTooSkewed); }
        if (amzDate[0..8] != auth.date.view()) { return Err(S3Code.SignatureDoesNotMatch); }
        let payloadHash = match (headerOf(this, "x-amz-content-sha256")) {
            Some(h) => h,
            null => { return Err(S3Code.InvalidRequest); }
        };
        var canonical = Vector<u8>.create();
        let complete = mapOom(canonicalRequest(
            this.methodText.view(),
            this.rawPath.view(),
            this.rawQuery.view(),
            this.headers.view(),
            auth.signedHeaders.view(),
            payloadHash,
            mut canonical,
        ))?;
        if (!complete) { return Err(S3Code.SignatureDoesNotMatch); }
        let signing = mapOom(signingKey(key, auth.date.view(), auth.region.view(), auth.service.view()))?;
        var seed = Vector<u8>.create();
        mapOom(seedSignature(borrow signing, amzDate, auth.scope.view(), canonical.view(), mut seed))?;
        if (!sameSignature(seed.view(), auth.signature.view())) { return Err(S3Code.SignatureDoesNotMatch); }

        if (payloadHash == "UNSIGNED-PAYLOAD".bytes()) {
            return Ok(Authenticated { payload: PayloadMode.Unsigned, signer: null });
        }
        if (payloadHash == "STREAMING-UNSIGNED-PAYLOAD-TRAILER".bytes()) {
            return Ok(Authenticated { payload: PayloadMode.Chunked, signer: null });
        }
        if (payloadHash == "STREAMING-AWS4-HMAC-SHA256-PAYLOAD".bytes() ||
            payloadHash == "STREAMING-AWS4-HMAC-SHA256-PAYLOAD-TRAILER".bytes()) {
            var signer = ChunkSigner {
                key: signing,
                amzDate: Vector<u8>.create(),
                scope: Vector<u8>.create(),
                previous: Vector<u8>.create(),
            };
            mapOom(signer.amzDate.extend(amzDate))?;
            mapOom(signer.scope.extend(auth.scope.view()))?;
            mapOom(signer.previous.extend(seed.view()))?;
            return Ok(Authenticated { payload: PayloadMode.Chunked, signer: signer });
        }
        if (payloadHash.length == 64) {
            var digest = [0u8; 32];
            for (i in 0..32) {
                let hi = hexValue(payloadHash[i * 2]);
                let lo = hexValue(payloadHash[i * 2 + 1]);
                if (hi.isNull() || lo.isNull()) { return Err(S3Code.InvalidArgument); }
                digest[i] = ((hi ?? 0) << 4) | (lo ?? 0);
            }
            return Ok(Authenticated { payload: PayloadMode.Hashed(digest), signer: null });
        }
        return Err(S3Code.InvalidArgument);
    }
}

/// The field `name` (lowercase) of `r`, its first value.
fn headerOf<region a>(r: borrow(a) S3Request, name: StringView) -> Slice<a, u8>? {
    for (i in 0..r.headers.length) {
        if (r.headers[i].name.view() == name.bytes()) { return Some(r.headers[i].value.view()); }
    }
    return null;
}

/// The query parameter `name` of `r`, decoded.
fn paramOf<region a>(r: borrow(a) S3Request, name: StringView) -> Slice<a, u8>? {
    for (i in 0..r.query.length) {
        if (r.query[i].name.view() == name.bytes()) { return Some(r.query[i].value.view()); }
    }
    return null;
}

fn mapOom<T>(r: Result<T, AllocError>) -> Result<T, S3Code> => match (r) {
    Ok(v) => Ok(v),
    Err(_) => Err(S3Code.InternalError),
};

/// Appends `bytes` if they are UTF-8; else InvalidArgument.
fn appendUtf8(out: borrow mut String, bytes: Slice<u8>) -> Result<void, S3Fail> {
    match (StringView.fromUtf8(bytes)) {
        Some(t) => { out.append(t)?; }
        null => { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
    }
    return Ok();
}

/// How a handler fails: with an S3 error to send, or with the exchange's own failure.
enum S3Fail {
    Code(S3Code),
    @from Http(HandlerError),
    @from OutOfMemory(AllocError),
}
