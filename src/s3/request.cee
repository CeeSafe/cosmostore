// One S3 request as the handlers see it (ADR-0008): its fields with lowercase names, the bucket and key decoded from
// the path, the decoded query, and SigV4 authentication.
import web_http;

/// An access key and its secret, from the credentials file.
struct Credential {
    accessKey: Vector<u8>;
    secret: Vector<u8>;
}

/// Parses a credentials file: one `access-key secret-key` pair per line; `#` starts a comment.
fn parseCredentials(text: Slice<u8>) -> Result<Vector<Credential>, AllocError> {
    var out = Vector<Credential>.create();
    var at: usize = 0;
    while (at < text.length) {
        let end = pieceEnd(text, at, '\n');
        let raw = text[at..end];
        at = end + 1;
        let hash = pieceEnd(raw, 0, '#');
        let line = trimSpaces(raw[0..hash]);
        let trimmed = if (line.length > 0 && line[line.length - 1] == '\r') line[0..line.length - 1] else line;
        if (trimmed.length == 0) { continue; }
        let space = pieceEnd(trimmed, 0, ' ');
        if (space == trimmed.length) { continue; }
        var c = Credential { accessKey: Vector<u8>.create(), secret: Vector<u8>.create() };
        c.accessKey.extend(trimmed[0..space])?;
        c.secret.extend(trimSpaces(trimmed[space + 1..]))?;
        out.push(c)?;
    }
    return Ok(out);
}

/// How the body is covered by the signature (x-amz-content-sha256, ADR-0008 §6).
enum PayloadMode {
    Unsigned,
    /// The body's SHA-256, to be checked before the commit.
    Hashed([u8; 32]),
    /// aws-chunked; with a signer its chunks are signed.
    Chunked,
}

/// What authentication found.
struct Authenticated {
    payload: PayloadMode;
    signer: ChunkSigner?;
}

struct S3Request {
    method: Method;
    methodText: Vector<u8>;
    headers: Vector<HeaderPair>;
    rawPath: Vector<u8>;
    rawQuery: Vector<u8>;
    /// Decoded; empty for the service (`/`) and for a bucket's own requests.
    bucket: String;
    key: String;
    query: Vector<QueryParam>;

    /// The request's parts, or InvalidArgument for a path or query that does not decode to UTF-8. With a `domain`,
    /// a Host of `<bucket>.<domain>` names the bucket (virtual-host addressing), and the whole path is the key.
    fn of(request: borrow Request, domain: Slice<u8>) -> Result<S3Request, S3Fail> {
        var r = S3Request {
            method: request.method(),
            methodText: Vector<u8>.create(),
            headers: Vector<HeaderPair>.create(),
            rawPath: Vector<u8>.create(),
            rawQuery: Vector<u8>.create(),
            bucket: String.create(),
            key: String.create(),
            query: Vector<QueryParam>.create(),
        };
        r.methodText.extend(request.methodToken())?;
        let fields = request.headers();
        for (i in 0..fields.count()) {
            var p = HeaderPair { name: Vector<u8>.create(), value: Vector<u8>.create() };
            let name = fields.nameBytes(i);
            for (k in 0..name.length) { p.name.push(lowerAscii(name[k]))?; }
            p.value.extend(fields.value(i))?;
            r.headers.push(p)?;
        }
        let path = request.path().bytes();
        r.rawPath.extend(path)?;
        match (request.query()) {
            Some(q) => { r.rawQuery.extend(q.bytes())?; }
            null => {}
        }
        let start: usize = if (path.length > 0 && path[0] == '/') 1 else 0;
        var decoded = Vector<u8>.create();
        var hostBucket = Vector<u8>.create();
        virtualBucket(headerOf(borrow r, "host") ?? "".bytes(), domain, mut hostBucket)?;
        if (hostBucket.length > 0) {
            // /key, under <bucket>.<domain>.
            appendUtf8(mut r.bucket, hostBucket.view())?;
            if (!percentDecodeInto(mut decoded, path[start..], false)?) {
                return Err(S3Fail.Code(S3Code.InvalidArgument));
            }
            appendUtf8(mut r.key, decoded.view())?;
            r.parseQuery()?;
            return Ok(r);
        }
        // /bucket/key: the key is everything after the bucket's slash, slashes included.
        let slash = pieceEnd(path, start, '/');
        if (!percentDecodeInto(mut decoded, path[start..slash], false)?) {
            return Err(S3Fail.Code(S3Code.InvalidArgument));
        }
        appendUtf8(mut r.bucket, decoded.view())?;
        if (slash < path.length) {
            decoded.clear();
            if (!percentDecodeInto(mut decoded, path[slash + 1..], false)?) {
                return Err(S3Fail.Code(S3Code.InvalidArgument));
            }
            appendUtf8(mut r.key, decoded.view())?;
        }
        r.parseQuery()?;
        return Ok(r);
    }

    fn parseQuery(borrow mut this) -> Result<void, S3Fail> {
        let raw = this.rawQuery.view();
        var at: usize = 0;
        while (at < raw.length) {
            let end = pieceEnd(raw, at, '&');
            let part = raw[at..end];
            at = end + 1;
            if (part.length == 0) { continue; }
            let eq = pieceEnd(part, 0, '=');
            var p = QueryParam { name: Vector<u8>.create(), value: Vector<u8>.create() };
            if (!percentDecodeInto(mut p.name, part[0..eq], true)?) { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            if (eq < part.length && !percentDecodeInto(mut p.value, part[eq + 1..], true)?) {
                return Err(S3Fail.Code(S3Code.InvalidArgument));
            }
            this.query.push(p)?;
        }
        this.hoistQueryHeaders()?;
        return Ok();
    }

    /// A presigned URL carries some `x-amz-*` headers in its query (presigners hoist them), and the signature covers
    /// them there. Each one stands for the header it names, unless the request also sends that header (ADR-0013).
    /// Only presigned requests do this: for header auth the query's `x-amz-*` would be unsigned headers.
    fn hoistQueryHeaders(borrow mut this) -> Result<void, AllocError> {
        if (!this.hasParam("X-Amz-Algorithm")) { return Ok(); }
        var hoisted = Vector<HeaderPair>.create();
        for (i in 0..this.query.length) {
            let name = this.query[i].name.view();
            if (name.length <= 6 || !equalsIgnoreCase(name[0..6], "x-amz-".bytes()) || isQueryAuthParam(name)) {
                continue;
            }
            var lower = Vector<u8>.create();
            for (c in name) { lower.push(lowerAscii(c))?; }
            var present = false;
            for (h in 0..this.headers.length) {
                if (this.headers[h].name.view() == lower.view()) { present = true; }
            }
            if (present) { continue; }
            var value = Vector<u8>.create();
            value.extend(this.query[i].value.view())?;
            hoisted.push(HeaderPair { name: lower, value: value })?;
        }
        for (h in 0..hoisted.length) {
            this.headers.push(
                replace(mut hoisted[h], HeaderPair { name: Vector<u8>.create(), value: Vector<u8>.create() }),
            )?;
        }
        return Ok();
    }

    fn hasParam(borrow this, name: StringView) -> bool {
        for (i in 0..this.query.length) {
            if (this.query[i].name.view() == name.bytes()) { return true; }
        }
        return false;
    }

    /// Whether every query parameter is among `allowed` (comma-separated), one S3 ignores (`x-id`), or a presigned
    /// URL's `X-Amz-*`.
    fn onlyParams(borrow this, allowed: StringView) -> bool {
        for (i in 0..this.query.length) {
            let name = this.query[i].name.view();
            if (name == "x-id".bytes() || (name.length > 6 && equalsIgnoreCase(name[0..6], "x-amz-".bytes()))) {
                continue;
            }
            var found = false;
            let list = allowed.bytes();
            var at: usize = 0;
            while (at < list.length) {
                let end = pieceEnd(list, at, ',');
                if (list[at..end] == name) { found = true; }
                at = end + 1;
            }
            if (!found) { return false; }
        }
        return true;
    }

    /// The SigV4 check: the Authorization header (ADR-0008 §5), or a presigned URL's query (ADR-0011).
    fn authenticate(borrow this, credentials: Slice<Credential>, now: i64) -> Result<Authenticated, S3Code> {
        match (headerOf(this, "authorization")) {
            Some(value) => {
                if (startsWithBytes(value, "AWS ".bytes())) { return Err(S3Code.AuthorizationMechanism); } // SigV2
                let auth = match (parseAuthorization(value)) {
                    Ok(a) => a,
                    Err(_) => { return Err(S3Code.AuthorizationHeaderMalformed); }
                };
                let amzDate = match (headerOf(this, "x-amz-date")) {
                    Some(v) => v,
                    null => { return Err(S3Code.AccessDenied); }
                };
                let when = match (parseAmzDate(amzDate)) {
                    Some(v) => v,
                    null => { return Err(S3Code.AccessDenied); }
                };
                let skew = if (when > now) when - now else now - when;
                if (skew > 900) { return Err(S3Code.RequestTimeTooSkewed); }
                let payloadHash = match (headerOf(this, "x-amz-content-sha256")) {
                    Some(v) => v,
                    null => { return Err(S3Code.InvalidRequest); }
                };
                return this.verify(credentials, borrow auth, amzDate, payloadHash, this.rawQuery.view());
            }
            null => {}
        }
        if (paramOf(this, "X-Amz-Algorithm").isSome()) { return this.authenticateQuery(credentials, now); }
        if (paramOf(this, "AWSAccessKeyId").isSome()) { return Err(S3Code.AuthorizationMechanism); } // SigV2
        return Err(S3Code.AccessDenied);
    }

    /// A presigned URL: X-Amz-Algorithm, -Credential, -Date, -Expires, -SignedHeaders and -Signature in the query,
    /// which is signed without its signature. The payload is UNSIGNED-PAYLOAD unless a header says otherwise.
    fn authenticateQuery(borrow this, credentials: Slice<Credential>, now: i64) -> Result<Authenticated, S3Code> {
        let malformed = S3Code.AuthorizationQueryParametersError;
        if ((paramOf(this, "X-Amz-Algorithm") ?? "".bytes()) != "AWS4-HMAC-SHA256".bytes()) { return Err(malformed); }
        if (paramOf(this, "X-Amz-Security-Token").isSome()) { return Err(S3Code.InvalidToken); }
        let credential = match (paramOf(this, "X-Amz-Credential")) {
            Some(v) => v,
            null => { return Err(malformed); }
        };
        let signedHeaders = match (paramOf(this, "X-Amz-SignedHeaders")) {
            Some(v) => v,
            null => { return Err(malformed); }
        };
        let signature = match (paramOf(this, "X-Amz-Signature")) {
            Some(v) => v,
            null => { return Err(malformed); }
        };
        let amzDate = match (paramOf(this, "X-Amz-Date")) {
            Some(v) => v,
            null => { return Err(malformed); }
        };
        let expires = match (parseDecimal(paramOf(this, "X-Amz-Expires") ?? "".bytes())) {
            Some(v) => v,
            null => { return Err(malformed); }
        };
        if (expires < 1 || expires > 604800) { return Err(malformed); }
        // The same fields as an Authorization header, so one parser checks them.
        var header = Vector<u8>.create();
        mapOom(header.extend("AWS4-HMAC-SHA256 Credential=".bytes()))?;
        mapOom(header.extend(credential))?;
        mapOom(header.extend(", SignedHeaders=".bytes()))?;
        mapOom(header.extend(signedHeaders))?;
        mapOom(header.extend(", Signature=".bytes()))?;
        mapOom(header.extend(signature))?;
        let auth = match (parseAuthorization(header.view())) {
            Ok(a) => a,
            Err(_) => { return Err(malformed); }
        };
        let when = match (parseAmzDate(amzDate)) {
            Some(v) => v,
            null => { return Err(malformed); }
        };
        if (when > now + 900) { return Err(S3Code.AccessDenied); }                    // not valid yet
        if (now > when + truncate<i64>(expires)) { return Err(S3Code.AccessDenied); } // expired
        var query = Vector<u8>.create();
        mapOom(queryWithout(this.rawQuery.view(), "X-Amz-Signature".bytes(), mut query))?;
        let payloadHash = headerOf(this, "x-amz-content-sha256") ?? paramOf(this, "X-Amz-Content-Sha256") ??
            "UNSIGNED-PAYLOAD".bytes();
        return this.verify(credentials, borrow auth, amzDate, payloadHash, query.view());
    }

    /// Checks a signature over the canonical request with `query`, then says how the payload is covered.
    fn verify(
        borrow this,
        credentials: Slice<Credential>,
        auth: borrow AuthHeader,
        amzDate: Slice<u8>,
        payloadHash: Slice<u8>,
        query: Slice<u8>,
    ) -> Result<Authenticated, S3Code> {
        if (auth.service.view() != "s3".bytes()) { return Err(S3Code.AuthorizationHeaderMalformed); }
        var secret: Slice<u8>? = null;
        for (i in 0..credentials.length) {
            if (sameSignature(credentials[i].accessKey.view(), auth.accessKey.view())) {
                secret = Some(credentials[i].secret.view());
            }
        }
        let key = match (secret) {
            Some(s) => s,
            null => { return Err(S3Code.InvalidAccessKeyId); }
        };
        if (amzDate.length < 8 || amzDate[0..8] != auth.date.view()) { return Err(S3Code.SignatureDoesNotMatch); }
        var canonical = Vector<u8>.create();
        let complete = mapOom(canonicalRequest(
            this.methodText.view(),
            this.rawPath.view(),
            query,
            this.headers.view(),
            auth.signedHeaders.view(),
            payloadHash,
            mut canonical,
        ))?;
        if (!complete) { return Err(S3Code.SignatureDoesNotMatch); }
        let signing = mapOom(signingKey(key, auth.date.view(), auth.region.view(), auth.service.view()))?;
        var seed = Vector<u8>.create();
        mapOom(seedSignature(borrow signing, amzDate, auth.scope.view(), canonical.view(), mut seed))?;
        if (!sameSignature(seed.view(), auth.signature.view())) { return Err(S3Code.SignatureDoesNotMatch); }

        if (payloadHash == "UNSIGNED-PAYLOAD".bytes()) {
            return Ok(Authenticated { payload: PayloadMode.Unsigned, signer: null });
        }
        if (payloadHash == "STREAMING-UNSIGNED-PAYLOAD-TRAILER".bytes()) {
            return Ok(Authenticated { payload: PayloadMode.Chunked, signer: null });
        }
        if (payloadHash == "STREAMING-AWS4-HMAC-SHA256-PAYLOAD".bytes() ||
            payloadHash == "STREAMING-AWS4-HMAC-SHA256-PAYLOAD-TRAILER".bytes()) {
            var signer = ChunkSigner {
                key: signing,
                amzDate: Vector<u8>.create(),
                scope: Vector<u8>.create(),
                previous: Vector<u8>.create(),
            };
            mapOom(signer.amzDate.extend(amzDate))?;
            mapOom(signer.scope.extend(auth.scope.view()))?;
            mapOom(signer.previous.extend(seed.view()))?;
            return Ok(Authenticated { payload: PayloadMode.Chunked, signer: signer });
        }
        if (payloadHash.length == 64) {
            var digest = [0u8; 32];
            for (i in 0..32) {
                let hi = hexValue(payloadHash[i * 2]);
                let lo = hexValue(payloadHash[i * 2 + 1]);
                if (hi.isNull() || lo.isNull()) { return Err(S3Code.InvalidArgument); }
                digest[i] = ((hi ?? 0) << 4) | (lo ?? 0);
            }
            return Ok(Authenticated { payload: PayloadMode.Hashed(digest), signer: null });
        }
        return Err(S3Code.InvalidArgument);
    }
}

/// Whether `name` is one of query auth's own parameters, which are not hoisted headers.
fn isQueryAuthParam(name: Slice<u8>) -> bool {
    let names = [
        "X-Amz-Algorithm", "X-Amz-Credential", "X-Amz-Date", "X-Amz-Expires", "X-Amz-SignedHeaders",
        "X-Amz-Signature", "X-Amz-Security-Token", "X-Amz-Content-Sha256",
    ];
    for (n in names) {
        if (equalsIgnoreCase(name, n.bytes())) { return true; }
    }
    return false;
}

/// The raw query without the parameter `name` (as sent, not decoded).
fn queryWithout(raw: Slice<u8>, name: Slice<u8>, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    var at: usize = 0;
    while (at < raw.length) {
        let end = pieceEnd(raw, at, '&');
        let part = raw[at..end];
        at = end + 1;
        let eq = pieceEnd(part, 0, '=');
        if (part.length == 0 || part[0..eq] == name) { continue; }
        if (out.length > 0) { out.push('&')?; }
        out.extend(part)?;
    }
    return Ok();
}

/// The bucket a Host of `<bucket>.<domain>` (any port) names, into `out`; nothing for any other Host or no domain.
fn virtualBucket(host: Slice<u8>, domain: Slice<u8>, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    if (domain.length == 0) { return Ok(); }
    let name = host[0..pieceEnd(host, 0, ':')];
    if (name.length <= domain.length + 1) { return Ok(); }
    let dot = name.length - domain.length - 1;
    if (name[dot] != '.' || !equalsIgnoreCase(name[dot + 1..], domain)) { return Ok(); }
    out.extend(name[0..dot])?;
    return Ok();
}

/// The field `name` (lowercase) of `r`, its first value.
fn headerOf<region a>(r: borrow(a) S3Request, name: StringView) -> Slice<a, u8>? {
    for (i in 0..r.headers.length) {
        if (r.headers[i].name.view() == name.bytes()) { return Some(r.headers[i].value.view()); }
    }
    return null;
}

/// The query parameter `name` of `r`, decoded.
fn paramOf<region a>(r: borrow(a) S3Request, name: StringView) -> Slice<a, u8>? {
    for (i in 0..r.query.length) {
        if (r.query[i].name.view() == name.bytes()) { return Some(r.query[i].value.view()); }
    }
    return null;
}

fn mapOom<T>(r: Result<T, AllocError>) -> Result<T, S3Code> => match (r) {
    Ok(v) => Ok(v),
    Err(_) => Err(S3Code.InternalError),
};

/// Appends `bytes` if they are UTF-8; else InvalidArgument.
fn appendUtf8(out: borrow mut String, bytes: Slice<u8>) -> Result<void, S3Fail> {
    match (StringView.fromUtf8(bytes)) {
        Some(t) => { out.append(t)?; }
        null => { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
    }
    return Ok();
}

/// How a handler fails: with an S3 error to send, or with the exchange's own failure.
enum S3Fail {
    Code(S3Code),
    @from Http(HandlerError),
    @from OutOfMemory(AllocError),
}
