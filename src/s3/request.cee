// One S3 request as the handlers see it (ADR-0008): its fields with lowercase names, the bucket and key decoded from
// the path, the decoded query, and SigV4 authentication.
import web_http;

/// An access key and its secret, from the credentials file.
struct Credential {
    accessKey: Vector<u8>;
    secret: Vector<u8>;
    /// Its last signing key (ADR-0035).
    signing: SigningKeyCache;
    /// The credentials file no longer has the key (ADR-0050): nothing it signs is accepted. Its place stays, so a
    /// key's place is the same in every set.
    revoked: bool;
    /// The user the users file gives the key, and that user's identity policy (ADR-0088 §1); empty and none for a key
    /// of the account.
    user: Vector<u8>;
    /// The user's name and its id, `<name> <id>`: what a resource policy's user principal is matched with, so a user
    /// made again with an old name does not have the old one's grants (the owner's choice after M11's exit review).
    userKey: Vector<u8>;
    policyText: Vector<u8>;
    policy: BucketPolicy?;
    /// The IAM API's key (ADR-0104), not a file's: its user is the API's, even in a set made before the user was
    /// deleted, so it is never listed as a file's user (the M19 SDK checks).
    fromIam: bool;
}

/// The most credential sets a server takes in its life: the first, and a reload for each of the others.
const MAX_CREDENTIAL_SETS: usize = 4096;

/// The credentials, and the sets that replaced them as the file changed (ADR-0050). A request reads the current
/// set without a lock: each set is written once, into a cell made at start, and `current` then names it. A key's
/// place is the same in every set, so a place taken from one set means the same key in the next.
struct CredentialSets {
    sets: Vector<OnceLock<Vector<Credential>>>;
    current: AtomicU64;
    none: Vector<Credential>;

    fn create(first: Vector<Credential>) -> Result<CredentialSets, AllocError> {
        var sets = Vector<OnceLock<Vector<Credential>>>.create();
        sets.reserve(MAX_CREDENTIAL_SETS)?;
        for (i in 0..MAX_CREDENTIAL_SETS) { sets.push(OnceLock<Vector<Credential>>.create())?; }
        let _ = sets[0].set(first);
        return Ok(CredentialSets { sets: sets, current: AtomicU64.create(0), none: Vector<Credential>.create() });
    }

    /// The current set.
    fn view(borrow this) -> Slice<Credential> {
        let at = this.current.load() as usize;
        return match (this.sets[at].get()) {
            Some(set) => set.view(),
            null => this.none.view(),
        };
    }

    /// Makes `next` the current set; false when every cell is used, and the set stays as it was. One task calls
    /// this, the upkeep.
    fn replace(borrow this, next: Vector<Credential>) -> bool {
        let at = this.current.load() as usize + 1;
        if (at >= this.sets.length) { return false; }
        if (this.sets[at].set(next).isErr()) { return false; }
        this.current.store(at as u64);
        return true;
    }
}

/// The set that follows `old` when the file holds `fresh` (ADR-0050 §2): every key of `old` in its place, with
/// the file's secret, or revoked if the file no longer has it; then the file's new keys, in its order.
fn nextCredentials(old: Slice<Credential>, fresh: Slice<Credential>) -> Result<Vector<Credential>, AllocError> {
    var out = Vector<Credential>.create();
    for (i in 0..old.length) {
        var c = Credential {
            accessKey: copyBytes(old[i].accessKey.view())?,
            secret: Vector<u8>.create(),
            signing: SigningKeyCache.create(),
            revoked: true,
            user: Vector<u8>.create(),
            userKey: Vector<u8>.create(),
            policyText: Vector<u8>.create(),
            policy: null,
            fromIam: false,
        };
        for (j in 0..fresh.length) {
            if (c.revoked && fresh[j].accessKey.view() == old[i].accessKey.view()) {
                c.secret.extend(fresh[j].secret.view())?;
                c.revoked = false;
                c.fromIam = fresh[j].fromIam;
            }
        }
        out.push(c)?;
    }
    for (j in 0..fresh.length) {
        var known = false;
        for (i in 0..out.length) {
            if (out[i].accessKey.view() == fresh[j].accessKey.view()) { known = true; }
        }
        if (known) { continue; }
        out.push(Credential {
            accessKey: copyBytes(fresh[j].accessKey.view())?,
            secret: copyBytes(fresh[j].secret.view())?,
            signing: SigningKeyCache.create(),
            revoked: false,
            user: Vector<u8>.create(),
            userKey: Vector<u8>.create(),
            policyText: Vector<u8>.create(),
            policy: null,
            fromIam: fresh[j].fromIam,
        })?;
    }
    return Ok(out);
}

/// Whether two sets hold the same keys, secrets, revocations and users in the same places.
fn sameCredentials(a: Slice<Credential>, b: Slice<Credential>) -> bool {
    if (a.length != b.length) { return false; }
    for (i in 0..a.length) {
        if (a[i].revoked != b[i].revoked || a[i].accessKey.view() != b[i].accessKey.view() ||
            !sameSignature(a[i].secret.view(), b[i].secret.view()) || a[i].userKey.view() != b[i].userKey.view() ||
            a[i].policyText.view() != b[i].policyText.view()) {
            return false;
        }
    }
    return true;
}

/// Parses a credentials file: one `access-key secret-key` pair per line; `#` starts a comment.
fn parseCredentials(text: Slice<u8>) -> Result<Vector<Credential>, AllocError> {
    var out = Vector<Credential>.create();
    var at: usize = 0;
    while (at < text.length) {
        let end = pieceEnd(text, at, '\n');
        let raw = text[at..end];
        at = end + 1;
        let hash = pieceEnd(raw, 0, '#');
        let line = trimSpaces(raw[0..hash]);
        let trimmed = if (line.length > 0 && line[line.length - 1] == '\r') line[0..line.length - 1] else line;
        if (trimmed.length == 0) { continue; }
        let space = pieceEnd(trimmed, 0, ' ');
        if (space == trimmed.length) { continue; }
        var c = Credential {
            accessKey: Vector<u8>.create(),
            secret: Vector<u8>.create(),
            signing: SigningKeyCache.create(),
            revoked: false,
            user: Vector<u8>.create(),
            userKey: Vector<u8>.create(),
            policyText: Vector<u8>.create(),
            policy: null,
            fromIam: false,
        };
        c.accessKey.extend(trimmed[0..space])?;
        c.secret.extend(trimSpaces(trimmed[space + 1..]))?;
        out.push(c)?;
    }
    return Ok(out);
}

/// How the body is covered by the signature (x-amz-content-sha256, ADR-0008 §6).
enum PayloadMode {
    Unsigned,
    /// The body's SHA-256, to be checked before the commit.
    Hashed([u8; 32]),
    /// aws-chunked; with a signer its chunks are signed.
    Chunked,
}

/// The signing service of directory buckets' requests (ADR-0080).
const EXPRESS_SERVICE: StringView = "s3express";

/// Field `n` of `req`'s credential scope (`<key>/<date>/<region>/<service>/aws4_request`: 1 the date, 2 the region,
/// 3 the service), in the Authorization field or a presigned URL's `X-Amz-Credential`; null if it has none.
fn scopeField<region a>(req: borrow(a) S3Request, n: usize) -> Slice<a, u8>? {
    let credential = match (headerOf(req, "authorization")) {
        Some(value) => {
            let marker = "Credential=".bytes();
            match (findBytes(value, marker, 0)) {
                Some(at) => value[at + marker.length..],
                null => { return null; }
            }
        }
        null => match (paramOf(req, "X-Amz-Credential")) {
            Some(v) => v,
            null => { return null; }
        },
    };
    var field: usize = 0;
    var start: usize = 0;
    for (i in 0..credential.length) {
        let c = credential[i];
        if (c == '/' || c == ',' || c == ' ') {
            if (field == n) { return Some(credential[start..i]); }
            if (c != '/') { return null; }
            field += 1;
            start = i + 1;
        }
    }
    return null;
}

/// Whether `req` is signed for `s3express` (ADR-0080 §4). Read again after the signature checked, which took only
/// `s3` and `s3express` for S3's calls.
fn signedForExpress(req: borrow S3Request) -> bool => match (scopeField(req, 3)) {
    Some(service) => service == EXPRESS_SERVICE.bytes(),
    null => false,
};

/// What authentication found.
struct Authenticated {
    payload: PayloadMode;
    signer: ChunkSigner?;
    /// The access key that signed, by its place in the credentials; null for an anonymous request (ADR-0043). For
    /// temporary credentials, the key that asked for them.
    key: usize?;
    /// Temporary credentials' session (ADR-0075), its secret wiped.
    session: StsSession?;
}

struct S3Request {
    method: Method;
    methodText: Vector<u8>;
    headers: Vector<HeaderPair>;
    rawPath: Vector<u8>;
    rawQuery: Vector<u8>;
    /// Decoded; empty for the service (`/`) and for a bucket's own requests.
    bucket: String;
    key: String;
    query: Vector<QueryParam>;

    /// An SSE-C key in the request's fields (its own or a copy source's, in base64) is wiped when the request is done
    /// (ADR-0046 §6), so it is not left in freed memory.
    drop {
        for (i in 0..this.headers.length) {
            if (isCustomerKeyField(this.headers[i].name.view())) {
                for (k in 0..this.headers[i].value.length) { this.headers[i].value[k] = 0; }
            }
        }
    }

    /// The request's parts, or InvalidArgument for a path or query that does not decode to UTF-8. With a `domain`,
    /// a Host of `<bucket>.<domain>` names the bucket (virtual-host addressing), and the whole path is the key.
    fn of(request: borrow Request, domain: Slice<u8>) -> Result<S3Request, S3Fail> {
        var r = S3Request {
            method: request.method(),
            methodText: Vector<u8>.create(),
            headers: Vector<HeaderPair>.create(),
            rawPath: Vector<u8>.create(),
            rawQuery: Vector<u8>.create(),
            bucket: String.create(),
            key: String.create(),
            query: Vector<QueryParam>.create(),
        };
        r.methodText.extend(request.methodToken())?;
        let fields = request.headers();
        for (i in 0..fields.count()) {
            var p = HeaderPair { name: Vector<u8>.create(), value: Vector<u8>.create() };
            let name = fields.nameBytes(i);
            for (k in 0..name.length) { p.name.push(lowerAscii(name[k]))?; }
            p.value.extend(fields.value(i))?;
            r.headers.push(p)?;
        }
        let path = request.path().bytes();
        r.rawPath.extend(path)?;
        match (request.query()) {
            Some(q) => { r.rawQuery.extend(q.bytes())?; }
            null => {}
        }
        let start: usize = if (path.length > 0 && path[0] == '/') 1 else 0;
        var decoded = Vector<u8>.create();
        var hostBucket = Vector<u8>.create();
        virtualBucket(headerOf(borrow r, "host") ?? "".bytes(), domain, mut hostBucket)?;
        if (hostBucket.length > 0) {
            // /key, under <bucket>.<domain>.
            appendUtf8(mut r.bucket, hostBucket.view())?;
            // A directory bucket's key has no empty first directory, as path-style below (ADR-0080 §9).
            let keyStart = if (directoryNamed(r.bucket.bytes()) && path.length > 1 && path[0] == '/' &&
                path[1] == '/') 2 else start;
            if (!percentDecodeInto(mut decoded, path[keyStart..], false)?) {
                return Err(S3Fail.Code(S3Code.InvalidArgument));
            }
            appendUtf8(mut r.key, decoded.view())?;
            r.parseQuery()?;
            return Ok(r);
        }
        // /bucket/key: the key is everything after the bucket's slash, slashes included.
        let slash = pieceEnd(path, start, '/');
        if (!percentDecodeInto(mut decoded, path[start..slash], false)?) {
            return Err(S3Fail.Code(S3Code.InvalidArgument));
        }
        appendUtf8(mut r.bucket, decoded.view())?;
        if (slash < path.length) {
            decoded.clear();
            // The JavaScript SDK writes a directory bucket's path-style requests as `/<bucket>//<key>` (`//` for the
            // bucket itself): one slash more there is no key's (ADR-0080 §9).
            let keyStart = if (directoryNamed(r.bucket.bytes())) {
                if (slash + 1 < path.length && path[slash + 1] == '/') slash + 2 else slash + 1
            } else slash + 1;
            if (!percentDecodeInto(mut decoded, path[keyStart..], false)?) {
                return Err(S3Fail.Code(S3Code.InvalidArgument));
            }
            appendUtf8(mut r.key, decoded.view())?;
        }
        r.parseQuery()?;
        return Ok(r);
    }

    fn parseQuery(borrow mut this) -> Result<void, S3Fail> {
        let raw = this.rawQuery.view();
        var at: usize = 0;
        while (at < raw.length) {
            let end = pieceEnd(raw, at, '&');
            let part = raw[at..end];
            at = end + 1;
            if (part.length == 0) { continue; }
            let eq = pieceEnd(part, 0, '=');
            var p = QueryParam { name: Vector<u8>.create(), value: Vector<u8>.create() };
            if (!percentDecodeInto(mut p.name, part[0..eq], true)?) { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            if (eq < part.length && !percentDecodeInto(mut p.value, part[eq + 1..], true)?) {
                return Err(S3Fail.Code(S3Code.InvalidArgument));
            }
            this.query.push(p)?;
        }
        this.hoistQueryHeaders()?;
        return Ok();
    }

    /// A presigned URL carries some `x-amz-*` headers in its query (presigners hoist them), and the signature covers
    /// them there. Each one stands for the header it names, unless the request also sends that header (ADR-0013).
    /// Only presigned requests do this: for header auth the query's `x-amz-*` would be unsigned headers.
    fn hoistQueryHeaders(borrow mut this) -> Result<void, AllocError> {
        if (!this.hasParam("X-Amz-Algorithm")) { return Ok(); }
        var hoisted = Vector<HeaderPair>.create();
        for (i in 0..this.query.length) {
            let name = this.query[i].name.view();
            if (name.length <= 6 || !equalsIgnoreCase(name[0..6], "x-amz-".bytes()) || isQueryAuthParam(name)) {
                continue;
            }
            var lower = Vector<u8>.create();
            for (c in name) { lower.push(lowerAscii(c))?; }
            var present = false;
            for (h in 0..this.headers.length) {
                if (this.headers[h].name.view() == lower.view()) { present = true; }
            }
            if (present) { continue; }
            var value = Vector<u8>.create();
            value.extend(this.query[i].value.view())?;
            hoisted.push(HeaderPair { name: lower, value: value })?;
        }
        for (h in 0..hoisted.length) {
            this.headers.push(
                replace(mut hoisted[h], HeaderPair { name: Vector<u8>.create(), value: Vector<u8>.create() }),
            )?;
        }
        return Ok();
    }

    fn hasParam(borrow this, name: StringView) -> bool {
        for (i in 0..this.query.length) {
            if (this.query[i].name.view() == name.bytes()) { return true; }
        }
        return false;
    }

    /// Whether every query parameter is among `allowed` (comma-separated), one S3 ignores (`x-id`), or a presigned
    /// URL's `X-Amz-*`.
    fn onlyParams(borrow this, allowed: StringView) -> bool {
        for (i in 0..this.query.length) {
            let name = this.query[i].name.view();
            if (name == "x-id".bytes() || (name.length > 6 && equalsIgnoreCase(name[0..6], "x-amz-".bytes()))) {
                continue;
            }
            var found = false;
            let list = allowed.bytes();
            var at: usize = 0;
            while (at < list.length) {
                let end = pieceEnd(list, at, ',');
                if (list[at..end] == name) { found = true; }
                at = end + 1;
            }
            if (!found) { return false; }
        }
        return true;
    }

    /// The SigV4 check: the Authorization header (ADR-0008 §5), or a presigned URL's query (ADR-0011).
    /// Whether the request carries no credentials at all: no Authorization header and no presigned-URL parameters
    /// (ADR-0043 §1).
    fn isAnonymous(borrow this) -> bool =>
        headerOf(this, "authorization").isNull() && paramOf(this, "X-Amz-Algorithm").isNull() &&
            paramOf(this, "AWSAccessKeyId").isNull();

    /// An anonymous request's body (ADR-0043 §7): unsigned, unless `x-amz-content-sha256` gives a digest to check or
    /// unsigned aws-chunked; a signed stream without a signature is InvalidRequest.
    fn anonymous(borrow this) -> Result<Authenticated, S3Code> {
        let none = Authenticated { payload: PayloadMode.Unsigned, signer: null, key: null, session: null };
        let hash = match (headerOf(this, "x-amz-content-sha256")) {
            Some(h) => h,
            null => { return Ok(none); }
        };
        if (hash == "UNSIGNED-PAYLOAD".bytes()) { return Ok(none); }
        if (hash == "STREAMING-UNSIGNED-PAYLOAD-TRAILER".bytes()) {
            return Ok(Authenticated { payload: PayloadMode.Chunked, signer: null, key: null, session: null });
        }
        if (hash.length != 64) { return Err(S3Code.InvalidRequest); }
        var digest = [0u8; 32];
        for (i in 0..32) {
            let hi = hexValue(hash[i * 2]);
            let lo = hexValue(hash[i * 2 + 1]);
            if (hi.isNull() || lo.isNull()) { return Err(S3Code.InvalidArgument); }
            digest[i] = ((hi ?? 0) << 4) | (lo ?? 0);
        }
        return Ok(Authenticated { payload: PayloadMode.Hashed(digest), signer: null, key: null, session: null });
    }

    /// `service` is the scope's (`s3`, or `sts` for STS's calls, ADR-0075); `bodyHash`, when given, is the body's
    /// SHA-256 in hex, for calls (STS's) whose clients send no `x-amz-content-sha256`.
    fn authenticate(
        borrow this,
        credentials: Slice<Credential>,
        sts: Slice<MasterKey>,
        now: i64,
        service: StringView,
        bodyHash: Slice<u8>?,
    ) -> Result<Authenticated, S3Code> {
        match (headerOf(this, "authorization")) {
            Some(value) => {
                if (startsWithBytes(value, "AWS ".bytes())) { return Err(S3Code.AuthorizationMechanism); } // SigV2
                let auth = match (parseAuthorization(value)) {
                    Ok(a) => a,
                    Err(_) => { return Err(S3Code.AuthorizationHeaderMalformed); }
                };
                let amzDate = match (headerOf(this, "x-amz-date")) {
                    Some(v) => v,
                    null => { return Err(S3Code.AccessDenied); }
                };
                let when = match (parseAmzDate(amzDate)) {
                    Some(v) => v,
                    null => { return Err(S3Code.AccessDenied); }
                };
                let skew = if (when > now) when - now else now - when;
                if (skew > 900) { return Err(S3Code.RequestTimeTooSkewed); }
                let payloadHash = match (bodyHash ?? headerOf(this, "x-amz-content-sha256")) {
                    Some(v) => v,
                    null => { return Err(S3Code.InvalidRequest); }
                };
                return this.verify(
                    credentials,
                    sts,
                    now,
                    service,
                    borrow auth,
                    amzDate,
                    payloadHash,
                    this.rawQuery.view(),
                );
            }
            null => {}
        }
        if (paramOf(this, "X-Amz-Algorithm").isSome()) {
            if (service != "s3") { return Err(S3Code.AccessDenied); }
            return this.authenticateQuery(credentials, sts, now);
        }
        if (paramOf(this, "AWSAccessKeyId").isSome()) { return Err(S3Code.AuthorizationMechanism); } // SigV2
        return Err(S3Code.AccessDenied);
    }

    /// A presigned URL: X-Amz-Algorithm, -Credential, -Date, -Expires, -SignedHeaders and -Signature in the query,
    /// which is signed without its signature. The payload is UNSIGNED-PAYLOAD unless a header says otherwise.
    fn authenticateQuery(
        borrow this,
        credentials: Slice<Credential>,
        sts: Slice<MasterKey>,
        now: i64,
    ) -> Result<Authenticated, S3Code> {
        let malformed = S3Code.AuthorizationQueryParametersError;
        if ((paramOf(this, "X-Amz-Algorithm") ?? "".bytes()) != "AWS4-HMAC-SHA256".bytes()) { return Err(malformed); }
        let credential = match (paramOf(this, "X-Amz-Credential")) {
            Some(v) => v,
            null => { return Err(malformed); }
        };
        let signedHeaders = match (paramOf(this, "X-Amz-SignedHeaders")) {
            Some(v) => v,
            null => { return Err(malformed); }
        };
        let signature = match (paramOf(this, "X-Amz-Signature")) {
            Some(v) => v,
            null => { return Err(malformed); }
        };
        let amzDate = match (paramOf(this, "X-Amz-Date")) {
            Some(v) => v,
            null => { return Err(malformed); }
        };
        // A number of seconds, 1 to 604,800 (a week). Zero, a negative number, or more than a week is AccessDenied, as
        // S3 answers; anything that is not a number is malformed.
        let expiresText = paramOf(this, "X-Amz-Expires") ?? "".bytes();
        let negative = expiresText.length > 1 && expiresText[0] == '-';
        let expires = match (parseDecimal(if (negative) expiresText[1..] else expiresText)) {
            Some(v) => v,
            null => { return Err(malformed); }
        };
        if (negative || expires < 1 || expires > 604800) { return Err(S3Code.AccessDenied); }
        // The same fields as an Authorization header, so one parser checks them.
        var header = Vector<u8>.create();
        mapOom(header.extend("AWS4-HMAC-SHA256 Credential=".bytes()))?;
        mapOom(header.extend(credential))?;
        mapOom(header.extend(", SignedHeaders=".bytes()))?;
        mapOom(header.extend(signedHeaders))?;
        mapOom(header.extend(", Signature=".bytes()))?;
        mapOom(header.extend(signature))?;
        let auth = match (parseAuthorization(header.view())) {
            Ok(a) => a,
            Err(_) => { return Err(malformed); }
        };
        let when = match (parseAmzDate(amzDate)) {
            Some(v) => v,
            null => { return Err(malformed); }
        };
        if (when > now + 900) { return Err(S3Code.AccessDenied); }                    // not valid yet
        if (now > when + truncate<i64>(expires)) { return Err(S3Code.AccessDenied); } // expired
        var query = Vector<u8>.create();
        mapOom(queryWithout(this.rawQuery.view(), "X-Amz-Signature".bytes(), mut query))?;
        let payloadHash = headerOf(this, "x-amz-content-sha256") ?? paramOf(this, "X-Amz-Content-Sha256") ??
            "UNSIGNED-PAYLOAD".bytes();
        return this.verify(credentials, sts, now, "s3", borrow auth, amzDate, payloadHash, query.view());
    }

    /// Checks a signature over the canonical request with `query`, then says how the payload is covered.
    fn verify(
        borrow this,
        credentials: Slice<Credential>,
        sts: Slice<MasterKey>,
        now: i64,
        service: StringView,
        auth: borrow AuthHeader,
        amzDate: Slice<u8>,
        payloadHash: Slice<u8>,
        query: Slice<u8>,
    ) -> Result<Authenticated, S3Code> {
        // S3's calls are signed for `s3`, or for `s3express` (directory buckets, ADR-0080 §4); the dispatch decides
        // what an `s3express` signature may reach (`signedForExpress`).
        let express = service == "s3" && auth.service.view() == EXPRESS_SERVICE.bytes();
        if (auth.service.view() != service.bytes() && !express) { return Err(S3Code.AuthorizationHeaderMalformed); }
        var found: usize? = null;
        // Temporary credentials (ADR-0075 §1): the token, sealed by this server, holds the secret and the key that
        // asked for them, which must still be in the credentials.
        var session: StsSession? = null;
        // A CreateSession token (ADR-0080 §4) is a session of its key with no role; its bucket and mode are checked at
        // the dispatch (`checkExpressSession`). Signed for `s3express` (boto3) or `s3` (the AWS CRT's object calls).
        let fromExpress = match (headerOf(this, EXPRESS_TOKEN_FIELD)) {
            Some(token) => {
                if (headerOf(this, "x-amz-security-token").isSome() || paramOf(this, "X-Amz-Security-Token").isSome()) {
                    return Err(S3Code.InvalidRequest);
                }
                match (openExpressToken(sts, trimBlank(token))) {
                    Ok(Some(e)) => Some(StsSession {
                        accessKey: e.accessKey,
                        secret: e.secret,
                        parent: e.parent,
                        role: Vector<u8>.create(),
                        name: Vector<u8>.create(),
                        policy: Vector<u8>.create(),
                        expiresMs: e.expiresMs,
                    }),
                    Ok(null) => { return Err(S3Code.InvalidToken); }
                    Err(_) => { return Err(S3Code.InternalError); }
                }
            }
            null => null,
        };
        let stsToken = if (fromExpress.isSome()) null else headerOf(this, "x-amz-security-token") ?? paramOf(
            this,
            "X-Amz-Security-Token",
        );
        if (fromExpress.isSome() || stsToken.isSome()) {
            {
                let opened = match (fromExpress) {
                    Some(s) => s,
                    null => match (openStsToken(sts, trimBlank(stsToken ?? "".bytes()))) {
                        Ok(Some(s)) => s,
                        Ok(null) => { return Err(S3Code.InvalidToken); }
                        Err(_) => { return Err(S3Code.InternalError); }
                    },
                };
                if (!sameSignature(opened.accessKey.view(), auth.accessKey.view())) { return Err(S3Code.InvalidToken); }
                if (opened.expiresMs <= now * 1000) { return Err(S3Code.ExpiredToken); }
                for (i in 0..credentials.length) {
                    if (!credentials[i].revoked && credentials[i].accessKey.view() == opened.parent.view()) {
                        found = Some(i);
                    }
                }
                if (found.isNull()) { return Err(S3Code.InvalidToken); }
                session = Some(opened);
            }
        } else {
            for (i in 0..credentials.length) {
                if (!credentials[i].revoked && sameSignature(credentials[i].accessKey.view(), auth.accessKey.view())) {
                    found = Some(i);
                }
            }
        }
        let place = match (found) {
            Some(i) => i,
            null => { return Err(S3Code.InvalidAccessKeyId); }
        };
        let credential = borrow credentials[place];
        if (amzDate.length < 8 || amzDate[0..8] != auth.date.view()) { return Err(S3Code.SignatureDoesNotMatch); }
        var canonical = Vector<u8>.create();
        // SigV4 encodes a path once more for every service but S3 (S3 Tables' ARNs, ADR-0083 §1).
        var path = Vector<u8>.create();
        if (service == "s3tables") {
            mapOom(encodePathAgain(this.rawPath.view(), mut path))?;
        } else {
            mapOom(path.extend(this.rawPath.view()))?;
        }
        let complete = mapOom(canonicalRequest(
            this.methodText.view(),
            path.view(),
            query,
            this.headers.view(),
            auth.signedHeaders.view(),
            payloadHash,
            mut canonical,
        ))?;
        if (!complete) { return Err(S3Code.SignatureDoesNotMatch); }
        let signing = match (borrow mut session) {
            Some(s) => {
                // A session's key is not cached: its secret is its own, and is wiped once used.
                let k = mapOom(signingKey(s.secret.view(), auth.date.view(), auth.region.view(), auth.service.view()))?;
                for (i in 0..s.secret.length) { s.secret[i] = 0; }
                k
            }
            null => mapOom(cachedSigningKey(
                borrow credential.signing,
                credential.secret.view(),
                auth.date.view(),
                auth.region.view(),
                auth.service.view(),
            ))?,
        };
        var seed = Vector<u8>.create();
        mapOom(seedSignature(borrow signing, amzDate, auth.scope.view(), canonical.view(), mut seed))?;
        if (!sameSignature(seed.view(), auth.signature.view())) { return Err(S3Code.SignatureDoesNotMatch); }

        if (payloadHash == "UNSIGNED-PAYLOAD".bytes()) {
            return Ok(Authenticated { payload: PayloadMode.Unsigned, signer: null, key: found, session: session });
        }
        if (payloadHash == "STREAMING-UNSIGNED-PAYLOAD-TRAILER".bytes()) {
            return Ok(Authenticated { payload: PayloadMode.Chunked, signer: null, key: found, session: session });
        }
        if (payloadHash == "STREAMING-AWS4-HMAC-SHA256-PAYLOAD".bytes() ||
            payloadHash == "STREAMING-AWS4-HMAC-SHA256-PAYLOAD-TRAILER".bytes()) {
            var signer = ChunkSigner {
                key: signing,
                amzDate: Vector<u8>.create(),
                scope: Vector<u8>.create(),
                previous: Vector<u8>.create(),
            };
            mapOom(signer.amzDate.extend(amzDate))?;
            mapOom(signer.scope.extend(auth.scope.view()))?;
            mapOom(signer.previous.extend(seed.view()))?;
            return Ok(Authenticated { payload: PayloadMode.Chunked, signer: signer, key: found, session: session });
        }
        if (payloadHash.length == 64) {
            var digest = [0u8; 32];
            for (i in 0..32) {
                let hi = hexValue(payloadHash[i * 2]);
                let lo = hexValue(payloadHash[i * 2 + 1]);
                if (hi.isNull() || lo.isNull()) { return Err(S3Code.InvalidArgument); }
                digest[i] = ((hi ?? 0) << 4) | (lo ?? 0);
            }
            return Ok(
                Authenticated { payload: PayloadMode.Hashed(digest), signer: null, key: found, session: session },
            );
        }
        return Err(S3Code.InvalidArgument);
    }
}

/// Whether `name` is one of query auth's own parameters, which are not hoisted headers.
fn isQueryAuthParam(name: Slice<u8>) -> bool {
    let names = [
        "X-Amz-Algorithm", "X-Amz-Credential", "X-Amz-Date", "X-Amz-Expires", "X-Amz-SignedHeaders",
        "X-Amz-Signature", "X-Amz-Security-Token", "X-Amz-Content-Sha256",
    ];
    for (n in names) {
        if (equalsIgnoreCase(name, n.bytes())) { return true; }
    }
    return false;
}

/// The raw query without the parameter `name` (as sent, not decoded).
fn queryWithout(raw: Slice<u8>, name: Slice<u8>, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    var at: usize = 0;
    while (at < raw.length) {
        let end = pieceEnd(raw, at, '&');
        let part = raw[at..end];
        at = end + 1;
        let eq = pieceEnd(part, 0, '=');
        if (part.length == 0 || part[0..eq] == name) { continue; }
        if (out.length > 0) { out.push('&')?; }
        out.extend(part)?;
    }
    return Ok();
}

/// The bucket a Host of `<bucket>.<domain>` (any port) names, into `out`; nothing for any other Host or no domain.
fn virtualBucket(host: Slice<u8>, domain: Slice<u8>, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    if (domain.length == 0) { return Ok(); }
    let name = host[0..pieceEnd(host, 0, ':')];
    if (name.length <= domain.length + 1) { return Ok(); }
    let dot = name.length - domain.length - 1;
    if (name[dot] != '.' || !equalsIgnoreCase(name[dot + 1..], domain)) { return Ok(); }
    out.extend(name[0..dot])?;
    return Ok();
}

/// The field `name` (lowercase) of `r`, its first value.
fn headerOf<region a>(r: borrow(a) S3Request, name: StringView) -> Slice<a, u8>? {
    for (i in 0..r.headers.length) {
        if (r.headers[i].name.view() == name.bytes()) { return Some(r.headers[i].value.view()); }
    }
    return null;
}

/// The query parameter `name` of `r`, decoded.
fn paramOf<region a>(r: borrow(a) S3Request, name: StringView) -> Slice<a, u8>? {
    for (i in 0..r.query.length) {
        if (r.query[i].name.view() == name.bytes()) { return Some(r.query[i].value.view()); }
    }
    return null;
}

fn mapOom<T>(r: Result<T, AllocError>) -> Result<T, S3Code> => match (r) {
    Ok(v) => Ok(v),
    Err(_) => Err(S3Code.InternalError),
};

/// Appends `bytes` if they are UTF-8; else InvalidArgument.
fn appendUtf8(out: borrow mut String, bytes: Slice<u8>) -> Result<void, S3Fail> {
    match (StringView.fromUtf8(bytes)) {
        Some(t) => { out.append(t)?; }
        null => { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
    }
    return Ok();
}

/// How a handler fails: with an S3 error to send, or with the exchange's own failure.
enum S3Fail {
    Code(S3Code),
    @from Http(HandlerError),
    @from OutOfMemory(AllocError),
}

/// A path as it came, URI-encoded again (`%` becomes `%25`), as SigV4's canonical request has it for services
/// other than S3.
fn encodePathAgain(path: Slice<u8>, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    let hex = "0123456789ABCDEF".bytes();
    for (c in path) {
        let unreserved = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' ||
            c == '_' || c == '.' || c == '~' || c == '/';
        if (unreserved) {
            out.push(c)?;
        } else {
            out.push('%')?;
            out.push(hex[(c >> 4) as usize])?;
            out.push(hex[(c & 15) as usize])?;
        }
    }
    return Ok();
}
