// The IAM API's records (ADR-0104, ADR-0108): users with their access keys and inline policies, roles with their trust
// and inline policies, groups, and managed policies with their versions, kept in one record of the hidden bucket `_cosmostore-iam`, and merged with the users and roles
// files into the credential and role sets (§4). The files stay the operator's: a name in both keeps the API's, and the
// file's entry is skipped (§5).

/// The hidden bucket the records live in, and the record.
const IAM_BUCKET: StringView = "_cosmostore-iam";
const IAM_STATE_KEY: StringView = "state";
/// A user holds two access keys at most, as on AWS.
const IAM_MAX_KEYS: usize = 2;

struct IamKey {
    accessKey: Vector<u8>;
    secret: Vector<u8>;
    active: bool;
    createdMs: i64;
}

/// An inline policy: its name and its document, as given.
struct IamPolicy {
    name: Vector<u8>;
    text: Vector<u8>;
}

/// A tag of a user, role or managed policy, as given.
struct IamTag {
    key: Vector<u8>;
    value: Vector<u8>;
}

struct IamUser {
    name: Vector<u8>;
    id: Vector<u8>;
    createdMs: i64;
    keys: Vector<IamKey>;
    policies: Vector<IamPolicy>;
    /// Its path (`/` unless given), shown in its ARN (ADR-0108 §3).
    path: Vector<u8>;
    tags: Vector<IamTag>;
    /// The ARNs of the managed policies attached to it.
    attached: Vector<Vector<u8>>;
}

struct IamRole {
    name: Vector<u8>;
    id: Vector<u8>;
    createdMs: i64;
    /// Its trust policy (`AssumeRolePolicyDocument`), as given.
    trust: Vector<u8>;
    policies: Vector<IamPolicy>;
    maxSeconds: u64;
    path: Vector<u8>;
    tags: Vector<IamTag>;
    attached: Vector<Vector<u8>>;
    description: Vector<u8>;
}

/// A version of a managed policy, `v<number>`: its document as given.
struct IamPolicyVersion {
    number: u32;
    text: Vector<u8>;
    createdMs: i64;
}

/// A managed policy (ADR-0108 §1): up to five versions, one of them the default, attached by its ARN,
/// `arn:aws:iam::000000000000:policy<path><name>`.
struct IamManagedPolicy {
    name: Vector<u8>;
    id: Vector<u8>;
    path: Vector<u8>;
    description: Vector<u8>;
    createdMs: i64;
    updatedMs: i64;
    tags: Vector<IamTag>;
    versions: Vector<IamPolicyVersion>;
    defaultVersion: u32;
    /// The number the next version takes: numbers are not used again, as on AWS.
    nextVersion: u32;
}

/// A group: its members (user names), and inline and attached policies its members' identity policies join.
struct IamGroup {
    name: Vector<u8>;
    id: Vector<u8>;
    path: Vector<u8>;
    createdMs: i64;
    members: Vector<Vector<u8>>;
    policies: Vector<IamPolicy>;
    attached: Vector<Vector<u8>>;
}

/// Everything the API has made.
struct IamState {
    users: Vector<IamUser>;
    roles: Vector<IamRole>;
    groups: Vector<IamGroup>;
    managed: Vector<IamManagedPolicy>;

    fn empty() -> IamState => IamState {
        users: Vector<IamUser>.create(),
        roles: Vector<IamRole>.create(),
        groups: Vector<IamGroup>.create(),
        managed: Vector<IamManagedPolicy>.create(),
    };
}

/// The record's form: 2 since ADR-0108 (groups, managed policies, paths, tags). A record of form 1 is read too, with
/// none of those.
const IAM_RECORD_VERSION: i64 = 2;

// ---- The record ----

fn policiesJson(policies: Slice<IamPolicy>) -> Result<Json, AllocError> {
    var out = jsonArray();
    for (i in 0..policies.length) {
        var p = jsonObject();
        jsonSet(mut p, "name", Json.Text(copyBytes(policies[i].name.view())?))?;
        jsonSet(mut p, "text", Json.Text(copyBytes(policies[i].text.view())?))?;
        jsonPush(mut out, p)?;
    }
    return Ok(out);
}

fn tagsJson(tags: Slice<IamTag>) -> Result<Json, AllocError> {
    var out = jsonArray();
    for (i in 0..tags.length) {
        var t = jsonObject();
        jsonSet(mut t, "key", Json.Text(copyBytes(tags[i].key.view())?))?;
        jsonSet(mut t, "value", Json.Text(copyBytes(tags[i].value.view())?))?;
        jsonPush(mut out, t)?;
    }
    return Ok(out);
}

fn namesJson(names: Slice<Vector<u8>>) -> Result<Json, AllocError> {
    var out = jsonArray();
    for (i in 0..names.length) { jsonPush(mut out, Json.Text(copyBytes(names[i].view())?))?; }
    return Ok(out);
}

fn copyNames(names: Slice<Vector<u8>>) -> Result<Vector<Vector<u8>>, AllocError> {
    var out = Vector<Vector<u8>>.create();
    for (i in 0..names.length) { out.push(copyBytes(names[i].view())?)?; }
    return Ok(out);
}

fn copyTags(tags: Slice<IamTag>) -> Result<Vector<IamTag>, AllocError> {
    var out = Vector<IamTag>.create();
    for (i in 0..tags.length) {
        out.push(IamTag { key: copyBytes(tags[i].key.view())?, value: copyBytes(tags[i].value.view())? })?;
    }
    return Ok(out);
}

fn copyPolicies(policies: Slice<IamPolicy>) -> Result<Vector<IamPolicy>, AllocError> {
    var out = Vector<IamPolicy>.create();
    for (i in 0..policies.length) {
        out.push(IamPolicy { name: copyBytes(policies[i].name.view())?, text: copyBytes(policies[i].text.view())? })?;
    }
    return Ok(out);
}

/// The record's JSON.
fn encodeIamState(s: borrow IamState) -> Result<Vector<u8>, AllocError> {
    var users = jsonArray();
    for (i in 0..s.users.length) {
        let u = borrow s.users[i];
        var keys = jsonArray();
        for (k in 0..u.keys.length) {
            var key = jsonObject();
            jsonSet(mut key, "accessKey", Json.Text(copyBytes(u.keys[k].accessKey.view())?))?;
            jsonSet(mut key, "secret", Json.Text(copyBytes(u.keys[k].secret.view())?))?;
            jsonSet(mut key, "active", Json.Bool(u.keys[k].active))?;
            jsonSet(mut key, "created", jsonInteger(u.keys[k].createdMs)?)?;
            jsonPush(mut keys, key)?;
        }
        var user = jsonObject();
        jsonSet(mut user, "name", Json.Text(copyBytes(u.name.view())?))?;
        jsonSet(mut user, "id", Json.Text(copyBytes(u.id.view())?))?;
        jsonSet(mut user, "created", jsonInteger(u.createdMs)?)?;
        jsonSet(mut user, "keys", keys)?;
        jsonSet(mut user, "policies", policiesJson(u.policies.view())?)?;
        jsonSet(mut user, "path", Json.Text(copyBytes(u.path.view())?))?;
        jsonSet(mut user, "tags", tagsJson(u.tags.view())?)?;
        jsonSet(mut user, "attached", namesJson(u.attached.view())?)?;
        jsonPush(mut users, user)?;
    }
    var roles = jsonArray();
    for (i in 0..s.roles.length) {
        let r = borrow s.roles[i];
        var role = jsonObject();
        jsonSet(mut role, "name", Json.Text(copyBytes(r.name.view())?))?;
        jsonSet(mut role, "id", Json.Text(copyBytes(r.id.view())?))?;
        jsonSet(mut role, "created", jsonInteger(r.createdMs)?)?;
        jsonSet(mut role, "trust", Json.Text(copyBytes(r.trust.view())?))?;
        jsonSet(mut role, "maxSeconds", jsonInteger(truncate<i64>(r.maxSeconds))?)?;
        jsonSet(mut role, "policies", policiesJson(r.policies.view())?)?;
        jsonSet(mut role, "path", Json.Text(copyBytes(r.path.view())?))?;
        jsonSet(mut role, "tags", tagsJson(r.tags.view())?)?;
        jsonSet(mut role, "attached", namesJson(r.attached.view())?)?;
        jsonSet(mut role, "description", Json.Text(copyBytes(r.description.view())?))?;
        jsonPush(mut roles, role)?;
    }
    var groups = jsonArray();
    for (i in 0..s.groups.length) {
        let g = borrow s.groups[i];
        var group = jsonObject();
        jsonSet(mut group, "name", Json.Text(copyBytes(g.name.view())?))?;
        jsonSet(mut group, "id", Json.Text(copyBytes(g.id.view())?))?;
        jsonSet(mut group, "path", Json.Text(copyBytes(g.path.view())?))?;
        jsonSet(mut group, "created", jsonInteger(g.createdMs)?)?;
        jsonSet(mut group, "members", namesJson(g.members.view())?)?;
        jsonSet(mut group, "policies", policiesJson(g.policies.view())?)?;
        jsonSet(mut group, "attached", namesJson(g.attached.view())?)?;
        jsonPush(mut groups, group)?;
    }
    var managed = jsonArray();
    for (i in 0..s.managed.length) {
        let m = borrow s.managed[i];
        var versions = jsonArray();
        for (v in 0..m.versions.length) {
            var version = jsonObject();
            jsonSet(mut version, "number", jsonInteger(m.versions[v].number as i64)?)?;
            jsonSet(mut version, "text", Json.Text(copyBytes(m.versions[v].text.view())?))?;
            jsonSet(mut version, "created", jsonInteger(m.versions[v].createdMs)?)?;
            jsonPush(mut versions, version)?;
        }
        var policy = jsonObject();
        jsonSet(mut policy, "name", Json.Text(copyBytes(m.name.view())?))?;
        jsonSet(mut policy, "id", Json.Text(copyBytes(m.id.view())?))?;
        jsonSet(mut policy, "path", Json.Text(copyBytes(m.path.view())?))?;
        jsonSet(mut policy, "description", Json.Text(copyBytes(m.description.view())?))?;
        jsonSet(mut policy, "created", jsonInteger(m.createdMs)?)?;
        jsonSet(mut policy, "updated", jsonInteger(m.updatedMs)?)?;
        jsonSet(mut policy, "tags", tagsJson(m.tags.view())?)?;
        jsonSet(mut policy, "versions", versions)?;
        jsonSet(mut policy, "default", jsonInteger(m.defaultVersion as i64)?)?;
        jsonSet(mut policy, "next", jsonInteger(m.nextVersion as i64)?)?;
        jsonPush(mut managed, policy)?;
    }
    var root = jsonObject();
    jsonSet(mut root, "version", jsonInteger(IAM_RECORD_VERSION)?)?;
    jsonSet(mut root, "users", users)?;
    jsonSet(mut root, "roles", roles)?;
    jsonSet(mut root, "groups", groups)?;
    jsonSet(mut root, "managed", managed)?;
    var out = Vector<u8>.create();
    writeJson(mut out, borrow root)?;
    return Ok(out);
}

/// A boolean member's value, if it is one.
fn jsonMemberBool(j: borrow Json, key: StringView) -> bool? {
    let v = jsonMember(j, key) ?? { return null; };
    return match (v) {
        Json.Bool(b) => Some(*b),
        _ => null,
    };
}

fn textMember(j: borrow Json, key: StringView) -> Result<Vector<u8>?, AllocError> => match (jsonMemberText(j, key)) {
    Some(t) => Ok(Some(copyBytes(t)?)),
    null => Ok(null),
};

fn policiesOf(j: borrow Json) -> Result<Vector<IamPolicy>?, AllocError> {
    var out = Vector<IamPolicy>.create();
    let items = memberItems(j, "policies") ?? { return Ok(null); };
    for (i in 0..items.length) {
        let name = textMember(borrow items[i], "name")? ?? { return Ok(null); };
        let text = textMember(borrow items[i], "text")? ?? { return Ok(null); };
        out.push(IamPolicy { name: name, text: text })?;
    }
    return Ok(Some(out));
}

/// A path, `/` when the record has none (form 1).
fn pathMember(j: borrow Json) -> Result<Vector<u8>?, AllocError> {
    if (jsonMember(j, "path").isNull()) { return Ok(Some(copyBytes("/".bytes())?)); }
    return textMember(j, "path");
}

/// Texts of `key`, none when the record has none (form 1); null when one is not a text.
fn namesMember(j: borrow Json, key: StringView) -> Result<Vector<Vector<u8>>?, AllocError> {
    var out = Vector<Vector<u8>>.create();
    if (jsonMember(j, key).isNull()) { return Ok(Some(out)); }
    let items = memberItems(j, key) ?? { return Ok(null); };
    for (i in 0..items.length) {
        match (borrow items[i]) {
            Json.Text(t) => { out.push(copyBytes(t.view())?)?; }
            _ => { return Ok(null); }
        }
    }
    return Ok(Some(out));
}

fn tagsMember(j: borrow Json) -> Result<Vector<IamTag>?, AllocError> {
    var out = Vector<IamTag>.create();
    if (jsonMember(j, "tags").isNull()) { return Ok(Some(out)); }
    let items = memberItems(j, "tags") ?? { return Ok(null); };
    for (i in 0..items.length) {
        let key = textMember(borrow items[i], "key")? ?? { return Ok(null); };
        let value = textMember(borrow items[i], "value")? ?? { return Ok(null); };
        out.push(IamTag { key: key, value: value })?;
    }
    return Ok(Some(out));
}

/// A text member, empty when the record has none.
fn textOrEmpty(j: borrow Json, key: StringView) -> Result<Vector<u8>?, AllocError> {
    if (jsonMember(j, key).isNull()) { return Ok(Some(Vector<u8>.create())); }
    return textMember(j, key);
}

/// The record read back; null when it is not one this reads.
fn decodeIamState(bytes: Slice<u8>) -> Result<IamState?, AllocError> {
    let root = parseJson(bytes)? ?? { return Ok(null); };
    let form = jsonMemberI64(borrow root, "version") ?? { return Ok(null); };
    if (form < 1 || form > IAM_RECORD_VERSION) { return Ok(null); }
    var out = IamState.empty();
    let users = memberItems(borrow root, "users") ?? { return Ok(null); };
    for (i in 0..users.length) {
        let u = borrow users[i];
        var keys = Vector<IamKey>.create();
        let items = memberItems(u, "keys") ?? { return Ok(null); };
        for (k in 0..items.length) {
            let key = borrow items[k];
            keys.push(IamKey {
                accessKey: textMember(key, "accessKey")? ?? { return Ok(null); },
                secret: textMember(key, "secret")? ?? { return Ok(null); },
                active: jsonMemberBool(key, "active") ?? { return Ok(null); },
                createdMs: jsonMemberI64(key, "created") ?? 0,
            })?;
        }
        out.users.push(IamUser {
            name: textMember(u, "name")? ?? { return Ok(null); },
            id: textMember(u, "id")? ?? { return Ok(null); },
            createdMs: jsonMemberI64(u, "created") ?? 0,
            keys: keys,
            policies: policiesOf(u)? ?? { return Ok(null); },
            path: pathMember(u)? ?? { return Ok(null); },
            tags: tagsMember(u)? ?? { return Ok(null); },
            attached: namesMember(u, "attached")? ?? { return Ok(null); },
        })?;
    }
    let roles = memberItems(borrow root, "roles") ?? { return Ok(null); };
    for (i in 0..roles.length) {
        let r = borrow roles[i];
        out.roles.push(IamRole {
            name: textMember(r, "name")? ?? { return Ok(null); },
            id: textMember(r, "id")? ?? { return Ok(null); },
            createdMs: jsonMemberI64(r, "created") ?? 0,
            trust: textMember(r, "trust")? ?? { return Ok(null); },
            policies: policiesOf(r)? ?? { return Ok(null); },
            maxSeconds: truncate<u64>(jsonMemberI64(r, "maxSeconds") ?? 3600),
            path: pathMember(r)? ?? { return Ok(null); },
            tags: tagsMember(r)? ?? { return Ok(null); },
            attached: namesMember(r, "attached")? ?? { return Ok(null); },
            description: textOrEmpty(r, "description")? ?? { return Ok(null); },
        })?;
    }
    if (jsonMember(borrow root, "groups").isSome()) {
        let groups = memberItems(borrow root, "groups") ?? { return Ok(null); };
        for (i in 0..groups.length) {
            let g = borrow groups[i];
            out.groups.push(IamGroup {
                name: textMember(g, "name")? ?? { return Ok(null); },
                id: textMember(g, "id")? ?? { return Ok(null); },
                path: pathMember(g)? ?? { return Ok(null); },
                createdMs: jsonMemberI64(g, "created") ?? 0,
                members: namesMember(g, "members")? ?? { return Ok(null); },
                policies: policiesOf(g)? ?? { return Ok(null); },
                attached: namesMember(g, "attached")? ?? { return Ok(null); },
            })?;
        }
    }
    if (jsonMember(borrow root, "managed").isSome()) {
        let managed = memberItems(borrow root, "managed") ?? { return Ok(null); };
        for (i in 0..managed.length) {
            let m = borrow managed[i];
            var versions = Vector<IamPolicyVersion>.create();
            let items = memberItems(m, "versions") ?? { return Ok(null); };
            for (v in 0..items.length) {
                let number = jsonMemberI64(borrow items[v], "number") ?? { return Ok(null); };
                versions.push(IamPolicyVersion {
                    number: checkedTruncate<u32>(number) ?? { return Ok(null); },
                    text: textMember(borrow items[v], "text")? ?? { return Ok(null); },
                    createdMs: jsonMemberI64(borrow items[v], "created") ?? 0,
                })?;
            }
            let defaultVersion = jsonMemberI64(m, "default") ?? { return Ok(null); };
            let nextVersion = jsonMemberI64(m, "next") ?? { return Ok(null); };
            out.managed.push(IamManagedPolicy {
                name: textMember(m, "name")? ?? { return Ok(null); },
                id: textMember(m, "id")? ?? { return Ok(null); },
                path: pathMember(m)? ?? { return Ok(null); },
                description: textOrEmpty(m, "description")? ?? { return Ok(null); },
                createdMs: jsonMemberI64(m, "created") ?? 0,
                updatedMs: jsonMemberI64(m, "updated") ?? 0,
                tags: tagsMember(m)? ?? { return Ok(null); },
                versions: versions,
                defaultVersion: checkedTruncate<u32>(defaultVersion) ?? { return Ok(null); },
                nextVersion: checkedTruncate<u32>(nextVersion) ?? { return Ok(null); },
            })?;
        }
    }
    return Ok(Some(out));
}

// ---- Merged with the files (ADR-0104 §4, §5) ----

/// What a user or role with no policy yet is given: a statement that allows only an action no request asks, so it is
/// allowed nothing by its own policy, as on AWS, while a bucket policy may still grant it (an explicit Deny would not
/// let it). A policy's statements cannot be empty (the policy parser refuses `[]`, as S3 does).
const IAM_NO_POLICY: StringView =
    "{\"Version\":\"2012-10-17\",\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:CosmoStoreNoPolicy\",\"Resource\":\"*\"}}";

/// The account's managed policies' ARNs begin so; AWS's own, so (ADR-0108 §4).
const IAM_POLICY_ARN: StringView = "arn:aws:iam::000000000000:policy";
const AWS_POLICY_ARN: StringView = "arn:aws:iam::aws:policy/";

/// AWS's managed policies that mean something to this store, each a fixed document (ADR-0108 §4, the owner's choice);
/// null for any other.
fn awsManagedPolicy(arn: Slice<u8>) -> StringView? {
    let p = AWS_POLICY_ARN.bytes();
    if (arn.length <= p.length || arn[0..p.length] != p) { return null; }
    let name = arn[p.length..];
    if (name == "AdministratorAccess".bytes()) {
        return Some(
            "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"*\"}]}",
        );
    }
    if (name == "AmazonS3FullAccess".bytes()) {
        return Some(
            "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"s3:*\",\"Resource\":\"*\"}]}",
        );
    }
    if (name == "AmazonS3ReadOnlyAccess".bytes()) {
        return Some(
            "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"s3:Get*\",\"s3:List*\",\"s3:Describe*\"],\"Resource\":\"*\"}]}",
        );
    }
    if (name == "IAMReadOnlyAccess".bytes()) {
        return Some(
            "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"iam:Get*\",\"iam:List*\"],\"Resource\":\"*\"}]}",
        );
    }
    return null;
}

/// Whether `arn` is the ARN of the account's managed policy `path` + `name`.
fn managedArnIs(arn: Slice<u8>, path: Slice<u8>, name: Slice<u8>) -> bool {
    let p = IAM_POLICY_ARN.bytes();
    if (arn.length != p.length + path.length + name.length) { return false; }
    return arn[0..p.length] == p &&
        arn[p.length..p.length + path.length] == path && arn[p.length + path.length..] == name;
}

/// The account's managed policy with ARN `arn`.
fn managedAt(iam: borrow IamState, arn: Slice<u8>) -> usize? {
    for (i in 0..iam.managed.length) {
        if (managedArnIs(arn, iam.managed[i].path.view(), iam.managed[i].name.view())) { return Some(i); }
    }
    return null;
}

/// Whether `arn` names a managed policy there is: the account's, or one of AWS's four.
fn managedArnKnown(iam: borrow IamState, arn: Slice<u8>) -> bool =>
    awsManagedPolicy(arn).isSome() || managedAt(iam, arn).isSome();

/// The default versions' documents of the managed policies `arns` names. One there is not is left out: an attach
/// checks it, and a policy attached is not deleted.
fn pushAttachedTexts(
    iam: borrow IamState,
    arns: Slice<Vector<u8>>,
    out: borrow mut Vector<Vector<u8>>,
) -> Result<void, AllocError> {
    for (a in 0..arns.length) {
        match (awsManagedPolicy(arns[a].view())) {
            Some(doc) => {
                out.push(copyBytes(doc.bytes())?)?;
                continue;
            }
            null => {}
        }
        let m = managedAt(iam, arns[a].view()) ?? { continue; };
        let policy = borrow iam.managed[m];
        for (v in 0..policy.versions.length) {
            if (policy.versions[v].number == policy.defaultVersion) {
                out.push(copyBytes(policy.versions[v].text.view())?)?;
            }
        }
    }
    return Ok();
}

fn pushInlineTexts(policies: Slice<IamPolicy>, out: borrow mut Vector<Vector<u8>>) -> Result<void, AllocError> {
    for (i in 0..policies.length) { out.push(copyBytes(policies[i].text.view())?)?; }
    return Ok();
}

/// Whether group `g` has user `name` among its members.
fn groupHolds(g: borrow IamGroup, name: Slice<u8>) -> bool {
    for (i in 0..g.members.length) {
        if (sameNameIgnoringCase(g.members[i].view(), name)) { return true; }
    }
    return false;
}

/// The documents user `u`'s identity policy joins (ADR-0108 §2): its inline policies, its attached policies' default
/// versions, and each of its groups' inline and attached policies.
fn userPolicyTexts(iam: borrow IamState, u: usize) -> Result<Vector<Vector<u8>>, AllocError> {
    var out = Vector<Vector<u8>>.create();
    let user = borrow iam.users[u];
    pushInlineTexts(user.policies.view(), mut out)?;
    pushAttachedTexts(iam, user.attached.view(), mut out)?;
    for (g in 0..iam.groups.length) {
        if (!groupHolds(borrow iam.groups[g], user.name.view())) { continue; }
        pushInlineTexts(iam.groups[g].policies.view(), mut out)?;
        pushAttachedTexts(iam, iam.groups[g].attached.view(), mut out)?;
    }
    return Ok(out);
}

/// The documents role `r`'s policy joins: its inline policies and its attached policies' default versions.
fn rolePolicyTexts(iam: borrow IamState, r: usize) -> Result<Vector<Vector<u8>>, AllocError> {
    var out = Vector<Vector<u8>>.create();
    pushInlineTexts(iam.roles[r].policies.view(), mut out)?;
    pushAttachedTexts(iam, iam.roles[r].attached.view(), mut out)?;
    return Ok(out);
}

/// A policy document joining the statements of `texts` (policy documents); IAM_NO_POLICY for none.
fn joinedPolicy(texts: Slice<Vector<u8>>) -> Result<Vector<u8>?, AllocError> {
    if (texts.length == 0) { return Ok(Some(copyBytes(IAM_NO_POLICY.bytes())?)); }
    var statements = jsonArray();
    for (i in 0..texts.length) {
        let doc = parseJson(texts[i].view())? ?? { return Ok(null); };
        let member = jsonMember(borrow doc, "Statement") ?? { return Ok(null); };
        match (member) {
            Json.Array(items) => {
                for (k in 0..items.length) { jsonPush(mut statements, cloneJson(borrow items[k])?)?; }
            }
            _ => { jsonPush(mut statements, cloneJson(member)?)?; }
        }
    }
    var root = jsonObject();
    jsonSet(mut root, "Version", Json.Text(copyBytes("2012-10-17".bytes())?))?;
    jsonSet(mut root, "Statement", statements)?;
    var out = Vector<u8>.create();
    writeJson(mut out, borrow root)?;
    return Ok(Some(out));
}

/// Whether `texts` joined are an identity policy the sets take: not past its size, say (the M21 exit review's finding
/// 1). Null when out of memory.
fn joinsToPolicy(texts: Slice<Vector<u8>>) -> Result<bool, AllocError> {
    let joined = joinedPolicy(texts)? ?? { return Ok(false); };
    return match (parseIdentityPolicy(joined.view())) {
        Ok(_) => Ok(true),
        Err(S3Fail.OutOfMemory(e)) => Err(e),
        Err(_) => Ok(false),
    };
}

/// The API's users and roles whose joined policies are not a policy, as `user:<name>` and `role:<name>`.
fn unjoinableEntities(iam: borrow IamState) -> Result<Vector<Vector<u8>>, AllocError> {
    var out = Vector<Vector<u8>>.create();
    for (u in 0..iam.users.length) {
        let texts = userPolicyTexts(iam, u)?;
        if (!joinsToPolicy(texts.view())?) {
            var n = copyBytes("user:".bytes())?;
            n.extend(iam.users[u].name.view())?;
            out.push(n)?;
        }
    }
    for (r in 0..iam.roles.length) {
        let texts = rolePolicyTexts(iam, r)?;
        if (!joinsToPolicy(texts.view())?) {
            var n = copyBytes("role:".bytes())?;
            n.extend(iam.roles[r].name.view())?;
            out.push(n)?;
        }
    }
    return Ok(out);
}

/// The policy a user or role of the API is given: its documents joined, or, when they do not join to a policy (past
/// its size, say), one that allows nothing, said on stderr: it fails closed, and the rest of the set is taken (the M21
/// exit review's finding 1: one user's policy had frozen the set for every user).
fn effectivePolicy(texts: Slice<Vector<u8>>, kind: StringView, name: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    if (joinsToPolicy(texts)?) { return Ok(joinedPolicy(texts)? ?? copyBytes(IAM_NO_POLICY.bytes())?); }
    var line = String.create();
    let _ = line.append("cosmostore: the IAM API's ");
    let _ = line.append(kind);
    let _ = line.append(" ");
    let _ = line.append(StringView.fromUtf8(name) ?? "?");
    let _ = line.append(
        ": its policies joined are not a policy (past its size?); it is allowed nothing until they are",
    );
    Console.writeErrorLine(line.view());
    return copyBytes(IAM_NO_POLICY.bytes());
}

/// The credentials file's keys and the API's active keys, in that order.
fn withIamKeys(fileKeys: Vector<Credential>, iam: borrow IamState) -> Result<Vector<Credential>, AllocError> {
    var out = fileKeys;
    for (u in 0..iam.users.length) {
        for (k in 0..iam.users[u].keys.length) {
            let key = borrow iam.users[u].keys[k];
            if (!key.active) { continue; }
            var known = false;
            for (i in 0..out.length) {
                if (out[i].accessKey.view() == key.accessKey.view()) { known = true; }
            }
            if (known) { continue; } // a key the file has too: the file's
            out.push(Credential {
                accessKey: copyBytes(key.accessKey.view())?,
                secret: copyBytes(key.secret.view())?,
                signing: SigningKeyCache.create(),
                revoked: false,
                user: Vector<u8>.create(),
                userKey: Vector<u8>.create(),
                policyText: Vector<u8>.create(),
                policy: null,
                path: Vector<u8>.create(),
                fromIam: true,
            })?;
        }
    }
    return Ok(out);
}

/// Whether an API user holds `key`, active or not.
fn iamHoldsKey(iam: borrow IamState, key: Slice<u8>) -> bool {
    for (u in 0..iam.users.length) {
        for (k in 0..iam.users[u].keys.length) {
            if (iam.users[u].keys[k].accessKey.view() == key) { return true; }
        }
    }
    return false;
}

/// The users the sets are decided by: the users file's, or, without one, the credentials file's keys as the account's;
/// then the API's users, whose names the file's give way to (ADR-0104 §5). `skipped` names the file's users left
/// out. Null when the API has no users and there is no users file: every key is then the account's, as before.
fn withIamUsers(
    file: UsersFile?,
    fileKeys: Slice<Credential>,
    iam: borrow IamState,
    skipped: borrow mut Vector<Vector<u8>>,
) -> Result<UsersFile?, String> {
    if (iam.users.length == 0) { return Ok(file); }
    let oom = textOf("out of memory");
    var out = match (file) {
        Some(f) => f,
        null => {
            // The credentials file's keys, never an API user's: those are the user's (the slice's test found a set's
            // whole list taken for the account's).
            var account = Vector<Vector<u8>>.create();
            for (i in 0..fileKeys.length) {
                if (iamHoldsKey(iam, fileKeys[i].accessKey.view())) { continue; }
                match (copyBytes(fileKeys[i].accessKey.view())) {
                    Ok(k) => {
                        if (account.push(k).isErr()) { return Err(oom); }
                    }
                    Err(_) => { return Err(oom); }
                }
            }
            UsersFile { account: account, users: Vector<UserEntry>.create() }
        }
    };
    var kept = Vector<UserEntry>.create();
    while (out.users.length > 0) {
        let entry = out.users.remove(0);
        var clash = false;
        for (u in 0..iam.users.length) {
            if (sameNameIgnoringCase(iam.users[u].name.view(), entry.name.view())) { clash = true; }
        }
        if (clash) {
            match (copyBytes(entry.name.view())) {
                Ok(n) => {
                    if (skipped.push(n).isErr()) { return Err(oom); }
                }
                Err(_) => { return Err(oom); }
            }
        } else if (kept.push(entry).isErr()) {
            return Err(oom);
        }
    }
    for (u in 0..iam.users.length) {
        let user = borrow iam.users[u];
        var keys = Vector<Vector<u8>>.create();
        for (k in 0..user.keys.length) {
            if (!user.keys[k].active) { continue; }
            match (copyBytes(user.keys[k].accessKey.view())) {
                Ok(c) => {
                    if (keys.push(c).isErr()) { return Err(oom); }
                }
                Err(_) => { return Err(oom); }
            }
        }
        let texts = userPolicyTexts(iam, u).ok() ?? { return Err(oom); };
        let policy = effectivePolicy(texts.view(), "user", user.name.view()).ok() ?? { return Err(oom); };
        let entry = UserEntry {
            name: copyBytes(user.name.view()).ok() ?? { return Err(oom); },
            id: copyBytes(user.id.view()).ok() ?? { return Err(oom); },
            keys: keys,
            policyText: policy,
            path: copyBytes(user.path.view()).ok() ?? { return Err(oom); },
        };
        if (kept.push(entry).isErr()) { return Err(oom); }
    }
    out.users = kept;
    return Ok(Some(out));
}

/// The roles file's roles and the API's, whose names the file's give way to (ADR-0104 §5).
fn withIamRoles(
    fileRoles: Vector<StsRole>,
    iam: borrow IamState,
    skipped: borrow mut Vector<Vector<u8>>,
) -> Result<Vector<StsRole>, AllocError> {
    var out = Vector<StsRole>.create();
    var rest = fileRoles;
    while (rest.length > 0) {
        let role = rest.remove(0);
        var clash = false;
        for (r in 0..iam.roles.length) {
            if (iam.roles[r].name.view() == role.name.view()) { clash = true; }
        }
        if (clash) {
            skipped.push(copyBytes(role.name.view())?)?;
        } else {
            out.push(role)?;
        }
    }
    for (r in 0..iam.roles.length) {
        let role = borrow iam.roles[r];
        let texts = rolePolicyTexts(iam, r)?;
        // A role whose policies do not join is kept, allowed nothing (the M21 exit review's finding 4: it had left the
        // set unsaid).
        let text = effectivePolicy(texts.view(), "role", role.name.view())?;
        let policy = match (parseIdentityPolicy(text.view())) {
            Ok(p) => p,
            Err(S3Fail.OutOfMemory(e)) => { return Err(e); }
            Err(_) => { continue; } // checked when it was put: a record that does not parse is left out
        };
        out.push(
            StsRole {
                name: copyBytes(role.name.view())?,
                maxSeconds: role.maxSeconds,
                policy: policy,
                removed: false,
                trust: copyBytes(role.trust.view())?,
                id: copyBytes(role.id.view())?,
                path: copyBytes(role.path.view())?,
            },
        )?;
    }
    return Ok(out);
}

// ---- Trust policies (ADR-0104 §7) ----

/// Whether a JSON value is, or is an array holding, a text one of `wanted` matches.
fn jsonNames(v: borrow Json, wanted: Slice<Vector<u8>>) -> bool {
    match (v) {
        Json.Text(t) => {
            for (w in 0..wanted.length) {
                if (t.view() == wanted[w].view()) { return true; }
            }
            return false;
        }
        Json.Array(items) => {
            for (i in 0..items.length) {
                if (jsonNames(borrow items[i], wanted)) { return true; }
            }
            return false;
        }
        _ => { return false; }
    }
}

/// Whether a trust policy uses only what `trustAllows` decides (the M19 exit review): every statement an Allow or a
/// Deny with a Principal and an Action; no Condition, NotPrincipal or NotAction, as ignoring them would widen who
/// may assume the role; and actions with a wildcard only `*` and `sts:*`, as a Deny of `sts:Assume*` would be missed.
fn trustSupported(doc: borrow Json) -> bool {
    let statement = jsonMember(doc, "Statement") ?? { return false; };
    return match (statement) {
        Json.Array(items) => {
            if (items.length == 0) { return false; }
            for (i in 0..items.length) {
                if (!trustStatementSupported(borrow items[i])) { return false; }
            }
            true
        },
        _ => trustStatementSupported(statement),
    };
}

fn trustStatementSupported(s: borrow Json) -> bool {
    for (refused in ["Condition", "NotPrincipal", "NotAction", "NotResource"]) {
        if (jsonMember(s, refused).isSome()) { return false; }
    }
    let effect = jsonMemberText(s, "Effect") ?? { return false; };
    if (effect != "Allow".bytes() && effect != "Deny".bytes()) { return false; }
    if (jsonMember(s, "Principal").isNull()) { return false; }
    let action = jsonMember(s, "Action") ?? { return false; };
    return match (action) {
        Json.Text(t) => trustActionSupported(t.view()),
        Json.Array(items) => {
            if (items.length == 0) { return false; }
            for (i in 0..items.length) {
                let ok = match (borrow items[i]) {
                    Json.Text(t) => trustActionSupported(t.view()),
                    _ => false,
                };
                if (!ok) { return false; }
            }
            true
        },
        _ => false,
    };
}

fn trustActionSupported(action: Slice<u8>) -> bool {
    if (action == "*".bytes() || action == "sts:*".bytes()) { return true; }
    for (i in 0..action.length) {
        if (action[i] == '*' || action[i] == '?') { return false; }
    }
    return true;
}

/// Whether a role's trust policy lets the caller assume it: the account (its keys: `user` none), or the user named.
/// A statement counts when its action covers `sts:AssumeRole` and its `AWS` principal names `*`, the account (its id or
/// `root`), or the user's ARN; a Deny that counts wins.
fn trustAllows(trust: Slice<u8>, user: borrow Vector<u8>?) -> Result<bool, AllocError> {
    let doc = parseJson(trust)? ?? { return Ok(false); };
    if (!trustSupported(borrow doc)) { return Ok(false); } // fails closed on what it cannot decide
    var principals = Vector<Vector<u8>>.create();
    principals.push(copyBytes("*".bytes())?)?;
    principals.push(copyBytes("000000000000".bytes())?)?;
    principals.push(copyBytes("arn:aws:iam::000000000000:root".bytes())?)?;
    match (user) {
        Some(u) => {
            // `u` is the user's path and name (`/tf/dave`), or a name at `/`: its ARN with its path (the M21 exit
            // review's finding 5).
            var arn = copyBytes("arn:aws:iam::000000000000:user".bytes())?;
            if (!startsWithBytes(u.view(), "/".bytes())) { arn.push('/')?; }
            arn.extend(u.view())?;
            principals.push(arn)?;
        }
        null => {}
    }
    var actions = Vector<Vector<u8>>.create();
    for (a in ["*", "sts:*", "sts:AssumeRole"]) { actions.push(copyBytes(a.bytes())?)?; }
    let statement = jsonMember(borrow doc, "Statement") ?? { return Ok(false); };
    var list = Vector<Json>.create();
    match (statement) {
        Json.Array(items) => {
            for (i in 0..items.length) { list.push(cloneJson(borrow items[i])?)?; }
        }
        _ => { list.push(cloneJson(statement)?)?; }
    }
    var allowed = false;
    for (i in 0..list.length) {
        let s = borrow list[i];
        let action = jsonMember(s, "Action") ?? { continue; };
        if (!jsonNames(action, actions.view())) { continue; }
        let principal = jsonMember(s, "Principal") ?? { continue; };
        let names = match (principal) {
            Json.Text(_) => jsonNames(principal, principals.view()), // "Principal": "*"
            _ => match (jsonMember(principal, "AWS")) {
                Some(aws) => jsonNames(aws, principals.view()),
                null => false,
            },
        };
        if (!names) { continue; }
        let effect = jsonMemberText(s, "Effect") ?? "".bytes();
        if (effect == "Deny".bytes()) { return Ok(false); }
        if (effect == "Allow".bytes()) { allowed = true; }
    }
    return Ok(allowed);
}
