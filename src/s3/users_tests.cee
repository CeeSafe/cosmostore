// Users (ADR-0088): the users file, its users given to keys, the identity policy grammar of every service, and
// resource policies that name a user.
import web_core;
import web_http;
import web_server;

fn usersKey(key: StringView) -> Credential => Credential {
    accessKey: copyBytes(key.bytes())!,
    secret: copyBytes("secret".bytes())!,
    signing: SigningKeyCache.create(),
    revoked: false,
    user: Vector<u8>.create(),
    userKey: Vector<u8>.create(),
    policyText: Vector<u8>.create(),
    policy: null,
    fromIam: false,
};

const READER_POLICY: StringView =
    "{\"Version\":\"2012-10-17\",\"Statement\":{\"Effect\":\"Allow\",\"Action\":[\"s3:GetObject\",\"s3:ListBucket\"],\"Resource\":[\"arn:aws:s3:::photos\",\"arn:aws:s3:::photos/*\"]}}";

@test
fn usersFileAndKeys() -> Result<void, TestFailure> {
    var text = String.create();
    text.append("# who may do what\n\naccount AKIAACCOUNT\nreader:R1 AKIAREADER1,AKIAREADER2 ")!;
    text.append(READER_POLICY)!;
    text.append("\n")!;
    let file = parseUsersFile(text.bytes())!;
    Check.equalU64(1, file.account.length as u64)?;
    Check.equalU64(1, file.users.length as u64)?;
    Check.equalU64(2, file.users[0].keys.length as u64)?;
    let any = "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:*\",\"Resource\":\"*\"}}";
    for (bad in [
        "reader",
        "reader:R1 AKIA1",
        "bad/name:X1 AKIA1 {\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:*\",\"Resource\":\"*\"}}",
        "reader:R1 AKIA1 {\"Statement\":{\"Effect\":\"Allow\",\"Principal\":\"*\",\"Action\":\"s3:*\",\"Resource\":\"*\"}}",
        "reader:R1 AKIA1 {\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"ec2:*\",\"Resource\":\"*\"}}",
        "reader:R1 AKIA1, {\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:*\",\"Resource\":\"*\"}}",
        "reader:R1 AKIA1,AKIA1 {\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:*\",\"Resource\":\"*\"}}",
        "Account:C1 AKIA1 {\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:*\",\"Resource\":\"*\"}}",
        "account AKIA1 {}",
        "account AKIA1,",
    ]) {
        Check.isTrue(parseUsersFile(bad.bytes()).isErr(), bad)?;
    }
    // A user named twice, ignoring case; a key named twice, by two users or a user and the account.
    for (pair in [["a:A1 AKIA1 ", "A:A2 AKIA2 "], ["a:A1 AKIA1 ", "b:B1 AKIA1 "], ["account AKIA1", "b:B1 AKIA1 "]]) {
        var twice = String.create();
        twice.append(pair[0])!;
        if (pair[0] != "account AKIA1") { twice.append(any)!; }
        twice.append("\n")!;
        twice.append(pair[1])!;
        twice.append(any)!;
        Check.isTrue(parseUsersFile(twice.bytes()).isErr(), pair[1])?;
    }
    // Given to keys: the reader's two, the account's its own, and a key the file does not name refused.
    var set = Vector<Credential>.create();
    for (k in ["AKIAACCOUNT", "AKIAREADER1", "AKIAREADER2", "AKIAFORMER"]) { set.push(usersKey(k))!; }
    applyUsers(mut set, borrow file)!;
    Check.equalU64(0, set[0].user.length as u64)?;
    Check.isFalse(set[0].revoked, "the account's key")?;
    Check.equalBytes("reader".bytes(), set[1].user.view())?;
    Check.isTrue(set[2].policy.isSome(), "its policy, parsed")?;
    Check.isTrue(set[3].revoked, "a key the file does not name is refused, not the account's")?;
    // A key the credentials file revoked stays revoked, though a user names it; the other keys are unchanged.
    var short = Vector<Credential>.create();
    for (k in ["AKIAACCOUNT", "AKIAREADER1"]) { short.push(usersKey(k))!; }
    short[1].revoked = true;
    applyUsers(mut short, borrow file)!;
    Check.isTrue(short[1].revoked, "a revoked key, though named")?;
    Check.isFalse(short[0].revoked, "the account's key, still")?;
    // An empty users file names no key: every key is refused.
    let empty = parseUsersFile("# nobody\n".bytes())!;
    var all = Vector<Credential>.create();
    all.push(usersKey("AKIAACCOUNT"))!;
    applyUsers(mut all, borrow empty)!;
    Check.isTrue(all[0].revoked, "an empty file refuses every key")?;
    return Ok();
}

fn identityDecides(policy: StringView, action: StringView, resource: StringView) -> Vector<u8> {
    let p = parseIdentityPolicy(policy.bytes())!;
    let req = bareRequest();
    let facts = policyFacts(borrow req, false, false, null)!;
    return copyBytes(decisionName(decidePolicy(borrow p, null, action, resource.bytes(), borrow facts)).bytes())!;
}

@test
fn identityPoliciesOfEveryService() -> Result<void, TestFailure> {
    // S3: objects of one bucket.
    Check.equalBytes("allow".bytes(), identityDecides(READER_POLICY, "s3:GetObject", "s3:photos/a.jpg").view())?;
    Check.equalBytes("neither".bytes(), identityDecides(READER_POLICY, "s3:GetObject", "s3:other/a.jpg").view())?;
    Check.equalBytes("neither".bytes(), identityDecides(READER_POLICY, "s3:PutObject", "s3:photos/a.jpg").view())?;
    // S3 Tables, a role, an access point: each its own namespace (ADR-0088 §3).
    let tables =
        "{\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"s3tables:*\",\"Resource\":\"arn:aws:s3tables:*:*:bucket/sales/table/*\"},{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRole\",\"Resource\":\"arn:aws:iam::000000000000:role/reader\"},{\"Effect\":\"Allow\",\"Action\":\"s3:GetAccessPoint\",\"Resource\":\"arn:aws:s3:us-east-1:000000000000:accesspoint/door\"}]}";
    Check.equalBytes("allow".bytes(), identityDecides(tables, "s3tables:GetTable", "s3tables:sales/table/x").view())?;
    Check.equalBytes("neither".bytes(), identityDecides(tables, "s3tables:GetTable", "s3tables:other/table/x").view())?;
    Check.equalBytes("allow".bytes(), identityDecides(tables, "sts:AssumeRole", "iam:role/reader").view())?;
    Check.equalBytes("neither".bytes(), identityDecides(tables, "sts:AssumeRole", "iam:role/admin").view())?;
    Check.equalBytes("allow".bytes(), identityDecides(tables, "s3:GetAccessPoint", "s3ap:door").view())?;
    // A bucket named `accesspoint` is not an access point's namespace.
    Check.equalBytes("neither".bytes(), identityDecides(tables, "s3:GetAccessPoint", "s3:accesspoint/door").view())?;
    // Another service's action or ARN is not taken.
    for (bad in [
        "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"ec2:RunInstances\",\"Resource\":\"*\"}}",
        "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:GetObject\",\"Resource\":\"arn:aws:ec2:::x\"}}",
        "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:GetObject\",\"Resource\":\"arn:aws:iam::0:group/x\"}}",
    ]) {
        Check.isTrue(parseIdentityPolicy(bad.bytes()).isErr(), bad)?;
    }
    // A user's ARN, and IAM's actions, are taken since the IAM API (ADR-0104 §2).
    Check.isTrue(
        parseIdentityPolicy(
            "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"iam:GetUser\",\"Resource\":\"arn:aws:iam::0:user/x\"}}".bytes(),
        ).isOk(),
        "a user's ARN",
    )?;
    return Ok();
}

@test
fn resourcePoliciesNameUsers() -> Result<void, TestFailure> {
    let none = Vector<Credential>.create();
    let doc =
        "{\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"arn:aws:iam::000000000000:user/reader\"},\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::photos/*\"},{\"Effect\":\"Deny\",\"Principal\":{\"AWS\":\"arn:aws:iam::000000000000:user/intern\"},\"Action\":\"s3:*\",\"Resource\":\"arn:aws:s3:::photos/*\"}]}";
    let p = parseBucketPolicy(doc.bytes(), "photos".bytes(), none.view(), false)!;
    let req = bareRequest();
    let facts = policyFacts(borrow req, false, false, null)!;
    Check.equalBytes(
        "allow".bytes(),
        decisionName(
            decidePolicyFor(
                borrow p,
                Some("AKIA1".bytes()),
                Some("reader".bytes()),
                "s3:PutObject",
                "photos/a".bytes(),
                borrow facts,
            ),
        ).bytes(),
    )?;
    Check.equalBytes(
        "deny".bytes(),
        decisionName(
            decidePolicyFor(
                borrow p,
                Some("AKIA2".bytes()),
                Some("intern".bytes()),
                "s3:GetObject",
                "photos/a".bytes(),
                borrow facts,
            ),
        ).bytes(),
    )?;
    Check.equalBytes(
        "neither".bytes(),
        decisionName(
            decidePolicyFor(borrow p, Some("AKIA3".bytes()), null, "s3:PutObject", "photos/a".bytes(), borrow facts),
        ).bytes(),
    )?;
    let bad =
        "{\"Statement\":{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"arn:aws:iam::0:user/bad/name\"},\"Action\":\"s3:*\",\"Resource\":\"arn:aws:s3:::photos/*\"}}";
    Check.isTrue(parseBucketPolicy(bad.bytes(), "photos".bytes(), none.view(), false).isErr(), "a name not a user's")?;
    return Ok();
}

fn callOf(action: StringView, bucket: StringView, key: StringView) -> Vector<u8> {
    let call = identityCallOf(action, bucket, key.bytes())!;
    var out = copyBytes(call.action.view())!;
    out.push(' ')!;
    out.extend(call.target.view())!;
    return out;
}

@test
fn exitReviewRulesOfM11() -> Result<void, TestFailure> {
    // A5: a directory bucket's ARN grants directory buckets only, not every bucket.
    let express =
        "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":[\"s3:GetObject\",\"s3express:CreateSession\"],\"Resource\":\"arn:aws:s3express:us-east-1:000000000000:bucket/*\"}}";
    Check.equalBytes("neither".bytes(), identityDecides(express, "s3:GetObject", "s3:victim/report.csv").view())?;
    Check.equalBytes(
        "allow".bytes(),
        identityDecides(express, "s3express:CreateSession", "s3express:d--use1-az4--x-s3").view(),
    )?;
    // B1: a directory bucket's calls as S3 Express names them; a general purpose bucket's as S3's.
    Check.equalBytes(
        "s3express:CreateSession s3express:d--use1-az4--x-s3".bytes(),
        callOf("s3:GetObject", "d--use1-az4--x-s3", "a").view(),
    )?;
    Check.equalBytes(
        "s3express:DeleteBucket s3express:d--use1-az4--x-s3".bytes(),
        callOf("s3:DeleteBucket", "d--use1-az4--x-s3", "").view(),
    )?;
    Check.equalBytes("s3:GetObject s3:photos/a".bytes(), callOf("s3:GetObject", "photos", "a").view())?;
    let point =
        "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3express:CreateAccessPoint\",\"Resource\":\"arn:aws:s3express:us-east-1:000000000000:accesspoint/door--use1-az4--xa-s3\"}}";
    Check.equalBytes(
        "allow".bytes(),
        identityDecides(point, "s3express:CreateAccessPoint", "s3expressap:door--use1-az4--xa-s3").view(),
    )?;
    Check.equalBytes("neither".bytes(), identityDecides(point, "s3express:CreateAccessPoint", "s3ap:door").view())?;
    // B2: a user principal of another account, or one the users file does not have, is refused when put.
    var set = Vector<Credential>.create();
    set.push(usersKey("AKIAREADER1"))!;
    set[0].user.extend("reader".bytes())!;
    let named =
        "{\"Statement\":{\"Effect\":\"Deny\",\"Principal\":{\"AWS\":\"arn:aws:iam::000000000000:user/reader\"},\"Action\":\"s3:*\",\"Resource\":\"arn:aws:s3:::photos/*\"}}";
    Check.isTrue(parseBucketPolicy(named.bytes(), "photos".bytes(), set.view(), true).isOk(), "a user there")?;
    let typo =
        "{\"Statement\":{\"Effect\":\"Deny\",\"Principal\":{\"AWS\":\"arn:aws:iam::000000000000:user/raeder\"},\"Action\":\"s3:*\",\"Resource\":\"arn:aws:s3:::photos/*\"}}";
    Check.isTrue(parseBucketPolicy(typo.bytes(), "photos".bytes(), set.view(), true).isErr(), "a user not there")?;
    let other =
        "{\"Statement\":{\"Effect\":\"Deny\",\"Principal\":{\"AWS\":\"arn:aws:iam::999999999999:user/reader\"},\"Action\":\"s3:*\",\"Resource\":\"arn:aws:s3:::photos/*\"}}";
    Check.isTrue(parseBucketPolicy(other.bytes(), "photos".bytes(), set.view(), true).isErr(), "another account")?;
    // Stored before the rule, it still reads, and names no user here.
    Check.isTrue(parseBucketPolicy(other.bytes(), "photos".bytes(), set.view(), false).isOk(), "a stored one reads")?;
    return Ok();
}

@test
fn destinationsSeeEveryDenyUnderTheirPrefix() -> Result<void, TestFailure> {
    // A pattern meets a prefix if some text it matches starts with it.
    Check.isTrue(patternMeetsPrefix("bkt/secret/*".bytes(), "bkt/".bytes()), "a narrower Deny under the prefix")?;
    Check.isTrue(patternMeetsPrefix("bkt/*".bytes(), "bkt/logs/".bytes()), "a wider one")?;
    Check.isTrue(patternMeetsPrefix("b?t/x".bytes(), "bkt/".bytes()), "a ? in it")?;
    Check.isFalse(patternMeetsPrefix("other/*".bytes(), "bkt/".bytes()), "another bucket")?;
    Check.isFalse(patternMeetsPrefix("bkt/a".bytes(), "bkt/b".bytes()), "another key")?;
    Check.isFalse(patternMeetsPrefix("bk".bytes(), "bkt/".bytes()), "shorter, no wildcard")?;
    // The bucket's Deny of a user on `secret/` reaches replication into the whole bucket, whatever its conditions.
    let none = Vector<Credential>.create();
    let doc =
        "{\"Statement\":{\"Effect\":\"Deny\",\"Principal\":{\"AWS\":\"arn:aws:iam::000000000000:user/five\"},\"Action\":[\"s3:ReplicateObject\",\"s3:PutObject\"],\"Resource\":\"arn:aws:s3:::bkt/secret/*\",\"Condition\":{\"Bool\":{\"aws:SecureTransport\":\"false\"}}}}";
    let p = parseBucketPolicy(doc.bytes(), "bkt".bytes(), none.view(), false)!;
    Check.isTrue(
        denyReaches(borrow p, Some("AKIA5".bytes()), Some("five".bytes()), "s3:ReplicateObject", "bkt/".bytes()),
        "five",
    )?;
    Check.isFalse(
        denyReaches(borrow p, Some("AKIA6".bytes()), Some("six".bytes()), "s3:ReplicateObject", "bkt/".bytes()),
        "six",
    )?;
    Check.isFalse(
        denyReaches(borrow p, Some("AKIA5".bytes()), Some("five".bytes()), "s3:ReplicateObject", "bkt/public/".bytes()),
        "beside it",
    )?;
    // The user's own Deny (an identity policy names no principal).
    let mine = parseIdentityPolicy(
        "{\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"s3:*\",\"Resource\":\"*\"},{\"Effect\":\"Deny\",\"Action\":\"s3:Replicate*\",\"Resource\":\"arn:aws:s3:::bkt/secret/*\"}]}".bytes(),
    )!;
    Check.isTrue(denyReaches(borrow mine, null, null, "s3:ReplicateObject", "s3:bkt/".bytes()), "its own Deny")?;
    Check.isFalse(denyReaches(borrow mine, null, null, "s3:PutObject", "s3:bkt/".bytes()), "of another action")?;
    return Ok();
}

@test
fn policiesNameUsersByTheirIds() -> Result<void, TestFailure> {
    // A user's id is part of its line; two users have two ids.
    for (bad in ["reader AKIA1 {}", "reader: AKIA1 {}", "reader:R-1 AKIA1 {}"]) {
        Check.isTrue(parseUsersFile(bad.bytes()).isErr(), bad)?;
    }
    let any = "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:*\",\"Resource\":\"*\"}}";
    var twins = String.create();
    twins.append("a:SAME AKIA1 ")!;
    twins.append(any)!;
    twins.append("\nb:SAME AKIA2 ")!;
    twins.append(any)!;
    Check.isTrue(parseUsersFile(twins.bytes()).isErr(), "two users with one id")?;
    // A policy put while reader is R1 names R1: stored with it, and read back with it.
    var first = Vector<Credential>.create();
    first.push(usersKey("AKIAREADER1"))!;
    first[0].user.extend("reader".bytes())!;
    first[0].userKey.extend("reader R1".bytes())!;
    let doc =
        "{\"Statement\":{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"arn:aws:iam::000000000000:user/reader\"},\"Action\":\"s3:GetObject\",\"Resource\":\"arn:aws:s3:::photos/*\"}}";
    let put = parseBucketPolicy(doc.bytes(), "photos".bytes(), first.view(), true)!;
    let stored = withUserIds(doc.bytes(), borrow put, first.view())!;
    Check.equalBytes(doc.bytes(), storedPolicyText(stored.view()))?;
    let read = parseBucketPolicy(stored.view(), "photos".bytes(), first.view(), false)!;
    let req = bareRequest();
    let facts = policyFacts(borrow req, false, false, null)!;
    let decide = (userKey: StringView) => decisionName(
        decidePolicyFor(
            borrow read,
            Some("AKIAX".bytes()),
            Some(userKey.bytes()),
            "s3:GetObject",
            "photos/a".bytes(),
            borrow facts,
        ),
    );
    Check.equalBytes("allow".bytes(), decide("reader R1").bytes())?;
    // reader removed and made again (R2): the old grant is not the new reader's.
    Check.equalBytes("neither".bytes(), decide("reader R2").bytes())?;
    // A policy stored before ids names no one in an Allow, and the name's every user in a Deny.
    let oldDeny =
        "{\"Statement\":{\"Effect\":\"Deny\",\"Principal\":{\"AWS\":\"arn:aws:iam::000000000000:user/reader\"},\"Action\":\"s3:GetObject\",\"Resource\":\"arn:aws:s3:::photos/*\"}}";
    let denied = parseBucketPolicy(oldDeny.bytes(), "photos".bytes(), first.view(), false)!;
    Check.equalBytes(
        "deny".bytes(),
        decisionName(
            decidePolicyFor(
                borrow denied,
                Some("AKIAX".bytes()),
                Some("reader R2".bytes()),
                "s3:GetObject",
                "photos/a".bytes(),
                borrow facts,
            ),
        ).bytes(),
    )?;
    Check.equalBytes(
        "neither".bytes(),
        decisionName(
            decidePolicyFor(
                borrow denied,
                Some("AKIAX".bytes()),
                Some("readers R3".bytes()),
                "s3:GetObject",
                "photos/a".bytes(),
                borrow facts,
            ),
        ).bytes(),
    )?;
    // A policy stored before ids names no one.
    let old = parseBucketPolicy(doc.bytes(), "photos".bytes(), first.view(), false)!;
    Check.equalBytes(
        "neither".bytes(),
        decisionName(
            decidePolicyFor(
                borrow old,
                Some("AKIAX".bytes()),
                Some("reader R1".bytes()),
                "s3:GetObject",
                "photos/a".bytes(),
                borrow facts,
            ),
        ).bytes(),
    )?;
    return Ok();
}

fn recordedRole(name: StringView, policy: StringView) -> StsRole =>
    StsRole {
        name: copyBytes(name.bytes())!,
        maxSeconds: 3600,
        policy: parseIdentityPolicy(policy.bytes())!,
        removed: false,
        trust: Vector<u8>.create(),
        id: Vector<u8>.create(),
    };

/// A configuration's write decided as the requester it records (ADR-0094 §2), with the users, roles and policies of
/// now: a user removed, or its policy narrowed, stops it; a role likewise; the bucket's Deny refuses and its Allow lets
/// a user write; a condition on a client's address holds for no write.
@test
fn writesDecidedAsTheirRequester() -> Result<void, TestFailure> {
    let putAll =
        "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::dst/*\"}}";
    let fromAddress =
        "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::dst/*\",\"Condition\":{\"IpAddress\":{\"aws:SourceIp\":\"10.0.0.0/8\"}}}}";
    var set = Vector<Credential>.create();
    set.push(usersKey("AKIAWRITER1"))!;
    set[0].user.extend("writer".bytes())!;
    set[0].userKey.extend("writer W1".bytes())!;
    set[0].policy = Some(parseIdentityPolicy(putAll.bytes())!);
    var roles = Vector<StsRole>.create();
    roles.push(recordedRole("auditor", putAll))!;
    let none: BucketPolicy? = null;
    let decide = (creds: Slice<Credential>, policy: borrow BucketPolicy?, broken: bool, requester: StringView) =>
        decideRecorded(
            creds,
            roles.view(),
            false,
            policy,
            broken,
            requester.bytes(),
            "s3:PutObject",
            "dst",
            "r/a".bytes(),
        )!;
    Check.isTrue(decide(set.view(), none.asBorrow(), false, ""), "the account's")?;
    Check.isTrue(decide(set.view(), none.asBorrow(), false, "user writer W1"), "a user its policy allows")?;
    Check.isFalse(decide(set.view(), none.asBorrow(), false, "user writer W2"), "a user made again (another id)")?;
    Check.isTrue(decide(set.view(), none.asBorrow(), false, "role auditor"), "a role its policy allows")?;
    Check.isFalse(decide(set.view(), none.asBorrow(), false, "role gone"), "a role no longer there")?;
    // A requester that could not be named fails closed: an empty user key is no account's key (the M14 review's B3).
    Check.isFalse(decide(set.view(), none.asBorrow(), false, "user "), "a user that could not be named")?;
    Check.isFalse(decide(set.view(), none.asBorrow(), false, "role "), "a role that could not be named")?;
    Check.isFalse(decide(set.view(), none.asBorrow(), true, "user writer W1"), "a bucket policy that does not parse")?;
    // The bucket's Deny of the user refuses; its Allow lets a user its own policy does not.
    let deny = parseBucketPolicy(
        "{\"Statement\":{\"Effect\":\"Deny\",\"Principal\":{\"AWS\":\"arn:aws:iam::000000000000:user/writer\"},\"Action\":\"s3:*\",\"Resource\":\"arn:aws:s3:::dst/*\"}}".bytes(),
        "dst".bytes(),
        set.view(),
        false,
    )!;
    let denied: BucketPolicy? = Some(deny);
    Check.isFalse(decide(set.view(), denied.asBorrow(), false, "user writer W1"), "the bucket's Deny")?;
    // The user removed: refused, whatever it was allowed.
    var removed = Vector<Credential>.create();
    removed.push(usersKey("AKIAWRITER1"))!;
    removed[0].revoked = true;
    Check.isFalse(decide(removed.view(), none.asBorrow(), false, "user writer W1"), "a user removed")?;
    // Its policy narrowed to a client's address: no write has one.
    var narrowed = Vector<Credential>.create();
    narrowed.push(usersKey("AKIAWRITER1"))!;
    narrowed[0].user.extend("writer".bytes())!;
    narrowed[0].userKey.extend("writer W1".bytes())!;
    narrowed[0].policy = Some(parseIdentityPolicy(fromAddress.bytes())!);
    Check.isFalse(decide(narrowed.view(), none.asBorrow(), false, "user writer W1"), "a condition on an address")?;
    // Nor does a negated or Null condition on a client's fact (the M14 review's B1): a Deny on unencrypted writes does
    // not refuse a write the server makes, and a Null Allow does not let one.
    let denyPlain = parseBucketPolicy(
        "{\"Statement\":{\"Effect\":\"Deny\",\"Principal\":\"*\",\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::dst/*\",\"Condition\":{\"Null\":{\"s3:x-amz-server-side-encryption\":\"true\"}}}}".bytes(),
        "dst".bytes(),
        set.view(),
        false,
    )!;
    let plainDenied: BucketPolicy? = Some(denyPlain);
    Check.isTrue(decide(set.view(), plainDenied.asBorrow(), false, "user writer W1"), "a Null Deny does not apply")?;
    let nullAllow = parseBucketPolicy(
        "{\"Statement\":{\"Effect\":\"Allow\",\"Principal\":\"*\",\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::dst/*\",\"Condition\":{\"Null\":{\"aws:SourceIp\":\"true\"}}}}".bytes(),
        "dst".bytes(),
        set.view(),
        false,
    )!;
    let nullAllowed: BucketPolicy? = Some(nullAllow);
    Check.isFalse(
        decide(narrowed.view(), nullAllowed.asBorrow(), false, "user writer W1"),
        "a Null Allow does not apply",
    )?;
    return Ok();
}

/// The roles file reloaded (ADR-0096 §2): every role keeps its place, one the file no longer has is marked removed,
/// one it changed takes its new policy, and a new one goes after the others.
@test
fn rolesReloadKeepTheirPlaces() -> Result<void, TestFailure> {
    let readAll = "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:GetObject\",\"Resource\":\"*\"}}";
    let putAll = "{\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"s3:PutObject\",\"Resource\":\"*\"}}";
    var old = Vector<StsRole>.create();
    old.push(recordedRole("reader", readAll))!;
    old.push(recordedRole("writer", readAll))!;
    var fresh = Vector<StsRole>.create();
    fresh.push(recordedRole("auditor", readAll))!;
    fresh.push(recordedRole("writer", putAll))!;
    let next = nextRoles(old.view(), fresh.view())!;
    Check.equalU64(3, next.length as u64)?;
    Check.equalBytes("reader".bytes(), next[0].name.view())?;
    Check.isTrue(next[0].removed, "a role the file no longer has")?;
    Check.equalBytes("writer".bytes(), next[1].name.view())?;
    Check.isFalse(next[1].removed, "a role still there")?;
    let req = bareRequest();
    let facts = policyFacts(borrow req, false, false, null)!;
    Check.equalBytes(
        "allow".bytes(),
        decisionName(decidePolicy(borrow next[1].policy, null, "s3:PutObject", "s3:b/k".bytes(), borrow facts)).bytes(),
    )?;
    Check.equalBytes("auditor".bytes(), next[2].name.view())?;
    // A role removed is no requester's any more.
    let creds = Vector<Credential>.create();
    let none: BucketPolicy? = null;
    Check.isFalse(
        decideRecorded(
            creds.view(),
            next.view(),
            false,
            none.asBorrow(),
            false,
            "role reader".bytes(),
            "s3:GetObject",
            "b",
            "k".bytes(),
        )!,
        "a removed role's write",
    )?;
    return Ok();
}
