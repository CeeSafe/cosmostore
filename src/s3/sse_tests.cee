// Server-side encryption (ADR-0046): chunks, sealing and opening, the envelope, the key file, the request's fields.
import web_core;
import web_http;
import web_server;

@test
fn sseChunkGeometry() -> Result<void, TestFailure> {
    Check.equalU64(1, sseChunks(0))?;
    Check.equalU64(1, sseChunks(1))?;
    Check.equalU64(1, sseChunks(65536))?;
    Check.equalU64(2, sseChunks(65537))?;
    Check.equalU64(16, sseStoredLength(0))?;
    Check.equalU64(17, sseStoredLength(1))?;
    Check.equalU64(65552, sseStoredLength(65536))?;
    Check.equalU64(65537 + 32, sseStoredLength(65537))?;
    Check.equalU64(5368709120 + 16 * 81920, sseStoredLength(5368709120))?; // 5 GiB
    // An empty part: its one tag.
    let none = sseSpan(0, 0, 0);
    Check.equalU64(1, none.chunks)?;
    Check.equalU64(0, none.storedFrom)?;
    Check.equalU64(16, none.storedTo)?;
    // A whole part of two chunks and a bit.
    let n: u64 = 2 * 65536 + 100;
    let whole = sseSpan(n, 0, n);
    Check.equalU64(0, whole.firstChunk)?;
    Check.equalU64(3, whole.chunks)?;
    Check.equalU64(0, whole.storedFrom)?;
    Check.equalU64(sseStoredLength(n), whole.storedTo)?;
    Check.equalU64(0, whole.skip)?;
    // One byte at a chunk's end, and the next: each its own chunk.
    let last = sseSpan(n, 65535, 65536);
    Check.equalU64(0, last.firstChunk)?;
    Check.equalU64(1, last.chunks)?;
    Check.equalU64(65552, last.storedTo)?;
    Check.equalU64(65535, last.skip)?;
    let next = sseSpan(n, 65536, 65537);
    Check.equalU64(1, next.firstChunk)?;
    Check.equalU64(1, next.chunks)?;
    Check.equalU64(65552, next.storedFrom)?;
    Check.equalU64(2 * 65552, next.storedTo)?;
    Check.equalU64(0, next.skip)?;
    // A range across a boundary into the short last chunk.
    let tail = sseSpan(n, 65536 + 10, n);
    Check.equalU64(1, tail.firstChunk)?;
    Check.equalU64(2, tail.chunks)?;
    Check.equalU64(65552, tail.storedFrom)?;
    Check.equalU64(2 * 65552 + 100 + 16, tail.storedTo)?;
    Check.equalU64(10, tail.skip)?;
    // Every span is whole chunks: its stored bytes are its plaintext's and a tag each.
    let froms = [0u64, 1u64, 65535u64, 65536u64, 131071u64, 131072u64, 131171u64];
    for (from in froms) {
        for (to in froms) {
            if (to <= from) { continue; }
            let s = sseSpan(n, from, to);
            let plainEnd = if ((s.firstChunk + s.chunks) * 65536 < n) (s.firstChunk + s.chunks) * 65536 else n;
            Check.equalU64(plainEnd - s.firstChunk * 65536 + 16 * s.chunks, s.storedTo - s.storedFrom)?;
            Check.equalU64(from, s.firstChunk * 65536 + s.skip)?;
        }
    }
    // Nonces: the part and the chunk, little-endian; no two alike.
    let a = sseNonce(0, 0);
    let b = sseNonce(1, 0);
    let c = sseNonce(0, 1);
    let d = sseNonce(0x01020304, 0x1122334455667788);
    Check.equalBytes([0u8; 12][..], a[..])?;
    Check.equalBytes([1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8][..], b[..])?;
    Check.equalBytes([0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8][..], c[..])?;
    Check.equalBytes(
        [4u8, 3u8, 2u8, 1u8, 0x88u8, 0x77u8, 0x66u8, 0x55u8, 0x44u8, 0x33u8, 0x22u8, 0x11u8][..],
        d[..],
    )?;
    return Ok();
}

@test
fn sseEnvelopeAsText() -> Result<void, TestFailure> {
    var e = SseEnvelope {
        customer: false, kms: false,
        keyId: copyBytes("key-2026_11".bytes())!,
        nonce: [0u8; 12],
        wrapped: [0u8; 48],
        context: Vector<u8>.create(),
    };
    for (i in 0..12) { e.nonce[i] = truncate<u8>(i * 17); }
    for (i in 0..48) { e.wrapped[i] = truncate<u8>(255 - i); }
    var text = Vector<u8>.create();
    encodeEnvelope(borrow e, mut text)!;
    Check.equalU64((6 + 11 + 1 + 24 + 1 + 96) as u64, text.length as u64)?;
    Check.isTrue(startsWithBytes(text.view(), "v1.s3.key-2026_11.00112233".bytes()), "the text")?;
    let back = match (decodeEnvelope(text.view())!) {
        Some(b) => b,
        null => { return Check.fail("the envelope reads back"); }
    };
    Check.isTrue(!back.customer, "its mode")?;
    Check.equalBytes(e.keyId.view(), back.keyId.view())?;
    Check.equalBytes(e.nonce[..], back.nonce[..])?;
    Check.equalBytes(e.wrapped[..], back.wrapped[..])?;
    // SSE-C: no key id.
    var c = SseEnvelope {
        customer: true,
        kms: false,
        keyId: copyBytes("-".bytes())!,
        nonce: [7u8; 12],
        wrapped: [9u8; 48],
        context: Vector<u8>.create(),
    };
    var ctext = Vector<u8>.create();
    encodeEnvelope(borrow c, mut ctext)!;
    Check.isTrue(startsWithBytes(ctext.view(), "v1.c.-.0707".bytes()), "a customer's envelope")?;
    Check.isTrue(decodeEnvelope(ctext.view())!.isSome(), "it reads back")?;
    // What is not an envelope.
    let hexNonce = "000102030405060708090a0b";
    var wrapped = Vector<u8>.create();
    for (i in 0..96) { wrapped.push('a')!; }
    let heads = ["v2.s3.k.", "v1.sse.k.", "v1.kms.-.", "v1.s3..", "v1.s3.-.", "v1.c.k.", "v1.s3.bad id.", "v1.s3.k.x."];
    for (h in heads) {
        var bad = Vector<u8>.create();
        bad.extend(h.bytes())!;
        bad.extend(hexNonce.bytes())!;
        bad.push('.')!;
        bad.extend(wrapped.view())!;
        Check.isTrue(decodeEnvelope(bad.view())!.isNull(), "not an envelope")?;
    }
    let others = [
        "", "AES256", "v1.s3.k.000102030405060708090a0b", "v1.s3.k.000102030405060708090a0b.abcd",
        "v1.s3.k.000102030405060708090a0g.aa", "v1.s3.k.00.aa.bb",
    ];
    for (o in others) { Check.isTrue(decodeEnvelope(o.bytes())!.isNull(), "not an envelope")?; }
    return Ok();
}

fn keyFileAnswer(text: StringView) -> StringView => match (parseKeyFile(text.bytes())) {
    Ok(_) => "ok",
    Err(KeyFileFault.Empty) => "empty",
    Err(KeyFileFault.BadLine) => "line",
    Err(KeyFileFault.BadId) => "id",
    Err(KeyFileFault.BadKey) => "key",
    Err(KeyFileFault.Duplicate) => "duplicate",
    Err(KeyFileFault.OutOfMemory) => "memory",
};

@test
fn sseKeyFile() -> Result<void, TestFailure> {
    // 32 bytes of 0, and of 0xFF, in base64.
    let zeros = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
    let ones = "//////////////////////////////////////////8=";
    var text = Vector<u8>.create();
    text.extend("# the master keys: the first seals\n\nk2  ".bytes())!;
    text.extend(ones.bytes())!;
    text.extend("   # since November\r\nk1\t".bytes())!;
    text.extend(zeros.bytes())!;
    text.extend("\n".bytes())!;
    let keys = match (parseKeyFile(text.view())) {
        Ok(k) => k,
        Err(_) => { return Check.fail("the key file parses"); }
    };
    Check.equalU64(2, keys.length as u64)?;
    Check.equalBytes("k2".bytes(), keys[0].id.view())?;
    Check.equalBytes([0xFFu8; 32][..], keys[0].key[..])?;
    Check.equalBytes("k1".bytes(), keys[1].id.view())?;
    Check.equalBytes([0u8; 32][..], keys[1].key[..])?;
    Check.equalBytes("empty".bytes(), keyFileAnswer("").bytes())?;
    Check.equalBytes("empty".bytes(), keyFileAnswer("# nothing\n\n").bytes())?;
    Check.equalBytes("line".bytes(), keyFileAnswer("justanid\n").bytes())?;
    Check.equalBytes("id".bytes(), keyFileAnswer("bad.id AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\n").bytes())?;
    Check.equalBytes("id".bytes(), keyFileAnswer("- AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\n").bytes())?;
    Check.equalBytes(
        "id".bytes(),
        keyFileAnswer("abcdefghijklmnopqrstuvwxyz0123456 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\n").bytes(),
    )?;
    Check.equalBytes("key".bytes(), keyFileAnswer("k AAAAAAAAAAAAAAAAAAAAAA==\n").bytes())?; // 16 bytes
    Check.equalBytes("key".bytes(), keyFileAnswer("k not-base64\n").bytes())?;
    Check.equalBytes(
        "duplicate".bytes(),
        keyFileAnswer(
            "k AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\nk //////////////////////////////////////////8=\n",
        ).bytes(),
    )?;
    return Ok();
}

fn sseAnswer(managed: StringView, algorithm: StringView, key: StringView, md5: StringView) -> Vector<u8> =>
    sseKmsAnswer(managed, "", "", algorithm, key, md5);

fn sseKmsAnswer(
    managed: StringView,
    kmsKey: StringView,
    context: StringView,
    algorithm: StringView,
    key: StringView,
    md5: StringView,
) -> Vector<u8> {
    let m: Slice<u8>? = if (managed.length > 0) Some(managed.bytes()) else null;
    let kk: Slice<u8>? = if (kmsKey.length > 0) Some(kmsKey.bytes()) else null;
    let c: Slice<u8>? = if (context.length > 0) Some(context.bytes()) else null;
    let a: Slice<u8>? = if (algorithm.length > 0) Some(algorithm.bytes()) else null;
    let k: Slice<u8>? = if (key.length > 0) Some(key.bytes()) else null;
    let d: Slice<u8>? = if (md5.length > 0) Some(md5.bytes()) else null;
    var named = Vector<u8>.create();
    let answer = match (sseOfFields(m, kk, c, a, k, d)) {
        Ok(SseRequest.None) => "none",
        Ok(SseRequest.Managed) => "managed",
        Ok(SseRequest.Kms(name)) => {
            named.extend("kms:".bytes())!;
            named.extend(name.view())!;
            StringView.fromUtf8(named.view()) ?? "?"
        }
        Ok(SseRequest.Customer(given)) => if (given[0] == 0 && given[31] == 0) "customer" else "another key",
        Err(S3Fail.Code(code)) => s3CodeName(code),
        Err(_) => "failed",
    };
    return copyBytes(answer.bytes())!;
}

@test
fn sseRequestFields() -> Result<void, TestFailure> {
    let zeros = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
    // The MD5 of 32 zero bytes, in base64.
    var digest = Vector<u8>.create();
    appendBase64(mut digest, Md5.of([0u8; 32][..])[..])!;
    let md5 = match (StringView.fromUtf8(digest.view())) {
        Some(t) => t,
        null => { return Check.fail("the digest is text"); }
    };
    Check.equalBytes("none".bytes(), sseAnswer("", "", "", "").view())?;
    Check.equalBytes("managed".bytes(), sseAnswer("AES256", "", "", "").view())?;
    // SSE-KMS (ADR-0055): the key's id, or its last piece of an ARN; the default key without one.
    Check.equalBytes("kms:".bytes(), sseAnswer("aws:kms", "", "", "").view())?;
    Check.equalBytes("kms:orders".bytes(), sseKmsAnswer("aws:kms", "orders", "", "", "", "").view())?;
    Check.equalBytes(
        "kms:k-1".bytes(),
        sseKmsAnswer("aws:kms", "arn:aws:kms:us-east-1:000000000000:key/k-1", "", "", "", "").view(),
    )?;
    Check.equalBytes("InvalidArgument".bytes(), sseKmsAnswer("aws:kms", "a key", "", "", "", "").view())?;
    Check.equalBytes("InvalidArgument".bytes(), sseKmsAnswer("AES256", "orders", "", "", "", "").view())?;
    Check.equalBytes("InvalidArgument".bytes(), sseKmsAnswer("", "orders", "", "", "", "").view())?;
    // An encryption context is taken since ADR-0090 §6 (`e30=` is `{}`); one that is not JSON is refused.
    Check.equalBytes("kms:".bytes(), sseKmsAnswer("aws:kms", "", "e30=", "", "", "").view())?;
    Check.equalBytes("InvalidArgument".bytes(), sseKmsAnswer("aws:kms", "", "bm90IGpzb24=", "", "", "").view())?;
    Check.equalBytes("NotImplemented".bytes(), sseAnswer("aws:kms:dsse", "", "", "").view())?;
    Check.equalBytes("InvalidArgument".bytes(), sseAnswer("AES128", "", "", "").view())?;
    Check.equalBytes("customer".bytes(), sseAnswer("", "AES256", zeros, md5).view())?;
    Check.equalBytes("InvalidArgument".bytes(), sseAnswer("AES256", "AES256", zeros, md5).view())?;
    Check.equalBytes("InvalidArgument".bytes(), sseAnswer("", "", zeros, md5).view())?;
    Check.equalBytes("InvalidArgument".bytes(), sseAnswer("", "AES256", "", md5).view())?;
    Check.equalBytes("InvalidArgument".bytes(), sseAnswer("", "AES256", zeros, "").view())?;
    Check.equalBytes("InvalidArgument".bytes(), sseAnswer("", "AES128", zeros, md5).view())?;
    Check.equalBytes("InvalidArgument".bytes(), sseAnswer("", "AES256", "AAAAAAAAAAAAAAAAAAAAAA==", md5).view())?;
    Check.equalBytes(
        "InvalidArgument".bytes(),
        sseAnswer("", "AES256", "//////////////////////////////////////////8=", md5).view(),
    )?;
    Check.isTrue(isSseField("x-amz-server-side-encryption".bytes()), "the SSE-S3 field")?;
    Check.isTrue(isSseField("x-amz-server-side-encryption-customer-key".bytes()), "a customer field")?;
    Check.isTrue(isSseField("x-amz-server-side-encryption-aws-kms-key-id".bytes()), "a KMS field")?;
    Check.isTrue(
        isSseField("x-amz-copy-source-server-side-encryption-customer-key".bytes()),
        "a copy source's field",
    )?;
    Check.isTrue(!isSseField("x-amz-meta-server-side-encryption".bytes()), "user metadata")?;
    Check.isTrue(!isSseField("x-amz-acl".bytes()), "another field")?;
    return Ok();
}

/// Byte k of a test text.
fn sseText(n: usize, seed: usize) -> Vector<u8> {
    var v = Vector<u8>.create();
    for (k in 0..n) { v.push(truncate<u8>(k * 31 + seed + (k >> 9)))!; }
    return v;
}

fn sseTestKey() -> [u8; 32] {
    var key = [0u8; 32];
    for (i in 0..32) { key[i] = truncate<u8>(i); }
    return key;
}

/// A part sealed, fed `step` bytes at a time.
fn sseSealed(key: borrow [u8; 32], part: u32, text: Slice<u8>, step: usize) -> Vector<u8> {
    var sealer = match (SseSealer.create(key, part, text.length as u64)) {
        Some(s) => s,
        null => { panic("no cipher for the key"); }
    };
    var stored = Vector<u8>.create();
    var at: usize = 0;
    while (at < text.length) {
        let end = if (text.length - at < step) text.length else at + step;
        sealer.feed(text[at..end], mut stored)!;
        at = end;
    }
    sealer.finish(mut stored)!;
    return stored;
}

/// Stored chunks opened from chunk `first`, fed `step` bytes at a time: the plaintext, or null when one is refused
/// or the bytes end inside a chunk.
fn sseOpened(
    key: borrow [u8; 32],
    part: u32,
    size: u64,
    first: u64,
    stored: Slice<u8>,
    step: usize,
) -> Vector<u8>? {
    var opener = match (SseOpener.create(key, part, size, first)) {
        Some(o) => o,
        null => { panic("no cipher for the key"); }
    };
    var plain = Vector<u8>.create();
    var at: usize = 0;
    while (at < stored.length) {
        let end = if (stored.length - at < step) stored.length else at + step;
        if (!opener.feed(stored[at..end], mut plain)!) { return null; }
        at = end;
    }
    if (!opener.isWhole()) { return null; }
    return plain;
}

@test
fn sseSealsAndOpens() -> Result<void, TestFailure> {
    let key = sseTestKey();
    // What another implementation gives (Python's cryptography) for "abc" as the one chunk of part 0.
    let abc = sseSealed(borrow key, 0, "abc".bytes(), 100);
    var hex = Vector<u8>.create();
    appendHexBytes(mut hex, abc.view())!;
    Check.equalBytes("6fded6d0933d8de78af52db2d132390290077c".bytes(), hex.view())?;
    let sizes = [0usize, 1, 65535, 65536, 65537, 200000];
    for (i in 0..sizes.length) {
        let n = sizes[i];
        let text = sseText(n, i);
        let stored = sseSealed(borrow key, 3, text.view(), 7001);
        Check.equalU64(sseStoredLength(n as u64), stored.length as u64)?;
        match (sseOpened(borrow key, 3, n as u64, 0, stored.view(), 5000)) {
            Some(plain) => { Check.equalBytes(text.view(), plain.view())?; }
            null => { return Check.fail("a sealed part did not open"); }
        }
        // Under another part number, or another key, nothing opens.
        Check.isTrue(sseOpened(borrow key, 4, n as u64, 0, stored.view(), 5000).isNull(), "refused")?;
        var other = key;
        other[31] = other[31] ^ 1;
        Check.isTrue(sseOpened(borrow other, 3, n as u64, 0, stored.view(), 5000).isNull(), "refused")?;
    }
    return Ok();
}

@test
fn sseOpensRangesAndRefusesChanges() -> Result<void, TestFailure> {
    let key = sseTestKey();
    let n: usize = 200000;
    let text = sseText(n, 9);
    let stored = sseSealed(borrow key, 0, text.view(), 65536);
    // A range across a chunk's end: its two chunks are read whole and opened.
    let from: usize = 65530;
    let to: usize = 65545;
    let span = sseSpan(n as u64, from as u64, to as u64);
    let piece = stored.view()[span.storedFrom as usize..span.storedTo as usize];
    match (sseOpened(borrow key, 0, n as u64, span.firstChunk, piece, 4096)) {
        Some(plain) => {
            let skip = span.skip as usize;
            Check.equalBytes(text.view()[from..to], plain.view()[skip..skip + (to - from)])?;
        }
        null => { return Check.fail("a range did not open"); }
    }
    // The last chunk alone.
    let tail = sseSpan(n as u64, (n - 1) as u64, n as u64);
    let last = stored.view()[tail.storedFrom as usize..tail.storedTo as usize];
    Check.isTrue(sseOpened(borrow key, 0, n as u64, tail.firstChunk, last, 4096).isSome(), "opens")?;
    // A changed byte, in a text or in a tag.
    var changed = Vector<u8>.create();
    changed.extend(stored.view())!;
    changed[70000] = changed[70000] ^ 1;
    Check.isTrue(sseOpened(borrow key, 0, n as u64, 0, changed.view(), 4096).isNull(), "refused")?;
    changed[70000] = changed[70000] ^ 1;
    changed[65536 + 3] = changed[65536 + 3] ^ 0x80;
    Check.isTrue(sseOpened(borrow key, 0, n as u64, 0, changed.view(), 4096).isNull(), "refused")?;
    // Chunks in another order: the second where the first was.
    let stride: usize = 65552;
    Check.isTrue(sseOpened(borrow key, 0, n as u64, 0, stored.view()[stride..2 * stride], 4096).isNull(), "refused")?;
    // Cut short: inside a chunk, and after a whole chunk (the object would end at a chunk that is not its last).
    Check.isTrue(sseOpened(borrow key, 0, n as u64, 0, stored.view()[0..stride + 10], 4096).isNull(), "refused")?;
    Check.isTrue(sseOpened(borrow key, 0, 2 * 65536, 0, stored.view()[0..2 * stride], 4096).isNull(), "refused")?;
    // Bytes after the last chunk.
    var longer = Vector<u8>.create();
    longer.extend(stored.view())!;
    longer.push(0)!;
    Check.isTrue(sseOpened(borrow key, 0, n as u64, 0, longer.view(), 4096).isNull(), "refused")?;
    return Ok();
}

@test
fn sseWrapsDataKeys() -> Result<void, TestFailure> {
    let master = sseTestKey();
    var dataKey = [0u8; 32];
    for (i in 0..32) { dataKey[i] = truncate<u8>(100 + i); }
    var nonce = [0u8; 12];
    for (i in 0..12) { nonce[i] = truncate<u8>(i); }
    let wrapped = match (wrapDataKey(borrow master, "s3", borrow dataKey, nonce)) {
        Some(w) => w,
        null => { return Check.fail("no cipher for the master key"); }
    };
    // What another implementation gives.
    var hex = Vector<u8>.create();
    appendHexBytes(mut hex, wrapped[..])!;
    Check.equalBytes(
        "2367b07cad8ca870e12cf9e4c1980a1ef7a3f14388022507441a9bfa9de88231f2b64d8bc19091e1ffbd90adf361693a".bytes(),
        hex.view(),
    )?;
    var e = SseEnvelope {
        customer: false,
        kms: false,
        keyId: copyBytes("k1".bytes())!,
        nonce: nonce,
        wrapped: wrapped,
        context: Vector<u8>.create(),
    };
    match (unwrapDataKey(borrow master, borrow e)) {
        Some(k) => { Check.equalBytes(dataKey[..], k[..])?; }
        null => { return Check.fail("the data key did not open"); }
    }
    // Another master key, another mode, a changed envelope: no key.
    var other = master;
    other[0] = other[0] ^ 1;
    Check.isTrue(unwrapDataKey(borrow other, borrow e).isNull(), "no key")?;
    e.customer = true;
    Check.isTrue(unwrapDataKey(borrow master, borrow e).isNull(), "no key")?;
    e.customer = false;
    e.wrapped[5] = e.wrapped[5] ^ 1;
    Check.isTrue(unwrapDataKey(borrow master, borrow e).isNull(), "no key")?;
    return Ok();
}

fn sseKeyOf(id: StringView, fill: u8) -> MasterKey {
    var key = MasterKey { id: copyBytes(id.bytes())!, key: [0u8; 32] };
    for (i in 0..32) { key.key[i] = fill + truncate<u8>(i); }
    return key;
}

fn sseKeyFaultIs(answer: Result<[u8; 32], SseKeyFault>, expected: SseKeyFault) -> bool => match (answer) {
    Ok(_) => false,
    Err(SseKeyFault.Broken) => match (expected) {
        SseKeyFault.Broken => true,
        _ => false,
    },
    Err(SseKeyFault.Customer) => match (expected) {
        SseKeyFault.Customer => true,
        _ => false,
    },
    Err(SseKeyFault.UnknownKey) => match (expected) {
        SseKeyFault.UnknownKey => true,
        _ => false,
    },
};

@test
fn sseManagedKeysRotate() -> Result<void, TestFailure> {
    var keys = Vector<MasterKey>.create();
    Check.isTrue(newManagedSeal(keys.view()).isErr(), "no key file: refused")?;
    keys.push(sseKeyOf("k1", 1))!;
    let seal = match (newManagedSeal(keys.view())) {
        Ok(s) => s,
        Err(_) => { return Check.fail("no seal"); }
    };
    Check.isTrue(startsWithBytes(seal.field.view(), "v1.s3.k1.".bytes()), "the envelope names the first key")?;
    match (managedDataKey(keys.view(), seal.field.view())) {
        Ok(k) => { Check.equalBytes(seal.dataKey[..], k[..])?; }
        Err(_) => { return Check.fail("the data key did not open"); }
    }
    // Two objects get two data keys.
    let second = match (newManagedSeal(keys.view())) {
        Ok(s) => s,
        Err(_) => { return Check.fail("no seal"); }
    };
    Check.isTrue(second.dataKey[..] != seal.dataKey[..], "a data key per object")?;
    // Rotated: a new first key seals, the old one still opens what it sealed.
    var rotated = Vector<MasterKey>.create();
    rotated.push(sseKeyOf("k2", 50))!;
    rotated.push(sseKeyOf("k1", 1))!;
    match (managedDataKey(rotated.view(), seal.field.view())) {
        Ok(k) => { Check.equalBytes(seal.dataKey[..], k[..])?; }
        Err(_) => { return Check.fail("the old key did not open its object"); }
    }
    let after = match (newManagedSeal(rotated.view())) {
        Ok(s) => s,
        Err(_) => { return Check.fail("no seal"); }
    };
    Check.isTrue(startsWithBytes(after.field.view(), "v1.s3.k2.".bytes()), "the new key seals")?;
    // The old key gone: the id is unknown. Another key under the id: the envelope does not open.
    var gone = Vector<MasterKey>.create();
    gone.push(sseKeyOf("k2", 50))!;
    Check.isTrue(sseKeyFaultIs(managedDataKey(gone.view(), seal.field.view()), SseKeyFault.UnknownKey), "unknown")?;
    var swapped = Vector<MasterKey>.create();
    swapped.push(sseKeyOf("k1", 7))!;
    Check.isTrue(sseKeyFaultIs(managedDataKey(swapped.view(), seal.field.view()), SseKeyFault.Broken), "broken")?;
    Check.isTrue(sseKeyFaultIs(managedDataKey(keys.view(), "v1.s3.k1.00".bytes()), SseKeyFault.Broken), "broken")?;
    // An SSE-C envelope needs the request's key.
    var c = SseEnvelope {
        customer: true,
        kms: false,
        keyId: copyBytes("-".bytes())!,
        nonce: [0u8; 12],
        wrapped: [0u8; 48],
        context: Vector<u8>.create(),
    };
    var field = Vector<u8>.create();
    encodeEnvelope(borrow c, mut field)!;
    Check.isTrue(sseKeyFaultIs(managedDataKey(keys.view(), field.view()), SseKeyFault.Customer), "customer")?;
    return Ok();
}

/// A sealed object put into the store as the S3 layer puts one: its chunks stored, its plaintext's size and MD5.
fn putSealed(s: borrow mut ObjectStore, key: StringView, text: Slice<u8>, stored: Slice<u8>) {
    var obj = s.writeAll(stored)!;
    obj.size = text.length as u64;
    obj.md5 = Md5.of(text);
    var e = SseEnvelope {
        customer: false,
        kms: false,
        keyId: copyBytes("k1".bytes())!,
        nonce: [0u8; 12],
        wrapped: [0u8; 48],
        context: Vector<u8>.create(),
    };
    var field = Vector<u8>.create();
    encodeEnvelope(borrow e, mut field)!;
    var metadata = Vector<u8>.create();
    metadataAdd(mut metadata, SSE_FIELD.bytes(), field.view())!;
    let _ = s.putFinishedWith("bkt", key, "", metadata.view(), "".bytes(), borrow obj, PutCondition.None)!;
}

@test
fn sseSealedVersionsAreReadAndVerifiedAsStored() -> Result<void, TestFailure> {
    let key = sseTestKey();
    let dir = scratchDirectory("sse-sealed");
    let small = sseText(500, 1);
    let large = sseText(200000, 2);
    {
        var s = ObjectStore.open(dir.view(), spaceConfig(0, 0))!;
        s.createBucket("bkt")!;
        putSealed(mut s, "inline", small.view(), sseSealed(borrow key, 0, small.view(), 4096).view());
        putSealed(mut s, "extents", large.view(), sseSealed(borrow key, 0, large.view(), 65536).view());
        putSealed(mut s, "empty", "".bytes(), sseSealed(borrow key, 0, "".bytes(), 1).view());
        s.checkpoint()!;
    }
    var s = ObjectStore.open(dir.view(), spaceConfig(0, 0))!;
    let report = s.verify()!;
    Check.equalU64(3, report.objects)?;
    Check.equalU64(sseStoredLength(500) + sseStoredLength(200000) + sseStoredLength(0), report.bytes)?;
    Check.equalU64(0, report.problems.length as u64)?;
    // A read is of what is stored, past the size the version answers with, and it opens.
    let whole = s.getObject("bkt", "extents")!;
    Check.equalU64(sseStoredLength(200000), whole.length as u64)?;
    match (sseOpened(borrow key, 0, 200000, 0, whole.view(), 65536)) {
        Some(plain) => { Check.equalBytes(large.view(), plain.view())?; }
        null => { return Check.fail("the stored object did not open"); }
    }
    let span = sseSpan(200000, 131070, 131075);
    let piece = s.getObjectRange("bkt", "extents", span.storedFrom, span.storedTo)!;
    match (sseOpened(borrow key, 0, 200000, span.firstChunk, piece.view(), 4096)) {
        Some(plain) => {
            let skip = span.skip as usize;
            Check.equalBytes(large.view()[131070..131075], plain.view()[skip..skip + 5])?;
        }
        null => { return Check.fail("a range did not open"); }
    }
    // A version that claims to be sealed but whose bytes are not its chunks' length is a mismatch.
    putSealed(mut s, "short", small.view(), small.view());
    let after = s.verify()!;
    Check.equalU64(1, after.problems.length as u64)?;
    Check.equalBytes("short".bytes(), after.problems[0].key.view())?;
    let mismatch = match (after.problems[0].fault) {
        VerifyFault.Mismatch => true,
        _ => false,
    };
    Check.isTrue(mismatch, "a mismatch")?;
    removeTree(dir.view());
    return Ok();
}

/// A multipart object sealed as UploadPart seals one: each part under the key of its salt, after the salt.
fn sseSealedParts(dataKey: borrow [u8; 32], text: Slice<u8>, sizes: Slice<u64>) -> Vector<u8> {
    var stored = Vector<u8>.create();
    var at: usize = 0;
    for (i in 0..sizes.length) {
        var salt = [0u8; 16];
        for (k in 0..16) { salt[k] = truncate<u8>(i * 16 + k + 1); }
        var sealer = match (SseSealer.createPart(dataKey, salt, sizes[i])!) {
            Some(s) => s,
            null => { panic("no cipher"); }
        };
        if (sealer.storedLength() != SSE_PART_HEADER + sseStoredLength(sizes[i])) { panic("a part's stored length"); }
        let end = at + sizes[i] as usize;
        sealer.feed(text[at..end], mut stored)!;
        sealer.finish(mut stored)!;
        at = end;
    }
    return stored;
}

/// Plaintext `from..to` read from a sealed multipart object as GET reads it: the planned stored range, and the first
/// part's header apart when the range starts after it.
fn sseReadRange(
    dataKey: borrow [u8; 32],
    stored: Slice<u8>,
    sizes: Slice<u64>,
    size: u64,
    from: u64,
    to: u64,
) -> Vector<u8>? {
    let r = sseRange(size, sizes, from, to);
    let salt = match (r.headerAt) {
        Some(h) => stored[h as usize..(h + SSE_PART_HEADER) as usize],
        null => "".bytes(),
    };
    var stream = match (SseStream.multipart(dataKey, sizes[r.part..], r.chunk, salt)!) {
        Some(s) => s,
        null => { return null; }
    };
    var plain = Vector<u8>.create();
    let piece = stored[r.storedFrom as usize..r.storedTo as usize];
    var at: usize = 0;
    while (at < piece.length) {
        let end = if (piece.length - at < 3000) piece.length else at + 3000;
        if (!stream.feed(piece[at..end], mut plain)!) { return null; }
        at = end;
    }
    if (!stream.isWhole()) { return null; }
    let skip = r.skip as usize;
    var out = Vector<u8>.create();
    out.extend(plain.view()[skip..skip + (to - from) as usize])!;
    return out;
}

@test
fn sseMultipartPartsOpenInAnyRange() -> Result<void, TestFailure> {
    let dataKey = sseTestKey();
    let sizes = [70000u64, 100, 131077, 1];
    var size: u64 = 0;
    for (i in 0..sizes.length) { size += sizes[i]; }
    let text = sseText(size as usize, 5);
    let stored = sseSealedParts(borrow dataKey, text.view(), sizes[..]);
    var storedSize: u64 = 0;
    for (i in 0..sizes.length) { storedSize += SSE_PART_HEADER + sseStoredLength(sizes[i]); }
    Check.equalU64(storedSize, stored.length as u64)?;
    // Whole; inside one part, at its start and after its first chunk; across parts; the last byte.
    let ranges = [
        0u64, size,
        0, 1,
        69999, 70001,
        70000, 70100,
        70050, 70150,
        70100, 70100 + 65536 + 3,
        70100 + 65540, 70100 + 65550,
        70100 + 131076, size,
        65530, size - 1,
        size - 1, size,
    ];
    var k: usize = 0;
    while (k < ranges.length) {
        let from = ranges[k];
        let to = ranges[k + 1];
        k += 2;
        match (sseReadRange(borrow dataKey, stored.view(), sizes[..], size, from, to)) {
            Some(plain) => { Check.equalBytes(text.view()[from as usize..to as usize], plain.view())?; }
            null => { return Check.fail("a range of a sealed multipart object did not open"); }
        }
    }
    // A changed salt, a changed chunk, two parts swapped: nothing opens.
    var changed = Vector<u8>.create();
    changed.extend(stored.view())!;
    let second = (SSE_PART_HEADER + sseStoredLength(70000)) as usize;
    changed[second + 3] = changed[second + 3] ^ 1;
    Check.isTrue(sseReadRange(borrow dataKey, changed.view(), sizes[..], size, 0, size).isNull(), "a salt")?;
    changed[second + 3] = changed[second + 3] ^ 1;
    changed[second + 20] = changed[second + 20] ^ 1;
    Check.isTrue(sseReadRange(borrow dataKey, changed.view(), sizes[..], size, 70000, 70100).isNull(), "a chunk")?;
    let same = [100u64, 100];
    let twice = sseSealedParts(borrow dataKey, text.view()[0..200], same[..]);
    var swapped = Vector<u8>.create();
    let part = (SSE_PART_HEADER + sseStoredLength(100)) as usize;
    swapped.extend(twice.view()[part..2 * part])!;
    swapped.extend(twice.view()[0..part])!;
    match (sseReadRange(borrow dataKey, swapped.view(), same[..], 200, 0, 200)) {
        Some(plain) => { Check.isTrue(plain.view() != text.view()[0..200], "swapped parts read swapped")?; }
        null => {}
    }
    // One part uploaded twice: two salts, two keys, two ciphertexts of one text.
    var a = match (SseSealer.createPart(borrow dataKey, [1u8; 16], 100)!) {
        Some(s) => s,
        null => { return Check.fail("no cipher"); }
    };
    var b = match (SseSealer.createPart(borrow dataKey, [2u8; 16], 100)!) {
        Some(s) => s,
        null => { return Check.fail("no cipher"); }
    };
    var sa = Vector<u8>.create();
    var sb = Vector<u8>.create();
    a.feed(text.view()[0..100], mut sa)!;
    a.finish(mut sa)!;
    b.feed(text.view()[0..100], mut sb)!;
    b.finish(mut sb)!;
    Check.isTrue(sa.view()[16..] != sb.view()[16..], "a key per upload of a part")?;
    // Under the wrong data key nothing opens.
    var other = dataKey;
    other[0] = other[0] ^ 1;
    Check.isTrue(sseReadRange(borrow other, stored.view(), sizes[..], size, 0, size).isNull(), "another key")?;
    return Ok();
}

@test
fn sseCustomerEnvelopesNeedTheirKey() -> Result<void, TestFailure> {
    var key = [0u8; 32];
    for (i in 0..32) { key[i] = truncate<u8>(200 - i); }
    let keys = Vector<MasterKey>.create();
    let asked = SseRequest.Customer(key);
    let seal = match (newSeal(keys.view(), keys.view(), borrow asked)) {
        Ok(Some(s)) => s,
        _ => { return Check.fail("no SSE-C seal"); }
    };
    Check.isTrue(seal.customer, "SSE-C")?;
    Check.isTrue(isCustomerEnvelope(seal.field.view()), "an SSE-C envelope")?;
    Check.isTrue(startsWithBytes(seal.field.view(), "v1.c.-.".bytes()), "no key id")?;
    let e = match (decodeEnvelope(seal.field.view())!) {
        Some(e) => e,
        null => { return Check.fail("the envelope does not decode"); }
    };
    match (unwrapDataKey(borrow key, borrow e)) {
        Some(k) => { Check.equalBytes(seal.dataKey[..], k[..])?; }
        null => { return Check.fail("the request's key does not open it"); }
    }
    var other = key;
    other[3] = other[3] ^ 1;
    Check.isTrue(unwrapDataKey(borrow other, borrow e).isNull(), "another key")?;
    // The master keys do not open it, and SSE-S3 without a key file is refused.
    Check.isTrue(sseKeyFaultIs(managedDataKey(keys.view(), seal.field.view()), SseKeyFault.Customer), "SSE-C")?;
    let managedAsked = SseRequest.Managed;
    let none = SseRequest.None;
    Check.isTrue(newSeal(keys.view(), keys.view(), borrow managedAsked).isErr(), "no key file")?;
    Check.isTrue(newSeal(keys.view(), keys.view(), borrow none)!.isNull(), "nothing asked")?;
    // Its ETag is a digest of the plaintext's MD5 under the key: not the MD5, the same for the same bytes, another
    // under another key.
    let sealer = sealerOf(borrow seal, 10, Some(key))!;
    let md5 = Md5.of("ten bytes!".bytes());
    let etag = sealedEtag(borrow sealer, md5);
    Check.isTrue(etag[..] != md5[..], "not the MD5")?;
    Check.equalBytes(etag[..], sseCustomerEtag(borrow key, borrow md5)[..])?;
    Check.isTrue(sseCustomerEtag(borrow other, borrow md5)[..] != etag[..], "another key")?;
    let managed = sealerOf(borrow seal, 10, null)!;
    Check.equalBytes(md5[..], sealedEtag(borrow managed, md5)[..])?;
    return Ok();
}

@test
fn sseSealsWithoutKnowingTheSize() -> Result<void, TestFailure> {
    // A POST form's file has no size in advance: a sealer told 0 seals as one told the size.
    let key = sseTestKey();
    let sizes = [0usize, 1, 65536, 131072, 131073];
    for (i in 0..sizes.length) {
        let text = sseText(sizes[i], i);
        let known = sseSealed(borrow key, 0, text.view(), 5000);
        var sealer = match (SseSealer.create(borrow key, 0, 0)) {
            Some(s) => s,
            null => { return Check.fail("no cipher"); }
        };
        var stored = Vector<u8>.create();
        var at: usize = 0;
        while (at < text.length) {
            let end = if (text.length - at < 65536) text.length else at + 65536;
            sealer.feed(text.view()[at..end], mut stored)!;
            at = end;
        }
        sealer.finish(mut stored)!;
        Check.equalBytes(known.view(), stored.view())?;
    }
    return Ok();
}

@test
fn sseBucketEncryptionXml() -> Result<void, TestFailure> {
    let aes =
        "<ServerSideEncryptionConfiguration><Rule><ApplyServerSideEncryptionByDefault><SSEAlgorithm>AES256</SSEAlgorithm></ApplyServerSideEncryptionByDefault></Rule></ServerSideEncryptionConfiguration>";
    Check.isTrue(parseBucketEncryption(aes.bytes()).isOk(), "AES256")?;
    let kms =
        "<ServerSideEncryptionConfiguration><Rule><ApplyServerSideEncryptionByDefault><SSEAlgorithm>aws:kms</SSEAlgorithm></ApplyServerSideEncryptionByDefault></Rule></ServerSideEncryptionConfiguration>";
    Check.equalBytes("aws:kms".bytes(), parseBucketEncryption(kms.bytes())!.view())?;
    let named =
        "<ServerSideEncryptionConfiguration><Rule><ApplyServerSideEncryptionByDefault><SSEAlgorithm>aws:kms</SSEAlgorithm><KMSMasterKeyID>arn:aws:kms:us-east-1:1:key/orders</KMSMasterKeyID></ApplyServerSideEncryptionByDefault></Rule></ServerSideEncryptionConfiguration>";
    Check.equalBytes("aws:kms orders".bytes(), parseBucketEncryption(named.bytes())!.view())?;
    let dsse =
        "<ServerSideEncryptionConfiguration><Rule><ApplyServerSideEncryptionByDefault><SSEAlgorithm>aws:kms:dsse</SSEAlgorithm></ApplyServerSideEncryptionByDefault></Rule></ServerSideEncryptionConfiguration>";
    Check.isTrue(parseBucketEncryption(dsse.bytes()).isErr(), "aws:kms:dsse")?;
    Check.isTrue(isEncryptionValue("aws:kms orders".bytes()) && !isEncryptionValue("aws:kms a b".bytes()), "stored")?;
    Check.isTrue(parseBucketEncryption("<ServerSideEncryptionConfiguration/>".bytes()).isErr(), "no rule")?;
    let other =
        "<ServerSideEncryptionConfiguration><Rule><ApplyServerSideEncryptionByDefault><SSEAlgorithm>DES</SSEAlgorithm></ApplyServerSideEncryptionByDefault></Rule></ServerSideEncryptionConfiguration>";
    Check.isTrue(parseBucketEncryption(other.bytes()).isErr(), "DES")?;
    return Ok();
}

@test
fn sseKmsSealsUnderNamedKeys() -> Result<void, TestFailure> {
    var kmsKeys = Vector<MasterKey>.create();
    kmsKeys.push(sseKeyOf("app-default", 9))!;
    kmsKeys.push(sseKeyOf("orders", 40))!;
    var masterKeys = Vector<MasterKey>.create();
    masterKeys.push(sseKeyOf("orders", 77))!;
    // No name: the KMS key file's first key; a name: that key; the envelope is SSE-KMS's and names it.
    let byDefault = SseRequest.Kms(KmsKeyName { length: 0, bytes: [0u8; 32], context: Vector<u8>.create() });
    let first = match (newSeal(masterKeys.view(), kmsKeys.view(), borrow byDefault)) {
        Ok(Some(s)) => s,
        _ => { return Check.fail("no SSE-KMS seal"); }
    };
    Check.isTrue(startsWithBytes(first.field.view(), "v1.kms.app-default.".bytes()), "the first key")?;
    Check.isTrue(first.kms && !first.customer, "SSE-KMS")?;
    let named = SseRequest.Kms(
        kmsKeyNameOf("orders".bytes()) ?? KmsKeyName { length: 0, bytes: [0u8; 32], context: Vector<u8>.create() },
    );
    let seal = match (newSeal(masterKeys.view(), kmsKeys.view(), borrow named)) {
        Ok(Some(s)) => s,
        _ => { return Check.fail("no SSE-KMS seal"); }
    };
    Check.isTrue(isKmsEnvelope(seal.field.view()), "a KMS envelope")?;
    match (managedDataKey(kmsKeys.view(), seal.field.view())) {
        Ok(k) => { Check.equalBytes(seal.dataKey[..], k[..])?; }
        Err(_) => { return Check.fail("the KMS key does not open it"); }
    }
    // SSE-S3's master key of the same id does not open it: the mode is the wrapping's associated data.
    Check.isTrue(sseKeyFaultIs(managedDataKey(masterKeys.view(), seal.field.view()), SseKeyFault.Broken), "apart")?;
    // A name the file does not have, and no KMS key file at all.
    let unknown = SseRequest.Kms(
        kmsKeyNameOf("nobody".bytes()) ?? KmsKeyName { length: 0, bytes: [0u8; 32], context: Vector<u8>.create() },
    );
    Check.isTrue(newSeal(masterKeys.view(), kmsKeys.view(), borrow unknown).isErr(), "unknown key")?;
    let none = Vector<MasterKey>.create();
    Check.isTrue(newSeal(masterKeys.view(), none.view(), borrow byDefault).isErr(), "no KMS keys")?;
    // Its ETag is not the plaintext's MD5.
    let sealer = sealerOf(borrow seal, 3, null)!;
    let md5 = Md5.of("abc".bytes());
    Check.isTrue(sealedEtag(borrow sealer, md5)[..] != md5[..], "not the MD5")?;
    return Ok();
}

/// SSE-KMS's encryption context (ADR-0090 §6): taken as base64 of a JSON object of strings, kept in the envelope
/// under the data key's seal, so an envelope whose context was changed does not open.
@test
fn kmsEncryptionContextIsSealed() -> Result<void, TestFailure> {
    // {"team":"blue"}
    let context = "eyJ0ZWFtIjoiYmx1ZSJ9";
    Check.isTrue(encryptionContextOk(context.bytes())!, "a JSON object of strings")?;
    for (bad in ["", "not base64!", "WzFd" /* [1] */, "eyJ0ZWFtIjoxfQ==" /* {"team":1} */]) {
        Check.isFalse(encryptionContextOk(bad.bytes())!, bad)?;
    }
    let asked = sseOfFields(Some("aws:kms".bytes()), null, Some(context.bytes()), null, null, null).ok() ?? {
        return Check.fail("the context taken");
    };
    var keys = Vector<MasterKey>.create();
    keys.push(sseKeyOf("orders", 7))!;
    let none = Vector<MasterKey>.create();
    let seal = (newSeal(none.view(), keys.view(), borrow asked).ok() ?? null) ?? { return Check.fail("sealed"); };
    let e = decodeEnvelope(seal.field.view())! ?? { return Check.fail("decoded"); };
    Check.equalBytes(context.bytes(), e.context.view())?;
    Check.isTrue(unwrapDataKey(borrow keys[0].key, borrow e).isSome(), "it opens")?;
    // Another context in the same envelope: the seal does not open.
    var changed = copyBytes(seal.field.view())!;
    let last = changed.length - 2;
    changed[last] = if (changed[last] == 'J') 'K' else 'J';
    match (decodeEnvelope(changed.view())!) {
        Some(t) => { Check.isTrue(unwrapDataKey(borrow keys[0].key, borrow t).isNull(), "a changed context")?; }
        null => {}
    }
    // Without a context, the envelope is the five pieces it was.
    let plain = sseOfFields(Some("aws:kms".bytes()), null, null, null, null, null).ok() ?? {
        return Check.fail("no context");
    };
    let old = (newSeal(none.view(), keys.view(), borrow plain).ok() ?? null) ?? { return Check.fail("sealed"); };
    var dots: usize = 0;
    for (c in old.field.view()) {
        if (c == '.') { dots += 1; }
    }
    Check.equalU64(4, dots as u64)?;
    return Ok();
}

/// A key file's reload (ADR-0096 §3, the M15 exit review): new bytes under a key's id count as its removal; what
/// still needs a key is counted with the writes staged and the buckets whose KMS default names it; and a write sealed
/// under a key no longer in the set does not pass the commit check.
@test
fn keyRemovalsAreCheckedWhole() -> Result<void, TestFailure> {
    let dir = scratchDirectory("key-removals");
    let zero = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
    let other = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAE=";
    var firstPath = textOf(dir.view());
    firstPath.append("/first.keys")!;
    var first = textOf("k2 ");
    first.append(zero)!;
    first.append("\nk1 ")!;
    first.append(zero)!;
    first.append("\n")!;
    DurableFile.createNew(firstPath.view())!.writeAt(first.bytes(), 0)!;
    var secondPath = textOf(dir.view());
    secondPath.append("/second.keys")!;
    var second = textOf("k2 ");
    second.append(other)!;
    second.append("\nk1 ")!;
    second.append(zero)!;
    second.append("\n")!;
    DurableFile.createNew(secondPath.view())!.writeAt(second.bytes(), 0)!;
    var k = KeyRotation {
        sets: sharedKeys(readSseKeys(firstPath.view())!)!,
        path: textOf(secondPath.view()),
        kind: KEY_FILE_SSE,
        modified: 0,
        failed: 0,
    };
    match (keyFileChange(mut k)) {
        KeyChange.Fresh(fresh, dropped, _) => {
            Check.equalU64(2, fresh.length as u64)?;
            Check.equalU64(1, dropped.length as u64)?;
            Check.equalBytes("k2".bytes(), dropped[0].view())?;
        }
        _ => { return Check.fail("the file's change"); }
    }
    // What needs a key: a version, a staged inline write, and (KMS) a bucket's default encryption.
    var s = ObjectStore.open(dir.view(), spaceConfig(0, 0))!;
    s.createBucket("bkt")!;
    s.setBucketConfig("bkt", BUCKET_CONFIG_ENCRYPTION, "aws:kms proj".bytes())!;
    var meta = Vector<u8>.create();
    metadataAdd(mut meta, SSE_FIELD.bytes(), "v1.s3.k2.00.00".bytes())!;
    var w = s.newWriter()!;
    w.write("sealed".bytes())!;
    let obj = w.finish()!;
    let _ = s.putInlineDeferred("bkt", "staged", "", meta.view(), "".bytes(), borrow obj)!;
    var ids = Vector<Vector<u8>>.create();
    ids.push(copyBytes("k2".bytes())!)!;
    Check.equalU64(1, sealedUnder(mut s, "s3", ids.view())!)?;
    ids[0] = copyBytes("k1".bytes())!;
    Check.equalU64(0, sealedUnder(mut s, "s3", ids.view())!)?;
    ids[0] = copyBytes("proj".bytes())!;
    Check.equalU64(1, sealedUnder(mut s, "kms", ids.view())!)?;
    // The commit check.
    let sse = readSseKeys(secondPath.view())!;
    let none = Vector<MasterKey>.create();
    Check.isTrue(sealKeyHeld(sse.view(), none.view(), meta.view()), "a key in the set")?;
    var gone = Vector<u8>.create();
    metadataAdd(mut gone, SSE_FIELD.bytes(), "v1.s3.k9.00.00".bytes())!;
    Check.isFalse(sealKeyHeld(sse.view(), none.view(), gone.view()), "a key removed")?;
    var kms = Vector<u8>.create();
    metadataAdd(mut kms, SSE_FIELD.bytes(), "v1.kms.k2.00.00".bytes())!;
    Check.isFalse(sealKeyHeld(sse.view(), none.view(), kms.view()), "KMS's envelope looks in KMS's keys")?;
    var customer = Vector<u8>.create();
    metadataAdd(mut customer, SSE_FIELD.bytes(), "v1.c.-.00.00".bytes())!;
    Check.isTrue(sealKeyHeld(none.view(), none.view(), customer.view()), "SSE-C needs no master key")?;
    Check.isTrue(sealKeyHeld(none.view(), none.view(), "".bytes()), "nothing sealed")?;
    return Ok();
}
