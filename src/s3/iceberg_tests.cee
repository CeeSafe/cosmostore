// The Iceberg REST catalog (ADR-0083 §5): a new table's metadata, requirements and updates.
import web_core;
import web_http;
import web_server;

fn jsonOf(text: StringView) -> Json => parseJson(text.bytes())!!;

fn textOfJson(j: borrow Json) -> Vector<u8> {
    var out = Vector<u8>.create();
    writeJson(mut out, j)!;
    return out;
}

@test
fn icebergNewTableMetadata() -> Result<void, TestFailure> {
    let request = jsonOf(
        "{\"name\":\"t\",\"schema\":{\"type\":\"struct\",\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"},{\"id\":2,\"name\":\"tags\",\"required\":false,\"type\":{\"type\":\"list\",\"element-id\":5,\"element\":\"string\",\"element-required\":false}}]},\"partition-spec\":{\"fields\":[{\"source-id\":1,\"field-id\":1000,\"name\":\"a_bucket\",\"transform\":\"bucket[4]\"}]},\"properties\":{\"k\":\"v\"}}",
    );
    let m = newTableMetadata(borrow request, "s3://w--table-s3/id".bytes())!!;
    Check.isTrue(jsonMemberI64(borrow m, "format-version") == Some(2i64), "version 2")?;
    Check.isTrue(jsonMemberI64(borrow m, "last-column-id") == Some(5i64), "the highest id, nested")?;
    Check.isTrue(jsonMemberI64(borrow m, "last-partition-id") == Some(1000i64), "the spec's")?;
    Check.equalBytes("s3://w--table-s3/id".bytes(), jsonMemberText(borrow m, "location")!)?;
    let noSchema = jsonOf("{\"name\":\"t\"}");
    Check.isTrue(newTableMetadata(borrow noSchema, "s3://w/x".bytes())!.isNull(), "no schema")?;
    return Ok();
}

fn refusedMetadata(text: StringView) -> bool {
    let request = jsonOf(text);
    return newTableMetadata(borrow request, "s3://w--table-s3/id".bytes())!.isNull();
}

@test
fn icebergCreateChecksIds() -> Result<void, TestFailure> {
    // Field ids given once each and above 0; a spec's and an order's columns the schema's (M9's exit review, C4).
    for (bad in [
        "{\"schema\":{\"type\":\"struct\",\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"},{\"id\":1,\"name\":\"b\",\"required\":true,\"type\":\"long\"}]}}",
        "{\"schema\":{\"type\":\"struct\",\"fields\":[{\"name\":\"a\",\"required\":true,\"type\":\"long\"}]}}",
        "{\"schema\":{\"type\":\"struct\",\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":{\"type\":\"list\",\"element-id\":1,\"element\":\"string\",\"element-required\":false}}]}}",
        "{\"schema\":{\"type\":\"struct\",\"fields\":[]}}",
        "{\"schema\":{\"type\":\"struct\",\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"}]},\"partition-spec\":{\"fields\":[{\"source-id\":9,\"field-id\":1000,\"name\":\"x\",\"transform\":\"identity\"}]}}",
        "{\"schema\":{\"type\":\"struct\",\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"}]},\"partition-spec\":{\"fields\":[{\"source-id\":1,\"field-id\":5,\"name\":\"x\",\"transform\":\"identity\"}]}}",
        "{\"schema\":{\"type\":\"struct\",\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"}]},\"write-order\":{\"order-id\":0,\"fields\":[{\"source-id\":2,\"transform\":\"identity\",\"direction\":\"asc\",\"null-order\":\"nulls-first\"}]}}",
    ]) {
        Check.isTrue(refusedMetadata(bad), bad)?;
    }
    // A spec field without its id gets the next; a sorted order is order 1, whatever id it came with.
    let request = jsonOf(
        "{\"schema\":{\"type\":\"struct\",\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"},{\"id\":2,\"name\":\"b\",\"required\":false,\"type\":\"string\"}]},\"partition-spec\":{\"fields\":[{\"source-id\":1,\"field-id\":1003,\"name\":\"x\",\"transform\":\"identity\"},{\"source-id\":2,\"name\":\"y\",\"transform\":\"identity\"}]},\"write-order\":{\"order-id\":0,\"fields\":[{\"source-id\":2,\"transform\":\"identity\",\"direction\":\"asc\",\"null-order\":\"nulls-first\"}]}}",
    );
    let m = newTableMetadata(borrow request, "s3://w--table-s3/id".bytes())!!;
    Check.isTrue(jsonMemberI64(borrow m, "last-partition-id") == Some(1004i64), "assigned after 1003")?;
    Check.isTrue(jsonMemberI64(borrow m, "default-sort-order-id") == Some(1i64), "a sorted order is 1")?;
    return Ok();
}

fn applied(m: borrow mut Json, updates: StringView) -> bool {
    let u = jsonOf(updates);
    return applyUpdates(m, borrow u, "s3://w--table-s3/id".bytes())!.isNull();
}

@test
fn icebergUpdatesAsIcebergApplies() -> Result<void, TestFailure> {
    let request = jsonOf(
        "{\"schema\":{\"type\":\"struct\",\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"}]}}",
    );
    var m = newTableMetadata(borrow request, "s3://w--table-s3/id".bytes())!!;
    // Two snapshots, the second's parent the first; main at the second, a tag at the first.
    Check.isTrue(applied(
        mut m,
        "[{\"action\":\"add-snapshot\",\"snapshot\":{\"snapshot-id\":11,\"parent-snapshot-id\":null,\"sequence-number\":1,\"timestamp-ms\":1000,\"manifest-list\":\"s3://w--table-s3/id/m1.avro\",\"summary\":{\"operation\":\"append\"}}},{\"action\":\"set-snapshot-ref\",\"ref-name\":\"main\",\"type\":\"branch\",\"snapshot-id\":11},{\"action\":\"set-snapshot-ref\",\"ref-name\":\"t1\",\"type\":\"tag\",\"snapshot-id\":11}]",
    ), "a first snapshot, its parent null (C8)")?;
    // A second whose sequence number is not above the last, with a parent: refused; with a null parent, taken.
    var old = cloneJson(borrow m)!;
    Check.isFalse(applied(
        mut old,
        "[{\"action\":\"add-snapshot\",\"snapshot\":{\"snapshot-id\":12,\"parent-snapshot-id\":11,\"sequence-number\":1,\"timestamp-ms\":2000,\"manifest-list\":\"s3://w--table-s3/id/m2.avro\"}}]",
    ), "an old sequence number")?;
    Check.isTrue(applied(
        mut m,
        "[{\"action\":\"add-snapshot\",\"snapshot\":{\"snapshot-id\":12,\"parent-snapshot-id\":11,\"sequence-number\":2,\"timestamp-ms\":2000,\"manifest-list\":\"s3://w--table-s3/id/m2.avro\"}},{\"action\":\"set-snapshot-ref\",\"ref-name\":\"main\",\"type\":\"branch\",\"snapshot-id\":12}]",
    ), "a second")?;
    Check.equalU64(2, arrayLength(borrow m, "snapshot-log") as u64)?;
    // Removing the first takes its tag and log entry with it, and the second's parent (C1).
    Check.isTrue(applied(mut m, "[{\"action\":\"remove-snapshots\",\"snapshot-ids\":[11]}]"), "removed")?;
    Check.isTrue(jsonMember(jsonMember(borrow m, "refs")!, "t1").isNull(), "its tag")?;
    Check.isTrue(jsonMember(jsonMember(borrow m, "refs")!, "main").isSome(), "main stays")?;
    Check.equalU64(1, arrayLength(borrow m, "snapshot-log") as u64)?;
    Check.isTrue(jsonMemberI64(borrow m, "current-snapshot-id") == Some(12i64), "current stays")?;
    let snaps = jsonMember(borrow m, "snapshots")!;
    let kept = match (snaps) {
        Json.Array(items) => jsonMember(borrow items[0], "parent-snapshot-id").isNull(),
        _ => false,
    };
    Check.isTrue(kept, "no parent left dangling")?;
    // Removing main's snapshot: main goes, and the current snapshot is none.
    Check.isTrue(applied(mut m, "[{\"action\":\"remove-snapshots\",\"snapshot-ids\":[12]}]"), "main's")?;
    Check.isTrue(jsonMember(jsonMember(borrow m, "refs")!, "main").isNull(), "main gone")?;
    Check.isTrue(jsonMemberI64(borrow m, "current-snapshot-id") == Some(-1i64), "no current")?;
    // `-1` is the last added by this commit: none added is refused (C7).
    for (bad in [
        "[{\"action\":\"set-current-schema\",\"schema-id\":-1}]",
        "[{\"action\":\"set-default-spec\",\"spec-id\":-1}]",
        "[{\"action\":\"set-default-sort-order\",\"sort-order-id\":-1}]",
        "[{\"action\":\"set-location\",\"location\":\"s3://w--table-s3/idX\"}]",
        "[{\"action\":\"set-properties\",\"updates\":{\"k\":1}}]",
        "[{\"action\":\"remove-properties\",\"removals\":[1]}]",
    ]) {
        var copy = cloneJson(borrow m)!;
        Check.isFalse(applied(mut copy, bad), bad)?;
    }
    Check.isTrue(applied(mut m, "[{\"action\":\"set-location\",\"location\":\"s3://w--table-s3/id/x\"}]"), "inside")?;
    // Properties on metadata that had none (an engine's file) are kept, not dropped (C6).
    jsonRemove(mut m, "properties".bytes());
    Check.isTrue(applied(mut m, "[{\"action\":\"set-properties\",\"updates\":{\"k\":\"v\"}}]"), "set")?;
    Check.equalBytes("v".bytes(), jsonMemberText(jsonMember(borrow m, "properties")!, "k")!)?;
    // No more than ICEBERG_MAX_CHANGES updates in a commit (B4).
    var many = Vector<u8>.create();
    many.push('[')!;
    for (i in 0..1001) {
        if (i > 0) { many.push(',')!; }
        many.extend("{\"action\":\"set-properties\",\"updates\":{\"k\":\"v\"}}".bytes())!;
    }
    many.push(']')!;
    let tooMany = parseJson(many.view())!!;
    Check.isTrue(applyUpdates(mut m, borrow tooMany, "s3://w--table-s3/id".bytes())!.isSome(), "too many")?;
    return Ok();
}

@test
fn icebergRequirementsAndUpdates() -> Result<void, TestFailure> {
    let request = jsonOf(
        "{\"schema\":{\"type\":\"struct\",\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"}]}}",
    );
    var m = newTableMetadata(borrow request, "s3://w--table-s3/id".bytes())!!;
    let uuid = copyBytes(jsonMemberText(borrow m, "table-uuid")!)!;
    // A first append: main has no snapshot yet (snapshot-id null).
    let first = jsonOf("[{\"type\":\"assert-ref-snapshot-id\",\"ref\":\"main\",\"snapshot-id\":null}]");
    Check.isTrue(checkRequirements(borrow m, borrow first)!.isNull(), "main unset")?;
    let updates = jsonOf(
        "[{\"action\":\"add-snapshot\",\"snapshot\":{\"snapshot-id\":8933763417129393145,\"sequence-number\":1,\"timestamp-ms\":1700000000000,\"manifest-list\":\"s3://w--table-s3/id/metadata/snap.avro\",\"summary\":{\"operation\":\"append\"},\"schema-id\":0}},{\"action\":\"set-snapshot-ref\",\"ref-name\":\"main\",\"type\":\"branch\",\"snapshot-id\":8933763417129393145},{\"action\":\"set-properties\",\"updates\":{\"owner\":\"x\"}}]",
    );
    Check.isTrue(applyUpdates(mut m, borrow updates, "s3://w--table-s3/id".bytes())!.isNull(), "applied")?;
    Check.isTrue(jsonMemberI64(borrow m, "current-snapshot-id") == Some(8933763417129393145i64), "current")?;
    Check.isTrue(jsonMemberI64(borrow m, "last-sequence-number") == Some(1i64), "its sequence number")?;
    Check.equalU64(1, arrayLength(borrow m, "snapshot-log") as u64)?;
    // Now main is at that snapshot: the first requirement no longer holds; one naming it does.
    Check.isTrue(checkRequirements(borrow m, borrow first)!.isSome(), "main moved on")?;
    let second = jsonOf("[{\"type\":\"assert-ref-snapshot-id\",\"ref\":\"main\",\"snapshot-id\":8933763417129393145}]");
    Check.isTrue(checkRequirements(borrow m, borrow second)!.isNull(), "main at it")?;
    var uuidReq = Vector<u8>.create();
    uuidReq.extend("[{\"type\":\"assert-table-uuid\",\"uuid\":\"".bytes())!;
    uuidReq.extend(uuid.view())!;
    uuidReq.extend("\"},{\"type\":\"assert-current-schema-id\",\"current-schema-id\":0}]".bytes())!;
    let both = parseJson(uuidReq.view())!!;
    Check.isTrue(checkRequirements(borrow m, borrow both)!.isNull(), "its uuid and schema")?;
    let create = jsonOf("[{\"type\":\"assert-create\"}]");
    Check.isTrue(checkRequirements(borrow m, borrow create)!.isSome(), "it exists")?;
    let other = jsonOf("[{\"type\":\"assert-other\"}]");
    Check.isTrue(checkRequirements(borrow m, borrow other)!.isSome(), "unknown")?;
    // Updates that are wrong, or not done here.
    for (bad in [
        "[{\"action\":\"set-snapshot-ref\",\"ref-name\":\"main\",\"type\":\"branch\",\"snapshot-id\":1}]",
        "[{\"action\":\"set-location\",\"location\":\"s3://elsewhere/t\"}]",
        "[{\"action\":\"upgrade-format-version\",\"format-version\":3}]",
        "[{\"action\":\"set-statistics\",\"snapshot-id\":1}]",
        "[{\"action\":\"add-schema\",\"schema\":{\"type\":\"struct\",\"schema-id\":0,\"fields\":[]}}]",
    ]) {
        var copy = cloneJson(borrow m)!;
        let update = jsonOf(bad);
        Check.isTrue(applyUpdates(mut copy, borrow update, "s3://w--table-s3/id".bytes())!.isSome(), bad)?;
    }
    // A schema added and made current with -1; a property removed.
    let evolve = jsonOf(
        "[{\"action\":\"add-schema\",\"schema\":{\"type\":\"struct\",\"schema-id\":1,\"fields\":[{\"id\":1,\"name\":\"a\",\"required\":true,\"type\":\"long\"},{\"id\":2,\"name\":\"b\",\"required\":false,\"type\":\"string\"}]}},{\"action\":\"set-current-schema\",\"schema-id\":-1},{\"action\":\"remove-properties\",\"removals\":[\"owner\"]}]",
    );
    Check.isTrue(applyUpdates(mut m, borrow evolve, "s3://w--table-s3/id".bytes())!.isNull(), "evolved")?;
    Check.isTrue(jsonMemberI64(borrow m, "current-schema-id") == Some(1i64), "schema 1")?;
    Check.isTrue(jsonMemberI64(borrow m, "last-column-id") == Some(2i64), "column 2")?;
    Check.isTrue(jsonMemberText(jsonMember(borrow m, "properties")!, "owner").isNull(), "owner removed")?;
    Check.isTrue(metadataVersion("s3://w/id/metadata/00012-abc.metadata.json".bytes()) == 12, "a file's version")?;
    var seg = Vector<u8>.create();
    encodedSegment("arn:aws:s3tables:us-east-1:0:bucket/b1".bytes(), mut seg)!;
    Check.equalBytes("arn%3Aaws%3As3tables%3Aus-east-1%3A0%3Abucket%2Fb1".bytes(), seg.view())?;
    let _ = textOfJson(borrow m);
    return Ok();
}
