// Iceberg views in the REST catalog (ADR-0134 §2 to §4), beyond S3 Tables: a view's record is
// `.s3tables/views/<namespace>/<name>` (its id, its metadata file's location, its times, and the encryption it was made
// under); its metadata files are in the table bucket's warehouse under its id, versioned and sealed as a table's are.
// Each call is authorized by an action of its own (`s3tables:CreateView` and the rest), on `<bucket>/view/<id>`.
import web_core;
import web_http;
import web_server;

const CATALOG_VIEWS: StringView = ".s3tables/views/";

fn viewKey(ns: Slice<u8>, name: Slice<u8>) -> Result<Vector<u8>, AllocError> => catalogKey(CATALOG_VIEWS, ns, name);

fn noSuchView() -> Result<TablesAnswer, TablesError> =>
    icebergError(404, "NoSuchViewException", "The view does not exist.");

/// Whether `<ns>/<name>` is a view's (a table may not take its name, nor a view a table's: ADR-0134 §2).
fn viewExists(
    store: borrow ObjectStore,
    hidden: Slice<u8>,
    ns: Slice<u8>,
    name: Slice<u8>,
) -> Result<bool, TablesError> =>
    Ok(readRecord(store, hidden, viewKey(ns, name)?.view())?.isSome());

/// Whether a namespace holds a view (it is then not dropped).
fn namespaceHasViews(store: borrow ObjectStore, hidden: Slice<u8>, ns: Slice<u8>) -> Result<bool, TablesError> {
    var under = viewKey(ns, "".bytes())?;
    under.push('/')?;
    return Ok(catalogKeys(store, hidden, under.view(), "".bytes(), 1)?.length > 0);
}

fn loadViewResult(location: Slice<u8>, m: Json) -> Result<TablesAnswer, TablesError> {
    var j = jsonObject();
    jsonSet(mut j, "metadata-location", jsonString(location)?)?;
    jsonSet(mut j, "metadata", m)?;
    jsonSet(mut j, "config", jsonObject())?;
    return tablesJson(borrow j);
}

// ---- The metadata (format version 1) ----

fn jsonTexts(j: borrow Json) -> bool => match (j) {
    Json.Array(items) => {
        for (i in 0..items.length) {
            match (borrow items[i]) {
                Json.Text(_) => {}
                _ => { return false; }
            }
        }
        true
    },
    _ => false,
};

/// A view version as the spec has it: its id and its schema's, a timestamp, its summary (an object of strings, as
/// Iceberg Java reads it), its SQL representations (one or more, each with its SQL and its dialect, the dialects
/// distinct), and its default namespace.
fn viewVersionOk(v: borrow Json) -> bool {
    if (jsonMemberI64(v, "version-id").isNull() || jsonMemberI64(v, "schema-id").isNull()) { return false; }
    if (jsonMemberI64(v, "timestamp-ms").isNull()) { return false; }
    match (jsonMember(v, "summary")) {
        Some(Json.Object(ms)) => {
            for (i in 0..ms.length) {
                match (borrow ms[i].value) {
                    Json.Text(_) => {}
                    _ => { return false; }
                }
            }
        }
        _ => { return false; }
    }
    match (jsonMember(v, "default-namespace")) {
        Some(ns) => {
            if (!jsonTexts(ns)) { return false; }
        }
        null => { return false; }
    }
    let reps = match (jsonMember(v, "representations")) {
        Some(Json.Array(items)) => items,
        _ => { return false; }
    };
    if (reps.length == 0) { return false; }
    for (i in 0..reps.length) {
        let r = borrow reps[i];
        if (jsonMemberText(r, "type") != Some("sql".bytes())) { return false; }
        let dialect = jsonMemberText(r, "dialect") ?? { return false; };
        if (jsonMemberText(r, "sql").isNull()) { return false; }
        for (k in 0..i) {
            if (equalsIgnoreCase(jsonMemberText(borrow reps[k], "dialect") ?? "".bytes(), dialect)) { return false; }
        }
    }
    return true;
}

/// A schema a view takes: a struct of field ids each once.
fn viewSchemaOk(s: borrow Json) -> Result<bool, AllocError> {
    if (jsonMemberText(s, "type") != Some("struct".bytes())) { return Ok(false); }
    return Ok(schemaColumns(s)?.isSome());
}

fn highestOf(m: borrow Json, list: StringView, idKey: StringView) -> i64 {
    var most: i64 = -1;
    match (jsonMember(m, list)) {
        Some(Json.Array(items)) => {
            for (i in 0..items.length) {
                let id = jsonMemberI64(borrow items[i], idKey) ?? -1;
                if (id > most) { most = id; }
            }
        }
        _ => {}
    }
    return most;
}

fn holdsMember(m: borrow Json, list: StringView, idKey: StringView, id: i64) -> bool {
    match (jsonMember(m, list)) {
        Some(Json.Array(items)) => {
            for (i in 0..items.length) {
                if (jsonMemberI64(borrow items[i], idKey) == Some(id)) { return true; }
            }
        }
        _ => {}
    }
    return false;
}

/// Whether two JSON values are the same: an object's members in any order, an array's in its, a number as written.
fn jsonSame(a: borrow Json, b: borrow Json) -> bool {
    match (a) {
        Json.Null => {
            return match (b) {
                Json.Null => true,
                _ => false,
            };
        }
        Json.Bool(x) => {
            return match (b) {
                Json.Bool(y) => x == y,
                _ => false,
            };
        }
        Json.Number(x) => {
            return match (b) {
                Json.Number(y) => x.view() == y.view(),
                _ => false,
            };
        }
        Json.Text(x) => {
            return match (b) {
                Json.Text(y) => x.view() == y.view(),
                _ => false,
            };
        }
        Json.Array(xs) => {
            match (b) {
                Json.Array(ys) => {
                    if (xs.length != ys.length) { return false; }
                    for (i in 0..xs.length) {
                        if (!jsonSame(borrow xs[i], borrow ys[i])) { return false; }
                    }
                    return true;
                }
                _ => { return false; }
            }
        }
        Json.Object(xs) => {
            match (b) {
                Json.Object(ys) => {
                    if (xs.length != ys.length) { return false; }
                    for (i in 0..xs.length) {
                        var found = false;
                        for (k in 0..ys.length) {
                            if (ys[k].key.view() == xs[i].key.view()) {
                                if (!jsonSame(borrow xs[i].value, borrow ys[k].value)) { return false; }
                                found = true;
                                break;
                            }
                        }
                        if (!found) { return false; }
                    }
                    return true;
                }
                _ => { return false; }
            }
        }
    }
}

/// Whether a member is the same in both: absent from both, or the same value. With `emptyIsAbsent`, an empty array
/// is as absent.
fn memberSame(a: borrow Json, b: borrow Json, key: StringView, emptyIsAbsent: bool) -> bool {
    let x = jsonMember(a, key);
    let y = jsonMember(b, key);
    let xAbsent = x.isNull() || (emptyIsAbsent && arrayLength(a, key) == 0);
    let yAbsent = y.isNull() || (emptyIsAbsent && arrayLength(b, key) == 0);
    if (xAbsent || yAbsent) { return xAbsent && yAbsent; }
    return jsonSame(x!, y!);
}

/// The id of a schema `m` holds that is the same as `s` (its fields and identifier fields), as Iceberg Java's
/// `Schema.sameSchema`; null if none is.
fn sameSchemaIn(m: borrow Json, s: borrow Json) -> i64? {
    match (jsonMember(m, "schemas")) {
        Some(Json.Array(items)) => {
            for (i in 0..items.length) {
                let held = borrow items[i];
                if (memberSame(held, s, "fields", false) && memberSame(held, s, "identifier-field-ids", true)) {
                    return jsonMemberI64(held, "schema-id");
                }
            }
        }
        _ => {}
    }
    return null;
}

/// The id of a version `m` holds that is the same as `v` (all but its id and time), as Iceberg Java's
/// `ViewMetadata.Builder.sameViewVersion`; null if none is.
fn sameVersionIn(m: borrow Json, v: borrow Json) -> i64? {
    match (jsonMember(m, "versions")) {
        Some(Json.Array(items)) => {
            for (i in 0..items.length) {
                let held = borrow items[i];
                if (memberSame(held, v, "summary", false) && memberSame(held, v, "representations", false) &&
                    memberSame(held, v, "default-catalog", false) && memberSame(held, v, "default-namespace", false) &&
                    jsonMemberI64(held, "schema-id") == jsonMemberI64(v, "schema-id")) {
                    return jsonMemberI64(held, "version-id");
                }
            }
        }
        _ => {}
    }
    return null;
}

/// A version's `timestamp-ms` in `m`; `fallback` if it has none.
fn versionTime(m: borrow Json, vid: i64, fallback: i64) -> i64 {
    match (jsonMember(m, "versions")) {
        Some(Json.Array(items)) => {
            for (i in 0..items.length) {
                if (jsonMemberI64(borrow items[i], "version-id") == Some(vid)) {
                    return jsonMemberI64(borrow items[i], "timestamp-ms") ?? fallback;
                }
            }
        }
        _ => {}
    }
    return fallback;
}

/// The versions a view keeps, `version.history.num-entries` (10 when absent) as Iceberg Java's builder reads it; null
/// when it is not a positive integer.
fn historySize(m: borrow Json) -> usize? {
    let props = jsonMember(m, "properties") ?? { return Some(10); };
    let text = jsonMemberText(props, "version.history.num-entries") ?? { return Some(10); };
    let n = parseDecimal(text) ?? { return null; };
    if (n == 0 || n > 2147483647) { return null; }
    return checkedTruncate<usize>(n);
}

/// Old versions expired as Iceberg Java's `ViewMetadata.Builder` expires them (B1 of M34's exit review, ADR-0136
/// §2): past the history size, the highest ids kept and the current one always, never one this commit added; the
/// version log keeps its entries from the last one of a version no longer kept. False when the history size is not
/// valid.
fn expireViewVersions(m: borrow mut Json, added: Slice<i64>) -> Result<bool, AllocError> {
    let size = historySize(m) ?? { return Ok(false); };
    let current = jsonMemberI64(m, "current-version-id") ?? -1;
    var must: usize = 1;
    for (i in 0..added.length) {
        if (added[i] != current) { must += 1; }
    }
    let keep = if (must > size) must else size;
    var ids = Vector<i64>.create();
    match (jsonMember(m, "versions")) {
        Some(Json.Array(items)) => {
            for (i in 0..items.length) { ids.push(jsonMemberI64(borrow items[i], "version-id") ?? -1)?; }
        }
        _ => {}
    }
    if (ids.length <= keep) { return Ok(true); }
    ids.sortBy((a, b) => if (a > b) -1 else if (a < b) 1 else 0);
    var kept = Vector<i64>.create();
    kept.push(current)?;
    for (i in 0..ids.length) {
        if (kept.length >= keep) { break; }
        if (ids[i] != current) { kept.push(ids[i])?; }
    }
    let keptView = kept.view();
    match (jsonMemberMut(m, "versions")) {
        Some(Json.Array(items)) => {
            items.retain((v) => keptHolds(keptView, jsonMemberI64(v, "version-id") ?? -1));
        }
        _ => {}
    }
    var log = jsonArray();
    match (jsonMember(m, "version-log")) {
        Some(Json.Array(entries)) => {
            for (i in 0..entries.length) {
                if (keptHolds(keptView, jsonMemberI64(borrow entries[i], "version-id") ?? -1)) {
                    jsonPush(mut log, cloneJson(borrow entries[i])?)?;
                } else {
                    log = jsonArray();
                }
            }
        }
        _ => {}
    }
    jsonSet(m, "version-log", log)?;
    return Ok(true);
}

fn keptHolds(kept: Slice<i64>, id: i64) -> bool {
    for (i in 0..kept.length) {
        if (kept[i] == id) { return true; }
    }
    return false;
}

/// A created view's metadata (`CreateViewRequest`: its schema, its version and its properties), at `location`; null
/// when the request is not one a view is made from.
fn newViewMetadata(request: borrow Json, location: Slice<u8>, now: i64) -> Result<Json?, AllocError> {
    let schema = jsonMember(request, "schema") ?? { return Ok(null); };
    if (!viewSchemaOk(schema)?) { return Ok(null); }
    let version = jsonMember(request, "view-version") ?? { return Ok(null); };
    var s = cloneJson(schema)?;
    jsonSet(mut s, "schema-id", jsonInteger(0)?)?;
    var v = cloneJson(version)?;
    let vid = match (jsonMemberI64(version, "version-id")) {
        Some(id) => if (id > 0) id else 1,
        null => 1,
    };
    jsonSet(mut v, "version-id", jsonInteger(vid)?)?;
    jsonSet(mut v, "schema-id", jsonInteger(0)?)?;
    if (jsonMemberI64(version, "timestamp-ms").isNull()) { jsonSet(mut v, "timestamp-ms", jsonInteger(now)?)?; }
    if (!viewVersionOk(borrow v)) { return Ok(null); }
    let at = jsonMemberI64(borrow v, "timestamp-ms") ?? now;
    var uuid = Vector<u8>.create();
    if (!newUuid(mut uuid)?) { return Ok(null); }
    var m = jsonObject();
    jsonSet(mut m, "view-uuid", Json.Text(uuid))?;
    jsonSet(mut m, "format-version", jsonInteger(1)?)?;
    jsonSet(mut m, "location", jsonString(location)?)?;
    jsonSet(mut m, "current-version-id", jsonInteger(vid)?)?;
    var versions = jsonArray();
    jsonPush(mut versions, v)?;
    jsonSet(mut m, "versions", versions)?;
    // The log's entry at the version's time, as Iceberg Java's builder stamps it (ADR-0136 §2).
    var entry = jsonObject();
    jsonSet(mut entry, "timestamp-ms", jsonInteger(at)?)?;
    jsonSet(mut entry, "version-id", jsonInteger(vid)?)?;
    var log = jsonArray();
    jsonPush(mut log, entry)?;
    jsonSet(mut m, "version-log", log)?;
    var schemas = jsonArray();
    jsonPush(mut schemas, s)?;
    jsonSet(mut m, "schemas", schemas)?;
    let properties = match (jsonMember(request, "properties")) {
        Some(Json.Object(ms)) => {
            for (k in 0..ms.length) {
                match (borrow ms[k].value) {
                    Json.Text(_) => {}
                    _ => { return Ok(null); }
                }
            }
            cloneJson(jsonMember(request, "properties")!)?
        }
        Some(_) => { return Ok(null); }
        null => jsonObject(),
    };
    jsonSet(mut m, "properties", properties)?;
    return Ok(Some(m));
}

/// Whether a view commit's requirements hold: `assert-view-uuid` only.
fn viewRequirementsHold(m: borrow Json, requirements: borrow Json?) -> bool {
    let rs = match (requirements) {
        Some(Json.Array(items)) => items,
        Some(_) => { return false; }
        null => { return true; }
    };
    for (i in 0..rs.length) {
        let r = borrow rs[i];
        if (jsonMemberText(r, "type") != Some("assert-view-uuid".bytes())) { return false; }
        if (jsonMemberText(r, "uuid") != jsonMemberText(m, "view-uuid")) { return false; }
    }
    return true;
}

/// A view commit's updates applied to `m` (the spec's eight); false when one is not valid, or of a kind not taken.
fn applyViewUpdates(m: borrow mut Json, updates: borrow Json?, now: i64) -> Result<bool, AllocError> {
    let us = match (updates) {
        Some(Json.Array(items)) => items,
        Some(_) => { return Ok(false); }
        null => { return Ok(true); }
    };
    var lastSchema: i64 = -1;
    var lastVersion: i64 = -1;
    var added = Vector<i64>.create();
    for (i in 0..us.length) {
        let u = borrow us[i];
        let action = jsonMemberText(u, "action") ?? { return Ok(false); };
        if (action == "assign-uuid".bytes()) {
            if (jsonMemberText(u, "uuid") != jsonMemberText(m, "view-uuid")) { return Ok(false); }
        } else if (action == "upgrade-format-version".bytes()) {
            if (jsonMemberI64(u, "format-version") != Some(1)) { return Ok(false); }
        } else if (action == "add-schema".bytes()) {
            let schema = jsonMember(u, "schema") ?? { return Ok(false); };
            if (!viewSchemaOk(schema)?) { return Ok(false); }
            // A schema the view holds already is reused, its id the last added (ADR-0136 §2, as Java's builder).
            match (sameSchemaIn(m, schema)) {
                Some(held) => {
                    lastSchema = held;
                    continue;
                }
                null => {}
            }
            var sid = jsonMemberI64(schema, "schema-id") ?? -1;
            let top = highestOf(m, "schemas", "schema-id");
            if (sid <= top) { sid = top + 1; }
            var s = cloneJson(schema)?;
            jsonSet(mut s, "schema-id", jsonInteger(sid)?)?;
            appendTo(m, "schemas", s)?;
            lastSchema = sid;
        } else if (action == "set-location".bytes()) {
            // A view's location is its warehouse, as at its create (the M34 exit review's L3).
            let location = jsonMemberText(u, "location") ?? { return Ok(false); };
            if (Some(location) != jsonMemberText(m, "location")) { return Ok(false); }
        } else if (action == "set-properties".bytes()) {
            var props = match (jsonMember(m, "properties")) {
                Some(p) => cloneJson(p)?,
                null => jsonObject(),
            };
            match (jsonMember(u, "updates")) {
                Some(Json.Object(ms)) => {
                    for (k in 0..ms.length) {
                        match (borrow ms[k].value) {
                            Json.Text(_) => {}
                            _ => { return Ok(false); }
                        }
                        // A key that is not UTF-8 is refused, not kept as "" (the M34 exit review's L6).
                        let key = StringView.fromUtf8(ms[k].key.view()) ?? { return Ok(false); };
                        jsonSet(mut props, key, cloneJson(borrow ms[k].value)?)?;
                    }
                }
                _ => { return Ok(false); }
            }
            jsonSet(m, "properties", props)?;
        } else if (action == "remove-properties".bytes()) {
            var props = match (jsonMember(m, "properties")) {
                Some(p) => cloneJson(p)?,
                null => jsonObject(),
            };
            match (jsonMember(u, "removals")) {
                Some(Json.Array(items)) => {
                    for (k in 0..items.length) {
                        match (borrow items[k]) {
                            Json.Text(t) => { jsonRemove(mut props, t.view()); }
                            _ => { return Ok(false); }
                        }
                    }
                }
                _ => { return Ok(false); }
            }
            jsonSet(m, "properties", props)?;
        } else if (action == "add-view-version".bytes()) {
            let version = jsonMember(u, "view-version") ?? { return Ok(false); };
            var v = cloneJson(version)?;
            var sid = jsonMemberI64(version, "schema-id") ?? -1;
            if (sid == -1) { sid = lastSchema; }
            if (sid < 0 || !holdsMember(m, "schemas", "schema-id", sid)) { return Ok(false); }
            jsonSet(mut v, "schema-id", jsonInteger(sid)?)?;
            if (jsonMemberI64(version, "timestamp-ms").isNull()) { jsonSet(mut v, "timestamp-ms", jsonInteger(now)?)?; }
            var vid = jsonMemberI64(version, "version-id") ?? -1;
            let top = highestOf(m, "versions", "version-id");
            if (vid <= top) { vid = top + 1; }
            if (vid < 1) { vid = 1; }
            jsonSet(mut v, "version-id", jsonInteger(vid)?)?;
            if (!viewVersionOk(borrow v)) { return Ok(false); }
            // A version the view holds already (all but its id and time) is reused (ADR-0136 §2, as Java's builder).
            match (sameVersionIn(m, borrow v)) {
                Some(held) => {
                    lastVersion = held;
                    continue;
                }
                null => {}
            }
            appendTo(m, "versions", v)?;
            added.push(vid)?;
            lastVersion = vid;
        } else if (action == "set-current-view-version".bytes()) {
            var vid = jsonMemberI64(u, "view-version-id") ?? { return Ok(false); };
            if (vid == -1) { vid = lastVersion; }
            if (vid < 1 || !holdsMember(m, "versions", "version-id", vid)) { return Ok(false); }
            // The current version again is no change, and no entry in the log (the M34 exit review's L2).
            if (jsonMemberI64(m, "current-version-id") == Some(vid)) { continue; }
            jsonSet(m, "current-version-id", jsonInteger(vid)?)?;
            var entry = jsonObject();
            jsonSet(mut entry, "timestamp-ms", jsonInteger(versionTime(m, vid, now))?)?;
            jsonSet(mut entry, "version-id", jsonInteger(vid)?)?;
            appendTo(m, "version-log", entry)?;
        } else {
            return Ok(false);
        }
    }
    return expireViewVersions(m, added.view());
}

// ---- The calls ----

/// `/v1/{prefix}/namespaces/{ns}/views[/{view}]` (ADR-0134 §3): `rest` from `views`.
fn icebergViews(
    store: borrow mut ObjectStore,
    m: Method,
    b: Slice<u8>,
    ns: Slice<u8>,
    rest: Slice<Vector<u8>>,
    body: Slice<u8>,
    caller: borrow TablesCaller,
    sealing: borrow WarehouseKeys,
) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(b)?;
    // Authorized before a namespace's existence is told (the M34 exit review's L1).
    if (rest.length == 1) {
        if (isMethod(m, Method.Get)) {
            checkTablesView(store, caller, "s3tables:ListViews", b, "".bytes())?;
            if (!namespaceExists(store, hidden.view(), ns)?) { return noSuchNamespace(); }
            return listViews(store, hidden.view(), ns);
        }
        if (isMethod(m, Method.Post)) {
            checkTablesView(store, caller, "s3tables:CreateView", b, "".bytes())?;
            if (!namespaceExists(store, hidden.view(), ns)?) { return noSuchNamespace(); }
            return createView(store, b, ns, body, sealing);
        }
        return icebergUnsupported();
    }
    if (rest.length != 2) { return icebergUnsupported(); }
    let name = rest[1].view();
    let key = viewKey(ns, name)?;
    let rec = readRecord(store, hidden.view(), key.view())? ?? {
        // Not one: refused as its action would be, so that a caller learns nothing it may not ask.
        checkTablesView(store, caller, "s3tables:GetView", b, "".bytes())?;
        if (!namespaceExists(store, hidden.view(), ns)?) { return noSuchNamespace(); }
        return noSuchView();
    };
    let id = copyBytes(jsonMemberText(borrow rec.json, "id") ?? "".bytes())?;
    if (isMethod(m, Method.Head)) {
        checkTablesView(store, caller, "s3tables:GetView", b, id.view())?;
        return Ok(tablesNoContent());
    }
    if (isMethod(m, Method.Get)) {
        checkTablesView(store, caller, "s3tables:GetView", b, id.view())?;
        let location = copyBytes(jsonMemberText(borrow rec.json, "metadataLocation") ?? "".bytes())?;
        let meta = readMetadataWith(store, hidden.view(), location.view(), sealing)?;
        return loadViewResult(location.view(), meta);
    }
    if (isMethod(m, Method.Post)) {
        checkTablesView(store, caller, "s3tables:UpdateView", b, id.view())?;
        return commitView(store, hidden.view(), key.view(), rec, body, sealing);
    }
    if (isMethod(m, Method.Delete)) {
        checkTablesView(store, caller, "s3tables:DeleteView", b, id.view())?;
        match (store.deleteObject(catalogText(hidden.view()), catalogText(key.view()))) {
            Ok(_) => {}
            Err(e) => { return Err(tablesStoreFail(e)); }
        }
        // Its files go after the answer, as a dropped table's (`purgeWarehouse`).
        var answer = tablesNoContent();
        answer.purgeBucket = hidden;
        answer.purgeId = id;
        return Ok(answer);
    }
    return icebergUnsupported();
}

fn listViews(store: borrow ObjectStore, hidden: Slice<u8>, ns: Slice<u8>) -> Result<TablesAnswer, TablesError> {
    var under = viewKey(ns, "".bytes())?;
    under.push('/')?;
    let keys = catalogKeys(store, hidden, under.view(), "".bytes(), 0)?;
    var ids = jsonArray();
    for (k in keys.view()) {
        var ident = jsonObject();
        jsonSet(mut ident, "namespace", namespaceJson(ns)?)?;
        jsonSet(mut ident, "name", jsonString(k.view()[under.length..])?)?;
        jsonPush(mut ids, ident)?;
    }
    var j = jsonObject();
    jsonSet(mut j, "identifiers", ids)?;
    return tablesJson(borrow j);
}

/// CreateView: its name a table's nor a view's in its namespace, its metadata file sealed with its bucket's
/// encryption, its record written once.
fn createView(
    store: borrow mut ObjectStore,
    bucket: Slice<u8>,
    ns: Slice<u8>,
    body: Slice<u8>,
    sealing: borrow WarehouseKeys,
) -> Result<TablesAnswer, TablesError> {
    let request = parseJson(body)? ?? { return badRequest("The body is not JSON."); };
    let name = copyBytes(jsonMemberText(borrow request, "name") ?? "".bytes())?;
    if (!tableNameOk(name.view(), false)) { return badRequest("A view's name is 1 to 255 of a-z, 0-9 and _."); }
    let hidden = tableWarehouseBucket(bucket)?;
    let tableKey = catalogKey(CATALOG_TABLES, ns, name.view())?;
    if (readRecord(store, hidden.view(), tableKey.view())?.isSome() || viewExists(
        store,
        hidden.view(),
        ns,
        name.view(),
    )?) {
        return icebergError(409, "AlreadyExistsException", "A table or view has the name.");
    }
    var id = Vector<u8>.create();
    if (!newUuid(mut id)?) { return Err(TablesError.Internal); }
    let warehouse = warehouseOf(bucket, id.view())?;
    match (jsonMemberText(borrow request, "location")) {
        Some(l) => {
            if (l != warehouse.view()) { return badRequest("A view's location is its warehouse."); }
        }
        null => {}
    }
    let now = Clock.unixMillis();
    let m = newViewMetadata(borrow request, warehouse.view(), now)? ?? {
        return badRequest("A view needs a struct schema and a version with its SQL.");
    };
    // Sealed with its bucket's encryption, kept with its record for its later versions (ADR-0134 §2).
    let encryption = bucketEncryption(store, hidden.view())?;
    match (encryption.asBorrow()) {
        Some(e) => {
            if (!encryptionHeld(e, sealing)) { return Err(TablesError.BadRequest); }
        }
        null => {}
    }
    let location = writeMetadataSealedBy(store, hidden.view(), id.view(), 0, borrow m, sealing, encryption.asBorrow())?;
    var rec = jsonObject();
    jsonSet(mut rec, "id", jsonString(id.view())?)?;
    jsonSet(mut rec, "metadataLocation", jsonString(location.view())?)?;
    jsonSet(mut rec, "createdAt", jsonInteger(now)?)?;
    jsonSet(mut rec, "modifiedAt", jsonInteger(now)?)?;
    match (encryption) {
        Some(e) => { jsonSet(mut rec, "encryption", e)?; }
        null => {}
    }
    match (writeRecord(store, hidden.view(), viewKey(ns, name.view())?.view(), borrow rec, PutCondition.IfAbsent)) {
        Ok(_) => {}
        Err(e) => {
            removeMetadataFile(store, hidden.view(), location.view());
            return match (e) {
                TablesError.Conflict => icebergError(409, "AlreadyExistsException", "A table or view has the name."),
                _ => Err(e),
            };
        }
    }
    return loadViewResult(location.view(), m);
}

/// A view's commit (ADR-0134 §3): its requirements checked, its updates applied, its next metadata file written and
/// its record swapped if it has not changed since it was read (CommitFailed else).
fn commitView(
    store: borrow mut ObjectStore,
    hidden: Slice<u8>,
    key: Slice<u8>,
    rec: CatalogRecord,
    body: Slice<u8>,
    sealing: borrow WarehouseKeys,
) -> Result<TablesAnswer, TablesError> {
    let request = parseJson(body)? ?? { return badRequest("The body is not JSON."); };
    let id = copyBytes(jsonMemberText(borrow rec.json, "id") ?? "".bytes())?;
    let previous = copyBytes(jsonMemberText(borrow rec.json, "metadataLocation") ?? "".bytes())?;
    var m = readMetadataWith(store, hidden, previous.view(), sealing)?;
    if (!viewRequirementsHold(borrow m, jsonMember(borrow request, "requirements"))) {
        return icebergError(409, "CommitFailedException", "A requirement of the commit does not hold.");
    }
    let now = Clock.unixMillis();
    if (!applyViewUpdates(mut m, jsonMember(borrow request, "updates"), now)?) {
        return badRequest("An update is not valid here, or not one this catalog applies.");
    }
    // No updates: no new metadata file (the M34 exit review's L2).
    let changes = match (jsonMember(borrow request, "updates")) {
        Some(Json.Array(items)) => items.length,
        _ => 0,
    };
    if (changes == 0) { return loadViewResult(previous.view(), m); }
    let version = metadataVersion(previous.view());
    let encryption: Json? = match (jsonMember(borrow rec.json, "encryption")) {
        Some(e) => Some(cloneJson(e)?),
        null => null,
    };
    let location = writeMetadataSealedBy(
        store,
        hidden,
        id.view(),
        if (version >= 0) version + 1 else 1,
        borrow m,
        sealing,
        encryption.asBorrow(),
    )?;
    var next = cloneJson(borrow rec.json)?;
    jsonSet(mut next, "metadataLocation", jsonString(location.view())?)?;
    jsonSet(mut next, "modifiedAt", jsonInteger(now)?)?;
    match (writeRecord(store, hidden, key, borrow next, PutCondition.IfGeneration(rec.generation))) {
        Ok(_) => {}
        Err(e) => {
            removeMetadataFile(store, hidden, location.view());
            return match (e) {
                TablesError.Conflict => icebergError(
                    409,
                    "CommitFailedException",
                    "The view changed since it was read.",
                ),
                _ => Err(e),
            };
        }
    }
    return loadViewResult(location.view(), m);
}

/// `POST /v1/{prefix}/views/rename` (ADR-0134 §3): within its table bucket, to a namespace there, to a name no
/// table or view has.
fn icebergRenameView(
    store: borrow mut ObjectStore,
    bucket: Slice<u8>,
    body: Slice<u8>,
    caller: borrow TablesCaller,
) -> Result<TablesAnswer, TablesError> {
    let request = parseJson(body)? ?? { return badRequest("The body is not JSON."); };
    let source = jsonMember(borrow request, "source") ?? { return badRequest("A rename names its source."); };
    let destination = jsonMember(borrow request, "destination") ?? {
        return badRequest("A rename names its destination.");
    };
    let fromNs = nestedNamespaceOf(source)? ?? { return badRequest("A namespace is 1 to 8 levels here."); };
    let toNs = nestedNamespaceOf(destination)? ?? { return badRequest("A namespace is 1 to 8 levels here."); };
    let fromName = copyBytes(jsonMemberText(source, "name") ?? "".bytes())?;
    let toName = copyBytes(jsonMemberText(destination, "name") ?? "".bytes())?;
    if (!tableNameOk(toName.view(), false)) { return badRequest("A view's name is 1 to 255 of a-z, 0-9 and _."); }
    let hidden = tableWarehouseBucket(bucket)?;
    let from = viewKey(fromNs.view(), fromName.view())?;
    let rec = readRecord(store, hidden.view(), from.view())? ?? {
        checkTablesView(store, caller, "s3tables:RenameView", bucket, "".bytes())?;
        return noSuchView();
    };
    checkTablesView(store, caller, "s3tables:RenameView", bucket, jsonMemberText(borrow rec.json, "id") ?? "".bytes())?;
    if (!namespaceExists(store, hidden.view(), toNs.view())?) { return noSuchNamespace(); }
    let tableKey = catalogKey(CATALOG_TABLES, toNs.view(), toName.view())?;
    if (readRecord(store, hidden.view(), tableKey.view())?.isSome() ||
        viewExists(store, hidden.view(), toNs.view(), toName.view())?) {
        return icebergError(409, "AlreadyExistsException", "A table or view has the name.");
    }
    let to = viewKey(toNs.view(), toName.view())?;
    match (store.renameObjectTo(
        catalogText(hidden.view()),
        catalogText(from.view()),
        catalogText(to.view()),
        rec.generation,
        "".bytes(),
        true,
    )) {
        Ok() => {}
        Err(e) => { return Err(tablesStoreFail(e)); }
    }
    return Ok(tablesNoContent());
}
