// S3 Tables (ADR-0083): the JSON model, names, ARNs, and what S3's calls may do in a table bucket's warehouse.
import web_core;
import web_http;
import web_server;

fn roundTrip(text: StringView) -> Vector<u8> {
    let j = parseJson(text.bytes())!!;
    var out = Vector<u8>.create();
    writeJson(mut out, borrow j)!;
    return out;
}

@test
fn jsonModel() -> Result<void, TestFailure> {
    Check.equalBytes(
        "{\"a\":[1,-2.5e3,true,false,null],\"b\":{\"c\":\"x\\\"y\"}}".bytes(),
        roundTrip(" { \"a\" : [ 1 , -2.5e3 , true , false , null ] , \"b\" : { \"c\" : \"x\\\"y\" } } ").view(),
    )?;
    // Numbers keep their text: a snapshot id past 2^53 goes through exactly.
    Check.equalBytes("{\"id\":8933763417129393145}".bytes(), roundTrip("{\"id\":8933763417129393145}").view())?;
    let j = parseJson("{\"id\":8933763417129393145,\"s\":\"\\u00e9\\ud83d\\ude00\",\"n\":-7}".bytes())!!;
    Check.isTrue(jsonMemberI64(borrow j, "id") == Some(8933763417129393145i64), "a 64-bit integer")?;
    Check.isTrue(jsonMemberI64(borrow j, "n") == Some(-7i64), "a negative one")?;
    Check.equalBytes([0xC3u8, 0xA9, 0xF0, 0x9F, 0x98, 0x80][..], jsonMemberText(borrow j, "s")!)?;
    for (bad in ["", "{", "{\"a\":}", "[1,]", "{\"a\":1}x", "\"\\x\"", "01a", "{\"a\" 1}", "\"\\ud800\""]) {
        Check.isTrue(parseJson(bad.bytes())!.isNull(), bad)?;
    }
    var deep = String.create();
    for (i in 0..70) { deep.append("[")!; }
    for (i in 0..70) { deep.append("]")!; }
    Check.isTrue(parseJson(deep.bytes())!.isNull(), "nested past the limit")?;
    // Editing.
    var o = jsonObject();
    jsonSet(mut o, "k", jsonInteger(-9223372036854775807 - 1)!)!;
    jsonSet(mut o, "t", jsonString("a\nb".bytes())!)!;
    jsonSet(mut o, "k", jsonInteger(42)!)!;
    var out = Vector<u8>.create();
    writeJson(mut out, borrow o)!;
    Check.equalBytes("{\"k\":42,\"t\":\"a\\nb\"}".bytes(), out.view())?;
    jsonRemove(mut o, "k".bytes());
    let copy = cloneJson(borrow o)!;
    out.clear();
    writeJson(mut out, borrow copy)!;
    Check.equalBytes("{\"t\":\"a\\nb\"}".bytes(), out.view())?;
    Check.isTrue(parseJsonInteger("-9223372036854775808".bytes()) == Some(-9223372036854775807 - 1), "i64's least")?;
    Check.isTrue(parseJsonInteger("9223372036854775807".bytes()) == Some(9223372036854775807i64), "its most")?;
    Check.isTrue(parseJsonInteger("9223372036854775808".bytes()).isNull(), "past i64 (kept as text)")?;
    Check.isTrue(parseJsonInteger("-9223372036854775809".bytes()).isNull(), "below it")?;
    return Ok();
}

@test
fn jsonModelRefusesAndScales() -> Result<void, TestFailure> {
    // Leading zeros, a key twice, and strings that are not UTF-8 are not JSON (M9's exit review, C10).
    for (bad in ["0123", "-01", "[00]", "{\"a\":1,\"a\":2}", "{\"b\":1,\"a\":2,\"b\":3}"]) {
        Check.isTrue(parseJson(bad.bytes())!.isNull(), bad)?;
    }
    for (good in ["0", "-0", "0.5", "-0e1", "{\"a\":1,\"b\":{\"a\":2}}"]) {
        Check.isTrue(parseJson(good.bytes())!.isSome(), good)?;
    }
    Check.isTrue(parseJson([0x22u8, 0xFF, 0x22][..])!.isNull(), "a string not UTF-8")?;
    Check.isTrue(parseJson([0x7Bu8, 0x22, 0xC3, 0x22, 0x3A, 0x31, 0x7D][..])!.isNull(), "a key not UTF-8")?;
    // Set many members at once, in log n each (B4): replaced in place, new ones after in their order.
    var o = parseJson("{\"x\":\"1\",\"y\":\"2\"}".bytes())!!;
    let changes = parseJson("{\"z\":\"3\",\"y\":\"two\",\"a\":\"4\"}".bytes())!!;
    jsonSetAll(mut o, borrow changes)!;
    var out = Vector<u8>.create();
    writeJson(mut out, borrow o)!;
    Check.equalBytes("{\"x\":\"1\",\"y\":\"two\",\"z\":\"3\",\"a\":\"4\"}".bytes(), out.view())?;
    var gone = Vector<Vector<u8>>.create();
    gone.push(copyBytes("z".bytes())!)!;
    gone.push(copyBytes("x".bytes())!)!;
    gone.push(copyBytes("none".bytes())!)!;
    jsonRemoveAll(mut o, mut gone);
    out.clear();
    writeJson(mut out, borrow o)!;
    Check.equalBytes("{\"y\":\"two\",\"a\":\"4\"}".bytes(), out.view())?;
    // 50,000 properties set, then all removed: n log n, not n² (the review measured 60,000 at 2.4 s before).
    var many = jsonObject();
    var members = Vector<JsonMember>.create();
    var keys = Vector<Vector<u8>>.create();
    for (i in 0..50000) {
        var k = copyBytes("p".bytes())!;
        appendDecimal(mut k, truncate<u64>(i))!;
        members.push(JsonMember { key: copyBytes(k.view())!, value: jsonString("v".bytes())! })!;
        keys.push(k)!;
    }
    let big = Json.Object(members);
    let started = Clock.unixMillis();
    jsonSetAll(mut many, borrow big)!;
    jsonSetAll(mut many, borrow big)!;
    Check.equalU64(50000, match (borrow many) {
        Json.Object(ms) => ms.length as u64,
        _ => 0,
    })?;
    jsonRemoveAll(mut many, mut keys);
    Check.equalU64(0, match (borrow many) {
        Json.Object(ms) => ms.length as u64,
        _ => 1,
    })?;
    Check.isTrue(Clock.unixMillis() - started < 2000, "quick")?;
    return Ok();
}

@test
fn tableIdsAndCatalogKeys() -> Result<void, TestFailure> {
    // A purge reaches only a UUID's prefix (B1): never `.s3tables` or another prefix a forged record would name.
    Check.isTrue(uuidShaped("0f8e9a2b-1c3d-4e5f-8a7b-6c5d4e3f2a1b".bytes()), "a table's id")?;
    for (bad in [
        ".s3tables",
        "",
        "0f8e9a2b-1c3d-4e5f-8a7b-6c5d4e3f2a1",
        "0f8e9a2b-1c3d-4e5f-8a7b-6c5d4e3f2a1bc",
        "0F8E9A2B-1C3D-4E5F-8A7B-6C5D4E3F2A1B",
        "0f8e9a2b-1c3d-4e5f-8a7b/6c5d4e3f2a1b",
        "0f8e9a2bx1c3d-4e5f-8a7b-6c5d4e3f2a1b",
    ]) {
        Check.isFalse(uuidShaped(bad.bytes()), bad)?;
    }
    let hidden = "002b2b5256073c200d64b94c800f0b93--table-s3".bytes();
    Check.isTrue(catalogObject(hidden, ".s3tables/tables/ns/t".bytes()), "a catalog record")?;
    Check.isFalse(catalogObject(hidden, "id/data/a.parquet".bytes()), "a warehouse's object")?;
    Check.isFalse(catalogObject("plain".bytes(), ".s3tables/tables/ns/t".bytes()), "another bucket's key")?;
    // The warehouse's boundary (B7): itself or under `<warehouse>/`, not a sibling that shares its id as a prefix.
    let w = "s3://w--table-s3/id".bytes();
    Check.isTrue(withinWarehouse(w, w) && withinWarehouse("s3://w--table-s3/id/x".bytes(), w), "within")?;
    Check.isFalse(withinWarehouse("s3://w--table-s3/idX".bytes(), w), "a sibling")?;
    Check.isFalse(withinWarehouse("s3://w--table-s3/i".bytes(), w), "shorter")?;
    // A gzipped metadata file is not read here, so it is not taken (C5).
    Check.isFalse(metadataLocationOk("s3://w--table-s3/id/metadata/00001-a.metadata.json.gz".bytes(), w), ".gz")?;
    Check.isFalse(metadataLocationOk("s3://w--table-s3/idX/00001-a.metadata.json".bytes(), w), "beside it")?;
    return Ok();
}

fn createRequestRefused(metadata: StringView) -> bool {
    let md = parseJson(metadata.bytes())!!;
    return createRequestOfMetadata(borrow md).isErr();
}

@test
fn createTableMetadataShapes() -> Result<void, TestFailure> {
    // CreateTable's `metadata` takes AWS's shapes' members only (C6): another, or a type not a string, is refused.
    let ok =
        "{\"iceberg\":{\"schema\":{\"fields\":[{\"id\":1,\"name\":\"a\",\"type\":\"long\",\"required\":true}]},\"partitionSpec\":{\"spec-id\":0,\"fields\":[{\"source-id\":1,\"transform\":\"identity\",\"name\":\"a\",\"field-id\":1000}]},\"writeOrder\":{\"order-id\":1,\"fields\":[{\"source-id\":1,\"transform\":\"identity\",\"direction\":\"asc\",\"null-order\":\"nulls-first\"}]},\"properties\":{\"k\":\"v\"}}}";
    Check.isFalse(createRequestRefused(ok), "AWS's shapes")?;
    for (bad in [
        "{\"iceberg\":{\"schema\":{\"fields\":[{\"name\":\"a\",\"type\":\"long\",\"doc\":\"d\"}]}}}",
        "{\"iceberg\":{\"schema\":{\"fields\":[{\"name\":\"a\",\"type\":{\"type\":\"list\"}}]}}}",
        "{\"iceberg\":{\"schema\":{\"fields\":[{\"name\":\"a\"}]}}}",
        "{\"iceberg\":{\"schema\":{\"fields\":[{\"name\":\"a\",\"type\":\"long\",\"required\":\"yes\"}]}}}",
        "{\"iceberg\":{\"schema\":{\"fields\":[]},\"other\":1}}",
        "{\"iceberg\":{\"schema\":{\"fields\":[]}},\"more\":1}",
        "{\"iceberg\":{\"schema\":{\"fields\":[{\"name\":\"a\",\"type\":\"long\"}]},\"partitionSpec\":{\"spec-id\":3,\"fields\":[]}}}",
        "{\"iceberg\":{\"schema\":{\"fields\":[{\"name\":\"a\",\"type\":\"long\"}]},\"partitionSpec\":{\"fields\":[{\"source-id\":1,\"name\":\"a\"}]}}}",
        "{\"iceberg\":{\"schema\":{\"fields\":[{\"name\":\"a\",\"type\":\"long\"}]},\"writeOrder\":{\"fields\":[]}}}",
    ]) {
        Check.isTrue(createRequestRefused(bad), bad)?;
    }
    return Ok();
}

@test
fn tableNamesAndArns() -> Result<void, TestFailure> {
    Check.isTrue(tableBucketNameOk("analytics".bytes()) && tableBucketNameOk("a-1".bytes()), "table bucket names")?;
    for (bad in [
        "ab",
        "Analytics",
        "a_b",
        "-ab",
        "ab-",
        "xn--ab",
        "awsdata",
        "data--x-s3",
        "data--table-s3",
        "data-s3alias",
    ]) {
        Check.isFalse(tableBucketNameOk(bad.bytes()), bad)?;
    }
    Check.isTrue(tableNameOk("orders_2025".bytes(), false) && tableNameOk("aws_like".bytes(), false), "table names")?;
    Check.isFalse(tableNameOk("aws_like".bytes(), true), "a namespace beginning aws")?;
    for (bad in ["", "_a", "a-b", "A", "a.b"]) { Check.isFalse(tableNameOk(bad.bytes(), false), bad)?; }
    var id = Vector<u8>.create();
    let b = tableBucketOfArn("arn:aws:s3tables:us-east-1:000000000000:bucket/analytics".bytes(), mut id)!!;
    Check.equalBytes("analytics".bytes(), b.view())?;
    Check.equalU64(0, id.length as u64)?;
    let t = tableBucketOfArn("arn:aws:s3tables:eu-west-1:123456789012:bucket/analytics/table/abc-1".bytes(), mut id)!!;
    Check.equalBytes("analytics".bytes(), t.view())?;
    Check.equalBytes("abc-1".bytes(), id.view())?;
    for (bad in [
        "arn:aws:s3:::analytics",
        "arn:aws:s3tables:us-east-1:0:bucket/Bad",
        "arn:aws:s3tables:us-east-1:0:bucket/ab/x",
    ]) {
        var none = Vector<u8>.create();
        Check.isTrue(tableBucketOfArn(bad.bytes(), mut none)!.isNull(), bad)?;
    }
    // The warehouse: the name and `--table-s3`, which the store takes past 63 characters for these alone.
    let w = tableWarehouseBucket("a234567890123456789012345678901234567890123456789012345678901ab".bytes())!;
    Check.equalU64(73, w.length as u64)?;
    Check.isTrue(isTableWarehouseShaped(w.view()) && isTableBucketStoreName(w.view()), "--table-s3")?;
    Check.isFalse(isTableBucketStoreName("-a--table-s3".bytes()), "not a valid name before it")?;
    var id1 = Vector<u8>.create();
    var id2 = Vector<u8>.create();
    tableBucketId("a".bytes(), 1, mut id1)!;
    tableBucketId("a".bytes(), 1, mut id2)!;
    Check.isTrue(id1.view() == id2.view() && id1.length == 36, "a table bucket's id, the same each time")?;
    Check.isTrue(
        metadataLocationOk("s3://w--table-s3/id/metadata/00001-a.metadata.json".bytes(), "s3://w--table-s3/id".bytes()),
        "in it",
    )?;
    Check.isFalse(
        metadataLocationOk("s3://w--table-s3/id2/m.metadata.json".bytes(), "s3://w--table-s3/id".bytes()),
        "a sibling",
    )?;
    Check.isFalse(
        metadataLocationOk("s3://w--table-s3/id/data/x.parquet".bytes(), "s3://w--table-s3/id".bytes()),
        "not metadata",
    )?;
    let segs = pathSegments("/tables/arn%3Aaws%3As3tables%3Aus-east-1%3A0%3Abucket%2Fa1b/sales/orders/rename".bytes())!;
    Check.equalU64(5, segs.length as u64)?;
    Check.equalBytes("arn:aws:s3tables:us-east-1:0:bucket/a1b".bytes(), segs[1].view())?;
    var again = Vector<u8>.create();
    encodePathAgain("/buckets/arn%3Aa%2Fb".bytes(), mut again)!;
    Check.equalBytes("/buckets/arn%253Aa%252Fb".bytes(), again.view())?;
    return Ok();
}

fn warehouseCall(method: Method, key: StringView, param: StringView, value: StringView) -> S3Code? {
    var req = bareRequest();
    req.method = method;
    let _ = req.bucket.append("002b2b5256073c200d64b94c800f0b93--table-s3");
    let _ = req.key.append(key);
    if (param.length > 0) { req.query.push(policyParam(param, value))!; }
    if (param == "prefix") { req.query.push(policyParam("list-type", "2"))!; }
    return match (tableWarehouseRefusal(borrow req)) {
        Ok() => null,
        Err(S3Fail.Code(c)) => Some(c),
        Err(_) => Some(S3Code.InternalError),
    };
}

@test
fn tableWarehouseCalls() -> Result<void, TestFailure> {
    Check.isTrue(warehouseCall(Method.Put, "id/data/a.parquet", "", "").isNull(), "an engine's PUT")?;
    Check.isTrue(warehouseCall(Method.Get, "id/metadata/x.metadata.json", "", "").isNull(), "a GET")?;
    Check.isTrue(warehouseCall(Method.Get, "", "prefix", "id/").isNull(), "a listing of a table's")?;
    Check.isTrue(warehouseCall(Method.Head, "", "", "").isNull(), "HeadBucket")?;
    Check.isTrue(isCode(warehouseCall(Method.Get, ".s3tables/bucket", "", ""), S3Code.AccessDenied), "the catalog")?;
    Check.isTrue(isCode(warehouseCall(Method.Get, "", "prefix", ""), S3Code.AccessDenied), "a listing of everything")?;
    Check.isTrue(isCode(warehouseCall(Method.Get, "", "prefix", ".s3"), S3Code.AccessDenied), "toward the catalog")?;
    Check.isTrue(isCode(warehouseCall(Method.Delete, "", "", ""), S3Code.NotImplemented), "DeleteBucket")?;
    Check.isTrue(isCode(warehouseCall(Method.Put, "", "versioning", ""), S3Code.NotImplemented), "versioning")?;
    return Ok();
}
