// Policies for S3 Tables (ADR-0084): a table bucket's and a table's resource policies, the decision for an S3 Tables
// or Iceberg call and for an engine's S3 calls on a table's files, and the check at startup for `--table-s3` buckets
// that S3 made before M9.
import web_core;
import web_http;
import web_server;

/// A table bucket's policy, and each table's (by its id), as catalog objects (ADR-0084 §1).
const TABLE_BUCKET_POLICY_KEY: StringView = ".s3tables/policy";
const TABLE_POLICIES: StringView = ".s3tables/table-policies/";
/// A resource policy's length at most, as AWS's model has it.
const TABLES_MAX_POLICY: usize = 20480;
/// The length of a table's id (a UUID's form): an object of a table's begins with it and `/`.
const TABLE_ID_LENGTH: usize = 36;

/// Who a request is, for the policies: its key (empty for none) and its facts for conditions.
struct TablesCaller {
    principal: Vector<u8>;
    facts: PolicyFacts;
    /// The user it is (ADR-0088), `<name> <id>`, and a copy of that user's identity policy; empty and none for an
    /// account's key.
    user: Vector<u8>;
    userPolicy: BucketPolicy?;
    /// A role's session (ADR-0075): copies of its role's policy and its session's, each of which must allow.
    role: bool;
    rolePolicy: BucketPolicy?;
    sessionPolicy: BucketPolicy?;
    /// Its key was revoked since its request was authenticated: refused (the M11 second reading's #6).
    revoked: bool;
    /// What its call was first authorized for (ADR-0130 §2), for the table bucket's log: the action's place in
    /// TABLES_ACTIONS plus one (0: none), and the table's id as 16 bytes (`tableSet` 1 once it is).
    action: AtomicU64;
    tableHi: AtomicU64;
    tableLo: AtomicU64;
    tableSet: AtomicU64;
}

/// The actions a call is authorized for, as its log record names them (`S3Tables.<Action>`).
const TABLES_ACTIONS: [StringView; 46] = [
    "s3tables:CreateNamespace", "s3tables:CreateTable", "s3tables:CreateTableBucket", "s3tables:DeleteNamespace",
    "s3tables:DeleteTable", "s3tables:DeleteTableBucket", "s3tables:DeleteTableBucketEncryption",
    "s3tables:DeleteTableBucketPolicy", "s3tables:DeleteTablePolicy", "s3tables:GetNamespace", "s3tables:GetTable",
    "s3tables:GetTableBucket", "s3tables:GetTableBucketEncryption", "s3tables:GetTableBucketLogging",
    "s3tables:GetTableBucketMaintenanceConfiguration", "s3tables:GetTableBucketPolicy",
    "s3tables:GetTableBucketStorageClass", "s3tables:GetTableData", "s3tables:GetTableEncryption",
    "s3tables:GetTableMaintenanceConfiguration", "s3tables:GetTableMaintenanceJobStatus",
    "s3tables:GetTableMetadataLocation", "s3tables:GetTablePolicy", "s3tables:GetTableStorageClass",
    "s3tables:ListNamespaces", "s3tables:ListTableBuckets", "s3tables:ListTables", "s3tables:ListTagsForResource",
    "s3tables:PutTableBucketEncryption", "s3tables:PutTableBucketLogging",
    "s3tables:PutTableBucketMaintenanceConfiguration", "s3tables:PutTableBucketPolicy",
    "s3tables:PutTableBucketStorageClass", "s3tables:PutTableData", "s3tables:PutTableMaintenanceConfiguration",
    "s3tables:PutTablePolicy", "s3tables:RenameTable", "s3tables:TagResource", "s3tables:UntagResource",
    "s3tables:UpdateTableMetadataLocation", "s3tables:PutTableBucketMetricsConfiguration",
    "s3tables:GetTableBucketMetricsConfiguration", "s3tables:DeleteTableBucketMetricsConfiguration",
    "s3tables:PutTableRecordExpirationConfiguration", "s3tables:GetTableRecordExpirationConfiguration",
    "s3tables:GetTableRecordExpirationJobStatus",
];

/// A call's first authorization noted on its caller (ADR-0130 §2): its action, and the table it names.
fn noteTablesCall(caller: borrow TablesCaller, action: StringView, tableId: Slice<u8>) {
    if (caller.action.load() == 0) {
        for (i in 0..TABLES_ACTIONS.length) {
            if (TABLES_ACTIONS[i].bytes() == action.bytes()) {
                caller.action.store((i + 1) as u64);
                break;
            }
        }
    }
    if (caller.tableSet.load() == 0 && uuidShaped(tableId)) {
        var hex = Vector<u8>.create();
        for (b in tableId) {
            if (b != '-' && hex.push(b).isErr()) { return; }
        }
        let hi = parseHexU64(hex.view()[0..16]) ?? { return; };
        let lo = parseHexU64(hex.view()[16..32]) ?? { return; };
        caller.tableHi.store(hi);
        caller.tableLo.store(lo);
        caller.tableSet.store(1);
    }
}

/// A hex number of up to 16 digits; null for anything else.
fn parseHexU64(text: Slice<u8>) -> u64? {
    if (text.length == 0 || text.length > 16) { return null; }
    var n: u64 = 0;
    for (c in text) {
        let d: u64 = if (c >= '0' && c <= '9') (c - '0') as u64 else if (c >= 'a' && c <= 'f') (c - 'a' + 10) as u64
            else { return null; };
        n = (n << 4) | d;
    }
    return Some(n);
}

/// The call's table, as its log record names it: `<table bucket ARN>/table/<id>`; empty when it named none.
fn notedTableArn(caller: borrow TablesCaller, bucket: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var out = Vector<u8>.create();
    if (caller.tableSet.load() == 0) { return Ok(out); }
    appendTableBucketArn(mut out, bucket)?;
    out.extend("/table/".bytes())?;
    var hex = Vector<u8>.create();
    for (word in [caller.tableHi.load(), caller.tableLo.load()]) {
        for (i in 0u64..16) {
            let d = truncate<u8>((word >> ((15 - i) * 4)) & 15);
            hex.push(if (d < 10) '0' + d else 'a' + d - 10)?;
        }
    }
    let h = hex.view();
    for (part in [h[0..8], h[8..12], h[12..16], h[16..20], h[20..32]]) {
        if (out[out.length - 1] != '/') { out.push('-')?; }
        out.extend(part)?;
    }
    return Ok(out);
}

fn clonedPolicy(p: borrow BucketPolicy?) -> Result<BucketPolicy?, AllocError> => match (p) {
    Some(x) => Ok(Some(clonePolicy(x)?)),
    null => Ok(null),
};

/// A copy of the role at `r`'s policy; none for a place no role has (ADR-0096's sets keep removed roles' places).
fn rolePolicyCopy(roles: Slice<StsRole>, r: usize) -> Result<BucketPolicy?, AllocError> {
    if (r >= roles.length) { return Ok(null); }
    return Ok(Some(clonePolicy(borrow roles[r].policy)?));
}

/// A requester as S3 Tables decides it: its key, and its user's or role's identity policies (ADR-0088 §2).
fn tablesCallerOf(
    app: borrow S3App,
    req: borrow S3Request,
    who: borrow Requester,
    body: Slice<u8>,
) -> Result<TablesCaller, AllocError> {
    let credentials = app.credentials.get().view();
    let user = if (who.role.isNull()) userOfRequester(credentials, who) else null;
    var facts = policyFacts(req, false, app.secure, who.peer)?;
    requestTagsInto(mut facts, req, body)?;
    return Ok(TablesCaller {
        principal: principalOf(app, who)?,
        facts: facts,
        user: match (user) {
            Some(u) => copyBytes(u.userKey.view())?,
            null => Vector<u8>.create(),
        },
        userPolicy: match (user) {
            Some(u) => clonedPolicy(u.policy.asBorrow())?,
            null => null,
        },
        role: who.role.isSome(),
        rolePolicy: match (who.role) {
            Some(r) => rolePolicyCopy(app.roles.get().view(), r)?,
            null => null,
        },
        sessionPolicy: clonedPolicy(who.sessionPolicy.asBorrow())?,
        revoked: revokedRequester(credentials, who),
        action: AtomicU64.create(0),
        tableHi: AtomicU64.create(0),
        tableLo: AtomicU64.create(0),
        tableSet: AtomicU64.create(0),
    });
}

/// The tags an S3 Tables call sets or names, for `aws:RequestTag/<key>` and `aws:TagKeys` (ADR-0126 §1): a body's
/// `tags` (TagResource, CreateTableBucket, CreateTable), or UntagResource's `tagKeys`. The Iceberg catalog's calls set
/// none.
fn requestTagsInto(facts: borrow mut PolicyFacts, req: borrow S3Request, body: Slice<u8>) -> Result<void, AllocError> {
    if (icebergPath(req)) { return Ok(); }
    if (startsWithBytes(req.rawPath.view(), "/tag/".bytes()) && isMethod(req.method, Method.Delete)) {
        facts.requestTagged = true;
        for (k in paramValues(req, "tagKeys")?.view()) { facts.requestTagKeys.push(copyBytes(k.view())?)?; }
        return Ok();
    }
    if (body.length == 0) { return Ok(); }
    let j = parseJson(body)? ?? { return Ok(); };
    match (jsonMember(borrow j, "tags")) {
        Some(Json.Object(ms)) => {
            facts.requestTagged = true;
            for (m in ms.view()) {
                match (borrow m.value) {
                    Json.Text(v) => {
                        facts.requestTagKeys.push(copyBytes(m.key.view())?)?;
                        facts.requestTagValues.push(copyBytes(v.view())?)?;
                    }
                    _ => {}
                }
            }
        }
        _ => {}
    }
    return Ok();
}

/// What the caller's identity policies say of `action` on `resource` (`s3tables:<bucket>[/table/<id>]`): a role's
/// session Allow only when its role's and its session's policies both allow, else Deny; a user's its policy's say;
/// Neither for an account's key.
fn identityVerdict(
    caller: borrow TablesCaller,
    facts: borrow PolicyFacts,
    action: StringView,
    resource: Slice<u8>,
) -> PolicyDecision {
    if (caller.role) {
        match (borrow caller.rolePolicy) {
            Some(p) => {
                match (decidePolicy(p, null, action, resource, facts)) {
                    PolicyDecision.Allow => {}
                    _ => { return PolicyDecision.Deny; }
                }
            }
            null => { return PolicyDecision.Deny; }
        }
        match (borrow caller.sessionPolicy) {
            Some(p) => {
                match (decidePolicy(p, null, action, resource, facts)) {
                    PolicyDecision.Allow => {}
                    _ => { return PolicyDecision.Deny; }
                }
            }
            null => {}
        }
        return PolicyDecision.Allow;
    }
    return match (borrow caller.userPolicy) {
        Some(p) => decidePolicy(p, null, action, resource, facts),
        null => if (caller.user.length > 0) PolicyDecision.Deny else PolicyDecision.Neither,
    };
}

/// The access key of a requester, empty for none.
fn principalOf(app: borrow S3App, who: borrow Requester) -> Result<Vector<u8>, AllocError> {
    let credentials = app.credentials.get().view();
    return match (who.key) {
        Some(i) => if (i < credentials.length) copyBytes(credentials[i].accessKey.view()) else Ok(Vector<u8>.create()),
        null => Ok(Vector<u8>.create()),
    };
}

/// The policy calls, which a key is never refused, so it cannot lock itself out (ADR-0084 §2, as ADR-0043 §4).
fn isTablesPolicyAction(action: StringView) -> bool =>
    action == "s3tables:GetTableBucketPolicy" || action == "s3tables:PutTableBucketPolicy" ||
        action == "s3tables:DeleteTableBucketPolicy" || action == "s3tables:GetTablePolicy" ||
        action == "s3tables:PutTablePolicy" || action == "s3tables:DeleteTablePolicy";

/// A table's policy's key: `.s3tables/table-policies/<id>`.
fn tablePolicyKey(id: Slice<u8>) -> Result<Vector<u8>, AllocError> => catalogKey(TABLE_POLICIES, id, "".bytes());

/// An object of the catalog as it is stored, null if there is none.
fn readCatalogBytes(store: borrow ObjectStore, hidden: Slice<u8>, key: Slice<u8>) -> Result<Vector<u8>?, TablesError> {
    match (store.headObject(catalogText(hidden), catalogText(key))) {
        Ok(_) => {}
        Err(StoreError.NoSuchKey) => { return Ok(null); }
        Err(StoreError.NoSuchBucket) => { return Ok(null); }
        Err(e) => { return Err(tablesStoreFail(e)); }
    }
    return match (store.getObject(catalogText(hidden), catalogText(key))) {
        Ok(b) => Ok(Some(b)),
        Err(StoreError.NoSuchKey) => Ok(null),
        Err(e) => Err(tablesStoreFail(e)),
    };
}

/// Whether the policy kept at `key` (none: it does) lets the caller do `action` on `resource`: false for a Deny, or
/// for a stored policy that no longer parses (ADR-0043 §9).
fn policyVerdict(
    store: borrow ObjectStore,
    hidden: Slice<u8>,
    key: Slice<u8>,
    bucketName: Slice<u8>,
    caller: borrow TablesCaller,
    facts: borrow PolicyFacts,
    action: StringView,
    resource: Slice<u8>,
) -> Result<PolicyDecision, TablesError> {
    let document = match (readCatalogBytes(store, hidden, key)?) {
        Some(d) => d,
        null => { return Ok(PolicyDecision.Neither); }
    };
    let none = Vector<Credential>.create();
    let policy = match (parseTablesPolicy(document.view(), bucketName, none.view(), false)) {
        Ok(p) => p,
        Err(S3Fail.OutOfMemory(e)) => { return Err(TablesError.OutOfMemory(e)); }
        Err(_) => { return Ok(PolicyDecision.Deny); } // a stored policy that no longer parses refuses (ADR-0043 §9)
    };
    let who: Slice<u8>? = if (caller.principal.length > 0) Some(caller.principal.view()) else null;
    let user: Slice<u8>? = if (caller.user.length > 0) Some(caller.user.view()) else null;
    return Ok(decidePolicyFor(borrow policy, who, user, action, resource, facts));
}

/// ForbiddenException unless the caller may do `action` on table bucket `bucketName`, or on its table `tableId` when
/// one is given (ADR-0084 §2): the table bucket's policy, and the table's, refuse with a Deny; otherwise a key may.
fn checkTables(
    store: borrow ObjectStore,
    caller: borrow TablesCaller,
    action: StringView,
    bucketName: Slice<u8>,
    tableId: Slice<u8>,
) -> Result<void, TablesError> {
    noteTablesCall(caller, action, tableId);
    if (caller.revoked) { return Err(TablesError.Forbidden); }
    let account = !caller.role && caller.user.length == 0;
    // The policy calls are never refused to the account's keys (ADR-0084 §2); a user or a role needs an Allow.
    if (account && isTablesPolicyAction(action)) { return Ok(); }
    var resource = copyBytes(bucketName)?;
    if (tableId.length > 0) {
        resource.extend("/table/".bytes())?;
        resource.extend(tableId)?;
    }
    // The resource's tags, for `aws:ResourceTag` (ADR-0126 §1): a table's own, or its bucket's.
    let hidden = tableWarehouseBucket(bucketName)?;
    let configKey = if (tableId.length > 0) tableConfigKey(tableId)? else copyBytes(TABLE_BUCKET_CONFIG_KEY.bytes())?;
    let config = readTablesConfig(store, hidden.view(), configKey.view())?;
    let facts = factsWithTags(borrow caller.facts, jsonMember(borrow config, "tags"))?;
    // The identity policies first (ADR-0088 §2), on `s3tables:<bucket>[/table/<id>]`.
    var named = copyBytes("s3tables:".bytes())?;
    named.extend(resource.view())?;
    let identity = identityVerdict(caller, borrow facts, action, named.view());
    match (identity) {
        PolicyDecision.Deny => { return Err(TablesError.Forbidden); }
        _ => {}
    }
    var resourceAllows = false;
    match (policyVerdict(
        store,
        hidden.view(),
        TABLE_BUCKET_POLICY_KEY.bytes(),
        bucketName,
        caller,
        borrow facts,
        action,
        resource.view(),
    )?) {
        PolicyDecision.Deny => { return Err(TablesError.Forbidden); }
        PolicyDecision.Allow => { resourceAllows = true; }
        PolicyDecision.Neither => {}
    }
    if (tableId.length > 0) {
        let key = tablePolicyKey(tableId)?;
        match (policyVerdict(
            store,
            hidden.view(),
            key.view(),
            bucketName,
            caller,
            borrow facts,
            action,
            resource.view(),
        )?) {
            PolicyDecision.Deny => { return Err(TablesError.Forbidden); }
            PolicyDecision.Allow => { resourceAllows = true; }
            PolicyDecision.Neither => {}
        }
    }
    // An account's key may do what nothing denies; a role's session what its policies allow; a user what its policy
    // or a resource policy allows.
    if (account || caller.role) { return Ok(); }
    let identityAllows = match (identity) {
        PolicyDecision.Allow => true,
        _ => false,
    };
    return if (identityAllows || resourceAllows) Ok() else Err(TablesError.Forbidden);
}

/// For a call that names no table bucket a policy could be kept on (CreateTableBucket, ListTableBuckets): a user or a
/// role's session needs its identity policies' Allow; an account's key may (ADR-0088 §2).
fn checkTablesIdentity(
    caller: borrow TablesCaller,
    action: StringView,
    resource: Slice<u8>,
) -> Result<void, TablesError> {
    noteTablesCall(caller, action, "".bytes());
    if (!caller.role && caller.user.length == 0) { return Ok(); }
    return match (identityVerdict(caller, borrow caller.facts, action, resource)) {
        PolicyDecision.Allow => Ok(),
        _ => Err(TablesError.Forbidden),
    };
}

/// A table's id by its namespace and name; NotFound if it is not there.
fn tableIdOf(
    store: borrow ObjectStore,
    bucketName: Slice<u8>,
    ns: Slice<u8>,
    name: Slice<u8>,
) -> Result<Vector<u8>, TablesError> {
    let rec = tableRecord(store, bucketName, ns, name)?;
    return Ok(copyBytes(jsonMemberText(borrow rec.json, "id") ?? "".bytes())?);
}

// ---- The policy calls ----

/// PutTableBucketPolicy and PutTablePolicy's body: `{"resourcePolicy": "<policy JSON>"}`, the policy checked as it
/// will be read (its keys configured ones), at most TABLES_MAX_POLICY.
fn putPolicyDocument(
    body: Slice<u8>,
    bucketName: Slice<u8>,
    credentials: Slice<Credential>,
) -> Result<Vector<u8>, TablesError> {
    let j = tablesObject(body)?;
    let document = copyBytes(jsonMemberText(borrow j, "resourcePolicy") ?? "".bytes())?;
    if (document.length == 0 || document.length > TABLES_MAX_POLICY) { return Err(TablesError.BadRequest); }
    return match (parseTablesPolicy(document.view(), bucketName, credentials, true)) {
        Ok(p) => Ok(withUserIds(document.view(), borrow p, credentials)?),
        Err(S3Fail.OutOfMemory(e)) => Err(TablesError.OutOfMemory(e)),
        Err(S3Fail.Code(S3Code.NotImplemented)) => Err(TablesError.NotImplemented),
        Err(_) => Err(TablesError.BadRequest),
    };
}

/// A table bucket's or table's policy call (ADR-0084 §1): its policy kept at `key`, or read, or deleted.
fn tablesPolicyCall(
    store: borrow mut ObjectStore,
    m: Method,
    bucketName: Slice<u8>,
    key: Slice<u8>,
    body: Slice<u8>,
    credentials: Slice<Credential>,
) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(bucketName)?;
    if (isMethod(m, Method.Put)) {
        let document = putPolicyDocument(body, bucketName, credentials)?;
        return match (store.putObject(
            catalogText(hidden.view()),
            catalogText(key),
            "application/json",
            document.view(),
            PutCondition.None,
        )) {
            Ok(_) => Ok(tablesAnswer(200, Vector<u8>.create())),
            Err(e) => Err(tablesStoreFail(e)),
        };
    }
    if (isMethod(m, Method.Get)) {
        let document = match (readCatalogBytes(store, hidden.view(), key)?) {
            Some(d) => d,
            null => { return Err(TablesError.NotFound); }
        };
        var answer = jsonObject();
        jsonSet(mut answer, "resourcePolicy", Json.Text(copyBytes(storedPolicyText(document.view()))?))?;
        return tablesJson(borrow answer);
    }
    if (isMethod(m, Method.Delete)) {
        return match (store.deleteObject(catalogText(hidden.view()), catalogText(key))) {
            Ok() => Ok(tablesNoContent()),
            Err(StoreError.NoSuchKey) => Ok(tablesNoContent()),
            Err(e) => Err(tablesStoreFail(e)),
        };
    }
    return Err(TablesError.BadRequest);
}

// ---- Table data through S3 (ADR-0084 §4) ----

/// The table id a warehouse key or listing prefix begins with (`<id>/…`, or the id alone for a prefix); null if it
/// begins with none.
fn tableIdOfKey(key: Slice<u8>, prefix: bool) -> Slice<u8>? {
    if (key.length < TABLE_ID_LENGTH || !uuidShaped(key[0..TABLE_ID_LENGTH])) { return null; }
    if (key.length == TABLE_ID_LENGTH) { return if (prefix) Some(key) else null; }
    if (key[TABLE_ID_LENGTH] != '/') { return null; }
    return Some(key[0..TABLE_ID_LENGTH]);
}

/// Whether `who` may do `action` (`s3tables:GetTableData` or `PutTableData`) on table `id` of the hidden bucket
/// `hidden`, by its table bucket's and table's policies.
async fn tableDataAllowed(
    app: borrow S3App,
    req: borrow S3Request,
    who: borrow Requester,
    action: StringView,
    hidden: Slice<u8>,
    id: Slice<u8>,
) -> Result<bool, S3Fail> {
    if (!isTableWarehouseShaped(hidden)) { return Ok(true); }
    let name = hidden[0..hidden.length - TABLE_BUCKET_SUFFIX.bytes().length];
    let caller = tablesCallerOf(app, req, who, "".bytes())?;
    let callerRef = borrow caller;
    var guard = await lockStore(app)?;
    let store = guard.data();
    return match (await Async.blocking(() => checkTables(store, callerRef, action, name, id))) {
        Ok() => Ok(true),
        Err(TablesError.Forbidden) => Ok(false),
        Err(TablesError.OutOfMemory(e)) => Err(S3Fail.OutOfMemory(e)),
        Err(_) => Err(S3Fail.Code(S3Code.InternalError)),
    };
}

/// An S3 call into a table bucket's warehouse (after `tableWarehouseRefusal`): authorized as the table's data, a read
/// as `s3tables:GetTableData` and anything else as `s3tables:PutTableData` (ADR-0084 §4). HeadBucket names no table:
/// `s3tables:GetTableBucket`. DeleteObjects' keys are checked one by one.
async fn authorizeTableData(app: borrow S3App, req: borrow S3Request, who: borrow Requester) -> Result<void, S3Fail> {
    let listing = req.key.length == 0;
    let target = if (listing) paramOf(req, "prefix") ?? "".bytes() else req.key.bytes();
    let id = match (tableIdOfKey(target, listing)) {
        Some(i) => i,
        null => {
            // HeadBucket: the table bucket's own, `s3tables:GetTableBucket`, not a probe anyone may make (the M11
            // exit review's B5). DeleteObjects: its keys, one by one.
            if (listing && isMethod(req.method, Method.Head) &&
                !await tableDataAllowed(app, req, who, "s3tables:GetTableBucket", req.bucket.bytes(), "".bytes())?) {
                return Err(S3Fail.Code(S3Code.AccessDenied));
            }
            return Ok();
        }
    };
    let read = isMethod(req.method, Method.Get) || isMethod(req.method, Method.Head);
    let action = if (read) "s3tables:GetTableData" else "s3tables:PutTableData";
    if (!await tableDataAllowed(app, req, who, action, req.bucket.bytes(), id)?) {
        return Err(S3Fail.Code(S3Code.AccessDenied));
    }
    return Ok();
}

// ---- Table buckets made before M9 (ADR-0084 §5) ----

/// A `--table-s3` bucket holding a key no table bucket can (neither `.s3tables/…` nor `<table id>/…`): one S3 made
/// before M9. Null if there is none. Each table's keys are skipped with one seek, so this reads a bucket's tables.
fn legacyTableBucket(store: borrow ObjectStore) -> Result<Vector<u8>?, StoreError> {
    let all = store.listBucketInfo()?;
    for (i in 0..all.length) {
        let name = all[i].name.view();
        if (!isTableWarehouseShaped(name)) { continue; }
        let bucket = StringView.fromUtf8(name) ?? "";
        var after = Vector<u8>.create();
        var skipping = false;
        while (true) {
            let page = store.listObjects(bucket, "", "", after.view(), skipping, 1)?;
            if (page.keys.length == 0) { break; }
            let key = page.keys[0].view();
            let catalog = CATALOG_PREFIX.bytes();
            after.clear();
            if (startsWithBytes(key, catalog)) {
                after.extend(catalog)?;
            } else {
                match (tableIdOfKey(key, false)) {
                    Some(id) => {
                        after.extend(id)?;
                        after.push('/')?;
                    }
                    null => { return Ok(Some(copyBytes(name)?)); }
                }
            }
            skipping = true;
        }
    }
    return Ok(null);
}

/// The message for a `--table-s3` bucket made before M9: why the server does not start, and what to do.
fn legacyTableBucketMessage(name: Slice<u8>) -> Result<String, AllocError> {
    var m = String.create();
    m.append("bucket ")?;
    m.append(StringView.fromUtf8(name) ?? "?")?;
    m.append(
        " was made by S3 before table buckets (M9), and a --table-s3 name is now a table bucket's (ADR-0084 §5): with the release before M9, copy its objects to another bucket and delete it",
    )?;
    return Ok(m);
}
