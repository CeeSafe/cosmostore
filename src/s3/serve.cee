// `cosmostore serve <dir> <[address:]port> <credentials-file> [domain]` (ADR-0008 §1, ADR-0011, ADR-0016): the
// store behind S3, on 127.0.0.1 unless an address is given; with a domain, `<bucket>.<domain>` hosts address buckets
// too.
import web_core;
import web_transport;
import web_http;
import web_server;
import web_tls;

/// Reads a small file (at most 1 MiB) whole, through `DurableFile` (all file I/O goes through it); `what` names it
/// in the error.
fn readSmallFile(path: StringView, what: StringView) -> Result<Vector<u8>, String> {
    var text = Vector<u8>.create();
    let failure = match (readSmallFileInto(path, mut text)) {
        Ok() => { return Ok(text); }
        Err(reason) => match (reason) {
            ReadFault.Open => "cannot open it",
            ReadFault.Size => "cannot read its size",
            ReadFault.TooLarge => "it is larger than 1 MiB",
            ReadFault.Memory => "out of memory",
            ReadFault.Read => "a read failed",
        },
    };
    var message = String.create();
    let _ = message.append("cannot read the ");
    let _ = message.append(what);
    let _ = message.append(": ");
    let _ = message.append(failure);
    let _ = message.append(" (");
    let _ = message.append(path);
    let _ = message.append(")");
    return Err(message);
}

enum ReadFault {
    Open,
    Size,
    TooLarge,
    Memory,
    Read,
}

fn readSmallFileInto(path: StringView, out: borrow mut Vector<u8>) -> Result<void, ReadFault> {
    let file = match (DurableFile.openRead(path)) {
        Ok(f) => f,
        Err(_) => { return Err(ReadFault.Open); }
    };
    let size = match (file.size()) {
        Ok(n) => n,
        Err(_) => { return Err(ReadFault.Size); }
    };
    if (size > 1048576) { return Err(ReadFault.TooLarge); }
    match (out.resize(size as usize, 0)) {
        Ok() => {}
        Err(_) => { return Err(ReadFault.Memory); }
    }
    match (file.readExactAt(out.viewMut(), 0)) {
        Ok() => {}
        Err(_) => { return Err(ReadFault.Read); }
    }
    return Ok();
}

/// Reads the credentials file.
/// The credentials file and when it was last seen modified, with the sets its reloads go into (ADR-0050).
struct Rotation {
    sets: Arc<CredentialSets>;
    path: String;
    modified: i64;
    /// The users file (`--users-file`, ADR-0088 §1), empty for none, and when it was last seen modified: a change to
    /// either file reloads both.
    usersPath: String;
    usersModified: i64;
    /// The modification time of a file that did not read: it is tried again each round, and reported once.
    failed: i64;
    /// The roles file, reloaded beside them (ADR-0096 §1), and the API's roles (ADR-0104 §4).
    roles: RoleRotation?;
    /// The IAM records' generation last merged into the credentials (ADR-0104 §4).
    iamGeneration: u64;
    /// The STS, SSE-S3 and KMS key files given, reloaded beside them (ADR-0096 §3, §4).
    keyFiles: Vector<KeyRotation>;
    /// Where the re-wrap pass goes on from (ADR-0100 §3): the last key it looked at, or null for the first.
    rewrapAfter: IndexKey?;
    /// The notification and replication target files given (ADR-0096 §5).
    notifyFile: TargetRotation<NotifyTarget>?;
    replicationFile: TargetRotation<ReplicationTarget>?;
}

/// A target file and its list (ADR-0096 §5): a target removed fails its pending deliveries as an unknown one's do,
/// one changed is used from the next delivery.
struct TargetRotation<T: Send + Share> {
    list: Arc<Reloaded<T>>;
    path: String;
    modified: i64;
    failed: i64;
}

/// What a target file's change did.
enum TargetChange {
    Unchanged,
    Failed(String),
    Reloaded(u64),
}

/// The notification targets file read again if it changed, on a worker thread.
fn notifyFileChange(r: borrow mut TargetRotation<NotifyTarget>) -> TargetChange {
    let modified = Fs.modifiedMillis(r.path.view()).ok() ?? r.modified;
    if (modified == r.modified || modified == r.failed) { return TargetChange.Unchanged; }
    let text = match (readSmallFile(r.path.view(), "notification targets file")) {
        Ok(t) => t,
        Err(message) => {
            r.failed = modified;
            return TargetChange.Failed(message);
        }
    };
    let fresh = match (parseTargets(text.view())) {
        Ok(Some(t)) => t,
        _ => {
            r.failed = modified;
            return TargetChange.Failed(textOf("it needs lines of `<id> <http or https url>`, each id once"));
        }
    };
    let n = fresh.length as u64;
    if (!r.list.get().replace(fresh)) {
        r.failed = modified;
        return TargetChange.Failed(textOf("it was reloaded too many times; restart to reload"));
    }
    r.modified = modified;
    return TargetChange.Reloaded(n);
}

/// The replication targets file read again if it changed, on a worker thread; its text, which holds secrets, is wiped
/// once parsed.
fn replicationFileChange(r: borrow mut TargetRotation<ReplicationTarget>) -> TargetChange {
    let modified = Fs.modifiedMillis(r.path.view()).ok() ?? r.modified;
    if (modified == r.modified || modified == r.failed) { return TargetChange.Unchanged; }
    var text = match (readSmallFile(r.path.view(), "replication targets file")) {
        Ok(t) => t,
        Err(message) => {
            r.failed = modified;
            return TargetChange.Failed(message);
        }
    };
    let parsed = parseReplicationTargets(text.view());
    Secret.wipe(mut text[..]);
    let fresh = match (parsed) {
        Ok(Some(t)) => t,
        _ => {
            r.failed = modified;
            return TargetChange.Failed(
                textOf("it needs lines of `<id> <http or https url> <access key> <secret key> [region]`, each id once"),
            );
        }
    };
    let n = fresh.length as u64;
    if (!r.list.get().replace(fresh)) {
        r.failed = modified;
        return TargetChange.Failed(textOf("it was reloaded too many times; restart to reload"));
    }
    r.modified = modified;
    return TargetChange.Reloaded(n);
}

/// Says what a target file's reload did.
async fn reportTargets(what: StringView, change: TargetChange) {
    match (change) {
        TargetChange.Unchanged => {}
        TargetChange.Reloaded(n) => {
            var line = String.create();
            let _ = line.append("cosmostore: ");
            let _ = line.append(what);
            let _ = line.append(" reloaded: ");
            let _ = line.appendNumber(n);
            let _ = line.append(" targets\n");
            let _ = await AsyncConsole.writeError(line.view());
        }
        TargetChange.Failed(message) => {
            let _ = await AsyncConsole.writeError("cosmostore: ");
            let _ = await AsyncConsole.writeError(what);
            let _ = await AsyncConsole.writeError(" reload failed, keeping the targets in use: ");
            let _ = await AsyncConsole.writeError(message.view());
            let _ = await AsyncConsole.writeError("\n");
        }
    }
}

/// The target files reloaded (ADR-0096 §5), on `serve` and a node alike.
async fn reloadTargetsIfChanged(r: borrow mut Rotation) {
    match (borrow mut r.notifyFile) {
        Some(f) => {
            await reportTargets("notification targets file", await Async.blocking(() => notifyFileChange(f)));
        }
        null => {}
    }
    match (borrow mut r.replicationFile) {
        Some(f) => {
            await reportTargets("replication targets file", await Async.blocking(() => replicationFileChange(f)));
        }
        null => {}
    }
}

/// A key file and its set (ADR-0096 §3, §4). `mode` is the envelopes' (`s3`, `kms`) a key of it seals, or empty for
/// STS's, whose keys seal tokens: a key of those may be removed, which revokes them.
struct KeyRotation {
    sets: Arc<KeySets>;
    path: String;
    /// KEY_FILE_STS, KEY_FILE_SSE or KEY_FILE_KMS.
    kind: u8;
    modified: i64;
    failed: i64;
    /// The file's modification time whose removal waits on counts not yet known (a cluster's, ADR-0100 §4): tried
    /// again each cycle, said once.
    waiting: i64;
    /// When a waiting removal asks the cluster again, and the wait after that (ADR-0106 §2, the M18 exit review's
    /// B5): 2 s, doubling to a minute, from the start again when the file changes.
    askAtMs: i64;
    askEveryMs: i64;
}

const KEY_FILE_STS: u8 = 0;
const KEY_FILE_SSE: u8 = 1;
const KEY_FILE_KMS: u8 = 2;

/// The file's name in what the server says of it.
fn keyFileWhat(kind: u8) -> StringView =>
    if (kind == KEY_FILE_STS) "STS key file" else if (kind == KEY_FILE_SSE) "SSE key file" else "KMS key file";

/// The envelopes' mode a key of the file seals (`s3`, `kms`); empty for STS's, whose keys seal tokens.
fn keyFileMode(kind: u8) -> StringView => if (kind == KEY_FILE_SSE) "s3" else if (kind == KEY_FILE_KMS) "kms" else "";

/// What a key file's change asks: nothing, a file that does not read, or new keys and the ids of those it drops.
enum KeyChange {
    Unchanged,
    Failed(String),
    Fresh(Vector<MasterKey>, Vector<Vector<u8>>, i64),
}

/// Reads a key file again if its modification time changed (on a worker thread): its keys, and the ids of the current
/// ones it no longer has.
fn keyFileChange(k: borrow mut KeyRotation) -> KeyChange {
    let modified = Fs.modifiedMillis(k.path.view()).ok() ?? k.modified;
    if (modified == k.modified || modified == k.failed) { return KeyChange.Unchanged; }
    let fresh = match (readSseKeys(k.path.view())) {
        Ok(f) => f,
        Err(message) => {
            k.failed = modified;
            return KeyChange.Failed(message);
        }
    };
    var dropped = Vector<Vector<u8>>.create();
    let current = k.sets.get().view();
    for (i in 0..current.length) {
        // A key is kept only with the same bytes: new bytes under its id would open nothing it sealed, so they count
        // as its removal (the M15 exit review).
        var kept = false;
        for (j in 0..fresh.length) {
            if (fresh[j].sameAs(borrow current[i])) { kept = true; }
        }
        if (!kept) {
            match (copyBytes(current[i].id.view())) {
                Ok(id) => {
                    if (dropped.push(id).isErr()) { return KeyChange.Failed(textOf("out of memory")); }
                }
                Err(_) => { return KeyChange.Failed(textOf("out of memory")); }
            }
        }
    }
    return KeyChange.Fresh(fresh, dropped, modified);
}

/// How much of a store still needs one of `ids` (envelopes of `mode`): its versions and uploads sealed under it, and,
/// for KMS, its buckets whose default encryption names it. Under the store's lock, on a worker thread.
fn sealedUnder(s: borrow mut ObjectStore, mode: StringView, ids: Slice<Vector<u8>>) -> Result<u64, StoreError> {
    var n: u64 = 0;
    for (i in 0..ids.length) {
        var prefix = Vector<u8>.create();
        prefix.extend("v1.".bytes())?;
        prefix.extend(mode.bytes())?;
        prefix.push('.')?;
        prefix.extend(ids[i].view())?;
        prefix.push('.')?;
        n += s.countFieldPrefix(SSE_FIELD.bytes(), prefix.view())?;
        if (mode == "kms") {
            var named = Vector<u8>.create();
            named.extend("aws:kms ".bytes())?; // as the store keeps it (`isEncryptionValue`)
            named.extend(ids[i].view())?;
            let buckets = s.listBuckets()?;
            for (b in 0..buckets.length) {
                let name = StringView.fromUtf8(buckets[b].view()) ?? "";
                if (s.bucketConfig(name, BUCKET_CONFIG_ENCRYPTION)?.view() == named.view()) { n += 1; }
            }
        }
    }
    return Ok(n);
}

/// What a removal's check found.
enum KeyInstall {
    Installed,
    /// Still needed by this many versions, uploads and bucket configurations: the keys in use stay.
    InUse(u64),
    /// The store could not be counted, or every set cell is used: the keys in use stay.
    Failed,
}

/// The new keys counted against the store and installed under one hold of its lock (the M15 exit review): a write
/// commits under the same lock and checks its key is in the current set (`sealKeyHeld`), so none sealed under a
/// removed key commits after the count.
async fn countAndInstall(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    k: borrow KeyRotation,
    fresh: borrow Vector<MasterKey>,
    dropped: Slice<Vector<u8>>,
) -> KeyInstall {
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return KeyInstall.Failed; } // not known to be unused: kept
    };
    let s = guard.data();
    let mode = keyFileMode(k.kind);
    if (mode.length > 0 && dropped.length > 0) {
        match (await Async.blocking(() => sealedUnder(s, mode, dropped))) {
            Ok(0) => {}
            Ok(n) => { return KeyInstall.InUse(n); }
            Err(_) => { return KeyInstall.Failed; }
        }
    }
    if (!(await Async.blocking(() => installKeys(k, fresh)))) { return KeyInstall.Failed; }
    return KeyInstall.Installed;
}

/// A key file's reload refused, said once.
async fn refuseKeys(
    k: borrow mut KeyRotation,
    modified: i64,
    why: StringView,
    inUse: u64,
    dropped: borrow Vector<Vector<u8>>,
) {
    k.failed = modified;
    var line = String.create();
    let _ = line.append("cosmostore: ");
    let _ = line.append(keyFileWhat(k.kind));
    let _ = line.append(" reload refused: ");
    if (inUse > 0) {
        let _ = line.appendNumber(inUse);
        let _ = line.append(
            " versions, uploads or bucket encryption configurations still need the key it removes or changes (",
        );
        let _ = line.append(StringView.fromUtf8(dropped[0].view()) ?? "?");
        let _ = line.append("); re-seal them (CopyObject onto itself) first");
    } else {
        let _ = line.append(why);
    }
    let _ = line.append("\n");
    let _ = await AsyncConsole.writeError(line.view());
}

/// A key file's reload taken, said.
async fn reportKeys(k: borrow mut KeyRotation, modified: i64, count: usize) {
    k.modified = modified;
    var line = String.create();
    let _ = line.append("cosmostore: ");
    let _ = line.append(keyFileWhat(k.kind));
    let _ = line.append(" reloaded: ");
    let _ = line.appendNumber(count as u64);
    let _ = line.append(" keys\n");
    let _ = await AsyncConsole.writeError(line.view());
}

/// The keys made the current set, on a worker thread (the set's cell is a lock); false when every cell is used.
fn installKeys(k: borrow KeyRotation, fresh: borrow Vector<MasterKey>) -> bool {
    let copied = copyKeys(fresh.view()).ok() ?? { return false; };
    return k.sets.get().replace(copied);
}

/// A round of the re-wrap pass (ADR-0100 §3): versions under an SSE-S3 key that is not its file's first re-wrapped
/// under the first, under the store's lock. Nothing without `--sse-key-file`.
async fn rewrapUnderFirst(r: borrow mut Rotation, store: borrow Arc<AsyncMutex<ObjectStore>>) {
    var sets: Arc<KeySets>? = null;
    for (i in 0..r.keyFiles.length) {
        if (r.keyFiles[i].kind == KEY_FILE_SSE) { sets = Some(r.keyFiles[i].sets.clone()); }
    }
    let keySets = match (sets) {
        Some(s) => s,
        null => { return; }
    };
    let keys = keySets.get().view();
    var round: Result<RewrapRound, StoreError> = Err(StoreError.DataCorrupt);
    {
        // The store's lock for the round only, not for what is said of it.
        var guard = match (await store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return; }
        };
        let st = guard.data();
        let after = borrow r.rewrapAfter;
        round = await Async.blocking(() => rewrapRound(st, keys, after));
    }
    match (round) {
        Ok(done) => {
            r.rewrapAfter = done.next;
            if (done.moved > 0) {
                var line = String.create();
                let _ = line.append("cosmostore: re-wrapped ");
                let _ = line.appendNumber(done.moved);
                let _ = line.append(" versions under SSE key ");
                let _ = line.append(StringView.fromUtf8(keys[0].id.view()) ?? "?");
                let _ = line.append("\n");
                let _ = await AsyncConsole.writeError(line.view());
            }
        }
        Err(_) => { r.rewrapAfter = null; }
    }
}

/// `serve`'s key files reloaded, a removed key checked against its one store.
async fn reloadKeysIfChanged(r: borrow mut Rotation, store: borrow Arc<AsyncMutex<ObjectStore>>) {
    for (i in 0..r.keyFiles.length) {
        let k = borrow mut r.keyFiles[i];
        match (await Async.blocking(() => keyFileChange(k))) {
            KeyChange.Unchanged => {}
            KeyChange.Failed(message) => {
                let _ = await AsyncConsole.writeError(
                    "cosmostore: a key file reload failed, keeping the keys in use: ",
                );
                let _ = await AsyncConsole.writeError(message.view());
                let _ = await AsyncConsole.writeError("\n");
            }
            KeyChange.Fresh(fresh, dropped, modified) => {
                match (await countAndInstall(store, k, borrow fresh, dropped.view())) {
                    KeyInstall.Installed => { await reportKeys(k, modified, fresh.length); }
                    KeyInstall.InUse(n) => { await refuseKeys(k, modified, "", n, borrow dropped); }
                    KeyInstall.Failed => {
                        await refuseKeys(
                            k,
                            modified,
                            "the store could not be counted, or the keys were reloaded too many times",
                            0,
                            borrow dropped,
                        );
                    }
                }
            }
        }
    }
}

/// The roles file and its sets (ADR-0096 §1, §2), reloaded as the credentials file is.
struct RoleRotation {
    sets: Arc<RoleSets>;
    /// The roles file; empty for none (the API's roles are still merged in, ADR-0104 §4).
    path: String;
    modified: i64;
    failed: i64;
    /// The IAM records' generation last merged in.
    iamGeneration: u64;
}

/// The IAM API's records as last read, and the generation of the record they came from (0 for none).
struct IamSnapshot {
    state: IamState;
    generation: u64;
}

/// The IAM records of a store, under its lock; null when the record does not read (the sets in use stay).
async fn readIamSnapshot(store: borrow Arc<AsyncMutex<ObjectStore>>) -> IamSnapshot? {
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return null; }
    };
    let st = guard.data();
    return await Async.blocking(() => iamSnapshotOf(st));
}

/// The IAM records of a store: none when its hidden bucket or record is not there.
fn iamSnapshotOf(store: borrow ObjectStore) -> IamSnapshot? {
    let info = match (store.headObject(IAM_BUCKET, IAM_STATE_KEY)) {
        Ok(i) => i,
        Err(StoreError.NoSuchBucket) => { return Some(IamSnapshot { state: IamState.empty(), generation: 0 }); }
        Err(StoreError.NoSuchKey) => { return Some(IamSnapshot { state: IamState.empty(), generation: 0 }); }
        Err(_) => { return null; }
    };
    let bytes = store.getObject(IAM_BUCKET, IAM_STATE_KEY).ok() ?? { return null; };
    let state = decodeIamState(bytes.view()).ok() ?? { return null; };
    return match (state) {
        Some(s) => Some(IamSnapshot { state: s, generation: info.generation }),
        null => null,
    };
}

/// Reads the roles file again if its modification time changed: its roles become the current set, each in its place,
/// one the file no longer has marked removed. A file that does not read changes nothing, and is reported once.
fn checkRoles(r: borrow mut RoleRotation, iam: borrow IamSnapshot?) -> RotationOutcome {
    let modified = if (r.path.length == 0) 0 else match (Fs.modifiedMillis(r.path.view())) {
        Ok(m) => m,
        Err(_) => r.modified,
    };
    let generation = match (iam) {
        Some(s) => s.generation,
        null => r.iamGeneration,
    };
    if (modified == r.modified && generation == r.iamGeneration) { return RotationOutcome.Unchanged; }
    var fileRoles = Vector<StsRole>.create();
    if (r.path.length > 0) {
        let text = match (readSmallFile(r.path.view(), "roles file")) {
            Ok(t) => t,
            Err(message) => {
                if (modified == r.failed) { return RotationOutcome.Unchanged; }
                r.failed = modified;
                return RotationOutcome.Failed(message);
            }
        };
        fileRoles = match (parseRolesFile(text.view())) {
            Ok(f) => f,
            Err(_) => {
                if (modified == r.failed) { return RotationOutcome.Unchanged; }
                r.failed = modified;
                return RotationOutcome.Failed(textOf("the roles file has a line that is not a role"));
            }
        };
    }
    // The API's roles merged in, its names over the file's (ADR-0104 §4, §5).
    var skipped = Vector<Vector<u8>>.create();
    let fresh = match (iam) {
        Some(s) => match (withIamRoles(fileRoles, borrow s.state, mut skipped)) {
            Ok(f) => f,
            Err(_) => { return RotationOutcome.Failed(textOf("out of memory")); }
        },
        null => fileRoles,
    };
    reportSkipped("roles file", skipped.view());
    // The file counts as read only once its roles are installed, so a failure below is tried again (the M15 exit
    // review).
    let next = match (nextRoles(r.sets.get().view(), fresh.view())) {
        Ok(n) => n,
        Err(_) => { return RotationOutcome.Failed(textOf("out of memory")); }
    };
    var live: u64 = 0;
    var removed: u64 = 0;
    for (i in 0..next.length) {
        if (next[i].removed) {
            removed += 1;
        } else {
            live += 1;
        }
    }
    if (!r.sets.get().replace(next)) {
        r.failed = modified; // every cell used: said once, not tried again until the file changes
        return RotationOutcome.Failed(textOf("the roles were reloaded too many times; restart to reload"));
    }
    r.modified = modified;
    r.iamGeneration = generation;
    return RotationOutcome.Reloaded(live, removed);
}

/// The files' entries skipped as the IAM API holds their names (ADR-0104 §5), said once a rebuild. Runs on the
/// blocking pool, as the rebuilds do.
fn reportSkipped(file: StringView, skipped: Slice<Vector<u8>>) {
    for (i in 0..skipped.length) {
        var line = String.create();
        let _ = line.append("cosmostore: the ");
        let _ = line.append(file);
        let _ = line.append("'s ");
        let _ = line.append(StringView.fromUtf8(skipped[i].view()) ?? "?");
        let _ = line.append(" skipped: the IAM API holds the name");
        Console.writeErrorLine(line.view());
    }
}

enum RotationOutcome {
    Unchanged,
    /// The keys now accepted, and those revoked.
    Reloaded(u64, u64),
    Failed(String),
}

/// Reads the credentials file again if its modification time changed, and makes its keys the current set. A file
/// that does not read, or has no key, changes nothing: the keys in use stay.
fn checkCredentials(r: borrow mut Rotation, iam: borrow IamSnapshot?) -> RotationOutcome {
    let modified = match (Fs.modifiedMillis(r.path.view())) {
        Ok(m) => m,
        Err(_) => r.modified,
    };
    let usersModified = if (r.usersPath.length == 0) 0 else match (Fs.modifiedMillis(r.usersPath.view())) {
        Ok(m) => m,
        Err(_) => r.usersModified,
    };
    let generation = match (iam) {
        Some(s) => s.generation,
        null => r.iamGeneration,
    };
    if (modified == r.modified && usersModified == r.usersModified && generation == r.iamGeneration) {
        return RotationOutcome.Unchanged;
    }
    let fileKeys = match (readCredentials(r.path.view())) {
        Ok(f) => f,
        Err(message) => {
            // A file caught half written reads on a later round; one that stays unreadable is reported once.
            if (modified == r.failed) { return RotationOutcome.Unchanged; }
            r.failed = modified;
            return RotationOutcome.Failed(message);
        }
    };
    // The API's active keys after the file's (ADR-0104 §4).
    let empty = IamState.empty();
    let iamState = match (iam) {
        Some(s) => borrow s.state,
        null => borrow empty,
    };
    let fresh = match (withIamKeys(fileKeys, iamState)) {
        Ok(f) => f,
        Err(_) => { return RotationOutcome.Failed(textOf("out of memory")); }
    };
    let old = r.sets.get().view();
    var next = match (nextCredentials(old, fresh.view())) {
        Ok(n) => n,
        Err(_) => { return RotationOutcome.Failed(textOf("out of memory")); }
    };
    // The users file, applied to the new set: one that does not read changes nothing, as a credentials file that
    // does not read (ADR-0088 §1). A key it does not name is refused (the M11 exit review's A2). The API's users join
    // it, their names over the file's (ADR-0104 §5).
    var fileUsers: UsersFile? = null;
    if (r.usersPath.length > 0) {
        fileUsers = match (readUsers(r.usersPath.view())) {
            Ok(u) => Some(u),
            Err(message) => {
                if (usersModified == r.failed) { return RotationOutcome.Unchanged; }
                r.failed = usersModified;
                return RotationOutcome.Failed(message);
            }
        };
    }
    // The file's users, keyed or not, for the IAM API's names (ADR-0106 §1.6), when the file changed.
    if (usersModified != r.usersModified) {
        match (borrow fileUsers) {
            Some(u) => { let _ = r.sets.get().noteFileUsers(u); }
            null => {}
        }
    }
    var skipped = Vector<Vector<u8>>.create();
    let users = match (withIamUsers(fileUsers, fresh.view(), iamState, mut skipped)) {
        Ok(u) => u,
        Err(message) => { return RotationOutcome.Failed(message); }
    };
    reportSkipped("users file", skipped.view());
    match (users) {
        Some(u) => {
            match (applyUsers(mut next, borrow u)) {
                Ok() => {}
                Err(message) => {
                    if (usersModified == r.failed) { return RotationOutcome.Unchanged; }
                    r.failed = usersModified;
                    return RotationOutcome.Failed(message);
                }
            }
        }
        null => {}
    }
    r.modified = modified; // seen: a file that is the same keys, or a set that cannot be taken, is not read again
    r.usersModified = usersModified;
    r.iamGeneration = generation;
    if (sameCredentials(old, next.view())) { return RotationOutcome.Unchanged; }
    var live: u64 = 0;
    var revoked: u64 = 0;
    for (i in 0..next.length) {
        if (next[i].revoked) {
            revoked += 1;
        } else {
            live += 1;
        }
    }
    if (!r.sets.get().replace(next)) {
        return RotationOutcome.Failed(textOf("the credentials were reloaded too many times; restart to reload"));
    }
    return RotationOutcome.Reloaded(live, revoked);
}

async fn reloadCredentialsIfChanged(r: borrow mut Rotation, iam: borrow IamSnapshot?) {
    match (borrow mut r.roles) {
        Some(roles) => {
            match (await Async.blocking(() => checkRoles(roles, iam))) {
                RotationOutcome.Unchanged => {}
                RotationOutcome.Reloaded(live, removed) => {
                    var line = String.create();
                    let _ = line.append("cosmostore: roles reloaded: ");
                    let _ = line.appendNumber(live);
                    let _ = line.append(" roles, ");
                    let _ = line.appendNumber(removed);
                    let _ = line.append(" removed\n");
                    let _ = await AsyncConsole.writeError(line.view());
                }
                RotationOutcome.Failed(message) => {
                    let _ = await AsyncConsole.writeError(
                        "cosmostore: roles reload failed, keeping the roles in use: ",
                    );
                    let _ = await AsyncConsole.writeError(message.view());
                    let _ = await AsyncConsole.writeError("\n");
                }
            }
        }
        null => {}
    }
    let outcome = await Async.blocking(() => checkCredentials(r, iam));
    match (outcome) {
        RotationOutcome.Unchanged => {}
        RotationOutcome.Reloaded(live, revoked) => {
            var line = String.create();
            let _ = line.append("cosmostore: credentials reloaded: ");
            let _ = line.appendNumber(live);
            let _ = line.append(" keys accepted, ");
            let _ = line.appendNumber(revoked);
            let _ = line.append(" revoked\n");
            let _ = await AsyncConsole.writeError(line.view());
        }
        RotationOutcome.Failed(message) => {
            let _ = await AsyncConsole.writeError("cosmostore: credentials reload failed, keeping the keys in use: ");
            let _ = await AsyncConsole.writeError(message.view());
            let _ = await AsyncConsole.writeError("\n");
        }
    }
}

/// The targets file of `--notify-targets`; none without the option. A file that does not read stops `serve`.
fn readTargets(path: StringView, given: bool) -> Vector<NotifyTarget> {
    if (!given) { return Vector<NotifyTarget>.create(); }
    let text = match (readSmallFile(path, "notification targets file")) {
        Ok(t) => t,
        Err(message) => { die(message.view()); }
    };
    return match (parseTargets(text.view())) {
        Ok(Some(t)) => t,
        Ok(null) => { die("the notification targets file needs lines of `<id> <http or https url>`, each id once"); }
        Err(_) => { die("out of memory"); }
    };
}

/// The master keys of `--sse-key-file` (ADR-0046 §4). The file's text is wiped once parsed.
fn readSseKeys(path: StringView) -> Result<Vector<MasterKey>, String> {
    var text = readSmallFile(path, "SSE key file")?;
    let parsed = parseKeyFile(text.view());
    Secret.wipe(mut text[..]);
    return match (parsed) {
        Ok(keys) => Ok(keys),
        Err(fault) => Err(textOf(match (fault) {
            KeyFileFault.Empty => "the SSE key file has no `<key id> <base64 of 32 bytes>` line",
            KeyFileFault.BadLine => "a line of the SSE key file is not `<key id> <base64 of 32 bytes>`",
            KeyFileFault.BadId => "a key id of the SSE key file is not 1 to 32 of A-Z a-z 0-9 _ -",
            KeyFileFault.BadKey => "a key of the SSE key file is not the base64 of 32 bytes",
            KeyFileFault.Duplicate => "two keys of the SSE key file have one id",
            KeyFileFault.OutOfMemory => "out of memory",
        })),
    };
}

/// Reads the credentials file, and the users file when one is named (`usersPath` empty for none), its users applied
/// to the keys (ADR-0088 §1).
fn readCredentialsWithUsers(path: StringView, usersPath: StringView) -> Result<Vector<Credential>, String> {
    var creds = readCredentials(path)?;
    if (usersPath.length > 0) {
        let users = readUsers(usersPath)?;
        applyUsers(mut creds, borrow users)?;
    }
    return Ok(creds);
}

/// The users file's users noted in `sets` (ADR-0106 §1.6), at start; nothing for a file that does not read, which the
/// start has already refused.
fn noteFileUsersAt(sets: borrow CredentialSets, usersPath: StringView) {
    match (readUsers(usersPath)) {
        Ok(u) => { let _ = sets.noteFileUsers(borrow u); }
        Err(_) => {}
    }
}

fn readCredentials(path: StringView) -> Result<Vector<Credential>, String> {
    let text = readSmallFile(path, "credentials file")?;
    let creds = match (parseCredentials(text.view())) {
        Ok(c) => c,
        Err(_) => { return Err(textOf("out of memory")); }
    };
    if (creds.length == 0) { return Err(textOf("the credentials file has no `access-key secret-key` line")); }
    return Ok(creds);
}

fn s3Handler() -> Result<Box<dyn Handler<S3App> + Send + Share>, RouteError> {
    match (Box.create(S3Handler {})) {
        Ok(h) => {
            let d: Box<dyn Handler<S3App> + Send + Share> = h;
            return Ok(d);
        }
        Err(_) => { return Err(RouteError.OutOfMemory); }
    }
}

/// The server: every path and method goes to the one S3 handler, which reads the path itself (bucket, key).
fn s3Server(app: S3App) -> Result<Server<S3App>, RouteError> {
    var limits = Limits.defaults();
    // A 5 GiB object, plus aws-chunked framing.
    limits.maxBodyBytes = 6442450944;
    // The write buffer stays CeeSafe.Web's 16 KiB: a body slice at least that large goes to the socket without a copy
    // (CeeSafe.Web ADR 0013 amendment 4), so a larger buffer no longer pays (ADR-0038).
    var server = Server<S3App>.create(app, limits)?;
    server.router().get("/*path", s3Handler()?)?;
    server.router().put("/*path", s3Handler()?)?;
    server.router().post("/*path", s3Handler()?)?;
    server.router().delete("/*path", s3Handler()?)?;
    // A browser's preflight (ADR-0049): without the route the server would answer OPTIONS itself.
    server.router().add(Method.Options, "/*path", s3Handler()?)?;
    return Ok(server);
}

/// Where to listen (ADR-0016): a bare port is 127.0.0.1's; otherwise `a.b.c.d:port` or `[v6]:port`. `[::]` takes
/// IPv4 too (not v6-only).
fn listenAddress(text: StringView) -> SocketAddress? {
    match (text.parseInt<u16>()) {
        Some(port) => { return SocketAddresses.v4Loopback(port); }
        null => {}
    }
    return SocketAddresses.parse(text);
}

fn textOf(s: StringView) -> String {
    var t = String.create();
    let _ = t.append(s);
    return t;
}

/// The TLS configuration from a PEM certificate chain (leaf first) and its key (ADR-0016). HTTP/1.1 only, as the S3
/// layer serves.
fn tlsConfig(certPath: StringView, keyPath: StringView) -> Result<TlsConfig, String> {
    let chain = readSmallFile(certPath, "TLS certificate")?;
    let key = readSmallFile(keyPath, "TLS key")?;
    var config = match (TlsConfig.server(chain.view(), key.view())) {
        Ok(c) => c,
        Err(_) => { return Err(textOf("the TLS certificate and key could not be used together")); }
    };
    let protocols = [Alpn.Http11];
    match (config.setAlpn(protocols[..])) {
        Ok() => {}
        Err(_) => { return Err(textOf("TLS: ALPN could not be set")); }
    }
    return Ok(config);
}

/// How often the server runs the store's upkeep, unless `--maintain-seconds` says otherwise (ADR-0017, ADR-0019).
const MAINTAIN_EVERY_MS: u64 = 10000;

fn listenOn(address: SocketAddress) -> Result<Listener, NetError> {
    let options = ListenOptions { backlog: 0, reuseAddress: true, reusePort: false, v6Only: false };
    return Listener.bindWith(address, options);
}

async fn notice(address: SocketAddress, tls: bool) {
    // A notice, not a condition of serving: standard error may be something the async console cannot write to, such
    // as /dev/null on macOS (CEESAFE_GAPS G27), and the server must run all the same.
    let text = match (servingNotice(address, tls)) {
        Ok(n) => n,
        Err(_) => Vector<u8>.create(),
    };
    let _ = await AsyncConsole.writeError(StringView.fromUtf8(text.view()) ?? "");
    let _ = await AsyncConsole.writeError(openFileLine().view());
}

/// `cosmostore: open-file limit 61440`: the limit `serve` runs with, after raising it (ADR-0039 amendment).
fn openFileLine() -> String {
    var line = String.create();
    let _ = line.append("cosmostore: open-file limit ");
    match (ProcessLimits.openFiles()) {
        Ok(l) => {
            if (l.current == 0xFFFFFFFFFFFFFFFF) {
                let _ = line.append("unlimited");
            } else {
                let _ = line.appendNumber(l.current);
            }
        }
        Err(e) => {
            let _ = line.append("unknown: ");
            let _ = line.append(e.message());
        }
    }
    let _ = line.append("\n");
    return line;
}

/// Plain HTTP: the server, and beside it the store's upkeep; if the server stops, the upkeep is cancelled.
async fn servePlain(
    server: Server<S3App>,
    address: SocketAddress,
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    everyMs: u64,
    targets: borrow Arc<Reloaded<NotifyTarget>>,
    rotation: borrow mut Rotation,
    audit: borrow AuditWriter,
) -> Result<ServerReport, NetError> {
    let listener = listenOn(address)?;
    let drain = Drain.create()?;
    let plain = PlainAcceptor {};
    await notice(address, false);
    let raced = await Async.race(
        async move () => await server.run(listener, borrow plain, ConnectionLimits.defaults(), drain),
        async () => await maintainAndDeliver(store, everyMs, targets, rotation, audit),
    );
    return Ok(raced?.value);
}

/// The upkeep, and beside it the delivery of event notifications (ADR-0048): neither ends until it is cancelled.
async fn maintainAndDeliver(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    everyMs: u64,
    targets: borrow Arc<Reloaded<NotifyTarget>>,
    rotation: borrow mut Rotation,
    audit: borrow AuditWriter,
) -> Result<ServerReport, NetError> {
    let raced = await Async.race(
        async () => await maintainForever(store, everyMs, rotation),
        async () => await deliverAndAudit(store, targets, audit),
    );
    return Ok(raced?.value);
}

/// `maintainAndDeliver` for a TLS server, whose upkeep also reloads the certificate.
async fn maintainReloadAndDeliver(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    everyMs: u64,
    config: borrow TlsConfig,
    watch: borrow mut CertWatch,
    targets: borrow Arc<Reloaded<NotifyTarget>>,
    rotation: borrow mut Rotation,
    audit: borrow AuditWriter,
) -> Result<ServerReport, NetError> {
    let raced = await Async.race(
        async () => await maintainAndReload(store, everyMs, config, watch, rotation),
        async () => await deliverAndAudit(store, targets, audit),
    );
    return Ok(raced?.value);
}

/// TLS: as plain, and the upkeep also reloads the certificate when its files change (ADR-0019).
async fn serveTls(
    server: Server<S3App>,
    address: SocketAddress,
    acceptor: borrow TlsAcceptor,
    watch: borrow mut CertWatch,
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    everyMs: u64,
    targets: borrow Arc<Reloaded<NotifyTarget>>,
    rotation: borrow mut Rotation,
    audit: borrow AuditWriter,
) -> Result<ServerReport, NetError> {
    let listener = listenOn(address)?;
    let drain = Drain.create()?;
    await notice(address, true);
    let config = acceptor.configuration();
    let raced = await Async.race(
        async move () => await server.run(listener, acceptor, ConnectionLimits.defaults(), drain),
        async () => await maintainReloadAndDeliver(store, everyMs, config, watch, targets, rotation, audit),
    );
    return Ok(raced?.value);
}

/// The certificate and key files of a TLS server, and when each was last seen modified.
struct CertWatch {
    certPath: String;
    keyPath: String;
    certMillis: i64;
    keyMillis: i64;
}

fn certWatch(certPath: StringView, keyPath: StringView) -> CertWatch => CertWatch {
    certPath: textOf(certPath),
    keyPath: textOf(keyPath),
    certMillis: match (Fs.modifiedMillis(certPath)) {
        Ok(m) => m,
        Err(_) => 0,
    },
    keyMillis: match (Fs.modifiedMillis(keyPath)) {
        Ok(m) => m,
        Err(_) => 0,
    },
};

/// The store's upkeep, forever, every `everyMs`: checkpoints when due, compaction, reaping, and expiring old uploads
/// (`ObjectStore.maintain`). It holds the store's lock while it runs, so requests wait for it. A failure is logged and
/// tried again next time; the loop ends only when it is cancelled.
async fn maintainForever(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    everyMs: u64,
    rotation: borrow mut Rotation,
) -> Result<ServerReport, NetError> {
    while (true) {
        match (await Timer.sleep(everyMs)) {
            Ok() => {}
            Err(e) => { return Err(NetErrors.fromAsync(e)); }
        }
        await upkeep(store);
        let iam = await readIamSnapshot(store);
        await reloadCredentialsIfChanged(rotation, iam.asBorrow());
        await reloadKeysIfChanged(rotation, store);
        await rewrapUnderFirst(rotation, store);
        await reloadTargetsIfChanged(rotation);
    }
    return Err(NetError.Closed);
}

/// The upkeep, and a certificate reload whenever the certificate's or the key's file changed.
async fn maintainAndReload(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    everyMs: u64,
    config: borrow TlsConfig,
    watch: borrow mut CertWatch,
    rotation: borrow mut Rotation,
) -> Result<ServerReport, NetError> {
    while (true) {
        match (await Timer.sleep(everyMs)) {
            Ok() => {}
            Err(e) => { return Err(NetErrors.fromAsync(e)); }
        }
        await upkeep(store);
        await reloadIfChanged(config, watch);
        let iam = await readIamSnapshot(store);
        await reloadCredentialsIfChanged(rotation, iam.asBorrow());
        await reloadKeysIfChanged(rotation, store);
        await rewrapUnderFirst(rotation, store);
        await reloadTargetsIfChanged(rotation);
    }
    return Err(NetError.Closed);
}

/// Whether the journal's failure has been logged: once per process, since a failed journal stays failed.
static JOURNAL_FAILURE_LOGGED: AtomicBool = AtomicBool.constant(false);

async fn upkeep(store: borrow Arc<AsyncMutex<ObjectStore>>) {
    await logJournalFailure(store);
    match (await maintainOnce(store)) {
        Ok() => {}
        Err(e) => {
            let _ = await AsyncConsole.writeError("cosmostore: maintenance failed: ");
            let _ = await AsyncConsole.writeError(storeErrorLine(e).view());
        }
    }
}

/// Logs once, with its cause, that the journal failed and the store refuses writes (ADR-0039).
async fn logJournalFailure(store: borrow Arc<AsyncMutex<ObjectStore>>) {
    if (JOURNAL_FAILURE_LOGGED.load()) { return; }
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return; }
    };
    let s = guard.data();
    if (!s.hasFailed()) { return; }
    JOURNAL_FAILURE_LOGGED.store(true);
    var line = String.create();
    let _ = line.append("cosmostore: the journal failed");
    match (s.journalFailure()) {
        Some(f) => {
            let _ = line.append(" (");
            appendIoFailure(mut line, f);
            let _ = line.append(")");
        }
        null => {}
    }
    let _ = line.append("; writes are refused until a restart\n");
    let _ = await AsyncConsole.writeError(line.view());
}

/// A store error for the log, with the OS error number of an I/O failure: "open (errno 24)\n".
fn storeErrorLine(e: StoreError) -> String {
    var line = String.create();
    match (e) {
        StoreError.Journal(JournalError.Io(f)) => {
            let _ = line.append("journal ");
            appendIoFailure(mut line, f);
        }
        StoreError.Io(f) => { appendIoFailure(mut line, f); }
        StoreError.Journal(JournalError.Corrupt(segment, offset)) => {
            // Where: a record of segment 0 at offset 0 is one received whole, not read from a file.
            let _ = line.append("journal corrupt at segment ");
            let _ = line.appendNumber(truncate<i64>(segment));
            let _ = line.append(", offset ");
            let _ = line.appendNumber(truncate<i64>(offset));
        }
        StoreError.Journal(JournalError.OutOfOrder(lsn)) => {
            let _ = line.append("journal entry out of order at ");
            let _ = line.appendNumber(truncate<i64>(lsn));
        }
        StoreError.Journal(JournalError.BadSegmentHeader(id)) => {
            let _ = line.append("journal segment header bad: segment ");
            let _ = line.appendNumber(truncate<i64>(id));
        }
        StoreError.Journal(JournalError.MissingSegment(id)) => {
            let _ = line.append("journal segment missing: segment ");
            let _ = line.appendNumber(truncate<i64>(id));
        }
        StoreError.Journal(JournalError.WrongMode(id)) => {
            let _ = line.append("journal of the other kind: segment ");
            let _ = line.appendNumber(truncate<i64>(id));
        }
        StoreError.Journal(JournalError.TooLarge) => { let _ = line.append("journal record too large"); }
        StoreError.Journal(JournalError.Failed) => { let _ = line.append("journal failed earlier"); }
        StoreError.Journal(JournalError.ActiveSegment) => { let _ = line.append("journal: the active segment"); }
        _ => { let _ = line.append(describe(e)); }
    }
    let _ = line.append("\n");
    return line;
}

fn appendIoFailure(line: borrow mut String, f: IoFailure) {
    let _ = line.append(ioOpName(f.op));
    let _ = line.append(" failed, errno ");
    let _ = line.appendNumber(f.errno as i64);
}

async fn maintainOnce(store: borrow Arc<AsyncMutex<ObjectStore>>) -> Result<void, StoreError> {
    await checkpointInSteps(store)?;
    await compactInSteps(store)?;
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Ok(); } // cancelled: the server is stopping
    };
    let s = guard.data();
    let report = await Async.blocking(() => s.upkeep(false))?;
    if (report.totalMicros >= UPKEEP_SLOW_MICROS) {
        let _ = await AsyncConsole.writeError(slowUpkeepLine(borrow report).view());
    }
    return Ok();
}

/// "cosmostore: upkeep held the store 37 ms (reaping 0, compaction 33: 1 segments removed, 0 copied; lifecycle 2)"
fn slowUpkeepLine(r: borrow MaintenanceReport) -> String {
    var line = String.create();
    let _ = line.append("cosmostore: upkeep held the store ");
    let _ = line.appendNumber(r.totalMicros / 1000);
    let _ = line.append(" ms (reaping ");
    let _ = line.appendNumber(r.reapMicros / 1000);
    let _ = line.append(", compaction ");
    let _ = line.appendNumber(r.compactionMicros / 1000);
    let _ = line.append(": ");
    let _ = line.appendNumber(r.compaction.segmentsRemoved);
    let _ = line.append(" segments removed, ");
    let _ = line.appendNumber(r.compaction.relocated);
    let _ = line.append(" copied; lifecycle ");
    let _ = line.appendNumber(r.lifecycleMicros / 1000);
    let _ = line.append(")\n");
    return line;
}

/// "cosmostore: checkpoint at LSN 952414: 1000013 entries in 245 steps, the longest held the store 3 ms"
fn checkpointLine(job: borrow CheckpointJob) -> String {
    var line = String.create();
    let _ = line.append("cosmostore: checkpoint at LSN ");
    let _ = line.appendNumber(job.lsn);
    let _ = line.append(": ");
    let _ = line.appendNumber(job.entries());
    let _ = line.append(" entries in ");
    let _ = line.appendNumber(job.steps);
    let _ = line.append(" steps, the longest held the store ");
    let _ = line.appendNumber(job.longestStepMicros / 1000);
    let _ = line.append(" ms\n");
    return line;
}

/// A due checkpoint, written in steps (ADR-0028). The store's lock is held to begin it, for each step's encoding (a
/// few thousand entries, memory only), and to record or abandon it. The writes, the sync and the rename go without
/// the lock while requests go on; the index keeps the versions they change until the checkpoint has them. If the
/// server stops part way, the next begin drops the snapshot, and the next open the temporary file.
async fn checkpointInSteps(store: borrow Arc<AsyncMutex<ObjectStore>>) -> Result<void, StoreError> {
    var job = match (await beginJob(store)?) {
        Some(j) => j,
        null => { return Ok(); }
    };
    var failure: StoreError? = null;
    loop {
        let finished = match (await stepJob(store, mut job)) {
            Ok(Some(f)) => f,
            Ok(null) => { return Ok(); } // cancelled
            Err(e) => {
                failure = e;
                break;
            }
        };
        let j = borrow mut job;
        match (await Async.blocking(() => j.flush())) {
            Ok() => {}
            Err(e) => {
                failure = e;
                break;
            }
        }
        if (finished) { break; }
    }
    if (failure.isNull()) {
        let j = borrow mut job;
        match (await Async.blocking(() => j.publish())) {
            Ok(size) => { return await recordJob(store, borrow job, size); }
            Err(e) => { failure = e; }
        }
    }
    await abandonJob(store, mut job);
    return match (failure) {
        Some(e) => Err(e),
        null => Ok(),
    };
}

/// A compaction in steps (ADR-0029): the plan a few thousand index entries at a time and each copy batch's commit
/// under the store's lock; the records' reads without it. The lock is released between steps, so requests go on.
async fn compactInSteps(store: borrow Arc<AsyncMutex<ObjectStore>>) -> Result<void, StoreError> {
    var job = match (await beginCompactionJob(store)?) {
        Some(j) => j,
        null => { return Ok(); } // nothing to reclaim, or the server is stopping
    };
    while (true) {
        match (await compactionPlan(store, mut job)?) {
            Some(true) => { break; }
            Some(false) => {}
            null => { return Ok(); }
        }
    }
    while (true) {
        let j = borrow mut job;
        let read = await Async.blocking(() => j.readBatch(COMPACTION_COPY_BYTES))?;
        if (!read) { break; }
        if (!(await compactionCopy(store, mut job)?)) { return Ok(); }
    }
    let stats = match (await finishCompactionJob(store, mut job)?) {
        Some(st) => st,
        null => { return Ok(); }
    };
    if (stats.segmentsRemoved > 0 || stats.relocated > 0) {
        let _ = await AsyncConsole.writeError(compactionLine(borrow stats).view());
    }
    return Ok();
}

// Each of these holds the store's lock for one step; null (or false) if the server is stopping.

async fn beginCompactionJob(store: borrow Arc<AsyncMutex<ObjectStore>>) -> Result<CompactionJob?, StoreError> {
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Ok(null); }
    };
    let s = guard.data();
    return await Async.blocking(() => s.beginCompaction(s.compactionBudget()));
}

async fn compactionPlan(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    job: borrow mut CompactionJob,
) -> Result<bool?, StoreError> {
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Ok(null); }
    };
    let s = guard.data();
    return Ok(await Async.blocking(() => s.compactionPlanStep(job, COMPACTION_PLAN_ENTRIES))?);
}

async fn compactionCopy(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    job: borrow mut CompactionJob,
) -> Result<bool, StoreError> {
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Ok(false); }
    };
    let s = guard.data();
    await Async.blocking(() => s.compactionCopyStep(job))?;
    return Ok(true);
}

async fn finishCompactionJob(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    job: borrow mut CompactionJob,
) -> Result<CompactStats?, StoreError> {
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Ok(null); }
    };
    let s = guard.data();
    return Ok(await Async.blocking(() => s.finishCompaction(job))?);
}

/// "cosmostore: compaction removed 1 segments (68157440 bytes), copying 576 records (36864000 bytes)"
fn compactionLine(st: borrow CompactStats) -> String {
    var line = String.create();
    let _ = line.append("cosmostore: compaction removed ");
    let _ = line.appendNumber(st.segmentsRemoved);
    let _ = line.append(" segments (");
    let _ = line.appendNumber(st.bytesFreed);
    let _ = line.append(" bytes), copying ");
    let _ = line.appendNumber(st.relocated);
    let _ = line.append(" records (");
    let _ = line.appendNumber(st.bytesCopied);
    let _ = line.append(" bytes)\n");
    return line;
}

/// Begins a checkpoint if one is due: null if not, or if the server is stopping.
async fn beginJob(store: borrow Arc<AsyncMutex<ObjectStore>>) -> Result<CheckpointJob?, StoreError> {
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Ok(null); }
    };
    let s = guard.data();
    if (!s.checkpointDue()) { return Ok(null); }
    return await Async.blocking(() => s.beginCheckpoint());
}

/// One step under the lock: whether the snapshot is done; null if the server is stopping.
async fn stepJob(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    job: borrow mut CheckpointJob,
) -> Result<bool?, StoreError> {
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Ok(null); }
    };
    let s = guard.data();
    return Ok(await Async.blocking(() => s.checkpointStep(job, CHECKPOINT_STEP_ENTRIES))?);
}

async fn recordJob(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    job: borrow CheckpointJob,
    size: u64,
) -> Result<void, StoreError> {
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Ok(); } // published, but not recorded: the next open uses it all the same
    };
    let s = guard.data();
    await Async.blocking(() => s.checkpointPublished(job, size));
    let _ = await AsyncConsole.writeError(checkpointLine(job).view());
    return Ok();
}

async fn abandonJob(store: borrow Arc<AsyncMutex<ObjectStore>>, job: borrow mut CheckpointJob) {
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return; }
    };
    let s = guard.data();
    await Async.blocking(() => s.checkpointAbandoned(job));
}

/// Reloads the certificate if its file or its key's changed since the last good load, on a worker thread (the stat and
/// the reads block). New connections get the new certificate; open connections keep theirs. A failed reload (a
/// certificate written before its key, say) keeps the old certificate, is logged, and is tried again next time.
async fn reloadIfChanged(config: borrow TlsConfig, watch: borrow mut CertWatch) {
    let outcome = await Async.blocking(() => checkAndReload(config, watch));
    match (outcome) {
        ReloadOutcome.Unchanged => {}
        ReloadOutcome.Reloaded => { let _ = await AsyncConsole.writeError("cosmostore: TLS certificate reloaded\n"); }
        ReloadOutcome.Failed(message) => {
            let _ = await AsyncConsole.writeError("cosmostore: TLS reload failed, keeping the old certificate: ");
            let _ = await AsyncConsole.writeError(message.view());
            let _ = await AsyncConsole.writeError("\n");
        }
    }
}

enum ReloadOutcome {
    Unchanged,
    Reloaded,
    Failed(String),
}

fn checkAndReload(config: borrow TlsConfig, watch: borrow mut CertWatch) -> ReloadOutcome {
    let certMillis = match (Fs.modifiedMillis(watch.certPath.view())) {
        Ok(m) => m,
        Err(_) => watch.certMillis,
    };
    let keyMillis = match (Fs.modifiedMillis(watch.keyPath.view())) {
        Ok(m) => m,
        Err(_) => watch.keyMillis,
    };
    if (certMillis == watch.certMillis && keyMillis == watch.keyMillis) { return ReloadOutcome.Unchanged; }
    match (reloadCertificate(config, watch.certPath.view(), watch.keyPath.view())) {
        Ok() => {
            watch.certMillis = certMillis;
            watch.keyMillis = keyMillis;
            return ReloadOutcome.Reloaded;
        }
        Err(message) => { return ReloadOutcome.Failed(message); }
    }
}

fn reloadCertificate(config: borrow TlsConfig, certPath: StringView, keyPath: StringView) -> Result<void, String> {
    let chain = readSmallFile(certPath, "TLS certificate")?;
    let key = readSmallFile(keyPath, "TLS key")?;
    return match (config.reload(chain.view(), key.view())) {
        Ok() => Ok(),
        Err(_) => Err(textOf("the TLS certificate and key could not be used together")),
    };
}
/// `cosmostore: serving S3 on <address>:<port>`, a line.
fn servingNotice(address: SocketAddress, tls: bool) -> Result<Vector<u8>, AllocError> {
    var notice = Vector<u8>.create();
    notice.extend(if (tls) "cosmostore: serving S3 over TLS on ".bytes() else "cosmostore: serving S3 on ".bytes())?;
    let v6 = match (address) {
        SocketAddress.V6(_, _, _) => true,
        _ => false,
    };
    if (v6) { notice.push('[')?; }
    ipText(address, mut notice)?;
    if (v6) { notice.push(']')?; }
    notice.push(':')?;
    appendDecimal(mut notice, addressPort(address) as u64)?;
    notice.push('\n')?;
    return Ok(notice);
}

fn addressPort(a: SocketAddress) -> u16 => match (a) {
    SocketAddress.V4(_, port) => port,
    SocketAddress.V6(_, port, _) => port,
};

/// Raises the soft open-file limit as far as the system allows (CeeSafe 0.41.0, ADR 0104; ADR-0039 amendment): the
/// server holds a descriptor per connection and per upload in progress, and macOS starts processes at 256. The limit it
/// runs with is logged after the serving notice; a failure leaves it as it was.
fn raiseOpenFileLimit() {
    let _ = ProcessLimits.raiseOpenFiles(0xFFFFFFFFFFFFFFFF);
}

/// `cosmostore serve`: returns the exit status.
fn serve() -> i32 {
    let dir = Process.argument(2) ?? "";
    let portText = Process.argument(3) ?? "";
    let credentialsPath = Process.argument(4) ?? "";
    if (dir.length == 0 || credentialsPath.length == 0) { usage(); }
    // Then the domain, if the next argument is not an option, and `--tls-cert <file> --tls-key <file>`.
    var domain = Vector<u8>.create();
    // The argument positions of the certificate and the key (0: not given).
    var certAt: usize = 0;
    var keyAt: usize = 0;
    var everyMs = MAINTAIN_EVERY_MS;
    var targetsAt: usize = 0;
    var auditAt: usize = 0;
    var accessLogSeconds: u64 = 300;
    var inventoryDaySeconds: u64 = 86400;
    var restoreHourSeconds: u64 = 3600;
    var tablesDaySeconds: u64 = 86400;
    var websiteDomain = Vector<u8>.create();
    var zoneId = Vector<u8>.create();
    var sseKeysAt: usize = 0;
    var kmsKeysAt: usize = 0;
    var stsKeysAt: usize = 0;
    var replicationTargetsAt: usize = 0;
    var rolesAt: usize = 0;
    var usersAt: usize = 0;
    var perAddress: u64 = 0;
    var perKey: u64 = 0;
    var storeConfig = StoreConfig.defaults();
    var at: usize = 5;
    match (Process.argument(5)) {
        Some(d) => {
            if (!d.startsWith("--")) {
                match (domain.extend(d.bytes())) {
                    Ok() => {}
                    Err(_) => { die("out of memory"); }
                }
                at = 6;
            }
        }
        null => {}
    }
    while (true) {
        let option = match (Process.argument(at)) {
            Some(o) => o,
            null => { break; }
        };
        let value = Process.argument(at + 1) ?? "";
        if (value.length == 0) { usage(); }
        if (option == "--tls-cert") {
            certAt = at + 1;
        } else if (option == "--tls-key") {
            keyAt = at + 1;
        } else if (option == "--maintain-seconds") {
            match (value.parseInt<u64>()) {
                Some(n) => {
                    if (n < 1 || n > 86400) { die("--maintain-seconds is 1 to 86400"); }
                    everyMs = n * 1000;
                }
                null => { usage(); }
            }
        } else if (option == "--notify-targets") {
            targetsAt = at + 1;
        } else if (option == "--audit-log") {
            auditAt = at + 1;
        } else if (option == "--website-domain") {
            // Where buckets' websites are (ADR-0073): `<bucket>.<domain>`.
            if (value.length == 0) { usage(); }
            for (b in value.bytes()) {
                if (websiteDomain.push(lowerAscii(b)).isErr()) { die("out of memory"); }
            }
        } else if (option == "--zone-id") {
            // The zone of this server's directory buckets (ADR-0080 §1).
            if (!isZoneId(value.bytes())) { die("--zone-id is 1 to 20 of a-z, 0-9 and '-', e.g. local-az1"); }
            if (zoneId.extend(value.bytes()).isErr()) { die("out of memory"); }
        } else if (option == "--restore-hour-seconds") {
            // How long an hour of a restore's times, and a day of its `Days`, takes (ADR-0102 §6); shorter in tests.
            match (value.parseInt<u64>()) {
                Some(n) => {
                    if (n < 1 || n > 3600) { die("--restore-hour-seconds is 1 to 3600"); }
                    restoreHourSeconds = n;
                }
                null => { usage(); }
            }
        } else if (option == "--inventory-day-seconds") {
            // How long an inventory report's "day" is (ADR-0074 §3): a day; shorter in tests.
            match (value.parseInt<u64>()) {
                Some(n) => {
                    if (n < 1 || n > 86400) { die("--inventory-day-seconds is 1 to 86400"); }
                    inventoryDaySeconds = n;
                }
                null => { usage(); }
            }
        } else if (option == "--tables-day-seconds") {
            // How long table maintenance's "day" is (ADR-0086 §5): a day; shorter in tests.
            match (value.parseInt<u64>()) {
                Some(n) => {
                    if (n < 1 || n > 86400) { die("--tables-day-seconds is 1 to 86400"); }
                    tablesDaySeconds = n;
                }
                null => { usage(); }
            }
        } else if (option == "--access-log-seconds") {
            // How often a bucket's access log lines are delivered to its target (ADR-0072 §3).
            match (value.parseInt<u64>()) {
                Some(n) => {
                    if (n < 1 || n > 86400) { die("--access-log-seconds is 1 to 86400"); }
                    accessLogSeconds = n;
                }
                null => { usage(); }
            }
        } else if (option == "--sse-key-file") {
            sseKeysAt = at + 1;
        } else if (option == "--kms-key-file") {
            kmsKeysAt = at + 1;
        } else if (option == "--sts-key-file") {
            stsKeysAt = at + 1;
        } else if (option == "--replication-targets") {
            replicationTargetsAt = at + 1;
        } else if (option == "--roles-file") {
            rolesAt = at + 1;
        } else if (option == "--users-file") {
            // Users, their keys and their identity policies (ADR-0088 §1).
            usersAt = at + 1;
        } else if (option == "--rate-limit-address" || option == "--rate-limit-key") {
            match (value.parseInt<u64>()) {
                Some(n) => {
                    if (n < 1 || n > MAX_RATE_LIMIT) { die("a rate limit is 1 to 1000000 requests a second"); }
                    if (option == "--rate-limit-key") {
                        perKey = n;
                    } else {
                        perAddress = n;
                    }
                }
                null => { usage(); }
            }
        } else if (option == "--upload-expiry-hours") {
            match (value.parseInt<u64>()) {
                Some(n) => { storeConfig.uploadExpiryMillis = n * 3600000; } // 0: never
                null => { usage(); }
            }
        } else {
            usage();
        }
        at += 2;
    }
    raiseOpenFileLimit();
    if ((certAt == 0) != (keyAt == 0)) { die("--tls-cert and --tls-key go together"); }
    let address = match (listenAddress(portText)) {
        Some(a) => a,
        null => { usage(); }
    };
    let usersPath = Process.argument(usersAt) ?? "";
    let firstCredentials = match (readCredentialsWithUsers(credentialsPath, if (usersAt == 0) "" else usersPath)) {
        Ok(c) => c,
        Err(message) => { die(message.view()); }
    };
    // The sets a reload of the file goes into (ADR-0050): one owner for the requests, one for the upkeep.
    let credentials = match (CredentialSets.create(firstCredentials)) {
        Ok(sets) => match (Arc<CredentialSets>.create(sets)) {
            Ok(a) => a,
            Err(_) => { die("out of memory"); }
        },
        Err(_) => { die("out of memory"); }
    };
    if (usersAt != 0) { noteFileUsersAt(credentials.get(), usersPath); }
    var rotation = Rotation {
        sets: credentials.clone(),
        path: textOf(credentialsPath),
        modified: match (Fs.modifiedMillis(credentialsPath)) {
            Ok(m) => m,
            Err(_) => 0,
        },
        failed: 0,
        usersPath: textOf(if (usersAt == 0) "" else usersPath),
        usersModified: if (usersAt == 0) 0 else match (Fs.modifiedMillis(usersPath)) {
            Ok(m) => m,
            Err(_) => 0,
        },
        roles: null,
        iamGeneration: 0,
        keyFiles: Vector<KeyRotation>.create(),
        rewrapAfter: null,
        notifyFile: null,
        replicationFile: null,
    };
    // The webhooks of event notifications (ADR-0048): once for the requests, once for the delivery task.
    // One list for the requests and the delivery task, reloaded (ADR-0096 §5).
    let notifyTargets = match (sharedList(readTargets(Process.argument(targetsAt) ?? "", targetsAt != 0))) {
        Ok(t) => t,
        Err(_) => { die("out of memory"); }
    };
    if (targetsAt != 0) {
        let targetsPath = Process.argument(targetsAt) ?? "";
        rotation.notifyFile = Some(TargetRotation<NotifyTarget> {
            list: notifyTargets.clone(),
            path: textOf(targetsPath),
            modified: Fs.modifiedMillis(targetsPath).ok() ?? 0,
            failed: 0,
        });
    }
    // The audit log (ADR-0051): a queue the requests fill and a task empties into the file.
    let auditLines = match (Channel<Vector<u8>>.create(AUDIT_QUEUE)) {
        Ok(c) => c,
        Err(_) => { die("out of memory"); }
    };
    let accessLines = match (Channel<AccessLogEntry>.create(ACCESS_LOG_QUEUE)) {
        Ok(c) => c,
        Err(_) => { die("out of memory"); }
    };
    var auditWriter = AuditWriter {
        lines: auditLines.clone(),
        path: textOf(Process.argument(auditAt) ?? ""),
        enabled: auditAt != 0,
        access: AccessLogWriter { lines: accessLines.clone(), everyMs: accessLogSeconds * 1000 },
        inventory: InventoryWriter { dayMs: inventoryDaySeconds * 1000 },
        tables: TablesMaintainer {
            dayMs: tablesDaySeconds * 1000,
            keys: match (noTableKeys()) {
                Ok(k) => k,
                Err(_) => { die("out of memory"); }
            },
        },
        replication: ReplicaContext {
            targets: match (sharedList(Vector<ReplicationTarget>.create())) {
                Ok(t) => t,
                Err(_) => { die("out of memory"); }
            },
            sseKeys: match (sharedKeys(Vector<MasterKey>.create())) {
                Ok(k) => k,
                Err(_) => { die("out of memory"); }
            },
            kmsKeys: match (sharedKeys(Vector<MasterKey>.create())) {
                Ok(k) => k,
                Err(_) => { die("out of memory"); }
            },
        },
        decider: RecordedDecider.none(),
    };
    if (auditAt != 0) {
        // Before the store opens: a log that cannot be written stops `serve`.
        match (appendAudit(auditWriter.path.view(), "".bytes())) {
            Ok() => {}
            Err(_) => { die("the audit log cannot be opened for writing"); }
        }
    }
    // The master keys before the store opens: a key file that does not parse stops `serve` (ADR-0046 §4).
    var sseKeys = Vector<MasterKey>.create();
    if (sseKeysAt != 0) {
        sseKeys = match (readSseKeys(Process.argument(sseKeysAt) ?? "")) {
            Ok(k) => k,
            Err(message) => { die(message.view()); }
        };
    }
    var kmsKeys = Vector<MasterKey>.create();
    if (kmsKeysAt != 0) {
        kmsKeys = match (readSseKeys(Process.argument(kmsKeysAt) ?? "")) {
            Ok(k) => k,
            Err(message) => { die(message.view()); }
        };
    }
    // The endpoints replication may send to (ADR-0077 §6), and the keys that open what it sends; the file's text,
    // which holds secrets, is wiped once parsed.
    if (replicationTargetsAt != 0) {
        var text = match (readSmallFile(Process.argument(replicationTargetsAt) ?? "", "replication targets file")) {
            Ok(t) => t,
            Err(message) => { die(message.view()); }
        };
        let parsed = parseReplicationTargets(text.view());
        Secret.wipe(mut text[..]);
        let first = match (parsed) {
            Ok(Some(t)) => t,
            Ok(null) => {
                die(
                    "the replication targets file needs lines of `<id> <http or https url> <access key> <secret key> [region]`, each id once",
                );
            }
            Err(_) => { die("out of memory"); }
        };
        auditWriter.replication.targets = match (sharedList(first)) {
            Ok(t) => t,
            Err(_) => { die("out of memory"); }
        };
        let replicationPath = Process.argument(replicationTargetsAt) ?? "";
        rotation.replicationFile = Some(TargetRotation<ReplicationTarget> {
            list: auditWriter.replication.targets.clone(),
            path: textOf(replicationPath),
            modified: Fs.modifiedMillis(replicationPath).ok() ?? 0,
            failed: 0,
        });
    }
    // The key sets, shared by the S3 server and the writers, and reloaded (ADR-0096 §1, §3).
    let sseSets = match (sharedKeys(sseKeys)) {
        Ok(k) => k,
        Err(_) => { die("out of memory"); }
    };
    let kmsSets = match (sharedKeys(kmsKeys)) {
        Ok(k) => k,
        Err(_) => { die("out of memory"); }
    };
    auditWriter.replication.sseKeys = sseSets.clone();
    auditWriter.replication.kmsKeys = kmsSets.clone();
    auditWriter.tables.keys = TableKeys { sse: sseSets.clone(), kms: kmsSets.clone() };
    // STS's token keys and its roles (ADR-0075).
    var stsKeys = Vector<MasterKey>.create();
    if (stsKeysAt != 0) {
        stsKeys = match (readSseKeys(Process.argument(stsKeysAt) ?? "")) {
            Ok(k) => k,
            Err(message) => { die(message.view()); }
        };
    }
    let stsSets = match (sharedKeys(stsKeys)) {
        Ok(k) => k,
        Err(_) => { die("out of memory"); }
    };
    // The key files given, reloaded with the credentials (ADR-0096 §3, §4).
    for (file in [
        [sseKeysAt as u64, KEY_FILE_SSE as u64],
        [kmsKeysAt as u64, KEY_FILE_KMS as u64],
        [stsKeysAt as u64, KEY_FILE_STS as u64],
    ]) {
        if (file[0] == 0) { continue; }
        let path = Process.argument(file[0] as usize) ?? "";
        let kind = truncate<u8>(file[1]);
        let sets =
            if (kind == KEY_FILE_SSE) sseSets.clone()
                else if (kind == KEY_FILE_KMS) kmsSets.clone()
                else stsSets.clone();
        let added = rotation.keyFiles.push(KeyRotation {
            sets: sets,
            path: textOf(path),
            kind: kind,
            modified: Fs.modifiedMillis(path).ok() ?? 0,
            failed: 0,
            waiting: 0,
            askAtMs: 0,
            askEveryMs: 0,
        });
        if (added.isErr()) { die("out of memory"); }
    }
    var roles = Vector<StsRole>.create();
    if (rolesAt != 0) {
        let text = match (readSmallFile(Process.argument(rolesAt) ?? "", "roles file")) {
            Ok(t) => t,
            Err(message) => { die(message.view()); }
        };
        roles = match (parseRolesFile(text.view())) {
            Ok(r) => r,
            Err(fault) => {
                die(match (fault) {
                    RolesFault.BadLine => "a line of the roles file is not `<name> <max seconds> <policy JSON>`",
                    RolesFault.BadName => "a role name of the roles file is not 1 to 64 of A-Z a-z 0-9 +=,.@_-",
                    RolesFault.BadSeconds => "a role's max session seconds is not 900 to 43200",
                    RolesFault.BadPolicy => "a role's policy is not an identity policy CosmoStore takes",
                    RolesFault.Duplicate => "two roles of the roles file have one name",
                    RolesFault.OutOfMemory => "out of memory",
                });
            }
        };
        if (stsKeysAt == 0) { die("--roles-file needs --sts-key-file"); }
    }
    // The roles, shared by the S3 server and the writers, reloaded with their places (ADR-0096 §1).
    let roleSets = match (RoleSets.create(roles)) {
        Ok(sets) => match (Arc<RoleSets>.create(sets)) {
            Ok(a) => a,
            Err(_) => { die("out of memory"); }
        },
        Err(_) => { die("out of memory"); }
    };
    // The roles file, reloaded with the credentials (ADR-0096 §1).
    // Always, so the API's roles are merged in without a roles file too (ADR-0104 §4); its path empty then.
    let rolesPath = if (rolesAt != 0) Process.argument(rolesAt) ?? "" else "";
    rotation.roles = Some(RoleRotation {
        sets: roleSets.clone(),
        path: textOf(rolesPath),
        modified: if (rolesPath.length == 0) 0 else Fs.modifiedMillis(rolesPath).ok() ?? 0,
        failed: 0,
        iamGeneration: 0,
    });
    // The writers decide a configuration's writes as its requester (ADR-0094 §3), with the credentials as reloaded.
    auditWriter.decider = RecordedDecider {
        credentials: Some(credentials.clone()),
        roles: Some(roleSets.clone()),
        secure: certAt > 0,
    };
    // TLS before the store opens, so a bad certificate costs no recovery.
    var tls: TlsConfig? = null;
    if (certAt > 0) {
        tls = match (tlsConfig(Process.argument(certAt) ?? "", Process.argument(keyAt) ?? "")) {
            Ok(c) => c,
            Err(message) => { die(message.view()); }
        };
    }
    let store = match (ObjectStore.open(dir, storeConfig)) {
        Ok(s) => s,
        Err(e) => { die(describe(e)); }
    };
    // A `--table-s3` bucket S3 made before M9 is no table bucket: the server does not start (ADR-0084 §5).
    match (legacyTableBucket(borrow store)) {
        Ok(Some(name)) => {
            match (legacyTableBucketMessage(name.view())) {
                Ok(m) => { die(m.view()); }
                Err(_) => { die("out of memory"); }
            }
        }
        Ok(null) => {}
        Err(e) => { die(describe(e)); }
    }
    let writers = match (store.writerFactory()) {
        Ok(w) => w,
        Err(_) => { die("out of memory"); }
    };
    // The policy counts of ADR-0043 §8, before the first request.
    let policies = match (store.bucketPolicies()) {
        Ok(p) => countPolicies(borrow p, credentials.get().view()),
        Err(_) => { die("out of memory"); }
    };
    let corsBuckets = store.corsBucketCount();
    let loggingBuckets = store.loggingBucketCount();
    let accessPointBuckets = store.accessPointBucketCount();
    let replicationBuckets = store.replicationBucketCount();
    let encryptedBuckets = store.encryptedBucketCount();
    let locked = match (AsyncMutex<ObjectStore>.create(store)) {
        Ok(m) => m,
        Err(_) => { die("out of memory"); }
    };
    let shared = match (Arc<AsyncMutex<ObjectStore>>.create(locked)) {
        Ok(a) => a,
        Err(_) => { die("out of memory"); }
    };
    let maintenance = shared.clone();
    let turn = match (AsyncMutex<u8>.create(0)) {
        Ok(m) => m,
        Err(_) => { die("out of memory"); }
    };
    var barriers = Vector<AsyncMutex<u8>>.create();
    for (i in 0..BARRIERS) {
        match (AsyncMutex<u8>.create(0)) {
            Ok(m) => {
                match (barriers.push(m)) {
                    Ok() => {}
                    Err(_) => { die("out of memory"); }
                }
            }
            Err(_) => { die("out of memory"); }
        }
    }
    let latencies = match (Latencies.create()) {
        Ok(l) => l,
        Err(_) => { die("out of memory"); }
    };
    let bodyBuffers = match (Channel<Vector<u8>>.create(BODY_BUFFERS)) {
        Ok(c) => c,
        Err(_) => { die("out of memory"); }
    };
    let app = S3App {
        askedRuns: null,
        tablesCounts: match (AsyncMutex<Vector<TablesCount>>.create(Vector<TablesCount>.create())) {
            Ok(m) => m,
            Err(_) => { die("out of memory"); }
        },
        store: shared,
        credentials: credentials,
        requests: AtomicU64.create(0),
        domain: domain,
        websiteDomain: websiteDomain,
        zoneId: zoneId,
        tablesDayMs: tablesDaySeconds * 1000,
        restoreHourMs: restoreHourSeconds * 1000,
        commitTurn: turn,
        published: AtomicU64.create(0),
        syncing: AtomicBool.create(false),
        syncingBatch: AtomicU64.create(0),
        syncingLast: AtomicU64.create(0),
        barriers: barriers,
        leading: AtomicBool.create(false),
        leadingBatch: AtomicU64.create(0),
        writers: writers,
        latencies: latencies,
        bodyBuffers: bodyBuffers,
        policyBuckets: AtomicU64.create(policies.policies),
        denyBuckets: AtomicU64.create(policies.denies),
        secure: tls.isSome(),
        notifyTargets: notifyTargets.clone(),
        sseKeys: sseSets.clone(),
        stsKeys: stsSets.clone(),
        replicationTargets: auditWriter.replication.targets.clone(),
        roles: roleSets.clone(),
        kmsKeys: kmsSets.clone(),
        corsBuckets: AtomicU64.create(corsBuckets),
        accessLog: Some(AccessLog { lines: accessLines, dropped: AtomicU64.create(0) }),
        loggingBuckets: AtomicU64.create(loggingBuckets),
        accessPointBuckets: AtomicU64.create(accessPointBuckets),
        replicationBuckets: AtomicU64.create(replicationBuckets),
        encryptedBuckets: AtomicU64.create(encryptedBuckets),
        audit: if (auditAt != 0) Some(AuditLog { lines: auditLines, dropped: AtomicU64.create(0) }) else null,
        rates: match (RateLimiter.create(perAddress, perKey)) {
            Ok(r) => r,
            Err(_) => { die("out of memory"); }
        },
        cluster: false,
    };
    let server = match (s3Server(app)) {
        Ok(s) => s,
        Err(_) => { die("cannot build the routes"); }
    };
    let result = match (tls) {
        Some(config) => {
            let acceptor = match (TlsAcceptor.create(config)) {
                Ok(a) => a,
                Err(_) => { die("TLS: the acceptor could not be made"); }
            };
            var watch = certWatch(Process.argument(certAt) ?? "", Process.argument(keyAt) ?? "");
            Async.run(serveTls(
                server,
                address,
                borrow acceptor,
                mut watch,
                borrow maintenance,
                everyMs,
                borrow notifyTargets,
                mut rotation,
                borrow auditWriter,
            ))
        }
        null => {
            Async.run(servePlain(
                server,
                address,
                borrow maintenance,
                everyMs,
                borrow notifyTargets,
                mut rotation,
                borrow auditWriter,
            ))
        }
    };
    match (result) {
        Ok(_) => { return 0; }
        Err(e) => {
            Console.writeErrorLine(NetErrors.describe(e));
            return 1;
        }
    }
}
