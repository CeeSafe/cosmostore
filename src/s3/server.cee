// The S3 server (ADR-0008): one handler for every path, which authenticates the request and dispatches it to the
// bucket and object operations. Store calls run under the store's AsyncMutex, inside `Async.blocking`; bodies move
// without the lock.
import web_core;
import web_transport;
import web_http;
import web_server;

/// The largest object a single PUT may carry (S3's limit).
const MAX_PUT_BYTES: u64 = 5368709120;
/// Body bytes read and written per step.
const BODY_STEP: usize = 1048576;
/// Room beyond the declared size in a body buffer: aws-chunked framing, and a read of the end of the stream. Small,
/// because a small body's buffer is zeroed for each request: with 16 KiB, a 4 KiB PUT zeroed 20 KiB, about 13% of the
/// event loop's time at concurrency 128 (ADR-0035). Framing beyond it takes another read.
const BODY_SLACK: usize = 1024;
/// Full-size body buffers kept for reuse (ADR-0034, ADR-0036). A miss allocates a fresh 1 MiB block and faults its
/// pages in: with 4, most 1 MiB GETs at concurrency 32 missed, about 15% of the event loop's time. 32 keeps up to
/// 32 MiB, and the server's idle RSS after such a load is about 220 MiB instead of 100.
const BODY_BUFFERS: usize = 32;
const S3_XMLNS: StringView = "http://s3.amazonaws.com/doc/2006-03-01/";

struct S3App {
    /// Shared with the maintenance task (ADR-0017).
    store: Arc<AsyncMutex<ObjectStore>>;
    /// The credentials file's keys, replaced when the file changes (ADR-0050); shared with the upkeep, which
    /// reloads them.
    credentials: Arc<CredentialSets>;
    requests: AtomicU64;
    /// With virtual-host addressing, the domain under which `<bucket>.<domain>` names a bucket (empty: path-style
    /// only). ADR-0011.
    domain: Vector<u8>;
    /// The commit turn of group commit (ADR-0022): its holder is the leader that syncs the journal.
    commitTurn: AsyncMutex<u8>;
    /// Every record with a lower LSN is published, as the last leader saw it: followers check it without the
    /// store's lock. It may lag the store (other commits publish too), never lead it.
    published: AtomicU64;
    /// The batch a leader is syncing (ADR-0022): whether there is one, its number and last LSN.
    syncing: AtomicBool;
    syncingBatch: AtomicU64;
    syncingLast: AtomicU64;
    /// Batch barriers, BARRIERS of them used in turn: a leader holds its batch's while it syncs.
    barriers: Vector<AsyncMutex<u8>>;
    /// Whether a leader holds the commit turn and its batch's barrier, and that batch's number: a request staged
    /// meanwhile waits on that barrier, not in the turn's queue (ADR-0031).
    leading: AtomicBool;
    leadingBatch: AtomicU64;
    /// Full-size body buffers for reuse (ADR-0034).
    bodyBuffers: Channel<Vector<u8>>;
    /// Request latencies by class, for the stats endpoint (ADR-0033).
    latencies: Latencies;
    /// The store's writers without its lock: an inline-sized PUT starts with no lock round (ADR-0032).
    writers: WriterFactory;
    /// Buckets with a policy, and those whose policy has a Deny (ADR-0043 §8): while the second is 0, no key's request
    /// reads one. An anonymous request always reads its bucket's policy and ACL (ADR-0045 §6).
    policyBuckets: AtomicU64;
    denyBuckets: AtomicU64;
    /// Whether the server listens with TLS: `aws:SecureTransport` (ADR-0043 §6).
    secure: bool;
    /// The request rate limits (`serve --rate-limit-address`, `--rate-limit-key`, ADR-0053).
    rates: RateLimiter;
    /// The audit log's queue (`serve --audit-log`, ADR-0051); null without one.
    audit: AuditLog?;
    /// Buckets with CORS rules (ADR-0049 §4): while 0, a request's `Origin` is not looked at.
    corsBuckets: AtomicU64;
    /// The webhooks notification rules may name (`serve --notify-targets`, ADR-0048).
    notifyTargets: Vector<NotifyTarget>;
}

/// The buffer for moving a body of `expected` bytes: at most BODY_STEP, and no larger than the body and some slack
/// for aws-chunked framing. A small request must not pay for zeroing a 1 MiB buffer (ADR-0022).
fn bodyStep(expected: u64) -> usize {
    let wanted = expected + BODY_SLACK as u64;
    return if (wanted < BODY_STEP as u64) truncate<usize>(wanted) else BODY_STEP;
}

/// A buffer of `bodyStep(expected)` bytes. A full-size one comes from the pool when it has one (ADR-0034): it is
/// not zeroed and holds an earlier body's bytes, so a caller uses only the part a read has just filled.
fn takeBodyBuffer(app: borrow S3App, expected: u64) -> Result<Vector<u8>, AllocError> {
    let size = bodyStep(expected);
    if (size == BODY_STEP) {
        match (app.bodyBuffers.tryRecv()) {
            Some(b) => { return Ok(b); }
            null => {}
        }
    }
    var b = Vector<u8>.create();
    b.resize(size, 0)?;
    return Ok(b);
}

/// Returns a buffer from `takeBodyBuffer`: a full-size one to the pool, unless it is full.
fn giveBodyBuffer(app: borrow S3App, b: Vector<u8>) {
    if (b.length == BODY_STEP) { let _ = app.bodyBuffers.trySend(b); }
}

fn statusOf(code: u16) -> StatusCode => StatusCode.of(code) ?? Status.internalServerError();

/// Takes the store's lock; the guard releases it when dropped.
async fn lockStore(app: borrow S3App) -> Result<AsyncMutexGuard<ObjectStore>, S3Fail> {
    match (await app.store.get().lock()) {
        Ok(g) => { return Ok(g); }
        Err(_) => { return Err(S3Fail.Code(S3Code.ServiceUnavailable)); }
    }
}

/// The S3 failure of a store error. Server-side failures (5xx) are logged by the handler.
fn storeFail(e: StoreError, keyLength: usize) -> S3Fail => S3Fail.Code(codeOfStore(e, keyLength));

struct S3Handler {}

impl Handler<S3App> for S3Handler {
    async fn handle(
        borrow this,
        ctx: borrow mut RequestContext<S3App>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        let app = ctx.state();
        let id = app.requests.fetchAdd(1) + 1;
        var requestId = Vector<u8>.create();
        let idBytes = crc64Bytes(id);
        match (appendHexBytes(mut requestId, idBytes[..])) {
            Ok() => {}
            Err(_) => { return Err(HandlerError.Internal); }
        }
        exchange.header("x-amz-request-id", requestId.view())?;
        exchange.header("server", "CosmoStore".bytes())?;
        // Timed to the last byte of the response, an error's included (ADR-0033).
        let started = Clock.monotonicNanos();
        var kind = LATENCY_OTHER;
        let peer = ctx.connection().peerAddress();
        var facts = AuditFacts { requester: Vector<u8>.create(), code: null, aborted: false };
        let done = await respond(app, request, exchange, mut kind, requestId.view(), peer, mut facts);
        let micros = (Clock.monotonicNanos() - started) / 1000;
        app.latencies.record(kind, micros);
        // The request's line for the audit log (ADR-0051), after its response: queued, or dropped and counted if
        // the queue is full.
        match (borrow app.audit) {
            Some(audit) => {
                var line = Vector<u8>.create();
                let query = match (request.query()) {
                    Some(q) => q.bytes(),
                    null => "".bytes(),
                };
                let made = auditLine(
                    mut line,
                    Clock.unixMillis(),
                    requestId.view(),
                    peer,
                    borrow facts,
                    request.methodToken(),
                    request.path().bytes(),
                    query,
                    micros,
                );
                if (made.isErr() || audit.lines.trySend(line).isErr()) { let _ = audit.dropped.fetchAdd(1); }
            }
            null => {}
        }
        return done;
    }
}

/// The response to one request, and its latency class (`kind`).
async fn respond(
    app: borrow S3App,
    request: borrow Request,
    exchange: borrow mut Exchange,
    kind: borrow mut u8,
    requestId: Slice<u8>,
    peer: SocketAddress?,
    facts: borrow mut AuditFacts,
) -> Result<void, HandlerError> {
    {
        match (await serveS3(app, request, exchange, kind, peer, facts)) {
            Ok() => { return Ok(); }
            Err(S3Fail.Http(e)) => {
                facts.aborted = true;
                return Err(e);
            }
            Err(S3Fail.Code(code)) => {
                facts.code = code;
                if (s3Status(code) >= 500) {
                    // Standard error is unbuffered, so the line survives a crash (CEESAFE_GAPS G25).
                    let _ = await AsyncConsole.writeError("cosmostore: ");
                    let _ = await AsyncConsole.writeError(s3CodeName(code));
                    let _ = await AsyncConsole.writeError(" on ");
                    let _ = await AsyncConsole.writeError(request.path());
                    let _ = await AsyncConsole.writeError("\n");
                }
                return await sendError(exchange, code, request.path().bytes(), requestId);
            }
            Err(S3Fail.OutOfMemory(_)) => {
                facts.code = S3Code.InternalError;
                return await sendError(exchange, S3Code.InternalError, request.path().bytes(), requestId);
            }
        }
    }
}

/// S3's XML error response; after the head was sent, the connection is closed instead.
async fn sendError(
    exchange: borrow mut Exchange,
    code: S3Code,
    resource: Slice<u8>,
    requestId: Slice<u8>,
) -> Result<void, HandlerError> {
    if (exchange.headSent()) {
        exchange.closeConnection();
        return Err(HandlerError.Internal);
    }
    let status = s3Status(code);
    if (status == 304) { return await exchange.send(statusOf(304), "".bytes()); }
    var body = Vector<u8>.create();
    match (errorXml(mut body, code, resource, requestId)) {
        Ok() => {}
        Err(_) => { return Err(HandlerError.Internal); }
    }
    exchange.header("content-type", "application/xml".bytes())?;
    return await exchange.send(statusOf(status), body.view());
}

fn errorXml(
    out: borrow mut Vector<u8>,
    code: S3Code,
    resource: Slice<u8>,
    requestId: Slice<u8>,
) -> Result<void, AllocError> {
    out.extend("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Error><Code>".bytes())?;
    out.extend(s3CodeName(code).bytes())?;
    out.extend("</Code><Message>".bytes())?;
    appendXmlEscaped(out, s3Message(code).bytes())?;
    out.extend("</Message><Resource>".bytes())?;
    appendXmlEscaped(out, resource)?;
    out.extend("</Resource><RequestId>".bytes())?;
    out.extend(requestId)?;
    out.extend("</RequestId></Error>".bytes())?;
    return Ok();
}

async fn sendXml(exchange: borrow mut Exchange, body: borrow Vector<u8>) -> Result<void, S3Fail> {
    exchange.header("content-type", "application/xml".bytes())?;
    await exchange.send(Status.ok(), body.view())?;
    return Ok();
}

fn isMethod(m: Method, want: Method) -> bool => Methods.same(m, want);

/// Authenticates and dispatches one request; each call is first checked against its bucket's policy (ADR-0043).
async fn serveS3(
    app: borrow S3App,
    request: borrow Request,
    exchange: borrow mut Exchange,
    kind: borrow mut u8,
    peer: SocketAddress?,
    facts: borrow mut AuditFacts,
) -> Result<void, S3Fail> {
    facts.requester.push('-')?;
    // The address's rate limit first (ADR-0053): before anything is parsed or a signature is checked.
    let second = truncate<u64>(Clock.unixMillis() / 1000);
    if (!app.rates.admitAddress(peer, second)) { return Err(slowDown(exchange)); }
    let req = S3Request.of(request, app.domain.view())?;
    kind = latencyClass(borrow req);
    // CORS (ADR-0049): a preflight is answered here, unsigned; a request that names its origin gets a matching
    // rule's fields on whatever its answer is.
    if (isMethod(req.method, Method.Options)) { return await preflight(app, borrow req, exchange); }
    if (app.corsBuckets.load() > 0 && req.bucket.length > 0) {
        match (headerOf(borrow req, "origin")) {
            Some(origin) => { await corsAnswer(app, borrow req, trimBlank(origin), exchange)?; }
            null => {}
        }
    }
    // A browser form upload is authenticated by its form's policy signature, not its headers (ADR-0018).
    if (isPostObject(borrow req)) { return await postObject(app, borrow req, exchange, peer); }
    let now = Clock.unixMillis() / 1000;
    let attempt = if (req.isAnonymous()) req.anonymous() else req.authenticate(app.credentials.get().view(), now);
    let auth = match (attempt) {
        Ok(a) => a,
        Err(code) => { return Err(S3Fail.Code(code)); }
    };
    // Encryption waits for a cipher (ADR-0046 §7): refused, not ignored, so nothing asked to be sealed is stored
    // in the clear.
    if (asksEncryption(borrow req)) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
    // The key's rate limit, once it is known whose request it is (ADR-0053).
    match (auth.key) {
        Some(place) => {
            if (!app.rates.admitKey(place, second)) { return Err(slowDown(exchange)); }
        }
        null => {}
    }
    let who = Requester { key: auth.key, peer: peer };
    // Who the request is, for its line in the audit log (ADR-0051).
    if (app.audit.isSome()) {
        facts.requester.clear();
        let credentials = app.credentials.get().view();
        match (auth.key) {
            Some(i) => { facts.requester.extend(credentials[i].accessKey.view())?; }
            null => { facts.requester.extend("anonymous".bytes())?; }
        }
    }
    let m = req.method;
    let bucket = req.bucket.view();
    let none = "".bytes();
    // The service, the stats endpoint and new buckets have no bucket policy: keys only.
    if (who.key.isNull() && (req.bucket.length == 0 || bucket == STATS_BUCKET ||
        (isMethod(m, Method.Put) && req.key.length == 0 && req.query.length == 0))) {
        return Err(S3Fail.Code(S3Code.AccessDenied));
    }
    if (bucket == STATS_BUCKET) { return await serveStats(app, borrow req, exchange); } // ADR-0021
    if (req.bucket.length == 0) {
        if (isMethod(m, Method.Get) || isMethod(m, Method.Head)) {
            if (!req.onlyParams("max-buckets,continuation-token,prefix")) {
                return Err(S3Fail.Code(S3Code.NotImplemented));
            }
            return await listBuckets(app, borrow req, exchange);
        }
        return Err(S3Fail.Code(S3Code.MethodNotAllowed));
    }
    if (req.key.length == 0) {
        // A bucket's policy (ADR-0043).
        if (req.hasParam("policy")) {
            if (!req.onlyParams("policy")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            if (isMethod(m, Method.Get)) {
                await authorize(app, borrow req, borrow who, "s3:GetBucketPolicy", bucket, none)?;
                return await getBucketPolicy(app, borrow req, exchange);
            }
            if (isMethod(m, Method.Put)) {
                await authorize(app, borrow req, borrow who, "s3:PutBucketPolicy", bucket, none)?;
                return await putBucketPolicy(app, borrow req, auth, exchange);
            }
            if (isMethod(m, Method.Delete)) {
                await authorize(app, borrow req, borrow who, "s3:DeleteBucketPolicy", bucket, none)?;
                return await deleteBucketPolicy(app, borrow req, exchange);
            }
            return Err(S3Fail.Code(S3Code.MethodNotAllowed));
        }
        // A bucket's quota (ADR-0052): not an S3 call; keys only unless a policy says otherwise.
        if (req.hasParam("quota")) {
            if (!req.onlyParams("quota")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            if (isMethod(m, Method.Get)) {
                await authorize(app, borrow req, borrow who, "s3:GetBucketQuota", bucket, none)?;
                return await getBucketQuota(app, borrow req, exchange);
            }
            if (isMethod(m, Method.Put)) {
                await authorize(app, borrow req, borrow who, "s3:PutBucketQuota", bucket, none)?;
                return await putBucketQuota(app, borrow req, auth, exchange);
            }
            if (isMethod(m, Method.Delete)) {
                await authorize(app, borrow req, borrow who, "s3:PutBucketQuota", bucket, none)?;
                return await deleteBucketQuota(app, borrow req, exchange);
            }
            return Err(S3Fail.Code(S3Code.MethodNotAllowed));
        }
        // A bucket's CORS rules (ADR-0049).
        if (req.hasParam("cors")) {
            if (!req.onlyParams("cors")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            if (isMethod(m, Method.Get)) {
                await authorize(app, borrow req, borrow who, "s3:GetBucketCORS", bucket, none)?;
                return await getBucketCors(app, borrow req, exchange);
            }
            if (isMethod(m, Method.Put)) {
                await authorize(app, borrow req, borrow who, "s3:PutBucketCORS", bucket, none)?;
                return await putBucketCors(app, borrow req, auth, exchange);
            }
            if (isMethod(m, Method.Delete)) {
                await authorize(app, borrow req, borrow who, "s3:PutBucketCORS", bucket, none)?;
                return await deleteBucketCors(app, borrow req, exchange);
            }
            return Err(S3Fail.Code(S3Code.MethodNotAllowed));
        }
        // A bucket's notification configuration (ADR-0048).
        if (req.hasParam("notification")) {
            if (!req.onlyParams("notification")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            if (isMethod(m, Method.Get)) {
                await authorize(app, borrow req, borrow who, "s3:GetBucketNotification", bucket, none)?;
                return await getBucketNotification(app, borrow req, exchange);
            }
            if (isMethod(m, Method.Put)) {
                await authorize(app, borrow req, borrow who, "s3:PutBucketNotification", bucket, none)?;
                return await putBucketNotification(app, borrow req, auth, exchange);
            }
            return Err(S3Fail.Code(S3Code.MethodNotAllowed));
        }
        // A bucket's object lock configuration (ADR-0047).
        if (req.hasParam("object-lock")) {
            if (!req.onlyParams("object-lock")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            if (isMethod(m, Method.Get)) {
                await authorize(app, borrow req, borrow who, "s3:GetBucketObjectLockConfiguration", bucket, none)?;
                return await getObjectLockConfiguration(app, borrow req, exchange);
            }
            if (isMethod(m, Method.Put)) {
                await authorize(app, borrow req, borrow who, "s3:PutBucketObjectLockConfiguration", bucket, none)?;
                return await putObjectLockConfiguration(app, borrow req, auth, exchange);
            }
            return Err(S3Fail.Code(S3Code.MethodNotAllowed));
        }
        // A bucket's ACL (ADR-0045).
        if (req.hasParam("acl")) {
            if (!req.onlyParams("acl")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            if (isMethod(m, Method.Get)) {
                await authorize(app, borrow req, borrow who, "s3:GetBucketAcl", bucket, none)?;
                return await getBucketAcl(app, borrow req, exchange);
            }
            if (isMethod(m, Method.Put)) {
                await authorize(app, borrow req, borrow who, "s3:PutBucketAcl", bucket, none)?;
                return await putBucketAcl(app, borrow req, auth, exchange);
            }
            return Err(S3Fail.Code(S3Code.MethodNotAllowed));
        }
        // Whether its policy is public, and its public-access block (ADR-0044).
        if (req.hasParam("policyStatus")) {
            if (!req.onlyParams("policyStatus")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            if (!isMethod(m, Method.Get)) { return Err(S3Fail.Code(S3Code.MethodNotAllowed)); }
            await authorize(app, borrow req, borrow who, "s3:GetBucketPolicyStatus", bucket, none)?;
            return await getBucketPolicyStatus(app, borrow req, exchange);
        }
        if (req.hasParam("publicAccessBlock")) {
            if (!req.onlyParams("publicAccessBlock")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            if (isMethod(m, Method.Get)) {
                await authorize(app, borrow req, borrow who, "s3:GetBucketPublicAccessBlock", bucket, none)?;
                return await getPublicAccessBlock(app, borrow req, exchange);
            }
            if (isMethod(m, Method.Put)) {
                await authorize(app, borrow req, borrow who, "s3:PutBucketPublicAccessBlock", bucket, none)?;
                return await putPublicAccessBlock(app, borrow req, auth, exchange);
            }
            if (isMethod(m, Method.Delete)) {
                await authorize(app, borrow req, borrow who, "s3:PutBucketPublicAccessBlock", bucket, none)?;
                return await deletePublicAccessBlock(app, borrow req, exchange);
            }
            return Err(S3Fail.Code(S3Code.MethodNotAllowed));
        }
        // A bucket's tags and lifecycle rules (ADR-0020).
        if (req.hasParam("tagging") || req.hasParam("lifecycle")) {
            let tagging = req.hasParam("tagging");
            if (!req.onlyParams(if (tagging) "tagging" else "lifecycle")) {
                return Err(S3Fail.Code(S3Code.NotImplemented));
            }
            let reads = isMethod(m, Method.Get);
            let action = if (tagging) {
                if (reads) "s3:GetBucketTagging" else "s3:PutBucketTagging"
            } else {
                if (reads) "s3:GetLifecycleConfiguration" else "s3:PutLifecycleConfiguration"
            };
            if (isMethod(m, Method.Get) || isMethod(m, Method.Put) || isMethod(m, Method.Delete)) {
                await authorize(app, borrow req, borrow who, action, bucket, none)?;
            }
            if (isMethod(m, Method.Get)) {
                if (tagging) { return await getBucketTagging(app, borrow req, exchange); }
                return await getBucketLifecycle(app, borrow req, exchange);
            }
            if (isMethod(m, Method.Put)) {
                if (tagging) { return await putBucketTagging(app, borrow req, auth, exchange); }
                return await putBucketLifecycle(app, borrow req, auth, exchange);
            }
            if (isMethod(m, Method.Delete)) {
                if (tagging) { return await deleteBucketTagging(app, borrow req, exchange); }
                return await deleteBucketLifecycle(app, borrow req, exchange);
            }
            return Err(S3Fail.Code(S3Code.MethodNotAllowed));
        }
        if (isMethod(m, Method.Put)) {
            if (req.hasParam("versioning")) {
                if (!req.onlyParams("versioning")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
                await authorize(app, borrow req, borrow who, "s3:PutBucketVersioning", bucket, none)?;
                return await putBucketVersioning(app, borrow req, auth, exchange);
            }
            if (!req.onlyParams("")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            return await createBucket(app, borrow req, exchange);
        }
        if (isMethod(m, Method.Head)) {
            await authorize(app, borrow req, borrow who, "s3:ListBucket", bucket, none)?;
            return await headBucket(app, borrow req, exchange);
        }
        if (isMethod(m, Method.Delete)) {
            if (!req.onlyParams("")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            await authorize(app, borrow req, borrow who, "s3:DeleteBucket", bucket, none)?;
            return await deleteBucket(app, borrow req, exchange);
        }
        if (isMethod(m, Method.Get)) {
            if (req.hasParam("location")) {
                if (!req.onlyParams("location")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
                await authorize(app, borrow req, borrow who, "s3:GetBucketLocation", bucket, none)?;
                return await bucketLocation(app, borrow req, exchange);
            }
            if (req.hasParam("versions")) {
                if (!req.onlyParams("versions,prefix,delimiter,key-marker,version-id-marker,max-keys,encoding-type")) {
                    return Err(S3Fail.Code(S3Code.NotImplemented));
                }
                await authorize(app, borrow req, borrow who, "s3:ListBucketVersions", bucket, none)?;
                return await listObjectVersions(app, borrow req, exchange);
            }
            if (req.hasParam("versioning")) {
                if (!req.onlyParams("versioning")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
                await authorize(app, borrow req, borrow who, "s3:GetBucketVersioning", bucket, none)?;
                return await getBucketVersioning(app, borrow req, exchange);
            }
            if (req.hasParam("uploads")) {
                if (!req.onlyParams("uploads,prefix,delimiter,key-marker,upload-id-marker,max-uploads,encoding-type")) {
                    return Err(S3Fail.Code(S3Code.NotImplemented));
                }
                await authorize(app, borrow req, borrow who, "s3:ListBucketMultipartUploads", bucket, none)?;
                return await listMultipartUploads(app, borrow req, exchange);
            }
            if (!req.onlyParams(
                "list-type,prefix,delimiter,max-keys,marker,start-after,continuation-token,encoding-type,fetch-owner",
            )) {
                return Err(S3Fail.Code(S3Code.NotImplemented));
            }
            await authorize(app, borrow req, borrow who, "s3:ListBucket", bucket, none)?;
            return await listObjects(app, borrow req, exchange);
        }
        if (isMethod(m, Method.Post)) {
            // Each key is checked against the policy with its own action (ADR-0043 §5).
            if (req.hasParam("delete") && req.onlyParams("delete")) {
                return await deleteObjects(app, borrow req, auth, borrow who, exchange);
            }
            return Err(S3Fail.Code(S3Code.NotImplemented));
        }
        return Err(S3Fail.Code(S3Code.MethodNotAllowed));
    }
    if (req.key.length > MAX_KEY_BYTES) { return Err(S3Fail.Code(S3Code.KeyTooLongError)); }
    // A version's retention and legal hold (ADR-0047).
    if (req.hasParam("retention")) {
        if (!req.onlyParams("retention,versionId")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
        if (isMethod(m, Method.Get)) {
            await authorizeObject(app, borrow req, borrow who, "s3:GetObjectRetention", "s3:GetObjectRetention")?;
            return await getObjectRetention(app, borrow req, exchange);
        }
        if (isMethod(m, Method.Put)) {
            await authorizeObject(app, borrow req, borrow who, "s3:PutObjectRetention", "s3:PutObjectRetention")?;
            let bypass = await governanceBypass(app, borrow req, borrow who)?;
            return await putObjectRetention(app, borrow req, auth, bypass, exchange);
        }
        return Err(S3Fail.Code(S3Code.MethodNotAllowed));
    }
    if (req.hasParam("legal-hold")) {
        if (!req.onlyParams("legal-hold,versionId")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
        if (isMethod(m, Method.Get)) {
            await authorizeObject(app, borrow req, borrow who, "s3:GetObjectLegalHold", "s3:GetObjectLegalHold")?;
            return await getObjectLegalHold(app, borrow req, exchange);
        }
        if (isMethod(m, Method.Put)) {
            await authorizeObject(app, borrow req, borrow who, "s3:PutObjectLegalHold", "s3:PutObjectLegalHold")?;
            return await putObjectLegalHold(app, borrow req, auth, exchange);
        }
        return Err(S3Fail.Code(S3Code.MethodNotAllowed));
    }
    // An object's ACL (ADR-0045).
    if (req.hasParam("acl")) {
        if (!req.onlyParams("acl,versionId")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
        if (isMethod(m, Method.Get)) {
            await authorizeObject(app, borrow req, borrow who, "s3:GetObjectAcl", "s3:GetObjectVersionAcl")?;
            return await getObjectAcl(app, borrow req, exchange);
        }
        if (isMethod(m, Method.Put)) {
            await authorizeObject(app, borrow req, borrow who, "s3:PutObjectAcl", "s3:PutObjectVersionAcl")?;
            return await putObjectAcl(app, borrow req, auth, exchange);
        }
        return Err(S3Fail.Code(S3Code.MethodNotAllowed));
    }
    if (req.hasParam("tagging")) {
        if (!req.onlyParams("tagging,versionId")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
        if (isMethod(m, Method.Get)) {
            await authorizeObject(app, borrow req, borrow who, "s3:GetObjectTagging", "s3:GetObjectVersionTagging")?;
            return await getObjectTagging(app, borrow req, exchange);
        }
        if (isMethod(m, Method.Put)) {
            await authorizeObject(app, borrow req, borrow who, "s3:PutObjectTagging", "s3:PutObjectVersionTagging")?;
            return await putObjectTagging(app, borrow req, auth, exchange);
        }
        if (isMethod(m, Method.Delete)) {
            await authorizeObject(
                app,
                borrow req,
                borrow who,
                "s3:DeleteObjectTagging",
                "s3:DeleteObjectVersionTagging",
            )?;
            return await deleteObjectTagging(app, borrow req, exchange);
        }
        return Err(S3Fail.Code(S3Code.MethodNotAllowed));
    }
    if (isMethod(m, Method.Put)) {
        let copying = headerOf(borrow req, "x-amz-copy-source").isSome();
        if (req.hasParam("uploadId") || req.hasParam("partNumber")) {
            if (!req.onlyParams("partNumber,uploadId")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            await authorizeObject(app, borrow req, borrow who, "s3:PutObject", "s3:PutObject")?;
            if (copying) { return await uploadPartCopy(app, borrow req, borrow who, exchange); }
            return await uploadPart(app, borrow req, auth, exchange);
        }
        if (!req.onlyParams("")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
        await authorizeObject(app, borrow req, borrow who, "s3:PutObject", "s3:PutObject")?;
        if (copying) { return await copyObject(app, borrow req, borrow who, exchange); }
        return await putObject(app, borrow req, auth, exchange);
    }
    if (isMethod(m, Method.Get) && req.hasParam("attributes")) {
        if (!req.onlyParams("attributes,versionId")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
        await authorizeObject(
            app,
            borrow req,
            borrow who,
            "s3:GetObjectAttributes",
            "s3:GetObjectVersionAttributes",
        )?;
        return await getObjectAttributes(app, borrow req, exchange);
    }
    if (isMethod(m, Method.Get) && req.hasParam("uploadId")) {
        if (!req.onlyParams("uploadId,max-parts,part-number-marker,encoding-type")) {
            return Err(S3Fail.Code(S3Code.NotImplemented));
        }
        await authorizeObject(
            app,
            borrow req,
            borrow who,
            "s3:ListMultipartUploadParts",
            "s3:ListMultipartUploadParts",
        )?;
        return await listParts(app, borrow req, exchange);
    }
    if (isMethod(m, Method.Get) || isMethod(m, Method.Head)) {
        if (!req.onlyParams(
            "versionId,partNumber,response-content-type,response-content-language,response-expires,response-cache-control,response-content-disposition,response-content-encoding",
        )) {
            return Err(S3Fail.Code(S3Code.NotImplemented));
        }
        await authorizeObject(app, borrow req, borrow who, "s3:GetObject", "s3:GetObjectVersion")?;
        return await getObject(app, borrow req, exchange);
    }
    if (isMethod(m, Method.Delete)) {
        if (req.hasParam("uploadId")) {
            if (!req.onlyParams("uploadId")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            await authorizeObject(app, borrow req, borrow who, "s3:AbortMultipartUpload", "s3:AbortMultipartUpload")?;
            return await abortMultipartUpload(app, borrow req, exchange);
        }
        if (!req.onlyParams("versionId")) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
        await authorizeObject(app, borrow req, borrow who, "s3:DeleteObject", "s3:DeleteObjectVersion")?;
        // A version under governance retention goes only for a request that asks to bypass it and may
        // (ADR-0047 §4).
        let bypass = req.hasParam("versionId") && await governanceBypass(app, borrow req, borrow who)?;
        return await deleteObject(app, borrow req, bypass, exchange);
    }
    if (isMethod(m, Method.Post)) {
        if (req.hasParam("uploads") && req.onlyParams("uploads")) {
            await authorizeObject(app, borrow req, borrow who, "s3:PutObject", "s3:PutObject")?;
            return await createMultipartUpload(app, borrow req, exchange);
        }
        if (req.hasParam("uploadId") && req.onlyParams("uploadId")) {
            await authorizeObject(app, borrow req, borrow who, "s3:PutObject", "s3:PutObject")?;
            return await completeMultipartUpload(app, borrow req, auth, exchange);
        }
        return Err(S3Fail.Code(S3Code.NotImplemented));
    }
    return Err(S3Fail.Code(S3Code.MethodNotAllowed));
}

// ---- Service and buckets ----

/// ListBuckets, with S3's pagination: `max-buckets` (1 to 10,000), `continuation-token` (the previous page's last
/// name, base64), and `prefix`.
async fn listBuckets(app: borrow S3App, req: borrow S3Request, exchange: borrow mut Exchange) -> Result<void, S3Fail> {
    let all = await storeBucketList(app)?;
    let prefix = paramOf(req, "prefix") ?? "".bytes();
    var limit: usize = 10000;
    match (paramOf(req, "max-buckets")) {
        Some(t) => {
            match (parseDecimal(t)) {
                Some(v) => {
                    if (v < 1 || v > 10000) { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
                    limit = v as usize;
                }
                null => { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            }
        }
        null => {}
    }
    var after = Vector<u8>.create();
    match (paramOf(req, "continuation-token")) {
        Some(t) => {
            if (!decodeBase64(t, mut after)?) { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
        }
        null => {}
    }
    var buckets = Vector<BucketEntry>.create();
    var more = false;
    for (i in 0..all.length) {
        let name = all[i].name.view();
        if (!startsWithBytes(name, prefix)) { continue; }
        if (after.length > 0 && compareBytes(name, after.view()) <= 0) { continue; }
        if (buckets.length == limit) {
            more = true;
            break;
        }
        buckets.push(BucketEntry { name: copyBytes(name)?, createdMillis: all[i].createdMillis })?;
    }
    var body = Vector<u8>.create();
    body.extend("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ListAllMyBucketsResult xmlns=\"".bytes())?;
    body.extend(S3_XMLNS.bytes())?;
    body.extend("\"><Owner><ID>cosmostore</ID><DisplayName>cosmostore</DisplayName></Owner><Buckets>".bytes())?;
    for (i in 0..buckets.length) {
        body.extend("<Bucket><Name>".bytes())?;
        appendXmlEscaped(mut body, buckets[i].name.view())?;
        body.extend("</Name><CreationDate>".bytes())?;
        appendIso8601(mut body, buckets[i].createdMillis)?;
        body.extend("</CreationDate></Bucket>".bytes())?;
    }
    body.extend("</Buckets>".bytes())?;
    if (more) {
        var token = Vector<u8>.create();
        appendBase64(mut token, buckets[buckets.length - 1].name.view())?;
        xmlElement(mut body, "ContinuationToken", token.view(), false)?;
    }
    if (prefix.length > 0) { xmlElement(mut body, "Prefix", prefix, false)?; }
    body.extend("</ListAllMyBucketsResult>".bytes())?;
    return await sendXml(exchange, borrow body);
}

async fn storeBucketList(app: borrow S3App) -> Result<Vector<BucketEntry>, S3Fail> {
    var guard = await lockStore(app)?;
    let store = guard.data();
    return match (store.listBucketInfo()) { // memory only, as headObject (ADR-0023)
        Ok(v) => Ok(v),
        Err(e) => Err(storeFail(e, 0)),
    };
}

async fn createBucket(app: borrow S3App, req: borrow S3Request, exchange: borrow mut Exchange) -> Result<void, S3Fail> {
    // The ACL of the request's fields, checked before the bucket is made (ADR-0045 §3).
    let acl = storedAcl(requestAcl(req)? ?? privateAcl())?;
    // A bucket made with object lock has versioning enabled and the lock on (ADR-0047 §1).
    let locking = match (headerOf(req, "x-amz-bucket-object-lock-enabled")) {
        Some(v) => trimBlank(v) == "true".bytes() || trimBlank(v) == "True".bytes(),
        null => false,
    };
    {
        var guard = await lockStore(app)?;
        let store = guard.data();
        let name = req.bucket.view();
        match (await Async.blocking(() => store.createBucket(name))) {
            Ok() => {}
            Err(e) => { return Err(storeFail(e, 0)); }
        }
    }
    // A second record: a bucket made without it is private, which opens nothing.
    if (acl.length > 0) { await storeSetBucketConfig(app, req.bucket.view(), BUCKET_CONFIG_ACL, acl.view())?; }
    // Two more for a lock: a bucket made without them has no lock, and the request has failed.
    if (locking) {
        let enabled = [VERSIONING_ENABLED];
        await storeSetBucketConfig(app, req.bucket.view(), BUCKET_CONFIG_VERSIONING, enabled[..])?;
        await storeSetBucketConfig(app, req.bucket.view(), BUCKET_CONFIG_OBJECT_LOCK, "E".bytes())?;
    }
    var location = Vector<u8>.create();
    location.push('/')?;
    location.extend(req.bucket.view().bytes())?;
    exchange.header("location", location.view())?;
    await exchange.send(Status.ok(), "".bytes())?;
    return Ok();
}

async fn bucketExists(app: borrow S3App, name: StringView) -> Result<bool, S3Fail> {
    var guard = await lockStore(app)?;
    let store = guard.data();
    return match (store.bucketExists(name)) { // memory only (ADR-0023)
        Ok(v) => Ok(v),
        Err(e) => Err(storeFail(e, 0)),
    };
}

async fn headBucket(app: borrow S3App, req: borrow S3Request, exchange: borrow mut Exchange) -> Result<void, S3Fail> {
    if (!await bucketExists(app, req.bucket.view())?) { return Err(S3Fail.Code(S3Code.NoSuchBucket)); }
    exchange.header("x-amz-bucket-region", "us-east-1".bytes())?;
    await exchange.send(Status.ok(), "".bytes())?;
    return Ok();
}

async fn bucketLocation(
    app: borrow S3App,
    req: borrow S3Request,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    if (!await bucketExists(app, req.bucket.view())?) { return Err(S3Fail.Code(S3Code.NoSuchBucket)); }
    var body = Vector<u8>.create();
    body.extend("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<LocationConstraint xmlns=\"".bytes())?;
    body.extend(S3_XMLNS.bytes())?;
    body.extend("\"></LocationConstraint>".bytes())?;
    return await sendXml(exchange, borrow body);
}

async fn deleteBucket(app: borrow S3App, req: borrow S3Request, exchange: borrow mut Exchange) -> Result<void, S3Fail> {
    {
        var guard = await lockStore(app)?;
        let store = guard.data();
        let name = req.bucket.view();
        match (await Async.blocking(() => store.deleteBucket(name))) {
            Ok() => {}
            Err(e) => { return Err(storeFail(e, 0)); }
        }
    }
    // Its policy, if it had one, no longer counts (ADR-0043 §8).
    if (app.policyBuckets.load() > 0) { await recountPolicies(app)?; }
    if (app.corsBuckets.load() > 0) { await recountCors(app)?; }
    await exchange.send(Status.noContent(), "".bytes())?;
    return Ok();
}

// ---- Listing ----

/// ListObjects v1 and v2 (ADR-0008 §8).
async fn listObjects(app: borrow S3App, req: borrow S3Request, exchange: borrow mut Exchange) -> Result<void, S3Fail> {
    let v2 = match (paramOf(req, "list-type")) {
        Some(t) => {
            if (t != "2".bytes()) { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            true
        }
        null => false,
    };
    let prefix = utf8Param(req, "prefix")?;
    let delimiter = utf8Param(req, "delimiter")?;
    let urlEncoded = match (paramOf(req, "encoding-type")) {
        Some(t) => {
            if (t != "url".bytes()) { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            true
        }
        null => false,
    };
    var maxKeys: usize = 1000;
    match (paramOf(req, "max-keys")) {
        Some(t) => {
            match (parseDecimal(t)) {
                Some(v) => {
                    if (v < 1000) { maxKeys = v as usize; }
                }
                null => { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            }
        }
        null => {}
    }
    // Where the page starts: v2's continuation token (the previous page's last key or prefix, and which it was),
    // else start-after; v1's marker.
    var after = Vector<u8>.create();
    var afterIsPrefix = false;
    // An empty token is no token, though it is echoed back, as S3 does.
    let token = paramOf(req, "continuation-token");
    let tokenGiven = match (token) {
        Some(t) => t.length > 0,
        null => false,
    };
    if (v2) {
        match (if (tokenGiven) token else null) {
            Some(t) => {
                var raw = Vector<u8>.create();
                if (!decodeBase64(t, mut raw)? || raw.length == 0 || raw[0] > 1) {
                    return Err(S3Fail.Code(S3Code.InvalidArgument));
                }
                afterIsPrefix = raw[0] == 1;
                after.extend(raw.view()[1..])?;
            }
            null => {
                match (paramOf(req, "start-after")) {
                    Some(s) => { after.extend(s)?; }
                    null => {}
                }
            }
        }
    } else {
        match (paramOf(req, "marker")) {
            Some(s) => {
                after.extend(s)?;
                // A marker that is a common prefix (the previous page's NextMarker) skips everything under it.
                let d = delimiter.view().bytes();
                afterIsPrefix = d.length > 0 && s.length >= d.length && s[s.length - d.length..] == d &&
                    startsWithBytes(s, prefix.view().bytes());
            }
            null => {}
        }
    }
    let page = await listPage(
        app,
        req.bucket.view(),
        prefix.view(),
        delimiter.view(),
        borrow after,
        afterIsPrefix,
        maxKeys,
    )?;
    // max-keys=0 lists nothing and, as S3 answers, is not truncated.
    let truncated = page.truncated && maxKeys > 0;
    // fetch-owner in v2; v1 always has owners.
    let withOwner = !v2 || (paramOf(req, "fetch-owner") ?? "".bytes()) == "true".bytes();

    var body = Vector<u8>.create();
    body.extend("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ListBucketResult xmlns=\"".bytes())?;
    body.extend(S3_XMLNS.bytes())?;
    body.extend("\"><Name>".bytes())?;
    appendXmlEscaped(mut body, req.bucket.view().bytes())?;
    body.extend("</Name>".bytes())?;
    // v1 does not encode its own Prefix element (botocore decodes it only in v2).
    xmlElement(mut body, "Prefix", prefix.view().bytes(), urlEncoded && v2)?;
    if (delimiter.length > 0) { xmlElement(mut body, "Delimiter", delimiter.view().bytes(), urlEncoded)?; }
    body.extend("<MaxKeys>".bytes())?;
    appendDecimal(mut body, maxKeys as u64)?;
    body.extend("</MaxKeys>".bytes())?;
    if (urlEncoded) { body.extend("<EncodingType>url</EncodingType>".bytes())?; }
    body.extend(
        if (truncated) "<IsTruncated>true</IsTruncated>".bytes() else "<IsTruncated>false</IsTruncated>".bytes(),
    )?;
    if (v2) {
        body.extend("<KeyCount>".bytes())?;
        appendDecimal(mut body, (page.keys.length + page.commonPrefixes.length) as u64)?;
        body.extend("</KeyCount>".bytes())?;
        match (token) {
            Some(t) => { xmlElement(mut body, "ContinuationToken", t, false)?; }
            null => {}
        }
        match (paramOf(req, "start-after")) {
            Some(s) => { xmlElement(mut body, "StartAfter", s, urlEncoded)?; }
            null => {}
        }
        if (truncated) {
            var next = Vector<u8>.create();
            next.push(if (page.nextMarkerIsPrefix) 1u8 else 0u8)?;
            next.extend(page.nextMarker.view())?;
            var text = Vector<u8>.create();
            appendBase64(mut text, next.view())?;
            xmlElement(mut body, "NextContinuationToken", text.view(), false)?;
        }
    } else {
        xmlElement(mut body, "Marker", paramOf(req, "marker") ?? "".bytes(), urlEncoded)?;
        if (truncated) { xmlElement(mut body, "NextMarker", page.nextMarker.view(), urlEncoded)?; }
    }
    for (i in 0..page.keys.length) {
        body.extend("<Contents>".bytes())?;
        xmlElement(mut body, "Key", page.keys[i].view(), urlEncoded)?;
        body.extend("<LastModified>".bytes())?;
        appendIso8601(mut body, page.mtimes[i])?;
        body.extend("</LastModified><ETag>".bytes())?;
        var etag = Vector<u8>.create();
        appendEtag(mut etag, borrow page.md5s[i], page.parts[i])?;
        appendXmlEscaped(mut body, etag.view())?;
        body.extend("</ETag><Size>".bytes())?;
        appendDecimal(mut body, page.sizes[i])?;
        body.extend("</Size><StorageClass>STANDARD</StorageClass>".bytes())?;
        if (withOwner) {
            body.extend("<Owner><ID>cosmostore</ID><DisplayName>cosmostore</DisplayName></Owner>".bytes())?;
        }
        body.extend("</Contents>".bytes())?;
    }
    for (i in 0..page.commonPrefixes.length) {
        body.extend("<CommonPrefixes>".bytes())?;
        xmlElement(mut body, "Prefix", page.commonPrefixes[i].view(), urlEncoded)?;
        body.extend("</CommonPrefixes>".bytes())?;
    }
    body.extend("</ListBucketResult>".bytes())?;
    return await sendXml(exchange, borrow body);
}

/// A decoded query parameter as text (empty if absent).
fn utf8Param(req: borrow S3Request, name: StringView) -> Result<String, S3Fail> {
    var s = String.create();
    match (paramOf(req, name)) {
        Some(v) => { appendUtf8(mut s, v)?; }
        null => {}
    }
    return Ok(s);
}

/// `<name>value</name>`, the value URL-encoded for `encoding-type=url`, else XML-escaped.
fn xmlElement(
    out: borrow mut Vector<u8>,
    name: StringView,
    value: Slice<u8>,
    urlEncoded: bool,
) -> Result<void, AllocError> {
    out.push('<')?;
    out.extend(name.bytes())?;
    out.push('>')?;
    if (urlEncoded) {
        appendUriEncoded(out, value, true)?;
    } else {
        appendXmlEscaped(out, value)?;
    }
    out.extend("</".bytes())?;
    out.extend(name.bytes())?;
    out.push('>')?;
    return Ok();
}

async fn listPage(
    app: borrow S3App,
    bucket: StringView,
    prefix: StringView,
    delimiter: StringView,
    after: borrow Vector<u8>,
    afterIsPrefix: bool,
    maxKeys: usize,
) -> Result<ListPage, S3Fail> {
    var guard = await lockStore(app)?;
    let store = guard.data();
    let start = after.view();
    // Bounded by its page over the ordered index (ADR-0026), and memory only: on the event loop.
    return match (store.listObjects(bucket, prefix, delimiter, start, afterIsPrefix, maxKeys)) {
        Ok(p) => Ok(p),
        Err(e) => Err(storeFail(e, 0)),
    };
}

async fn deleteObject(
    app: borrow S3App,
    req: borrow S3Request,
    bypass: bool,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    // Staged, then acknowledged once published: deletes share syncs with PUTs (ADR-0025). With a version id the
    // version is removed for good; without one a bucket with versioning gets a delete marker (ADR-0041).
    let versionId = requestVersion(req)?;
    var staged: DeleteOutcome? = null;
    {
        var guard = await lockStore(app)?;
        let store = guard.data();
        let bucket = req.bucket.view();
        let key = req.key.view();
        staged = match (await Async.blocking(() => store.deleteDeferred(bucket, key, versionId, bypass))) {
            Ok(o) => o,
            Err(e) => { return Err(storeFail(e, key.length)); }
        };
    }
    match (staged) {
        Some(o) => {
            // Under retention or a legal hold: the version stays (ADR-0047 §4).
            if (o.locked) { return Err(S3Fail.Code(S3Code.AccessDenied)); }
            match (o.lsn) {
                Some(lsn) => { await awaitPublished(app, lsn)?; }
                null => {}
            }
            match (o.versionId) {
                Some(id) => { versionHeader(exchange, "x-amz-version-id", id)?; }
                null => {}
            }
            if (o.deleteMarker) { exchange.header("x-amz-delete-marker", "true".bytes())?; }
        }
        null => {}
    }
    await exchange.send(Status.noContent(), "".bytes())?;
    return Ok();
}

/// The request's object: its current version, or the one `versionId` names. A delete marker in the way adds its
/// fields to the error's response.
async fn objectInfo(
    app: borrow S3App,
    req: borrow S3Request,
    exchange: borrow mut Exchange,
) -> Result<ObjectInfo, S3Fail> {
    let versionId = requestVersion(req)?;
    let bucket = req.bucket.view();
    let key = req.key.view();
    var guard = await lockStore(app)?;
    let store = guard.data();
    // An index lookup, no I/O: on the event loop, without a worker thread (ADR-0023).
    match (store.headObjectOf(bucket, key, versionId)) {
        Ok(i) => { return Ok(i); }
        Err(e) => {
            deleteMarkerHeaders(store, bucket, key, versionId, exchange)?;
            return Err(storeFail(e, key.length));
        }
    }
}
