// Avro object container files (ADR-0086 §4), as Iceberg's manifest lists and manifests are: the header (magic, the
// metadata map with `avro.schema` and `avro.codec`, the sync marker), then blocks of records, each block `null` or
// `deflate`-compressed. Each record is decoded by the writer's schema into the JSON model (json.cee): records as
// objects, arrays and maps as arrays and objects, enums as their symbol, bytes and fixed as text holding the raw bytes,
// and floats and doubles as null (their values are not needed here).

/// Why a file could not be read: not Avro, or a codec not taken (its name).
enum AvroError {
    Malformed,
    Codec(Vector<u8>),
    @from OutOfMemory(AllocError),
}

/// How deep a schema or a value may nest, and how large a block may inflate to.
const AVRO_MAX_DEPTH: usize = 64;
const AVRO_MAX_BLOCK: usize = 67108864;
/// How much a file's blocks may decode to in all (M10's exit review, B2): a manifest is a few MiB.
const AVRO_MAX_FILE: usize = 67108864;
/// i64's least, which a count may not be: its negation overflows (M10's exit review, B1).
const AVRO_LEAST: i64 = -9223372036854775807 - 1;

/// A named type (record, enum, fixed) a schema may refer to again by its name.
struct AvroNamed {
    name: Vector<u8>;
    schema: Json;
}

/// A file read: its records, and its header's metadata.
struct AvroFile {
    records: Vector<Json>;
    metadata: Vector<JsonMember>;
}

struct AvroInput<region a> {
    data: Slice<a, u8>;
    at: usize;

    /// A zig-zag varint (Avro's int and long).
    fn long(borrow mut this) -> i64? {
        var value: u64 = 0;
        var shift: u32 = 0;
        while (true) {
            if (this.at >= this.data.length || shift > 63) { return null; }
            let b = this.data[this.at];
            this.at += 1;
            // The 10th byte holds the 64th bit only.
            if (shift == 63 && b > 1) { return null; }
            value |= ((b & 0x7F) as u64) << shift;
            if ((b & 0x80) == 0) { break; }
            shift += 7;
        }
        let half = truncate<i64>(value >> 1);
        return Some(if ((value & 1) == 0) half else -half - 1);
    }

    /// `n` bytes; null past the end.
    fn take(borrow mut this, n: usize) -> Slice<a, u8>? {
        if (n > this.data.length - this.at) { return null; }
        let s = this.data[this.at..this.at + n];
        this.at += n;
        return Some(s);
    }

    /// A block count of an array, a map or the metadata: negative, then a byte size, for a block of that many; at
    /// most the bytes left (each item takes one at least), so no count makes the reader loop or allocate past its
    /// input; null for one that is not so.
    fn blockCount(borrow mut this) -> usize? {
        var count = this.long()?;
        if (count == AVRO_LEAST) { return null; }
        if (count < 0) {
            count = -count;
            let _ = this.long()?;
        }
        let n = checkedTruncate<usize>(count)?;
        if (n > this.data.length - this.at) { return null; }
        return Some(n);
    }

    /// A length-prefixed byte string (bytes and string).
    fn lengthPrefixed(borrow mut this) -> Slice<a, u8>? {
        let n = this.long()?;
        if (n < 0) { return null; }
        return this.take(checkedTruncate<usize>(n)?);
    }
}

/// An object's array member's items; null if it has none or it is not an array.
fn memberItems<region a>(j: borrow(a) Json, key: StringView) -> borrow(a) Vector<Json>? {
    let m = jsonMember(j, key) ?? { return null; };
    return match (m) {
        Json.Array(items) => Some(items),
        _ => null,
    };
}

/// An object's object member's members; null if it has none or it is not an object.
fn memberMembers<region a>(j: borrow(a) Json, key: StringView) -> borrow(a) Vector<JsonMember>? {
    let m = jsonMember(j, key) ?? { return null; };
    return match (m) {
        Json.Object(ms) => Some(ms),
        _ => null,
    };
}

/// A type's name as a schema gives it: a string, or an object's `type`.
fn avroTypeName(schema: borrow Json) -> Slice<u8>? => match (schema) {
    Json.Text(t) => Some(t.view()),
    Json.Object(_) => jsonMemberText(schema, "type"),
    _ => null,
};

/// Every named type a schema defines, by its name (and its full name with a namespace), for references to it.
/// `enclosing` is the namespace a type without its own inherits (Avro 1.11: the nearest enclosing one).
fn collectAvroNames(
    schema: borrow Json,
    out: borrow mut Vector<AvroNamed>,
    depth: usize,
    enclosing: Slice<u8>,
) -> Result<bool, AllocError> {
    if (depth > AVRO_MAX_DEPTH) { return Ok(false); }
    var inner = copyBytes(enclosing)?;
    match (schema) {
        Json.Array(branches) => {
            for (i in 0..branches.length) {
                if (!collectAvroNames(borrow branches[i], out, depth + 1, enclosing)?) { return Ok(false); }
            }
        }
        Json.Object(_) => {
            let kind = jsonMemberText(schema, "type") ?? "".bytes();
            if (kind == "record".bytes() ||
                kind == "error".bytes() || kind == "enum".bytes() || kind == "fixed".bytes()) {
                let name = jsonMemberText(schema, "name") ?? "".bytes();
                out.push(AvroNamed { name: copyBytes(name)?, schema: cloneJson(schema)? })?;
                let dot = findBytes(name, ".".bytes(), 0);
                match (dot) {
                    Some(_) => {
                        // A full name: its namespace is what is before its last dot.
                        var last: usize = 0;
                        for (i in 0..name.length) {
                            if (name[i] == '.') { last = i; }
                        }
                        inner = copyBytes(name[0..last])?;
                    }
                    null => {
                        let ns = jsonMemberText(schema, "namespace") ?? enclosing;
                        inner = copyBytes(ns)?;
                        if (ns.length > 0) {
                            var full = copyBytes(ns)?;
                            full.push('.')?;
                            full.extend(name)?;
                            out.push(AvroNamed { name: full, schema: cloneJson(schema)? })?;
                        }
                    }
                }
            }
            if (kind == "record".bytes() || kind == "error".bytes()) {
                match (jsonMember(schema, "fields")) {
                    Some(fs) => {
                        match (fs) {
                            Json.Array(items) => {
                                for (i in 0..items.length) {
                                    match (jsonMember(borrow items[i], "type")) {
                                        Some(t) => {
                                            if (!collectAvroNames(
                                                t,
                                                out,
                                                depth + 1,
                                                inner.view(),
                                            )?) { return Ok(false); }
                                        }
                                        null => { return Ok(false); }
                                    }
                                }
                            }
                            _ => { return Ok(false); }
                        }
                    }
                    null => { return Ok(false); }
                }
            }
            for (k in ["items", "values"]) {
                match (jsonMember(schema, k)) {
                    Some(t) => {
                        if (!collectAvroNames(t, out, depth + 1, inner.view())?) { return Ok(false); }
                    }
                    null => {}
                }
            }
            match (jsonMember(schema, "type")) {
                Some(t) => {
                    match (t) {
                        Json.Object(_) | Json.Array(_) => {
                            if (!collectAvroNames(t, out, depth + 1, inner.view())?) { return Ok(false); }
                        }
                        _ => {}
                    }
                }
                null => {}
            }
        }
        _ => {}
    }
    return Ok(true);
}

fn namedSchema<region a>(names: borrow(a) Vector<AvroNamed>, name: Slice<u8>) -> borrow(a) Json? {
    for (i in 0..names.length) {
        if (names[i].name.view() == name) { return Some(borrow names[i].schema); }
    }
    // A full name's last part, as a reference within the same namespace may give it: one only, or none.
    var found: usize? = null;
    for (i in 0..names.length) {
        let n = names[i].name.view();
        if (n.length > name.length && n[n.length - name.length..] == name && n[n.length - name.length - 1] == '.') {
            if (found.isSome()) { return null; }
            found = Some(i);
        }
    }
    return match (found) {
        Some(i) => Some(borrow names[i].schema),
        null => null,
    };
}

/// One value of `schema`, decoded into the JSON model.
fn avroValue(
    input: borrow mut AvroInput,
    schema: borrow Json,
    names: borrow Vector<AvroNamed>,
    depth: usize,
) -> Result<Json, AvroError> {
    if (depth > AVRO_MAX_DEPTH) { return Err(AvroError.Malformed); }
    match (schema) {
        // A union: the branch's index, then its value.
        Json.Array(branches) => {
            let i = input.long() ?? { return Err(AvroError.Malformed); };
            if (i < 0 || i >= truncate<i64>(branches.length)) { return Err(AvroError.Malformed); }
            return avroValue(input, borrow branches[truncate<usize>(i)], names, depth + 1);
        }
        _ => {}
    }
    // `{"type": <a schema>}`: that schema.
    match (schema) {
        Json.Object(_) => {
            match (jsonMember(schema, "type")) {
                Some(inner) => {
                    match (inner) {
                        Json.Object(_) | Json.Array(_) => { return avroValue(input, inner, names, depth + 1); }
                        _ => {}
                    }
                }
                null => {}
            }
        }
        _ => {}
    }
    let kind = avroTypeName(schema) ?? { return Err(AvroError.Malformed); };
    if (kind == "null".bytes()) { return Ok(Json.Null); }
    if (kind == "boolean".bytes()) {
        let b = input.take(1) ?? { return Err(AvroError.Malformed); };
        return Ok(Json.Bool(b[0] != 0));
    }
    if (kind == "int".bytes() || kind == "long".bytes()) {
        let v = input.long() ?? { return Err(AvroError.Malformed); };
        if (kind == "int".bytes() && checkedTruncate<i32>(v).isNull()) { return Err(AvroError.Malformed); }
        return Ok(jsonInteger(v)?);
    }
    if (kind == "float".bytes()) {
        let _ = input.take(4) ?? { return Err(AvroError.Malformed); };
        return Ok(Json.Null);
    }
    if (kind == "double".bytes()) {
        let _ = input.take(8) ?? { return Err(AvroError.Malformed); };
        return Ok(Json.Null);
    }
    if (kind == "bytes".bytes() || kind == "string".bytes()) {
        let s = input.lengthPrefixed() ?? { return Err(AvroError.Malformed); };
        return Ok(Json.Text(copyBytes(s)?));
    }
    if (kind == "fixed".bytes()) {
        let size = jsonMemberI64(schema, "size") ?? -1;
        if (size < 0) { return Err(AvroError.Malformed); }
        let s = input.take(truncate<usize>(size)) ?? { return Err(AvroError.Malformed); };
        return Ok(Json.Text(copyBytes(s)?));
    }
    if (kind == "enum".bytes()) {
        let i = input.long() ?? { return Err(AvroError.Malformed); };
        let symbols = memberItems(schema, "symbols") ?? { return Err(AvroError.Malformed); };
        if (i < 0 || i >= truncate<i64>(symbols.length)) { return Err(AvroError.Malformed); }
        return Ok(cloneJson(borrow symbols[truncate<usize>(i)])?);
    }
    if (kind == "record".bytes() || kind == "error".bytes()) {
        var members = Vector<JsonMember>.create();
        let fields = memberItems(schema, "fields") ?? { return Err(AvroError.Malformed); };
        for (i in 0..fields.length) {
            let f = borrow fields[i];
            let name = jsonMemberText(f, "name") ?? { return Err(AvroError.Malformed); };
            let t = jsonMember(f, "type") ?? { return Err(AvroError.Malformed); };
            let v = avroValue(input, t, names, depth + 1)?;
            members.push(JsonMember { key: copyBytes(name)?, value: v })?;
        }
        return Ok(Json.Object(members));
    }
    if (kind == "array".bytes() || kind == "map".bytes()) {
        let isMap = kind == "map".bytes();
        let items = jsonMember(schema, if (isMap) "values" else "items") ?? { return Err(AvroError.Malformed); };
        var members = Vector<JsonMember>.create();
        var values = Vector<Json>.create();
        // Blocks of items, each its count (negative: then its size in bytes), to a count of 0.
        while (true) {
            let count = input.blockCount() ?? { return Err(AvroError.Malformed); };
            if (count == 0) { break; }
            for (n in 0..count) {
                if (isMap) {
                    let key = copyBytes(input.lengthPrefixed() ?? { return Err(AvroError.Malformed); })?;
                    let v = avroValue(input, items, names, depth + 1)?;
                    members.push(JsonMember { key: key, value: v })?;
                } else {
                    values.push(avroValue(input, items, names, depth + 1)?)?;
                }
            }
        }
        return Ok(if (isMap) Json.Object(members) else Json.Array(values));
    }
    // A reference to a named type.
    return match (namedSchema(names, kind)) {
        Some(named) => avroValue(input, named, names, depth + 1),
        null => Err(AvroError.Malformed),
    };
}

/// Reads an object container file: every record, decoded by its schema.
fn readAvro(bytes: Slice<u8>) -> Result<AvroFile, AvroError> {
    var input = AvroInput { data: bytes, at: 0 };
    let magic = input.take(4) ?? { return Err(AvroError.Malformed); };
    if (magic != [0x4Fu8, 0x62, 0x6A, 0x01][..]) { return Err(AvroError.Malformed); }
    // The metadata: a map of bytes.
    var metadata = Vector<JsonMember>.create();
    while (true) {
        let count = input.blockCount() ?? { return Err(AvroError.Malformed); };
        if (count == 0) { break; }
        for (n in 0..count) {
            let key = copyBytes(input.lengthPrefixed() ?? { return Err(AvroError.Malformed); })?;
            let value = copyBytes(input.lengthPrefixed() ?? { return Err(AvroError.Malformed); })?;
            metadata.push(JsonMember { key: key, value: Json.Text(value) })?;
        }
    }
    let sync = copyBytes(input.take(16) ?? { return Err(AvroError.Malformed); })?;
    var schemaText = Vector<u8>.create();
    var codec = copyBytes("null".bytes())?;
    for (i in 0..metadata.length) {
        let k = metadata[i].key.view();
        let v = match (borrow metadata[i].value) {
            Json.Text(t) => t.view(),
            _ => "".bytes(),
        };
        if (k == "avro.schema".bytes()) { schemaText = copyBytes(v)?; }
        if (k == "avro.codec".bytes()) { codec = copyBytes(v)?; }
    }
    if (codec.view() != "null".bytes() && codec.view() != "deflate".bytes()) { return Err(AvroError.Codec(codec)); }
    let schema = parseJson(schemaText.view())? ?? { return Err(AvroError.Malformed); };
    var names = Vector<AvroNamed>.create();
    if (!collectAvroNames(borrow schema, mut names, 0, "".bytes())?) { return Err(AvroError.Malformed); }
    var records = Vector<Json>.create();
    var decoded: usize = 0;
    while (input.at < bytes.length) {
        let count = input.long() ?? { return Err(AvroError.Malformed); };
        let size = input.long() ?? { return Err(AvroError.Malformed); };
        if (count < 0 || size < 0) { return Err(AvroError.Malformed); }
        let raw = input.take(checkedTruncate<usize>(size) ?? { return Err(AvroError.Malformed); }) ??
            { return Err(AvroError.Malformed); };
        let marker = input.take(16) ?? { return Err(AvroError.Malformed); };
        if (marker != sync.view()) { return Err(AvroError.Malformed); }
        var inflated = Vector<u8>.create();
        let block: Slice<u8> = if (codec.view() == "deflate".bytes()) {
            let left = AVRO_MAX_FILE - decoded;
            match (inflate(raw, if (left < AVRO_MAX_BLOCK) left else AVRO_MAX_BLOCK, mut inflated)) {
                Ok() => {}
                Err(InflateError.OutOfMemory(e)) => { return Err(AvroError.OutOfMemory(e)); }
                Err(_) => { return Err(AvroError.Malformed); }
            }
            inflated.view()
        } else raw;
        // Each record takes a byte at least, and the file's blocks decode to AVRO_MAX_FILE at most (B2).
        decoded += block.length;
        if (decoded > AVRO_MAX_FILE) { return Err(AvroError.Malformed); }
        let n = checkedTruncate<usize>(count) ?? { return Err(AvroError.Malformed); };
        if (n > block.length) { return Err(AvroError.Malformed); }
        var b = AvroInput { data: block, at: 0 };
        for (k in 0..n) {
            records.push(avroValue(mut b, borrow schema, borrow names, 0)?)?;
        }
        if (b.at != block.length) { return Err(AvroError.Malformed); }
    }
    return Ok(AvroFile { records: records, metadata: metadata });
}
