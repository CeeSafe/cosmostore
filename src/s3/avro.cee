// Avro object container files (ADR-0086 §4), as Iceberg's manifest lists and manifests are: the header (magic, the
// metadata map with `avro.schema` and `avro.codec`, the sync marker), then blocks of records, each block `null` or
// `deflate`-compressed. Each record is decoded by the writer's schema into the JSON model (json.cee): records as
// objects, arrays and maps as arrays and objects, enums as their symbol, and bytes, fixed, floats and doubles as text
// holding their raw bytes (a float's 4, a double's 8, little-endian), so a record read is written back as it was
// (`writeAvro`, ADR-0098 §3).

/// Why a file could not be read: not Avro, or a codec not taken (its name).
enum AvroError {
    Malformed,
    Codec(Vector<u8>),
    @from OutOfMemory(AllocError),
}

/// How deep a schema or a value may nest, and how large a block may inflate to.
const AVRO_MAX_DEPTH: usize = 64;
const AVRO_MAX_BLOCK: usize = 67108864;
/// How much a file's blocks may decode to in all (M10's exit review, B2): a manifest is a few MiB.
const AVRO_MAX_FILE: usize = 67108864;
/// i64's least, which a count may not be: its negation overflows (M10's exit review, B1).
const AVRO_LEAST: i64 = -9223372036854775807 - 1;

/// A named type (record, enum, fixed) a schema may refer to again by its name.
struct AvroNamed {
    name: Vector<u8>;
    schema: Json;
}

/// A file read: its records, and its header's metadata.
struct AvroFile {
    records: Vector<Json>;
    metadata: Vector<JsonMember>;
}

struct AvroInput<region a> {
    data: Slice<a, u8>;
    at: usize;

    /// A zig-zag varint (Avro's int and long).
    fn long(borrow mut this) -> i64? {
        var value: u64 = 0;
        var shift: u32 = 0;
        while (true) {
            if (this.at >= this.data.length || shift > 63) { return null; }
            let b = this.data[this.at];
            this.at += 1;
            // The 10th byte holds the 64th bit only.
            if (shift == 63 && b > 1) { return null; }
            value |= ((b & 0x7F) as u64) << shift;
            if ((b & 0x80) == 0) { break; }
            shift += 7;
        }
        let half = truncate<i64>(value >> 1);
        return Some(if ((value & 1) == 0) half else -half - 1);
    }

    /// `n` bytes; null past the end.
    fn take(borrow mut this, n: usize) -> Slice<a, u8>? {
        if (n > this.data.length - this.at) { return null; }
        let s = this.data[this.at..this.at + n];
        this.at += n;
        return Some(s);
    }

    /// A block count of an array, a map or the metadata: negative, then a byte size, for a block of that many; at
    /// most the bytes left (each item takes one at least), so no count makes the reader loop or allocate past its
    /// input; null for one that is not so.
    fn blockCount(borrow mut this) -> usize? {
        var count = this.long()?;
        if (count == AVRO_LEAST) { return null; }
        if (count < 0) {
            count = -count;
            let _ = this.long()?;
        }
        let n = checkedTruncate<usize>(count)?;
        if (n > this.data.length - this.at) { return null; }
        return Some(n);
    }

    /// A length-prefixed byte string (bytes and string).
    fn lengthPrefixed(borrow mut this) -> Slice<a, u8>? {
        let n = this.long()?;
        if (n < 0) { return null; }
        return this.take(checkedTruncate<usize>(n)?);
    }
}

/// An object's array member's items; null if it has none or it is not an array.
fn memberItems<region a>(j: borrow(a) Json, key: StringView) -> borrow(a) Vector<Json>? {
    let m = jsonMember(j, key) ?? { return null; };
    return match (m) {
        Json.Array(items) => Some(items),
        _ => null,
    };
}

/// An object's object member's members; null if it has none or it is not an object.
fn memberMembers<region a>(j: borrow(a) Json, key: StringView) -> borrow(a) Vector<JsonMember>? {
    let m = jsonMember(j, key) ?? { return null; };
    return match (m) {
        Json.Object(ms) => Some(ms),
        _ => null,
    };
}

/// A type's name as a schema gives it: a string, or an object's `type`.
fn avroTypeName(schema: borrow Json) -> Slice<u8>? => match (schema) {
    Json.Text(t) => Some(t.view()),
    Json.Object(_) => jsonMemberText(schema, "type"),
    _ => null,
};

/// Every named type a schema defines, by its name (and its full name with a namespace), for references to it.
/// `enclosing` is the namespace a type without its own inherits (Avro 1.11: the nearest enclosing one).
fn collectAvroNames(
    schema: borrow Json,
    out: borrow mut Vector<AvroNamed>,
    depth: usize,
    enclosing: Slice<u8>,
) -> Result<bool, AllocError> {
    if (depth > AVRO_MAX_DEPTH) { return Ok(false); }
    var inner = copyBytes(enclosing)?;
    match (schema) {
        Json.Array(branches) => {
            for (i in 0..branches.length) {
                if (!collectAvroNames(borrow branches[i], out, depth + 1, enclosing)?) { return Ok(false); }
            }
        }
        Json.Object(_) => {
            let kind = jsonMemberText(schema, "type") ?? "".bytes();
            if (kind == "record".bytes() ||
                kind == "error".bytes() || kind == "enum".bytes() || kind == "fixed".bytes()) {
                let name = jsonMemberText(schema, "name") ?? "".bytes();
                out.push(AvroNamed { name: copyBytes(name)?, schema: cloneJson(schema)? })?;
                let dot = findBytes(name, ".".bytes(), 0);
                match (dot) {
                    Some(_) => {
                        // A full name: its namespace is what is before its last dot.
                        var last: usize = 0;
                        for (i in 0..name.length) {
                            if (name[i] == '.') { last = i; }
                        }
                        inner = copyBytes(name[0..last])?;
                    }
                    null => {
                        let ns = jsonMemberText(schema, "namespace") ?? enclosing;
                        inner = copyBytes(ns)?;
                        if (ns.length > 0) {
                            var full = copyBytes(ns)?;
                            full.push('.')?;
                            full.extend(name)?;
                            out.push(AvroNamed { name: full, schema: cloneJson(schema)? })?;
                        }
                    }
                }
            }
            if (kind == "record".bytes() || kind == "error".bytes()) {
                match (jsonMember(schema, "fields")) {
                    Some(fs) => {
                        match (fs) {
                            Json.Array(items) => {
                                for (i in 0..items.length) {
                                    match (jsonMember(borrow items[i], "type")) {
                                        Some(t) => {
                                            if (!collectAvroNames(
                                                t,
                                                out,
                                                depth + 1,
                                                inner.view(),
                                            )?) { return Ok(false); }
                                        }
                                        null => { return Ok(false); }
                                    }
                                }
                            }
                            _ => { return Ok(false); }
                        }
                    }
                    null => { return Ok(false); }
                }
            }
            for (k in ["items", "values"]) {
                match (jsonMember(schema, k)) {
                    Some(t) => {
                        if (!collectAvroNames(t, out, depth + 1, inner.view())?) { return Ok(false); }
                    }
                    null => {}
                }
            }
            match (jsonMember(schema, "type")) {
                Some(t) => {
                    match (t) {
                        Json.Object(_) | Json.Array(_) => {
                            if (!collectAvroNames(t, out, depth + 1, inner.view())?) { return Ok(false); }
                        }
                        _ => {}
                    }
                }
                null => {}
            }
        }
        _ => {}
    }
    return Ok(true);
}

fn namedSchema<region a>(names: borrow(a) Vector<AvroNamed>, name: Slice<u8>) -> borrow(a) Json? {
    for (i in 0..names.length) {
        if (names[i].name.view() == name) { return Some(borrow names[i].schema); }
    }
    // A full name's last part, as a reference within the same namespace may give it: one only, or none.
    var found: usize? = null;
    for (i in 0..names.length) {
        let n = names[i].name.view();
        if (n.length > name.length && n[n.length - name.length..] == name && n[n.length - name.length - 1] == '.') {
            if (found.isSome()) { return null; }
            found = Some(i);
        }
    }
    return match (found) {
        Some(i) => Some(borrow names[i].schema),
        null => null,
    };
}

/// One value of `schema`, decoded into the JSON model.
fn avroValue(
    input: borrow mut AvroInput,
    schema: borrow Json,
    names: borrow Vector<AvroNamed>,
    depth: usize,
) -> Result<Json, AvroError> {
    if (depth > AVRO_MAX_DEPTH) { return Err(AvroError.Malformed); }
    match (schema) {
        // A union: the branch's index, then its value.
        Json.Array(branches) => {
            let i = input.long() ?? { return Err(AvroError.Malformed); };
            if (i < 0 || i >= truncate<i64>(branches.length)) { return Err(AvroError.Malformed); }
            return avroValue(input, borrow branches[truncate<usize>(i)], names, depth + 1);
        }
        _ => {}
    }
    // `{"type": <a schema>}`: that schema.
    match (schema) {
        Json.Object(_) => {
            match (jsonMember(schema, "type")) {
                Some(inner) => {
                    match (inner) {
                        Json.Object(_) | Json.Array(_) => { return avroValue(input, inner, names, depth + 1); }
                        _ => {}
                    }
                }
                null => {}
            }
        }
        _ => {}
    }
    let kind = avroTypeName(schema) ?? { return Err(AvroError.Malformed); };
    if (kind == "null".bytes()) { return Ok(Json.Null); }
    if (kind == "boolean".bytes()) {
        let b = input.take(1) ?? { return Err(AvroError.Malformed); };
        return Ok(Json.Bool(b[0] != 0));
    }
    if (kind == "int".bytes() || kind == "long".bytes()) {
        let v = input.long() ?? { return Err(AvroError.Malformed); };
        if (kind == "int".bytes() && checkedTruncate<i32>(v).isNull()) { return Err(AvroError.Malformed); }
        return Ok(jsonInteger(v)?);
    }
    if (kind == "float".bytes() || kind == "double".bytes()) {
        let raw = input.take(if (kind == "float".bytes()) 4 else 8) ?? { return Err(AvroError.Malformed); };
        return Ok(Json.Text(copyBytes(raw)?));
    }
    if (kind == "bytes".bytes() || kind == "string".bytes()) {
        let s = input.lengthPrefixed() ?? { return Err(AvroError.Malformed); };
        return Ok(Json.Text(copyBytes(s)?));
    }
    if (kind == "fixed".bytes()) {
        let size = jsonMemberI64(schema, "size") ?? -1;
        if (size < 0) { return Err(AvroError.Malformed); }
        let s = input.take(truncate<usize>(size)) ?? { return Err(AvroError.Malformed); };
        return Ok(Json.Text(copyBytes(s)?));
    }
    if (kind == "enum".bytes()) {
        let i = input.long() ?? { return Err(AvroError.Malformed); };
        let symbols = memberItems(schema, "symbols") ?? { return Err(AvroError.Malformed); };
        if (i < 0 || i >= truncate<i64>(symbols.length)) { return Err(AvroError.Malformed); }
        return Ok(cloneJson(borrow symbols[truncate<usize>(i)])?);
    }
    if (kind == "record".bytes() || kind == "error".bytes()) {
        var members = Vector<JsonMember>.create();
        let fields = memberItems(schema, "fields") ?? { return Err(AvroError.Malformed); };
        for (i in 0..fields.length) {
            let f = borrow fields[i];
            let name = jsonMemberText(f, "name") ?? { return Err(AvroError.Malformed); };
            let t = jsonMember(f, "type") ?? { return Err(AvroError.Malformed); };
            let v = avroValue(input, t, names, depth + 1)?;
            members.push(JsonMember { key: copyBytes(name)?, value: v })?;
        }
        return Ok(Json.Object(members));
    }
    if (kind == "array".bytes() || kind == "map".bytes()) {
        let isMap = kind == "map".bytes();
        let items = jsonMember(schema, if (isMap) "values" else "items") ?? { return Err(AvroError.Malformed); };
        var members = Vector<JsonMember>.create();
        var values = Vector<Json>.create();
        // Blocks of items, each its count (negative: then its size in bytes), to a count of 0.
        while (true) {
            let count = input.blockCount() ?? { return Err(AvroError.Malformed); };
            if (count == 0) { break; }
            for (n in 0..count) {
                if (isMap) {
                    let key = copyBytes(input.lengthPrefixed() ?? { return Err(AvroError.Malformed); })?;
                    let v = avroValue(input, items, names, depth + 1)?;
                    members.push(JsonMember { key: key, value: v })?;
                } else {
                    values.push(avroValue(input, items, names, depth + 1)?)?;
                }
            }
        }
        return Ok(if (isMap) Json.Object(members) else Json.Array(values));
    }
    // A reference to a named type.
    return match (namedSchema(names, kind)) {
        Some(named) => avroValue(input, named, names, depth + 1),
        null => Err(AvroError.Malformed),
    };
}

/// Reads an object container file: every record, decoded by its schema.
fn readAvro(bytes: Slice<u8>) -> Result<AvroFile, AvroError> {
    var input = AvroInput { data: bytes, at: 0 };
    let magic = input.take(4) ?? { return Err(AvroError.Malformed); };
    if (magic != [0x4Fu8, 0x62, 0x6A, 0x01][..]) { return Err(AvroError.Malformed); }
    // The metadata: a map of bytes.
    var metadata = Vector<JsonMember>.create();
    while (true) {
        let count = input.blockCount() ?? { return Err(AvroError.Malformed); };
        if (count == 0) { break; }
        for (n in 0..count) {
            let key = copyBytes(input.lengthPrefixed() ?? { return Err(AvroError.Malformed); })?;
            let value = copyBytes(input.lengthPrefixed() ?? { return Err(AvroError.Malformed); })?;
            metadata.push(JsonMember { key: key, value: Json.Text(value) })?;
        }
    }
    let sync = copyBytes(input.take(16) ?? { return Err(AvroError.Malformed); })?;
    var schemaText = Vector<u8>.create();
    var codec = copyBytes("null".bytes())?;
    for (i in 0..metadata.length) {
        let k = metadata[i].key.view();
        let v = match (borrow metadata[i].value) {
            Json.Text(t) => t.view(),
            _ => "".bytes(),
        };
        if (k == "avro.schema".bytes()) { schemaText = copyBytes(v)?; }
        if (k == "avro.codec".bytes()) { codec = copyBytes(v)?; }
    }
    if (codec.view() != "null".bytes() && codec.view() != "deflate".bytes() && codec.view() != "snappy".bytes()) {
        return Err(AvroError.Codec(codec));
    }
    let schema = parseJson(schemaText.view())? ?? { return Err(AvroError.Malformed); };
    var names = Vector<AvroNamed>.create();
    if (!collectAvroNames(borrow schema, mut names, 0, "".bytes())?) { return Err(AvroError.Malformed); }
    var records = Vector<Json>.create();
    var decoded: usize = 0;
    while (input.at < bytes.length) {
        let count = input.long() ?? { return Err(AvroError.Malformed); };
        let size = input.long() ?? { return Err(AvroError.Malformed); };
        if (count < 0 || size < 0) { return Err(AvroError.Malformed); }
        let raw = input.take(checkedTruncate<usize>(size) ?? { return Err(AvroError.Malformed); }) ??
            { return Err(AvroError.Malformed); };
        let marker = input.take(16) ?? { return Err(AvroError.Malformed); };
        if (marker != sync.view()) { return Err(AvroError.Malformed); }
        var inflated = Vector<u8>.create();
        let block: Slice<u8> = if (codec.view() == "deflate".bytes()) {
            let left = AVRO_MAX_FILE - decoded;
            // Avro's `deflate` is raw RFC 1951: lib/std's since ceesafec 0.90.0 (CeeSafe ADR 0196).
            match (inflateAvroBlock(raw, if (left < AVRO_MAX_BLOCK) left else AVRO_MAX_BLOCK, mut inflated)) {
                Ok() => {}
                Err(DecodeError.OutOfMemory(e)) => { return Err(AvroError.OutOfMemory(e)); }
                Err(_) => { return Err(AvroError.Malformed); }
            }
            inflated.view()
        } else if (codec.view() == "snappy".bytes()) {
            // Avro's `snappy`: a raw snappy block, then the CRC-32 of what it holds, 4 bytes big-endian (lib/std's
            // Snappy since ceesafec 0.94.0, CeeSafe ADR 0196 phase 2).
            if (raw.length < 4) { return Err(AvroError.Malformed); }
            let left = AVRO_MAX_FILE - decoded;
            match (Snappy.decompress(
                raw[0..raw.length - 4],
                if (left < AVRO_MAX_BLOCK) left else AVRO_MAX_BLOCK,
                mut inflated,
            )) {
                Ok() => {}
                Err(DecodeError.OutOfMemory(e)) => { return Err(AvroError.OutOfMemory(e)); }
                Err(_) => { return Err(AvroError.Malformed); }
            }
            let crc = raw[raw.length - 4..];
            let want = (crc[0] as u32 << 24) | (crc[1] as u32 << 16) | (crc[2] as u32 << 8) | crc[3] as u32;
            if (Crc32.of(inflated.view()) != want) { return Err(AvroError.Malformed); }
            inflated.view()
        } else raw;
        // Each record takes a byte at least, and the file's blocks decode to AVRO_MAX_FILE at most (B2).
        decoded += block.length;
        if (decoded > AVRO_MAX_FILE) { return Err(AvroError.Malformed); }
        let n = checkedTruncate<usize>(count) ?? { return Err(AvroError.Malformed); };
        if (n > block.length) { return Err(AvroError.Malformed); }
        var b = AvroInput { data: block, at: 0 };
        for (k in 0..n) {
            records.push(avroValue(mut b, borrow schema, borrow names, 0)?)?;
        }
        if (b.at != block.length) { return Err(AvroError.Malformed); }
    }
    return Ok(AvroFile { records: records, metadata: metadata });
}

// ---- Writing (ADR-0098 §3) ----

/// A file of `records`, by the schema in `metadata`'s `avro.schema` (its other entries, Iceberg's among them, written
/// as given), with the null codec, in one block; null when the schema does not parse or a record does not fit it.
fn writeAvro(metadata: Slice<JsonMember>, records: Slice<Json>) -> Result<Vector<u8>?, AllocError> {
    var schemaText: Slice<u8>? = null;
    for (i in 0..metadata.length) {
        if (metadata[i].key.view() == "avro.schema".bytes()) {
            match (borrow metadata[i].value) {
                Json.Text(t) => { schemaText = Some(t.view()); }
                _ => {}
            }
        }
    }
    let schema = parseJson(schemaText ?? { return Ok(null); })? ?? { return Ok(null); };
    var names = Vector<AvroNamed>.create();
    if (!collectAvroNames(borrow schema, mut names, 0, "".bytes())?) { return Ok(null); }
    var block = Vector<u8>.create();
    for (i in 0..records.length) {
        if (!(writeAvroValue(mut block, borrow records[i], borrow schema, borrow names, 0)?)) { return Ok(null); }
    }
    var out = Vector<u8>.create();
    out.extend([0x4Fu8, 0x62, 0x6A, 0x01][..])?;
    // The metadata, as one block of a map of bytes; the codec is always null here.
    var entries: i64 = 1;
    for (i in 0..metadata.length) {
        if (metadata[i].key.view() != "avro.codec".bytes()) { entries += 1; }
    }
    writeAvroLong(mut out, entries)?;
    for (i in 0..metadata.length) {
        let k = metadata[i].key.view();
        if (k == "avro.codec".bytes()) { continue; }
        let v = match (borrow metadata[i].value) {
            Json.Text(t) => t.view(),
            _ => { return Ok(null); }
        };
        writeAvroBytes(mut out, k)?;
        writeAvroBytes(mut out, v)?;
    }
    writeAvroBytes(mut out, "avro.codec".bytes())?;
    writeAvroBytes(mut out, "null".bytes())?;
    writeAvroLong(mut out, 0)?;
    var sync = [0u8; 16];
    if (Random.fill(mut sync[..]).isErr()) { return Ok(null); }
    out.extend(sync[..])?;
    if (records.length > 0) {
        writeAvroLong(mut out, truncate<i64>(records.length))?;
        writeAvroLong(mut out, truncate<i64>(block.length))?;
        out.extend(block.view())?;
        out.extend(sync[..])?;
    }
    return Ok(Some(out));
}

fn writeAvroLong(out: borrow mut Vector<u8>, v: i64) -> Result<void, AllocError> => writeZigzag(out, v);

fn writeAvroBytes(out: borrow mut Vector<u8>, b: Slice<u8>) -> Result<void, AllocError> {
    writeAvroLong(out, truncate<i64>(b.length))?;
    out.extend(b)?;
    return Ok();
}

/// A value by its schema; false when it does not fit.
fn writeAvroValue(
    out: borrow mut Vector<u8>,
    v: borrow Json,
    schema: borrow Json,
    names: borrow Vector<AvroNamed>,
    depth: usize,
) -> Result<bool, AllocError> {
    if (depth > AVRO_MAX_DEPTH) { return Ok(false); }
    match (schema) {
        // A union: the first branch the value fits.
        Json.Array(branches) => {
            for (i in 0..branches.length) {
                if (avroFits(v, borrow branches[i], names, depth + 1)) {
                    writeAvroLong(out, truncate<i64>(i))?;
                    return writeAvroValue(out, v, borrow branches[i], names, depth + 1);
                }
            }
            return Ok(false);
        }
        _ => {}
    }
    match (avroInner(schema)) {
        Some(inner) => { return writeAvroValue(out, v, inner, names, depth + 1); }
        null => {}
    }
    let kind = avroTypeName(schema) ?? { return Ok(false); };
    if (kind == "null".bytes()) { return Ok(isJsonNull(v)); }
    if (kind == "boolean".bytes()) {
        return match (v) {
            Json.Bool(b) => {
                out.push(if (*b) 1 else 0)?;
                Ok(true)
            }
            _ => Ok(false),
        };
    }
    if (kind == "int".bytes() || kind == "long".bytes()) {
        let n = jsonI64(v) ?? { return Ok(false); };
        if (kind == "int".bytes() && checkedTruncate<i32>(n).isNull()) { return Ok(false); }
        writeAvroLong(out, n)?;
        return Ok(true);
    }
    let text: Slice<u8>? = match (v) {
        Json.Text(t) => Some(t.view()),
        _ => null,
    };
    if (kind == "float".bytes() || kind == "double".bytes() || kind == "fixed".bytes()) {
        let t = text ?? { return Ok(false); };
        let size = if (kind == "float".bytes()) 4 else if (kind == "double".bytes()) 8
            else truncate<usize>(jsonMemberI64(schema, "size") ?? -1);
        if (t.length != size) { return Ok(false); }
        out.extend(t)?;
        return Ok(true);
    }
    if (kind == "bytes".bytes() || kind == "string".bytes()) {
        writeAvroBytes(out, text ?? { return Ok(false); })?;
        return Ok(true);
    }
    if (kind == "enum".bytes()) {
        let t = text ?? { return Ok(false); };
        let symbols = memberItems(schema, "symbols") ?? { return Ok(false); };
        for (i in 0..symbols.length) {
            match (borrow symbols[i]) {
                Json.Text(s) => {
                    if (s.view() == t) {
                        writeAvroLong(out, truncate<i64>(i))?;
                        return Ok(true);
                    }
                }
                _ => {}
            }
        }
        return Ok(false);
    }
    if (kind == "record".bytes() || kind == "error".bytes()) {
        let fields = memberItems(schema, "fields") ?? { return Ok(false); };
        let none = Json.Null;
        for (i in 0..fields.length) {
            let f = borrow fields[i];
            let name = jsonMemberText(f, "name") ?? { return Ok(false); };
            let t = jsonMember(f, "type") ?? { return Ok(false); };
            // A field the value lacks is written as null, which only a union with null takes.
            let value = jsonMember(v, StringView.fromUtf8(name) ?? "") ?? borrow none;
            if (!(writeAvroValue(out, value, t, names, depth + 1)?)) { return Ok(false); }
        }
        return Ok(true);
    }
    if (kind == "array".bytes()) {
        let items = jsonMember(schema, "items") ?? { return Ok(false); };
        let values = match (v) {
            Json.Array(a) => a,
            _ => { return Ok(false); }
        };
        if (values.length > 0) {
            writeAvroLong(out, truncate<i64>(values.length))?;
            for (i in 0..values.length) {
                if (!(writeAvroValue(out, borrow values[i], items, names, depth + 1)?)) { return Ok(false); }
            }
        }
        writeAvroLong(out, 0)?;
        return Ok(true);
    }
    if (kind == "map".bytes()) {
        let items = jsonMember(schema, "values") ?? { return Ok(false); };
        let members = match (v) {
            Json.Object(m) => m,
            _ => { return Ok(false); }
        };
        if (members.length > 0) {
            writeAvroLong(out, truncate<i64>(members.length))?;
            for (i in 0..members.length) {
                writeAvroBytes(out, members[i].key.view())?;
                if (!(writeAvroValue(out, borrow members[i].value, items, names, depth + 1)?)) { return Ok(false); }
            }
        }
        writeAvroLong(out, 0)?;
        return Ok(true);
    }
    return match (namedSchema(names, kind)) {
        Some(named) => writeAvroValue(out, v, named, names, depth + 1),
        null => Ok(false),
    };
}

/// `{"type": <a schema>}`'s schema, when the type is not a name.
fn avroInner(schema: borrow Json) -> borrow(schema) Json? {
    match (schema) {
        Json.Object(_) => {
            match (jsonMember(schema, "type")) {
                Some(inner) => {
                    match (inner) {
                        Json.Object(_) | Json.Array(_) => { return Some(inner); }
                        _ => {}
                    }
                }
                null => {}
            }
        }
        _ => {}
    }
    return null;
}

fn isJsonNull(v: borrow Json) -> bool => match (v) {
    Json.Null => true,
    _ => false,
};

/// Whether a value fits a union's branch, by its kind (a union's branches differ in kind, by Avro's rule).
fn avroFits(v: borrow Json, schema: borrow Json, names: borrow Vector<AvroNamed>, depth: usize) -> bool {
    if (depth > AVRO_MAX_DEPTH) { return false; }
    match (avroInner(schema)) {
        Some(inner) => { return avroFits(v, inner, names, depth + 1); }
        null => {}
    }
    let kind = avroTypeName(schema) ?? { return false; };
    // A name of a type defined before (a `fixed` reused, say): that type (the M16 exit review).
    if (!avroBuiltin(kind)) {
        return match (namedSchema(names, kind)) {
            Some(named) => avroFits(v, named, names, depth + 1),
            null => false,
        };
    }
    return match (v) {
        Json.Null => kind == "null".bytes(),
        Json.Bool(_) => kind == "boolean".bytes(),
        Json.Number(_) => kind == "int".bytes() || kind == "long".bytes(),
        Json.Text(t) => if (kind == "float".bytes()) t.length == 4 else if (kind == "double".bytes()) t.length == 8
            else if (kind == "fixed".bytes()) truncate<i64>(t.length) == (jsonMemberI64(schema, "size") ?? -1)
            else kind == "bytes".bytes() || kind == "string".bytes() || kind == "enum".bytes(),
        Json.Array(_) => kind == "array".bytes(),
        Json.Object(_) => kind == "record".bytes() || kind == "error".bytes() || kind == "map".bytes(),
    };
}

/// Whether a type's name is Avro's own (a primitive or a complex type's), not a named type's.
fn avroBuiltin(kind: Slice<u8>) -> bool {
    for (b in [
        "null",
        "boolean",
        "int",
        "long",
        "float",
        "double",
        "bytes",
        "string",
        "fixed",
        "enum",
        "record",
        "error",
        "array",
        "map",
    ]) {
        if (kind == b.bytes()) { return true; }
    }
    return false;
}

/// The bytes after a block's deflate stream that are taken: Python's Avro writer frames a block as
/// `zlib.compress(data)[2:-1]`, so 3 of the Adler-32's 4 bytes follow the stream. Its files are PyIceberg's.
const AVRO_DEFLATE_TAIL: usize = 4;

/// A block's raw deflate stream, decoded by lib/std's `Inflater` up to `limit` bytes. Up to AVRO_DEFLATE_TAIL bytes
/// after the stream's end are left, as Python's writer leaves them; lib/std's whole-buffer `Deflate.decompress`
/// refuses any (ADR 0196 §2.5).
fn inflateAvroBlock(raw: Slice<u8>, limit: usize, out: borrow mut Vector<u8>) -> Result<void, DecodeError> {
    var inflater = Inflater.create(DeflateFormat.Raw, limit as u64)?;
    var buf = Vector<u8>.create();
    buf.resize(65536, 0)?;
    var at: usize = 0;
    while (true) {
        let p = inflater.step(raw[at..], buf.viewMut())?;
        out.extend(buf.view()[0..p.written])?;
        at += p.read;
        if (p.done) { break; }
        if (p.read == 0 && p.written == 0) { return Err(DecodeError.Malformed); } // cut short
    }
    if (raw.length - at > AVRO_DEFLATE_TAIL) { return Err(DecodeError.Malformed); }
    return Ok();
}
