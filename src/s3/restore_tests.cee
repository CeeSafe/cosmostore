// Archive storage classes (ADR-0102): which versions read, by their class and their restore's state.

fn classMeta(stored: StringView, restore: StringView) -> Vector<u8> {
    var meta = Vector<u8>.create();
    if (stored.length > 0) { metadataAdd(mut meta, STORAGE_CLASS_FIELD.bytes(), stored.bytes())!; }
    if (restore.length > 0) { metadataAdd(mut meta, RESTORE_FIELD.bytes(), restore.bytes())!; }
    return meta;
}

/// Every class but an archive one reads; an archive one only from its restore's ready time to its expiry.
@test
fn archivedVersionsReadOnlyWhileRestored() -> Result<void, TestFailure> {
    Check.isTrue(readableNow(classMeta("", "").view(), 1000), "STANDARD")?;
    Check.isTrue(readableNow(classMeta("GLACIER_IR", "").view(), 1000), "GLACIER_IR is not archived")?;
    Check.isFalse(readableNow(classMeta("GLACIER", "").view(), 1000), "GLACIER, never restored")?;
    Check.isFalse(readableNow(classMeta("DEEP_ARCHIVE", "").view(), 1000), "DEEP_ARCHIVE, never restored")?;
    let restored = classMeta("GLACIER", "2000 5000");
    Check.isFalse(readableNow(restored.view(), 1999), "restoring")?;
    Check.isTrue(readableNow(restored.view(), 2000), "ready")?;
    Check.isTrue(readableNow(restored.view(), 4999), "before its expiry")?;
    Check.isFalse(readableNow(restored.view(), 5000), "archived again")?;
    Check.isFalse(readableNow(classMeta("GLACIER", "junk").view(), 3000), "a state that does not parse")?;
    return Ok();
}

/// A restore's state counts only for the class it was made for (the M18 exit review): a restored GLACIER version that
/// lifecycle moves to DEEP_ARCHIVE is archived again; a state written without a class, as first written, still counts.
@test
fn restoresBelongToTheirClass() -> Result<void, TestFailure> {
    Check.isTrue(readableNow(classMeta("GLACIER", "2000 5000 GLACIER").view(), 3000), "its own class")?;
    Check.isFalse(readableNow(classMeta("DEEP_ARCHIVE", "2000 5000 GLACIER").view(), 3000), "another class")?;
    Check.isTrue(readableNow(classMeta("GLACIER", "2000 5000").view(), 3000), "no class named")?;
    Check.isTrue(isRestoreValue("2000 5000 DEEP_ARCHIVE".bytes()), "a state for DEEP_ARCHIVE")?;
    Check.isFalse(isRestoreValue("2000 5000 STANDARD".bytes()), "not an archive class")?;
    return Ok();
}
