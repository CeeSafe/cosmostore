// The IAM API's records (ADR-0104): the record's round trip, and the API's users, keys and roles merged with the
// files', a name once.

fn iamPolicy(name: StringView, action: StringView) -> IamPolicy {
    var text = textOf("{\"Version\":\"2012-10-17\",\"Statement\":{\"Effect\":\"Allow\",\"Action\":\"");
    text.append(action)!;
    text.append("\",\"Resource\":\"*\"}}")!;
    return IamPolicy { name: copyBytes(name.bytes())!, text: copyBytes(text.bytes())! };
}

fn iamUserOf(name: StringView, key: StringView, active: bool) -> IamUser {
    var keys = Vector<IamKey>.create();
    keys.push(
        IamKey {
            accessKey: copyBytes(key.bytes())!,
            secret: copyBytes("s3cret/key".bytes())!,
            active: active,
            createdMs: 5,
        },
    )!;
    var policies = Vector<IamPolicy>.create();
    policies.push(iamPolicy("reads", "s3:GetObject"))!;
    policies.push(iamPolicy("lists", "s3:ListBucket"))!;
    var id = textOf("AIDA");
    id.append(name)!;
    return IamUser {
        name: copyBytes(name.bytes())!,
        id: copyBytes(id.bytes())!,
        createdMs: 3,
        keys: keys,
        policies: policies,
        path: copyBytes("/".bytes())!,
        tags: Vector<IamTag>.create(),
        attached: Vector<Vector<u8>>.create(),
    };
}

fn sampleIam() -> IamState {
    var s = IamState.empty();
    s.users.push(iamUserOf("alice", "AKIAALICE00000000001", true))!;
    s.users.push(iamUserOf("bob", "AKIABOB0000000000001", false))!;
    var policies = Vector<IamPolicy>.create();
    policies.push(iamPolicy("all", "s3:*"))!;
    s.roles.push(IamRole {
        name: copyBytes("deployer".bytes())!,
        id: copyBytes("AROADEPLOYER".bytes())!,
        createdMs: 4,
        trust: copyBytes("{\"Version\":\"2012-10-17\",\"Statement\":[]}".bytes())!,
        policies: policies,
        maxSeconds: 3600,
        path: copyBytes("/".bytes())!,
        tags: Vector<IamTag>.create(),
        attached: Vector<Vector<u8>>.create(),
        description: Vector<u8>.create(),
    })!;
    return s;
}

/// The record is read back as written.
@test
fn iamStatesRoundTrip() -> Result<void, TestFailure> {
    let s = sampleIam();
    let bytes = encodeIamState(borrow s)!;
    let back = decodeIamState(bytes.view())!!;
    Check.equalBytes(bytes.view(), encodeIamState(borrow back)!.view())?;
    Check.equalU64(2, back.users.length as u64)?;
    Check.isFalse(back.users[1].keys[0].active, "an inactive key stays so")?;
    Check.isTrue(
        decodeIamState("{\"version\":3,\"users\":[],\"roles\":[]}".bytes())!.isNull(),
        "a version this does not read",
    )?;
    return Ok();
}

/// The API's active keys after the file's; its users, with their joined policies, after the file's, whose names give
/// way; without a users file, the file's keys are the account's; and the roles likewise.
@test
fn iamRecordsMergeWithTheFiles() -> Result<void, TestFailure> {
    let iam = sampleIam();
    let fileKeys = parseCredentials("AKIAACCOUNT000000001 account/secret\nAKIAFILEALICE0000001 file/secret\n".bytes())!;
    var keys = withIamKeys(fileKeys, borrow iam)!;
    Check.equalU64(3, keys.length as u64)?; // bob's key is inactive
    Check.equalBytes("AKIAALICE00000000001".bytes(), keys[2].accessKey.view())?;
    // Without a users file: the file's keys are the account's.
    var skipped = Vector<Vector<u8>>.create();
    let users = withIamUsers(null, keys.view(), borrow iam, mut skipped).ok()!!;
    Check.equalU64(2, users.account.length as u64)?;
    Check.isTrue(applyUsers(mut keys, borrow users).isOk(), "users applied")?;
    Check.equalBytes("".bytes(), keys[0].user.view())?;
    Check.isFalse(keys[0].revoked, "an account key")?;
    Check.equalBytes("alice".bytes(), keys[2].user.view())?;
    Check.isTrue(findBytes(keys[2].policyText.view(), "s3:ListBucket".bytes(), 0).isSome(), "both policies joined")?;
    // A users file naming alice: the API's alice is kept, the file's skipped.
    var fileText = textOf("account AKIAACCOUNT000000001\nalice:AIDAFILEALICE AKIAFILEALICE0000001 ");
    fileText.append(READER_POLICY)!;
    fileText.append("\n")!;
    let file = parseUsersFile(fileText.bytes()).ok()!;
    var skipped2 = Vector<Vector<u8>>.create();
    let merged = withIamUsers(Some(file), keys.view(), borrow iam, mut skipped2).ok()!!;
    Check.equalU64(1, skipped2.length as u64)?;
    Check.equalU64(2, merged.users.length as u64)?; // the API's alice and bob
    // Roles: a file role named as the API's gives way.
    var fileRoles = Vector<StsRole>.create();
    fileRoles.push(
        StsRole {
            name: copyBytes("deployer".bytes())!,
            maxSeconds: 900,
            policy: parseIdentityPolicy(READER_POLICY.bytes())!,
            removed: false,
            trust: Vector<u8>.create(),
            id: Vector<u8>.create(),
        },
    )!;
    fileRoles.push(
        StsRole {
            name: copyBytes("reader".bytes())!,
            maxSeconds: 900,
            policy: parseIdentityPolicy(READER_POLICY.bytes())!,
            removed: false,
            trust: Vector<u8>.create(),
            id: Vector<u8>.create(),
        },
    )!;
    var skipped3 = Vector<Vector<u8>>.create();
    let roles = withIamRoles(fileRoles, borrow iam, mut skipped3)!;
    Check.equalU64(2, roles.length as u64)?;
    Check.equalBytes("reader".bytes(), roles[0].name.view())?;
    Check.equalBytes("deployer".bytes(), roles[1].name.view())?;
    Check.equalU64(3600, roles[1].maxSeconds)?;
    return Ok();
}

/// A user made with no policy yet (CreateUser, then CreateAccessKey) is in the set, allowed nothing.
@test
fn iamUsersWithoutPoliciesAreAllowedNothing() -> Result<void, TestFailure> {
    var iam = IamState.empty();
    var user = iamUserOf("carol", "AKIACAROL00000000001", true);
    user.policies = Vector<IamPolicy>.create();
    iam.users.push(user)!;
    let fileKeys = parseCredentials("AKIAACCOUNT000000001 account/secret\n".bytes())!;
    var keys = withIamKeys(fileKeys, borrow iam)!;
    var skipped = Vector<Vector<u8>>.create();
    let users = withIamUsers(null, keys.view(), borrow iam, mut skipped).ok()!!;
    Check.isTrue(applyUsers(mut keys, borrow users).isOk(), "a user with no policy applied")?;
    Check.equalBytes("carol".bytes(), keys[1].user.view())?;
    Check.isFalse(keys[1].revoked, "its key works")?;
    return Ok();
}

/// The records read from a store: none there is an empty state of generation 0; a record that does not decode is no
/// snapshot (the sets in use stay); a record written is read with its generation.
@test
fn iamSnapshotsComeFromTheStore() -> Result<void, TestFailure> {
    let dir = scratchDirectory("iam-snapshot");
    var s = ObjectStore.open(dir.view(), spaceConfig(0, 0))!;
    let none = iamSnapshotOf(borrow s)!;
    Check.equalU64(0, none.generation)?;
    Check.equalU64(0, none.state.users.length as u64)?;
    s.createBucket(IAM_BUCKET)!;
    let _ = s.putObject(IAM_BUCKET, IAM_STATE_KEY, "application/json", "not json".bytes(), PutCondition.None)!;
    Check.isTrue(iamSnapshotOf(borrow s).isNull(), "a record that does not decode")?;
    let state = sampleIam();
    let bytes = encodeIamState(borrow state)!;
    let _ = s.putObject(IAM_BUCKET, IAM_STATE_KEY, "application/json", bytes.view(), PutCondition.None)!;
    let read = iamSnapshotOf(borrow s)!;
    Check.isTrue(read.generation > 0, "a generation")?;
    Check.equalU64(2, read.state.users.length as u64)?;
    return Ok();
}

fn outcomeName(o: borrow IamOutcome) -> StringView => match (o) {
    IamOutcome.Done(_, _, _, _, _) => "Done",
    IamOutcome.NotReady => "NotReady",
    IamOutcome.NoSuchEntity => "NoSuchEntity",
    IamOutcome.EntityAlreadyExists => "EntityAlreadyExists",
    IamOutcome.LimitExceeded => "LimitExceeded",
    IamOutcome.DeleteConflict => "DeleteConflict",
    IamOutcome.MalformedPolicyDocument => "MalformedPolicyDocument",
    IamOutcome.Conflict => "Conflict",
};

fn iamCall(s: borrow mut ObjectStore, c: IamCall, files: Slice<Vector<u8>>) -> Vector<u8> {
    let roles = Vector<Vector<u8>>.create();
    return match (applyIamCall(s, borrow c, files, roles.view(), 1000)) {
        Ok(o) => copyBytes(outcomeName(borrow o).bytes())!,
        Err(_) => copyBytes("Err".bytes())!,
    };
}

fn iamName(text: StringView) -> Vector<u8> => copyBytes(text.bytes())!;

/// The calls' changes, and their refusals as IAM's: a name twice, a file's name, two keys at most, a user with keys or
/// policies kept, a policy that does not parse; a key made inactive leaves the set.
@test
fn iamCallsChangeTheRecord() -> Result<void, TestFailure> {
    let dir = scratchDirectory("iam-calls");
    var s = ObjectStore.open(dir.view(), spaceConfig(0, 0))!;
    var files = Vector<Vector<u8>>.create();
    files.push(iamName("filer"))!;
    Check.equalBytes("Done".bytes(), iamCall(mut s, IamCall.CreateUser(iamName("dev")), files.view()).view())?;
    Check.equalBytes(
        "EntityAlreadyExists".bytes(),
        iamCall(mut s, IamCall.CreateUser(iamName("DEV")), files.view()).view(),
    )?;
    Check.equalBytes(
        "EntityAlreadyExists".bytes(),
        iamCall(mut s, IamCall.CreateUser(iamName("filer")), files.view()).view(),
    )?;
    for (i in 0..2) {
        Check.equalBytes("Done".bytes(), iamCall(mut s, IamCall.CreateAccessKey(iamName("dev")), files.view()).view())?;
    }
    Check.equalBytes(
        "LimitExceeded".bytes(),
        iamCall(mut s, IamCall.CreateAccessKey(iamName("dev")), files.view()).view(),
    )?;
    Check.equalBytes(
        "NoSuchEntity".bytes(),
        iamCall(mut s, IamCall.CreateAccessKey(iamName("nobody")), files.view()).view(),
    )?;
    Check.equalBytes(
        "MalformedPolicyDocument".bytes(),
        iamCall(
            mut s,
            IamCall.PutUserPolicy(iamName("dev"), iamName("p"), iamName("{\"Statement\":\"no\"}")),
            files.view(),
        ).view(),
    )?;
    Check.equalBytes(
        "Done".bytes(),
        iamCall(
            mut s,
            IamCall.PutUserPolicy(iamName("dev"), iamName("p"), copyBytes(READER_POLICY.bytes())!),
            files.view(),
        ).view(),
    )?;
    Check.equalBytes(
        "DeleteConflict".bytes(),
        iamCall(mut s, IamCall.DeleteUser(iamName("dev")), files.view()).view(),
    )?;
    // A key made inactive is not in the set built from the record.
    let snapshot = iamSnapshotOf(borrow s)!;
    let key = copyBytes(snapshot.state.users[0].keys[0].accessKey.view())!;
    Check.equalBytes(
        "Done".bytes(),
        iamCall(mut s, IamCall.UpdateAccessKey(iamName("dev"), copyBytes(key.view())!, false), files.view()).view(),
    )?;
    let after = iamSnapshotOf(borrow s)!;
    let keys = withIamKeys(Vector<Credential>.create(), borrow after.state)!;
    Check.equalU64(1, keys.length as u64)?;
    Check.isFalse(keys[0].accessKey.view() == key.view(), "the inactive key left out")?;
    // Emptied, the user goes.
    for (k in 0..after.state.users[0].keys.length) {
        let id = copyBytes(after.state.users[0].keys[k].accessKey.view())!;
        Check.equalBytes(
            "Done".bytes(),
            iamCall(mut s, IamCall.DeleteAccessKey(iamName("dev"), id), files.view()).view(),
        )?;
    }
    Check.equalBytes(
        "Done".bytes(),
        iamCall(mut s, IamCall.DeleteUserPolicy(iamName("dev"), iamName("p")), files.view()).view(),
    )?;
    Check.equalBytes("Done".bytes(), iamCall(mut s, IamCall.DeleteUser(iamName("dev")), files.view()).view())?;
    Check.equalU64(0, iamSnapshotOf(borrow s)!.state.users.length as u64)?;
    return Ok();
}

/// A trust policy lets the account when it names the account (its id, its root, or `*`), and a user when it names the
/// user's ARN or the account; a Deny that counts wins; a statement of another action does not count.
@test
fn trustPoliciesDecideWhoAssumes() -> Result<void, TestFailure> {
    let root =
        "{\"Statement\":{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"arn:aws:iam::000000000000:root\"},\"Action\":\"sts:AssumeRole\"}}";
    let alice =
        "{\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":[\"arn:aws:iam::000000000000:user/alice\"]},\"Action\":\"sts:AssumeRole\"}]}";
    let denied =
        "{\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":\"*\",\"Action\":\"sts:*\"},{\"Effect\":\"Deny\",\"Principal\":{\"AWS\":\"arn:aws:iam::000000000000:user/bob\"},\"Action\":\"sts:AssumeRole\"}]}";
    let other = "{\"Statement\":{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"*\"},\"Action\":\"sts:TagSession\"}}";
    let none: Vector<u8>? = null;
    let a: Vector<u8>? = Some(copyBytes("alice".bytes())!);
    let b: Vector<u8>? = Some(copyBytes("bob".bytes())!);
    Check.isTrue(trustAllows(root.bytes(), none.asBorrow())!, "the account, by its root")?;
    Check.isTrue(trustAllows(root.bytes(), a.asBorrow())!, "a user, the account named")?;
    Check.isTrue(trustAllows(alice.bytes(), a.asBorrow())!, "a user named")?;
    Check.isFalse(trustAllows(alice.bytes(), b.asBorrow())!, "a user not named")?;
    // What it cannot decide fails closed (the M19 exit review), and is refused when a role is made.
    let conditioned =
        "{\"Statement\":{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"*\"},\"Action\":\"sts:AssumeRole\",\"Condition\":{\"StringEquals\":{\"aws:PrincipalArn\":\"x\"}}}}";
    let notPrincipal =
        "{\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"*\"},\"Action\":\"sts:AssumeRole\"},{\"Effect\":\"Deny\",\"NotPrincipal\":{\"AWS\":\"x\"},\"Action\":\"sts:AssumeRole\"}]}";
    let wildDeny =
        "{\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"*\"},\"Action\":\"sts:AssumeRole\"},{\"Effect\":\"Deny\",\"Principal\":{\"AWS\":\"*\"},\"Action\":\"sts:Assume*\"}]}";
    Check.isFalse(trustAllows(conditioned.bytes(), a.asBorrow())!, "a Condition is not ignored")?;
    Check.isFalse(trustAllows(notPrincipal.bytes(), a.asBorrow())!, "a NotPrincipal is not skipped")?;
    Check.isFalse(trustAllows(wildDeny.bytes(), a.asBorrow())!, "a wildcard Deny is not missed")?;
    Check.isFalse(trustAllows(alice.bytes(), none.asBorrow())!, "the account, not named")?;
    Check.isTrue(trustAllows(denied.bytes(), a.asBorrow())!, "anyone")?;
    Check.isFalse(trustAllows(denied.bytes(), b.asBorrow())!, "but a Deny")?;
    Check.isFalse(trustAllows(other.bytes(), none.asBorrow())!, "another action")?;
    Check.isFalse(trustAllows("not json".bytes(), none.asBorrow())!, "a document that does not parse")?;
    return Ok();
}

/// A users file's user with no live key is still the file's (ADR-0106 §1.6): listed, and its name not the API's.
@test
fn fileUsersWithoutKeysAreTheFiles() -> Result<void, TestFailure> {
    let none = Vector<Credential>.create();
    var fileKeys = Vector<Vector<u8>>.create();
    fileKeys.push(copyBytes("carol AIDACAROL01".bytes())!)!;
    let state = IamState.empty();
    let files = fileUsersOf(none.view(), fileKeys.view(), borrow state)!;
    Check.equalU64(1, files.length as u64)?;
    var names = Vector<Vector<u8>>.create();
    for (i in 0..files.length) { names.push(copyBytes(nameOfUserKey(files[i].view()))!)!; }
    Check.isTrue(namedIn(names.view(), "CAROL".bytes()), "its name, in any case, not the API's to make")?;
    return Ok();
}

fn managedPolicyOf(name: StringView, path: StringView, first: StringView, second: StringView) -> IamManagedPolicy {
    var versions = Vector<IamPolicyVersion>.create();
    versions.push(IamPolicyVersion { number: 1, text: iamPolicy("v1", first).text, createdMs: 7 })!;
    versions.push(IamPolicyVersion { number: 2, text: iamPolicy("v2", second).text, createdMs: 8 })!;
    var tags = Vector<IamTag>.create();
    tags.push(IamTag { key: copyBytes("team".bytes())!, value: copyBytes("data".bytes())! })!;
    return IamManagedPolicy {
        name: copyBytes(name.bytes())!,
        id: copyBytes("ANPAEXAMPLE".bytes())!,
        path: copyBytes(path.bytes())!,
        description: copyBytes("for tests".bytes())!,
        createdMs: 7,
        updatedMs: 8,
        tags: tags,
        versions: versions,
        defaultVersion: 2,
        nextVersion: 3,
    };
}

/// A state with a managed policy (its version 2 the default), a group holding alice with an inline policy and the
/// managed one attached, and AWS's read-only S3 policy attached to the role.
fn sampleIamWithGroups() -> IamState {
    var s = sampleIam();
    s.managed.push(managedPolicyOf("writers", "/team/", "s3:DeleteObject", "s3:PutObject"))!;
    var members = Vector<Vector<u8>>.create();
    members.push(copyBytes("Alice".bytes())!)!; // names are matched as IAM matches them, case aside
    var policies = Vector<IamPolicy>.create();
    policies.push(iamPolicy("tagging", "s3:PutObjectTagging"))!;
    var attached = Vector<Vector<u8>>.create();
    attached.push(copyBytes("arn:aws:iam::000000000000:policy/team/writers".bytes())!)!;
    s.groups.push(IamGroup {
        name: copyBytes("editors".bytes())!,
        id: copyBytes("AGPAEDITORS".bytes())!,
        path: copyBytes("/".bytes())!,
        createdMs: 9,
        members: members,
        policies: policies,
        attached: attached,
    })!;
    s.roles[0].attached.push(copyBytes("arn:aws:iam::aws:policy/AmazonS3ReadOnlyAccess".bytes())!)!;
    s.users[0].tags.push(IamTag { key: copyBytes("cost".bytes())!, value: copyBytes("42".bytes())! })!;
    s.users[0].path = copyBytes("/staff/".bytes())!;
    return s;
}

/// Form 2 of the record (ADR-0108 §1) is read back as written: groups, managed policies with their versions, paths,
/// tags and attachments.
@test
fn iamRecordsOfForm2RoundTrip() -> Result<void, TestFailure> {
    let s = sampleIamWithGroups();
    let bytes = encodeIamState(borrow s)!;
    let back = decodeIamState(bytes.view())!!;
    Check.equalBytes(bytes.view(), encodeIamState(borrow back)!.view())?;
    Check.equalU64(1, back.groups.length as u64)?;
    Check.equalBytes("Alice".bytes(), back.groups[0].members[0].view())?;
    Check.equalU64(1, back.managed.length as u64)?;
    Check.equalU64(2, back.managed[0].versions.length as u64)?;
    Check.equalU64(2, back.managed[0].defaultVersion as u64)?;
    Check.equalU64(3, back.managed[0].nextVersion as u64)?;
    Check.equalBytes("/team/".bytes(), back.managed[0].path.view())?;
    Check.equalBytes("data".bytes(), back.managed[0].tags[0].value.view())?;
    Check.equalBytes("/staff/".bytes(), back.users[0].path.view())?;
    Check.equalBytes("42".bytes(), back.users[0].tags[0].value.view())?;
    Check.equalU64(1, back.roles[0].attached.length as u64)?;
    return Ok();
}

/// A record of form 1, M19's, is read with none of form 2's: paths `/`, no tags, groups or managed policies.
@test
fn iamRecordsOfForm1StillRead() -> Result<void, TestFailure> {
    let form1 = """
        {"version":1,"users":[{"name":"alice","id":"AIDAALICE","created":3,"keys":[],"policies":[]}],
        "roles":[{"name":"deployer","id":"AROAD","created":4,"trust":"{}","maxSeconds":900,"policies":[]}]}
        """;
    let back = decodeIamState(form1.bytes())!!;
    Check.equalBytes("/".bytes(), back.users[0].path.view())?;
    Check.equalU64(0, back.users[0].tags.length as u64)?;
    Check.equalU64(0, back.users[0].attached.length as u64)?;
    Check.equalBytes("/".bytes(), back.roles[0].path.view())?;
    Check.equalU64(0, back.roles[0].description.length as u64)?;
    Check.equalU64(0, back.groups.length as u64)?;
    Check.equalU64(0, back.managed.length as u64)?;
    // Written again, it is form 2.
    let again = encodeIamState(borrow back)!;
    Check.isTrue(findBytes(again.view(), "\"version\":2".bytes(), 0).isSome(), "written as form 2")?;
    return Ok();
}

/// A user's identity policy joins its own, its groups' inline and attached ones, and an attached policy's default
/// version only; a role's joins AWS's policy attached to it (ADR-0108 §2, §4).
@test
fn iamPoliciesJoinGroupsAndManagedOnes() -> Result<void, TestFailure> {
    let iam = sampleIamWithGroups();
    let alice = joinedPolicy(userPolicyTexts(borrow iam, 0)!.view())!!;
    Check.isTrue(findBytes(alice.view(), "s3:GetObject".bytes(), 0).isSome(), "her own")?;
    Check.isTrue(findBytes(alice.view(), "s3:PutObjectTagging".bytes(), 0).isSome(), "her group's inline one")?;
    Check.isTrue(findBytes(alice.view(), "s3:PutObject\"".bytes(), 0).isSome(), "the default version attached")?;
    Check.isTrue(findBytes(alice.view(), "s3:DeleteObject".bytes(), 0).isNull(), "not a version not the default")?;
    Check.isTrue(parseIdentityPolicy(alice.view()).isOk(), "a policy")?;
    let bob = joinedPolicy(userPolicyTexts(borrow iam, 1)!.view())!!;
    Check.isTrue(findBytes(bob.view(), "s3:PutObjectTagging".bytes(), 0).isNull(), "not in the group")?;
    let role = joinedPolicy(rolePolicyTexts(borrow iam, 0)!.view())!!;
    Check.isTrue(findBytes(role.view(), "s3:List*".bytes(), 0).isSome(), "AWS's read-only policy")?;
    Check.isTrue(parseIdentityPolicy(role.view()).isOk(), "a policy")?;
    // The set's user is given the joined policy.
    let fileKeys = parseCredentials("AKIAACCOUNT000000001 account/secret\n".bytes())!;
    let keys = withIamKeys(fileKeys, borrow iam)!;
    var skipped = Vector<Vector<u8>>.create();
    let users = withIamUsers(null, keys.view(), borrow iam, mut skipped).ok()!!;
    Check.isTrue(findBytes(users.users[0].policyText.view(), "s3:PutObjectTagging".bytes(), 0).isSome(), "joined")?;
    return Ok();
}

/// AWS's four managed policies each parse as an identity policy; any other of AWS's is none.
@test
fn awsManagedPoliciesParse() -> Result<void, TestFailure> {
    let names = ["AdministratorAccess", "AmazonS3FullAccess", "AmazonS3ReadOnlyAccess", "IAMReadOnlyAccess"];
    for (n in names) {
        var arn = textOf("arn:aws:iam::aws:policy/");
        arn.append(n)!;
        let doc = awsManagedPolicy(arn.bytes()) ?? { return Err(TestFailure.create("one of the four")); };
        Check.isTrue(parseIdentityPolicy(doc.bytes()).isOk(), "it parses")?;
    }
    Check.isTrue(awsManagedPolicy("arn:aws:iam::aws:policy/AmazonEC2FullAccess".bytes()).isNull(), "not one")?;
    Check.isTrue(awsManagedPolicy("arn:aws:iam::aws:policy/".bytes()).isNull(), "no name")?;
    Check.isTrue(
        managedArnIs("arn:aws:iam::000000000000:policy/team/writers".bytes(), "/team/".bytes(), "writers".bytes()),
        "the account's",
    )?;
    Check.isFalse(
        managedArnIs("arn:aws:iam::000000000000:policy/writers".bytes(), "/team/".bytes(), "writers".bytes()),
        "its path counts",
    )?;
    return Ok();
}
