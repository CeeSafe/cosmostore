// Server-side encryption (ADR-0046): the chunks an object is sealed in and where they are stored, sealing and opening
// them with lib/std's AES-256-GCM (ceesafec 0.45.0; CEESAFE_GAPS.md, G33), the envelope kept with a version, the key
// file, the request's fields, and a bucket's default. SSE-S3 and SSE-C are served on writes (PUT, POST, copies,
// multipart uploads) and reads; SSE-KMS, and the fields on an operation that does not take them, are refused
// (`sseRefusal`).
import web_core;
import web_http;
import web_server;

// SSE_FIELD, SSE_CHUNK, SSE_TAG, sseChunks and sseStoredLength are the store's (`src/store/sealed.cee`).
const SSE_KEY_BYTES: usize = 32;
const SSE_NONCE_BYTES: usize = 12;
/// A data key sealed: its 32 bytes and the tag.
const SSE_WRAPPED_BYTES: usize = 48;
const MAX_KEY_ID: usize = 32;

// ---- Chunks (ADR-0046 §2) ----

/// A chunk's nonce: the part number (0 for an object that is not multipart) and the chunk's index in the part.
fn sseNonce(part: u32, chunk: u64) -> [u8; 12] {
    var nonce = [0u8; 12];
    for (i in 0..4) { nonce[i] = truncate<u8>(part >> truncate<u32>(i * 8)); }
    for (i in 0..8) { nonce[4 + i] = truncate<u8>(chunk >> truncate<u64>(i * 8)); }
    return nonce;
}

/// The stored bytes to read for a range of a part's plaintext.
struct SseSpan {
    /// The first chunk to open, and how many.
    firstChunk: u64;
    chunks: u64;
    /// The stored bytes of those chunks, from the part's start.
    storedFrom: u64;
    storedTo: u64;
    /// The plaintext bytes of the first chunk before the range.
    skip: u64;
}

/// The chunks that hold plaintext `from..to` of a part of `n` bytes (`from < to <= n`, or the whole of an empty
/// part): each is read and opened whole.
fn sseSpan(n: u64, from: u64, to: u64) -> SseSpan {
    let stride = SSE_CHUNK + SSE_TAG;
    if (n == 0 || to <= from) {
        return SseSpan { firstChunk: 0, chunks: 1, storedFrom: 0, storedTo: if (n == 0) SSE_TAG else 0, skip: 0 };
    }
    let first = from / SSE_CHUNK;
    let last = (to - 1) / SSE_CHUNK;
    let stored = sseStoredLength(n);
    let end = (last + 1) * stride;
    return SseSpan {
        firstChunk: first,
        chunks: last - first + 1,
        storedFrom: first * stride,
        storedTo: if (end < stored) end else stored,
        skip: from - first * SSE_CHUNK,
    };
}

// ---- Sealing (ADR-0046 §2) ----

/// A chunk's associated data: 1 for the last chunk of its part, else 0.
fn sseFlag(last: bool) -> [u8; 1] => [if (last) 1u8 else 0u8];

/// A cipher for a 32-byte key (the length is the type's, so there is one).
fn sseCipher(key: borrow [u8; 32]) -> Aes256Gcm? => Aes256Gcm.create(key[..]);

/// The key a multipart part is sealed under: HMAC-SHA256 of its salt under the object's data key. Each upload of a
/// part has a random salt of its own, so a part uploaded again under its number is sealed under another key, and no
/// nonce repeats under a key (ADR-0046 §2).
fn ssePartKey(dataKey: borrow [u8; 32], salt: Slice<u8>) -> [u8; 32] {
    var mac = HmacSha256.create(dataKey[..]);
    mac.update("cosmostore sse part v1".bytes());
    mac.update(salt);
    return mac.finish();
}

/// Seals a part's plaintext as it arrives: every 64 KiB a chunk, its ciphertext and tag, is given out, after the
/// part's header (a multipart part's salt) if it has one.
struct SseSealer {
    cipher: Aes256Gcm;
    part: u32;
    /// The part's plaintext bytes and chunks, and the next chunk's index.
    size: u64;
    chunks: u64;
    chunk: u64;
    /// The plaintext of the chunk being filled.
    pending: Vector<u8>;
    /// Bytes given out before the first chunk: a multipart part's salt; empty once given, or for one PUT.
    header: Vector<u8>;
    headerLength: u64;
    /// SSE-C: the request's key, under which the ETag is a digest of the plaintext's MD5, not that MD5 (ADR-0046
    /// §6, `sseCustomerEtag`).
    etagKey: [u8; 32]?;

    /// A sealer for a part of `size` plaintext bytes under `key`; null if the cipher refuses the key.
    fn create(key: borrow [u8; 32], part: u32, size: u64) -> SseSealer? => match (sseCipher(key)) {
        Some(c) => Some(
            SseSealer {
                cipher: c,
                part: part,
                size: size,
                chunks: sseChunks(size),
                chunk: 0,
                pending: Vector<u8>.create(),
                header: Vector<u8>.create(),
                headerLength: 0,
                etagKey: null,
            },
        ),
        null => null,
    };

    /// A sealer for a multipart part of `size` plaintext bytes: under the part key of `salt`, which it gives out
    /// first (ADR-0046 §2).
    fn createPart(dataKey: borrow [u8; 32], salt: [u8; 16], size: u64) -> Result<SseSealer?, AllocError> {
        var partKey = ssePartKey(dataKey, salt[..]);
        var made = SseSealer.create(borrow partKey, 0, size);
        for (i in 0..32) { partKey[i] = 0; }
        match (made.asBorrowMut()) {
            Some(s) => {
                s.header.extend(salt[..])?;
                s.headerLength = SSE_PART_HEADER;
            }
            null => {}
        }
        return Ok(made);
    }

    /// The bytes the part is stored in: its header and its chunks.
    fn storedLength(borrow this) -> u64 => this.headerLength + sseStoredLength(this.size);

    drop {
        match (this.etagKey.asBorrowMut()) {
            Some(k) => {
                for (i in 0..32) { k[i] = 0; }
            }
            null => {}
        }
    }

    fn emitHeader(borrow mut this, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
        if (this.header.length > 0) {
            out.extend(this.header.view())?;
            this.header.clear();
        }
        return Ok();
    }

    fn emit(borrow mut this, out: borrow mut Vector<u8>, last: bool) -> Result<void, AllocError> {
        let flag = sseFlag(last);
        let tag = this.cipher.seal(sseNonce(this.part, this.chunk), flag[..], this.pending.viewMut());
        out.extend(this.pending.view())?;
        out.extend(tag[..])?;
        this.pending.clear();
        this.chunk += 1;
        return Ok();
    }

    /// Takes plaintext and appends to `out` every chunk it completes. A full chunk is held until more plaintext
    /// comes, so whether it is the last is known without the size (a POST form's file has none in advance).
    fn feed(borrow mut this, data: Slice<u8>, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
        this.emitHeader(out)?;
        var at: usize = 0;
        while (at < data.length) {
            if (this.pending.length == SSE_CHUNK as usize) { this.emit(out, false)?; }
            let room = SSE_CHUNK as usize - this.pending.length;
            let take = if (data.length - at < room) data.length - at else room;
            this.pending.extend(data[at..at + take])?;
            at += take;
        }
        return Ok();
    }

    /// The part's end: its last chunk (an empty part's one empty chunk too).
    fn finish(borrow mut this, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
        this.emitHeader(out)?;
        if (this.pending.length > 0 || this.chunk == 0) { this.emit(out, true)?; }
        return Ok();
    }
}

/// Opens a part's stored chunks as they are read, from chunk `first` on.
struct SseOpener {
    cipher: Aes256Gcm;
    part: u32;
    /// The part's plaintext bytes, its chunks, and the next one's index.
    size: u64;
    chunks: u64;
    chunk: u64;
    /// The stored bytes of the chunk being read.
    pending: Vector<u8>;

    fn create(key: borrow [u8; 32], part: u32, size: u64, first: u64) -> SseOpener? => match (sseCipher(key)) {
        Some(c) => Some(
            SseOpener {
                cipher: c,
                part: part,
                size: size,
                chunks: sseChunks(size),
                chunk: first,
                pending: Vector<u8>.create(),
            },
        ),
        null => null,
    };

    /// The stored bytes of the next chunk: its plaintext's and the tag's.
    fn nextStored(borrow this) -> usize {
        let before = this.chunk * SSE_CHUNK;
        let left = if (this.size > before) this.size - before else 0;
        return (if (left < SSE_CHUNK) left else SSE_CHUNK) as usize + SSE_TAG as usize;
    }

    /// Takes stored bytes and appends to `out` the plaintext of every chunk they complete. False when a chunk does
    /// not open (it was changed, moved or cut short) or there are bytes after the part's last chunk: nothing of it
    /// is given out.
    fn feed(borrow mut this, stored: Slice<u8>, out: borrow mut Vector<u8>) -> Result<bool, AllocError> {
        var at: usize = 0;
        while (at < stored.length) {
            if (this.chunk >= this.chunks) { return Ok(false); }
            let whole = this.nextStored();
            let room = whole - this.pending.length;
            let take = if (stored.length - at < room) stored.length - at else room;
            this.pending.extend(stored[at..at + take])?;
            at += take;
            if (this.pending.length < whole) { break; }
            let plain = whole - SSE_TAG as usize;
            var tag = [0u8; 16];
            for (i in 0..16) { tag[i] = this.pending[plain + i]; }
            let flag = sseFlag(this.chunk + 1 >= this.chunks);
            let nonce = sseNonce(this.part, this.chunk);
            if (!this.cipher.open(nonce, flag[..], mut this.pending.viewMut()[0..plain], tag)) { return Ok(false); }
            out.extend(this.pending.view()[0..plain])?;
            this.pending.clear();
            this.chunk += 1;
        }
        return Ok(true);
    }

    /// Whether every stored byte given was a whole chunk's: a read that ends inside one was cut short.
    fn isWhole(borrow this) -> bool => this.pending.length == 0;
}

/// The stored bytes to read for a range of a sealed object's plaintext, one PUT's or a multipart object's.
struct SseRange {
    storedFrom: u64;
    storedTo: u64;
    /// The part the range starts in (its index in the parts; 0 for one PUT), the chunk of that part it starts in,
    /// and that chunk's plaintext bytes before the range.
    part: usize;
    chunk: u64;
    skip: u64;
    /// A multipart object whose range starts after its first part's header: where that header is stored, to be read
    /// apart. Null when the stored range starts with a header, or for one PUT.
    headerAt: u64?;
}

/// The stored range for plaintext `from..to` (`from < to <= size`) of a sealed object: one PUT's chunks, or, with
/// `partSizes`, a multipart object's parts, each its header and its chunks (ADR-0046 §2).
fn sseRange(size: u64, partSizes: Slice<u64>, from: u64, to: u64) -> SseRange {
    if (partSizes.length == 0) {
        let s = sseSpan(size, from, to);
        return SseRange {
            storedFrom: s.storedFrom,
            storedTo: s.storedTo,
            part: 0,
            chunk: s.firstChunk,
            skip: s.skip,
            headerAt: null,
        };
    }
    // The first part the range touches, and where its plaintext and its stored bytes start.
    var i: usize = 0;
    var plainAt: u64 = 0;
    var storedAt: u64 = 0;
    while (i + 1 < partSizes.length && from >= plainAt + partSizes[i]) {
        plainAt += partSizes[i];
        storedAt += SSE_PART_HEADER + sseStoredLength(partSizes[i]);
        i += 1;
    }
    let firstTo = if (to < plainAt + partSizes[i]) to else plainAt + partSizes[i];
    let first = sseSpan(partSizes[i], from - plainAt, firstTo - plainAt);
    var r = SseRange {
        storedFrom: storedAt,
        storedTo: storedAt + SSE_PART_HEADER + first.storedTo,
        part: i,
        chunk: first.firstChunk,
        skip: first.skip,
        headerAt: null,
    };
    if (first.firstChunk > 0) {
        r.storedFrom = storedAt + SSE_PART_HEADER + first.storedFrom;
        r.headerAt = storedAt;
    }
    // The last part it touches.
    var j = i;
    while (j + 1 < partSizes.length && to > plainAt + partSizes[j]) {
        plainAt += partSizes[j];
        storedAt += SSE_PART_HEADER + sseStoredLength(partSizes[j]);
        j += 1;
    }
    if (j > i) { r.storedTo = storedAt + SSE_PART_HEADER + sseSpan(partSizes[j], 0, to - plainAt).storedTo; }
    return r;
}

/// Opens a sealed object's stored bytes as they are read: one PUT's chunks, or a multipart object's parts, each a
/// header (its salt, which gives the part's key) and its chunks.
struct SseStream {
    dataKey: [u8; 32];
    /// Multipart: the plaintext sizes of the parts, from the first one read; empty for one PUT.
    sizes: Vector<u64>;
    part: usize;
    /// The current part's opener; null while its header is read.
    opener: SseOpener?;
    /// Multipart: the stored bytes of the current part's chunks not yet read.
    left: u64;
    header: Vector<u8>;

    /// One PUT's chunks from chunk `first`.
    fn single(dataKey: borrow [u8; 32], size: u64, first: u64) -> SseStream? {
        let opener = SseOpener.create(dataKey, 0, size, first);
        if (opener.isNull()) { return null; }
        return SseStream {
            dataKey: [0u8; 32],
            sizes: Vector<u64>.create(),
            part: 0,
            opener: opener,
            left: 0,
            header: Vector<u8>.create(),
        };
    }

    /// A multipart object's parts of `sizes`, from chunk `first` of the first one. When `first` is not 0 the stored
    /// bytes start after that part's header, whose salt is given.
    fn multipart(
        dataKey: borrow [u8; 32],
        sizes: Slice<u64>,
        first: u64,
        salt: Slice<u8>,
    ) -> Result<SseStream?, AllocError> {
        var s = SseStream {
            dataKey: [0u8; 32],
            sizes: Vector<u64>.create(),
            part: 0,
            opener: null,
            left: 0,
            header: Vector<u8>.create(),
        };
        for (i in 0..32) { s.dataKey[i] = dataKey[i]; }
        s.sizes.extend(sizes)?;
        if (first > 0) {
            if (salt.length != SSE_PART_HEADER as usize || sizes.length == 0) { return Ok(null); }
            if (!s.startPart(salt, first)) { return Ok(null); }
        }
        return Ok(Some(s));
    }

    /// The current part's opener, from chunk `first`, under the key of its salt.
    fn startPart(borrow mut this, salt: Slice<u8>, first: u64) -> bool {
        var partKey = ssePartKey(borrow this.dataKey, salt);
        let size = this.sizes[this.part];
        this.opener = SseOpener.create(borrow partKey, 0, size, first);
        for (i in 0..32) { partKey[i] = 0; }
        let skipped = first * (SSE_CHUNK + SSE_TAG);
        let stored = sseStoredLength(size);
        this.left = if (skipped < stored) stored - skipped else 0;
        return this.opener.isSome();
    }

    /// Takes stored bytes and appends to `out` the plaintext of every chunk they complete; false when one does not
    /// open, or the bytes go on past the last part.
    fn feed(borrow mut this, stored: Slice<u8>, out: borrow mut Vector<u8>) -> Result<bool, AllocError> {
        if (this.sizes.length == 0) {
            return match (this.opener.asBorrowMut()) {
                Some(o) => o.feed(stored, out),
                null => Ok(false),
            };
        }
        var at: usize = 0;
        while (at < stored.length) {
            if (this.part >= this.sizes.length) { return Ok(false); }
            if (this.opener.isNull()) {
                let want = SSE_PART_HEADER as usize - this.header.length;
                let take = if (stored.length - at < want) stored.length - at else want;
                this.header.extend(stored[at..at + take])?;
                at += take;
                if (this.header.length == SSE_PART_HEADER as usize) {
                    var salt = [0u8; 16];
                    for (i in 0..16) { salt[i] = this.header[i]; }
                    this.header.clear();
                    if (!this.startPart(salt[..], 0)) { return Ok(false); }
                }
                continue;
            }
            let have = (stored.length - at) as u64;
            let take = if (have < this.left) have else this.left;
            let piece = stored[at..at + take as usize];
            let opened = match (this.opener.asBorrowMut()) {
                Some(o) => o.feed(piece, out)?,
                null => false,
            };
            if (!opened) { return Ok(false); }
            at += take as usize;
            this.left -= take;
            if (this.left == 0) {
                let whole = match (this.opener.asBorrow()) {
                    Some(o) => o.isWhole(),
                    null => false,
                };
                if (!whole) { return Ok(false); }
                this.opener = null;
                this.part += 1;
            }
        }
        return Ok(true);
    }

    /// Whether the bytes read end at a chunk's end: a read that ends inside a chunk or a header was cut short.
    fn isWhole(borrow this) -> bool {
        if (this.header.length > 0) { return false; }
        return match (this.opener.asBorrow()) {
            Some(o) => o.isWhole(),
            null => true,
        };
    }

    drop {
        for (i in 0..32) { this.dataKey[i] = 0; }
    }
}

/// The associated data of a wrapped data key: its mode (ADR-0046 §3).
fn sseModeText(customer: bool) -> StringView => if (customer) "c" else "s3";

/// An envelope's mode, as its text holds it: `s3`, `c` or `kms` (ADR-0055).
fn envelopeMode(e: borrow SseEnvelope) -> StringView => if (e.kms) "kms" else sseModeText(e.customer);

/// A data key sealed under `master` (a master key, or the request's key for SSE-C) with `nonce`, which must be
/// random: the envelope's last two fields.
fn wrapDataKey(master: borrow [u8; 32], mode: StringView, dataKey: borrow [u8; 32], nonce: [u8; 12]) -> [u8; 48]? {
    let cipher = match (sseCipher(master)) {
        Some(c) => c,
        null => { return null; }
    };
    var sealed = [0u8; 32];
    for (i in 0..32) { sealed[i] = dataKey[i]; }
    let tag = cipher.seal(nonce, mode.bytes(), mut sealed[..]);
    var wrapped = [0u8; 48];
    for (i in 0..32) { wrapped[i] = sealed[i]; }
    for (i in 0..16) { wrapped[32 + i] = tag[i]; }
    return wrapped;
}

/// The data key of an envelope, opened under `master`; null when it is not the key that sealed it.
fn unwrapDataKey(master: borrow [u8; 32], e: borrow SseEnvelope) -> [u8; 32]? {
    let cipher = match (sseCipher(master)) {
        Some(c) => c,
        null => { return null; }
    };
    var key = [0u8; 32];
    var tag = [0u8; 16];
    for (i in 0..32) { key[i] = e.wrapped[i]; }
    for (i in 0..16) { tag[i] = e.wrapped[32 + i]; }
    if (!cipher.open(e.nonce, envelopeMode(e).bytes(), mut key[..], tag)) { return null; }
    return key;
}

// ---- The envelope (ADR-0046 §3) ----

/// What a version keeps to be opened again: the data key, sealed under a master key or the request's.
struct SseEnvelope {
    /// SSE-C: the data key is sealed under the request's key, and `keyId` is `-`.
    customer: bool;
    /// SSE-KMS (ADR-0055): sealed under the KMS key `keyId` names.
    kms: bool;
    keyId: Vector<u8>;
    nonce: [u8; 12];
    wrapped: [u8; 48];
}

fn isKeyId(id: Slice<u8>) -> bool {
    if (id.length == 0 || id.length > MAX_KEY_ID) { return false; }
    for (i in 0..id.length) {
        let c = id[i];
        let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-';
        if (!ok) { return false; }
    }
    return true;
}

/// The envelope as the field holds it: `v1.<mode>.<key id>.<nonce>.<wrapped data key>`, the last two in hex.
fn encodeEnvelope(e: borrow SseEnvelope, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    out.extend("v1.".bytes())?;
    out.extend(envelopeMode(e).bytes())?;
    out.push('.')?;
    out.extend(e.keyId.view())?;
    out.push('.')?;
    appendHexBytes(out, e.nonce[..])?;
    out.push('.')?;
    appendHexBytes(out, e.wrapped[..])?;
    return Ok();
}

/// `text` as hex into `out`, whose length it must fill exactly.
fn hexInto(text: Slice<u8>, out: SliceMut<u8>) -> bool {
    if (text.length != out.length * 2) { return false; }
    for (i in 0..out.length) {
        let hi = hexValue(text[i * 2]);
        let lo = hexValue(text[i * 2 + 1]);
        if (hi.isNull() || lo.isNull()) { return false; }
        out[i] = ((hi ?? 0) << 4) | (lo ?? 0);
    }
    return true;
}

/// A stored envelope; null for a field that is not one.
fn decodeEnvelope(text: Slice<u8>) -> Result<SseEnvelope?, AllocError> {
    var pieces = [0usize; 6];
    var count: usize = 1;
    for (i in 0..text.length) {
        if (text[i] != '.') { continue; }
        if (count == 5) { return Ok(null); }
        pieces[count] = i + 1;
        count += 1;
    }
    if (count != 5) { return Ok(null); }
    pieces[5] = text.length + 1;
    if (text[pieces[0]..pieces[1] - 1] != "v1".bytes()) { return Ok(null); }
    let mode = text[pieces[1]..pieces[2] - 1];
    let customer = mode == "c".bytes();
    let kms = mode == "kms".bytes();
    if (!customer && !kms && mode != "s3".bytes()) { return Ok(null); }
    let id = text[pieces[2]..pieces[3] - 1];
    if (!isKeyId(id) || customer != (id == "-".bytes())) { return Ok(null); }
    var e = SseEnvelope {
        customer: customer,
        kms: kms,
        keyId: copyBytes(id)?,
        nonce: [0u8; 12],
        wrapped: [0u8; 48],
    };
    if (!hexInto(text[pieces[3]..pieces[4] - 1], mut e.nonce[..])) { return Ok(null); }
    if (!hexInto(text[pieces[4]..pieces[5] - 1], mut e.wrapped[..])) { return Ok(null); }
    return Ok(Some(e));
}

// ---- The key file (ADR-0046 §4) ----

struct MasterKey {
    id: Vector<u8>;
    key: [u8; 32];
}

enum KeyFileFault {
    /// No key at all.
    Empty,
    /// A line that is not `<key id> <base64 of 32 bytes>`.
    BadLine,
    BadId,
    BadKey,
    /// Two keys with one id.
    Duplicate,
    OutOfMemory,
}

fn keyFileOom(e: AllocError) -> KeyFileFault => KeyFileFault.OutOfMemory;

/// The master keys of a key file: the first seals new objects, every one opens what was sealed under it.
fn parseKeyFile(text: Slice<u8>) -> Result<Vector<MasterKey>, KeyFileFault> {
    var keys = Vector<MasterKey>.create();
    var at: usize = 0;
    while (at < text.length) {
        let end = pieceEnd(text, at, '\n');
        let line = trimBlank(text[at..pieceEnd(text[0..end], at, '#')]);
        at = end + 1;
        if (line.length == 0) { continue; }
        var space = pieceEnd(line, 0, ' ');
        let tab = pieceEnd(line, 0, '\t');
        if (tab < space) { space = tab; }
        if (space >= line.length) { return Err(KeyFileFault.BadLine); }
        let id = line[0..space];
        let encoded = trimBlank(line[space + 1..]);
        if (!isKeyId(id) || id == "-".bytes()) { return Err(KeyFileFault.BadId); }
        for (i in 0..keys.length) {
            if (keys[i].id.view() == id) { return Err(KeyFileFault.Duplicate); }
        }
        var raw = Vector<u8>.create();
        let decoded = match (decodeBase64(encoded, mut raw)) {
            Ok(d) => d,
            Err(e) => { return Err(keyFileOom(e)); }
        };
        if (!decoded || raw.length != SSE_KEY_BYTES) { return Err(KeyFileFault.BadKey); }
        var key = MasterKey {
            id: match (copyBytes(id)) {
                Ok(c) => c,
                Err(e) => { return Err(keyFileOom(e)); }
            },
            key: [0u8; 32],
        };
        for (i in 0..SSE_KEY_BYTES) { key.key[i] = raw[i]; }
        match (keys.push(key)) {
            Ok() => {}
            Err(e) => { return Err(keyFileOom(e)); }
        }
    }
    if (keys.length == 0) { return Err(KeyFileFault.Empty); }
    return Ok(keys);
}

// ---- The request's fields (ADR-0046 §5, §6) ----

/// What a request asks for a new object, or brings to read one.
enum SseRequest {
    None,
    /// SSE-S3: `x-amz-server-side-encryption: AES256`.
    Managed,
    /// SSE-C: the request's key.
    Customer([u8; 32]),
    /// SSE-KMS (ADR-0055): `aws:kms`, and the KMS key named (an empty name: the KMS key file's first key).
    Kms(KmsKeyName),
}

/// A KMS key's id, as `x-amz-server-side-encryption-aws-kms-key-id` names it (its last `/`-piece, so an ARN or an
/// alias path names the same key): 0 to 32 of `A-Z a-z 0-9 _ -`.
struct KmsKeyName {
    length: usize;
    bytes: [u8; 32];

    fn view(borrow this) -> Slice<u8> => this.bytes[0..this.length];
}

/// The KMS key a request names: null when the text is not a key id.
fn kmsKeyNameOf(text: Slice<u8>) -> KmsKeyName? {
    let t = trimBlank(text);
    var from: usize = 0;
    for (i in 0..t.length) {
        if (t[i] == '/') { from = i + 1; }
    }
    let id = t[from..];
    if (!isKeyId(id)) { return null; }
    var name = KmsKeyName { length: id.length, bytes: [0u8; 32] };
    for (i in 0..id.length) { name.bytes[i] = id[i]; }
    return name;
}

/// The encryption a request's fields ask for: the SSE-S3 field (`AES256`, or `aws:kms` with the KMS key's id), or
/// the three customer fields (the algorithm, the key in base64 and its MD5 in base64), not both. An encryption
/// context and `aws:kms:dsse` are NotImplemented (ADR-0055).
fn sseOfFields(
    managed: Slice<u8>?,
    kmsKeyId: Slice<u8>?,
    context: Slice<u8>?,
    algorithm: Slice<u8>?,
    key: Slice<u8>?,
    keyMd5: Slice<u8>?,
) -> Result<SseRequest, S3Fail> {
    let invalid = S3Fail.Code(S3Code.InvalidArgument);
    let customer = algorithm.isSome() || key.isSome() || keyMd5.isSome();
    let kms = match (managed) {
        Some(m) => trimBlank(m) == "aws:kms".bytes(),
        null => false,
    };
    // The KMS fields go only with `aws:kms`.
    if (!kms && (kmsKeyId.isSome() || context.isSome())) { return Err(invalid); }
    match (managed) {
        Some(m) => {
            if (customer) { return Err(invalid); }
            if (trimBlank(m) == "AES256".bytes()) { return Ok(SseRequest.Managed); }
            if (kms) {
                if (context.isSome()) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
                return match (kmsKeyId) {
                    Some(id) => match (kmsKeyNameOf(id)) {
                        Some(name) => Ok(SseRequest.Kms(name)),
                        null => Err(invalid),
                    },
                    null => Ok(SseRequest.Kms(KmsKeyName { length: 0, bytes: [0u8; 32] })),
                };
            }
            if (trimBlank(m) == "aws:kms:dsse".bytes()) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            return Err(invalid);
        }
        null => {}
    }
    if (!customer) { return Ok(SseRequest.None); }
    if (trimBlank(algorithm ?? "".bytes()) != "AES256".bytes()) { return Err(invalid); }
    var raw = Vector<u8>.create();
    if (!decodeBase64(trimBlank(key ?? "".bytes()), mut raw)? || raw.length != SSE_KEY_BYTES) { return Err(invalid); }
    var digest = Vector<u8>.create();
    if (!decodeBase64(trimBlank(keyMd5 ?? "".bytes()), mut digest)? || digest.length != 16) { return Err(invalid); }
    let ok = sameSignature(digest.view(), Md5.of(raw.view())[..]);
    var out = [0u8; 32];
    for (i in 0..SSE_KEY_BYTES) {
        out[i] = raw[i];
        raw[i] = 0; // the key is not left behind in a freed buffer
    }
    if (!ok) { return Err(invalid); }
    return Ok(SseRequest.Customer(out));
}

/// Whether a field's name is one of the encryption fields, a copy source's included.
fn isSseField(name: Slice<u8>) -> bool =>
    startsWithBytes(name, SSE_FIELD.bytes()) ||
        startsWithBytes(name, "x-amz-copy-source-server-side-encryption".bytes());

/// Whether a request asks for encryption or brings a key (ADR-0046 §7).
fn asksEncryption(req: borrow S3Request) -> bool {
    for (i in 0..req.headers.length) {
        if (isSseField(req.headers[i].name.view())) { return true; }
    }
    return false;
}

/// The prefixes of SSE-C's fields, a request's own and a copy source's.
const SSE_CUSTOMER: StringView = "x-amz-server-side-encryption-customer-";
const SSE_SOURCE_CUSTOMER: StringView = "x-amz-copy-source-server-side-encryption-customer-";

/// Why the request's encryption fields are not ones its operation takes, or null when they are (ADR-0046 §5 to §7):
/// SSE-S3's field goes on PutObject, CopyObject and CreateMultipartUpload, and elsewhere is InvalidArgument, as S3
/// answers; SSE-C's on those, UploadPart, UploadPartCopy, CompleteMultipartUpload, GetObject, HeadObject and
/// GetObjectAttributes; a copy source's SSE-C fields on a copy. Anything else (SSE-KMS's fields, or the fields on
/// another operation) is NotImplemented, so nothing asked to be sealed is stored in the clear.
fn sseRefusal(req: borrow S3Request) -> S3Code? {
    if (req.key.length == 0) { return S3Code.NotImplemented; }
    let copying = headerOf(req, "x-amz-copy-source").isSome();
    let m = req.method;
    let put = isMethod(m, Method.Put) && req.onlyParams("");
    let create = isMethod(m, Method.Post) && req.hasParam("uploads") && req.onlyParams("uploads");
    let part = isMethod(m, Method.Put) && req.hasParam("uploadId") && req.hasParam("partNumber") &&
        req.onlyParams("partNumber,uploadId");
    let complete = isMethod(m, Method.Post) && req.hasParam("uploadId") && req.onlyParams("uploadId");
    let read = (isMethod(m, Method.Get) || isMethod(m, Method.Head)) && (req.onlyParams(
        "versionId,partNumber,response-content-type,response-content-language,response-expires,response-cache-control,response-content-disposition,response-content-encoding",
    ) || (req.hasParam("attributes") && req.onlyParams("attributes,versionId")));
    for (i in 0..req.headers.length) {
        let name = req.headers[i].name.view();
        if (!isSseField(name)) { continue; }
        let kmsField = name == "x-amz-server-side-encryption-aws-kms-key-id".bytes() ||
            name == "x-amz-server-side-encryption-context".bytes();
        if (name == SSE_FIELD.bytes() || kmsField) {
            // On UploadPart and Complete, clients repeat the upload's fields: the upload's key governs
            // (`checkPartFields`).
            if (put || create || part || complete) { continue; }
            if (read) { return S3Code.InvalidArgument; }
            return S3Code.NotImplemented;
        }
        let fine = if (startsWithBytes(name, SSE_CUSTOMER.bytes())) {
            put || create || part || complete || read
        } else if (startsWithBytes(name, SSE_SOURCE_CUSTOMER.bytes())) {
            copying && (put || part)
        } else {
            false
        };
        if (!fine) { return S3Code.NotImplemented; }
    }
    return null;
}

/// Whether a field holds an SSE-C key: `...-customer-key`, a request's or a copy source's (not its MD5).
fn isCustomerKeyField(name: Slice<u8>) -> bool =>
    name == "x-amz-server-side-encryption-customer-key".bytes() ||
        name == "x-amz-copy-source-server-side-encryption-customer-key".bytes();

/// Whether the request brings an SSE-C key, its own or a copy source's: only over TLS (ADR-0046 §6).
fn bringsCustomerKey(req: borrow S3Request) -> bool {
    for (i in 0..req.headers.length) {
        let name = req.headers[i].name.view();
        if (startsWithBytes(name, SSE_CUSTOMER.bytes()) || startsWithBytes(name, SSE_SOURCE_CUSTOMER.bytes())) {
            return true;
        }
    }
    return false;
}

/// The encryption a request's fields ask for.
fn sseRequestOf(req: borrow S3Request) -> Result<SseRequest, S3Fail> =>
    sseOfFields(
        headerOf(req, SSE_FIELD),
        headerOf(req, "x-amz-server-side-encryption-aws-kms-key-id"),
        headerOf(req, "x-amz-server-side-encryption-context"),
        headerOf(req, "x-amz-server-side-encryption-customer-algorithm"),
        headerOf(req, "x-amz-server-side-encryption-customer-key"),
        headerOf(req, "x-amz-server-side-encryption-customer-key-md5"),
    );

/// The SSE-C key a request brings to read or write a sealed object: its own fields, or a copy source's.
fn sseCustomerKeyOf(req: borrow S3Request, source: bool) -> Result<[u8; 32]?, S3Fail> {
    let fields = if (source) {
        sseOfFields(
            null,
            null,
            null,
            headerOf(req, "x-amz-copy-source-server-side-encryption-customer-algorithm"),
            headerOf(req, "x-amz-copy-source-server-side-encryption-customer-key"),
            headerOf(req, "x-amz-copy-source-server-side-encryption-customer-key-md5"),
        )?
    } else {
        sseOfFields(
            null,
            null,
            null,
            headerOf(req, "x-amz-server-side-encryption-customer-algorithm"),
            headerOf(req, "x-amz-server-side-encryption-customer-key"),
            headerOf(req, "x-amz-server-side-encryption-customer-key-md5"),
        )?
    };
    return match (fields) {
        SseRequest.Customer(k) => Ok(Some(k)),
        _ => Ok(null),
    };
}

/// A part's SSE-S3 or SSE-KMS fields (ADR-0055): clients repeat the upload's on UploadPart, and the part is sealed
/// under the upload's key whatever they name, as S3 and s3-tests do. Into an upload in the clear, or an SSE-C one,
/// they are InvalidArgument: nothing asked to be sealed goes in the clear.
fn checkPartFields(req: borrow S3Request, uploadEnvelope: Slice<u8>) -> Result<void, S3Fail> {
    let asked = headerOf(req, SSE_FIELD).isSome() ||
        headerOf(req, "x-amz-server-side-encryption-aws-kms-key-id").isSome();
    if (asked && (uploadEnvelope.length == 0 || isCustomerEnvelope(uploadEnvelope))) {
        return Err(S3Fail.Code(S3Code.InvalidArgument));
    }
    return Ok();
}

/// Whether a stored envelope is SSE-C's, or SSE-KMS's.
fn isCustomerEnvelope(field: Slice<u8>) -> bool => startsWithBytes(field, "v1.c.".bytes());
fn isKmsEnvelope(field: Slice<u8>) -> bool => startsWithBytes(field, "v1.kms.".bytes());

/// The answer's fields for an object sealed with `envelope`: SSE-S3's `AES256`; SSE-KMS's `aws:kms` and its key's id
/// (ADR-0055); SSE-C's algorithm and, when the request brought it, its key's MD5.
fn sseAnswerOf(exchange: borrow mut Exchange, envelope: Slice<u8>, customer: [u8; 32]?) -> Result<void, S3Fail> {
    if (isCustomerEnvelope(envelope)) {
        match (customer) {
            Some(_) => { sseAnswerFields(exchange, customer)?; }
            null => { exchange.header("x-amz-server-side-encryption-customer-algorithm", "AES256".bytes())?; }
        }
        return Ok();
    }
    if (isKmsEnvelope(envelope)) {
        exchange.header(SSE_FIELD, "aws:kms".bytes())?;
        match (decodeEnvelope(envelope)?) {
            Some(e) => { exchange.header("x-amz-server-side-encryption-aws-kms-key-id", e.keyId.view())?; }
            null => {}
        }
        return Ok();
    }
    exchange.header(SSE_FIELD, "AES256".bytes())?;
    return Ok();
}

/// The answer's fields for a sealed object: SSE-S3's, or SSE-C's algorithm and the MD5 of the request's key.
fn sseAnswerFields(exchange: borrow mut Exchange, customer: [u8; 32]?) -> Result<void, S3Fail> {
    match (customer) {
        Some(k) => {
            exchange.header("x-amz-server-side-encryption-customer-algorithm", "AES256".bytes())?;
            var md5 = Vector<u8>.create();
            appendBase64(mut md5, Md5.of(k[..])[..])?;
            exchange.header("x-amz-server-side-encryption-customer-key-md5", md5.view())?;
        }
        null => { exchange.header(SSE_FIELD, "AES256".bytes())?; }
    }
    return Ok();
}

// ---- Sealing a new object, opening a stored one (ADR-0046 §2 to §6) ----

/// A new object's data key, and its envelope as the metadata field holds it.
struct NewSeal {
    dataKey: [u8; 32];
    field: Vector<u8>;
    /// SSE-C's, sealed under the request's key; SSE-KMS's, under a KMS key (ADR-0055). Neither has the plaintext's
    /// MD5 for its ETag.
    customer: bool;
    kms: bool;

    drop {
        for (i in 0..32) { this.dataKey[i] = 0; }
    }
}

/// A new object's data key wrapped under `wrapping` (a master key, or the request's for SSE-C).
fn newSealUnder(wrapping: borrow [u8; 32], customer: bool, kms: bool, keyId: Slice<u8>) -> Result<NewSeal, S3Fail> {
    let failed = S3Fail.Code(S3Code.InternalError);
    var dataKey = [0u8; 32];
    var nonce = [0u8; 12];
    if (Random.fill(mut dataKey[..]).isErr() || Random.fill(mut nonce[..]).isErr()) { return Err(failed); }
    var e = SseEnvelope { customer: customer, kms: kms, keyId: copyBytes(keyId)?, nonce: nonce, wrapped: [0u8; 48] };
    e.wrapped = match (wrapDataKey(wrapping, envelopeMode(borrow e), borrow dataKey, nonce)) {
        Some(w) => w,
        null => { return Err(failed); }
    };
    var field = Vector<u8>.create();
    encodeEnvelope(borrow e, mut field)?;
    var seal = NewSeal { dataKey: [0u8; 32], field: field, customer: customer, kms: kms };
    for (i in 0..32) {
        seal.dataKey[i] = dataKey[i];
        dataKey[i] = 0;
    }
    return Ok(seal);
}

/// SSE-S3 for a new object: a random data key, wrapped under the first master key with a random nonce.
fn newManagedSeal(keys: Slice<MasterKey>) -> Result<NewSeal, S3Fail> {
    if (keys.length == 0) { return Err(S3Fail.Code(S3Code.InvalidRequest)); } // `serve` has no key file
    return newSealUnder(borrow keys[0].key, false, false, keys[0].id.view());
}

/// SSE-KMS for a new object (ADR-0055): its data key wrapped under the KMS key named, or the KMS key file's first.
/// Without a KMS key file, NotImplemented, as before; a name the file does not have is InvalidArgument.
fn newKmsSeal(kmsKeys: Slice<MasterKey>, name: borrow KmsKeyName) -> Result<NewSeal, S3Fail> {
    if (kmsKeys.length == 0) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
    if (name.length == 0) { return newSealUnder(borrow kmsKeys[0].key, false, true, kmsKeys[0].id.view()); }
    for (i in 0..kmsKeys.length) {
        if (kmsKeys[i].id.view() == name.view()) {
            return newSealUnder(borrow kmsKeys[i].key, false, true, kmsKeys[i].id.view());
        }
    }
    return Err(S3Fail.Code(S3Code.InvalidArgument));
}

/// The seal a new object gets for what is asked: SSE-S3, SSE-C under the request's key, SSE-KMS, or none.
fn newSeal(keys: Slice<MasterKey>, kmsKeys: Slice<MasterKey>, asked: borrow SseRequest) -> Result<NewSeal?, S3Fail> =>
    match (asked) {
        SseRequest.None => Ok(null),
        SseRequest.Managed => Ok(Some(newManagedSeal(keys)?)),
        SseRequest.Customer(k) => Ok(Some(newSealUnder(k, true, false, "-".bytes())?)),
        SseRequest.Kms(name) => Ok(Some(newKmsSeal(kmsKeys, name)?)),
    };

/// An SSE-C object's ETag (ADR-0046 §6): HMAC-SHA256 of its plaintext's MD5 under the request's key, its first 16
/// bytes. It is not the MD5, which would let whoever reads a listing test a guess of the content, and it is the same
/// for the same bytes under the same key, as a part uploaded again must be for Complete to find it.
fn sseCustomerEtag(key: borrow [u8; 32], md5: borrow [u8; 16]) -> [u8; 16] {
    var mac = HmacSha256.create(key[..]);
    mac.update("cosmostore sse-c etag v1".bytes());
    mac.update(md5[..]);
    let digest = mac.finish();
    var etag = [0u8; 16];
    for (i in 0..16) { etag[i] = digest[i]; }
    return etag;
}

/// The ETag of a sealed body whose plaintext's MD5 is `md5`: that MD5, or SSE-C's digest of it.
fn sealedEtag(sealer: borrow SseSealer, md5: [u8; 16]) -> [u8; 16] => match (sealer.etagKey) {
    Some(k) => sseCustomerEtag(borrow k, borrow md5),
    null => md5,
};

/// A sealer for one PUT's body of `size` bytes under a new object's data key.
fn sealerOf(seal: borrow NewSeal, size: u64, customer: [u8; 32]?) -> Result<SseSealer, S3Fail> {
    var sealer = match (SseSealer.create(borrow seal.dataKey, 0, size)) {
        Some(s) => s,
        null => { return Err(S3Fail.Code(S3Code.InternalError)); }
    };
    if (seal.customer) { sealer.etagKey = customer; }
    // SSE-KMS's ETag is not the plaintext's MD5 either: a digest of it under the object's data key (ADR-0055).
    if (seal.kms) { sealer.etagKey = Some(seal.dataKey); }
    return Ok(sealer);
}

/// SSE-C's key, when that is what is asked.
fn customerKeyOf(asked: borrow SseRequest) -> [u8; 32]? => match (asked) {
    SseRequest.Customer(k) => Some(k),
    _ => null,
};

/// What a new object is sealed with (ADR-0046 §5, §6): the request's fields, else its bucket's default encryption.
async fn sseAskedFor(app: borrow S3App, req: borrow S3Request) -> Result<SseRequest, S3Fail> {
    let asked = sseRequestOf(req)?;
    match (asked) {
        SseRequest.None => {}
        _ => { return Ok(asked); }
    }
    return await bucketDefaultSse(app, req.bucket.view());
}

/// A bucket's default encryption (ADR-0046 §5): SSE-S3, SSE-KMS, or none. Read under the lock, without I/O. A
/// directory bucket's objects are always sealed (ADR-0080 §3): with none set, SSE-S3 when this server has its keys.
async fn bucketDefaultSse(app: borrow S3App, bucket: StringView) -> Result<SseRequest, S3Fail> {
    let fallback = if (inDirectoryBucket(bucket) && app.sseKeys.length > 0) SseRequest.Managed else SseRequest.None;
    if (app.encryptedBuckets.load() == 0) { return Ok(fallback); }
    var guard = await lockStore(app)?;
    let store = guard.data();
    let stored = match (store.bucketConfig(bucket, BUCKET_CONFIG_ENCRYPTION)) {
        Ok(v) => v,
        Err(StoreError.NoSuchBucket) => { return Ok(SseRequest.None); } // the write reports it
        Err(e) => { return Err(storeFail(e, 0)); }
    };
    if (stored.length == 0) { return Ok(fallback); }
    return Ok(defaultOfStored(stored.view()));
}

/// Whether a directory bucket's request asks for the encryption its bucket has (ADR-0080 §3): S3 lets a request
/// name only that, or nothing.
fn directoryEncryptionAgrees(asked: borrow SseRequest, bucket: borrow SseRequest) -> bool => match (asked) {
    SseRequest.None => true,
    SseRequest.Managed => match (bucket) {
        SseRequest.Managed => true,
        SseRequest.None => true,
        _ => false,
    },
    SseRequest.Kms(n) => match (bucket) {
        SseRequest.Kms(d) => n.length == 0 || n.view() == d.view(),
        _ => false,
    },
    SseRequest.Customer(_) => false,
};

/// A stored default (`BucketConfig` kind 11) as a request: `AES256`, or `aws:kms` with its key's id after a space.
fn defaultOfStored(stored: Slice<u8>) -> SseRequest {
    if (stored.length == 0) { return SseRequest.None; }
    if (startsWithBytes(stored, "aws:kms".bytes())) {
        let id = if (stored.length > 8) stored[8..] else "".bytes();
        return SseRequest.Kms(kmsKeyNameOf(id) ?? KmsKeyName { length: 0, bytes: [0u8; 32] });
    }
    return SseRequest.Managed;
}

// ---- A bucket's default encryption: Get-, Put- and DeleteBucketEncryption (ADR-0046 §5) ----

async fn recountEncrypted(app: borrow S3App) -> Result<void, S3Fail> {
    if (app.cluster) { return Ok(); } // the count stays at "some" (ADR-0060)
    var guard = await lockStore(app)?;
    let store = guard.data();
    app.encryptedBuckets.store(store.encryptedBucketCount());
    return Ok();
}

async fn getBucketEncryption(
    app: borrow S3App,
    req: borrow S3Request,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    let stored = await storeBucketConfig(app, req.bucket.view(), BUCKET_CONFIG_ENCRYPTION)?;
    if (stored.length == 0) { return Err(S3Fail.Code(S3Code.ServerSideEncryptionConfigurationNotFoundError)); }
    var body = Vector<u8>.create();
    xmlHead(mut body, "ServerSideEncryptionConfiguration")?;
    body.extend("<Rule><ApplyServerSideEncryptionByDefault>".bytes())?;
    if (startsWithBytes(stored.view(), "aws:kms".bytes())) {
        body.extend("<SSEAlgorithm>aws:kms</SSEAlgorithm>".bytes())?;
        if (stored.length > 8) { xmlElement(mut body, "KMSMasterKeyID", stored.view()[8..], false)?; }
    } else {
        body.extend("<SSEAlgorithm>AES256</SSEAlgorithm>".bytes())?;
    }
    body.extend(
        "</ApplyServerSideEncryptionByDefault><BucketKeyEnabled>false</BucketKeyEnabled></Rule></ServerSideEncryptionConfiguration>".bytes(),
    )?;
    return await sendXml(exchange, borrow body);
}

/// The default a `<ServerSideEncryptionConfiguration>` names: one rule of `AES256`. `aws:kms` and `aws:kms:dsse`
/// are NotImplemented; anything else is MalformedXML.
/// What a `<ServerSideEncryptionConfiguration>` stores: `AES256`, or `aws:kms` and its KMS key's id after a space
/// (ADR-0055). `aws:kms:dsse` is NotImplemented; anything else is MalformedXML.
fn parseBucketEncryption(xml: Slice<u8>) -> Result<Vector<u8>, S3Fail> {
    // The root element carries S3's namespace (`xmlns=`), so it is found by its name alone.
    if (findBytes(xml, "<ServerSideEncryptionConfiguration".bytes(), 0).isNull()) {
        return Err(S3Fail.Code(S3Code.MalformedXML));
    }
    let rule = match (elementText(xml, "ApplyServerSideEncryptionByDefault")) {
        Some(r) => r,
        null => { return Err(S3Fail.Code(S3Code.MalformedXML)); }
    };
    let algorithm = trimBlank(elementText(rule, "SSEAlgorithm") ?? "".bytes());
    if (algorithm == "AES256".bytes()) {
        if (elementText(rule, "KMSMasterKeyID").isSome()) { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
        return Ok(copyBytes("AES256".bytes())?);
    }
    if (algorithm == "aws:kms".bytes()) {
        var stored = copyBytes("aws:kms".bytes())?;
        match (elementText(rule, "KMSMasterKeyID")) {
            Some(id) => {
                let name = match (kmsKeyNameOf(id)) {
                    Some(n) => n,
                    null => { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
                };
                stored.push(' ')?;
                stored.extend(name.view())?;
            }
            null => {}
        }
        return Ok(stored);
    }
    if (algorithm == "aws:kms:dsse".bytes()) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
    return Err(S3Fail.Code(S3Code.MalformedXML));
}

async fn putBucketEncryption(
    app: borrow S3App,
    req: borrow S3Request,
    auth: Authenticated,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    let xml = await readSmallBody(auth, exchange, 65536)?;
    verifySmallBody(req, xml.view(), true)?;
    let stored = parseBucketEncryption(xml.view())?;
    // A default that could not be honoured is refused: SSE-S3 needs the key file; SSE-KMS the KMS key file (else
    // NotImplemented, as SSE-KMS is without it) and, when it names one, a key the file has.
    match (defaultOfStored(stored.view())) {
        SseRequest.Kms(name) => {
            if (app.kmsKeys.length == 0) { return Err(S3Fail.Code(S3Code.NotImplemented)); }
            if (name.length > 0) {
                var found = false;
                for (i in 0..app.kmsKeys.length) {
                    if (app.kmsKeys[i].id.view() == name.view()) { found = true; }
                }
                if (!found) { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
            }
        }
        _ => {
            if (app.sseKeys.length == 0) { return Err(S3Fail.Code(S3Code.InvalidRequest)); }
        }
    }
    await storeSetBucketConfig(app, req.bucket.view(), BUCKET_CONFIG_ENCRYPTION, stored.view())?;
    await recountEncrypted(app)?;
    await exchange.send(Status.ok(), "".bytes())?;
    return Ok();
}

async fn deleteBucketEncryption(
    app: borrow S3App,
    req: borrow S3Request,
    exchange: borrow mut Exchange,
) -> Result<void, S3Fail> {
    await storeSetBucketConfig(app, req.bucket.view(), BUCKET_CONFIG_ENCRYPTION, "".bytes())?;
    await recountEncrypted(app)?;
    await exchange.send(Status.noContent(), "".bytes())?;
    return Ok();
}

/// Why a stored envelope does not give its data key.
enum SseKeyFault {
    /// The field is not an envelope, or the key it names does not open it: InternalError.
    Broken,
    /// SSE-C: the request must bring the key.
    Customer,
    /// No key of the key file has the id: InternalError, and a line in the log.
    UnknownKey,
}

/// The data key of a stored SSE-S3 envelope, opened with the master key its id names.
fn managedDataKey(keys: Slice<MasterKey>, field: Slice<u8>) -> Result<[u8; 32], SseKeyFault> {
    let e = match (decodeEnvelope(field)) {
        Ok(Some(e)) => e,
        _ => { return Err(SseKeyFault.Broken); }
    };
    if (e.customer) { return Err(SseKeyFault.Customer); }
    for (i in 0..keys.length) {
        if (keys[i].id.view() == e.keyId.view()) {
            return match (unwrapDataKey(borrow keys[i].key, borrow e)) {
                Some(k) => Ok(k),
                null => Err(SseKeyFault.Broken),
            };
        }
    }
    return Err(SseKeyFault.UnknownKey);
}

/// The data key of a stored envelope with what the request brings (ADR-0046 §4, §6): SSE-S3's under the master key
/// its id names (no key may be brought: InvalidRequest), SSE-C's under the request's key (none brought:
/// InvalidRequest; another: InvalidRequest too, 400). A key id not in the key file is InternalError and a line in the log.
async fn sealedDataKey(app: borrow S3App, field: Slice<u8>, customer: [u8; 32]?) -> Result<[u8; 32], S3Fail> {
    if (isCustomerEnvelope(field)) {
        let key = match (customer) {
            Some(k) => k,
            null => { return Err(S3Fail.Code(S3Code.InvalidRequest)); }
        };
        let e = match (decodeEnvelope(field)?) {
            Some(e) => e,
            null => { return Err(S3Fail.Code(S3Code.InternalError)); }
        };
        // Another key is 400, as s3-tests has S3 answer (ADR-0046 §6).
        return match (unwrapDataKey(borrow key, borrow e)) {
            Some(k) => Ok(k),
            null => Err(S3Fail.Code(S3Code.InvalidRequest)),
        };
    }
    if (customer.isSome()) { return Err(S3Fail.Code(S3Code.InvalidRequest)); }
    // SSE-S3's master keys and SSE-KMS's keys are apart: an id names a key of its own kind (ADR-0055).
    let keys = if (isKmsEnvelope(field)) app.kmsKeys.view() else app.sseKeys.view();
    return match (managedDataKey(keys, field)) {
        Ok(k) => Ok(k),
        Err(SseKeyFault.Customer) => Err(S3Fail.Code(S3Code.InvalidRequest)),
        Err(SseKeyFault.UnknownKey) => {
            var line = Vector<u8>.create();
            line.extend(
                if (isKmsEnvelope(
                    field,
                )) "cosmostore: an object is sealed under a KMS key that is not in the KMS key file: ".bytes()
                    else "cosmostore: an object is sealed under a master key that is not in the key file: ".bytes(),
            )?;
            match (decodeEnvelope(field)) {
                Ok(Some(e)) => { line.extend(e.keyId.view())?; }
                _ => {}
            }
            line.push('\n')?;
            let _ = await AsyncConsole.writeError(StringView.fromUtf8(line.view()) ?? "");
            Err(S3Fail.Code(S3Code.InternalError))
        }
        Err(SseKeyFault.Broken) => Err(S3Fail.Code(S3Code.InternalError)),
    };
}

/// One read of a sealed body, on a worker thread: stored bytes from `reader` into `buf`, and the plaintext of the
/// chunks they complete appended to `plain`. Ok(0) at the end; DataCorrupt when a chunk does not open.
fn readOpened(
    reader: borrow mut ObjectReader,
    opener: borrow mut SseStream,
    buf: SliceMut<u8>,
    plain: borrow mut Vector<u8>,
) -> Result<usize, StoreError> {
    let n = reader.read(buf)?;
    if (n == 0) {
        if (!opener.isWhole()) { return Err(StoreError.DataCorrupt); } // cut short inside a chunk
        return Ok(0);
    }
    if (!opener.feed(buf[0..n], plain)?) { return Err(StoreError.DataCorrupt); }
    return Ok(n);
}

/// Sends `length` plaintext bytes of a sealed body, from `skip` bytes into the first chunk the reader holds
/// (ADR-0046 §2): every chunk is opened whole before any of it is sent.
async fn sendOpened(
    app: borrow S3App,
    exchange: borrow mut Exchange,
    reader: borrow mut ObjectReader,
    opener: borrow mut SseStream,
    skip: u64,
    length: u64,
) -> Result<void, S3Fail> {
    var plain = Vector<u8>.create();
    var skipping = skip;
    var left = length;
    match (reader.takeInline()) {
        Some(bytes) => {
            // An inline object is at most a few chunks, already in memory: opened without a worker thread.
            if (!opener.feed(bytes.view(), mut plain)? || !opener.isWhole()) {
                return Err(storeFail(StoreError.DataCorrupt, 0));
            }
            let from = if (skipping > plain.length as u64) plain.length else skipping as usize;
            let to = if (length < (plain.length - from) as u64) from + length as usize else plain.length;
            await exchange.write(plain.view()[from..to])?;
            return Ok();
        }
        null => {}
    }
    var buf = takeBodyBuffer(app, length + SSE_CHUNK + SSE_TAG)?;
    while (left > 0) {
        plain.clear();
        let chunk = buf.viewMut();
        let got = await Async.blocking(() => readOpened(reader, opener, chunk, mut plain));
        let n = match (got) {
            Ok(n) => n,
            Err(e) => { return Err(storeFail(e, 0)); }
        };
        if (n == 0) { break; } // shorter than planned: the response's length tells the client
        var from: usize = 0;
        if (skipping > 0) {
            from = if (skipping > plain.length as u64) plain.length else skipping as usize;
            skipping -= from as u64;
        }
        let have = (plain.length - from) as u64;
        let take = if (have > left) left else have;
        if (take > 0) { await exchange.write(plain.view()[from..from + take as usize])?; }
        left -= take;
    }
    giveBodyBuffer(app, buf);
    return Ok();
}
