// Parquet's pages written (ADR-0112 §1, §2, slice 4): a row group's columns, each one column chunk of v1 data pages,
// with a dictionary page when that is smaller than PLAIN, levels in the RLE/bit-packed hybrid, compressed by the
// chunk's codec, and statistics; then the footer, the inputs' schema kept as it was (Iceberg's field ids with it).
// A row group's bytes are made one at a time, so a file's memory is a row group's.

/// A data page holds this many levels at most, and starts at a row (a repetition level of 0).
const PQ_PAGE_LEVELS: usize = 20000;
/// A page is cut at a row's start once its values reach this many bytes (pyarrow's 1 MB): pages of wide values stay
/// far below the 64 MB the reader takes (the M23 exit review).
const PQ_PAGE_BYTES: usize = 1048576;
/// A dictionary holds this many values at most; a chunk with more is PLAIN.
const PQ_DICTIONARY_MAX: usize = 65535;
/// What compaction names itself as in a file's `created_by`.
const PQ_CREATED_BY: StringView = "CosmoStore compaction (ADR-0112)";

fn tInt(id: i16, v: i64) -> ThriftField => ThriftField { id: id, value: ThriftValue.Int(THRIFT_I32, v) };

fn tLong(id: i16, v: i64) -> ThriftField => ThriftField { id: id, value: ThriftValue.Int(THRIFT_I64, v) };

fn tBinary(id: i16, b: Slice<u8>) -> Result<ThriftField, AllocError> =>
    Ok(ThriftField { id: id, value: ThriftValue.Binary(copyBytes(b)?) });

fn tStruct(id: i16, fields: Vector<ThriftField>) -> ThriftField =>
    ThriftField { id: id, value: ThriftValue.Struct(fields) };

// ---- The hybrid ----

fn writeUleb(out: borrow mut Vector<u8>, value: u64) -> Result<void, AllocError> {
    var v = value;
    while (v >= 0x80) {
        out.push(truncate<u8>(v & 0x7F) | 0x80)?;
        v = v >> 7;
    }
    out.push(truncate<u8>(v))?;
    return Ok();
}

/// `values` of `width` bits in the RLE/bit-packed hybrid: a run of 8 or more equal values as an RLE run, the others
/// bit-packed 8 at a time (the last group padded, as the end of the hybrid may be).
fn writeHybrid(out: borrow mut Vector<u8>, values: Slice<u64>, width: u32) -> Result<void, AllocError> {
    var i: usize = 0;
    let bytes = ((width + 7) / 8) as usize;
    while (i < values.length) {
        var run: usize = 1;
        while (i + run < values.length && values[i + run] == values[i]) { run += 1; }
        if (run >= 8 || width == 0) {
            writeUleb(out, (run as u64) << 1)?;
            for (k in 0..bytes) { out.push(truncate<u8>(values[i] >> ((k * 8) as u64)))?; }
            i += run;
            continue;
        }
        // Eight values bit-packed: one group.
        writeUleb(out, (1u64 << 1) | 1)?;
        var acc: u64 = 0;
        var accBits: u32 = 0;
        for (k in 0..8) {
            let v = if (i + k < values.length) values[i + k] else 0;
            for (b in 0..width) {
                if ((v >> (b as u64)) & 1 != 0) { acc = acc | (1u64 << (accBits as u64)); }
                accBits += 1;
                if (accBits == 8) {
                    out.push(truncate<u8>(acc))?;
                    acc = 0;
                    accBits = 0;
                }
            }
        }
        i += if (values.length - i < 8) values.length - i else 8;
    }
    return Ok();
}

/// Levels for v1 pages: their length, 4 bytes, and the hybrid.
fn writeLevels(out: borrow mut Vector<u8>, levels: Slice<u8>, max: u32) -> Result<void, AllocError> {
    var values = Vector<u64>.create();
    for (l in levels) { values.push(l as u64)?; }
    var body = Vector<u8>.create();
    writeHybrid(mut body, values.view(), bitWidthOf(max))?;
    out.pushLE(truncate<u32>(body.length))?;
    out.extend(body.view())?;
    return Ok();
}

// ---- Values ----

/// A value written PLAIN (a BOOLEAN's bit is packed by the caller).
fn writePlainValue(out: borrow mut Vector<u8>, leaf: borrow PageLeaf, bytes: Slice<u8>) -> Result<void, AllocError> {
    if (leaf.physical == PQ_BYTE_ARRAY) { out.pushLE(truncate<u32>(bytes.length))?; }
    out.extend(bytes)?;
    return Ok();
}

/// Values `from..to` of `v` written PLAIN.
fn writePlainRange(
    out: borrow mut Vector<u8>,
    leaf: borrow PageLeaf,
    v: borrow ColumnValues,
    from: usize,
    to: usize,
) -> Result<void, AllocError> {
    if (leaf.physical == PQ_BOOLEAN) {
        var acc: u8 = 0;
        var bits: u32 = 0;
        for (i in from..to) {
            if (valueAt(v, leaf, i)[0] != 0) { acc = acc | (1u8 << truncate<u8>(bits)); }
            bits += 1;
            if (bits == 8) {
                out.push(acc)?;
                acc = 0;
                bits = 0;
            }
        }
        if (bits > 0) { out.push(acc)?; }
        return Ok();
    }
    for (i in from..to) { writePlainValue(out, leaf, valueAt(v, leaf, i))?; }
    return Ok();
}

/// How two big-endian two's-complement integers of any lengths order (a DECIMAL's unscaled value); an empty one is 0.
fn compareTwosComplement(a: Slice<u8>, b: Slice<u8>) -> i32 {
    let negA = a.length > 0 && a[0] >= 0x80;
    let negB = b.length > 0 && b[0] >= 0x80;
    if (negA != negB) { return if (negA) -1 else 1; }
    let n = if (a.length > b.length) a.length else b.length;
    let pad: u8 = if (negA) 0xFF else 0;
    for (i in 0..n) {
        let x = if (i < n - a.length) pad else a[i - (n - a.length)];
        let y = if (i < n - b.length) pad else b[i - (n - b.length)];
        if (x != y) { return if (x < y) -1 else 1; }
    }
    return 0;
}

/// How two non-NaN values of `leaf`'s type order, by its statistics order (ADR-0118 §1); null when it has none here.
fn compareValues(leaf: borrow PageLeaf, a: Slice<u8>, b: Slice<u8>) -> i32? {
    let order = leaf.order;
    if (order == PQ_ORDER_SIGNED || order == PQ_ORDER_UNSIGNED) {
        let unsigned = order == PQ_ORDER_UNSIGNED;
        if (leaf.physical == PQ_INT32) {
            let x = a.readLE<u32>(0);
            let y = b.readLE<u32>(0);
            if (unsigned) { return Some(if (x < y) -1 else if (x > y) 1 else 0); }
            let sx = truncate<i32>(x);
            let sy = truncate<i32>(y);
            return Some(if (sx < sy) -1 else if (sx > sy) 1 else 0);
        }
        if (leaf.physical == PQ_INT64) {
            let x = a.readLE<u64>(0);
            let y = b.readLE<u64>(0);
            if (unsigned) { return Some(if (x < y) -1 else if (x > y) 1 else 0); }
            let sx = truncate<i64>(x);
            let sy = truncate<i64>(y);
            return Some(if (sx < sy) -1 else if (sx > sy) 1 else 0);
        }
        return null;
    }
    if (order == PQ_ORDER_FLOAT) {
        let x = if (leaf.physical == PQ_FLOAT) f32.fromBits(
            a.readLE<u32>(0),
        ) as f64 else f64.fromBits(a.readLE<u64>(0));
        let y = if (leaf.physical == PQ_FLOAT) f32.fromBits(
            b.readLE<u32>(0),
        ) as f64 else f64.fromBits(b.readLE<u64>(0));
        if (x != x || y != y) { return null; }
        return Some(if (x < y) -1 else if (x > y) 1 else 0);
    }
    if (order == PQ_ORDER_DECIMAL) { return Some(compareTwosComplement(a, b)); }
    if (order == PQ_ORDER_BYTES) { return Some(compareBytes(a, b)); }
    return null;
}

/// A chunk's statistics: its nulls, and its least and greatest values in its type's order (ADR-0118 §1): NaNs left
/// out, a zero minimum written as -0.0 and a zero maximum as +0.0, as the format asks; none when its type has no
/// order here or every value is a NaN.
fn statisticsOf(leaf: borrow PageLeaf, v: borrow ColumnValues) -> Result<Vector<ThriftField>, AllocError> {
    var nulls: i64 = 0;
    for (d in v.defs.view()) {
        if ((d as u32) < leaf.maxDef) { nulls += 1; }
    }
    var out = Vector<ThriftField>.create();
    out.push(tLong(3, nulls))?;
    var least: usize? = null;
    var most: usize? = null;
    for (i in 0..v.count) {
        let x = valueAt(v, leaf, i);
        if (isNaNValue(leaf.physical, x)) { continue; }
        match (least) {
            Some(l) => {
                let c = compareValues(leaf, x, valueAt(v, leaf, l)) ?? { return Ok(out); };
                if (c < 0) { least = Some(i); }
            }
            null => {
                if (compareValues(leaf, x, x).isNull()) { return Ok(out); }
                least = Some(i);
            }
        }
        match (most) {
            Some(m) => {
                let c = compareValues(leaf, x, valueAt(v, leaf, m)) ?? { return Ok(out); };
                if (c > 0) { most = Some(i); }
            }
            null => { most = Some(i); }
        }
    }
    let l = least ?? { return Ok(out); };
    let m = most ?? { return Ok(out); };
    var max = copyBytes(valueAt(v, leaf, m))?;
    var min = copyBytes(valueAt(v, leaf, l))?;
    if (leaf.order == PQ_ORDER_FLOAT) {
        // A zero's sign bit is the last byte's top bit (little-endian): cleared in the maximum, set in the minimum.
        let top = max.length - 1;
        if (isZeroFloat(leaf, max.view())) { max[top] = max[top] & 0x7F; }
        if (isZeroFloat(leaf, min.view())) { min[top] = min[top] | 0x80; }
    }
    out.push(tBinary(5, max.view())?)?;
    out.push(tBinary(6, min.view())?)?;
    return Ok(out);
}

/// Whether `a` is a zero (+0.0 or -0.0) of `leaf`'s FLOAT or DOUBLE.
fn isZeroFloat(leaf: borrow PageLeaf, a: Slice<u8>) -> bool {
    if (leaf.physical == PQ_FLOAT) { return (a.readLE<u32>(0) & 0x7FFFFFFF) == 0; }
    if (leaf.physical == PQ_DOUBLE) { return (a.readLE<u64>(0) & 0x7FFFFFFFFFFFFFFF) == 0; }
    return false;
}

// ---- A column chunk ----

/// A dictionary's index width for `count` values: at least 1, as Arrow and parquet-java write it (ADR-0118 §4, the M23
/// exit review's B5), though a width of 0 holds the one index of a dictionary of one value.
fn indexWidthOf(count: usize) -> u32 {
    let w = bitWidthOf(truncate<u32>(count - 1));
    return if (w == 0) 1 else w;
}

/// A page's bytes compressed by `codec`; null for a codec not written here.
fn compressPage(codec: i64, level: u32, page: Slice<u8>) -> Result<Vector<u8>?, AllocError> {
    if (codec == PQ_CODEC_UNCOMPRESSED) { return Ok(Some(copyBytes(page)?)); }
    if (codec == PQ_CODEC_GZIP) {
        var out = Vector<u8>.create();
        // The table's level (ADR-0116), 6 when it sets none, as gzip's own default.
        Gzip.compress(page, if (level == 0 || level > 9) 6 else level, mut out)?;
        return Ok(Some(out));
    }
    if (codec == PQ_CODEC_SNAPPY) {
        var out = Vector<u8>.create();
        Snappy.compress(page, 0, mut out)?;
        return Ok(Some(out));
    }
    if (codec == PQ_CODEC_ZSTD) {
        var out = Vector<u8>.create();
        // The table's level, 1 to 9 (ADR-0116 §1); 0 is zstd's default, 3.
        Zstd.compress(page, level, mut out)?;
        return Ok(Some(out));
    }
    return Ok(null);
}

/// A page's header and its (compressed) bytes, appended to `out`; its header's and uncompressed body's size, or null
/// for a codec not written here.
fn writePage(
    out: borrow mut Vector<u8>,
    codec: i64,
    level: u32,
    kind: i64,
    page: Slice<u8>,
    detail: ThriftField,
) -> Result<i64?, AllocError> {
    let compressed = compressPage(codec, level, page)? ?? { return Ok(null); };
    var header = Vector<ThriftField>.create();
    header.push(tInt(1, kind))?;
    header.push(tInt(2, truncate<i64>(page.length)))?;
    header.push(tInt(3, truncate<i64>(compressed.length)))?;
    header.push(detail)?;
    let before = out.length;
    writeThriftStruct(out, header.view())?;
    let headerLength = out.length - before;
    out.extend(compressed.view())?;
    // The page's size as `total_uncompressed_size` counts it: its header and its uncompressed body (ADR-0118 §2).
    return Ok(Some(truncate<i64>(headerLength + page.length)));
}

/// The dictionary of a chunk's values, when it is smaller than PLAIN: its values (PLAIN, in first-seen order) and
/// each value's index into them.
struct ChunkDictionary {
    values: Vector<u8>;
    count: usize;
    indexes: Vector<u64>;
}

fn dictionaryOf(leaf: borrow PageLeaf, v: borrow ColumnValues) -> Result<ChunkDictionary?, AllocError> {
    if (leaf.physical == PQ_BOOLEAN || v.count == 0) { return Ok(null); }
    var seen = HashMap<Vector<u8>, u64>.create();
    var values = Vector<u8>.create();
    var indexes = Vector<u64>.create();
    var plain: usize = 0;
    for (i in 0..v.count) {
        let bytes = valueAt(v, leaf, i);
        plain += bytes.length + (if (leaf.physical == PQ_BYTE_ARRAY) 4 else 0);
        let key = copyBytes(bytes)?;
        match (seen.get(borrow key)) {
            Some(ix) => { indexes.push(*ix)?; }
            null => {
                if (seen.length() >= PQ_DICTIONARY_MAX) { return Ok(null); }
                let ix = seen.length() as u64;
                writePlainValue(mut values, leaf, bytes)?;
                let _ = seen.put(key, ix)?;
                indexes.push(ix)?;
            }
        }
    }
    let width = indexWidthOf(seen.length());
    let encoded = values.length + (v.count * width as usize + 7) / 8 + 16;
    if (encoded >= plain) { return Ok(null); }
    return Ok(Some(ChunkDictionary { values: values, count: seen.length(), indexes: indexes }));
}

/// A column's chunk, at `offset` in the file: its pages appended to `out`, and its ColumnChunk; null when its codec or
/// type is not written here.
fn writeColumnChunk(
    out: borrow mut Vector<u8>,
    offset: u64,
    leaf: borrow PageLeaf,
    v: borrow ColumnValues,
    codec: i64,
) -> Result<ThriftValue?, AllocError> => writeColumnChunkAt(out, offset, leaf, v, codec, 0);

/// `writeColumnChunk` at the codec's `level` (0: its default; ADR-0116).
fn writeColumnChunkAt(
    out: borrow mut Vector<u8>,
    offset: u64,
    leaf: borrow PageLeaf,
    v: borrow ColumnValues,
    codec: i64,
    codecLevel: u32,
) -> Result<ThriftValue?, AllocError> {
    if (valueWidth(leaf).isNull() || v.reps.length != v.defs.length) { return Ok(null); }
    let start = out.length;
    let dictionary = dictionaryOf(leaf, v)?;
    var dictionaryOffset: u64? = null;
    var dictionarySize: i64 = 0;
    match (borrow dictionary) {
        Some(d) => {
            dictionaryOffset = Some(offset + (out.length - start) as u64);
            var detail = Vector<ThriftField>.create();
            detail.push(tInt(1, truncate<i64>(d.count)))?;
            detail.push(tInt(2, PQ_ENC_PLAIN))?;
            dictionarySize = writePage(
                out,
                codec,
                codecLevel,
                PQ_PAGE_DICTIONARY,
                d.values.view(),
                tStruct(7, detail),
            )? ?? { return Ok(null); };
        }
        null => {}
    }
    let dataOffset = offset + (out.length - start) as u64;
    let width = match (borrow dictionary) {
        Some(d) => indexWidthOf(d.count),
        null => 0,
    };
    var uncompressedTotal: i64 = dictionarySize;
    var level: usize = 0;
    var value: usize = 0;
    while (level < v.defs.length) {
        // The page's levels: up to PQ_PAGE_LEVELS, or its values to PQ_PAGE_BYTES, ending before a row's start.
        var to = level;
        var bytes: usize = 0;
        var at = value;
        while (to < v.defs.length) {
            if (to > level && v.reps[to] == 0 && (to - level >= PQ_PAGE_LEVELS || bytes >= PQ_PAGE_BYTES)) { break; }
            if (v.defs[to] as u32 == leaf.maxDef) {
                bytes += valueAt(v, leaf, at).length;
                at += 1;
            }
            to += 1;
        }
        let present = presentCount(v.defs.view()[level..to], leaf.maxDef);
        var page = Vector<u8>.create();
        if (leaf.maxRep > 0) { writeLevels(mut page, v.reps.view()[level..to], leaf.maxRep)?; }
        if (leaf.maxDef > 0) { writeLevels(mut page, v.defs.view()[level..to], leaf.maxDef)?; }
        let encoding = match (borrow dictionary) {
            Some(d) => {
                page.push(truncate<u8>(width))?;
                writeHybrid(mut page, d.indexes.view()[value..value + present], width)?;
                PQ_ENC_RLE_DICTIONARY
            },
            null => {
                writePlainRange(mut page, leaf, v, value, value + present)?;
                PQ_ENC_PLAIN
            },
        };
        var detail = Vector<ThriftField>.create();
        detail.push(tInt(1, truncate<i64>(to - level)))?;
        detail.push(tInt(2, encoding))?;
        detail.push(tInt(3, PQ_ENC_RLE))?;
        detail.push(tInt(4, PQ_ENC_RLE))?;
        uncompressedTotal += writePage(out, codec, codecLevel, PQ_PAGE_DATA, page.view(), tStruct(5, detail))? ?? {
            return Ok(null);
        };
        level = to;
        value += present;
    }
    if (v.defs.length == 0) { return Ok(null); }
    // Its metadata.
    var encodings = Vector<ThriftValue>.create();
    encodings.push(ThriftValue.Int(THRIFT_I32, if (dictionary.isSome()) PQ_ENC_RLE_DICTIONARY else PQ_ENC_PLAIN))?;
    encodings.push(ThriftValue.Int(THRIFT_I32, PQ_ENC_RLE))?;
    if (dictionary.isSome()) { encodings.push(ThriftValue.Int(THRIFT_I32, PQ_ENC_PLAIN))?; }
    // The path's own names, so a name holding a `.` stays one (ADR-0118 §3, the M23 exit review's B4).
    var path = Vector<ThriftValue>.create();
    let names = leaf.names.view();
    var at: usize = 0;
    while (at + 4 <= names.length) {
        let n = names.readLE<u32>(at) as usize;
        if (at + 4 + n > names.length) { return Ok(null); }
        path.push(ThriftValue.Binary(copyBytes(names[at + 4..at + 4 + n])?))?;
        at += 4 + n;
    }
    if (path.length == 0 || at != names.length) { return Ok(null); }
    let total = truncate<i64>(out.length - start);
    var meta = Vector<ThriftField>.create();
    meta.push(tInt(PQ_META_TYPE, leaf.physical))?;
    meta.push(ThriftField { id: 2, value: ThriftValue.List(THRIFT_LIST, THRIFT_I32, encodings) })?;
    meta.push(ThriftField { id: 3, value: ThriftValue.List(THRIFT_LIST, THRIFT_BINARY, path) })?;
    meta.push(tInt(PQ_META_CODEC, codec))?;
    meta.push(tLong(PQ_META_NUM_VALUES, truncate<i64>(v.defs.length)))?;
    meta.push(tLong(6, uncompressedTotal))?;
    meta.push(tLong(PQ_META_TOTAL_COMPRESSED, total))?;
    meta.push(tLong(PQ_META_DATA_OFFSET, truncate<i64>(dataOffset)))?;
    match (dictionaryOffset) {
        Some(d) => { meta.push(tLong(PQ_META_DICT_OFFSET, truncate<i64>(d)))?; }
        null => {}
    }
    meta.push(tStruct(12, statisticsOf(leaf, v)?))?;
    var chunk = Vector<ThriftField>.create();
    chunk.push(tLong(PQ_CHUNK_FILE_OFFSET, truncate<i64>(dictionaryOffset ?? dataOffset)))?;
    chunk.push(tStruct(PQ_CHUNK_META, meta))?;
    return Ok(Some(ThriftValue.Struct(chunk)));
}

// ---- Row groups and the file ----

/// A row group, encoded: its bytes, to be written at the offset it was made for, and its RowGroup.
struct EncodedGroup {
    bytes: Vector<u8>;
    group: ThriftValue;
    rows: i64;
}

/// `rows` rows' columns (one ColumnValues a leaf, in the schema's order) as a row group at `offset`; null when a
/// column is not written here.
fn encodeRowGroup(
    offset: u64,
    leaves: Slice<PageLeaf>,
    columns: Slice<ColumnValues>,
    rows: i64,
    codec: i64,
) -> Result<EncodedGroup?, AllocError> => encodeRowGroupAt(offset, leaves, columns, rows, codec, 0);

/// `encodeRowGroup` at the codec's `level` (0: its default; ADR-0116).
fn encodeRowGroupAt(
    offset: u64,
    leaves: Slice<PageLeaf>,
    columns: Slice<ColumnValues>,
    rows: i64,
    codec: i64,
    level: u32,
) -> Result<EncodedGroup?, AllocError> {
    if (leaves.length != columns.length || leaves.length == 0) { return Ok(null); }
    var bytes = Vector<u8>.create();
    var chunks = Vector<ThriftValue>.create();
    var uncompressed: i64 = 0;
    for (c in 0..leaves.length) {
        let at = offset + bytes.length as u64;
        let chunk = writeColumnChunkAt(
            mut bytes,
            at,
            borrow leaves[c],
            borrow columns[c],
            codec,
            level,
        )? ?? { return Ok(null); };
        uncompressed += match (borrow chunk) {
            ThriftValue.Struct(f) => match (thriftField(f, PQ_CHUNK_META)) {
                Some(m) => match (m) {
                    ThriftValue.Struct(mf) => thriftInt(mf, 6) ?? 0,
                    _ => 0,
                },
                null => 0,
            },
            _ => 0,
        };
        chunks.push(chunk)?;
    }
    var group = Vector<ThriftField>.create();
    group.push(ThriftField { id: PQ_GROUP_COLUMNS, value: ThriftValue.List(THRIFT_LIST, THRIFT_STRUCT, chunks) })?;
    group.push(tLong(2, uncompressed))?;
    group.push(tLong(PQ_GROUP_NUM_ROWS, rows))?;
    group.push(tLong(PQ_GROUP_FILE_OFFSET, truncate<i64>(offset)))?;
    group.push(tLong(6, truncate<i64>(bytes.length)))?;
    return Ok(Some(EncodedGroup { bytes: bytes, group: ThriftValue.Struct(group), rows: rows }));
}

/// The file's end: the footer (the inputs' schema and key-value metadata as they were, the row groups written), its
/// length, and the magic.
fn parquetTail(
    inputMeta: borrow Vector<ThriftField>,
    groups: Vector<ThriftValue>,
    rows: i64,
) -> Result<Vector<u8>?, AllocError> {
    var meta = Vector<ThriftField>.create();
    meta.push(tInt(1, 1))?; // version
    let schema = thriftField(inputMeta, PQ_FILE_SCHEMA) ?? { return Ok(null); };
    meta.push(ThriftField { id: PQ_FILE_SCHEMA, value: cloneThrift(schema)? })?;
    meta.push(tLong(PQ_FILE_NUM_ROWS, rows))?;
    meta.push(ThriftField { id: PQ_FILE_ROW_GROUPS, value: ThriftValue.List(THRIFT_LIST, THRIFT_STRUCT, groups) })?;
    match (thriftField(inputMeta, 5)) {
        Some(kv) => { meta.push(ThriftField { id: 5, value: cloneThrift(kv)? })?; }
        null => {}
    }
    meta.push(tBinary(PQ_FILE_CREATED_BY, PQ_CREATED_BY.bytes())?)?;
    // The column orders, as the schema's (its leaves the same): without them parquet-mr does not trust min and max.
    match (thriftField(inputMeta, PQ_FILE_COLUMN_ORDERS)) {
        Some(orders) => { meta.push(ThriftField { id: PQ_FILE_COLUMN_ORDERS, value: cloneThrift(orders)? })?; }
        null => {}
    }
    var out = Vector<u8>.create();
    writeThriftStruct(mut out, meta.view())?;
    let length = out.length;
    out.pushLE(truncate<u32>(length))?;
    out.extend(PARQUET_MAGIC.bytes())?;
    return Ok(Some(out));
}

/// A whole file of one row group, in memory (the tests'; compaction writes a row group at a time).
fn writeParquetFile(
    inputMeta: borrow Vector<ThriftField>,
    leaves: Slice<PageLeaf>,
    columns: Slice<ColumnValues>,
    rows: i64,
    codec: i64,
    codecLevel: u32,
) -> Result<Vector<u8>?, AllocError> {
    var out = copyBytes(PARQUET_MAGIC.bytes())?;
    let g = encodeRowGroupAt(out.length as u64, leaves, columns, rows, codec, codecLevel)? ?? { return Ok(null); };
    out.extend(g.bytes.view())?;
    var groups = Vector<ThriftValue>.create();
    groups.push(g.group)?;
    let tail = parquetTail(inputMeta, groups, rows)? ?? { return Ok(null); };
    out.extend(tail.view())?;
    return Ok(Some(out));
}
