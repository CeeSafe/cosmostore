// Compaction's crash sweep (ADR-0110 §6, the owner's bar): a table of two small Parquet files compacted by the same
// steps `compactTable` and a cluster leader's run take, with a fault at every I/O point (once, sticky, torn) or a
// crash there; then the store reopened and the table read: its metadata the old or the new, every file it names there,
// and its rows the same.

const COMPACT_ID: StringView = "c0c0c0c0-1111-4222-8333-444444444444";
const COMPACT_HIDDEN: StringView = "compact--table-s3";

fn compactPath(rest: StringView) -> Vector<u8> {
    var p = copyBytes("s3://compact--table-s3/".bytes())!;
    p.extend(COMPACT_ID.bytes())!;
    p.push('/')!;
    p.extend(rest.bytes())!;
    return p;
}

fn compactKey(rest: StringView) -> Vector<u8> {
    var k = copyBytes(COMPACT_ID.bytes())!;
    k.push('/')!;
    k.extend(rest.bytes())!;
    return k;
}

fn compactTableName() -> MaintainedTable =>
    MaintainedTable {
        bucket: copyBytes("compact".bytes())!,
        ns: copyBytes("ns".bytes())!,
        name: copyBytes("t".bytes())!,
    };

/// A data file's manifest entry: the fixture manifest's first, at `path`, of `size` bytes and `rows` rows, added by
/// snapshot 1 with its sequence number inherited.
fn compactEntry(template: borrow Json, path: Slice<u8>, size: usize, rows: i64) -> Json {
    var entry = cloneJson(template)!;
    let dataFile = jsonMember(template, "data_file") ?? { return Json.Null; };
    var file = cloneJson(dataFile)!;
    jsonSet(mut file, "file_path", Json.Text(copyBytes(path)!))!;
    jsonSet(mut file, "file_size_in_bytes", jsonInteger(truncate<i64>(size))!)!;
    jsonSet(mut file, "record_count", jsonInteger(rows)!)!;
    jsonSet(mut file, "split_offsets", Json.Null)!;
    jsonSet(mut entry, "data_file", file)!;
    jsonSet(mut entry, "status", jsonInteger(1)!)!;
    jsonSet(mut entry, "snapshot_id", jsonInteger(1)!)!;
    jsonSet(mut entry, "sequence_number", Json.Null)!;
    jsonSet(mut entry, "file_sequence_number", Json.Null)!;
    return entry;
}

/// A table bucket `compact` with table `ns.t`, partitioned by identity on field 2 as PyIceberg's fixture table is: one
/// snapshot of two data files in one partition (Parquet fixtures A and B, 3 and 2 rows), both under compaction's
/// target, so a run joins them into one.
fn fixtureCompactStore(dir: Slice<u8>, config: StoreConfig) =>
    fixtureCompactStoreOf(dir, config, fixtureBytes(PARQUET_FIXTURE_A[..]), 3, fixtureBytes(PARQUET_FIXTURE_B[..]), 2);

/// The table of `fixtureCompactStore` with data files `a` and `b` of `aRows` and `bRows` rows.
fn fixtureCompactStoreOf(dir: Slice<u8>, config: StoreConfig, a: Vector<u8>, aRows: i64, b: Vector<u8>, bRows: i64) =>
    fixtureCompactStoreWith(dir, config, a, aRows, b, bRows, false, false);

/// The same, and with `withDeletes` a position and an equality delete file in its partition at sequence number 2
/// (above the data files' 1): `DELETES_COMPACT_POSITION` and `DELETES_COMPACT_EQUALITY` (ADR-0114 §6).
fn fixtureCompactStoreWith(
    dir: Slice<u8>,
    config: StoreConfig,
    a: Vector<u8>,
    aRows: i64,
    b: Vector<u8>,
    bRows: i64,
    withDeletes: bool,
    otherSpec: bool,
) => fixtureCompactStoreFull(dir, config, a, aRows, b, bRows, withDeletes, otherSpec, 0);

/// `fixtureCompactStoreWith`, with c and other position deletes by `positions`: 1, a second position delete file
/// (DELETES_REWRITE_POSITION: rows naming c, a file gone, and a; ADR-0120); 2, the position delete file one naming
/// only c, its `file_path` bounds stated (ADR-0122 §1). c is live in a's partition (named ORC) unless `otherSpec`.
fn fixtureCompactStoreFull(
    dir: Slice<u8>,
    config: StoreConfig,
    a: Vector<u8>,
    aRows: i64,
    b: Vector<u8>,
    bRows: i64,
    withDeletes: bool,
    otherSpec: bool,
    positions: i32,
) {
    let secondPositions = positions == 1;
    let withC = positions != 0;
    var s = ObjectStore.open(StringView.fromUtf8(dir) ?? "", config)!;
    s.createBucket(COMPACT_HIDDEN)!;
    let hidden = COMPACT_HIDDEN.bytes();
    let aKey = compactKey("data/kind=a/a.parquet");
    let bKey = compactKey("data/kind=a/b.parquet");
    let _ = s.putObject(COMPACT_HIDDEN, StringView.fromUtf8(aKey.view()) ?? "", "", a.view(), PutCondition.None)!;
    let _ = s.putObject(COMPACT_HIDDEN, StringView.fromUtf8(bKey.view()) ?? "", "", b.view(), PutCondition.None)!;
    // Their manifest, written as PyIceberg's fixture is, its entries pointed at them.
    let fixture = readAvro(fixtureBytes(AVRO_FIXTURE_MANIFEST[..]).view())!;
    var entries = Vector<Json>.create();
    entries.push(
        compactEntry(borrow fixture.records[0], compactPath("data/kind=a/a.parquet").view(), a.length, aRows),
    )!;
    entries.push(
        compactEntry(borrow fixture.records[0], compactPath("data/kind=a/b.parquet").view(), b.length, bRows),
    )!;
    if (withC && !otherSpec) {
        // c, live in a's partition and spec, which compaction does not rewrite: its manifest names it ORC (ADR-0120's
        // tests: the rows naming it are kept).
        let c = fixtureBytes(PAGES_FLAT_IDS[..]);
        let cKey = compactKey("data/kind=a/c.parquet");
        let _ = s.putObject(COMPACT_HIDDEN, StringView.fromUtf8(cKey.view()) ?? "", "", c.view(), PutCondition.None)!;
        var cEntry = compactEntry(borrow fixture.records[0], compactPath("data/kind=a/c.parquet").view(), c.length, 23);
        var cFile = cloneJson(jsonMember(borrow cEntry, "data_file")!)!;
        jsonSet(mut cFile, "file_format", jsonString("ORC".bytes())!)!;
        jsonSet(mut cEntry, "data_file", cFile)!;
        entries.push(cEntry)!;
    }
    let manifest = writeAvro(fixture.metadata.view(), entries.view())!!;
    let mKey = compactKey("metadata/m0.avro");
    let _ = s.putObject(
        COMPACT_HIDDEN,
        StringView.fromUtf8(mKey.view()) ?? "",
        "",
        manifest.view(),
        PutCondition.None,
    )!;
    // The delete files, and their manifest.
    var deleteManifest = Vector<u8>.create();
    if (withDeletes) {
        var deleteEntries = Vector<Json>.create();
        let files: usize = if (secondPositions) 3 else 2;
        for (k in 0..files) {
            let name = if (k == 0) "data/kind=a/position-deletes.parquet"
                else if (k == 1) "data/kind=a/equality-deletes.parquet"
                else "data/kind=a/position-deletes-2.parquet";
            var bytes = Vector<u8>.create();
            if (k == 0 && positions == 2) {
                bytes = fixtureBytes(PAGES_DELETES_C_POSITION[..]);
            } else if (k == 0) {
                bytes = fixtureBytes(PAGES_DELETES_COMPACT_POSITION[..]);
            } else if (k == 1) {
                bytes = fixtureBytes(PAGES_DELETES_COMPACT_EQUALITY[..]);
            } else {
                bytes = fixtureBytes(PAGES_DELETES_REWRITE_POSITION[..]);
            }
            let key = compactKey(name);
            let _ = s.putObject(
                COMPACT_HIDDEN,
                StringView.fromUtf8(key.view()) ?? "",
                "",
                bytes.view(),
                PutCondition.None,
            )!;
            var entry = compactEntry(
                borrow fixture.records[0],
                compactPath(name).view(),
                bytes.length,
                if (k == 0 && positions == 2) 1 else if (k == 0) 3 else if (k == 1) 2 else 5,
            );
            var file = cloneJson(jsonMember(borrow entry, "data_file")!)!;
            if (k == 0 && positions == 2) {
                // Its `file_path` bounds, equal: the one file it names.
                for (bounds in ["lower_bounds", "upper_bounds"]) {
                    var pair = jsonObject();
                    jsonSet(mut pair, "key", jsonInteger(ICEBERG_DELETE_FILE_PATH)!)!;
                    jsonSet(mut pair, "value", Json.Text(compactPath("data/kind=a/c.parquet")))!;
                    var items = Vector<Json>.create();
                    items.push(pair)!;
                    jsonSet(mut file, bounds, Json.Array(items))!;
                }
            }
            jsonSet(mut file, "content", jsonInteger(if (k == 1) 2 else 1)!)!;
            if (k == 1) {
                var ids = Vector<Json>.create();
                ids.push(jsonInteger(1)!)!;
                jsonSet(mut file, "equality_ids", Json.Array(ids))!;
            }
            jsonSet(mut entry, "data_file", file)!;
            deleteEntries.push(entry)!;
        }
        deleteManifest = writeAvro(fixture.metadata.view(), deleteEntries.view())!!;
        let dKey = compactKey("metadata/m1.avro");
        let _ = s.putObject(
            COMPACT_HIDDEN,
            StringView.fromUtf8(dKey.view()) ?? "",
            "",
            deleteManifest.view(),
            PutCondition.None,
        )!;
    }
    // The manifest list.
    let listFixture = readAvro(fixtureBytes(AVRO_FIXTURE_LIST[..]).view())!;
    var item = cloneJson(borrow listFixture.records[0])!;
    jsonSet(mut item, "manifest_path", Json.Text(compactPath("metadata/m0.avro")))!;
    jsonSet(mut item, "manifest_length", jsonInteger(truncate<i64>(manifest.length))!)!;
    jsonSet(mut item, "added_snapshot_id", jsonInteger(1)!)!;
    jsonSet(mut item, "sequence_number", jsonInteger(1)!)!;
    jsonSet(mut item, "min_sequence_number", jsonInteger(1)!)!;
    jsonSet(mut item, "added_files_count", jsonInteger(2)!)!;
    jsonSet(mut item, "added_rows_count", jsonInteger(aRows + bRows)!)!;
    var items = Vector<Json>.create();
    items.push(item)!;
    if (otherSpec) {
        // A live data file under another spec (1), in a manifest of its own: FLAT_IDS's rows again.
        let c = fixtureBytes(PAGES_FLAT_IDS[..]);
        let cKey = compactKey("data/kind=a/c.parquet");
        let _ = s.putObject(COMPACT_HIDDEN, StringView.fromUtf8(cKey.view()) ?? "", "", c.view(), PutCondition.None)!;
        var cEntries = Vector<Json>.create();
        cEntries.push(
            compactEntry(borrow fixture.records[0], compactPath("data/kind=a/c.parquet").view(), c.length, 23),
        )!;
        let cManifest = writeAvro(fixture.metadata.view(), cEntries.view())!!;
        let m2 = compactKey("metadata/m2.avro");
        let _ = s.putObject(
            COMPACT_HIDDEN,
            StringView.fromUtf8(m2.view()) ?? "",
            "",
            cManifest.view(),
            PutCondition.None,
        )!;
        var cItem = cloneJson(borrow listFixture.records[0])!;
        jsonSet(mut cItem, "manifest_path", Json.Text(compactPath("metadata/m2.avro")))!;
        jsonSet(mut cItem, "manifest_length", jsonInteger(truncate<i64>(cManifest.length))!)!;
        jsonSet(mut cItem, "partition_spec_id", jsonInteger(1)!)!;
        jsonSet(mut cItem, "added_snapshot_id", jsonInteger(1)!)!;
        jsonSet(mut cItem, "sequence_number", jsonInteger(1)!)!;
        jsonSet(mut cItem, "min_sequence_number", jsonInteger(1)!)!;
        jsonSet(mut cItem, "added_files_count", jsonInteger(1)!)!;
        jsonSet(mut cItem, "added_rows_count", jsonInteger(23)!)!;
        items.push(cItem)!;
    }
    if (withDeletes) {
        var deletesItem = cloneJson(borrow listFixture.records[0])!;
        jsonSet(mut deletesItem, "manifest_path", Json.Text(compactPath("metadata/m1.avro")))!;
        jsonSet(mut deletesItem, "manifest_length", jsonInteger(truncate<i64>(deleteManifest.length))!)!;
        jsonSet(mut deletesItem, "content", jsonInteger(1)!)!;
        jsonSet(mut deletesItem, "added_snapshot_id", jsonInteger(1)!)!;
        jsonSet(mut deletesItem, "sequence_number", jsonInteger(2)!)!;
        jsonSet(mut deletesItem, "min_sequence_number", jsonInteger(2)!)!;
        jsonSet(mut deletesItem, "added_files_count", jsonInteger(2)!)!;
        jsonSet(mut deletesItem, "added_rows_count", jsonInteger(5)!)!;
        items.push(deletesItem)!;
    }
    let list = writeAvro(listFixture.metadata.view(), items.view())!!;
    let lKey = compactKey("metadata/snap-1.avro");
    let _ = s.putObject(COMPACT_HIDDEN, StringView.fromUtf8(lKey.view()) ?? "", "", list.view(), PutCondition.None)!;
    // The table's metadata: the fixture's schema and spec, and snapshot 1.
    let request = parseJson(
        """
        {"schema":{"type":"struct","fields":[{"id":1,"name":"id","type":"long","required":true},{"id":2,"name":"kind","type":"string","required":false}]},"partition-spec":{"fields":[{"source-id":2,"field-id":1000,"transform":"identity","name":"kind"}]}}
        """.bytes(),
    )!!;
    var warehouse = copyBytes("s3://compact--table-s3/".bytes())!;
    warehouse.extend(COMPACT_ID.bytes())!;
    var m = newTableMetadata(borrow request, warehouse.view())!!;
    var updates = textOf("[{\"action\":\"add-snapshot\",\"snapshot\":{\"snapshot-id\":1,\"sequence-number\":");
    updates.append(if (withDeletes) "2," else "1,")!;
    updates.append("\"timestamp-ms\":1000,\"summary\":{\"operation\":\"append\"},\"manifest-list\":\"")!;
    let listPath = compactPath("metadata/snap-1.avro");
    updates.append(StringView.fromUtf8(listPath.view()) ?? "")!;
    updates.append(
        "\"}},{\"action\":\"set-snapshot-ref\",\"ref-name\":\"main\",\"type\":\"branch\",\"snapshot-id\":1}]",
    )!;
    let u = parseJson(updates.bytes())!!;
    if (applyUpdates(mut m, borrow u, warehouse.view())!.isSome()) { return; }
    let location = writeMetadata(mut s, hidden, COMPACT_ID.bytes(), 0, borrow m)!;
    var ns = jsonObject();
    jsonSet(mut ns, "id", jsonString("ns-id".bytes())!)!;
    let _ = writeRecord(mut s, hidden, ".s3tables/namespaces/ns".bytes(), borrow ns, PutCondition.None)!;
    var rec = jsonObject();
    jsonSet(mut rec, "id", jsonString(COMPACT_ID.bytes())!)!;
    jsonSet(mut rec, "metadataLocation", Json.Text(location))!;
    let _ = writeRecord(mut s, hidden, ".s3tables/tables/ns/t".bytes(), borrow rec, PutCondition.None)!;
}

/// A compaction run, step by step as `compactTable` takes them (its locked steps here in one thread): the plan, the
/// footers, each bin's copy and put, the commit. A step that fails ends the run, as a fault does a real one.
fn compactionWorkload(dir: Slice<u8>, config: StoreConfig) {
    let _ = compactionWorkloadCounting(dir, config);
}

/// `compactionWorkload`, and how many partitions' position delete files it read to rewrite.
fn compactionWorkloadCounting(dir: Slice<u8>, config: StoreConfig) -> usize {
    var s = match (ObjectStore.open(StringView.fromUtf8(dir) ?? "", config)) {
        Ok(s) => s,
        Err(_) => { return 0; }
    };
    let t = compactTableName();
    var draft = match (planCompaction(mut s, borrow t, 50000)) {
        Ok(Some(d)) => d,
        _ => { return 0; }
    };
    if (readFooterLengths(mut draft).isErr()) { return 0; }
    pinFooters(mut s, mut draft);
    if (finishPlan(mut draft).isErr()) { return 0; }
    var plan = draft.plan;
    var outputs = Vector<CompactionOutput>.create();
    var joined = Vector<usize>.create();
    for (b in 0..plan.bins.length) {
        var copy = match (prepareBin(mut s, borrow plan, b)) {
            Ok(Some(c)) => c,
            _ => { continue; }
        };
        let obj = match (copyBin(mut copy, plan.bins[b].join.tail.view())) {
            Ok(Some(o)) => o,
            _ => { continue; }
        };
        match (putBin(mut s, borrow plan, b, borrow obj)) {
            Ok(Some(o)) => {
                var out = o;
                out.metrics = copy.metrics;
                if (outputs.push(out).isErr() || joined.push(b).isErr()) { return 0; }
            }
            _ => {}
        }
    }
    let read = match (rewriteDeletesNow(mut s, mut plan, joined.view())) {
        Ok(n) => n,
        Err(_) => { return 0; }
    };
    var leftover = Vector<Vector<u8>>.create();
    let _ = finishCompaction(mut s, mut plan, borrow outputs, joined.view(), 50000, mut leftover);
    return read;
}

/// A recovered store's table: its metadata names snapshot 1 (before) or a replace after it, every data file its
/// current snapshot's manifests name is there with its size, and they hold the 5 rows. Returns how many data files.
fn checkCompacted(s: borrow ObjectStore) -> Result<usize, TestFailure> => checkCompactedRows(s, 5);

/// `checkCompacted`, for a table of `want` rows.
fn checkCompactedRows(s: borrow ObjectStore, want: i64) -> Result<usize, TestFailure> {
    let c = tableCounts(s)?;
    Check.equalU64(truncate<u64>(want), truncate<u64>(c.dataRows))?;
    Check.equalU64(0, c.deleteFiles as u64)?;
    return Ok(c.dataFiles);
}

/// A recovered table's live files: its data files and their rows (each file there at its size, its rows its
/// footer's), and its delete files.
struct TableCounts {
    dataFiles: usize;
    dataRows: i64;
    deleteFiles: usize;
    /// Each data file's path and rows.
    paths: Vector<Vector<u8>>;
    fileRows: Vector<i64>;
    /// Each delete file's path and data sequence number.
    deletePaths: Vector<Vector<u8>>;
    deleteSequences: Vector<i64>;
}

fn tableCounts(s: borrow ObjectStore) -> Result<TableCounts, TestFailure> {
    if (!s.bucketExists(COMPACT_HIDDEN)!) { return Err(TestFailure.create("the table bucket is gone")); }
    let rec = match (tableRecord(s, "compact".bytes(), "ns".bytes(), "t".bytes())) {
        Ok(r) => r,
        Err(_) => { return Err(TestFailure.create("the table's record does not read")); }
    };
    let location = jsonMemberText(borrow rec.json, "metadataLocation") ?? {
        return Err(TestFailure.create("no metadata"));
    };
    let m = match (readMetadata(s, COMPACT_HIDDEN.bytes(), location)) {
        Ok(m) => m,
        Err(_) => { return Err(TestFailure.create("the metadata it names is not there")); }
    };
    let current = jsonMemberI64(borrow m, "current-snapshot-id") ?? { return Err(TestFailure.create("no snapshot")); };
    let listPath = snapshotListPath(borrow m, current) ?? { return Err(TestFailure.create("no manifest list")); };
    let list = match (readWarehouseAvro(s, COMPACT_HIDDEN.bytes(), listPath)) {
        Ok(Some(l)) => l,
        _ => { return Err(TestFailure.create("the manifest list is not there")); }
    };
    var rows: i64 = 0;
    var files: usize = 0;
    var deletes: usize = 0;
    var paths = Vector<Vector<u8>>.create();
    var fileRows = Vector<i64>.create();
    var deletePaths = Vector<Vector<u8>>.create();
    var deleteSequences = Vector<i64>.create();
    for (i in 0..list.records.length) {
        let path = jsonMemberText(borrow list.records[i], "manifest_path") ?? {
            return Err(TestFailure.create("a manifest path"));
        };
        let manifest = match (readWarehouseAvro(s, COMPACT_HIDDEN.bytes(), path)) {
            Ok(Some(f)) => f,
            _ => { return Err(TestFailure.create("a manifest is not there")); }
        };
        for (e in 0..manifest.records.length) {
            let entry = borrow manifest.records[e];
            if (jsonMemberI64(entry, "status") == Some(2i64)) { continue; } // deleted
            let file = jsonMember(entry, "data_file") ?? { return Err(TestFailure.create("a data file")); };
            let filePath = jsonMemberText(file, "file_path") ?? { return Err(TestFailure.create("a file path")); };
            let prefix = "s3://compact--table-s3/".bytes();
            let key = filePath[prefix.length..];
            let info = match (s.headObject(COMPACT_HIDDEN, StringView.fromUtf8(key) ?? "")) {
                Ok(found) => found,
                Err(_) => { return Err(TestFailure.create("a data file the table names is not there")); }
            };
            Check.equalU64(truncate<u64>(jsonMemberI64(file, "file_size_in_bytes") ?? -1), info.size)?;
            // Its rows read from the Parquet file's own footer, not the manifest's count (the M22 exit review's
            // finding 3): a file of the right size and wrong bytes does not pass.
            let bytes = match (s.getObject(COMPACT_HIDDEN, StringView.fromUtf8(key) ?? "")) {
                Ok(b) => b,
                Err(_) => { return Err(TestFailure.create("a data file does not read")); }
            };
            if (bytes.length < 12) { return Err(TestFailure.create("a data file too short")); }
            let n = parquetFooterLength(bytes.view()[bytes.length - 8..], bytes.length as u64) ?? {
                return Err(TestFailure.create("a data file that is not Parquet"));
            };
            let start = bytes.length - 8 - n as usize;
            let footer = match (parseParquetFooter(bytes.view()[start..bytes.length - 8], bytes.length as u64)) {
                Ok(Some(f)) => f,
                _ => { return Err(TestFailure.create("a data file whose footer does not read")); }
            };
            Check.equalU64(truncate<u64>(jsonMemberI64(file, "record_count") ?? -1), truncate<u64>(footer.rows))?;
            if ((jsonMemberI64(file, "content") ?? 0) != 0) {
                deletes += 1;
                deletePaths.push(copyBytes(filePath)!)!;
                let manifestSequence = jsonMemberI64(borrow list.records[i], "sequence_number") ?? 0;
                deleteSequences.push(jsonMemberI64(entry, "sequence_number") ?? manifestSequence)!;
                continue;
            }
            rows += footer.rows;
            files += 1;
            paths.push(copyBytes(filePath)!)!;
            fileRows.push(footer.rows)!;
        }
    }
    return Ok(TableCounts {
        dataFiles: files,
        dataRows: rows,
        deleteFiles: deletes,
        paths: paths,
        fileRows: fileRows,
        deletePaths: deletePaths,
        deleteSequences: deleteSequences,
    });
}

/// Without faults the two files are compacted into one, the 5 rows kept.
@test
fn compactionJoinsTheFixtureTable() -> Result<void, TestFailure> {
    let dir = scratchDirectory("compact-plain");
    fixtureCompactStore(dir.bytes(), storeConfig());
    {
        let s = ObjectStore.open(dir.view(), storeConfig())!;
        Check.equalU64(2, checkCompacted(borrow s)? as u64)?;
    }
    compactionWorkload(dir.bytes(), storeConfig());
    let s = ObjectStore.open(dir.view(), storeConfig())!;
    Check.equalU64(1, checkCompacted(borrow s)? as u64)?;
    // Its job's status, written with the commit.
    let status = maintenanceDocument(
        borrow s,
        COMPACT_HIDDEN.bytes(),
        jobStatusKey(COMPACT_ID.bytes(), COMPACTION)!.view(),
    )!;
    Check.equalBytes("Successful".bytes(), jsonMemberText(borrow status, "status")!)?;
    removeTree(dir.view());
    return Ok();
}

fn sweepCompaction(name: StringView, mode: SweepMode) -> Result<void, TestFailure> =>
    sweepCompactionOf(name, mode, PARQUET_FIXTURE_A[..], 3, PARQUET_FIXTURE_B[..], 2);

/// The sweep over a table of the data files `a` and `b`, of `aRows` and `bRows` rows.
fn sweepCompactionOf(
    name: StringView,
    mode: SweepMode,
    a: Slice<StringView>,
    aRows: i64,
    b: Slice<StringView>,
    bRows: i64,
) -> Result<void, TestFailure> {
    let rows = aRows + bRows;
    Faults.elideSyncs(true);
    let base = scratchDirectory(name);
    let dir = base.view();
    removeTree(dir);
    Fs.ensureDirectory(dir)!;
    fixtureCompactStoreOf(dir.bytes(), faultStoreConfig(), fixtureBytes(a), aRows, fixtureBytes(b), bRows);
    Faults.countOperations();
    compactionWorkload(dir.bytes(), faultStoreConfig());
    Faults.disarm();
    let points = Faults.seen();
    Check.isTrue(points > 10, "the run performs I/O")?;
    {
        let s = ObjectStore.open(dir, faultStoreConfig())!;
        Check.equalU64(1, checkCompactedRows(borrow s, rows)? as u64)?;
    }
    for (n in 1..points + 1) {
        removeTree(dir);
        Fs.ensureDirectory(dir)!;
        fixtureCompactStoreOf(dir.bytes(), faultStoreConfig(), fixtureBytes(a), aRows, fixtureBytes(b), bRows);
        armMode(borrow mode, n);
        compactionWorkload(dir.bytes(), faultStoreConfig());
        Faults.disarm();
        if (isCrash(borrow mode)) {
            Check.equalU64(0, Faults.violations())?;
            Faults.crash(dir)!;
        }
        {
            var s = ObjectStore.open(dir, faultStoreConfig())!;
            let _ = checkCompactedRows(borrow s, rows)?;
            let _ = s.checkpoint()!;
        }
        let s = ObjectStore.open(dir, faultStoreConfig())!;
        let files = checkCompactedRows(borrow s, rows)?;
        Check.isTrue(files == 1 || files == 2, "the table as before or as after")?;
    }
    removeTree(dir);
    Faults.elideSyncs(false);
    return Ok();
}

@test
fn compactionFaultsOnce() -> Result<void, TestFailure> => sweepCompaction("compact-once", SweepMode.Once);

@test
fn compactionFaultsSticky() -> Result<void, TestFailure> => sweepCompaction("compact-sticky", SweepMode.Sticky);

@test
fn compactionFaultsTorn() -> Result<void, TestFailure> => sweepCompaction("compact-torn", SweepMode.StickyTorn);

@test
fn compactionFaultsCrash() -> Result<void, TestFailure> => sweepCompaction("compact-crash", SweepMode.Crash);

/// A bin whose pages all read is merged (ADR-0112): two uncompressed pyarrow files of 23 rows, one written with a
/// dictionary and one PLAIN, become one file of one row group of 46 rows that the page reader reads whole.
@test
fn compactionMergesReadableFiles() -> Result<void, TestFailure> {
    let dir = scratchDirectory("compact-merge");
    fixtureCompactStoreOf(
        dir.bytes(),
        storeConfig(),
        fixtureBytes(PAGES_FLAT_V1_DICT[..]),
        23,
        fixtureBytes(PAGES_FLAT_V1_PLAIN[..]),
        23,
    );
    compactionWorkload(dir.bytes(), storeConfig());
    let s = ObjectStore.open(dir.view(), storeConfig())!;
    Check.equalU64(1, checkCompactedRows(borrow s, 46)? as u64)?;
    // The merged file: one row group, every column read, the first fixture's values then the second's.
    let bytes = compactedFile(borrow s)?;
    let n = parquetFooterLength(bytes.view()[bytes.length - 8..], bytes.length as u64)!;
    let start = bytes.length - 8 - n as usize;
    let footer = parseParquetFooter(bytes.view()[start..bytes.length - 8], bytes.length as u64)!!;
    let groups = structItems(borrow footer.meta, PQ_FILE_ROW_GROUPS) ?? { return Err(TestFailure.create("groups")); };
    Check.equalU64(1, groups.length as u64)?;
    Check.equalU64(46, truncate<u64>(footer.rows))?;
    Check.equalU64(7, readAllColumns(bytes.view()) as u64)?;
    removeTree(dir.view());
    return Ok();
}

/// Files of one schema from writers that order and name its columns otherwise merge (ADR-0112 §2): the renamed file's
/// columns, matched by field id, follow the first's own in its order and under its names.
@test
fn compactionMergesByFieldId() -> Result<void, TestFailure> =>
    mergedTwiceOver("compact-merge-ids", PAGES_FLAT_IDS[..], PAGES_FLAT_IDS_RENAMED[..], PAGES_FLAT_IDS_EXPECTED[..]);

/// An input of three row groups merged, each read alone (ADR-0114 §1): with a file of the same rows in one, every
/// value in its column.
@test
fn compactionMergesRowGroupByRowGroup() -> Result<void, TestFailure> =>
    mergedTwiceOver(
        "compact-merge-groups",
        PAGES_FLAT_V1_GROUPS[..],
        PAGES_FLAT_V1_DICT[..],
        PAGES_FLAT_V1_DICT_EXPECTED[..],
    );

/// Two fixtures of the flat rows (23 each) compacted: one file of one row group, its columns, in the first's order,
/// the expected lines' rows twice over.
fn mergedTwiceOver(
    name: StringView,
    a: Slice<StringView>,
    b: Slice<StringView>,
    expected: Slice<StringView>,
) -> Result<void, TestFailure> {
    let dir = scratchDirectory(name);
    fixtureCompactStoreOf(dir.bytes(), storeConfig(), fixtureBytes(a), 23, fixtureBytes(b), 23);
    compactionWorkload(dir.bytes(), storeConfig());
    let s = ObjectStore.open(dir.view(), storeConfig())!;
    Check.equalU64(1, checkCompactedRows(borrow s, 46)? as u64)?;
    let bytes = compactedFile(borrow s)?;
    let n = parquetFooterLength(bytes.view()[bytes.length - 8..], bytes.length as u64)!;
    let start = bytes.length - 8 - n as usize;
    let footer = parseParquetFooter(bytes.view()[start..bytes.length - 8], bytes.length as u64)!!;
    let leaves = schemaLeaves(borrow footer.meta)!!;
    let groups = structItems(borrow footer.meta, PQ_FILE_ROW_GROUPS) ?? { return Err(TestFailure.create("groups")); };
    Check.equalU64(1, groups.length as u64)?;
    let group = match (borrow groups[0]) {
        ThriftValue.Struct(f) => f,
        _ => { return Err(TestFailure.create("a row group")); }
    };
    let chunks = structItems(group, PQ_GROUP_COLUMNS) ?? { return Err(TestFailure.create("columns")); };
    Check.equalU64(7, chunks.length as u64)?;
    for (c in 0..chunks.length) {
        let chunk = match (borrow chunks[c]) {
            ThriftValue.Struct(f) => f,
            _ => { return Err(TestFailure.create("a column chunk")); }
        };
        let values = readColumnChunk(bytes.view(), chunk, borrow leaves[c])! ?? {
            return Err(TestFailure.create("a column read"));
        };
        let want = twiceOver(expected[c]);
        Check.equalText(want.view(), renderedColumn(borrow leaves[c], borrow values).view())?;
    }
    removeTree(dir.view());
    return Ok();
}

/// A fixture's expected line for its rows twice over: `path|def|rep|reps|defs|values`, levels and values doubled.
fn twiceOver(line: StringView) -> String {
    var parts = Vector<StringView>.create();
    for (p in line.split("|")) { parts.push(p)!; }
    var out = String.create();
    for (i in 0..3) {
        out.append(parts[i])!;
        out.append("|")!;
    }
    for (i in 3..5) {
        out.append(parts[i])!;
        out.append(parts[i])!;
        out.append("|")!;
    }
    out.append(parts[5])!;
    if (parts[5].length > 0) {
        out.append(",")!;
        out.append(parts[5])!;
    }
    return out;
}

/// The bytes of the one compacted file the table's current snapshot names.
fn compactedFile(s: borrow ObjectStore) -> Result<Vector<u8>, TestFailure> {
    let rec = tableRecord(s, "compact".bytes(), "ns".bytes(), "t".bytes())!;
    let m = readMetadata(s, COMPACT_HIDDEN.bytes(), jsonMemberText(borrow rec.json, "metadataLocation")!)!;
    let list = readWarehouseAvro(
        s,
        COMPACT_HIDDEN.bytes(),
        snapshotListPath(borrow m, jsonMemberI64(borrow m, "current-snapshot-id")!)!,
    )!!;
    var path = Vector<u8>.create();
    for (i in 0..list.records.length) {
        let manifest = readWarehouseAvro(
            s,
            COMPACT_HIDDEN.bytes(),
            jsonMemberText(borrow list.records[i], "manifest_path")!,
        )!!;
        for (e in 0..manifest.records.length) {
            if (jsonMemberI64(borrow manifest.records[e], "status") == Some(2i64)) { continue; }
            let file = jsonMember(borrow manifest.records[e], "data_file") ?? {
                return Err(TestFailure.create("a file"));
            };
            path = copyBytes(jsonMemberText(file, "file_path")!)!;
        }
    }
    let key = path.view()["s3://compact--table-s3/".bytes().length..];
    return Ok(s.getObject(COMPACT_HIDDEN, StringView.fromUtf8(key) ?? "")!);
}

/// The sweep over a merge (ADR-0112 §5): two files of one schema from writers whose shapes differ, so that they are
/// never joined, only merged (by field id) into one.
fn sweepMerge(name: StringView, mode: SweepMode) -> Result<void, TestFailure> =>
    sweepCompactionOf(name, mode, PAGES_FLAT_IDS[..], 23, PAGES_FLAT_IDS_RENAMED[..], 23);

@test
fn compactionMergeFaultsOnce() -> Result<void, TestFailure> => sweepMerge("merge-once", SweepMode.Once);

@test
fn compactionMergeFaultsSticky() -> Result<void, TestFailure> => sweepMerge("merge-sticky", SweepMode.Sticky);

@test
fn compactionMergeFaultsTorn() -> Result<void, TestFailure> => sweepMerge("merge-torn", SweepMode.StickyTorn);

@test
fn compactionMergeFaultsCrash() -> Result<void, TestFailure> => sweepMerge("merge-crash", SweepMode.Crash);

// ---- Deletes applied (ADR-0114 §6) ----

/// The table with deletes in one of the states a run may leave it in, each its rows with the deletes applied the
/// same 39: before (the two files, 46 rows, and both delete files); one file compacted alone with its deletes applied
/// (the other as it was, both delete files kept: they still apply to it), the first leaving 19 rows and the second 20;
/// or after (one file of 39 rows, no delete file). Returns how many data files.
fn checkDeletesTable(s: borrow ObjectStore) -> Result<usize, TestFailure> {
    let c = tableCounts(s)?;
    let a = compactPath("data/kind=a/a.parquet");
    let b = compactPath("data/kind=a/b.parquet");
    if (c.dataFiles == 1 && c.dataRows == 39 && c.deleteFiles == 0 && c.paths[0].view() != a.view() &&
        c.paths[0].view() != b.view()) {
        return Ok(1);
    }
    if (c.dataFiles == 2 && c.deleteFiles == 2) {
        var original: usize = 0;
        var other: usize = 0;
        var otherRows: i64 = 0;
        var kept = Vector<u8>.create();
        for (f in 0..2) {
            if (c.paths[f].view() == a.view() || c.paths[f].view() == b.view()) {
                if (c.fileRows[f] != 23) { return Err(TestFailure.create("an original file changed")); }
                original += 1;
                kept = copyBytes(c.paths[f].view())!;
            } else {
                other += 1;
                otherRows = c.fileRows[f];
            }
        }
        if (original == 2) { return Ok(2); }
        // One compacted alone: the first's leaves 19 rows (positions 0 and 5, ids of rows 2 and 7), the second's 20.
        if (original == 1 && other == 1) {
            let want: i64 = if (kept.view() == b.view()) 19 else 20;
            if (otherRows == want) { return Ok(2); }
        }
    }
    var why = textOf("not a state a run leaves: ");
    why.appendNumber(truncate<i64>(c.dataFiles))!;
    why.append(" files, ")!;
    why.appendNumber(c.dataRows)!;
    why.append(" rows, ")!;
    why.appendNumber(truncate<i64>(c.deleteFiles))!;
    why.append(" delete files")!;
    return Err(TestFailure.create(why.view()));
}

fn deletesStore(dir: Slice<u8>, config: StoreConfig) =>
    fixtureCompactStoreWith(
        dir,
        config,
        fixtureBytes(PAGES_FLAT_IDS[..]),
        23,
        fixtureBytes(PAGES_FLAT_IDS_RENAMED[..]),
        23,
        true,
        false,
    );

/// Compaction applies a position and an equality delete (ADR-0114 §4, §5): one file of 39 rows, each id as many
/// times as the deletes leave it, and both delete files removed.
@test
fn compactionAppliesDeletes() -> Result<void, TestFailure> {
    let dir = scratchDirectory("compact-deletes");
    deletesStore(dir.bytes(), storeConfig());
    {
        let s = ObjectStore.open(dir.view(), storeConfig())!;
        Check.equalU64(2, checkDeletesTable(borrow s)? as u64)?;
    }
    compactionWorkload(dir.bytes(), storeConfig());
    let s = ObjectStore.open(dir.view(), storeConfig())!;
    Check.equalU64(1, checkDeletesTable(borrow s)? as u64)?;
    // Row r's id is r * 1000003 - 7 in both files: rows 2 and 7 deleted by id from both, rows 0 and 5 by position
    // from the first, row 1 from the second.
    let read = readFixture(compactedFile(borrow s)?.view())?;
    let k = leafOfId(read.leaves.view(), 1) ?? { return Err(TestFailure.create("the id column")); };
    let ids = borrow read.columns[k];
    for (r in 0..23) {
        let id = truncate<i64>(r) * 1000003 - 7;
        var seen: u64 = 0;
        for (i in 0..ids.count) {
            if (truncate<i64>(valueAt(ids, borrow read.leaves[k], i).readLE<u64>(0)) == id) { seen += 1; }
        }
        let want: u64 = if (r == 2 || r == 7) 0 else if (r == 0 || r == 5 || r == 1) 1 else 2;
        Check.equalU64(want, seen)?;
    }
    removeTree(dir.view());
    return Ok();
}

/// A bin whose rows are all deleted adds no file (ADR-0118 §5, the M24 exit review's B1): both files hold only the ids
/// the equality delete names, so the run removes them and adds none, and its written file is deleted.
@test
fn deletedRowsAddNoFile() -> Result<void, TestFailure> {
    let dir = scratchDirectory("compact-all-deleted");
    fixtureCompactStoreWith(
        dir.bytes(),
        storeConfig(),
        fixtureBytes(PAGES_DELETES_COMPACT_EQUALITY[..]),
        2,
        fixtureBytes(PAGES_DELETES_COMPACT_EQUALITY[..]),
        2,
        true,
        false,
    );
    compactionWorkload(dir.bytes(), storeConfig());
    let s = ObjectStore.open(dir.view(), storeConfig())!;
    let c = tableCounts(borrow s)?;
    Check.equalU64(0, c.dataFiles as u64)?;
    Check.equalI64(0, c.dataRows)?;
    // Both delete files applied to nothing live after the run, and are gone.
    Check.equalU64(0, c.deleteFiles as u64)?;
    // The run's written file is deleted: no `compacted-` object is left.
    let listed = s.listObjects(COMPACT_HIDDEN, "", "", "".bytes(), false, 1000)!;
    for (k in listed.keys.view()) {
        var found = false;
        let needle = "compacted-".bytes();
        if (k.length >= needle.length) {
            for (i in 0..k.length - needle.length + 1) {
                if (k.view()[i..i + needle.length] == needle) { found = true; }
            }
        }
        Check.isTrue(!found, "the run's file left")?;
    }
    removeTree(dir.view());
    return Ok();
}

/// The fixture table's properties set to `props` (a JSON object's members), as a new metadata file.
fn setCompactProperties(dir: Slice<u8>, props: StringView) {
    var s = ObjectStore.open(StringView.fromUtf8(dir) ?? "", storeConfig())!;
    let rec = tableRecord(borrow s, "compact".bytes(), "ns".bytes(), "t".bytes())!;
    var m = readMetadata(borrow s, COMPACT_HIDDEN.bytes(), jsonMemberText(borrow rec.json, "metadataLocation")!)!;
    var text = textOf("[{\"action\":\"set-properties\",\"updates\":{");
    text.append(props)!;
    text.append("}}]")!;
    let u = parseJson(text.view().bytes())!!;
    var warehouse = copyBytes("s3://compact--table-s3/".bytes())!;
    warehouse.extend(COMPACT_ID.bytes())!;
    if (applyUpdates(mut m, borrow u, warehouse.view())!.isSome()) { return; }
    let location = writeMetadata(mut s, COMPACT_HIDDEN.bytes(), COMPACT_ID.bytes(), 1, borrow m)!;
    var updated = cloneJson(borrow rec.json)!;
    jsonSet(mut updated, "metadataLocation", Json.Text(location))!;
    let _ = writeRecord(
        mut s,
        COMPACT_HIDDEN.bytes(),
        ".s3tables/tables/ns/t".bytes(),
        borrow updated,
        PutCondition.None,
    )!;
}

/// A merged file of the flat rows at the table's gzip `level`, and its chunks' codecs.
fn compactedAtLevel(name: StringView, level: StringView) -> Result<Vector<u8>, TestFailure> {
    let dir = scratchDirectory(name);
    fixtureCompactStoreOf(
        dir.bytes(),
        storeConfig(),
        fixtureBytes(PAGES_FLAT_IDS[..]),
        23,
        fixtureBytes(PAGES_FLAT_IDS_RENAMED[..]),
        23,
    );
    var props = textOf("\"write.parquet.compression-codec\": \"gzip\", \"write.parquet.compression-level\": \"");
    props.append(level)!;
    props.append("\"")!;
    setCompactProperties(dir.bytes(), props.view());
    compactionWorkload(dir.bytes(), storeConfig());
    let s = ObjectStore.open(dir.view(), storeConfig())!;
    Check.equalU64(1, checkCompactedRows(borrow s, 46)? as u64)?;
    let bytes = compactedFile(borrow s)?;
    let chunks = writtenChunks(bytes.view())?;
    for (chunk in chunks.view()) { Check.equalI64(PQ_CODEC_GZIP, thriftInt(chunk, PQ_META_CODEC) ?? -1)?; }
    removeTree(dir.view());
    return Ok(bytes);
}

/// The table's level reaches the merged file's pages (the M25 exit review's B2): gzip at 1 and at 9 writes two
/// different files, where a level lost on the way would write both at 6.
@test
fn tableLevelReachesTheFile() -> Result<void, TestFailure> {
    let fast = compactedAtLevel("compact-level-1", "1")?;
    let slow = compactedAtLevel("compact-level-9", "9")?;
    let six = compactedAtLevel("compact-level-6", "6")?;
    Check.isTrue(fast.view() != slow.view(), "levels 1 and 9 differ")?;
    Check.isTrue(fast.view() != six.view() && slow.view() != six.view(), "neither is the default's")?;
    return Ok();
}

/// FLAT_IDS with its first page's body broken: its footer reads, its first page does not (its snappy length made
/// longer than the page's stated size).
fn brokenPages() -> Vector<u8> {
    var bytes = fixtureBytes(PAGES_FLAT_IDS[..]);
    // The first page starts after the magic; its body after its Thrift header.
    let header = readThriftStruct(bytes.view(), 4)!!;
    let body = header.end;
    for (i in 0..4) { bytes[body + i] = 0xFF; }
    return bytes;
}

/// The join fallback's table: FLAT_IDS and its copy with broken pages, opened; and its directory.
fn joinFallbackStore() -> String {
    let dir = scratchDirectory("compact-join-fallback");
    fixtureCompactStoreOf(dir.bytes(), storeConfig(), fixtureBytes(PAGES_FLAT_IDS[..]), 23, brokenPages(), 23);
    return dir;
}

/// The join fallback's table after the run: one file of 46 rows, each input's row group copied as it was.
fn checkJoinedFallback(dir: StringView) -> Result<void, TestFailure> {
    let s = ObjectStore.open(dir, storeConfig())!;
    let c = tableCounts(borrow s)?;
    Check.equalU64(1, c.dataFiles as u64)?;
    Check.equalI64(46, c.dataRows)?;
    let bytes = compactedFile(borrow s)?;
    let n = parquetFooterLength(bytes.view()[bytes.length - 8..], bytes.length as u64)!;
    let start = bytes.length - 8 - n as usize;
    let footer = parseParquetFooter(bytes.view()[start..bytes.length - 8], bytes.length as u64)!!;
    let groups = structItems(borrow footer.meta, PQ_FILE_ROW_GROUPS) ?? { return Err(TestFailure.create("groups")); };
    Check.equalU64(2, groups.length as u64)?;
    removeTree(dir);
    return Ok();
}

/// A bin whose merge fails is joined as before (the M23 exit review's B6), through the async runner as `serve` runs
/// it: an input whose footer reads and whose pages do not, the bin's two files joined into one of two row groups.
@test
async fn mergeFailureJoins() -> Result<void, TestFailure> {
    let dir = await Async.blocking(() => joinFallbackStore());
    let d = dir.view();
    let store = await Async.blocking(() => ObjectStore.open(d, storeConfig()))!;
    {
        let locked = AsyncMutex<ObjectStore>.create(store)!;
        let shared = Arc<AsyncMutex<ObjectStore>>.create(locked)!;
        let t = compactTableName();
        await compactTable(borrow shared, borrow t, 50000)!;
    }
    return await Async.blocking(() => checkJoinedFallback(d));
}

/// Compaction with deletes swept for faults and crashes at every I/O point: the table as before or as after, never
/// a row brought back or lost.
fn sweepDeletes(name: StringView, mode: SweepMode) -> Result<void, TestFailure> {
    Faults.elideSyncs(true);
    let base = scratchDirectory(name);
    let dir = base.view();
    removeTree(dir);
    Fs.ensureDirectory(dir)!;
    deletesStore(dir.bytes(), faultStoreConfig());
    Faults.countOperations();
    compactionWorkload(dir.bytes(), faultStoreConfig());
    Faults.disarm();
    let points = Faults.seen();
    Check.isTrue(points > 10, "the run performs I/O")?;
    {
        let s = ObjectStore.open(dir, faultStoreConfig())!;
        Check.equalU64(1, checkDeletesTable(borrow s)? as u64)?;
    }
    for (n in 1..points + 1) {
        removeTree(dir);
        Fs.ensureDirectory(dir)!;
        deletesStore(dir.bytes(), faultStoreConfig());
        armMode(borrow mode, n);
        compactionWorkload(dir.bytes(), faultStoreConfig());
        Faults.disarm();
        if (isCrash(borrow mode)) {
            Check.equalU64(0, Faults.violations())?;
            Faults.crash(dir)!;
        }
        {
            var s = ObjectStore.open(dir, faultStoreConfig())!;
            let _ = checkDeletesTable(borrow s)?;
            let _ = s.checkpoint()!;
        }
        let s = ObjectStore.open(dir, faultStoreConfig())!;
        let _ = checkDeletesTable(borrow s)?;
    }
    removeTree(dir);
    Faults.elideSyncs(false);
    return Ok();
}

@test
fn compactionDeletesFaultsOnce() -> Result<void, TestFailure> => sweepDeletes("deletes-once", SweepMode.Once);

@test
fn compactionDeletesFaultsSticky() -> Result<void, TestFailure> => sweepDeletes("deletes-sticky", SweepMode.Sticky);

@test
fn compactionDeletesFaultsTorn() -> Result<void, TestFailure> => sweepDeletes("deletes-torn", SweepMode.StickyTorn);

@test
fn compactionDeletesFaultsCrash() -> Result<void, TestFailure> => sweepDeletes("deletes-crash", SweepMode.Crash);

/// Deletes kept while a live data file of another spec remains (the M24 exit review's H1: an equality delete written
/// under an unpartitioned spec applies to every spec's older files): the spec's files merged with the deletes applied,
/// the other spec's file as it was, and the equality delete kept (the position delete, naming only the merged files, is
/// rewritten away, ADR-0120).
@test
fn compactionKeepsDeletesWithAnotherSpec() -> Result<void, TestFailure> {
    let dir = scratchDirectory("compact-deletes-specs");
    fixtureCompactStoreWith(
        dir.bytes(),
        storeConfig(),
        fixtureBytes(PAGES_FLAT_IDS[..]),
        23,
        fixtureBytes(PAGES_FLAT_IDS_RENAMED[..]),
        23,
        true,
        true,
    );
    compactionWorkload(dir.bytes(), storeConfig());
    let s = ObjectStore.open(dir.view(), storeConfig())!;
    let c = tableCounts(borrow s)?;
    Check.equalU64(2, c.dataFiles as u64)?;
    Check.equalU64(39 + 23, truncate<u64>(c.dataRows))?;
    // The equality delete stays (global, and the other spec's file is live). The position delete names only the two
    // files merged, so its rows all dangle, and its partition's rewrite removes it (ADR-0120 §4).
    Check.equalU64(1, c.deleteFiles as u64)?;
    removeTree(dir.view());
    return Ok();
}

/// A partition's two position delete files rewritten as one (ADR-0120): of the second's rows, c's (a live file of the
/// partition the run does not rewrite) kept (sorted, once
/// each), the gone file's and a's dropped; the first's, naming only merged files, dropped whole. The new file takes
/// the largest sequence number of those it replaces (2), and the equality delete stays.
@test
fn positionDeletesRewritten() -> Result<void, TestFailure> {
    let dir = scratchDirectory("compact-rewrite-deletes");
    rewriteStore(dir.bytes(), storeConfig());
    compactionWorkload(dir.bytes(), storeConfig());
    let s = ObjectStore.open(dir.view(), storeConfig())!;
    let c = tableCounts(borrow s)?;
    Check.equalU64(2, c.dataFiles as u64)?;
    // 46 merged less a's positions 0, 3 and 5, b's 1, and ids 2 and 7 in both; c's 23 as they are.
    Check.equalI64(38 + 23, c.dataRows)?;
    Check.equalU64(2, c.deleteFiles as u64)?;
    var found = false;
    for (k in 0..c.deletePaths.length) {
        let path = c.deletePaths[k].view();
        let prefix = "s3://compact--table-s3/".bytes();
        let bytes = s.getObject(COMPACT_HIDDEN, StringView.fromUtf8(path[prefix.length..]) ?? "")!;
        let read = readPositionDeletes(bytes.view())! ?? { continue; };
        found = true;
        Check.equalI64(2, c.deleteSequences[k])?;
        Check.equalU64(1, read.paths.length as u64)?;
        let named = read.paths[0].view();
        Check.isTrue(named.length > 9 && named[named.length - 9..] == "c.parquet".bytes(), "c named")?;
        Check.equalU64(2, read.positions[0].length as u64)?;
        Check.equalI64(0, read.positions[0][0])?;
        Check.equalI64(2, read.positions[0][1])?;
    }
    Check.isTrue(found, "a position delete file")?;
    removeTree(dir.view());
    return Ok();
}

/// The rewrite's table (ADR-0120 §6) in a state a run may leave, by its files' rows and delete files: before, or with
/// its deletes rewritten only; after, with or without them rewritten; or a or b compacted alone. In every state each
/// original file still live keeps every position deleted from it (a's 0, 3 and 5, b's 1, c's 0 and 2) in a live
/// position delete file.
fn checkRewriteTable(s: borrow ObjectStore) -> Result<void, TestFailure> {
    let c = tableCounts(s)?;
    let states = [[3i64, 69, 3], [3, 69, 2], [2, 61, 2], [2, 61, 3], [3, 64, 2], [3, 64, 3], [3, 66, 2], [3, 66, 3]];
    var known = false;
    for (st in states) {
        if (truncate<i64>(c.dataFiles) == st[0] && c.dataRows == st[1] && truncate<i64>(c.deleteFiles) == st[2]) {
            known = true;
        }
    }
    if (!known) {
        var why = textOf("not a state a run leaves: ");
        why.appendNumber(truncate<i64>(c.dataFiles))!;
        why.append(" files, ")!;
        why.appendNumber(c.dataRows)!;
        why.append(" rows, ")!;
        why.appendNumber(truncate<i64>(c.deleteFiles))!;
        why.append(" delete files")!;
        return Err(TestFailure.create(why.view()));
    }
    let names = ["data/kind=a/a.parquet", "data/kind=a/b.parquet", "data/kind=a/c.parquet"];
    let wanted = [[0i64, 3, 5], [1, -1, -1], [0, 2, -1]];
    let prefix = "s3://compact--table-s3/".bytes();
    for (f in 0..names.length) {
        let named = compactPath(names[f]);
        var live = false;
        for (p in c.paths.view()) {
            if (p.view() == named.view()) { live = true; }
        }
        if (!live) { continue; }
        for (want in wanted[f]) {
            if (want < 0) { continue; }
            var covered = false;
            for (k in 0..c.deletePaths.length) {
                let path = c.deletePaths[k].view();
                let bytes = s.getObject(COMPACT_HIDDEN, StringView.fromUtf8(path[prefix.length..]) ?? "")!;
                let read = readPositionDeletes(bytes.view())! ?? { continue; };
                match (positionsOf(borrow read, named.view())!) {
                    Some(ps) => {
                        for (p in ps) {
                            if (p == want) { covered = true; }
                        }
                    }
                    null => {}
                }
            }
            Check.isTrue(covered, "a live file's deleted position still deleted")?;
        }
    }
    return Ok();
}

fn rewriteStore(dir: Slice<u8>, config: StoreConfig) =>
    fixtureCompactStoreFull(
        dir,
        config,
        fixtureBytes(PAGES_FLAT_IDS[..]),
        23,
        fixtureBytes(PAGES_FLAT_IDS_RENAMED[..]),
        23,
        true,
        false,
        1,
    );

/// Compaction that rewrites position deletes, swept for faults and crashes at every I/O point (ADR-0120 §6).
fn sweepRewrite(name: StringView, mode: SweepMode) -> Result<void, TestFailure> {
    Faults.elideSyncs(true);
    let base = scratchDirectory(name);
    let dir = base.view();
    removeTree(dir);
    Fs.ensureDirectory(dir)!;
    rewriteStore(dir.bytes(), faultStoreConfig());
    Faults.countOperations();
    compactionWorkload(dir.bytes(), faultStoreConfig());
    Faults.disarm();
    let points = Faults.seen();
    Check.isTrue(points > 10, "the run performs I/O")?;
    {
        let s = ObjectStore.open(dir, faultStoreConfig())!;
        let c = tableCounts(borrow s)?;
        Check.equalU64(2, c.deleteFiles as u64)?;
        Check.equalI64(61, c.dataRows)?;
    }
    for (n in 1..points + 1) {
        removeTree(dir);
        Fs.ensureDirectory(dir)!;
        rewriteStore(dir.bytes(), faultStoreConfig());
        armMode(borrow mode, n);
        compactionWorkload(dir.bytes(), faultStoreConfig());
        Faults.disarm();
        if (isCrash(borrow mode)) {
            Check.equalU64(0, Faults.violations())?;
            Faults.crash(dir)!;
        }
        {
            var s = ObjectStore.open(dir, faultStoreConfig())!;
            checkRewriteTable(borrow s)?;
            let _ = s.checkpoint()!;
        }
        let s = ObjectStore.open(dir, faultStoreConfig())!;
        checkRewriteTable(borrow s)?;
    }
    removeTree(dir);
    Faults.elideSyncs(false);
    return Ok();
}

@test
fn rewriteDeletesFaultsOnce() -> Result<void, TestFailure> => sweepRewrite("rewrite-once", SweepMode.Once);

@test
fn rewriteDeletesFaultsSticky() -> Result<void, TestFailure> => sweepRewrite("rewrite-sticky", SweepMode.Sticky);

@test
fn rewriteDeletesFaultsTorn() -> Result<void, TestFailure> => sweepRewrite("rewrite-torn", SweepMode.StickyTorn);

@test
fn rewriteDeletesFaultsCrash() -> Result<void, TestFailure> => sweepRewrite("rewrite-crash", SweepMode.Crash);

/// A partition whose delete rows name a file of another partition stays as it is (the M27 exit review's L2): c is
/// under another spec here, so the second position delete file, naming it, is neither rewritten nor removed.
@test
fn crossPartitionRowsLeaveTheRewrite() -> Result<void, TestFailure> {
    let dir = scratchDirectory("compact-rewrite-cross");
    fixtureCompactStoreFull(
        dir.bytes(),
        storeConfig(),
        fixtureBytes(PAGES_FLAT_IDS[..]),
        23,
        fixtureBytes(PAGES_FLAT_IDS_RENAMED[..]),
        23,
        true,
        true,
        1,
    );
    compactionWorkload(dir.bytes(), storeConfig());
    let s = ObjectStore.open(dir.view(), storeConfig())!;
    let c = tableCounts(borrow s)?;
    Check.equalU64(2, c.dataFiles as u64)?;
    let second = compactPath("data/kind=a/position-deletes-2.parquet");
    var kept = false;
    for (p in c.deletePaths.view()) {
        if (p.view() == second.view()) { kept = true; }
    }
    Check.isTrue(kept, "the second position delete file as it was")?;
    removeTree(dir.view());
    return Ok();
}

/// A partition's position delete files read only when a rewrite could change them (ADR-0122 §1, M27's B1): one file
/// whose `file_path` bounds name c alone, live in its partition, is not read and stays; two files are read.
@test
fn rewriteReadsOnlyWhatCouldChange() -> Result<void, TestFailure> {
    let one = scratchDirectory("compact-rewrite-one");
    fixtureCompactStoreFull(
        one.bytes(),
        storeConfig(),
        fixtureBytes(PAGES_FLAT_IDS[..]),
        23,
        fixtureBytes(PAGES_FLAT_IDS_RENAMED[..]),
        23,
        true,
        false,
        2,
    );
    Check.equalU64(0, compactionWorkloadCounting(one.bytes(), storeConfig()) as u64)?;
    {
        let s = ObjectStore.open(one.view(), storeConfig())!;
        let c = tableCounts(borrow s)?;
        let first = compactPath("data/kind=a/position-deletes.parquet");
        var kept = false;
        for (p in c.deletePaths.view()) {
            if (p.view() == first.view()) { kept = true; }
        }
        Check.isTrue(kept, "the one file naming c, as it was")?;
    }
    removeTree(one.view());
    let two = scratchDirectory("compact-rewrite-two");
    rewriteStore(two.bytes(), storeConfig());
    Check.equalU64(1, compactionWorkloadCounting(two.bytes(), storeConfig()) as u64)?;
    removeTree(two.view());
    return Ok();
}

/// A table's metadata whose properties are `props` (a JSON object's members), for the codec choice's tests.
fn metadataWith(props: StringView) -> Json {
    var text = textOf("{\"format-version\": 2, \"properties\": {");
    text.append(props)!;
    text.append("}}")!;
    return parseJson(text.view().bytes())!!;
}

/// The codecs and levels taken from the table's properties (ADR-0116 §1, §3; the M25 review's M1): names without
/// case, the codecs not written here, levels out of range or not numbers.
@test
fn codecsFromProperties() -> Result<void, TestFailure> {
    let none = metadataWith("");
    Check.equalI64(PQ_CODEC_ZSTD, pageCodecOf(borrow none))?;
    Check.equalU64(0, codecLevelOf(borrow none, "write.parquet.compression-level") as u64)?;
    Check.equalU64(AVRO_WRITE_DEFLATE as u64, avroCodecOf(borrow none).kind as u64)?;
    let names = [
        "\"ZSTD\"",
        "\"Snappy\"",
        "\"gzip\"",
        "\"uncompressed\"",
        "\"none\"",
        "\"lz4\"",
        "\"brotli\"",
        "\"x\"",
    ];
    let codecs = [
        PQ_CODEC_ZSTD,
        PQ_CODEC_SNAPPY,
        PQ_CODEC_GZIP,
        PQ_CODEC_UNCOMPRESSED,
        PQ_CODEC_UNCOMPRESSED,
        PQ_CODEC_SNAPPY,
        PQ_CODEC_SNAPPY,
        PQ_CODEC_SNAPPY,
    ];
    for (i in 0..names.length) {
        var p = textOf("\"write.parquet.compression-codec\": ");
        p.append(names[i])!;
        let m = metadataWith(p.view());
        Check.equalI64(codecs[i], pageCodecOf(borrow m))?;
    }
    let levels = ["\"1\"", "\"3\"", "\"9\"", "\"15\"", "\"22\"", "\"0\"", "\"-1\"", "\"abc\"", "\"\"", "\" 3\""];
    let taken = [1u64, 3, 9, 9, 9, 0, 0, 0, 0, 0];
    for (i in 0..levels.length) {
        var p = textOf("\"write.parquet.compression-level\": ");
        p.append(levels[i])!;
        let m = metadataWith(p.view());
        Check.equalU64(taken[i], codecLevelOf(borrow m, "write.parquet.compression-level") as u64)?;
    }
    let avroNames = [
        "\"zstd\"",
        "\"ZStandard\"",
        "\"snappy\"",
        "\"gzip\"",
        "\"deflate\"",
        "\"uncompressed\"",
        "\"null\"",
        "\"bzip2\"",
    ];
    let kinds = [
        AVRO_WRITE_ZSTANDARD,
        AVRO_WRITE_ZSTANDARD,
        AVRO_WRITE_SNAPPY,
        AVRO_WRITE_DEFLATE,
        AVRO_WRITE_DEFLATE,
        AVRO_WRITE_NULL,
        AVRO_WRITE_NULL,
        AVRO_WRITE_DEFLATE,
    ];
    for (i in 0..avroNames.length) {
        var p = textOf("\"write.avro.compression-level\": \"7\", \"write.avro.compression-codec\": ");
        p.append(avroNames[i])!;
        let m = metadataWith(p.view());
        let c = avroCodecOf(borrow m);
        Check.equalU64(kinds[i] as u64, c.kind as u64)?;
        let wantLevel: u64 = if (kinds[i] == AVRO_WRITE_ZSTANDARD || kinds[i] == AVRO_WRITE_DEFLATE) 7 else 0;
        Check.equalU64(wantLevel, c.level as u64)?;
    }
    return Ok();
}

/// The level reaches the codec (the M25 review's M2): a page in ZSTD at levels 1, 3 and 9 is lib/std's frame at that
/// level, byte for byte, and gzip's at 1 and 9 is `Gzip`'s.
@test
fn levelsReachTheCodec() -> Result<void, TestFailure> {
    var page = Vector<u8>.create();
    for (i in 0u64..200000) {
        let n = truncate<u32>(i * 2654435761u64);
        page.push(truncate<u8>(n >> 24) % 23 + 'a')!;
    }
    for (level in [1u32, 3, 9]) {
        let got = compressPage(PQ_CODEC_ZSTD, level, page.view())!!;
        var want = Vector<u8>.create();
        Zstd.compress(page.view(), level, mut want)!;
        Check.equalBytes(want.view(), got.view())?;
    }
    // The page is one whose frames differ by level, so a level dropped on the way would be seen.
    let fast = compressPage(PQ_CODEC_ZSTD, 1, page.view())!!;
    let slow = compressPage(PQ_CODEC_ZSTD, 9, page.view())!!;
    Check.isTrue(fast.view() != slow.view(), "levels 1 and 9 differ")?;
    for (level in [1u32, 9]) {
        let got = compressPage(PQ_CODEC_GZIP, level, page.view())!!;
        var want = Vector<u8>.create();
        Gzip.compress(page.view(), level, mut want)!;
        Check.equalBytes(want.view(), got.view())?;
    }
    return Ok();
}
