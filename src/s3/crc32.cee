// CRC-32 (IEEE 802.3, reflected polynomial 0xEDB88320): the AWS CLI's default `x-amz-checksum-crc32`. lib/std has
// CRC-32C and CRC-64/NVME but not this one (CEESAFE_GAPS G26), so it is computed here, one byte at a time from a table
// built on first use.

struct Crc32 {
    private state: u32;
    private table: [u32; 256];

    fn create() -> Crc32 {
        var table = [0u32; 256];
        for (n in 0..256) {
            var c = truncate<u32>(n);
            for (k in 0..8) {
                c = if ((c & 1) != 0) 0xEDB88320 ^ (c >> 1) else c >> 1;
            }
            table[n] = c;
        }
        return Crc32 { state: 0xFFFFFFFF, table: table };
    }

    fn update(borrow mut this, bytes: Slice<u8>) {
        var c = this.state;
        for (i in 0..bytes.length) {
            c = this.table[((c ^ bytes[i] as u32) & 255) as usize] ^ (c >> 8);
        }
        this.state = c;
    }

    fn finish(borrow this) -> u32 => this.state ^ 0xFFFFFFFF;
}

/// The big-endian bytes of a CRC, as S3 base64-encodes it.
fn crc32Bytes(v: u32) -> [u8; 4] =>
    [truncate<u8>(v >> 24), truncate<u8>(v >> 16), truncate<u8>(v >> 8), truncate<u8>(v)];

fn crc64Bytes(v: u64) -> [u8; 8] => [
    truncate<u8>(v >> 56),
    truncate<u8>(v >> 48),
    truncate<u8>(v >> 40),
    truncate<u8>(v >> 32),
    truncate<u8>(v >> 24),
    truncate<u8>(v >> 16),
    truncate<u8>(v >> 8),
    truncate<u8>(v),
];
