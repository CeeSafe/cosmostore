// S3 Tables' configuration of table buckets and tables (ADR-0126): tags and storage class, kept as catalog records.
// A table bucket's are `.s3tables/bucket-config`; a table's, by its id as its policy is, `.s3tables/table-config/<id>`.
import web_core;
import web_http;
import web_server;

const TABLE_BUCKET_CONFIG_KEY: StringView = ".s3tables/bucket-config";
const TABLE_CONFIGS: StringView = ".s3tables/table-config/";
/// S3's limits on a resource's tags.
const TABLES_MAX_TAGS: usize = 50;
const TABLES_MAX_TAG_KEY: usize = 128;
const TABLES_MAX_TAG_VALUE: usize = 256;

fn tableConfigKey(id: Slice<u8>) -> Result<Vector<u8>, AllocError> => catalogKey(TABLE_CONFIGS, id, "".bytes());

/// A resource's configuration record, `{}` when it has none.
fn readTablesConfig(store: borrow ObjectStore, hidden: Slice<u8>, key: Slice<u8>) -> Result<Json, TablesError> {
    return match (readRecord(store, hidden, key)?) {
        Some(r) => Ok(r.json),
        null => Ok(jsonObject()),
    };
}

fn writeTablesConfig(
    store: borrow mut ObjectStore,
    hidden: Slice<u8>,
    key: Slice<u8>,
    config: borrow Json,
) -> Result<void, TablesError> {
    let _ = writeRecord(store, hidden, key, config, PutCondition.None)?;
    return Ok();
}

/// A `tags` map as S3 Tables takes it: strings to strings, 50 at most, keys 1 to 128 characters and values to 256,
/// none of AWS's own (`aws:`); null otherwise.
fn tablesTagsOf(j: borrow Json) -> Result<Vector<JsonMember>?, AllocError> {
    var out = Vector<JsonMember>.create();
    match (j) {
        Json.Object(ms) => {
            if (ms.length > TABLES_MAX_TAGS) { return Ok(null); }
            for (k in 0..ms.length) {
                let key = ms[k].key.view();
                if (key.length == 0 || key.length > TABLES_MAX_TAG_KEY || startsWithBytes(key, "aws:".bytes())) {
                    return Ok(null);
                }
                match (borrow ms[k].value) {
                    Json.Text(t) => {
                        if (t.length > TABLES_MAX_TAG_VALUE) { return Ok(null); }
                    }
                    _ => { return Ok(null); }
                }
                out.push(JsonMember { key: copyBytes(key)?, value: cloneJson(borrow ms[k].value)? })?;
            }
        }
        _ => { return Ok(null); }
    }
    return Ok(Some(out));
}

/// A configuration's tags with `more` added over them; null when they would pass the limit.
fn mergedTags(config: borrow Json, more: Slice<JsonMember>) -> Result<Json?, AllocError> {
    var tags = match (jsonMember(config, "tags")) {
        Some(t) => cloneJson(t)?,
        null => jsonObject(),
    };
    for (m in more) { jsonSet(mut tags, StringView.fromUtf8(m.key.view()) ?? "", cloneJson(borrow m.value)?)?; }
    let count = match (borrow tags) {
        Json.Object(ms) => ms.length,
        _ => 0,
    };
    if (count > TABLES_MAX_TAGS) { return Ok(null); }
    return Ok(Some(tags));
}

/// A storage class S3 Tables takes: STANDARD or INTELLIGENT_TIERING.
fn tablesStorageClassOk(name: Slice<u8>) -> bool =>
    name == "STANDARD".bytes() || name == "INTELLIGENT_TIERING".bytes();

/// A `storageClassConfiguration`'s class; null when it is not one taken.
fn storageClassConfigOf(j: borrow Json) -> Result<Vector<u8>?, AllocError> {
    let name = jsonMemberText(j, "storageClass") ?? { return Ok(null); };
    if (!tablesStorageClassOk(name)) { return Ok(null); }
    return Ok(Some(copyBytes(name)?));
}

/// A create's `tags` and `storageClassConfiguration`, as a configuration record; `inherited` the class when it gives
/// none (a table its bucket's). Err(BadRequest) for ones not taken.
fn createdConfigOf(request: borrow Json, inherited: Slice<u8>) -> Result<Json, TablesError> {
    var config = jsonObject();
    match (jsonMember(request, "tags")) {
        Some(t) => {
            let tags = tablesTagsOf(t)? ?? { return Err(TablesError.BadRequest); };
            jsonSet(mut config, "tags", Json.Object(tags))?;
        }
        null => {}
    }
    var storageClass = copyBytes(inherited)?;
    match (jsonMember(request, "storageClassConfiguration")) {
        Some(s) => { storageClass = storageClassConfigOf(s)? ?? { return Err(TablesError.BadRequest); }; }
        null => {}
    }
    jsonSet(mut config, "storageClass", Json.Text(storageClass))?;
    return Ok(config);
}

/// Whether a created resource's configuration is all defaults (no tags, STANDARD, no encryption): one with no record.
fn isDefaultConfig(config: borrow Json) -> bool {
    match (jsonMember(config, "tags")) {
        Some(Json.Object(t)) => {
            if (t.length > 0) { return false; }
        }
        Some(_) => { return false; }
        null => {}
    }
    if ((jsonMemberText(config, "storageClass") ?? "STANDARD".bytes()) != "STANDARD".bytes()) { return false; }
    return jsonMember(config, "encryption").isNull();
}

/// A table bucket's storage class: its configuration's, STANDARD when it set none.
fn bucketStorageClass(store: borrow ObjectStore, hidden: Slice<u8>) -> Result<Vector<u8>, TablesError> {
    let config = readTablesConfig(store, hidden, TABLE_BUCKET_CONFIG_KEY.bytes())?;
    return Ok(copyBytes(jsonMemberText(borrow config, "storageClass") ?? "STANDARD".bytes())?);
}

/// A table's storage class: its own, else its bucket's.
fn tableStorageClass(store: borrow ObjectStore, hidden: Slice<u8>, id: Slice<u8>) -> Result<Vector<u8>, TablesError> {
    let config = readTablesConfig(store, hidden, tableConfigKey(id)?.view())?;
    return match (jsonMemberText(borrow config, "storageClass")) {
        Some(c) => Ok(copyBytes(c)?),
        null => bucketStorageClass(store, hidden),
    };
}

/// Whether a table of the bucket has the id: its record, among the bucket's tables.
fn tableIdExists(store: borrow ObjectStore, hidden: Slice<u8>, id: Slice<u8>) -> Result<bool, TablesError> {
    var after = Vector<u8>.create();
    while (true) {
        let keys = catalogKeys(store, hidden, CATALOG_TABLES.bytes(), after.view(), 1000)?;
        if (keys.length == 0) { return Ok(false); }
        for (k in keys.view()) {
            match (readRecord(store, hidden, k.view())?) {
                Some(r) => {
                    if (jsonMemberText(borrow r.json, "id") == Some(id)) { return Ok(true); }
                }
                null => {}
            }
        }
        after = copyBytes(keys[keys.length - 1].view())?;
    }
    return Ok(false);
}

/// The configuration record of a tag call's resource: a table bucket's, or a table's by its id; NotFound when it is
/// not there.
fn taggedKeyOf(store: borrow ObjectStore, bucket: Slice<u8>, id: Slice<u8>) -> Result<Vector<u8>, TablesError> {
    let _ = tableBucketRecord(store, bucket)?;
    if (id.length == 0) { return Ok(copyBytes(TABLE_BUCKET_CONFIG_KEY.bytes())?); }
    let hidden = tableWarehouseBucket(bucket)?;
    if (!tableIdExists(store, hidden.view(), id)?) { return Err(TablesError.NotFound); }
    return Ok(tableConfigKey(id)?);
}

/// TagResource, UntagResource and ListTagsForResource (ADR-0126 §1).
fn tablesTagCall(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    bucket: Slice<u8>,
    id: Slice<u8>,
    body: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(bucket)?;
    let key = taggedKeyOf(store, bucket, id)?;
    var config = readTablesConfig(store, hidden.view(), key.view())?;
    if (isMethod(req.method, Method.Get)) {
        var answer = jsonObject();
        jsonSet(
            mut answer,
            "tags",
            match (jsonMember(borrow config, "tags")) {
                Some(t) => cloneJson(t)?,
                null => jsonObject(),
            },
        )?;
        return tablesJson(borrow answer);
    }
    if (isMethod(req.method, Method.Post)) {
        let j = tablesObject(body)?;
        let more = tablesTagsOf(jsonMember(borrow j, "tags") ?? { return Err(TablesError.BadRequest); })? ?? {
            return Err(TablesError.BadRequest);
        };
        let tags = mergedTags(borrow config, more.view())? ?? { return Err(TablesError.BadRequest); };
        jsonSet(mut config, "tags", tags)?;
        writeTablesConfig(store, hidden.view(), key.view(), borrow config)?;
        return tablesJson(borrow jsonObject());
    }
    if (isMethod(req.method, Method.Delete)) {
        var tags = match (jsonMember(borrow config, "tags")) {
            Some(t) => cloneJson(t)?,
            null => jsonObject(),
        };
        for (k in paramValues(req, "tagKeys")?.view()) { jsonRemove(mut tags, k.view()); }
        jsonSet(mut config, "tags", tags)?;
        writeTablesConfig(store, hidden.view(), key.view(), borrow config)?;
        return Ok(tablesNoContent());
    }
    return Err(TablesError.BadRequest);
}

/// PutTableBucketStorageClass and GetTableBucketStorageClass (ADR-0126 §2).
fn bucketStorageClassCall(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    bucket: Slice<u8>,
    body: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(bucket)?;
    if (isMethod(req.method, Method.Put)) {
        let j = tablesObject(body)?;
        let c = storageClassConfigOf(jsonMember(borrow j, "storageClassConfiguration") ?? {
            return Err(TablesError.BadRequest);
        })? ?? { return Err(TablesError.BadRequest); };
        var config = readTablesConfig(store, hidden.view(), TABLE_BUCKET_CONFIG_KEY.bytes())?;
        jsonSet(mut config, "storageClass", Json.Text(c))?;
        writeTablesConfig(store, hidden.view(), TABLE_BUCKET_CONFIG_KEY.bytes(), borrow config)?;
        return tablesJson(borrow jsonObject());
    }
    if (isMethod(req.method, Method.Get)) {
        return storageClassAnswer(bucketStorageClass(store, hidden.view())?.view());
    }
    return Err(TablesError.BadRequest);
}

fn storageClassAnswer(storageClass: Slice<u8>) -> Result<TablesAnswer, TablesError> {
    var inner = jsonObject();
    jsonSet(mut inner, "storageClass", jsonString(storageClass)?)?;
    var answer = jsonObject();
    jsonSet(mut answer, "storageClassConfiguration", inner)?;
    return tablesJson(borrow answer);
}

/// The values of a query parameter given more than once (`tagKeys=a&tagKeys=b`), or once with commas.
fn paramValues(req: borrow S3Request, name: StringView) -> Result<Vector<Vector<u8>>, AllocError> {
    var out = Vector<Vector<u8>>.create();
    for (p in req.query.view()) {
        if (p.name.view() != name.bytes()) { continue; }
        let text = StringView.fromUtf8(p.value.view()) ?? { continue; };
        for (part in text.split(",")) {
            if (part.bytes().length > 0) { out.push(copyBytes(part.bytes())?)?; }
        }
    }
    return Ok(out);
}

/// A write into a table's warehouse that asks for no storage class takes its table's (ADR-0126 §2): its metadata with
/// the class recorded, when that is not STANDARD.
async fn withTableStorageClass(
    app: borrow S3App,
    req: borrow S3Request,
    metadata: Vector<u8>,
) -> Result<Vector<u8>, S3Fail> {
    let hidden = req.bucket.bytes();
    if (!isTableWarehouseShaped(hidden) || headerOf(req, STORAGE_CLASS_FIELD).isSome()) { return Ok(metadata); }
    let id = copyBytes(tableIdOfKey(req.key.bytes(), false) ?? { return Ok(metadata); })?;
    var stored: Vector<u8>? = null;
    {
        var guard = await lockStore(app)?;
        let store = guard.data();
        let idView = id.view();
        stored = match (await Async.blocking(() => tableStorageClass(store, hidden, idView))) {
            Ok(c) => Some(c),
            Err(TablesError.OutOfMemory(e)) => { return Err(S3Fail.OutOfMemory(e)); }
            Err(_) => null,
        };
    }
    let storageClass = stored ?? { return Ok(metadata); };
    if (storageClass.view() == "STANDARD".bytes()) { return Ok(metadata); }
    var out = metadata;
    metadataAdd(mut out, STORAGE_CLASS_FIELD.bytes(), storageClass.view())?;
    return Ok(out);
}

// ---- Encryption (ADR-0126 §3, §4) ----

/// An `encryptionConfiguration` as S3 Tables takes it: `AES256`, or `aws:kms` with a `kmsKeyArn` naming a KMS key
/// (its ARN or id); kept as `{sseAlgorithm, kmsKeyArn}`. Null when it is not one taken.
fn encryptionConfigOf(j: borrow Json) -> Result<Json?, AllocError> {
    let algorithm = jsonMemberText(j, "sseAlgorithm") ?? { return Ok(null); };
    var out = jsonObject();
    if (algorithm == "AES256".bytes()) {
        if (jsonMember(j, "kmsKeyArn").isSome()) { return Ok(null); }
        jsonSet(mut out, "sseAlgorithm", jsonString("AES256".bytes())?)?;
        return Ok(Some(out));
    }
    if (algorithm != "aws:kms".bytes()) { return Ok(null); }
    let key = jsonMemberText(j, "kmsKeyArn") ?? { return Ok(null); };
    if (kmsKeyNameOf(key).isNull()) { return Ok(null); }
    jsonSet(mut out, "sseAlgorithm", jsonString("aws:kms".bytes())?)?;
    jsonSet(mut out, "kmsKeyArn", jsonString(key)?)?;
    return Ok(Some(out));
}

/// What a kept encryption seals with: SSE-S3, or SSE-KMS by its key.
fn sseOfEncryption(e: borrow Json) -> SseRequest {
    if (jsonMemberText(e, "sseAlgorithm") == Some("aws:kms".bytes())) {
        return match (kmsKeyNameOf(jsonMemberText(e, "kmsKeyArn") ?? "".bytes())) {
            Some(n) => SseRequest.Kms(n),
            null => SseRequest.Managed,
        };
    }
    return SseRequest.Managed;
}

/// A table bucket's encryption, null when it has none.
fn bucketEncryption(store: borrow ObjectStore, hidden: Slice<u8>) -> Result<Json?, TablesError> {
    let config = readTablesConfig(store, hidden, TABLE_BUCKET_CONFIG_KEY.bytes())?;
    return match (jsonMember(borrow config, "encryption")) {
        Some(e) => Ok(Some(cloneJson(e)?)),
        null => Ok(null),
    };
}

/// A table's encryption, as its create set it (its own, or its bucket's then); null when it has none.
fn tableEncryption(store: borrow ObjectStore, hidden: Slice<u8>, id: Slice<u8>) -> Result<Json?, TablesError> {
    let config = readTablesConfig(store, hidden, tableConfigKey(id)?.view())?;
    return match (jsonMember(borrow config, "encryption")) {
        Some(e) => Ok(Some(cloneJson(e)?)),
        null => Ok(null),
    };
}

fn encryptionAnswer(e: borrow Json?) -> Result<TablesAnswer, TablesError> {
    var answer = jsonObject();
    jsonSet(
        mut answer,
        "encryptionConfiguration",
        match (e) {
            Some(x) => cloneJson(x)?,
            null => {
                var managed = jsonObject();
                jsonSet(mut managed, "sseAlgorithm", jsonString("AES256".bytes())?)?;
                managed
            }
        },
    )?;
    return tablesJson(borrow answer);
}

/// PutTableBucketEncryption, GetTableBucketEncryption and DeleteTableBucketEncryption (ADR-0126 §3): the bucket's
/// encryption, its tables' default at their create.
fn bucketEncryptionCall(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    bucket: Slice<u8>,
    body: Slice<u8>,
    keys: borrow WarehouseKeys,
) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(bucket)?;
    var config = readTablesConfig(store, hidden.view(), TABLE_BUCKET_CONFIG_KEY.bytes())?;
    if (isMethod(req.method, Method.Put)) {
        let j = tablesObject(body)?;
        let e = heldEncryptionOf(jsonMember(borrow j, "encryptionConfiguration") ?? {
            return Err(TablesError.BadRequest);
        }, keys)?;
        jsonSet(mut config, "encryption", e)?;
        writeTablesConfig(store, hidden.view(), TABLE_BUCKET_CONFIG_KEY.bytes(), borrow config)?;
        return tablesJson(borrow jsonObject());
    }
    if (isMethod(req.method, Method.Get)) {
        let kept: Json? = match (jsonMember(borrow config, "encryption")) {
            Some(e) => Some(cloneJson(e)?),
            null => { return Err(TablesError.NotFound); }
        };
        return encryptionAnswer(kept.asBorrow());
    }
    if (isMethod(req.method, Method.Delete)) {
        jsonRemove(mut config, "encryption".bytes());
        writeTablesConfig(store, hidden.view(), TABLE_BUCKET_CONFIG_KEY.bytes(), borrow config)?;
        return Ok(tablesNoContent());
    }
    return Err(TablesError.BadRequest);
}

/// A create's encryption (ADR-0126 §3): its own `encryptionConfiguration`, else `inherited` (its bucket's); none
/// when neither is given. Err(BadRequest) for one not taken.
/// Whether this server can seal with an encryption configuration, as S3's PutBucketEncryption asks (ADR-0126 §3):
/// AES256 with an SSE-S3 key file; `aws:kms` with the KMS key it names, not one being retired.
fn encryptionHeld(e: borrow Json, keys: borrow WarehouseKeys) -> bool {
    if ((jsonMemberText(e, "sseAlgorithm") ?? "".bytes()) != "aws:kms".bytes()) { return keys.sse.length > 0; }
    let name = kmsKeyNameOf(jsonMemberText(e, "kmsKeyArn") ?? "".bytes()) ?? { return false; };
    for (k in keys.kms) {
        if (k.id.view() == name.view() && !k.retiring) { return true; }
    }
    return false;
}

/// An encryption configuration a request gives, when it is valid and this server holds its key.
fn heldEncryptionOf(j: borrow Json, keys: borrow WarehouseKeys) -> Result<Json, TablesError> {
    let e = encryptionConfigOf(j)? ?? { return Err(TablesError.BadRequest); };
    if (!encryptionHeld(borrow e, keys)) { return Err(TablesError.BadRequest); }
    return Ok(e);
}

fn createdEncryptionOf(
    request: borrow Json,
    inherited: borrow Json?,
    keys: borrow WarehouseKeys,
) -> Result<Json?, TablesError> {
    return match (jsonMember(request, "encryptionConfiguration")) {
        Some(e) => Ok(Some(heldEncryptionOf(e, keys)?)),
        // Its bucket's, if this server still seals with it (a KMS key retired since is refused, the M30 exit review).
        null => match (inherited) {
            Some(i) => {
                if (!encryptionHeld(i, keys)) { return Err(TablesError.BadRequest); }
                Ok(Some(cloneJson(i)?))
            }
            null => Ok(null),
        },
    };
}

/// The encryption a write into a table's warehouse is sealed with (ADR-0126 §4): its table's, when it has one and
/// the write asks for none; null when the table has none (the bucket's default applies, as S3's). A write that asks
/// for another than its table's is refused, as S3 Tables refuses.
async fn tableWriteSse(
    app: borrow S3App,
    bucket: Slice<u8>,
    key: Slice<u8>,
    asked: borrow SseRequest,
) -> Result<SseRequest?, S3Fail> {
    if (!isTableWarehouseShaped(bucket)) { return Ok(null); }
    let id = copyBytes(tableIdOfKey(key, false) ?? { return Ok(null); })?;
    var found: Json? = null;
    {
        var guard = await lockStore(app)?;
        let store = guard.data();
        let idView = id.view();
        // A configuration that cannot be read fails the write: taken as none, an encrypted table's file would be
        // stored in the clear (the M30 exit review).
        found = match (await Async.blocking(() => tableEncryption(store, bucket, idView))) {
            Ok(e) => e,
            Err(TablesError.OutOfMemory(e)) => { return Err(S3Fail.OutOfMemory(e)); }
            Err(_) => { return Err(S3Fail.Code(S3Code.InternalError)); }
        };
    }
    let e = found ?? { return Ok(null); };
    let table = sseOfEncryption(borrow e);
    let same = match (asked) {
        SseRequest.None => true,
        SseRequest.Managed => match (table) {
            SseRequest.Managed => true,
            _ => false,
        },
        SseRequest.Kms(n) => match (borrow table) {
            SseRequest.Kms(t) => n.view() == t.view() || n.view().length == 0,
            _ => false,
        },
        SseRequest.Customer(_) => false,
    };
    if (!same) { return Err(S3Fail.Code(S3Code.InvalidArgument)); }
    return Ok(Some(table));
}

// ---- Logging (ADR-0130 §1) ----

/// A table bucket's logging as GetTableBucketLogging answers it: `{"tableBucketLoggingStatus": {}}` when off.
fn tableLoggingAnswer(stored: Slice<u8>) -> Result<TablesAnswer, TablesError> {
    var status = jsonObject();
    match (decodeLogging(stored)) {
        Some(t) => {
            var partitioned = jsonObject();
            let source = if (t.keys == LOG_KEYS_DELIVERY_TIME) "DeliveryTime" else "EventTime";
            jsonSet(mut partitioned, "partitionDateSource", jsonString(source.bytes())?)?;
            var format = jsonObject();
            jsonSet(mut format, "partitionedPrefix", partitioned)?;
            var enabled = jsonObject();
            jsonSet(mut enabled, "targetBucket", jsonString(t.bucket.view())?)?;
            jsonSet(mut enabled, "targetPrefix", jsonString(t.prefix.view())?)?;
            jsonSet(mut enabled, "targetObjectKeyFormat", format)?;
            jsonSet(mut status, "loggingEnabled", enabled)?;
        }
        null => {}
    }
    var answer = jsonObject();
    jsonSet(mut answer, "tableBucketLoggingStatus", status)?;
    return tablesJson(borrow answer);
}

/// GetTableBucketLogging, under the store.
fn getTableBucketLogging(
    store: borrow ObjectStore,
    caller: borrow TablesCaller,
    bucket: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let _ = tableBucketRecord(store, bucket)?;
    checkTables(store, caller, "s3tables:GetTableBucketLogging", bucket, "".bytes())?;
    let hidden = tableWarehouseBucket(bucket)?;
    let stored = match (store.bucketConfig(catalogText(hidden.view()), BUCKET_CONFIG_LOGGING)) {
        Ok(s) => s,
        Err(e) => { return Err(tablesStoreFail(e)); }
    };
    return tableLoggingAnswer(stored.view());
}

/// A PutTableBucketLogging body's target: null to turn logging off. Its key format must be partitioned, as S3 Tables
/// takes no other (EventTime when it names no date source).
fn tableLoggingTargetOf(body: Slice<u8>) -> Result<LoggingTarget?, TablesError> {
    let j = tablesObject(body)?;
    let status = jsonMember(borrow j, "tableBucketLoggingStatus") ?? { return Err(TablesError.BadRequest); };
    let enabled = jsonMember(status, "loggingEnabled") ?? { return Ok(null); };
    let bucket = jsonMemberText(enabled, "targetBucket") ?? { return Err(TablesError.BadRequest); };
    let prefix = match (jsonMember(enabled, "targetPrefix")) {
        Some(Json.Text(p)) => copyBytes(p.view())?,
        Some(_) => { return Err(TablesError.BadRequest); }
        null => Vector<u8>.create(),
    };
    var keys = LOG_KEYS_EVENT_TIME;
    match (jsonMember(enabled, "targetObjectKeyFormat")) {
        Some(f) => {
            if (jsonMember(f, "simplePrefix").isSome()) { return Err(TablesError.BadRequest); }
            match (jsonMember(f, "partitionedPrefix")) {
                Some(p) => {
                    match (jsonMemberText(p, "partitionDateSource")) {
                        Some(s) => {
                            if (s == "DeliveryTime".bytes()) {
                                keys = LOG_KEYS_DELIVERY_TIME;
                            } else if (s != "EventTime".bytes()) {
                                return Err(TablesError.BadRequest);
                            }
                        }
                        null => {}
                    }
                }
                null => { return Err(TablesError.BadRequest); }
            }
        }
        null => {}
    }
    if (bucket.length == 0 || bucket.length > 63 || prefix.length > 1024) { return Err(TablesError.BadRequest); }
    // A general purpose bucket: not a table bucket's warehouse, a hidden one or a directory bucket.
    if (isHiddenBucketName(bucket) || isTableWarehouseShaped(bucket) || isDirectoryShaped(bucket)) {
        return Err(TablesError.BadRequest);
    }
    return Ok(
        Some(LoggingTarget { bucket: copyBytes(bucket)?, prefix: prefix, requester: Vector<u8>.create(), keys: keys }),
    );
}

/// The checks of a target that need its bucket (ADR-0130 §1): there (on `serve`; a cluster's other shard's is not
/// seen here, as S3's logging takes it), without SSE-KMS default encryption or object lock.
fn tableLoggingTargetFits(store: borrow ObjectStore, target: Slice<u8>, cluster: bool) -> Result<bool, TablesError> {
    let name = catalogText(target);
    let there = match (store.bucketExists(name)) {
        Ok(t) => t,
        Err(e) => { return Err(tablesStoreFail(e)); }
    };
    if (!there) { return Ok(cluster); }
    let encryption = match (store.bucketConfig(name, BUCKET_CONFIG_ENCRYPTION)) {
        Ok(e) => e,
        Err(e) => { return Err(tablesStoreFail(e)); }
    };
    if (startsWithBytes(encryption.view(), "aws:kms".bytes())) { return Ok(false); }
    let lock = match (store.bucketConfig(name, BUCKET_CONFIG_OBJECT_LOCK)) {
        Ok(l) => l,
        Err(e) => { return Err(tablesStoreFail(e)); }
    };
    return Ok(lock.length == 0);
}

/// PutTableBucketLogging (ADR-0130 §1): its target checked, and kept as its warehouse's logging configuration, with
/// who put it (ADR-0094); `{}` turns it off.
async fn putTableBucketLogging(
    app: borrow S3App,
    req: borrow S3Request,
    who: borrow Requester,
    caller: borrow TablesCaller,
    bucket: Slice<u8>,
    body: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    {
        var guard = await lockStore(app)?;
        let store = guard.data();
        await Async.blocking(() => tablesAllowedOnBucket(store, caller, "s3tables:PutTableBucketLogging", bucket))?;
    }
    var stored = Vector<u8>.create();
    match (tableLoggingTargetOf(body)?) {
        Some(parsed) => {
            var t = parsed;
            // The caller's logs go only where it may write (as S3's PutBucketLogging, the M11 exit review's A1).
            match (await authorizeDestination(app, req, who, "s3:PutObject", t.bucket.view(), t.prefix.view())) {
                Ok() => {}
                Err(S3Fail.OutOfMemory(e)) => { return Err(TablesError.OutOfMemory(e)); }
                Err(_) => { return Err(TablesError.Forbidden); }
            }
            var fits = false;
            {
                var guard = await lockStore(app)?;
                let store = guard.data();
                let target = t.bucket.view();
                let cluster = app.cluster;
                fits = await Async.blocking(() => tableLoggingTargetFits(store, target, cluster))?;
            }
            if (!fits) { return Err(TablesError.BadRequest); }
            t.requester = requesterText(app, who)?;
            encodeLogging(borrow t, mut stored)?;
        }
        null => {}
    }
    let hidden = tableWarehouseBucket(bucket)?;
    {
        var guard = await lockStore(app)?;
        let store = guard.data();
        let h = catalogText(hidden.view());
        let value = stored.view();
        match (await Async.blocking(() => store.setBucketConfig(h, BUCKET_CONFIG_LOGGING, value))) {
            Ok() => {}
            Err(e) => { return Err(tablesStoreFail(e)); }
        }
    }
    match (await recountLogging(app)) {
        Ok() => {}
        Err(S3Fail.OutOfMemory(e)) => { return Err(TablesError.OutOfMemory(e)); }
        Err(_) => { return Err(TablesError.Internal); }
    }
    return tablesJson(borrow jsonObject());
}

/// The table bucket is there and the caller may do `action` on it (its policy and identity's, ADR-0084).
fn tablesAllowedOnBucket(
    store: borrow ObjectStore,
    caller: borrow TablesCaller,
    action: StringView,
    bucket: Slice<u8>,
) -> Result<void, TablesError> {
    let _ = tableBucketRecord(store, bucket)?;
    return checkTables(store, caller, action, bucket, "".bytes());
}

// ---- Metrics (ADR-0130 §4) ----

/// One table bucket's requests since the server started: all, and those answered 4xx and 5xx.
struct TablesCount {
    bucket: Vector<u8>;
    requests: u64;
    clientErrors: u64;
    serverErrors: u64;
}

/// Put, Get and DeleteTableBucketMetricsConfiguration: kept in the table bucket's configuration record, with an id
/// given at its Put; Get answers its table bucket's ARN and that id, NotFoundException when it is off.
fn bucketMetricsCall(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    bucket: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(bucket)?;
    var config = readTablesConfig(store, hidden.view(), TABLE_BUCKET_CONFIG_KEY.bytes())?;
    if (isMethod(req.method, Method.Put)) {
        if (jsonMember(borrow config, "metrics").isNull()) {
            var id = Vector<u8>.create();
            if (!newUuid(mut id)?) { return Err(TablesError.Internal); }
            var metrics = jsonObject();
            jsonSet(mut metrics, "id", Json.Text(id))?;
            jsonSet(mut config, "metrics", metrics)?;
            writeTablesConfig(store, hidden.view(), TABLE_BUCKET_CONFIG_KEY.bytes(), borrow config)?;
        }
        return Ok(tablesAnswer(200, Vector<u8>.create()));
    }
    if (isMethod(req.method, Method.Delete)) {
        if (jsonMember(borrow config, "metrics").isSome()) {
            jsonRemove(mut config, "metrics".bytes());
            writeTablesConfig(store, hidden.view(), TABLE_BUCKET_CONFIG_KEY.bytes(), borrow config)?;
        }
        return Ok(tablesNoContent());
    }
    if (!isMethod(req.method, Method.Get)) { return Err(TablesError.BadRequest); }
    let metrics = jsonMember(borrow config, "metrics") ?? { return Err(TablesError.NotFound); };
    var arn = Vector<u8>.create();
    tableBucketArn(req, bucket, mut arn)?;
    var answer = jsonObject();
    jsonSet(mut answer, "tableBucketARN", Json.Text(arn))?;
    jsonSet(mut answer, "id", jsonString(jsonMemberText(metrics, "id") ?? "".bytes())?)?;
    return tablesJson(borrow answer);
}

/// Whether a table bucket's metrics are on (ADR-0130 §4).
fn tablesMetricsOn(store: borrow ObjectStore, bucket: Slice<u8>) -> bool {
    let hidden = match (tableWarehouseBucket(bucket)) {
        Ok(h) => h,
        Err(_) => { return false; }
    };
    return match (readTablesConfig(store, hidden.view(), TABLE_BUCKET_CONFIG_KEY.bytes())) {
        Ok(c) => jsonMember(borrow c, "metrics").isSome(),
        Err(_) => false,
    };
}

/// For each counted table bucket, whether its metrics are on (its configuration read under the store).
fn metricsOnOf(store: borrow ObjectStore, counts: Slice<TablesCount>) -> Result<Vector<bool>, AllocError> {
    var on = Vector<bool>.create();
    for (c in counts) { on.push(tablesMetricsOn(store, c.bucket.view()))?; }
    return Ok(on);
}

/// A table bucket's request counted (ADR-0130 §4), by its answer's status: a request naming none is not.
async fn countTablesRequest(
    app: borrow S3App,
    req: borrow S3Request,
    body: Slice<u8>,
    answered: borrow Result<TablesAnswer, TablesError>,
) {
    let bucket = match (tablesBucketOfRequest(req, body)) {
        Ok(Some(b)) => b,
        _ => { return; }
    };
    let status: u16 = match (answered) {
        Ok(a) => a.status,
        Err(e) => tablesErrorStatus(e),
    };
    var guard = match (await app.tablesCounts.lock()) {
        Ok(g) => g,
        Err(_) => { return; }
    };
    let counts = guard.data();
    var at = counts.length;
    for (i in 0..counts.length) {
        if (counts[i].bucket.view() == bucket.view()) { at = i; }
    }
    if (at == counts.length) {
        let made = counts.push(TablesCount { bucket: bucket, requests: 0, clientErrors: 0, serverErrors: 0 });
        if (made.isErr()) { return; }
    }
    counts[at].requests += 1;
    if (status >= 400 && status < 500) { counts[at].clientErrors += 1; }
    if (status >= 500) { counts[at].serverErrors += 1; }
}

/// The stats endpoint's `tableBuckets` (ADR-0130 §4): the counts of the table buckets whose metrics are on, as a
/// JSON field (with its trailing comma).
async fn tablesCountsField(app: borrow S3App) -> Result<Vector<u8>, S3Fail> {
    var counts = Vector<TablesCount>.create();
    {
        var guard = match (await app.tablesCounts.lock()) {
            Ok(g) => g,
            Err(_) => { return Err(S3Fail.Code(S3Code.ServiceUnavailable)); }
        };
        for (c in guard.data().view()) {
            counts.push(TablesCount {
                bucket: copyBytes(c.bucket.view())?,
                requests: c.requests,
                clientErrors: c.clientErrors,
                serverErrors: c.serverErrors,
            })?;
        }
    }
    var on = Vector<bool>.create();
    {
        var guard = await lockStore(app)?;
        let store = guard.data();
        let cs = counts.view();
        on = await Async.blocking(() => metricsOnOf(store, cs))?;
    }
    var out = Vector<u8>.create();
    out.extend("\"tableBuckets\": [".bytes())?;
    var first = true;
    for (i in 0..counts.length) {
        if (!on[i]) { continue; }
        if (!first) { out.extend(", ".bytes())?; }
        first = false;
        out.extend("{\"name\": \"".bytes())?;
        out.extend(counts[i].bucket.view())?;
        out.extend("\", \"requests\": ".bytes())?;
        appendDecimal(mut out, counts[i].requests)?;
        out.extend(", \"clientErrors\": ".bytes())?;
        appendDecimal(mut out, counts[i].clientErrors)?;
        out.extend(", \"serverErrors\": ".bytes())?;
        appendDecimal(mut out, counts[i].serverErrors)?;
        out.push('}')?;
    }
    out.extend("],\n  ".bytes())?;
    return Ok(out);
}
