// Compaction (ADR-0098): a table's small Parquet data files joined, a bin at a time, by copying their column chunks
// under a new footer (`parquet.cee`), and committed as one `replace` snapshot through the catalog's conditional write.
//
// What is never rewritten: a file in a partition that has a live delete file (or when a delete file's spec is not the
// data file's), a file sealed with SSE (its stored bytes are not its Parquet bytes), a file of another bucket, a file
// whose footer this cannot join, and a file whose stored size is not its manifest's. Not knowing is not compacting.
import web_core;
import web_transport;
import web_http;
import web_server;

/// A file is compacted when it is under this share of the target, in percent (ADR-0098 §2).
const COMPACTION_SMALL_PERCENT: u64 = 75;
/// Whether partitions with delete files are compacted, their deletes applied (ADR-0114); off, every partition with a
/// delete file stays as it is (ADR-0098 §2).
const COMPACTION_APPLIES_DELETES: bool = true;
/// The most files one run reads the footers of: a table of more is compacted over several runs.
const COMPACTION_MAX_CANDIDATES: usize = 10000;

/// A data file to join: where it is, its manifest entry, and its footer.
struct CompactionInput {
    path: Vector<u8>;
    key: Vector<u8>;
    size: u64;
    /// Its version's generation when planned: any overwrite since changes it (the M16 exit review).
    generation: u64;
    footer: ParquetFooter;
    /// Its manifest (an index into the plan's manifests) and its entry there.
    manifest: usize;
    entry: usize;
    /// Its data sequence number (format v2): the entry's, or its manifest's when the entry inherits it.
    sequence: i64;
    /// Its spec and partition (as JSON), as a delete file's.
    partitionKey: Vector<u8>;
    /// Its spec, partition (as JSON) and shape: the files of a bin share them.
    group: Vector<u8>;
}

/// Files joined into one, and the join's plan.
struct CompactionBin {
    inputs: Vector<CompactionInput>;
    join: ParquetJoin;
    /// Its files' pages all read here (ADR-0112 §4): their values are rewritten as row groups of the target size,
    /// rather than their chunks copied.
    merge: bool;
    /// The plan's delete files that apply to its files (ADR-0114 §3): applied as it merges. Such a bin is never
    /// joined, since a position delete names its files' paths.
    deletes: Vector<usize>;
}

/// Iceberg's default row group size, when the table sets none (`write.parquet.row-group-size-bytes`).
const COMPACTION_ROW_GROUP_BYTES: u64 = 134217728;
/// The largest row group a merge writes: its decoded values are held while it is written.
const COMPACTION_MAX_ROW_GROUP_BYTES: u64 = 268435456;
/// A merge's row group is written at this many levels in a column too, below the reader's PQ_MAX_CHUNK_LEVELS, so
/// that a merged file is always one the next merge reads.
const COMPACTION_GROUP_LEVELS: usize = 16777216;

/// Whether ZSTD is written: lib/std's zstd encoder (ADR 0196 phase 4, ceesafec 0.95.1). Off, a table that asks for
/// ZSTD gets SNAPPY pages (ADR-0111's choice).
const COMPACTION_WRITES_ZSTD: bool = true;

/// The codec merged files were written with before ADR-0116, and the one for a codec not written here.
const COMPACTION_PAGE_CODEC: i64 = 1;

/// What a run read under the store, and what it will join.
struct CompactionPlan {
    bucket: Vector<u8>;
    hidden: Vector<u8>;
    id: Vector<u8>;
    ns: Vector<u8>;
    name: Vector<u8>;
    location: Vector<u8>;
    metadata: Json;
    previousStamp: i64;
    formatVersion: i64;
    snapshot: i64;
    /// The current snapshot's manifest list, and its manifests in its order.
    list: AvroFile;
    manifests: Vector<AvroFile>;
    bins: Vector<CompactionBin>;
    /// The row groups a merged file is written in, about this many bytes each.
    rowGroupBytes: u64;
    /// The live delete files of the partitions compacted with their deletes (ADR-0114 §3).
    deletes: Vector<DeleteFile>;
    /// The codecs a merged file's pages and the run's manifests are written in: the table's (ADR-0116).
    pageCodec: i64;
    pageLevel: u32;
    avroCodec: AvroCodec;
}

/// A file a run wrote: its key and path, and its length.
struct CompactionOutput {
    key: Vector<u8>;
    path: Vector<u8>;
    length: u64;
    /// A merged file's metrics from its rows (ADR-0114 §2); null for a joined file, whose are its inputs' combined.
    metrics: FileMetrics?;
}

/// A bin's file written, and a merged one's metrics.
struct BinWritten {
    obj: FinishedObject;
    metrics: FileMetrics?;
}

// ---- The plan ----

/// The job's target in bytes, when it is enabled and binpacks; `Failed` written, and null, for a strategy not done.
fn compactionTarget(
    store: borrow mut ObjectStore,
    hidden: Slice<u8>,
    id: Slice<u8>,
    nowMs: i64,
) -> Result<u64?, TablesError> {
    let configKey = tableMaintenanceKey(id)?;
    let document = maintenanceDocument(store, hidden, configKey.view())?;
    let value = maintenanceValue(borrow document, COMPACTION)?;
    if (!maintenanceEnabled(borrow value)) { return Ok(null); }
    let strategy = match (jsonMember(borrow value, "settings")) {
        Some(s) => match (jsonMember(s, COMPACTION)) {
            Some(c) => copyBytes(jsonMemberText(c, "strategy") ?? "auto".bytes())?,
            null => copyBytes("auto".bytes())?,
        },
        null => copyBytes("auto".bytes())?,
    };
    if (strategy.view() != "auto".bytes() && strategy.view() != "binpack".bytes()) {
        writeJobStatus(
            store,
            hidden,
            id,
            COMPACTION,
            "Failed",
            "Only the binpack strategy is done here (auto is binpack); sort and z-order are not.",
            nowMs,
        )?;
        return Ok(null);
    }
    let mb = maintenanceSetting(borrow value, COMPACTION, "targetFileSizeMB") ?? 512;
    return Ok(Some(truncate<u64>(mb) * 1048576));
}

/// The member `name` of a record as an integer; `fallback` when it is null or absent.
fn recordInt(record: borrow Json, name: StringView, fallback: i64) -> i64 => match (jsonMember(record, name)) {
    Some(v) => jsonI64(v) ?? fallback,
    null => fallback,
};

/// A record's member as JSON text, for grouping by it.
fn jsonTextOf(j: borrow Json) -> Result<Vector<u8>, AllocError> {
    var out = Vector<u8>.create();
    writeJson(mut out, j)?;
    return Ok(out);
}

/// The plan of a table's compaction, under the store; null when there is nothing to do (disabled, no snapshot, no
/// bin of two files) or the table cannot be read (its job's status then says why).
/// A candidate whose footer is still to be read, off the store's lock (ADR-0106 §3, the M16 exit review's B6): its
/// tail pinned under it, read after.
struct PendingInput {
    path: Vector<u8>;
    key: Vector<u8>;
    size: u64;
    generation: u64;
    manifest: usize;
    entry: usize;
    sequence: i64;
    partitionKey: Vector<u8>;
    /// Its last 8 bytes, pinned under the lock; then its footer's, once their length is known (0: not joined).
    tail: PreparedReader;
    footerLength: u64;
    footer: PreparedReader?;
}

/// A plan made under the store's lock, its candidates' footers not yet read.
struct CompactionDraft {
    plan: CompactionPlan;
    pending: Vector<PendingInput>;
    target: u64;
}

fn planCompaction(
    store: borrow mut ObjectStore,
    t: borrow MaintainedTable,
    nowMs: i64,
) -> Result<CompactionDraft?, TablesError> {
    let hidden = tableWarehouseBucket(t.bucket.view())?;
    let rec = match (tableRecord(store, t.bucket.view(), t.ns.view(), t.name.view())) {
        Ok(r) => r,
        Err(TablesError.NotFound) => { return Ok(null); }
        Err(e) => { return Err(e); }
    };
    let id = copyBytes(jsonMemberText(borrow rec.json, "id") ?? "".bytes())?;
    let target = match (compactionTarget(store, hidden.view(), id.view(), nowMs)?) {
        Some(b) => b,
        null => { return Ok(null); }
    };
    let location = copyBytes(jsonMemberText(borrow rec.json, "metadataLocation") ?? "".bytes())?;
    if (location.length == 0) { return Ok(null); }
    let m = match (readMetadata(store, hidden.view(), location.view())) {
        Ok(m) => m,
        Err(TablesError.OutOfMemory(e)) => { return Err(TablesError.OutOfMemory(e)); }
        Err(_) => {
            writeJobStatus(
                store,
                hidden.view(),
                id.view(),
                COMPACTION,
                "Failed",
                "The table's metadata could not be read.",
                nowMs,
            )?;
            return Ok(null);
        }
    };
    let snapshot = jsonMemberI64(borrow m, "current-snapshot-id") ?? -1;
    if (snapshot < 0) { return Ok(null); }
    let listPath = match (snapshotListPath(borrow m, snapshot)) {
        Some(p) => copyBytes(p)?,
        null => { return Ok(null); } // a v1 snapshot of inline manifests: not compacted here
    };
    let failed = "The table's manifests could not be read; nothing was compacted.";
    let list = match (readWarehouseAvro(store, hidden.view(), listPath.view())?) {
        Some(f) => f,
        null => {
            writeJobStatus(store, hidden.view(), id.view(), COMPACTION, "Failed", failed, nowMs)?;
            return Ok(null);
        }
    };
    var manifests = Vector<AvroFile>.create();
    for (i in 0..list.records.length) {
        let path = jsonMemberText(borrow list.records[i], "manifest_path") ?? "".bytes();
        match (readWarehouseAvro(store, hidden.view(), path)?) {
            Some(f) => { manifests.push(f)?; }
            null => {
                writeJobStatus(store, hidden.view(), id.view(), COMPACTION, "Failed", failed, nowMs)?;
                return Ok(null);
            }
        }
    }
    // The live delete files (ADR-0114 §3). A partition whose deletes are all read here is compacted with them applied;
    // one with any other (not Parquet, not here, too large, an equality delete without its ids) stays as it is
    // (ADR-0098 §2), and so does every partition while deletes are not applied (`COMPACTION_APPLIES_DELETES`).
    var blocked = Vector<Vector<u8>>.create();
    var deletes = Vector<DeleteFile>.create();
    var deleteSpecs = Vector<i64>.create();
    for (i in 0..list.records.length) {
        if (recordInt(borrow list.records[i], "content", 0) != 1) { continue; }
        let spec = recordInt(borrow list.records[i], "partition_spec_id", 0);
        let manifestSequence = recordInt(borrow list.records[i], "sequence_number", 0);
        for (e in 0..manifests[i].records.length) {
            let entry = borrow manifests[i].records[e];
            if (recordInt(entry, "status", 0) == 2) { continue; }
            let file = jsonMember(entry, "data_file");
            let k = match (file) {
                Some(d) => partitionKeyOf(spec, jsonMember(d, "partition"))?,
                null => partitionKeyOf(spec, null)?,
            };
            if (!holdsId(deleteSpecs.view(), spec)) { deleteSpecs.push(spec)?; }
            let read = match (file) {
                Some(d) => if (COMPACTION_APPLIES_DELETES) deleteFileOf(store, hidden.view(), d, k.view())? else null,
                null => null,
            };
            match (read) {
                Some(found) => {
                    var one = found;
                    one.manifest = i;
                    one.entry = e;
                    one.sequence = match (jsonMember(entry, "sequence_number")) {
                        Some(v) => jsonI64(v) ?? manifestSequence,
                        null => manifestSequence,
                    };
                    deletes.push(one)?;
                }
                null => { blocked.push(k)?; }
            }
        }
    }
    // The candidates, by group, in path order: their footers read after, off the lock.
    var pending = Vector<PendingInput>.create();
    let small = target * COMPACTION_SMALL_PERCENT / 100;
    for (i in 0..list.records.length) {
        let manifestRecord = borrow list.records[i];
        if (recordInt(manifestRecord, "content", 0) != 0) { continue; }
        let spec = recordInt(manifestRecord, "partition_spec_id", 0);
        // A delete file of another spec may apply to any of this spec's partitions.
        var otherSpec = false;
        for (s in 0..deleteSpecs.length) {
            if (deleteSpecs[s] != spec) { otherSpec = true; }
        }
        if (otherSpec) { continue; }
        let manifestSequence = recordInt(manifestRecord, "sequence_number", 0);
        for (e in 0..manifests[i].records.length) {
            if (pending.length >= COMPACTION_MAX_CANDIDATES) { break; }
            let entry = borrow manifests[i].records[e];
            if (recordInt(entry, "status", 0) == 2) { continue; }
            let file = jsonMember(entry, "data_file") ?? { continue; };
            if (recordInt(file, "content", 0) != 0) { continue; }
            let format = jsonMemberText(file, "file_format") ?? "".bytes();
            if (!equalsIgnoreCase(format, "PARQUET".bytes())) { continue; }
            let size = recordInt(file, "file_size_in_bytes", -1);
            if (size <= 0 || truncate<u64>(size) >= small) { continue; }
            let path = jsonMemberText(file, "file_path") ?? { continue; };
            match (refPlace(path, hidden.view())) {
                RefPlace.Here => {}
                _ => { continue; }
            }
            let partitionKey = partitionKeyOf(spec, jsonMember(file, "partition"))?;
            var inBlocked = false;
            for (d in 0..blocked.length) {
                if (blocked[d].view() == partitionKey.view()) { inBlocked = true; }
            }
            if (inBlocked) { continue; }
            let key = refKey(path);
            // Its tail pinned, to be read off the lock (ADR-0106 §3): the version as it is now, its generation with it.
            let bucket = catalogText(hidden.view());
            let name = catalogText(key);
            let info = match (store.headObject(bucket, name)) {
                Ok(h) => h,
                Err(_) => { continue; }
            };
            let fileSize = truncate<u64>(size);
            if (info.size != fileSize || fileSize < 12 ||
                metadataFind(info.metadata.view(), SSE_FIELD.bytes()).isSome()) {
                continue;
            }
            // Its last 8 bytes only (the M20 exit review): the footer's length, then the footer, as before.
            let tail = match (store.prepareReaderOf(bucket, name, null, fileSize - 8, fileSize)) {
                Ok(r) => r,
                Err(_) => { continue; }
            };
            let sequence = match (jsonMember(entry, "sequence_number")) {
                Some(v) => jsonI64(v) ?? manifestSequence,
                null => manifestSequence,
            };
            pending.push(PendingInput {
                path: copyBytes(path)?,
                key: copyBytes(key)?,
                size: fileSize,
                generation: info.generation,
                manifest: i,
                entry: e,
                sequence: sequence,
                partitionKey: partitionKey,
                tail: tail,
                footerLength: 0,
                footer: null,
            })?;
        }
    }
    let rowGroupBytes = rowGroupBytesOf(borrow m);
    let pageCodec = pageCodecOf(borrow m);
    let pageLevel = codecLevelOf(borrow m, "write.parquet.compression-level");
    let avroCodec = avroCodecOf(borrow m);
    let plan = CompactionPlan {
        bucket: copyBytes(t.bucket.view())?,
        hidden: hidden,
        id: id,
        ns: copyBytes(t.ns.view())?,
        name: copyBytes(t.name.view())?,
        location: location,
        previousStamp: jsonMemberI64(borrow m, "last-updated-ms") ?? 0,
        formatVersion: jsonMemberI64(borrow m, "format-version") ?? 1,
        metadata: m,
        snapshot: snapshot,
        list: list,
        manifests: manifests,
        bins: Vector<CompactionBin>.create(),
        rowGroupBytes: rowGroupBytes,
        deletes: deletes,
        pageCodec: pageCodec,
        pageLevel: pageLevel,
        avroCodec: avroCodec,
    };
    return Ok(Some(CompactionDraft { plan: plan, pending: pending, target: target }));
}

/// A draft's footers read and its plan's bins made, off the store's lock (ADR-0106 §3), once `pinFooters` has pinned
/// them: no bins when there is nothing to join. The readers' pins keep the bytes each candidate had when planned.
fn finishPlan(d: borrow mut CompactionDraft) -> Result<void, TablesError> {
    var inputs = Vector<CompactionInput>.create();
    for (i in 0..d.pending.length) {
        let c = borrow mut d.pending[i];
        if (c.footerLength == 0) { continue; }
        let bytes = match (c.footer.asBorrowMut()) {
            Some(r) => readPrepared(r)?,
            null => null,
        };
        let footerBytes = bytes ?? { continue; };
        if (footerBytes.length as u64 != c.footerLength) { continue; }
        let footer = match (parseParquetFooter(footerBytes.view(), c.size)?) {
            Some(f) => f,
            null => { continue; }
        };
        c.footer = null; // its pin let go
        // Files whose pages all read are grouped by their columns (ADR-0112 §2: by field id, whatever their writer);
        // others by their shape, to be joined as before.
        var group = copyBytes(c.partitionKey.view())?;
        group.push(0)?;
        let mergeable = if (pagesReadable(borrow footer.meta)?) schemaLeaves(borrow footer.meta)? else null;
        match (mergeable) {
            Some(leaves) => {
                group.push('M')?;
                group.extend(mergeKeyOf(leaves.view())?.view())?;
            }
            null => {
                group.push('J')?;
                group.extend(footer.shape.view())?;
            }
        }
        inputs.push(CompactionInput {
            path: copyBytes(c.path.view())?,
            key: copyBytes(c.key.view())?,
            size: c.size,
            generation: c.generation,
            footer: footer,
            manifest: c.manifest,
            entry: c.entry,
            sequence: c.sequence,
            partitionKey: copyBytes(c.partitionKey.view())?,
            group: group,
        })?;
    }
    d.plan.bins = binsOf(inputs, d.target, d.plan.deletes.view())?;
    return Ok();
}

/// Each candidate's last 8 bytes read, off the lock: its footer's length (0 when it is not a Parquet file's).
fn readFooterLengths(d: borrow mut CompactionDraft) -> Result<void, AllocError> {
    for (i in 0..d.pending.length) {
        let c = borrow mut d.pending[i];
        let tail = readPrepared(mut c.tail)? ?? { continue; };
        if (tail.length != 8) { continue; }
        c.footerLength = parquetFooterLength(tail.view(), c.size) ?? 0;
    }
    return Ok();
}

/// Each candidate's footer pinned, under the lock, if its version is still the one planned.
fn pinFooters(store: borrow mut ObjectStore, d: borrow mut CompactionDraft) {
    let hidden = copyBytes(d.plan.hidden.view()).ok() ?? { return; };
    for (i in 0..d.pending.length) {
        let c = borrow mut d.pending[i];
        if (c.footerLength == 0 || c.footerLength + 8 > c.size) {
            c.footerLength = 0;
            continue;
        }
        let bucket = catalogText(hidden.view());
        let name = catalogText(c.key.view());
        let same = match (store.headObject(bucket, name)) {
            Ok(h) => h.generation == c.generation,
            Err(_) => false,
        };
        if (!same) {
            c.footerLength = 0;
            continue;
        }
        c.footer = store.prepareReaderOf(bucket, name, null, c.size - 8 - c.footerLength, c.size - 8).ok();
        if (c.footer.isNull()) { c.footerLength = 0; }
    }
}

/// A pinned reader's bytes, whole; null when they cannot be read.
fn readPrepared(prepared: borrow mut PreparedReader) -> Result<Vector<u8>?, AllocError> {
    var reader = match (prepared.open()) {
        Ok(r) => r,
        Err(_) => { return Ok(null); }
    };
    var out = Vector<u8>.create();
    var buf = Vector<u8>.create();
    buf.resize(65536, 0)?;
    while (true) {
        let n = match (reader.read(buf.viewMut())) {
            Ok(n) => n,
            Err(_) => { return Ok(null); }
        };
        if (n == 0) { break; }
        out.extend(buf.view()[0..n])?;
    }
    return Ok(Some(out));
}

/// The manifest list of snapshot `id`, if the metadata has the snapshot and it names one.
fn snapshotListPath(m: borrow Json, id: i64) -> Slice<u8>? {
    let snaps = memberItems(m, "snapshots") ?? { return null; };
    for (i in 0..snaps.length) {
        if (jsonMemberI64(borrow snaps[i], "snapshot-id") == Some(id)) {
            return jsonMemberText(borrow snaps[i], "manifest-list");
        }
    }
    return null;
}

/// An Avro file of the table's bucket by its path; null when it is elsewhere, missing or not Avro.
fn readWarehouseAvro(store: borrow ObjectStore, hidden: Slice<u8>, path: Slice<u8>) -> Result<AvroFile?, TablesError> {
    match (refPlace(path, hidden)) {
        RefPlace.Here => {}
        _ => { return Ok(null); }
    }
    let bytes = match (warehouseObject(store, hidden, refKey(path))?) {
        Some(b) => b,
        null => { return Ok(null); }
    };
    return match (readAvro(bytes.view())) {
        Ok(f) => Ok(Some(f)),
        Err(AvroError.OutOfMemory(e)) => Err(TablesError.OutOfMemory(e)),
        Err(_) => Ok(null),
    };
}

/// The table's row group size, `write.parquet.row-group-size-bytes`, or Iceberg's default; 1 MB at least, and 256 MB
/// at most (the M23 exit review: a merge holds a row group's decoded values, so the table may not set it without end).
fn rowGroupBytesOf(m: borrow Json) -> u64 {
    let props = jsonMember(m, "properties") ?? { return COMPACTION_ROW_GROUP_BYTES; };
    let text = jsonMemberText(props, "write.parquet.row-group-size-bytes") ?? { return COMPACTION_ROW_GROUP_BYTES; };
    let n = parseDecimal(text) ?? { return COMPACTION_ROW_GROUP_BYTES; };
    return if (n < 1048576) 1048576 else if (n > COMPACTION_MAX_ROW_GROUP_BYTES) COMPACTION_MAX_ROW_GROUP_BYTES else n;
}

/// A file's partition key: its spec, and its partition's values in their order, without their names (the M24 exit
/// review's S1: writers that name a partition field otherwise, as Avro's names are made, still match).
fn partitionKeyOf(spec: i64, partition: borrow Json?) -> Result<Vector<u8>, AllocError> {
    var k = Vector<u8>.create();
    appendDecimal(mut k, truncate<u64>(spec))?;
    k.push(' ')?;
    match (partition) {
        Some(p) => {
            match (p) {
                Json.Object(members) => {
                    k.push('[')?;
                    for (m in 0..members.length) {
                        if (m > 0) { k.push(',')?; }
                        k.extend(jsonTextOf(borrow members[m].value)?.view())?;
                    }
                    k.push(']')?;
                }
                _ => { k.extend(jsonTextOf(p)?.view())?; }
            }
        }
        null => {}
    }
    return Ok(k);
}

/// A live delete file's entry, when it is one read here (ADR-0114 §3): position or equality, Parquet, in the table's
/// warehouse, at its size and not sealed, at most DELETE_FILE_MAX_BYTES, an equality delete with its field ids.
fn deleteFileOf(
    store: borrow ObjectStore,
    hidden: Slice<u8>,
    d: borrow Json,
    partitionKey: Slice<u8>,
) -> Result<DeleteFile?, AllocError> {
    let content = recordInt(d, "content", 0);
    if (content != DELETE_CONTENT_POSITION && content != DELETE_CONTENT_EQUALITY) { return Ok(null); }
    if (!equalsIgnoreCase(jsonMemberText(d, "file_format") ?? "".bytes(), "PARQUET".bytes())) { return Ok(null); }
    let size = recordInt(d, "file_size_in_bytes", -1);
    if (size <= 0 || truncate<u64>(size) > DELETE_FILE_MAX_BYTES) { return Ok(null); }
    // Its rows as its manifest states them, within DELETE_FILE_MAX_ROWS (its decoding checks them again).
    let rows = recordInt(d, "record_count", -1);
    if (rows < 0 || truncate<u64>(rows) > DELETE_FILE_MAX_ROWS as u64) { return Ok(null); }
    let path = jsonMemberText(d, "file_path") ?? { return Ok(null); };
    match (refPlace(path, hidden)) {
        RefPlace.Here => {}
        _ => { return Ok(null); }
    }
    let key = refKey(path);
    let info = match (store.headObject(catalogText(hidden), catalogText(key))) {
        Ok(h) => h,
        Err(_) => { return Ok(null); }
    };
    if (info.size != truncate<u64>(size) || metadataFind(info.metadata.view(), SSE_FIELD.bytes()).isSome()) {
        return Ok(null);
    }
    var ids = Vector<i64>.create();
    match (memberItems(d, "equality_ids")) {
        Some(items) => {
            for (k in 0..items.length) { ids.push(jsonI64(borrow items[k]) ?? { return Ok(null); })?; }
        }
        null => {}
    }
    if (content == DELETE_CONTENT_EQUALITY && ids.length == 0) { return Ok(null); }
    return Ok(Some(DeleteFile {
        path: copyBytes(path)?,
        key: copyBytes(key)?,
        size: truncate<u64>(size),
        generation: info.generation,
        content: content,
        sequence: 0,
        equalityIds: ids,
        partitionKey: copyBytes(partitionKey)?,
        manifest: 0,
        entry: 0,
    }));
}

/// A table property's text, in lower case; null when it is not set.
fn propertyLower(m: borrow Json, name: StringView) -> Result<Vector<u8>?, AllocError> {
    let props = jsonMember(m, "properties") ?? { return Ok(null); };
    let text = jsonMemberText(props, name) ?? { return Ok(null); };
    var out = Vector<u8>.create();
    for (b in text) { out.push(if (b >= 'A' && b <= 'Z') b + 32 else b)?; }
    return Ok(Some(out));
}

/// The codec a merged file's pages are written in (ADR-0116 §1): the table's `write.parquet.compression-codec`, ZSTD
/// when it sets none (Iceberg's default since 1.4, the owner's choice); SNAPPY for a codec not written here.
fn pageCodecOf(m: borrow Json) -> i64 {
    let zstd = if (COMPACTION_WRITES_ZSTD) PQ_CODEC_ZSTD else COMPACTION_PAGE_CODEC;
    let name = match (propertyLower(m, "write.parquet.compression-codec")) {
        Ok(Some(n)) => n,
        Ok(null) => { return zstd; }
        Err(_) => { return COMPACTION_PAGE_CODEC; }
    };
    let n = name.view();
    if (n == "zstd".bytes()) { return zstd; }
    if (n == "snappy".bytes()) { return PQ_CODEC_SNAPPY; }
    if (n == "gzip".bytes()) { return PQ_CODEC_GZIP; }
    if (n == "uncompressed".bytes() || n == "none".bytes()) { return PQ_CODEC_UNCOMPRESSED; }
    return COMPACTION_PAGE_CODEC;
}

/// A codec's level from the table's property `name`: 1 to 9 (above 9 as 9), 0 for the codec's own default (ZSTD's
/// 3, gzip's 6) when it sets none.
fn codecLevelOf(m: borrow Json, name: StringView) -> u32 {
    let props = jsonMember(m, "properties") ?? { return 0; };
    let text = jsonMemberText(props, name) ?? { return 0; };
    let n = parseDecimal(text) ?? { return 0; };
    return if (n > 9) 9 else truncate<u32>(n);
}

/// The codec the run's manifests are written in (ADR-0116 §3): the table's `write.avro.compression-codec`, `gzip`
/// (Avro's deflate) when it sets none, as Iceberg's writers do; deflate for one not written here.
fn avroCodecOf(m: borrow Json) -> AvroCodec {
    let level = codecLevelOf(m, "write.avro.compression-level");
    let deflate = AvroCodec { kind: AVRO_WRITE_DEFLATE, level: level };
    let name = match (propertyLower(m, "write.avro.compression-codec")) {
        Ok(Some(n)) => n,
        _ => { return deflate; }
    };
    let n = name.view();
    // Iceberg Java's names and Avro's own, which PyIceberg takes too (`null`, `deflate`, `zstandard`).
    if (n == "snappy".bytes()) { return AvroCodec { kind: AVRO_WRITE_SNAPPY, level: 0 }; }
    if (n == "zstd".bytes() || n == "zstandard".bytes()) {
        return AvroCodec { kind: AVRO_WRITE_ZSTANDARD, level: level };
    }
    if (n == "uncompressed".bytes() || n == "none".bytes() || n == "null".bytes()) {
        return AvroCodec { kind: AVRO_WRITE_NULL, level: 0 };
    }
    return deflate;
}

/// The bins of `inputs` (ADR-0098 §2): by group, in path order, each up to `target` bytes; a bin of one file is left.
fn binsOf(
    inputs: Vector<CompactionInput>,
    target: u64,
    deletes: Slice<DeleteFile>,
) -> Result<Vector<CompactionBin>, AllocError> {
    var rest = inputs;
    rest.sortBy(
        (a, b) => compareBytes(a.group.view(), b.group.view()) * 2 + compareBytes(a.path.view(), b.path.view()),
    );
    var bins = Vector<CompactionBin>.create();
    var current = Vector<CompactionInput>.create();
    var bytes: u64 = 0;
    while (rest.length > 0) {
        let next = rest.remove(0);
        let sameGroup = current.length == 0 || current[0].group.view() == next.group.view();
        if (!sameGroup || bytes + next.size > target) {
            closeBin(mut bins, current, deletes)?;
            current = Vector<CompactionInput>.create();
            bytes = 0;
        }
        bytes += next.size;
        current.push(next)?;
    }
    closeBin(mut bins, current, deletes)?;
    return Ok(bins);
}

/// A bin kept when it joins two files or more.
fn closeBin(
    bins: borrow mut Vector<CompactionBin>,
    inputs: Vector<CompactionInput>,
    deletes: Slice<DeleteFile>,
) -> Result<void, AllocError> {
    // The deletes that apply to its files: a file with deletes is worth rewriting alone (ADR-0114 §3).
    var applying = Vector<usize>.create();
    for (x in 0..deletes.length) {
        for (i in 0..inputs.length) {
            if (deleteApplies(borrow deletes[x], inputs[i].partitionKey.view(), inputs[i].sequence)) {
                applying.push(x)?;
                break;
            }
        }
    }
    if (inputs.length < 2 && applying.length == 0) { return Ok(); }
    if (inputs.length == 0) { return Ok(); }
    var footers = Vector<ParquetFooter>.create();
    for (i in 0..inputs.length) {
        footers.push(ParquetFooter {
            meta: cloneFields(borrow inputs[i].footer.meta)?,
            rows: inputs[i].footer.rows,
            shape: copyBytes(inputs[i].footer.shape.view())?,
            dataEnd: inputs[i].footer.dataEnd,
        })?;
    }
    var merge = true;
    for (i in 0..footers.length) {
        if (!(pagesReadable(borrow footers[i].meta)?)) { merge = false; }
    }
    // Deletes are applied only by merging: a bin that does not merge leaves its files and their deletes as they are.
    if (applying.length > 0 && !merge) { return Ok(); }
    match (joinParquet(footers.view())?) {
        Some(join) => { bins.push(CompactionBin { inputs: inputs, join: join, merge: merge, deletes: applying })?; }
        null => {
            // Files of other writers' shapes merge, but cannot be joined: their join is only their row count.
            if (!merge) { return Ok(); }
            var rows: i64 = 0;
            for (i in 0..footers.length) { rows = addChecked(rows, footers[i].rows) ?? { return Ok(); }; }
            let join = ParquetJoin {
                copies: Vector<ParquetCopy>.create(),
                tail: Vector<u8>.create(),
                rows: rows,
                length: 0,
            };
            bins.push(CompactionBin { inputs: inputs, join: join, merge: true, deletes: applying })?;
        }
    }
    return Ok();
}

// ---- A bin's file ----

/// A bin's inputs, each copy's range pinned under the store (no I/O), and the writer of its file.
struct BinCopy {
    readers: Vector<PreparedReader>;
    lengths: Vector<u64>;
    writer: ObjectWriter;
    /// Each reader a row group of an input, its values rewritten (ADR-0112), rather than a range copied.
    merge: bool;
    rowGroupBytes: u64;
    /// For a merge: each input's footer (the plan's), and which row group each reader is.
    footers: Vector<ParquetFooter>;
    pieces: Vector<MergePiece>;
    /// For a merge: how each of the first input's leaves keeps its metrics, and the metrics once written.
    metricsPlan: Vector<LeafMetricsPlan>;
    metrics: FileMetrics?;
    /// A merge's page codec and level: the table's (ADR-0116).
    pageCodec: i64;
    pageLevel: u32;
    /// For a merge with deletes (ADR-0114 §4): each applying delete file, whole, and how it applies; each input's path
    /// and data sequence number.
    deleteReaders: Vector<PreparedReader>;
    deleteSizes: Vector<u64>;
    binDeletes: Vector<BinDelete>;
    inputPaths: Vector<Vector<u8>>;
    inputSequences: Vector<i64>;
}

/// A delete file applied by a merge: its content, its data sequence number, and an equality delete's field ids with
/// their Iceberg types.
struct BinDelete {
    content: i64;
    sequence: i64;
    ids: Vector<i64>;
    kinds: Vector<Vector<u8>>;
}

/// A merge's reader: an input's row group, its chunks' span in the file from `start` (ADR-0114 §1: a merge reads a
/// row group at a time, never a whole file).
struct MergePiece {
    input: usize;
    group: usize;
    start: u64;
}

/// The bytes a row group's chunks span in their file; null when a chunk is not one this reads.
fn groupSpan(group: borrow Vector<ThriftField>, dataEnd: u64) -> ChunkRange? {
    let chunks = structItems(group, PQ_GROUP_COLUMNS) ?? { return null; };
    if (chunks.length == 0) { return null; }
    var least: u64 = dataEnd;
    var most: u64 = 0;
    for (k in 0..chunks.length) {
        let r = match (borrow chunks[k]) {
            ThriftValue.Struct(f) => chunkRange(f, dataEnd) ?? { return null; },
            _ => { return null; }
        };
        if (r.start < least) { least = r.start; }
        if (r.start + r.length > most) { most = r.start + r.length; }
    }
    if (most <= least) { return null; }
    return Some(ChunkRange { start: least, length: most - least });
}

/// A bin's readers and writer, under the store; null when an input changed since the plan (gone, or another size).
fn prepareBin(store: borrow mut ObjectStore, plan: borrow CompactionPlan, b: usize) -> Result<BinCopy?, StoreError> {
    let bin = borrow plan.bins[b];
    let bucket = catalogText(plan.hidden.view());
    for (i in 0..bin.inputs.length) {
        match (store.headObject(bucket, catalogText(bin.inputs[i].key.view()))) {
            Ok(info) => {
                // The same version as planned, still not sealed: its footer and ranges are the plan's.
                if (info.size != bin.inputs[i].size || info.generation != bin.inputs[i].generation ||
                    metadataFind(info.metadata.view(), SSE_FIELD.bytes()).isSome()) {
                    return Ok(null);
                }
            }
            Err(_) => { return Ok(null); }
        }
    }
    var readers = Vector<PreparedReader>.create();
    var lengths = Vector<u64>.create();
    if (bin.merge) {
        // Each input's row groups, a reader each: their pages are decoded one row group at a time (ADR-0114 §1).
        var footers = Vector<ParquetFooter>.create();
        var pieces = Vector<MergePiece>.create();
        for (i in 0..bin.inputs.length) {
            let footer = borrow bin.inputs[i].footer;
            let groups = structItems(borrow footer.meta, PQ_FILE_ROW_GROUPS) ?? { return Ok(null); };
            for (g in 0..groups.length) {
                let span = match (borrow groups[g]) {
                    ThriftValue.Struct(f) => groupSpan(f, footer.dataEnd) ?? { return Ok(null); },
                    _ => { return Ok(null); }
                };
                let key = catalogText(bin.inputs[i].key.view());
                match (store.prepareReaderOf(bucket, key, null, span.start, span.start + span.length)) {
                    Ok(p) => { readers.push(p)?; }
                    Err(_) => { return Ok(null); }
                }
                lengths.push(span.length)?;
                pieces.push(MergePiece { input: i, group: g, start: span.start })?;
            }
            footers.push(ParquetFooter {
                meta: cloneFields(borrow footer.meta)?,
                rows: footer.rows,
                shape: copyBytes(footer.shape.view())?,
                dataEnd: footer.dataEnd,
            })?;
        }
        // Its deletes, each whole and as planned (ADR-0114 §4): one changed since leaves the bin for the next run.
        var deleteReaders = Vector<PreparedReader>.create();
        var deleteSizes = Vector<u64>.create();
        var binDeletes = Vector<BinDelete>.create();
        for (x in 0..bin.deletes.length) {
            let d = borrow plan.deletes[bin.deletes[x]];
            match (store.headObject(bucket, catalogText(d.key.view()))) {
                Ok(info) => {
                    if (info.size != d.size || info.generation != d.generation) { return Ok(null); }
                }
                Err(_) => { return Ok(null); }
            }
            match (store.prepareReaderOf(bucket, catalogText(d.key.view()), null, 0, d.size)) {
                Ok(r) => { deleteReaders.push(r)?; }
                Err(_) => { return Ok(null); }
            }
            deleteSizes.push(d.size)?;
            var kinds = Vector<Vector<u8>>.create();
            for (k in 0..d.equalityIds.length) {
                let kind = fieldTypeOf(borrow plan.metadata, d.equalityIds[k]) ?? { return Ok(null); };
                kinds.push(copyBytes(kind)?)?;
            }
            var ids = Vector<i64>.create();
            ids.extend(d.equalityIds.view())?;
            binDeletes.push(BinDelete { content: d.content, sequence: d.sequence, ids: ids, kinds: kinds })?;
        }
        var inputPaths = Vector<Vector<u8>>.create();
        var inputSequences = Vector<i64>.create();
        for (i in 0..bin.inputs.length) {
            inputPaths.push(copyBytes(bin.inputs[i].path.view())?)?;
            inputSequences.push(bin.inputs[i].sequence)?;
        }
        return Ok(Some(BinCopy {
            deleteReaders: deleteReaders,
            deleteSizes: deleteSizes,
            binDeletes: binDeletes,
            inputPaths: inputPaths,
            inputSequences: inputSequences,
            readers: readers,
            lengths: lengths,
            writer: store.newWriter()?,
            merge: true,
            rowGroupBytes: plan.rowGroupBytes,
            metricsPlan: match (schemaLeaves(borrow bin.inputs[0].footer.meta)?) {
                Some(leaves) => metricsPlanOf(borrow plan.metadata, leaves.view())?,
                null => { return Ok(null); }
            },
            metrics: null,
            pageCodec: plan.pageCodec,
            pageLevel: plan.pageLevel,
            footers: footers,
            pieces: pieces,
        }));
    }
    for (c in 0..bin.join.copies.length) {
        let copy = borrow bin.join.copies[c];
        let key = catalogText(bin.inputs[copy.input].key.view());
        match (store.prepareReaderOf(bucket, key, null, copy.start, copy.start + copy.length)) {
            Ok(p) => { readers.push(p)?; }
            Err(_) => { return Ok(null); }
        }
        lengths.push(copy.length)?;
    }
    return Ok(Some(BinCopy {
        readers: readers,
        lengths: lengths,
        writer: store.newWriter()?,
        merge: false,
        rowGroupBytes: plan.rowGroupBytes,
        footers: Vector<ParquetFooter>.create(),
        pieces: Vector<MergePiece>.create(),
        metricsPlan: Vector<LeafMetricsPlan>.create(),
        metrics: null,
        pageCodec: plan.pageCodec,
        pageLevel: plan.pageLevel,
        deleteReaders: Vector<PreparedReader>.create(),
        deleteSizes: Vector<u64>.create(),
        binDeletes: Vector<BinDelete>.create(),
        inputPaths: Vector<Vector<u8>>.create(),
        inputSequences: Vector<i64>.create(),
    }));
}

/// A bin's file written, without the store's lock (the readers' pins keep the inputs): `PAR1`, every copy in order,
/// the footer. Null when an input reads short.
fn copyBin(c: borrow mut BinCopy, tail: Slice<u8>) -> Result<FinishedObject?, StoreError> {
    if (c.merge) { return mergeBin(c); }
    if (c.writer.write(PARQUET_MAGIC.bytes()).isErr()) { return Ok(null); }
    var buf = Vector<u8>.create();
    buf.resize(REPLICA_COPY_BYTES, 0)?;
    for (i in 0..c.readers.length) {
        var reader = c.readers[i].open()?;
        var copied: u64 = 0;
        while (true) {
            let n = reader.read(buf.viewMut())?;
            if (n == 0) { break; }
            copied += n as u64;
            if (c.writer.write(buf.view()[0..n]).isErr()) { return Ok(null); }
        }
        if (copied != c.lengths[i]) { return Ok(null); }
    }
    if (c.writer.write(tail).isErr()) { return Ok(null); }
    return match (c.writer.finish()) {
        Ok(o) => Ok(Some(o)),
        Err(_) => Ok(null),
    };
}

/// A bin's files merged (ADR-0112 §2), without the store's lock: each input read whole and its row groups decoded,
/// their values written as row groups of about `rowGroupBytes` (measured by the values' bytes), by the first input's
/// schema, each input's columns matched to its by key (field id); then the footer. Null when an input reads short,
/// does not decode, or has other columns than the first.
fn mergeBin(c: borrow mut BinCopy) -> Result<FinishedObject?, StoreError> {
    if (c.writer.write(PARQUET_MAGIC.bytes()).isErr()) { return Ok(null); }
    var written: u64 = 4;
    var firstMeta: Vector<ThriftField>? = null;
    var leaves = Vector<PageLeaf>.create();
    var columns = Vector<ColumnValues>.create();
    var held: u64 = 0;
    var rows: i64 = 0;
    var totalRows: i64 = 0;
    var groups = Vector<ThriftValue>.create();
    var stats = Vector<LeafStats>.create();
    var piece: usize = 0;
    // The bin's deletes, read first (ADR-0114 §4); one that does not read leaves the bin as it is.
    var positionSets = Vector<PositionDeletes>.create();
    var positionAt = Vector<usize>.create();
    var equalitySets = Vector<EqualityDeletes>.create();
    var equalityAt = Vector<usize>.create();
    for (x in 0..c.binDeletes.length) {
        let bytes = readPrepared(mut c.deleteReaders[x])? ?? { return Ok(null); };
        if (bytes.length as u64 != c.deleteSizes[x]) { return Ok(null); }
        let d = borrow c.binDeletes[x];
        if (d.content == DELETE_CONTENT_POSITION) {
            positionSets.push(readPositionDeletes(bytes.view())? ?? { return Ok(null); })?;
            positionAt.push(x)?;
        } else {
            equalitySets.push(readEqualityDeletes(bytes.view(), d.ids.view(), d.kinds.view())? ?? {
                return Ok(null);
            })?;
            equalityAt.push(x)?;
        }
    }
    // All of the bin's deletes together within DELETE_BIN_MAX_ROWS (the M24 exit review's H2).
    var deleteRows: usize = 0;
    for (q in 0..positionSets.length) { deleteRows += positionSets[q].rows; }
    for (q in 0..equalitySets.length) { deleteRows += equalitySets[q].rows; }
    if (deleteRows > DELETE_BIN_MAX_ROWS) { return Ok(null); }
    for (i in 0..c.footers.length) {
        let footer = borrow c.footers[i];
        let these = schemaLeaves(borrow footer.meta)? ?? { return Ok(null); };
        if (firstMeta.isNull()) {
            for (k in 0..these.length) {
                columns.push(emptyValues())?;
                stats.push(emptyStats())?;
                leaves.push(copyLeaf(borrow these[k])?)?;
            }
            firstMeta = Some(cloneFields(borrow footer.meta)?);
        }
        let order = leafOrder(leaves.view(), these.view())? ?? { return Ok(null); };
        let fileGroups = structItems(borrow footer.meta, PQ_FILE_ROW_GROUPS) ?? { return Ok(null); };
        // The rows its position deletes name (by Iceberg's rule, those at or above its sequence number), sorted, and
        // the equality deletes above it.
        var drops = Vector<i64>.create();
        var equalities = Vector<usize>.create();
        if (c.binDeletes.length > 0) {
            if (i >= c.inputPaths.length || i >= c.inputSequences.length) { return Ok(null); }
            let sequence = c.inputSequences[i];
            for (q in 0..positionSets.length) {
                if (sequence > c.binDeletes[positionAt[q]].sequence) { continue; }
                match (positionsOf(borrow positionSets[q], c.inputPaths[i].view())?) {
                    Some(ps) => { drops.extend(ps)?; }
                    null => {}
                }
            }
            drops.sortBy((a, b) => if (a < b) -1 else if (a > b) 1 else 0);
            for (q in 0..equalitySets.length) {
                if (sequence < c.binDeletes[equalityAt[q]].sequence) { equalities.push(q)?; }
            }
        }
        var fileRow: i64 = 0;
        var nextDrop: usize = 0;
        for (g in 0..fileGroups.length) {
            let group = match (borrow fileGroups[g]) {
                ThriftValue.Struct(f) => f,
                _ => { return Ok(null); }
            };
            let groupRows = thriftInt(group, PQ_GROUP_NUM_ROWS) ?? { return Ok(null); };
            let chunks = structItems(group, PQ_GROUP_COLUMNS) ?? { return Ok(null); };
            if (chunks.length != these.length) { return Ok(null); }
            // This row group's bytes alone (ADR-0114 §1).
            if (piece >= c.pieces.length || c.pieces[piece].input != i || c.pieces[piece].group != g) {
                return Ok(null);
            }
            let bytes = readPrepared(mut c.readers[piece])? ?? { return Ok(null); };
            if (bytes.length as u64 != c.lengths[piece]) { return Ok(null); }
            let base = checkedTruncate<usize>(c.pieces[piece].start) ?? { return Ok(null); };
            piece += 1;
            var groupValues = Vector<ColumnValues>.create();
            for (k in 0..chunks.length) {
                let chunk = match (borrow chunks[k]) {
                    ThriftValue.Struct(f) => f,
                    _ => { return Ok(null); }
                };
                let values = readColumnChunkIn(bytes.view(), base, chunk, borrow these[k])? ?? { return Ok(null); };
                // Its rows are the row group's (the M23 exit review: a footer's count is not trusted alone).
                if (rowsOf(borrow these[k], borrow values) != groupRows) { return Ok(null); }
                groupValues.push(values)?;
            }
            // The rows its deletes drop (ADR-0114 §4): positions in the file, and rows whose key an equality delete
            // holds.
            let count = checkedTruncate<usize>(groupRows) ?? { return Ok(null); };
            var keep = Vector<bool>.create();
            keep.resize(count, true)?;
            var dropped: usize = 0;
            while (nextDrop < drops.length && drops[nextDrop] < fileRow + groupRows) {
                match (checkedTruncate<usize>(drops[nextDrop] - fileRow)) {
                    Some(at) => {
                        if (keep[at]) {
                            keep[at] = false;
                            dropped += 1;
                        }
                    }
                    null => {} // before this file's first row: names none of its rows
                }
                nextDrop += 1;
            }
            for (q in 0..equalities.length) {
                let set = borrow equalitySets[equalities[q]];
                let d = borrow c.binDeletes[equalityAt[equalities[q]]];
                var eqLeaves = Vector<PageLeaf>.create();
                var eqColumns = Vector<ColumnValues>.create();
                for (f in 0..d.ids.length) {
                    match (leafOfId(these.view(), d.ids[f])) {
                        Some(k) => {
                            if (these[k].maxRep != 0) { return Ok(null); }
                            eqLeaves.push(PageLeaf {
                                path: Vector<u8>.create(),
                                names: Vector<u8>.create(),
                                key: Vector<u8>.create(),
                                fieldId: these[k].fieldId,
                                unit: these[k].unit,
                                order: these[k].order,
                                physical: these[k].physical,
                                typeLength: these[k].typeLength,
                                maxDef: these[k].maxDef,
                                maxRep: 0,
                            })?;
                            var copy = emptyValues();
                            if (!(appendValues(mut copy, borrow groupValues[k])?)) { return Ok(null); }
                            eqColumns.push(copy)?;
                        }
                        null => {
                            eqLeaves.push(nullLeaf()?)?;
                            eqColumns.push(nullColumn(count)?)?;
                        }
                    }
                }
                let keys = rowKeys(eqLeaves.view(), d.kinds.view(), eqColumns.view())? ?? { return Ok(null); };
                if (keys.length != count) { return Ok(null); }
                for (r in 0..count) {
                    if (keep[r] && set.keys.get(borrow keys[r]).isSome()) {
                        keep[r] = false;
                        dropped += 1;
                    }
                }
            }
            for (k in 0..groupValues.length) {
                if (dropped == 0) {
                    held += heldBytes(borrow groupValues[k]);
                    if (!(appendValues(mut columns[order[k]], borrow groupValues[k])?)) { return Ok(null); }
                } else {
                    let kept = keptRows(borrow these[k], borrow groupValues[k], keep.view())? ?? { return Ok(null); };
                    held += heldBytes(borrow kept);
                    if (!(appendValues(mut columns[order[k]], borrow kept)?)) { return Ok(null); }
                }
            }
            fileRow += groupRows;
            let kept = groupRows - truncate<i64>(dropped);
            rows += kept;
            totalRows += kept;
            var most: usize = 0;
            for (k in 0..columns.length) {
                if (columns[k].defs.length > most) { most = columns[k].defs.length; }
            }
            if (held >= c.rowGroupBytes || most >= COMPACTION_GROUP_LEVELS) {
                if (!(flushGroup(
                    mut c.writer,
                    mut written,
                    leaves.view(),
                    mut columns,
                    rows,
                    mut groups,
                    c.metricsPlan.view(),
                    mut stats,
                    c.pageCodec,
                    c.pageLevel,
                )?)) { return Ok(null); }
                held = 0;
                rows = 0;
            }
        }
    }
    if (rows > 0 && !(flushGroup(
        mut c.writer,
        mut written,
        leaves.view(),
        mut columns,
        rows,
        mut groups,
        c.metricsPlan.view(),
        mut stats,
        c.pageCodec,
        c.pageLevel,
    )?)) { return Ok(null); }
    let meta = firstMeta ?? { return Ok(null); };
    // Always: its rows are the commit's record count (ADR-0114 §4).
    c.metrics = Some(fileMetricsOf(leaves.view(), c.metricsPlan.view(), stats.view(), totalRows)?);
    let tail = parquetTail(borrow meta, groups, totalRows)? ?? { return Ok(null); };
    if (c.writer.write(tail.view()).isErr()) { return Ok(null); }
    return match (c.writer.finish()) {
        Ok(o) => Ok(Some(o)),
        Err(_) => Ok(null),
    };
}

/// Everything a column's values hold: values, both levels, a byte array's ends.
fn heldBytes(v: borrow ColumnValues) -> u64 =>
    v.data.length as u64 + v.defs.length as u64 + v.reps.length as u64 + v.ends.length as u64 * 4;

/// The rows a chunk's values hold: its levels that start a row (every level when the column does not repeat).
fn rowsOf(leaf: borrow PageLeaf, v: borrow ColumnValues) -> i64 {
    if (leaf.maxRep == 0) { return truncate<i64>(v.defs.length); }
    var n: i64 = 0;
    for (r in v.reps.view()) {
        if (r == 0) { n += 1; }
    }
    return n;
}

/// A written row group's `k`th chunk's compressed bytes (0 when not stated).
fn chunkCompressedSize(group: borrow ThriftValue, k: usize) -> i64 {
    let fields = match (group) {
        ThriftValue.Struct(f) => f,
        _ => { return 0; }
    };
    let chunks = structItems(fields, PQ_GROUP_COLUMNS) ?? { return 0; };
    if (k >= chunks.length) { return 0; }
    let chunk = match (borrow chunks[k]) {
        ThriftValue.Struct(f) => f,
        _ => { return 0; }
    };
    return match (thriftField(chunk, PQ_CHUNK_META)) {
        Some(v) => match (v) {
            ThriftValue.Struct(meta) => thriftInt(meta, PQ_META_TOTAL_COMPRESSED) ?? 0,
            _ => 0,
        },
        null => 0,
    };
}

/// Whether a written file is left out of the commit (ADR-0118 §5, the M24 exit review's B1): a merged file that holds
/// no rows, every row of its bin deleted. A joined file's rows are its inputs' stated counts, not its own, so it is
/// always added.
fn addsNoFile(output: borrow CompactionOutput) -> bool => match (output.metrics.asBorrow()) {
    Some(m) => m.rows == 0,
    null => false,
};

/// A written file's rows: a merged file's own (its deletes dropped, ADR-0114 §4), a joined file's its inputs'.
fn outputRows(output: borrow CompactionOutput, bin: borrow CompactionBin) -> i64 => match (output.metrics.asBorrow()) {
    Some(m) => m.rows,
    null => bin.join.rows,
};

/// A written file's data sequence number: the table's at the plan when its bin applied deletes (ADR-0114 §5), else
/// the largest of its inputs' (ADR-0098 §3).
fn outputSequence(bin: borrow CompactionBin, startSequence: i64) -> i64 {
    if (bin.deletes.length > 0) { return startSequence; }
    var most: i64 = 0;
    for (i in 0..bin.inputs.length) {
        if (bin.inputs[i].sequence > most) { most = bin.inputs[i].sequence; }
    }
    return most;
}

/// A spec's prefix of a partition key: its id and a space.
fn specPrefix(spec: i64) -> Result<Vector<u8>, AllocError> {
    var k = Vector<u8>.create();
    appendDecimal(mut k, truncate<u64>(spec))?;
    k.push(' ')?;
    return Ok(k);
}

/// Whether delete file `d` may still apply to a live data file after the commit: one of the current snapshot's
/// data files it keeps (not in `gone`), or one it adds, by Iceberg's rule (partition and sequence number).
fn deleteStillApplies(
    plan: borrow CompactionPlan,
    d: borrow DeleteFile,
    gone: Slice<Vector<usize>>,
    outputs: borrow Vector<CompactionOutput>,
    bins: Slice<usize>,
    startSequence: i64,
) -> Result<bool, AllocError> {
    // A file this commit adds has a new path, which no position delete names; an equality delete is checked by its
    // rule.
    for (o in 0..outputs.length) {
        if (d.content == DELETE_CONTENT_POSITION) { break; }
        let bin = borrow plan.bins[bins[o]];
        if (deleteApplies(
            d,
            bin.inputs[0].partitionKey.view(),
            outputSequence(bin, startSequence),
        )) { return Ok(true); }
    }
    for (i in 0..plan.list.records.length) {
        if (recordInt(borrow plan.list.records[i], "content", 0) != 0) { continue; }
        let spec = recordInt(borrow plan.list.records[i], "partition_spec_id", 0);
        let manifestSequence = recordInt(borrow plan.list.records[i], "sequence_number", 0);
        for (e in 0..plan.manifests[i].records.length) {
            let entry = borrow plan.manifests[i].records[e];
            if (recordInt(entry, "status", 0) == 2 || holdsIndex(gone[i].view(), e)) { continue; }
            let file = jsonMember(entry, "data_file") ?? { continue; };
            if (recordInt(file, "content", 0) != 0) { continue; }
            // A live data file of another spec: a delete written under an unpartitioned spec applies to every spec's
            // older files (Iceberg's global equality deletes, the M24 exit review's H1), so none is removed then.
            if (!d.partitionKey.view().startsWith(specPrefix(spec)?.view())) { return Ok(true); }
            let k = partitionKeyOf(spec, jsonMember(file, "partition"))?;
            let sequence = match (jsonMember(entry, "sequence_number")) {
                Some(v) => jsonI64(v) ?? manifestSequence,
                null => manifestSequence,
            };
            if (deleteApplies(d, k.view(), sequence)) { return Ok(true); }
        }
    }
    return Ok(false);
}

/// A data file record's metrics map `name` set to `items`, when its manifest's schema has it.
fn setMetric(file: borrow mut Json, name: StringView, items: Slice<Json>) -> Result<void, AllocError> {
    if (jsonMember(file, name).isNull()) { return Ok(); }
    var out = Vector<Json>.create();
    for (k in 0..items.length) { out.push(cloneJson(borrow items[k])?)?; }
    jsonSet(file, name, Json.Array(out))?;
    return Ok();
}

/// The values held written as a row group, and let go.
fn flushGroup(
    writer: borrow mut ObjectWriter,
    written: borrow mut u64,
    leaves: Slice<PageLeaf>,
    columns: borrow mut Vector<ColumnValues>,
    rows: i64,
    groups: borrow mut Vector<ThriftValue>,
    plans: Slice<LeafMetricsPlan>,
    stats: borrow mut Vector<LeafStats>,
    codec: i64,
    level: u32,
) -> Result<bool, AllocError> {
    let encoded = encodeRowGroupAt(*written, leaves, columns.view(), rows, codec, level)? ?? { return Ok(false); };
    if (writer.write(encoded.bytes.view()).isErr()) { return Ok(false); }
    *written += encoded.bytes.length as u64;
    // The file's metrics from the values written (ADR-0114 §2), each chunk's size its compressed bytes.
    if (plans.length == leaves.length && stats.length == leaves.length) {
        for (k in 0..leaves.length) {
            let size = chunkCompressedSize(borrow encoded.group, k);
            foldStats(mut stats[k], borrow plans[k], borrow leaves[k], borrow columns[k], size)?;
        }
    }
    groups.push(encoded.group)?;
    for (k in 0..columns.length) { columns[k] = emptyValues(); }
    return Ok(true);
}

/// A bin's file put beside its first input, as `compacted-<uuid>.parquet`; null when it could not be.
fn putBin(
    store: borrow mut ObjectStore,
    plan: borrow CompactionPlan,
    b: usize,
    obj: borrow FinishedObject,
) -> Result<CompactionOutput?, StoreError> {
    let first = borrow plan.bins[b].inputs[0];
    let slash = lastSlash(first.key.view());
    var key = copyBytes(first.key.view()[0..slash])?;
    key.extend("compacted-".bytes())?;
    if (!newUuid(mut key)?) { return Ok(null); }
    key.extend(".parquet".bytes())?;
    match (store.putFinishedWith(
        catalogText(plan.hidden.view()),
        catalogText(key.view()),
        "application/octet-stream",
        "".bytes(),
        "".bytes(),
        obj,
        PutCondition.IfAbsent,
    )) {
        Ok(_) => {}
        Err(_) => { return Ok(null); }
    }
    let pathSlash = lastSlash(first.path.view());
    var path = copyBytes(first.path.view()[0..pathSlash])?;
    path.extend(key.view()[slash..])?;
    return Ok(Some(CompactionOutput { key: key, path: path, length: obj.size, metrics: null }));
}

/// The length of a key's or path's directory, its last `/` included (0 when it has none).
fn lastSlash(s: Slice<u8>) -> usize {
    var at: usize = 0;
    for (i in 0..s.length) {
        if (s[i] == '/') { at = i + 1; }
    }
    return at;
}

// ---- The commit ----

/// The type of the table's current schema's field `id` (a primitive's name), if it has one.
fn fieldTypeOf<region a>(m: borrow(a) Json, id: i64) -> Slice<a, u8>? {
    let current = jsonMemberI64(m, "current-schema-id") ?? 0;
    match (memberItems(m, "schemas")) {
        Some(schemas) => {
            for (i in 0..schemas.length) {
                if ((jsonMemberI64(borrow schemas[i], "schema-id") ?? 0) == current) {
                    return typeIn(borrow schemas[i], id, 0);
                }
            }
        }
        null => {}
    }
    return match (jsonMember(m, "schema")) {
        Some(s) => typeIn(s, id, 0),
        null => null,
    };
}

/// Field `id`'s primitive type in a struct type, its nested structs, lists and maps included.
fn typeIn<region a>(t: borrow(a) Json, id: i64, depth: usize) -> Slice<a, u8>? {
    if (depth > 32) { return null; }
    match (memberItems(t, "fields")) {
        Some(fields) => {
            for (i in 0..fields.length) {
                let f = borrow fields[i];
                let ft = jsonMember(f, "type") ?? { continue; };
                if (jsonMemberI64(f, "id") == Some(id)) {
                    return match (ft) {
                        Json.Text(name) => Some(name.view()),
                        _ => null,
                    };
                }
                match (typeIn(ft, id, depth + 1)) {
                    Some(found) => { return Some(found); }
                    null => {}
                }
            }
        }
        null => {}
    }
    // A list's element, a map's key and value.
    for (pair in [["element-id", "element"], ["key-id", "key"], ["value-id", "value"]]) {
        match (jsonMember(t, pair[1])) {
            Some(inner) => {
                if (jsonMemberI64(t, pair[0]) == Some(id)) {
                    return match (inner) {
                        Json.Text(name) => Some(name.view()),
                        _ => null,
                    };
                }
                match (typeIn(inner, id, depth + 1)) {
                    Some(found) => { return Some(found); }
                    null => {}
                }
            }
            null => {}
        }
    }
    return null;
}

/// How two single-value bounds of a type compare (Iceberg's binary form); null for a type whose order is not known
/// here, whose bounds are then left out.
fn compareBound(kind: Slice<u8>, a: Slice<u8>, b: Slice<u8>) -> i32? {
    if (kind == "int".bytes() || kind == "date".bytes()) {
        if (a.length != 4 || b.length != 4) { return null; }
        let x = truncate<i32>(a.readLE<u32>(0)); // the cast keeps the sign
        let y = truncate<i32>(b.readLE<u32>(0));
        return Some(if (x < y) -1 else if (x > y) 1 else 0);
    }
    if (kind == "long".bytes() ||
        kind == "time".bytes() || kind == "timestamp".bytes() || kind == "timestamptz".bytes() ||
        kind == "timestamp_ns".bytes() || kind == "timestamptz_ns".bytes()) {
        if (a.length != 8 || b.length != 8) { return null; }
        let x = truncate<i64>(a.readLE<u64>(0));
        let y = truncate<i64>(b.readLE<u64>(0));
        return Some(if (x < y) -1 else if (x > y) 1 else 0);
    }
    if (kind == "string".bytes() || kind == "binary".bytes() || kind == "boolean".bytes()) {
        return Some(compareBytes(a, b));
    }
    return null;
}

/// A metrics map of the new file (`column_sizes` and the like, Avro's arrays of `{key, value}`): for each key every
/// input has, the sum of counts, or (`bound` -1 lower, 1 upper) the least or greatest bound. Null when an input has
/// none.
fn mergedMetrics(
    plan: borrow CompactionPlan,
    bin: borrow CompactionBin,
    name: StringView,
    bound: i32,
) -> Result<Json, AllocError> {
    var out = Vector<Json>.create();
    let firstFile = dataFileOf(plan, borrow bin.inputs[0]) ?? { return Ok(Json.Null); };
    let firstMap = memberItems(firstFile, name) ?? { return Ok(Json.Null); };
    for (k in 0..firstMap.length) {
        let key = jsonMemberI64(borrow firstMap[k], "key") ?? { continue; };
        let kind: Slice<u8>? = if (bound == 0) null else fieldTypeOf(borrow plan.metadata, key);
        if (bound != 0 && kind.isNull()) { continue; }
        var sum: i64 = 0;
        var chosen = Vector<u8>.create();
        var everyInput = true;
        for (i in 0..bin.inputs.length) {
            let file = dataFileOf(plan, borrow bin.inputs[i]) ?? { return Ok(Json.Null); };
            let items = memberItems(file, name) ?? { return Ok(Json.Null); };
            var found = false;
            for (j in 0..items.length) {
                if (jsonMemberI64(borrow items[j], "key") != Some(key)) { continue; }
                found = true;
                let v = jsonMember(borrow items[j], "value") ?? { continue; };
                if (bound == 0) {
                    match (addChecked(sum, jsonI64(v) ?? 0)) {
                        Some(n) => { sum = n; }
                        null => { everyInput = false; } // a count past i64: left out
                    }
                } else {
                    let b = match (v) {
                        Json.Text(t) => t.view(),
                        _ => { everyInput = false; continue; }
                    };
                    if (chosen.length == 0 && i == 0) {
                        chosen = copyBytes(b)?;
                    } else {
                        match (compareBound(kind ?? "".bytes(), b, chosen.view())) {
                            Some(c) => {
                                if (c * bound > 0) { chosen = copyBytes(b)?; }
                            }
                            null => { everyInput = false; }
                        }
                    }
                }
            }
            if (!found) { everyInput = false; }
        }
        if (!everyInput) { continue; }
        var pair = jsonObject();
        jsonSet(mut pair, "key", jsonInteger(key)?)?;
        jsonSet(mut pair, "value", if (bound == 0) jsonInteger(sum)? else Json.Text(chosen))?;
        out.push(pair)?;
    }
    return Ok(Json.Array(out));
}

/// An input's `data_file` record.
fn dataFileOf<region a>(plan: borrow(a) CompactionPlan, input: borrow CompactionInput) -> borrow(a) Json? =>
    jsonMember(borrow plan.manifests[input.manifest].records[input.entry], "data_file");

/// A positive snapshot id the metadata does not have.
fn newSnapshotId(m: borrow Json) -> i64? {
    for (attempt in 0..16) {
        var b = [0u8; 8];
        if (Random.fill(mut b[..]).isErr()) { return null; }
        let id = truncate<i64>(b[..].readLE<u64>(0) & 0x7FFFFFFFFFFFFFFF);
        if (id == 0) { continue; }
        if (snapshotListPath(m, id).isNull() && !snapshotKnown(m, id)) { return Some(id); }
    }
    return null;
}

fn snapshotKnown(m: borrow Json, id: i64) -> bool {
    let snaps = memberItems(m, "snapshots") ?? { return false; };
    for (i in 0..snaps.length) {
        if (jsonMemberI64(borrow snaps[i], "snapshot-id") == Some(id)) { return true; }
    }
    return false;
}

/// Sets a record's integer member, as named in the record (v1 and v2 name some counts apart: both are tried).
fn setCount(record: borrow mut Json, names: Slice<StringView>, value: i64) -> Result<void, AllocError> {
    for (n in names) {
        if (jsonMember(record, n).isSome()) { jsonSet(record, n, jsonInteger(value)?)?; }
    }
    return Ok();
}

/// An object written to the table's bucket, if absent; its path (`s3://<bucket>/<key>`, with `scheme`'s head).
fn putWarehouseFile(
    store: borrow mut ObjectStore,
    plan: borrow CompactionPlan,
    scheme: Slice<u8>,
    key: Slice<u8>,
    bytes: Slice<u8>,
    written: borrow mut Vector<Vector<u8>>,
) -> Result<Vector<u8>?, TablesError> {
    match (store.putObject(
        catalogText(plan.hidden.view()),
        catalogText(key),
        "application/octet-stream",
        bytes,
        PutCondition.IfAbsent,
    )) {
        Ok(_) => {}
        Err(e) => { return Err(tablesStoreFail(e)); }
    }
    written.push(copyBytes(key)?)?;
    var path = copyBytes(scheme)?;
    path.extend(plan.hidden.view())?;
    path.push('/')?;
    path.extend(key)?;
    return Ok(Some(path));
}

/// The run committed (ADR-0098 §3): one `replace` snapshot, its manifest list the current one's with the manifests
/// that held the inputs rewritten (the inputs DELETED, the rest EXISTING) and a manifest of the joined files ADDED.
/// False, with everything the run wrote deleted, when the table changed since the plan or a file does not fit its
/// manifest's schema.
fn commitCompaction(
    store: borrow mut ObjectStore,
    plan: borrow mut CompactionPlan,
    outputs: borrow Vector<CompactionOutput>,
    bins: Slice<usize>,
    nowMs: i64,
    leftover: borrow mut Vector<Vector<u8>>,
) -> Result<bool, TablesError> {
    var written = Vector<Vector<u8>>.create();
    for (i in 0..outputs.length) { written.push(copyBytes(outputs[i].key.view())?)?; }
    // Everything the run wrote is deleted unless the swap made it the table's, an error's path included (the M16
    // exit review).
    let outcome = commitWritten(store, plan, outputs, bins, nowMs, mut written);
    let done = match (outcome) {
        Ok(d) => d,
        Err(_) => false,
    };
    if (done) {
        // A bin whose rows were all deleted adds no file (ADR-0118 §5): its output, written before the commit, is
        // deleted, and handed back for a cluster's next gated step as an error's are.
        for (o in 0..outputs.length) {
            if (!addsNoFile(borrow outputs[o])) { continue; }
            let _ = store.deleteObject(catalogText(plan.hidden.view()), catalogText(outputs[o].key.view()));
            match (copyBytes(outputs[o].key.view())) {
                Ok(k) => { let _ = leftover.push(k); }
                Err(_) => {}
            }
        }
    }
    if (!done) {
        // Each deleted. On a cluster's leader a key written in this same step is not applied yet, so its delete does
        // nothing: it is handed back, for one more gated step to delete (the M22 exit review's finding 1).
        for (i in 0..written.length) {
            let _ = store.deleteObject(catalogText(plan.hidden.view()), catalogText(written[i].view()));
            match (copyBytes(written[i].view())) {
                Ok(k) => { let _ = leftover.push(k); }
                Err(_) => {}
            }
        }
    }
    return outcome;
}

fn commitWritten(
    store: borrow mut ObjectStore,
    plan: borrow mut CompactionPlan,
    outputs: borrow Vector<CompactionOutput>,
    bins: Slice<usize>,
    nowMs: i64,
    written: borrow mut Vector<Vector<u8>>,
) -> Result<bool, TablesError> {
    // The table as it is now: the run commits only on the metadata it planned from.
    var rec = match (tableRecord(store, plan.bucket.view(), plan.ns.view(), plan.name.view())) {
        Ok(r) => r,
        Err(TablesError.NotFound) => { return Ok(false); }
        Err(e) => { return Err(e); }
    };
    if (jsonMemberText(borrow rec.json, "metadataLocation") != Some(plan.location.view())) { return Ok(false); }
    let v2 = plan.formatVersion >= 2;
    let snapshot = newSnapshotId(borrow plan.metadata) ?? { return Ok(false); };
    let sequence = (jsonMemberI64(borrow plan.metadata, "last-sequence-number") ?? 0) + 1;
    let listPath = copyBytes(snapshotListPath(borrow plan.metadata, plan.snapshot) ?? { return Ok(false); })?;
    let scheme = copyBytes(listPath.view()[0..schemeLength(listPath.view())])?;
    let dir = copyBytes(refKey(listPath.view())[0..lastSlash(refKey(listPath.view()))])?;
    // Which entries each manifest loses.
    var gone = Vector<Vector<usize>>.create();
    for (i in 0..plan.manifests.length) { gone.push(Vector<usize>.create())?; }
    var addedRows: i64 = 0;
    var removedBytes: i64 = 0;
    var addedBytes: i64 = 0;
    var inputsCount: i64 = 0;
    var removedRows: i64 = 0;
    // The table's sequence number at the plan: a file whose bin applied deletes takes it (ADR-0114 §5), so that no
    // delete committed before applies to it.
    let startSequence = sequence - 1;
    var addedFiles: i64 = 0;
    for (o in 0..outputs.length) {
        let bin = borrow plan.bins[bins[o]];
        if (!addsNoFile(borrow outputs[o])) {
            addedFiles += 1;
            addedBytes += truncate<i64>(outputs[o].length);
            addedRows += outputRows(borrow outputs[o], bin);
        }
        for (i in 0..bin.inputs.length) {
            gone[bin.inputs[i].manifest].push(bin.inputs[i].entry)?;
            removedBytes += truncate<i64>(bin.inputs[i].size);
            let rows = match (dataFileOf(plan, borrow bin.inputs[i])) {
                Some(d) => recordInt(d, "record_count", 0),
                null => 0,
            };
            removedRows = addChecked(removedRows, rows) ?? { return Ok(false); };
            inputsCount += 1;
        }
    }
    // The delete files that apply to nothing live any more (ADR-0114 §5), removed: no data file left after this
    // commit, nor one it adds, that Iceberg's rule says each may apply to.
    var removedDeletes = Vector<usize>.create();
    for (x in 0..plan.deletes.length) {
        let d = borrow plan.deletes[x];
        // Only a delete a committed bin applied (the M24 exit review: not one whose partition merely matched no file).
        var applied = false;
        for (o in 0..outputs.length) {
            if (holdsIndex(plan.bins[bins[o]].deletes.view(), x)) { applied = true; }
        }
        if (!applied) { continue; }
        if (!deleteStillApplies(plan, d, gone.view(), outputs, bins, startSequence)?) {
            gone[d.manifest].push(d.entry)?;
            removedDeletes.push(x)?;
        }
    }
    // A manifest of the joined files per partition spec (the M16 exit review): each written by a manifest of that
    // spec's schema and metadata, an entry per file of the spec.
    var newList = Vector<Json>.create();
    var specs = Vector<i64>.create();
    for (o in 0..outputs.length) {
        if (addsNoFile(borrow outputs[o])) { continue; } // no file (ADR-0118 §5)
        let spec = recordInt(borrow plan.list.records[plan.bins[bins[o]].inputs[0].manifest], "partition_spec_id", 0);
        if (!holdsId(specs.view(), spec)) { specs.push(spec)?; }
    }
    for (sp in 0..specs.length) {
        var template: usize = 0;
        var entries = Vector<Json>.create();
        var leastSequence: i64 = sequence;
        var specRows: i64 = 0;
        var specFiles: i64 = 0;
        for (o in 0..outputs.length) {
            let bin = borrow plan.bins[bins[o]];
            if (recordInt(
                borrow plan.list.records[bin.inputs[0].manifest],
                "partition_spec_id",
                0,
            ) != specs[sp]) { continue; }
            if (addsNoFile(borrow outputs[o])) { continue; }
            if (specFiles == 0) { template = bin.inputs[0].manifest; }
            specFiles += 1;
            specRows = addChecked(specRows, outputRows(borrow outputs[o], bin)) ?? { return Ok(false); };
            let first = borrow bin.inputs[0];
            var entry = cloneJson(borrow plan.manifests[first.manifest].records[first.entry])?;
            var file = cloneJson(dataFileOf(plan, first) ?? { return Ok(false); })?;
            jsonSet(mut file, "file_path", Json.Text(copyBytes(outputs[o].path.view())?))?;
            jsonSet(mut file, "file_size_in_bytes", jsonInteger(truncate<i64>(outputs[o].length))?)?;
            jsonSet(mut file, "record_count", jsonInteger(outputRows(borrow outputs[o], bin))?)?;
            match (outputs[o].metrics.asBorrow()) {
                Some(m) => {
                    // A merged file's own metrics, from its rows (ADR-0114 §2).
                    setMetric(mut file, "column_sizes", m.sizes.view())?;
                    setMetric(mut file, "value_counts", m.valueCounts.view())?;
                    setMetric(mut file, "null_value_counts", m.nullCounts.view())?;
                    setMetric(mut file, "nan_value_counts", m.nanCounts.view())?;
                    setMetric(mut file, "lower_bounds", m.lower.view())?;
                    setMetric(mut file, "upper_bounds", m.upper.view())?;
                }
                null => {
                    for (name in ["column_sizes", "value_counts", "null_value_counts", "nan_value_counts"]) {
                        if (jsonMember(borrow file, name).isSome()) {
                            jsonSet(mut file, name, mergedMetrics(plan, bin, name, 0)?)?;
                        }
                    }
                    // A merged file's columns are encoded again: the inputs' sizes are not its (the M23 exit review). The
                    // counts and bounds are, as they describe the same values.
                    if (bin.merge && jsonMember(borrow file, "column_sizes").isSome()) {
                        jsonSet(mut file, "column_sizes", Json.Null)?;
                    }
                    if (jsonMember(borrow file, "lower_bounds").isSome()) {
                        jsonSet(mut file, "lower_bounds", mergedMetrics(plan, bin, "lower_bounds", -1)?)?;
                    }
                    if (jsonMember(borrow file, "upper_bounds").isSome()) {
                        jsonSet(mut file, "upper_bounds", mergedMetrics(plan, bin, "upper_bounds", 1)?)?;
                    }
                }
            }
            for (name in ["split_offsets", "key_metadata", "sort_order_id", "equality_ids", "distinct_counts"]) {
                if (jsonMember(borrow file, name).isSome()) { jsonSet(mut file, name, Json.Null)?; }
            }
            jsonSet(mut entry, "data_file", file)?;
            jsonSet(mut entry, "status", jsonInteger(1)?)?;
            jsonSet(mut entry, "snapshot_id", jsonInteger(snapshot)?)?;
            if (v2) {
                let most = outputSequence(bin, startSequence);
                if (most < leastSequence) { leastSequence = most; }
                jsonSet(mut entry, "sequence_number", jsonInteger(most)?)?;
                jsonSet(mut entry, "file_sequence_number", Json.Null)?;
            }
            entries.push(entry)?;
        }
        let addedManifest = match (writeAvroIn(
            plan.manifests[template].metadata.view(),
            entries.view(),
            AvroCodec { kind: plan.avroCodec.kind, level: plan.avroCodec.level },
        )?) {
            Some(b) => b,
            null => { return Ok(false); }
        };
        var addedKey = copyBytes(dir.view())?;
        if (!newUuid(mut addedKey)?) { return Ok(false); }
        addedKey.extend("-m-compaction.avro".bytes())?;
        let addedPath = putWarehouseFile(
            store,
            plan,
            scheme.view(),
            addedKey.view(),
            addedManifest.view(),
            written,
        )? ?? { return Ok(false); };
        var addedRecord = cloneJson(borrow plan.list.records[template])?;
        jsonSet(mut addedRecord, "manifest_path", Json.Text(addedPath))?;
        jsonSet(mut addedRecord, "manifest_length", jsonInteger(truncate<i64>(addedManifest.length))?)?;
        jsonSet(mut addedRecord, "added_snapshot_id", jsonInteger(snapshot)?)?;
        jsonSet(mut addedRecord, "partitions", Json.Null)?;
        setCount(mut addedRecord, ["added_files_count", "added_data_files_count"][..], specFiles)?;
        setCount(
            mut addedRecord,
            [
                "existing_files_count",
                "existing_data_files_count",
                "deleted_files_count",
                "deleted_data_files_count",
                "existing_rows_count",
                "deleted_rows_count",
            ][..],
            0,
        )?;
        setCount(mut addedRecord, ["added_rows_count"][..], specRows)?;
        if (v2) {
            jsonSet(mut addedRecord, "sequence_number", jsonInteger(sequence)?)?;
            jsonSet(mut addedRecord, "min_sequence_number", jsonInteger(leastSequence)?)?;
        }
        newList.push(addedRecord)?;
    }
    // The manifests that held inputs, rewritten; the others as they are.
    for (i in 0..plan.manifests.length) {
        if (gone[i].length == 0) {
            newList.push(cloneJson(borrow plan.list.records[i])?)?;
            continue;
        }
        let manifestSequence = recordInt(borrow plan.list.records[i], "sequence_number", 0);
        var kept = Vector<Json>.create();
        var existing: i64 = 0;
        var existingRows: i64 = 0;
        var deletedFiles: i64 = 0;
        var deletedRows: i64 = 0;
        var least: i64 = sequence;
        for (e in 0..plan.manifests[i].records.length) {
            let old = borrow plan.manifests[i].records[e];
            let status = recordInt(old, "status", 0);
            if (status == 2) { continue; } // deleted before: not carried
            var entry = cloneJson(old)?;
            let rows = match (jsonMember(old, "data_file")) {
                Some(d) => recordInt(d, "record_count", 0),
                null => 0,
            };
            if (v2) {
                // Inherited sequence numbers made explicit: the manifest they inherit from is no longer theirs.
                let data = match (jsonMember(old, "sequence_number")) {
                    Some(v) => jsonI64(v) ?? manifestSequence,
                    null => manifestSequence,
                };
                let fileSequence = match (jsonMember(old, "file_sequence_number")) {
                    Some(v) => jsonI64(v) ?? manifestSequence,
                    null => manifestSequence,
                };
                jsonSet(mut entry, "sequence_number", jsonInteger(data)?)?;
                jsonSet(mut entry, "file_sequence_number", jsonInteger(fileSequence)?)?;
                if (data < least) { least = data; }
            }
            if (holdsIndex(gone[i].view(), e)) {
                jsonSet(mut entry, "status", jsonInteger(2)?)?;
                jsonSet(mut entry, "snapshot_id", jsonInteger(snapshot)?)?;
                deletedFiles += 1;
                deletedRows = addChecked(deletedRows, rows) ?? { return Ok(false); };
            } else {
                jsonSet(mut entry, "status", jsonInteger(0)?)?;
                existing += 1;
                existingRows = addChecked(existingRows, rows) ?? { return Ok(false); };
            }
            kept.push(entry)?;
        }
        let bytes = match (writeAvroIn(
            plan.manifests[i].metadata.view(),
            kept.view(),
            AvroCodec { kind: plan.avroCodec.kind, level: plan.avroCodec.level },
        )?) {
            Some(b) => b,
            null => { return Ok(false); }
        };
        var key = copyBytes(dir.view())?;
        if (!newUuid(mut key)?) { return Ok(false); }
        key.extend("-m-rewritten.avro".bytes())?;
        let path = putWarehouseFile(
            store,
            plan,
            scheme.view(),
            key.view(),
            bytes.view(),
            written,
        )? ?? { return Ok(false); };
        var record = cloneJson(borrow plan.list.records[i])?;
        jsonSet(mut record, "manifest_path", Json.Text(path))?;
        jsonSet(mut record, "manifest_length", jsonInteger(truncate<i64>(bytes.length))?)?;
        jsonSet(mut record, "added_snapshot_id", jsonInteger(snapshot)?)?;
        setCount(mut record, ["added_files_count", "added_data_files_count", "added_rows_count"][..], 0)?;
        setCount(mut record, ["existing_files_count", "existing_data_files_count"][..], existing)?;
        setCount(mut record, ["existing_rows_count"][..], existingRows)?;
        setCount(mut record, ["deleted_files_count", "deleted_data_files_count"][..], deletedFiles)?;
        setCount(mut record, ["deleted_rows_count"][..], deletedRows)?;
        if (v2) {
            jsonSet(mut record, "sequence_number", jsonInteger(sequence)?)?;
            jsonSet(mut record, "min_sequence_number", jsonInteger(least)?)?;
        }
        newList.push(record)?;
    }
    // The manifest list, with the list's metadata naming the new snapshot.
    var listMeta = Vector<JsonMember>.create();
    for (i in 0..plan.list.metadata.length) {
        let k = plan.list.metadata[i].key.view();
        var value = cloneJson(borrow plan.list.metadata[i].value)?;
        var digits = Vector<u8>.create();
        if (k == "snapshot-id".bytes()) { appendDecimal(mut digits, truncate<u64>(snapshot))?; }
        if (k == "parent-snapshot-id".bytes()) { appendDecimal(mut digits, truncate<u64>(plan.snapshot))?; }
        if (k == "sequence-number".bytes()) { appendDecimal(mut digits, truncate<u64>(sequence))?; }
        if (digits.length > 0) { value = Json.Text(digits); }
        listMeta.push(JsonMember { key: copyBytes(k)?, value: value })?;
    }
    let listBytes = match (writeAvroIn(
        listMeta.view(),
        newList.view(),
        AvroCodec { kind: plan.avroCodec.kind, level: plan.avroCodec.level },
    )?) {
        Some(b) => b,
        null => { return Ok(false); }
    };
    var listKey = copyBytes(dir.view())?;
    listKey.extend("snap-".bytes())?;
    appendDecimal(mut listKey, truncate<u64>(snapshot))?;
    listKey.push('-')?;
    if (!newUuid(mut listKey)?) { return Ok(false); }
    listKey.extend(".avro".bytes())?;
    let newListPath = putWarehouseFile(
        store,
        plan,
        scheme.view(),
        listKey.view(),
        listBytes.view(),
        written,
    )? ?? { return Ok(false); };
    // The snapshot, and the metadata naming it.
    var summary = jsonObject();
    jsonSet(mut summary, "operation", jsonString("replace".bytes())?)?;
    summaryCount(mut summary, "added-data-files", addedFiles)?;
    summaryCount(mut summary, "deleted-data-files", inputsCount)?;
    summaryCount(mut summary, "added-records", addedRows)?;
    summaryCount(mut summary, "deleted-records", removedRows)?;
    // The delete files removed, and their deletes (ADR-0114 §5).
    var removedPositionFiles: i64 = 0;
    var removedEqualityFiles: i64 = 0;
    var removedPositions: i64 = 0;
    var removedEqualities: i64 = 0;
    for (r in 0..removedDeletes.length) {
        let d = borrow plan.deletes[removedDeletes[r]];
        let rows = match (jsonMember(borrow plan.manifests[d.manifest].records[d.entry], "data_file")) {
            Some(f) => recordInt(f, "record_count", 0),
            null => 0,
        };
        if (d.content == DELETE_CONTENT_POSITION) {
            removedPositionFiles += 1;
            removedPositions = addChecked(removedPositions, rows) ?? { return Ok(false); };
        } else {
            removedEqualityFiles += 1;
            removedEqualities = addChecked(removedEqualities, rows) ?? { return Ok(false); };
        }
    }
    if (removedDeletes.length > 0) {
        summaryCount(mut summary, "removed-delete-files", truncate<i64>(removedDeletes.length))?;
        summaryCount(mut summary, "removed-position-delete-files", removedPositionFiles)?;
        summaryCount(mut summary, "removed-equality-delete-files", removedEqualityFiles)?;
        summaryCount(mut summary, "removed-position-deletes", removedPositions)?;
        summaryCount(mut summary, "removed-equality-deletes", removedEqualities)?;
    }
    summaryCount(mut summary, "added-files-size", addedBytes)?;
    summaryCount(mut summary, "removed-files-size", removedBytes)?;
    let previous = previousSummary(borrow plan.metadata, plan.snapshot);
    // The totals less what the commit removed (rows its deletes dropped, the delete files it removed); a total that
    // would go below 0 (a writer's text, not trusted) is left out.
    let lessRecords = removedRows - addedRows;
    let lessDeleteFiles = truncate<i64>(removedDeletes.length);
    let totals = ["total-records", "total-delete-files", "total-position-deletes", "total-equality-deletes"];
    let less = [lessRecords, lessDeleteFiles, removedPositions, removedEqualities];
    for (t in 0..totals.length) {
        match (summaryValue(previous, totals[t])) {
            Some(v) => {
                if (v >= less[t]) { summaryCount(mut summary, totals[t], v - less[t])?; }
            }
            null => {}
        }
    }
    // A previous total that would overflow (a writer's text, not trusted) is left out (the M16 exit review).
    match (summaryValue(previous, "total-data-files")) {
        Some(v) => {
            match (addChecked(v, addedFiles - inputsCount)) {
                Some(t) => { summaryCount(mut summary, "total-data-files", t)?; }
                null => {}
            }
        }
        null => {}
    }
    match (summaryValue(previous, "total-files-size")) {
        Some(v) => {
            match (addChecked(v, addedBytes - removedBytes)) {
                Some(t) => { summaryCount(mut summary, "total-files-size", t)?; }
                null => {}
            }
        }
        null => {}
    }
    var snap = jsonObject();
    jsonSet(mut snap, "snapshot-id", jsonInteger(snapshot)?)?;
    jsonSet(mut snap, "parent-snapshot-id", jsonInteger(plan.snapshot)?)?;
    if (v2) { jsonSet(mut snap, "sequence-number", jsonInteger(sequence)?)?; }
    jsonSet(mut snap, "timestamp-ms", jsonInteger(nowMs)?)?;
    jsonSet(mut snap, "manifest-list", Json.Text(newListPath))?;
    jsonSet(mut snap, "summary", summary)?;
    match (previousSchemaId(borrow plan.metadata, plan.snapshot)) {
        Some(s) => { jsonSet(mut snap, "schema-id", jsonInteger(s)?)?; }
        null => {}
    }
    var m = cloneJson(borrow plan.metadata)?;
    appendTo(mut m, "snapshots", snap)?;
    jsonSet(mut m, "current-snapshot-id", jsonInteger(snapshot)?)?;
    if (v2) { jsonSet(mut m, "last-sequence-number", jsonInteger(sequence)?)?; }
    var log = jsonObject();
    jsonSet(mut log, "timestamp-ms", jsonInteger(nowMs)?)?;
    jsonSet(mut log, "snapshot-id", jsonInteger(snapshot)?)?;
    appendTo(mut m, "snapshot-log", log)?;
    var main = match (jsonMember(borrow m, "refs")) {
        Some(refs) => match (jsonMember(refs, "main")) {
            Some(r) => cloneJson(r)?,
            null => jsonObject(),
        },
        null => jsonObject(),
    };
    jsonSet(mut main, "snapshot-id", jsonInteger(snapshot)?)?;
    if (jsonMember(borrow main, "type").isNull()) { jsonSet(mut main, "type", jsonString("branch".bytes())?)?; }
    var refs = match (jsonMember(borrow m, "refs")) {
        Some(r) => cloneJson(r)?,
        null => jsonObject(),
    };
    jsonSet(mut refs, "main", main)?;
    jsonSet(mut m, "refs", refs)?;
    jsonSet(mut m, "last-updated-ms", jsonInteger(nowMs)?)?;
    let key = catalogKey(CATALOG_TABLES, plan.ns.view(), plan.name.view())?;
    return match (swapMetadata(
        store,
        plan.hidden.view(),
        plan.id.view(),
        key.view(),
        mut rec,
        plan.location.view(),
        mut m,
        plan.previousStamp,
    )?) {
        Some(_) => Ok(true),
        null => Ok(false), // another commit swapped first
    };
}

fn holdsIndex(list: Slice<usize>, i: usize) -> bool {
    for (x in list) {
        if (x == i) { return true; }
    }
    return false;
}

fn summaryCount(summary: borrow mut Json, name: StringView, value: i64) -> Result<void, AllocError> {
    var digits = Vector<u8>.create();
    if (value < 0) {
        digits.push('-')?;
        appendDecimal(mut digits, truncate<u64>(-(value + 1)) + 1)?; // i64's least too
    } else {
        appendDecimal(mut digits, truncate<u64>(value))?;
    }
    return jsonSet(summary, name, Json.Text(digits));
}

/// Snapshot `id`'s summary, if it has one.
fn previousSummary<region a>(m: borrow(a) Json, id: i64) -> borrow(a) Json? {
    let snaps = memberItems(m, "snapshots") ?? { return null; };
    for (i in 0..snaps.length) {
        if (jsonMemberI64(borrow snaps[i], "snapshot-id") == Some(id)) {
            return jsonMember(borrow snaps[i], "summary");
        }
    }
    return null;
}

fn previousSchemaId(m: borrow Json, id: i64) -> i64? {
    let snaps = memberItems(m, "snapshots") ?? { return null; };
    for (i in 0..snaps.length) {
        if (jsonMemberI64(borrow snaps[i], "snapshot-id") == Some(id)) {
            return jsonMemberI64(borrow snaps[i], "schema-id");
        }
    }
    return null;
}

/// A summary's count (summaries hold numbers as text).
fn summaryValue(summary: borrow Json?, name: StringView) -> i64? => match (summary) {
    Some(s) => match (jsonMemberText(s, name)) {
        Some(t) => (StringView.fromUtf8(t) ?? "").parseInt<i64>(),
        null => null,
    },
    null => null,
};

// ---- A run ----

/// A table's compaction (ADR-0098 §4): the plan under the store; then each bin's readers pinned under it, its bytes
/// copied without it, its file put under it; then the commit under it. The job's status says how it went.
async fn compactTable(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    t: borrow MaintainedTable,
    nowMs: i64,
) -> Result<void, NetError> {
    var draft = match (await lockedPlan(store, t, nowMs)?) {
        Some(d) => d,
        null => { return Ok(); }
    };
    // The footers off the lock (ADR-0106 §3): their lengths from each file's last 8 bytes; then, under the lock, the
    // footers pinned; then read, and the bins made.
    match (await Async.blocking(() => readFooterLengths(mut draft))) {
        Ok() => {}
        Err(_) => { return Ok(); } // out of memory: the next run
    }
    {
        var guard = match (await store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NetError.Closed); }
        };
        let st = guard.data();
        let dr = borrow mut draft;
        await Async.blocking(() => pinFooters(st, dr));
    }
    match (await Async.blocking(() => finishPlan(mut draft))) {
        Ok() => {}
        Err(_) => { return Ok(); } // out of memory: the next run
    }
    var plan = draft.plan;
    if (plan.bins.length == 0) {
        var guard = match (await store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NetError.Closed); }
        };
        let st = guard.data();
        let p = borrow plan;
        let _ = await Async.blocking(
            () => writeJobStatus(st, p.hidden.view(), p.id.view(), COMPACTION, "Successful", "", nowMs),
        );
        return Ok();
    }
    var outputs = Vector<CompactionOutput>.create();
    var joined = Vector<usize>.create();
    for (b in 0..plan.bins.length) {
        var written = match (await copiedBin(store, mut plan, b)?) {
            Some(w) => w,
            null => { continue; }
        };
        let p = borrow plan;
        var guard = match (await store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NetError.Closed); }
        };
        let st = guard.data();
        let obj = borrow written.obj;
        match (await Async.blocking(() => putBin(st, p, b, obj))) {
            Ok(Some(o)) => {
                var out = o;
                out.metrics = written.metrics;
                if (outputs.push(out).isErr() || joined.push(b).isErr()) { return Err(NetError.Closed); }
            }
            _ => {}
        }
    }
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NetError.Closed); }
    };
    let st = guard.data();
    let o = borrow outputs;
    let j = joined.view();
    var leftover = Vector<Vector<u8>>.create();
    let lo = borrow mut leftover;
    let _ = await Async.blocking(() => finishCompaction(st, mut plan, o, j, nowMs, lo));
    return Ok();
}

/// The keys a failed commit wrote, deleted (on a cluster, a gated step after the commit's, ADR-0110 §2).
fn deleteLeftovers(store: borrow mut ObjectStore, hidden: Slice<u8>, keys: Slice<Vector<u8>>) {
    for (i in 0..keys.length) { let _ = store.deleteObject(catalogText(hidden), catalogText(keys[i].view())); }
}

/// A bin's file written, off the lock: merged when its files' pages read, and joined as before when its merge fails
/// and its files can be joined (the M23 exit review: a file whose footer reads but whose pages do not would otherwise
/// keep its bin from compacting at every run). Null when an input changed, or neither way writes it.
async fn copiedBin(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    plan: borrow mut CompactionPlan,
    b: usize,
) -> Result<BinWritten?, NetError> {
    for (attempt in 0..2) {
        {
            let p = plan;
            var copy = match (await lockedPrepare(store, p, b)?) {
                Some(c) => c,
                null => { return Ok(null); } // an input changed: this bin waits for the next run
            };
            let tail = p.bins[b].join.tail.view();
            match (await Async.blocking(() => copyBin(mut copy, tail))) {
                Ok(Some(o)) => {
                    let metrics = copy.metrics;
                    return Ok(Some(BinWritten { obj: o, metrics: metrics }));
                }
                _ => {}
            }
        }
        // Joined as before only when no delete applies: a position delete names the inputs' paths.
        if (!plan.bins[b].merge || plan.bins[b].join.copies.length == 0 || plan.bins[b].deletes.length > 0) {
            return Ok(null);
        }
        plan.bins[b].merge = false;
    }
    return Ok(null);
}

/// A bin's readers and writer, under the store.
async fn lockedPrepare(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    plan: borrow CompactionPlan,
    b: usize,
) -> Result<BinCopy?, NetError> {
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NetError.Closed); }
    };
    let st = guard.data();
    return match (await Async.blocking(() => prepareBin(st, plan, b))) {
        Ok(c) => Ok(c),
        Err(_) => Ok(null),
    };
}

/// The plan's draft, under the store.
async fn lockedPlan(
    store: borrow Arc<AsyncMutex<ObjectStore>>,
    t: borrow MaintainedTable,
    nowMs: i64,
) -> Result<CompactionDraft?, NetError> {
    var guard = match (await store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NetError.Closed); }
    };
    let st = guard.data();
    return match (await Async.blocking(() => planCompaction(st, t, nowMs))) {
        Ok(p) => Ok(p),
        Err(_) => Ok(null),
    };
}

/// The commit, and the job's status: `Successful` once committed (or with nothing to commit), `Failed` when the table
/// changed meanwhile (the next run tries again) or the commit could not be made.
fn finishCompaction(
    store: borrow mut ObjectStore,
    plan: borrow mut CompactionPlan,
    outputs: borrow Vector<CompactionOutput>,
    bins: Slice<usize>,
    nowMs: i64,
    leftover: borrow mut Vector<Vector<u8>>,
) -> Result<void, TablesError> {
    if (outputs.length == 0) {
        return writeJobStatus(store, plan.hidden.view(), plan.id.view(), COMPACTION, "Successful", "", nowMs);
    }
    let hidden = copyBytes(plan.hidden.view())?;
    let id = copyBytes(plan.id.view())?;
    match (commitCompaction(store, plan, outputs, bins, nowMs, leftover)) {
        Ok(true) => { return writeJobStatus(store, hidden.view(), id.view(), COMPACTION, "Successful", "", nowMs); }
        Ok(false) => {
            return writeJobStatus(
                store,
                hidden.view(),
                id.view(),
                COMPACTION,
                "Failed",
                "The table changed while it was compacted; the next run tries again.",
                nowMs,
            );
        }
        Err(TablesError.OutOfMemory(e)) => { return Err(TablesError.OutOfMemory(e)); }
        Err(_) => {
            // What it wrote is deleted already (`commitCompaction`).
            return writeJobStatus(
                store,
                hidden.view(),
                id.view(),
                COMPACTION,
                "Failed",
                "The compaction could not be committed.",
                nowMs,
            );
        }
    }
}
