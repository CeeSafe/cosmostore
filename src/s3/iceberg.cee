// The Iceberg REST catalog of S3 Tables (ADR-0083 §5): `/iceberg/v1/…`, signed for `s3tables`, its `{prefix}` a
// table bucket's ARN. The catalog writes each version's table metadata file (format version 2) in the table's
// warehouse, checks a commit's requirements against the current one, applies its updates, and swaps the table's
// record to the new file by If-Match.
import web_core;
import web_http;
import web_server;

/// How many earlier metadata files a table's metadata-log keeps (Iceberg's `write.metadata.previous-versions-max`).
const ICEBERG_METADATA_LOG_MAX: usize = 100;

/// An Iceberg REST error: `{"error":{"message","type","code"}}`.
fn icebergError(code: u16, kind: StringView, message: StringView) -> Result<TablesAnswer, TablesError> {
    var e = jsonObject();
    jsonSet(mut e, "message", jsonString(message.bytes())?)?;
    jsonSet(mut e, "type", jsonString(kind.bytes())?)?;
    jsonSet(mut e, "code", jsonInteger(code as i64)?)?;
    var j = jsonObject();
    jsonSet(mut j, "error", e)?;
    var body = Vector<u8>.create();
    writeJson(mut body, borrow j)?;
    return Ok(tablesAnswer(code, body));
}

fn badRequest(message: StringView) -> Result<TablesAnswer, TablesError> =>
    icebergError(400, "BadRequestException", message);

fn noSuchNamespace() -> Result<TablesAnswer, TablesError> =>
    icebergError(404, "NoSuchNamespaceException", "The namespace does not exist.");

fn noSuchTable() -> Result<TablesAnswer, TablesError> =>
    icebergError(404, "NoSuchTableException", "The table does not exist.");

fn icebergUnsupported() -> Result<TablesAnswer, TablesError> =>
    icebergError(406, "UnsupportedOperationException", "This Iceberg REST call is not supported here.");

/// A table bucket's ARN, URL-encoded as a path's one segment (the `prefix` the config gives).
fn encodedSegment(text: Slice<u8>, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    let hex = "0123456789ABCDEF".bytes();
    for (c in text) {
        let plain = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' ||
            c == '_' || c == '.' || c == '~';
        if (plain) {
            out.push(c)?;
        } else {
            out.push('%')?;
            out.push(hex[(c >> 4) as usize])?;
            out.push(hex[(c & 15) as usize])?;
        }
    }
    return Ok();
}

/// The endpoints this catalog has, as `GET /v1/config` lists them.
const ICEBERG_ENDPOINTS: StringView =
    "GET /v1/{prefix}/namespaces,POST /v1/{prefix}/namespaces,GET /v1/{prefix}/namespaces/{namespace},HEAD /v1/{prefix}/namespaces/{namespace},DELETE /v1/{prefix}/namespaces/{namespace},GET /v1/{prefix}/namespaces/{namespace}/tables,POST /v1/{prefix}/namespaces/{namespace}/tables,GET /v1/{prefix}/namespaces/{namespace}/tables/{table},HEAD /v1/{prefix}/namespaces/{namespace}/tables/{table},POST /v1/{prefix}/namespaces/{namespace}/tables/{table},DELETE /v1/{prefix}/namespaces/{namespace}/tables/{table},POST /v1/{prefix}/tables/rename";

fn icebergConfig(
    store: borrow ObjectStore,
    req: borrow S3Request,
    caller: borrow TablesCaller,
) -> Result<TablesAnswer, TablesError> {
    let warehouse = paramOf(req, "warehouse") ?? "".bytes();
    var none = Vector<u8>.create();
    let name = match (tableBucketOfArn(warehouse, mut none)?) {
        Some(n) => n,
        null => { return badRequest("The warehouse must be a table bucket's ARN."); }
    };
    match (tableBucketRecord(store, name.view())) {
        Ok(_) => {}
        Err(TablesError.NotFound) => { return icebergError(404, "NoSuchWarehouseException", "No such table bucket."); }
        Err(e) => { return Err(e); }
    }
    checkTables(store, caller, "s3tables:GetTableBucket", name.view(), "".bytes())?;
    var prefix = Vector<u8>.create();
    encodedSegment(warehouse, mut prefix)?;
    var overrides = jsonObject();
    jsonSet(mut overrides, "prefix", Json.Text(prefix))?;
    var endpoints = jsonArray();
    for (e in ICEBERG_ENDPOINTS.split(",")) { jsonPush(mut endpoints, jsonString(e.bytes())?)?; }
    var j = jsonObject();
    jsonSet(mut j, "defaults", jsonObject())?;
    jsonSet(mut j, "overrides", overrides)?;
    jsonSet(mut j, "endpoints", endpoints)?;
    return tablesJson(borrow j);
}

// ---- Namespaces ----

fn namespaceJson(name: Slice<u8>) -> Result<Json, AllocError> => namespaceArray(name);

fn icebergListNamespaces(
    store: borrow ObjectStore,
    req: borrow S3Request,
    bucket: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(bucket)?;
    var list = jsonArray();
    // One level only: a parent has no children.
    if (paramOf(req, "parent").isNull()) {
        let keys = catalogKeys(store, hidden.view(), CATALOG_NAMESPACES.bytes(), "".bytes(), 0)?;
        for (i in 0..keys.length) {
            jsonPush(mut list, namespaceJson(keys[i].view()[CATALOG_NAMESPACES.bytes().length..])?)?;
        }
    }
    var j = jsonObject();
    jsonSet(mut j, "namespaces", list)?;
    return tablesJson(borrow j);
}

fn namespaceExists(store: borrow ObjectStore, hidden: Slice<u8>, ns: Slice<u8>) -> Result<bool, TablesError> {
    let key = catalogKey(CATALOG_NAMESPACES, ns, "".bytes())?;
    return Ok(readRecord(store, hidden, key.view())?.isSome());
}

fn icebergCreateNamespace(
    store: borrow mut ObjectStore,
    bucket: Slice<u8>,
    body: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let j = match (parseJson(body)?) {
        Some(j) => j,
        null => { return badRequest("The body is not JSON."); }
    };
    let ns = match (singleNamespace(borrow j)) {
        Ok(n) => n,
        Err(_) => { return badRequest("A namespace is one level here."); }
    };
    if (!tableNameOk(ns.view(), true)) { return badRequest("A namespace is 1 to 255 of a-z, 0-9 and _."); }
    // Only `owner`, as S3 Tables keeps.
    match (jsonMember(borrow j, "properties")) {
        Some(p) => {
            match (p) {
                Json.Object(ms) => {
                    for (i in 0..ms.length) {
                        if (ms[i].key.view() != "owner".bytes()) {
                            return badRequest("Only the owner property is kept.");
                        }
                        match (borrow ms[i].value) {
                            Json.Text(_) => {}
                            _ => { return badRequest("A property's value is a string."); }
                        }
                    }
                }
                _ => { return badRequest("The properties must be an object."); }
            }
        }
        null => {}
    }
    let hidden = tableWarehouseBucket(bucket)?;
    var id = Vector<u8>.create();
    if (!newUuid(mut id)?) { return Err(TablesError.Internal); }
    var rec = jsonObject();
    jsonSet(mut rec, "id", Json.Text(id))?;
    jsonSet(mut rec, "createdAt", jsonInteger(Clock.unixMillis())?)?;
    // Its `owner` is kept with it, and given back on create and load.
    let properties = namespaceProperties(borrow j)?;
    jsonSet(mut rec, "properties", cloneJson(borrow properties)?)?;
    let key = catalogKey(CATALOG_NAMESPACES, ns.view(), "".bytes())?;
    match (writeRecord(store, hidden.view(), key.view(), borrow rec, PutCondition.IfAbsent)) {
        Ok(_) => {}
        Err(TablesError.Conflict) => {
            return icebergError(409, "AlreadyExistsException", "The namespace already exists.");
        }
        Err(e) => { return Err(e); }
    }
    var answer = jsonObject();
    jsonSet(mut answer, "namespace", namespaceJson(ns.view())?)?;
    jsonSet(mut answer, "properties", properties)?;
    return tablesJson(borrow answer);
}

/// A namespace's properties as kept: `{"owner": …}` when one was given (the only one taken), else `{}`.
fn namespaceProperties(j: borrow Json) -> Result<Json, AllocError> {
    var out = jsonObject();
    match (jsonMember(j, "properties")) {
        Some(p) => {
            match (jsonMember(p, "owner")) {
                Some(o) => { jsonSet(mut out, "owner", cloneJson(o)?)?; }
                null => {}
            }
        }
        null => {}
    }
    return Ok(out);
}

fn icebergNamespace(
    store: borrow mut ObjectStore,
    m: Method,
    bucket: Slice<u8>,
    ns: Slice<u8>,
) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(bucket)?;
    let key = catalogKey(CATALOG_NAMESPACES, ns, "".bytes())?;
    let rec = match (readRecord(store, hidden.view(), key.view())?) {
        Some(r) => r,
        null => { return noSuchNamespace(); }
    };
    if (isMethod(m, Method.Head)) { return Ok(tablesNoContent()); }
    if (isMethod(m, Method.Get)) {
        var answer = jsonObject();
        jsonSet(mut answer, "namespace", namespaceJson(ns)?)?;
        jsonSet(mut answer, "properties", namespaceProperties(borrow rec.json)?)?;
        return tablesJson(borrow answer);
    }
    if (isMethod(m, Method.Delete)) {
        return match (deleteNamespace(store, bucket, ns)) {
            Ok(a) => Ok(a),
            Err(TablesError.Conflict) => icebergError(409, "NamespaceNotEmptyException", "The namespace has tables."),
            Err(e) => Err(e),
        };
    }
    return icebergUnsupported();
}

// ---- Table metadata ----

/// The highest field id a schema's type assigns: struct fields, list elements and map keys and values, nested.
fn highestFieldId(t: borrow Json) -> i64 {
    var top: i64 = 0;
    match (jsonMember(t, "fields")) {
        Some(fs) => {
            match (fs) {
                Json.Array(items) => {
                    for (i in 0..items.length) {
                        let f = borrow items[i];
                        let id = jsonMemberI64(f, "id") ?? 0;
                        if (id > top) { top = id; }
                        match (jsonMember(f, "type")) {
                            Some(ty) => {
                                let inner = highestFieldId(ty);
                                if (inner > top) { top = inner; }
                            }
                            null => {}
                        }
                    }
                }
                _ => {}
            }
        }
        null => {}
    }
    for (k in ["element-id", "key-id", "value-id"]) {
        let id = jsonMemberI64(t, k) ?? 0;
        if (id > top) { top = id; }
    }
    for (k in ["element", "key", "value"]) {
        match (jsonMember(t, k)) {
            Some(inner) => {
                let id = highestFieldId(inner);
                if (id > top) { top = id; }
            }
            null => {}
        }
    }
    return top;
}

fn highestPartitionFieldId(spec: borrow Json, floor: i64) -> i64 {
    var top = floor;
    match (jsonMember(spec, "fields")) {
        Some(fs) => {
            match (fs) {
                Json.Array(items) => {
                    for (i in 0..items.length) {
                        let id = jsonMemberI64(borrow items[i], "field-id") ?? 0;
                        if (id > top) { top = id; }
                    }
                }
                _ => {}
            }
        }
        null => {}
    }
    return top;
}

fn arrayLength(j: borrow Json, key: StringView) -> usize => match (jsonMember(j, key)) {
    Some(v) => match (v) {
        Json.Array(items) => items.length,
        _ => 0,
    },
    null => 0,
};

/// Whether an array member holds an element whose `idKey` is `id`.
fn hasId(j: borrow Json, key: StringView, idKey: StringView, id: i64) -> bool {
    match (jsonMember(j, key)) {
        Some(v) => {
            match (v) {
                Json.Array(items) => {
                    for (i in 0..items.length) {
                        if (jsonMemberI64(borrow items[i], idKey) == Some(id)) { return true; }
                    }
                }
                _ => {}
            }
        }
        null => {}
    }
    return false;
}

fn appendTo(m: borrow mut Json, key: StringView, value: Json) -> Result<void, AllocError> {
    match (jsonMemberMut(m, key)) {
        Some(a) => { return jsonPush(a, value); }
        null => {}
    }
    var a = jsonArray();
    jsonPush(mut a, value)?;
    return jsonSet(m, key, a);
}

/// Every field id a schema's type assigns (struct fields, list elements, map keys and values, nested), into `out`;
/// false if one is missing or not above 0.
fn collectFieldIds(t: borrow Json, out: borrow mut Vector<i64>) -> Result<bool, AllocError> {
    match (jsonMember(t, "fields")) {
        Some(fs) => {
            match (fs) {
                Json.Array(items) => {
                    for (i in 0..items.length) {
                        let f = borrow items[i];
                        let id = jsonMemberI64(f, "id") ?? 0;
                        if (id <= 0) { return Ok(false); }
                        out.push(id)?;
                        match (jsonMember(f, "type")) {
                            Some(ty) => {
                                if (!collectFieldIds(ty, out)?) { return Ok(false); }
                            }
                            null => { return Ok(false); }
                        }
                    }
                }
                _ => { return Ok(false); }
            }
        }
        null => {}
    }
    for (k in ["element-id", "key-id", "value-id"]) {
        match (jsonMember(t, k)) {
            Some(v) => {
                let id = jsonI64(v) ?? 0;
                if (id <= 0) { return Ok(false); }
                out.push(id)?;
            }
            null => {}
        }
    }
    for (k in ["element", "key", "value"]) {
        match (jsonMember(t, k)) {
            Some(inner) => {
                if (!collectFieldIds(inner, out)?) { return Ok(false); }
            }
            null => {}
        }
    }
    return Ok(true);
}

/// Whether every element of an array member names, by `source-id`, one of `columns`.
fn sourcesKnown(j: borrow Json, columns: Slice<i64>) -> bool {
    match (jsonMember(j, "fields")) {
        Some(fs) => {
            match (fs) {
                Json.Array(items) => {
                    for (i in 0..items.length) {
                        match (jsonMemberI64(borrow items[i], "source-id")) {
                            Some(s) => {
                                if (!holdsId(columns, s)) { return false; }
                            }
                            null => { return false; }
                        }
                    }
                }
                _ => { return false; }
            }
        }
        null => {}
    }
    return true;
}

/// A new spec's field ids: each given one at least 1000 and unique, a missing one assigned after the highest, as
/// Iceberg's own catalogs do. False if they are not so.
fn assignPartitionFieldIds(spec: borrow mut Json) -> Result<bool, AllocError> {
    var seen = Vector<i64>.create();
    var top: i64 = 999;
    match (jsonMember(spec, "fields")) {
        Some(fs) => {
            match (fs) {
                Json.Array(items) => {
                    for (i in 0..items.length) {
                        match (jsonMember(borrow items[i], "field-id")) {
                            Some(v) => {
                                let id = jsonI64(v) ?? 0;
                                if (id < 1000 || holdsId(seen.view(), id)) { return Ok(false); }
                                seen.push(id)?;
                                if (id > top) { top = id; }
                            }
                            null => {}
                        }
                    }
                }
                _ => { return Ok(false); }
            }
        }
        null => {}
    }
    match (jsonMemberMut(spec, "fields")) {
        Some(fs) => {
            match (fs) {
                Json.Array(items) => {
                    for (i in 0..items.length) {
                        if (jsonMember(borrow items[i], "field-id").isNull()) {
                            top += 1;
                            jsonSet(mut items[i], "field-id", jsonInteger(top)?)?;
                        }
                    }
                }
                _ => {}
            }
        }
        null => {}
    }
    return Ok(true);
}

/// A member of `j` that is there and not `null`: a CreateTableRequest's optional members may be sent as `null`, as
/// Iceberg Java sends `write-order` (ADR-0122's Java check).
fn presentMember<region a>(j: borrow(a) Json, key: StringView) -> borrow(a) Json? {
    return match (jsonMember(j, key)) {
        Some(v) => match (v) {
            Json.Null => null,
            _ => Some(v),
        },
        null => null,
    };
}

/// A schema's column ids, when it is a struct whose every field has an id above 0, once only (the REST spec has the
/// client assign them); null otherwise.
fn schemaColumns(schema: borrow Json) -> Result<Vector<i64>?, AllocError> {
    if (jsonMemberText(schema, "type") != Some("struct".bytes())) { return Ok(null); }
    var columns = Vector<i64>.create();
    if (!collectFieldIds(schema, mut columns)?) { return Ok(null); }
    if (columns.length == 0) { return Ok(null); }
    var sorted = Vector<i64>.create();
    sorted.extend(columns.view())?;
    sorted.sortBy((a, b) => if (a < b) -1 else if (a > b) 1 else 0);
    for (i in 1..sorted.length) {
        if (sorted[i - 1] == sorted[i]) { return Ok(null); }
    }
    return Ok(Some(columns));
}

/// A new table's first metadata from a CreateTableRequest: its schema as schema 0, its spec as spec 0, its order, its
/// properties, and the warehouse as its location; format version 2, or 3 when its `format-version` property asks
/// (ADR-0122 §2; the property itself not stored, as Iceberg's catalogs do). Null if the schema, spec or order is not
/// valid (field ids missing or repeated, a spec or order naming a column the schema has not), or the version is not 2
/// or 3.
fn newTableMetadata(request: borrow Json, location: Slice<u8>) -> Result<Json?, TablesError> {
    var schema = match (jsonMember(request, "schema")) {
        Some(s) => cloneJson(s)?,
        null => { return Ok(null); }
    };
    jsonSet(mut schema, "schema-id", jsonInteger(0)?)?;
    let columns = schemaColumns(borrow schema)? ?? { return Ok(null); };
    let lastColumn = highestFieldId(borrow schema);
    var spec = match (presentMember(request, "partition-spec")) {
        Some(s) => cloneJson(s)?,
        null => {
            var s = jsonObject();
            jsonSet(mut s, "fields", jsonArray())?;
            s
        }
    };
    jsonSet(mut spec, "spec-id", jsonInteger(0)?)?;
    if (!assignPartitionFieldIds(mut spec)? || !sourcesKnown(borrow spec, columns.view())) { return Ok(null); }
    let lastPartition = highestPartitionFieldId(borrow spec, 999);
    var order = match (presentMember(request, "write-order")) {
        Some(o) => cloneJson(o)?,
        null => {
            var o = jsonObject();
            jsonSet(mut o, "order-id", jsonInteger(0)?)?;
            jsonSet(mut o, "fields", jsonArray())?;
            o
        }
    };
    if (!sourcesKnown(borrow order, columns.view())) { return Ok(null); }
    // Order 0 is the unsorted order, so a sorted one is order 1 (as Iceberg's catalogs assign a new table's).
    let orderId: i64 = if (arrayLength(borrow order, "fields") == 0) 0 else 1;
    jsonSet(mut order, "order-id", jsonInteger(orderId)?)?;
    var properties = match (presentMember(request, "properties")) {
        Some(p) => cloneJson(p)?,
        null => jsonObject(),
    };
    let version: i64 = match (jsonMember(borrow properties, "format-version")) {
        Some(v) => match (v) {
            Json.Text(t) => match (parseDecimal(t.view())) {
                Some(2) => 2,
                Some(3) => 3,
                _ => { return Ok(null); }
            },
            _ => { return Ok(null); }
        },
        null => 2,
    };
    jsonRemove(mut properties, "format-version".bytes());
    var uuid = Vector<u8>.create();
    if (!newUuid(mut uuid)?) { return Err(TablesError.Internal); }
    var m = jsonObject();
    jsonSet(mut m, "format-version", jsonInteger(version)?)?;
    // Row lineage's counter (v3): the next snapshot's `first-row-id`.
    if (version >= 3) { jsonSet(mut m, "next-row-id", jsonInteger(0)?)?; }
    jsonSet(mut m, "table-uuid", Json.Text(uuid))?;
    jsonSet(mut m, "location", jsonString(location)?)?;
    jsonSet(mut m, "last-sequence-number", jsonInteger(0)?)?;
    jsonSet(mut m, "last-updated-ms", jsonInteger(Clock.unixMillis())?)?;
    jsonSet(mut m, "last-column-id", jsonInteger(lastColumn)?)?;
    var schemas = jsonArray();
    jsonPush(mut schemas, schema)?;
    jsonSet(mut m, "schemas", schemas)?;
    jsonSet(mut m, "current-schema-id", jsonInteger(0)?)?;
    var specs = jsonArray();
    jsonPush(mut specs, spec)?;
    jsonSet(mut m, "partition-specs", specs)?;
    jsonSet(mut m, "default-spec-id", jsonInteger(0)?)?;
    jsonSet(mut m, "last-partition-id", jsonInteger(lastPartition)?)?;
    var orders = jsonArray();
    jsonPush(mut orders, order)?;
    jsonSet(mut m, "sort-orders", orders)?;
    jsonSet(mut m, "default-sort-order-id", jsonInteger(orderId)?)?;
    jsonSet(mut m, "properties", properties)?;
    jsonSet(mut m, "current-snapshot-id", jsonInteger(-1)?)?;
    jsonSet(mut m, "refs", jsonObject())?;
    jsonSet(mut m, "snapshots", jsonArray())?;
    jsonSet(mut m, "snapshot-log", jsonArray())?;
    jsonSet(mut m, "metadata-log", jsonArray())?;
    return Ok(Some(m));
}

/// Why a commit is refused: a requirement that does not hold (409), or an update this catalog does not apply
/// or that is wrong (400).
enum CommitRefusal {
    Requirement,
    Update,
}

/// Each requirement against the current metadata (ADR-0083 §5).
fn checkRequirements(m: borrow Json, requirements: borrow Json) -> Result<CommitRefusal?, AllocError> {
    let items = match (requirements) {
        Json.Array(items) => items,
        _ => { return Ok(Some(CommitRefusal.Update)); }
    };
    if (items.length > ICEBERG_MAX_CHANGES) { return Ok(Some(CommitRefusal.Update)); }
    for (i in 0..items.length) {
        let r = borrow items[i];
        let kind = jsonMemberText(r, "type") ?? "".bytes();
        let holds = if (kind == "assert-create".bytes()) {
            false // the table exists
        } else if (kind == "assert-table-uuid".bytes()) {
            jsonMemberText(r, "uuid") == jsonMemberText(m, "table-uuid")
        } else if (kind == "assert-ref-snapshot-id".bytes()) {
            let refName = jsonMemberText(r, "ref") ?? "".bytes();
            let current: i64? = match (jsonMember(m, "refs")) {
                Some(refs) => match (refs) {
                    Json.Object(ms) => {
                        var found: i64? = null;
                        for (k in 0..ms.length) {
                            if (ms[k].key.view() == refName) {
                                found = jsonMemberI64(borrow ms[k].value, "snapshot-id");
                            }
                        }
                        found
                    },
                    _ => null,
                },
                null => null,
            };
            let wanted = match (jsonMember(r, "snapshot-id")) {
                Some(v) => jsonI64(v),
                null => null,
            };
            current == wanted
        } else if (kind == "assert-last-assigned-field-id".bytes()) {
            jsonMemberI64(r, "last-assigned-field-id") == jsonMemberI64(m, "last-column-id")
        } else if (kind == "assert-current-schema-id".bytes()) {
            jsonMemberI64(r, "current-schema-id") == jsonMemberI64(m, "current-schema-id")
        } else if (kind == "assert-last-assigned-partition-id".bytes()) {
            jsonMemberI64(r, "last-assigned-partition-id") == jsonMemberI64(m, "last-partition-id")
        } else if (kind == "assert-default-spec-id".bytes()) {
            jsonMemberI64(r, "default-spec-id") == jsonMemberI64(m, "default-spec-id")
        } else if (kind == "assert-default-sort-order-id".bytes()) {
            jsonMemberI64(r, "default-sort-order-id") == jsonMemberI64(m, "default-sort-order-id")
        } else {
            return Ok(Some(CommitRefusal.Update)); // an unknown requirement: 400
        };
        if (!holds) { return Ok(Some(CommitRefusal.Requirement)); }
    }
    return Ok(null);
}

/// Applies a commit's updates to `m`, as Iceberg's own catalogs do; Update for one not done or not valid.
fn applyUpdates(m: borrow mut Json, updates: borrow Json, warehouse: Slice<u8>) -> Result<CommitRefusal?, AllocError> {
    let items = match (updates) {
        Json.Array(items) => items,
        _ => { return Ok(Some(CommitRefusal.Update)); }
    };
    if (items.length > ICEBERG_MAX_CHANGES) { return Ok(Some(CommitRefusal.Update)); }
    var addedSnapshots = Vector<i64>.create();
    // What `-1` names in set-current-schema and the like: the last added by this commit, none if it added none.
    var addedSchema: i64? = null;
    var addedSpec: i64? = null;
    var addedOrder: i64? = null;
    let now = Clock.unixMillis();
    for (i in 0..items.length) {
        let u = borrow items[i];
        let action = jsonMemberText(u, "action") ?? "".bytes();
        if (action == "assign-uuid".bytes()) {
            let uuid = jsonMemberText(u, "uuid") ?? "".bytes();
            if (uuid.length == 0) { return Ok(Some(CommitRefusal.Update)); }
            jsonSet(m, "table-uuid", jsonString(uuid)?)?;
        } else if (action == "upgrade-format-version".bytes()) {
            // 2 or 3, never down (ADR-0122 §2); to 3, row lineage's counter from 0.
            let v = jsonMemberI64(u, "format-version") ?? 0;
            let current = jsonMemberI64(m, "format-version") ?? 1;
            if (v < current || v < 2 || v > 3) { return Ok(Some(CommitRefusal.Update)); }
            if (v > current) {
                jsonSet(m, "format-version", jsonInteger(v)?)?;
                if (v >= 3 && jsonMemberI64(m, "next-row-id").isNull()) {
                    jsonSet(m, "next-row-id", jsonInteger(0)?)?;
                }
            }
        } else if (action == "add-schema".bytes()) {
            let schema = match (jsonMember(u, "schema")) {
                Some(s) => cloneJson(s)?,
                null => { return Ok(Some(CommitRefusal.Update)); }
            };
            let id = jsonMemberI64(borrow schema, "schema-id") ?? -1;
            if (id < 0 || hasId(m, "schemas", "schema-id", id)) { return Ok(Some(CommitRefusal.Update)); }
            let highest = highestFieldId(borrow schema);
            let last = jsonMemberI64(m, "last-column-id") ?? 0;
            appendTo(m, "schemas", schema)?;
            jsonSet(m, "last-column-id", jsonInteger(if (highest > last) highest else last)?)?;
            addedSchema = Some(id);
        } else if (action == "set-current-schema".bytes()) {
            var id = jsonMemberI64(u, "schema-id") ?? -2;
            if (id == -1) { id = addedSchema ?? -2; }
            if (!hasId(m, "schemas", "schema-id", id)) { return Ok(Some(CommitRefusal.Update)); }
            jsonSet(m, "current-schema-id", jsonInteger(id)?)?;
        } else if (action == "add-spec".bytes()) {
            let spec = match (jsonMember(u, "spec")) {
                Some(s) => cloneJson(s)?,
                null => { return Ok(Some(CommitRefusal.Update)); }
            };
            let id = jsonMemberI64(borrow spec, "spec-id") ?? -1;
            if (id < 0 || hasId(m, "partition-specs", "spec-id", id)) { return Ok(Some(CommitRefusal.Update)); }
            let last = highestPartitionFieldId(borrow spec, jsonMemberI64(m, "last-partition-id") ?? 999);
            appendTo(m, "partition-specs", spec)?;
            jsonSet(m, "last-partition-id", jsonInteger(last)?)?;
            addedSpec = Some(id);
        } else if (action == "set-default-spec".bytes()) {
            var id = jsonMemberI64(u, "spec-id") ?? -2;
            if (id == -1) { id = addedSpec ?? -2; }
            if (!hasId(m, "partition-specs", "spec-id", id)) { return Ok(Some(CommitRefusal.Update)); }
            jsonSet(m, "default-spec-id", jsonInteger(id)?)?;
        } else if (action == "add-sort-order".bytes()) {
            let order = match (jsonMember(u, "sort-order")) {
                Some(o) => cloneJson(o)?,
                null => { return Ok(Some(CommitRefusal.Update)); }
            };
            let id = jsonMemberI64(borrow order, "order-id") ?? -1;
            if (id < 0 || hasId(m, "sort-orders", "order-id", id)) { return Ok(Some(CommitRefusal.Update)); }
            appendTo(m, "sort-orders", order)?;
            addedOrder = Some(id);
        } else if (action == "set-default-sort-order".bytes()) {
            var id = jsonMemberI64(u, "sort-order-id") ?? -2;
            if (id == -1) { id = addedOrder ?? -2; }
            if (!hasId(m, "sort-orders", "order-id", id)) { return Ok(Some(CommitRefusal.Update)); }
            jsonSet(m, "default-sort-order-id", jsonInteger(id)?)?;
        } else if (action == "add-snapshot".bytes()) {
            let snapshot = match (jsonMember(u, "snapshot")) {
                Some(s) => cloneJson(s)?,
                null => { return Ok(Some(CommitRefusal.Update)); }
            };
            let id = match (jsonMemberI64(borrow snapshot, "snapshot-id")) {
                Some(v) => v,
                null => { return Ok(Some(CommitRefusal.Update)); }
            };
            if (hasId(m, "snapshots", "snapshot-id", id) || jsonMemberText(borrow snapshot, "manifest-list").isNull()) {
                return Ok(Some(CommitRefusal.Update));
            }
            let sequence = jsonMemberI64(borrow snapshot, "sequence-number");
            let lastSequence = jsonMemberI64(m, "last-sequence-number") ?? 0;
            // A parent given as `null` is none.
            let hasParent = jsonMemberI64(borrow snapshot, "parent-snapshot-id").isSome();
            match (sequence) {
                Some(s) => {
                    if (s <= lastSequence && hasParent) { return Ok(Some(CommitRefusal.Update)); }
                    jsonSet(m, "last-sequence-number", jsonInteger(s)?)?;
                }
                null => {}
            }
            // Row lineage (v3, ADR-0122 §2): the snapshot's first row id at or above the table's next, which its added
            // rows then advance. One below it was made from older metadata: a conflict, retried on the new.
            if ((jsonMemberI64(m, "format-version") ?? 1) >= 3) {
                let first = jsonMemberI64(borrow snapshot, "first-row-id") ?? {
                    return Ok(Some(CommitRefusal.Update));
                };
                let added = jsonMemberI64(borrow snapshot, "added-rows") ?? { return Ok(Some(CommitRefusal.Update)); };
                let next = jsonMemberI64(m, "next-row-id") ?? 0;
                if (added < 0) { return Ok(Some(CommitRefusal.Update)); }
                if (first < next) { return Ok(Some(CommitRefusal.Requirement)); }
                let advanced = addChecked(first, added) ?? { return Ok(Some(CommitRefusal.Update)); };
                jsonSet(m, "next-row-id", jsonInteger(advanced)?)?;
            }
            let stamp = jsonMemberI64(borrow snapshot, "timestamp-ms") ?? now;
            appendTo(m, "snapshots", snapshot)?;
            jsonSet(m, "last-updated-ms", jsonInteger(stamp)?)?;
            addedSnapshots.push(id)?;
        } else if (action == "set-snapshot-ref".bytes()) {
            let refName = copyBytes(jsonMemberText(u, "ref-name") ?? "".bytes())?;
            let id = jsonMemberI64(u, "snapshot-id") ?? -1;
            let kind = jsonMemberText(u, "type") ?? "".bytes();
            if (refName.length == 0 || (kind != "branch".bytes() && kind != "tag".bytes())) {
                return Ok(Some(CommitRefusal.Update));
            }
            if (!hasId(m, "snapshots", "snapshot-id", id)) { return Ok(Some(CommitRefusal.Update)); }
            var r = jsonObject();
            jsonSet(mut r, "snapshot-id", jsonInteger(id)?)?;
            jsonSet(mut r, "type", jsonString(kind)?)?;
            for (k in ["max-ref-age-ms", "max-snapshot-age-ms", "min-snapshots-to-keep"]) {
                match (jsonMember(u, k)) {
                    Some(v) => {
                        match (v) {
                            Json.Null => {}
                            _ => { jsonSet(mut r, k, cloneJson(v)?)?; }
                        }
                    }
                    null => {}
                }
            }
            match (jsonMemberMut(m, "refs")) {
                Some(refs) => { jsonSet(refs, textOfRef(refName.view()), r)?; }
                null => {
                    var refs = jsonObject();
                    jsonSet(mut refs, textOfRef(refName.view()), r)?;
                    jsonSet(m, "refs", refs)?;
                }
            }
            if (refName.view() == "main".bytes()) {
                jsonSet(m, "current-snapshot-id", jsonInteger(id)?)?;
                let stamp = if (holdsId(addedSnapshots.view(), id)) jsonMemberI64(m, "last-updated-ms") ?? now else now;
                var entry = jsonObject();
                jsonSet(mut entry, "snapshot-id", jsonInteger(id)?)?;
                jsonSet(mut entry, "timestamp-ms", jsonInteger(stamp)?)?;
                appendTo(m, "snapshot-log", entry)?;
                jsonSet(m, "last-updated-ms", jsonInteger(stamp)?)?;
            }
        } else if (action == "remove-snapshots".bytes()) {
            var gone = Vector<i64>.create();
            match (jsonMember(u, "snapshot-ids")) {
                Some(v) => {
                    match (v) {
                        Json.Array(ids) => {
                            for (k in 0..ids.length) { gone.push(jsonI64(borrow ids[k]) ?? -1)?; }
                        }
                        _ => { return Ok(Some(CommitRefusal.Update)); }
                    }
                }
                null => { return Ok(Some(CommitRefusal.Update)); }
            }
            for (k in 0..gone.length) {
                if (!hasId(m, "snapshots", "snapshot-id", gone[k])) { return Ok(Some(CommitRefusal.Update)); }
            }
            removeSnapshots(m, gone.view())?;
        } else if (action == "remove-snapshot-ref".bytes()) {
            let refName = copyBytes(jsonMemberText(u, "ref-name") ?? "".bytes())?;
            match (jsonMemberMut(m, "refs")) {
                Some(refs) => { jsonRemove(refs, refName.view()); }
                null => {}
            }
            if (refName.view() == "main".bytes()) { jsonSet(m, "current-snapshot-id", jsonInteger(-1)?)?; }
        } else if (action == "set-location".bytes()) {
            let location = jsonMemberText(u, "location") ?? "".bytes();
            // Within the table's warehouse only, where its files are and its drop purges (ADR-0083 §4).
            if (!withinWarehouse(location, warehouse)) { return Ok(Some(CommitRefusal.Update)); }
            jsonSet(m, "location", jsonString(location)?)?;
        } else if (action == "set-properties".bytes()) {
            let changes = match (jsonMember(u, "updates")) {
                Some(c) => c,
                null => { return Ok(Some(CommitRefusal.Update)); }
            };
            // A property is a string to a string.
            match (changes) {
                Json.Object(ms) => {
                    for (k in 0..ms.length) {
                        match (borrow ms[k].value) {
                            Json.Text(_) => {}
                            _ => { return Ok(Some(CommitRefusal.Update)); }
                        }
                    }
                }
                _ => { return Ok(Some(CommitRefusal.Update)); }
            }
            // A metadata file with no properties (one an engine wrote) gains them.
            if (jsonMember(m, "properties").isNull()) { jsonSet(m, "properties", jsonObject())?; }
            match (jsonMemberMut(m, "properties")) {
                Some(p) => { jsonSetAll(p, changes)?; }
                null => {}
            }
        } else if (action == "remove-properties".bytes()) {
            var removals = Vector<Vector<u8>>.create();
            match (jsonMember(u, "removals")) {
                Some(v) => {
                    match (v) {
                        Json.Array(keys) => {
                            for (k in 0..keys.length) {
                                match (borrow keys[k]) {
                                    Json.Text(t) => { removals.push(copyBytes(t.view())?)?; }
                                    _ => { return Ok(Some(CommitRefusal.Update)); }
                                }
                            }
                        }
                        _ => { return Ok(Some(CommitRefusal.Update)); }
                    }
                }
                null => { return Ok(Some(CommitRefusal.Update)); }
            }
            match (jsonMemberMut(m, "properties")) {
                Some(p) => { jsonRemoveAll(p, mut removals); }
                null => {}
            }
        } else {
            return Ok(Some(CommitRefusal.Update)); // statistics, removing schemas or specs, and the rest: not done
        }
    }
    return Ok(null);
}

/// remove-snapshots, as Iceberg's own catalogs apply it: the snapshots go, and with them the refs that name one (main's
/// with the current snapshot) and their snapshot-log entries; a kept snapshot whose parent went has none.
fn removeSnapshots(m: borrow mut Json, gone: Slice<i64>) -> Result<void, AllocError> {
    match (jsonMemberMut(m, "snapshots")) {
        Some(s) => {
            match (s) {
                Json.Array(kept) => {
                    kept.retain((x) => !holdsId(gone, jsonMemberI64(x, "snapshot-id") ?? -1));
                    for (k in 0..kept.length) {
                        match (jsonMemberI64(borrow kept[k], "parent-snapshot-id")) {
                            Some(p) => {
                                if (holdsId(gone, p)) { jsonRemove(mut kept[k], "parent-snapshot-id".bytes()); }
                            }
                            null => {}
                        }
                    }
                }
                _ => {}
            }
        }
        null => {}
    }
    match (jsonMemberMut(m, "snapshot-log")) {
        Some(s) => {
            match (s) {
                Json.Array(log) => { log.retain((x) => !holdsId(gone, jsonMemberI64(x, "snapshot-id") ?? -1)); }
                _ => {}
            }
        }
        null => {}
    }
    match (jsonMemberMut(m, "refs")) {
        Some(r) => {
            match (r) {
                Json.Object(refs) => {
                    refs.retain((x) => !holdsId(gone, jsonMemberI64(borrow x.value, "snapshot-id") ?? -1));
                }
                _ => {}
            }
        }
        null => {}
    }
    // Their statistics files' entries go too, as Iceberg's catalogs remove them (M10's exit review, C1).
    for (k in ["statistics", "partition-statistics"]) {
        match (jsonMemberMut(m, k)) {
            Some(st) => {
                match (st) {
                    Json.Array(entries) => {
                        entries.retain((x) => !holdsId(gone, jsonMemberI64(x, "snapshot-id") ?? -1));
                    }
                    _ => {}
                }
            }
            null => {}
        }
    }
    if (holdsId(gone, jsonMemberI64(m, "current-snapshot-id") ?? -1)) {
        jsonSet(m, "current-snapshot-id", jsonInteger(-1)?)?;
    }
    return Ok();
}

/// A key as a StringView, for `jsonSet` (keys are the client's, checked UTF-8 by the parser's caller here).
fn textOfRef(key: Slice<u8>) -> StringView => StringView.fromUtf8(key) ?? "";

// ---- Metadata files ----

/// The key a metadata location names in the table bucket's hidden bucket; null if it is not there.
fn metadataKey<region a>(location: Slice<a, u8>, hidden: Slice<u8>) -> Slice<a, u8>? {
    let scheme = "s3://".bytes();
    if (!startsWithBytes(location, scheme)) { return null; }
    let rest = location[scheme.length..];
    if (!startsWithBytes(rest, hidden) || rest.length <= hidden.length || rest[hidden.length] != '/') { return null; }
    return Some(rest[hidden.length + 1..]);
}

fn holdsId(ids: Slice<i64>, id: i64) -> bool {
    for (x in ids) {
        if (x == id) { return true; }
    }
    return false;
}

fn readMetadata(store: borrow ObjectStore, hidden: Slice<u8>, location: Slice<u8>) -> Result<Json, TablesError> {
    let none = Vector<MasterKey>.create();
    return readMetadataWith(store, hidden, location, borrow WarehouseKeys { sse: none.view(), kms: none.view() });
}

/// `readMetadata` with the server's keys: an encrypted table's metadata file opened (ADR-0126 §4).
fn readMetadataWith(
    store: borrow ObjectStore,
    hidden: Slice<u8>,
    location: Slice<u8>,
    keys: borrow WarehouseKeys,
) -> Result<Json, TablesError> {
    let key = match (metadataKey(location, hidden)) {
        Some(k) => k,
        null => { return Err(TablesError.Internal); }
    };
    let info = match (store.headObject(catalogText(hidden), catalogText(key))) {
        Ok(i) => i,
        Err(e) => { return Err(tablesStoreFail(e)); }
    };
    let stored = match (store.getObject(catalogText(hidden), catalogText(key))) {
        Ok(b) => b,
        Err(e) => { return Err(tablesStoreFail(e)); }
    };
    let bytes = plainOfStored(borrow info, stored, keys)? ?? { return Err(TablesError.Internal); };
    return match (parseJson(bytes.view())?) {
        Some(j) => Ok(j),
        null => Err(TablesError.Internal),
    };
}

/// A table's configuration at its create through the catalog, written at its id: its bucket's storage class and
/// encryption then (ADR-0126 §2, §3). Its encryption, which the create's first metadata file is sealed with: given
/// to it, not read back, as a cluster shard's write is not seen in its own request (ADR-0058).
fn writeCreatedTableConfig(
    store: borrow mut ObjectStore,
    hidden: Slice<u8>,
    id: Slice<u8>,
    keys: borrow WarehouseKeys,
) -> Result<Json?, TablesError> {
    var config = jsonObject();
    jsonSet(mut config, "storageClass", Json.Text(bucketStorageClass(store, hidden)?))?;
    let encryption = bucketEncryption(store, hidden)?;
    match (encryption.asBorrow()) {
        Some(e) => {
            // A key this server no longer seals with (retired since the bucket's was set): refused, as each of
            // the table's writes would be.
            if (!encryptionHeld(e, keys)) { return Err(TablesError.BadRequest); }
            jsonSet(mut config, "encryption", cloneJson(e)?)?;
        }
        null => {}
    }
    writeTablesConfig(store, hidden, tableConfigKey(id)?.view(), borrow config)?;
    return Ok(encryption);
}

/// The version number a metadata file's name begins with (`00003-<uuid>.metadata.json`), or -1.
fn metadataVersion(location: Slice<u8>) -> i64 {
    var slash = 0usize;
    for (i in 0..location.length) {
        if (location[i] == '/') { slash = i + 1; }
    }
    let name = location[slash..];
    let dash = pieceEnd(name, 0, '-');
    return parseJsonInteger(name[0..dash]) ?? -1;
}

/// Writes `m` as the table's metadata file of version `n`; its location.
fn writeMetadata(
    store: borrow mut ObjectStore,
    hidden: Slice<u8>,
    tableId: Slice<u8>,
    n: i64,
    m: borrow Json,
) -> Result<Vector<u8>, TablesError> {
    let none = Vector<MasterKey>.create();
    return writeMetadataWith(store, hidden, tableId, n, m, borrow WarehouseKeys { sse: none.view(), kms: none.view() });
}

/// `writeMetadata` sealed with the table's encryption, when it has one (ADR-0126 §4), by the server's keys.
fn writeMetadataWith(
    store: borrow mut ObjectStore,
    hidden: Slice<u8>,
    tableId: Slice<u8>,
    n: i64,
    m: borrow Json,
    keys: borrow WarehouseKeys,
) -> Result<Vector<u8>, TablesError> {
    let encryption = tableEncryption(store, hidden, tableId)?;
    return writeMetadataSealedBy(store, hidden, tableId, n, m, keys, encryption.asBorrow());
}

/// `writeMetadataWith` sealed with `encryption`, the table's as its caller has it: a create's, given rather than read
/// back (`writeCreatedTableConfig`).
fn writeMetadataSealedBy(
    store: borrow mut ObjectStore,
    hidden: Slice<u8>,
    tableId: Slice<u8>,
    n: i64,
    m: borrow Json,
    keys: borrow WarehouseKeys,
    encryption: borrow Json?,
) -> Result<Vector<u8>, TablesError> {
    var key = copyBytes(tableId)?;
    key.extend("/metadata/".bytes())?;
    var digits = Vector<u8>.create();
    appendDecimal(mut digits, truncate<u64>(n))?;
    for (i in digits.length..5) { key.push('0')?; }
    key.extend(digits.view())?;
    key.push('-')?;
    if (!newUuid(mut key)?) { return Err(TablesError.Internal); }
    key.extend(".metadata.json".bytes())?;
    var body = Vector<u8>.create();
    writeJson(mut body, m)?;
    match (putTableFile(
        store,
        catalogText(hidden),
        catalogText(key.view()),
        "application/json",
        body.view(),
        encryption,
        keys,
        PutCondition.IfAbsent,
    )) {
        Ok(true) => {}
        Ok(false) => { return Err(TablesError.Internal); } // its key is not held here
        Err(e) => { return Err(tablesStoreFail(e)); }
    }
    var location = copyBytes("s3://".bytes())?;
    location.extend(hidden)?;
    location.push('/')?;
    location.extend(key.view())?;
    return Ok(location);
}

/// Makes `m`, changed from the metadata at `previous`, the table's: stamps when it changed (unless a snapshot's time
/// says), puts `previous` in its metadata log (the last ICEBERG_METADATA_LOG_MAX kept), writes the next version's file
/// and swaps the table's record to it by If-Match. Its location; null if another commit swapped first (its file is
/// then removed). A commit and snapshot management both commit so (ADR-0083 §5, ADR-0086 §2).
fn swapMetadata(
    store: borrow mut ObjectStore,
    hidden: Slice<u8>,
    id: Slice<u8>,
    key: Slice<u8>,
    rec: borrow mut CatalogRecord,
    previous: Slice<u8>,
    m: borrow mut Json,
    previousStamp: i64,
    sealing: borrow WarehouseKeys,
) -> Result<Vector<u8>?, TablesError> {
    // The metadata changed now, unless a snapshot's time already says when.
    if ((jsonMemberI64(m, "last-updated-ms") ?? 0) == previousStamp) {
        let now = Clock.unixMillis();
        jsonSet(m, "last-updated-ms", jsonInteger(if (now > previousStamp) now else previousStamp + 1)?)?;
    }
    var entry = jsonObject();
    jsonSet(mut entry, "metadata-file", jsonString(previous)?)?;
    jsonSet(mut entry, "timestamp-ms", jsonInteger(previousStamp)?)?;
    appendTo(m, "metadata-log", entry)?;
    match (jsonMemberMut(m, "metadata-log")) {
        Some(log) => {
            match (log) {
                Json.Array(items) => {
                    while (items.length > ICEBERG_METADATA_LOG_MAX) { let _ = items.remove(0); }
                }
                _ => {}
            }
        }
        null => {}
    }
    let version = metadataVersion(previous) + 1;
    let location = writeMetadataWith(store, hidden, id, if (version > 0) version else 1, m, sealing)?;
    jsonSet(mut rec.json, "metadataLocation", jsonString(location.view())?)?;
    jsonSet(mut rec.json, "modifiedAt", jsonInteger(Clock.unixMillis())?)?;
    match (writeRecord(store, hidden, key, borrow rec.json, PutCondition.IfGeneration(rec.generation))) {
        Ok(g) => { rec.generation = g; }
        Err(TablesError.Conflict) => {
            // Another commit swapped first: this one's file is no table's.
            removeMetadataFile(store, hidden, location.view());
            return Ok(null);
        }
        Err(e) => {
            removeMetadataFile(store, hidden, location.view());
            return Err(e);
        }
    }
    return Ok(Some(location));
}

/// Removes a metadata file this request wrote and no table names (a create or commit that lost its race).
fn removeMetadataFile(store: borrow mut ObjectStore, hidden: Slice<u8>, location: Slice<u8>) {
    match (metadataKey(location, hidden)) {
        Some(k) => { let _ = store.deleteObject(catalogText(hidden), catalogText(k)); }
        null => {}
    }
}

fn loadResult(location: Slice<u8>, m: Json) -> Result<TablesAnswer, TablesError> {
    var j = jsonObject();
    jsonSet(mut j, "metadata-location", jsonString(location)?)?;
    jsonSet(mut j, "metadata", m)?;
    jsonSet(mut j, "config", jsonObject())?;
    return tablesJson(borrow j);
}

// ---- Tables ----

fn icebergListTables(store: borrow ObjectStore, bucket: Slice<u8>, ns: Slice<u8>) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(bucket)?;
    if (!namespaceExists(store, hidden.view(), ns)?) { return noSuchNamespace(); }
    var base = catalogKey(CATALOG_TABLES, ns, "".bytes())?;
    base.push('/')?;
    let keys = catalogKeys(store, hidden.view(), base.view(), "".bytes(), 0)?;
    var list = jsonArray();
    for (i in 0..keys.length) {
        var id = jsonObject();
        jsonSet(mut id, "namespace", namespaceJson(ns)?)?;
        jsonSet(mut id, "name", jsonString(keys[i].view()[base.length..])?)?;
        jsonPush(mut list, id)?;
    }
    var j = jsonObject();
    jsonSet(mut j, "identifiers", list)?;
    return tablesJson(borrow j);
}

fn icebergCreateTable(
    store: borrow mut ObjectStore,
    bucket: Slice<u8>,
    ns: Slice<u8>,
    body: Slice<u8>,
    sealing: borrow WarehouseKeys,
) -> Result<TablesAnswer, TablesError> {
    let request = match (parseJson(body)?) {
        Some(j) => j,
        null => { return badRequest("The body is not JSON."); }
    };
    let name = copyBytes(jsonMemberText(borrow request, "name") ?? "".bytes())?;
    if (!tableNameOk(name.view(), false)) { return badRequest("A table is 1 to 255 of a-z, 0-9 and _."); }
    // A staged create (ADR-0124): the table's metadata answered, written nowhere; its id reserved, for the commit
    // that creates it (Iceberg Java's create and replace transactions, an engine's CREATE TABLE AS SELECT).
    let staged = match (jsonMember(borrow request, "stage-create")) {
        Some(v) => match (v) {
            Json.Bool(b) => *b,
            _ => false,
        },
        null => false,
    };
    let hidden = tableWarehouseBucket(bucket)?;
    if (!namespaceExists(store, hidden.view(), ns)?) { return noSuchNamespace(); }
    let key = catalogKey(CATALOG_TABLES, ns, name.view())?;
    if (readRecord(store, hidden.view(), key.view())?.isSome()) {
        return icebergError(409, "AlreadyExistsException", "The table already exists.");
    }
    var id = Vector<u8>.create();
    if (!newUuid(mut id)?) { return Err(TablesError.Internal); }
    let warehouse = warehouseOf(bucket, id.view())?;
    // A location given must be the warehouse S3 Tables gives it.
    match (jsonMemberText(borrow request, "location")) {
        Some(l) => {
            if (l != warehouse.view()) { return badRequest("A table's location is its warehouse."); }
        }
        null => {}
    }
    let m = match (newTableMetadata(borrow request, warehouse.view())?) {
        Some(m) => m,
        null => {
            return badRequest(
                "A table needs a struct schema with each field id once, and a spec and order of its columns.",
            );
        }
    };
    if (staged) {
        // Its configuration first, at its reserved id: the files an engine writes before its commit (a CTAS's data
        // and manifests) are sealed with its encryption as they arrive (ADR-0126 §4).
        let _ = writeCreatedTableConfig(store, hidden.view(), id.view(), sealing)?;
        // Kept by the table's namespace and name, so that one name holds one at most (the M29 exit review's M1): a
        // later staged create of the name replaces it.
        var reservation = jsonObject();
        jsonSet(mut reservation, "id", jsonString(id.view())?)?;
        jsonSet(mut reservation, "createdAt", jsonInteger(Clock.unixMillis())?)?;
        let stagedKey = catalogKey(CATALOG_STAGED, ns, name.view())?;
        let _ = writeRecord(store, hidden.view(), stagedKey.view(), borrow reservation, PutCondition.None)?;
        var j = jsonObject();
        jsonSet(mut j, "metadata", m)?;
        jsonSet(mut j, "config", jsonObject())?;
        return tablesJson(borrow j);
    }
    // Its configuration, written first; its metadata sealed with its encryption.
    let encryption = writeCreatedTableConfig(store, hidden.view(), id.view(), sealing)?;
    let location = writeMetadataSealedBy(store, hidden.view(), id.view(), 0, borrow m, sealing, encryption.asBorrow())?;
    let now = Clock.unixMillis();
    var rec = jsonObject();
    jsonSet(mut rec, "id", jsonString(id.view())?)?;
    jsonSet(mut rec, "createdAt", jsonInteger(now)?)?;
    jsonSet(mut rec, "modifiedAt", jsonInteger(now)?)?;
    jsonSet(mut rec, "metadataLocation", jsonString(location.view())?)?;
    match (writeRecord(store, hidden.view(), key.view(), borrow rec, PutCondition.IfAbsent)) {
        Ok(_) => {}
        Err(e) => {
            // Another create won the name: this one's file and configuration are no table's.
            removeMetadataFile(store, hidden.view(), location.view());
            let _ = store.deleteObject(catalogText(hidden.view()), catalogText(tableConfigKey(id.view())?.view()));
            return match (e) {
                TablesError.Conflict => icebergError(409, "AlreadyExistsException", "The table already exists."),
                _ => Err(e),
            };
        }
    }
    return loadResult(location.view(), m);
}

/// Whether a commit's requirements are `assert-create` alone.
fn createsOnly(requirements: borrow Json?) -> bool {
    let r = requirements ?? { return false; };
    return match (r) {
        Json.Array(items) => items.length == 1 && jsonMemberText(
            borrow items[0],
            "type",
        ) == Some("assert-create".bytes()),
        _ => false,
    };
}

/// A table made by a staged create's commit (ADR-0124): its updates applied to empty metadata, at the location its
/// staged create reserved, as Iceberg's catalogs build a table from a create transaction's changes.
fn icebergCommitCreate(
    store: borrow mut ObjectStore,
    bucket: Slice<u8>,
    ns: Slice<u8>,
    name: Slice<u8>,
    request: borrow Json,
    sealing: borrow WarehouseKeys,
) -> Result<TablesAnswer, TablesError> {
    let hidden = tableWarehouseBucket(bucket)?;
    if (!namespaceExists(store, hidden.view(), ns)?) { return noSuchNamespace(); }
    if (!tableNameOk(name, false)) { return badRequest("A table is 1 to 255 of a-z, 0-9 and _."); }
    let updates = match (jsonMember(request, "updates")) {
        Some(u) => cloneJson(u)?,
        null => jsonArray(),
    };
    // Its location, the warehouse of the id its staged create reserved for this table.
    var location: Vector<u8>? = null;
    match (borrow updates) {
        Json.Array(items) => {
            for (u in items.view()) {
                if (jsonMemberText(u, "action") == Some("set-location".bytes())) {
                    location = Some(copyBytes(jsonMemberText(u, "location") ?? "".bytes())?);
                }
            }
        }
        _ => { return badRequest("The commit's updates are not a list."); }
    }
    let at = location ?? { return badRequest("A create's commit sets its table's location."); };
    var prefix = copyBytes("s3://".bytes())?;
    prefix.extend(hidden.view())?;
    prefix.push('/')?;
    if (at.length <= prefix.length || !startsWithBytes(at.view(), prefix.view())) {
        return badRequest("A table's location is its warehouse.");
    }
    let id = copyBytes(at.view()[prefix.length..])?;
    if (findBytes(id.view(), "/".bytes(), 0).isSome()) { return badRequest("A table's location is its warehouse."); }
    let stagedKey = catalogKey(CATALOG_STAGED, ns, name)?;
    let reservation = readRecord(store, hidden.view(), stagedKey.view())? ?? {
        return badRequest("The table's location is not one a staged create gave it.");
    };
    if (jsonMemberText(borrow reservation.json, "id") != Some(id.view())) {
        return badRequest("The table's location is not the one its staged create gave it.");
    }
    let warehouse = warehouseOf(bucket, id.view())?;
    var m = emptyTableMetadata()?;
    match (applyUpdates(mut m, borrow updates, warehouse.view())?) {
        Some(_) => { return badRequest("An update is not valid here, or not one this catalog applies."); }
        null => {}
    }
    if (!completeCreatedMetadata(mut m, warehouse.view())?) {
        return badRequest("A created table needs its schema, its location and a format version of 2 or 3.");
    }
    // Its configuration as its staged create wrote it (the files written before this commit were sealed with it);
    // made now when it has none.
    let configKey = tableConfigKey(id.view())?;
    let staged = readTablesConfig(store, hidden.view(), configKey.view())?;
    var encryption: Json? = null;
    if (jsonMember(borrow staged, "storageClass").isNull()) {
        encryption = writeCreatedTableConfig(store, hidden.view(), id.view(), sealing)?;
    } else {
        match (jsonMember(borrow staged, "encryption")) {
            Some(e) => { encryption = Some(cloneJson(e)?); }
            null => {}
        }
    }
    let written = writeMetadataSealedBy(store, hidden.view(), id.view(), 0, borrow m, sealing, encryption.asBorrow())?;
    let now = Clock.unixMillis();
    var rec = jsonObject();
    jsonSet(mut rec, "id", jsonString(id.view())?)?;
    jsonSet(mut rec, "createdAt", jsonInteger(now)?)?;
    jsonSet(mut rec, "modifiedAt", jsonInteger(now)?)?;
    jsonSet(mut rec, "metadataLocation", jsonString(written.view())?)?;
    let key = catalogKey(CATALOG_TABLES, ns, name)?;
    match (writeRecord(store, hidden.view(), key.view(), borrow rec, PutCondition.IfAbsent)) {
        Ok(_) => {}
        Err(e) => {
            removeMetadataFile(store, hidden.view(), written.view());
            return match (e) {
                TablesError.Conflict => icebergError(409, "AlreadyExistsException", "The table already exists."),
                _ => Err(e),
            };
        }
    }
    let _ = store.deleteObject(catalogText(hidden.view()), catalogText(stagedKey.view()));
    var j = jsonObject();
    jsonSet(mut j, "metadata-location", jsonString(written.view())?)?;
    jsonSet(mut j, "metadata", m)?;
    return tablesJson(borrow j);
}

/// The metadata a create transaction's updates start from: no schema, spec, order, snapshot or location yet.
fn emptyTableMetadata() -> Result<Json, AllocError> {
    var m = jsonObject();
    jsonSet(mut m, "format-version", jsonInteger(1)?)?;
    jsonSet(mut m, "table-uuid", jsonString("".bytes())?)?;
    jsonSet(mut m, "location", jsonString("".bytes())?)?;
    jsonSet(mut m, "last-sequence-number", jsonInteger(0)?)?;
    jsonSet(mut m, "last-updated-ms", jsonInteger(Clock.unixMillis())?)?;
    jsonSet(mut m, "last-column-id", jsonInteger(0)?)?;
    jsonSet(mut m, "schemas", jsonArray())?;
    jsonSet(mut m, "current-schema-id", jsonInteger(-1)?)?;
    jsonSet(mut m, "partition-specs", jsonArray())?;
    jsonSet(mut m, "default-spec-id", jsonInteger(-1)?)?;
    jsonSet(mut m, "last-partition-id", jsonInteger(999)?)?;
    jsonSet(mut m, "sort-orders", jsonArray())?;
    jsonSet(mut m, "default-sort-order-id", jsonInteger(-1)?)?;
    jsonSet(mut m, "properties", jsonObject())?;
    jsonSet(mut m, "current-snapshot-id", jsonInteger(-1)?)?;
    jsonSet(mut m, "refs", jsonObject())?;
    jsonSet(mut m, "snapshots", jsonArray())?;
    jsonSet(mut m, "snapshot-log", jsonArray())?;
    jsonSet(mut m, "metadata-log", jsonArray())?;
    return Ok(m);
}

/// A created table's metadata made whole: version 2 or 3 (2 when its updates set none), its location the warehouse,
/// a schema current, an unpartitioned spec and the unsorted order when it added none, and a uuid; false when it
/// cannot be.
fn completeCreatedMetadata(m: borrow mut Json, warehouse: Slice<u8>) -> Result<bool, AllocError> {
    let version = jsonMemberI64(m, "format-version") ?? 1;
    if (version == 1) { jsonSet(m, "format-version", jsonInteger(2)?)?; }
    if (version > 3) { return Ok(false); }
    if (jsonMemberText(m, "location") != Some(warehouse)) { return Ok(false); }
    let current = jsonMemberI64(m, "current-schema-id") ?? -1;
    if (!hasId(m, "schemas", "schema-id", current)) { return Ok(false); }
    // The checks a create makes (the M29 exit review's M2): every schema a struct of ids once each, and each spec's
    // and order's sources the current schema's columns.
    var columns = Vector<i64>.create();
    for (schema in (memberItems(m, "schemas") ?? { return Ok(false); }).view()) {
        let ids = schemaColumns(schema)? ?? { return Ok(false); };
        if (jsonMemberI64(schema, "schema-id") == Some(current)) { columns = ids; }
    }
    for (spec in (memberItems(m, "partition-specs") ?? { return Ok(false); }).view()) {
        if (!sourcesKnown(spec, columns.view())) { return Ok(false); }
    }
    for (order in (memberItems(m, "sort-orders") ?? { return Ok(false); }).view()) {
        if (!sourcesKnown(order, columns.view())) { return Ok(false); }
    }
    // Its properties not the create's own `format-version`, which a create does not store (the review's L4).
    match (jsonMember(m, "properties")) {
        Some(_) => {
            var props = cloneJson(jsonMember(m, "properties") ?? { return Ok(false); })?;
            jsonRemove(mut props, "format-version".bytes());
            jsonSet(m, "properties", props)?;
        }
        null => {}
    }
    if (arrayLength(m, "partition-specs") == 0) {
        var spec = jsonObject();
        jsonSet(mut spec, "spec-id", jsonInteger(0)?)?;
        jsonSet(mut spec, "fields", jsonArray())?;
        appendTo(m, "partition-specs", spec)?;
        jsonSet(m, "default-spec-id", jsonInteger(0)?)?;
    }
    if (!hasId(m, "partition-specs", "spec-id", jsonMemberI64(m, "default-spec-id") ?? -1)) { return Ok(false); }
    if (arrayLength(m, "sort-orders") == 0) {
        var order = jsonObject();
        jsonSet(mut order, "order-id", jsonInteger(0)?)?;
        jsonSet(mut order, "fields", jsonArray())?;
        appendTo(m, "sort-orders", order)?;
        jsonSet(m, "default-sort-order-id", jsonInteger(0)?)?;
    }
    if (!hasId(m, "sort-orders", "order-id", jsonMemberI64(m, "default-sort-order-id") ?? -1)) { return Ok(false); }
    if (jsonMemberText(m, "table-uuid") == Some("".bytes())) {
        var uuid = Vector<u8>.create();
        if (!newUuid(mut uuid)?) { return Ok(false); }
        jsonSet(m, "table-uuid", Json.Text(uuid))?;
    }
    if ((jsonMemberI64(m, "format-version") ?? 2) >= 3 && jsonMemberI64(m, "next-row-id").isNull()) {
        jsonSet(m, "next-row-id", jsonInteger(0)?)?;
    }
    return Ok(true);
}

/// The table's record and current metadata; NotFound if it has none (made through the S3 Tables API, with no
/// metadata file yet).
fn currentTable(
    store: borrow ObjectStore,
    bucket: Slice<u8>,
    ns: Slice<u8>,
    name: Slice<u8>,
) -> Result<CatalogRecord?, TablesError> {
    let hidden = tableWarehouseBucket(bucket)?;
    let key = catalogKey(CATALOG_TABLES, ns, name)?;
    return readRecord(store, hidden.view(), key.view());
}

fn icebergCommit(
    store: borrow mut ObjectStore,
    bucket: Slice<u8>,
    ns: Slice<u8>,
    name: Slice<u8>,
    body: Slice<u8>,
    sealing: borrow WarehouseKeys,
) -> Result<TablesAnswer, TablesError> {
    let request = match (parseJson(body)?) {
        Some(j) => j,
        null => { return badRequest("The body is not JSON."); }
    };
    // An identifier given names this table (the path's).
    match (jsonMember(borrow request, "identifier")) {
        Some(ident) => {
            let same = match (singleNamespace(ident)) {
                Ok(n) => n.view() == ns && jsonMemberText(ident, "name") == Some(name),
                Err(_) => false,
            };
            if (!same) { return badRequest("The commit's identifier is not the table of its path."); }
        }
        null => {}
    }
    let hidden = tableWarehouseBucket(bucket)?;
    var rec = match (currentTable(store, bucket, ns, name)?) {
        Some(r) => r,
        null => { return noSuchTable(); } // a create's commit is `icebergTable`'s, authorized as a create
    };
    let previous = copyBytes(jsonMemberText(borrow rec.json, "metadataLocation") ?? "".bytes())?;
    if (previous.length == 0) { return noSuchTable(); }
    let id = copyBytes(jsonMemberText(borrow rec.json, "id") ?? "".bytes())?;
    var m = readMetadataWith(store, hidden.view(), previous.view(), sealing)?;
    let requirements = match (jsonMember(borrow request, "requirements")) {
        Some(r) => cloneJson(r)?,
        null => jsonArray(),
    };
    match (checkRequirements(borrow m, borrow requirements)?) {
        Some(CommitRefusal.Requirement) => {
            return icebergError(409, "CommitFailedException", "A requirement of the commit does not hold.");
        }
        Some(CommitRefusal.Update) => { return badRequest("A requirement is not one this catalog knows."); }
        null => {}
    }
    let updates = match (jsonMember(borrow request, "updates")) {
        Some(u) => cloneJson(u)?,
        null => jsonArray(),
    };
    // A commit that changes nothing writes no file: the table is as it was (as Iceberg's own catalogs answer).
    if (arrayLength(borrow request, "updates") == 0) {
        match (borrow updates) {
            Json.Array(_) => { return loadResult(previous.view(), m); }
            _ => {}
        }
    }
    let previousStamp = jsonMemberI64(borrow m, "last-updated-ms") ?? 0;
    let warehouse = warehouseOf(bucket, id.view())?;
    match (applyUpdates(mut m, borrow updates, warehouse.view())?) {
        Some(_) => { return badRequest("An update is not valid here, or not one this catalog applies."); }
        null => {}
    }
    let key = catalogKey(CATALOG_TABLES, ns, name)?;
    let location = match (swapMetadata(
        store,
        hidden.view(),
        id.view(),
        key.view(),
        mut rec,
        previous.view(),
        mut m,
        previousStamp,
        sealing,
    )?) {
        Some(l) => l,
        null => { return icebergError(409, "CommitFailedException", "The table changed since it was read."); }
    };
    var j = jsonObject();
    jsonSet(mut j, "metadata-location", jsonString(location.view())?)?;
    jsonSet(mut j, "metadata", m)?;
    return tablesJson(borrow j);
}

fn icebergTable(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    bucket: Slice<u8>,
    ns: Slice<u8>,
    name: Slice<u8>,
    body: Slice<u8>,
    caller: borrow TablesCaller,
    sealing: borrow WarehouseKeys,
) -> Result<TablesAnswer, TablesError> {
    let m = req.method;
    let hidden = tableWarehouseBucket(bucket)?;
    if (!namespaceExists(store, hidden.view(), ns)?) { return noSuchNamespace(); }
    let rec = match (currentTable(store, bucket, ns, name)?) {
        Some(r) => r,
        null => {
            // A staged create's commit makes the table (ADR-0124), authorized as the create it is; any other call to a
            // table not there is answered as such, before any authorization (the M29 exit review's L1, L2).
            if (isMethod(m, Method.Post)) {
                let request = match (parseJson(body)?) {
                    Some(j) => j,
                    null => { return badRequest("The body is not JSON."); }
                };
                if (createsOnly(jsonMember(borrow request, "requirements"))) {
                    checkTables(store, caller, "s3tables:CreateTable", bucket, "".bytes())?;
                    return icebergCommitCreate(store, bucket, ns, name, borrow request, sealing);
                }
            }
            return noSuchTable();
        }
    };
    // A commit is UpdateTableMetadataLocation; a load and HEAD GetTableMetadataLocation; a drop DeleteTable.
    let action = if (isMethod(m, Method.Post)) "s3tables:UpdateTableMetadataLocation"
        else if (isMethod(m, Method.Delete)) "s3tables:DeleteTable"
        else "s3tables:GetTableMetadataLocation";
    checkTables(store, caller, action, bucket, jsonMemberText(borrow rec.json, "id") ?? "".bytes())?;
    if (isMethod(m, Method.Post)) { return icebergCommit(store, bucket, ns, name, body, sealing); }
    if (isMethod(m, Method.Head)) { return Ok(tablesNoContent()); }
    if (isMethod(m, Method.Get)) {
        let location = copyBytes(jsonMemberText(borrow rec.json, "metadataLocation") ?? "".bytes())?;
        if (location.length == 0) { return noSuchTable(); }
        let metadata = readMetadataWith(store, hidden.view(), location.view(), sealing)?;
        return loadResult(location.view(), metadata);
    }
    if (isMethod(m, Method.Delete)) {
        // As S3 Tables: a drop purges, so it is asked for.
        let purge = paramOf(req, "purgeRequested") ?? "".bytes();
        if (!equalsIgnoreCase(purge, "true".bytes())) {
            return badRequest("A table is dropped with its files here: purgeRequested=true.");
        }
        return match (deleteTable(store, req, bucket, ns, name)) {
            Ok(a) => Ok(a),
            Err(TablesError.NotFound) => noSuchTable(),
            Err(e) => Err(e),
        };
    }
    return icebergUnsupported();
}

fn icebergRename(
    store: borrow mut ObjectStore,
    bucket: Slice<u8>,
    body: Slice<u8>,
    caller: borrow TablesCaller,
) -> Result<TablesAnswer, TablesError> {
    let j = match (parseJson(body)?) {
        Some(j) => j,
        null => { return badRequest("The body is not JSON."); }
    };
    var from = Vector<Vector<u8>>.create();
    for (side in ["source", "destination"]) {
        let ident = match (jsonMember(borrow j, side)) {
            Some(i) => i,
            null => { return badRequest("A rename names its source and destination."); }
        };
        let ns = match (singleNamespace(ident)) {
            Ok(n) => n,
            Err(_) => { return badRequest("A namespace is one level here."); }
        };
        from.push(ns)?;
        from.push(copyBytes(jsonMemberText(ident, "name") ?? "".bytes())?)?;
    }
    // RenameTable on the source table (ADR-0084 §3).
    match (tableIdOf(store, bucket, from[0].view(), from[1].view())) {
        Ok(id) => { checkTables(store, caller, "s3tables:RenameTable", bucket, id.view())?; }
        Err(TablesError.NotFound) => { return noSuchTable(); }
        Err(e) => { return Err(e); }
    }
    // A destination namespace that is not there is NoSuchNamespace (the spec's), not a missing table.
    let hidden = tableWarehouseBucket(bucket)?;
    if (!namespaceExists(store, hidden.view(), from[2].view())?) { return noSuchNamespace(); }
    var rename = jsonObject();
    jsonSet(mut rename, "newNamespaceName", jsonString(from[2].view())?)?;
    jsonSet(mut rename, "newName", jsonString(from[3].view())?)?;
    var request = Vector<u8>.create();
    writeJson(mut request, borrow rename)?;
    return match (renameTable(store, bucket, from[0].view(), from[1].view(), request.view())) {
        Ok(a) => Ok(a),
        Err(TablesError.NotFound) => noSuchTable(),
        Err(TablesError.Conflict) => icebergError(409, "AlreadyExistsException", "The destination table exists."),
        Err(TablesError.BadRequest) => badRequest("A name is not valid."),
        Err(e) => Err(e),
    };
}

/// `/iceberg/v1/…` (`segs` after `iceberg`).
fn icebergRoute(
    store: borrow mut ObjectStore,
    req: borrow S3Request,
    segs: Slice<Vector<u8>>,
    body: Slice<u8>,
    caller: borrow TablesCaller,
    sealing: borrow WarehouseKeys,
) -> Result<TablesAnswer, TablesError> {
    let m = req.method;
    if (segs.length < 2 || segs[0].view() != "v1".bytes()) { return icebergUnsupported(); }
    if (segs.length == 2 && segs[1].view() == "config".bytes() && isMethod(m, Method.Get)) {
        return icebergConfig(store, req, caller);
    }
    var none = Vector<u8>.create();
    let bucket = match (tableBucketOfArn(segs[1].view(), mut none)?) {
        Some(b) => b,
        null => { return badRequest("The prefix must be a table bucket's ARN."); }
    };
    match (tableBucketRecord(store, bucket.view())) {
        Ok(_) => {}
        Err(TablesError.NotFound) => { return icebergError(404, "NoSuchWarehouseException", "No such table bucket."); }
        Err(e) => { return Err(e); }
    }
    // Each call is authorized as the S3 Tables call it is (ADR-0084 §3); a refusal is 403 in Iceberg's shape.
    let b = bucket.view();
    let rest = segs[2..];
    if (rest.length == 2 && rest[0].view() == "tables".bytes() && rest[1].view() == "rename".bytes() &&
        isMethod(m, Method.Post)) {
        return icebergRename(store, b, body, caller);
    }
    if (rest.length == 0 || rest[0].view() != "namespaces".bytes()) { return icebergUnsupported(); }
    if (rest.length == 1) {
        if (isMethod(m, Method.Get)) {
            checkTables(store, caller, "s3tables:ListNamespaces", b, "".bytes())?;
            return icebergListNamespaces(store, req, b);
        }
        if (isMethod(m, Method.Post)) {
            checkTables(store, caller, "s3tables:CreateNamespace", b, "".bytes())?;
            return icebergCreateNamespace(store, b, body);
        }
        return icebergUnsupported();
    }
    // A multi-level namespace (its parts joined by 0x1F) is not one here.
    let ns = rest[1].view();
    if (findBytes(ns, [0x1Fu8][..], 0).isSome()) { return noSuchNamespace(); }
    if (rest.length == 2) {
        let action = if (isMethod(m, Method.Delete)) "s3tables:DeleteNamespace" else "s3tables:GetNamespace";
        checkTables(store, caller, action, b, "".bytes())?;
        return icebergNamespace(store, m, b, ns);
    }
    if (rest[2].view() != "tables".bytes()) { return icebergUnsupported(); }
    if (rest.length == 3) {
        if (isMethod(m, Method.Get)) {
            checkTables(store, caller, "s3tables:ListTables", b, "".bytes())?;
            return icebergListTables(store, b, ns);
        }
        if (isMethod(m, Method.Post)) {
            checkTables(store, caller, "s3tables:CreateTable", b, "".bytes())?;
            return icebergCreateTable(store, b, ns, body, sealing);
        }
        return icebergUnsupported();
    }
    if (rest.length == 4) { return icebergTable(store, req, b, ns, rest[3].view(), body, caller, sealing); }
    return icebergUnsupported();
}
