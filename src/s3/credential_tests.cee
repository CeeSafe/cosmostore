// Credential rotation (ADR-0050): the set that follows a reload of the credentials file, and the sets a server holds.
import web_core;
import web_http;
import web_server;

fn credentialsOf(text: StringView) -> Vector<Credential> => parseCredentials(text.bytes())!;

/// A set as text: `key=secret` for each, `key!` for a revoked one.
fn setText(set: Slice<Credential>) -> Vector<u8> {
    var out = Vector<u8>.create();
    for (i in 0..set.length) {
        if (i > 0) { out.push(' ')!; }
        out.extend(set[i].accessKey.view())!;
        if (set[i].revoked) {
            out.push('!')!;
        } else {
            out.push('=')!;
            out.extend(set[i].secret.view())!;
        }
    }
    return out;
}

@test
fn credentialsAfterAReload() -> Result<void, TestFailure> {
    let first = credentialsOf("A s1\nB s2\nC s3\n");
    Check.equalBytes("A=s1 B=s2 C=s3".bytes(), setText(first.view()).view())?;
    // The same file: the same set.
    let same = nextCredentials(first.view(), credentialsOf("# again\nA s1\nB s2\nC s3\n").view())!;
    Check.isTrue(sameCredentials(first.view(), same.view()), "nothing changed")?;
    // A secret changed, a key gone, a key new, the file's order different: every old key keeps its place.
    let second = nextCredentials(first.view(), credentialsOf("D s4\nC s3\nA new\n").view())!;
    Check.equalBytes("A=new B! C=s3 D=s4".bytes(), setText(second.view()).view())?;
    Check.isTrue(!sameCredentials(first.view(), second.view()), "it changed")?;
    Check.equalU64(0, second[1].secret.length as u64)?; // a revoked key's secret is not kept
    // A revoked key comes back, in its place; a key twice in the file has its first secret.
    let third = nextCredentials(second.view(), credentialsOf("B back\nB other\nA new\n").view())!;
    Check.equalBytes("A=new B=back C! D!".bytes(), setText(third.view()).view())?;
    Check.isTrue(!sameCredentials(second.view(), third.view()), "a key back")?;
    // A secret alone differs.
    let fourth = nextCredentials(third.view(), credentialsOf("B back\nA newer\n").view())!;
    Check.isTrue(!sameCredentials(third.view(), fourth.view()), "a secret changed")?;
    // A revoked key is no principal a policy may name, and signs nothing.
    Check.isTrue(configuredKey(third.view(), "A".bytes()), "a key in use")?;
    Check.isTrue(!configuredKey(third.view(), "C".bytes()), "a revoked key")?;
    return Ok();
}

@test
fn credentialSetsAreReplaced() -> Result<void, TestFailure> {
    let sets = CredentialSets.create(credentialsOf("A s1\n"))!;
    Check.equalBytes("A=s1".bytes(), setText(sets.view()).view())?;
    let before = sets.view(); // a request under way keeps the set it read
    Check.isTrue(sets.replace(nextCredentials(sets.view(), credentialsOf("B s2\n").view())!), "a reload")?;
    Check.equalBytes("A! B=s2".bytes(), setText(sets.view()).view())?;
    Check.equalBytes("A=s1".bytes(), setText(before).view())?;
    // Every cell is used once: after the last, a reload is refused and the set stays.
    for (i in 2..MAX_CREDENTIAL_SETS) {
        Check.isTrue(sets.replace(credentialsOf("A s1\n")), "another reload")?;
    }
    Check.isTrue(!sets.replace(credentialsOf("Z last\n")), "no cell left")?;
    Check.equalBytes("A=s1".bytes(), setText(sets.view()).view())?;
    return Ok();
}
