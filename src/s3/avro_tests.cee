// The Avro reader (ADR-0086 §4) against PyIceberg's own manifests (avro_fixtures.cee): their records read, the paths
// they name found; files that are not Avro, or of a codec not taken, refused.

fn fixtureBytes(chunks: Slice<StringView>) -> Vector<u8> {
    var out = Vector<u8>.create();
    for (c in chunks) { out.extend(hexToBytes(c).view())!; }
    return out;
}

fn avroMetadataValue<region a>(f: borrow(a) AvroFile, key: StringView) -> Slice<a, u8>? {
    for (i in 0..f.metadata.length) {
        if (f.metadata[i].key.view() == key.bytes()) {
            return match (borrow f.metadata[i].value) {
                Json.Text(t) => Some(t.view()),
                _ => null,
            };
        }
    }
    return null;
}

@test
fn avroReadsIcebergManifests() -> Result<void, TestFailure> {
    let listBytes = fixtureBytes(AVRO_FIXTURE_LIST[..]);
    let list = readAvro(listBytes.view())!;
    Check.equalBytes("deflate".bytes(), avroMetadataValue(borrow list, "avro.codec")!)?;
    Check.equalU64(AVRO_FIXTURE_LIST_ENTRIES.length as u64, list.records.length as u64)?;
    for (i in 0..list.records.length) {
        Check.equalBytes(
            AVRO_FIXTURE_LIST_ENTRIES[i].bytes(),
            jsonMemberText(borrow list.records[i], "manifest_path")!,
        )?;
        Check.isTrue(jsonMemberI64(borrow list.records[i], "added_snapshot_id").isSome(), "a 64-bit id")?;
    }
    let manifestBytes = fixtureBytes(AVRO_FIXTURE_MANIFEST[..]);
    let manifest = readAvro(manifestBytes.view())!;
    Check.equalU64(AVRO_FIXTURE_DATA_FILES.length as u64, manifest.records.length as u64)?;
    for (i in 0..manifest.records.length) {
        let entry = borrow manifest.records[i];
        let dataFile = jsonMember(entry, "data_file")!;
        Check.equalBytes(AVRO_FIXTURE_DATA_FILES[i].bytes(), jsonMemberText(dataFile, "file_path")!)?;
        Check.isTrue(jsonMemberI64(entry, "status").isSome(), "its status")?;
    }
    return Ok();
}

fn avroRefusal(bytes: Slice<u8>) -> StringView => match (readAvro(bytes)) {
    Ok(_) => "read",
    Err(AvroError.Malformed) => "malformed",
    Err(AvroError.Codec(_)) => "codec",
    Err(AvroError.OutOfMemory(_)) => "memory",
};

@test
fn avroRefusals() -> Result<void, TestFailure> {
    let good = fixtureBytes(AVRO_FIXTURE_LIST[..]);
    var notAvro = copyBytes(good.view())!;
    notAvro[3] = 2;
    Check.equalBytes("malformed".bytes(), avroRefusal(notAvro.view()).bytes())?;
    // A byte of the compressed block changed: the stream, its records or the sync after it no longer read.
    var damaged = copyBytes(good.view())!;
    let at = damaged.length - 40;
    damaged[at] = damaged[at] ^ 0x55;
    Check.equalBytes("malformed".bytes(), avroRefusal(damaged.view()).bytes())?;
    // Cut short.
    Check.equalBytes("malformed".bytes(), avroRefusal(good.view()[0..good.length - 5]).bytes())?;
    Check.equalBytes("malformed".bytes(), avroRefusal("".bytes()).bytes())?;
    // Another codec: named, not guessed at.
    var other = copyBytes(good.view())!;
    match (findBytes(other.view(), "deflate".bytes(), 0)) {
        Some(p) => {
            let z = "zstdard".bytes();
            for (i in 0..z.length) { other[p + i] = z[i]; }
        }
        null => { return Check.fail("the fixture names its codec"); }
    }
    match (readAvro(other.view())) {
        Err(AvroError.Codec(name)) => { Check.equalBytes("zstdard".bytes(), name.view())?; }
        _ => { return Check.fail("a codec not taken is named"); }
    }
    return Ok();
}

/// Avro's zig-zag varint of `v`.
fn zigzag(out: borrow mut Vector<u8>, v: i64) {
    var u: u64 = if (v < 0) ((truncate<u64>(-(v + 1))) << 1) | 1 else truncate<u64>(v) << 1;
    while (true) {
        let b = truncate<u8>(u & 0x7F);
        u >>= 7;
        if (u == 0) {
            out.push(b)!;
            return;
        }
        out.push(b | 0x80)!;
    }
}

fn lengthPrefixed(out: borrow mut Vector<u8>, text: Slice<u8>) {
    zigzag(out, truncate<i64>(text.length));
    out.extend(text)!;
}

/// An object container file of `schema`, codec null: its header (one metadata entry), then one block of `count`
/// records whose bytes are `block`.
fn avroContainer(schema: StringView, count: i64, block: Slice<u8>) -> Vector<u8> {
    var out = copyBytes([0x4Fu8, 0x62, 0x6A, 0x01][..])!;
    zigzag(mut out, 1);
    lengthPrefixed(mut out, "avro.schema".bytes());
    lengthPrefixed(mut out, schema.bytes());
    zigzag(mut out, 0);
    let sync = [7u8; 16];
    out.extend(sync[..])!;
    zigzag(mut out, count);
    zigzag(mut out, truncate<i64>(block.length));
    out.extend(block)!;
    out.extend(sync[..])!;
    return out;
}

@test
fn avroRefusesHostileCounts() -> Result<void, TestFailure> {
    // A well-formed one reads: two records of a long each.
    var two = Vector<u8>.create();
    zigzag(mut two, 5);
    zigzag(mut two, -6);
    Check.equalU64(2, readAvro(avroContainer("\"long\"", 2, two.view()).view())!.records.length as u64)?;
    // i64's least as a metadata count: refused, not negated (M10's exit review, B1).
    var least = copyBytes([0x4Fu8, 0x62, 0x6A, 0x01][..])!;
    least.extend([0xFFu8, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x01][..])!;
    least.extend([0u8; 40][..])!;
    Check.equalBytes("malformed".bytes(), avroRefusal(least.view()).bytes())?;
    // The same as an array's block count.
    var arrayMin = Vector<u8>.create();
    arrayMin.extend([0xFFu8, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x01][..])!;
    arrayMin.extend([0u8; 8][..])!;
    Check.equalBytes(
        "malformed".bytes(),
        avroRefusal(avroContainer("{\"type\":\"array\",\"items\":\"long\"}", 1, arrayMin.view()).view()).bytes(),
    )?;
    // A million records of no bytes each (B2): refused, not decoded.
    Check.equalBytes("malformed".bytes(), avroRefusal(avroContainer("\"null\"", 1048576, [0u8][..]).view()).bytes())?;
    // An array claiming more items than its bytes.
    var big = Vector<u8>.create();
    zigzag(mut big, 1000000);
    zigzag(mut big, 1);
    Check.equalBytes(
        "malformed".bytes(),
        avroRefusal(avroContainer("{\"type\":\"array\",\"items\":\"long\"}", 1, big.view()).view()).bytes(),
    )?;
    // An int past 32 bits, and a varint whose 10th byte holds more than the 64th bit.
    var wide = Vector<u8>.create();
    zigzag(mut wide, 4294967296);
    Check.equalBytes("malformed".bytes(), avroRefusal(avroContainer("\"int\"", 1, wide.view()).view()).bytes())?;
    let tenth = [0x80u8, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x02];
    Check.equalBytes("malformed".bytes(), avroRefusal(avroContainer("\"long\"", 1, tenth[..]).view()).bytes())?;
    // A type wrapped as `{"type": {…}}` reads as the type it wraps.
    var one = Vector<u8>.create();
    zigzag(mut one, 9);
    let wrapped = avroContainer("{\"type\":{\"type\":\"long\"}}", 1, one.view());
    let read = readAvro(wrapped.view())!;
    Check.isTrue(jsonI64(borrow read.records[0]) == Some(9i64), "a wrapped type")?;
    return Ok();
}

/// The writer (ADR-0098 §3): PyIceberg's manifest list and manifest, read, written back (null codec) and read again,
/// give the same records and metadata; a record that does not fit its schema is refused.
@test
fn avroFilesWrittenBackReadTheSame() -> Result<void, TestFailure> {
    let dir = scratchDirectory("avro-written");
    var which = 0;
    for (rows in [AVRO_FIXTURE_LIST[..], AVRO_FIXTURE_MANIFEST[..]]) {
        let bytes = fixtureBytes(rows);
        let first = readAvro(bytes.view()).ok() ?? { return Check.fail("the fixture reads"); };
        let written = writeAvro(first.metadata.view(), first.records.view())!!;
        let again = readAvro(written.view()).ok() ?? { return Check.fail("the written file reads"); };
        Check.equalU64(first.records.length as u64, again.records.length as u64)?;
        for (i in 0..first.records.length) {
            var a = Vector<u8>.create();
            var b = Vector<u8>.create();
            writeJson(mut a, borrow first.records[i])!;
            writeJson(mut b, borrow again.records[i])!;
            Check.equalBytes(a.view(), b.view())?;
        }
        for (i in 0..first.metadata.length) {
            if (first.metadata[i].key.view() == "avro.codec".bytes()) { continue; }
            var found = false;
            for (j in 0..again.metadata.length) {
                if (again.metadata[j].key.view() == first.metadata[i].key.view()) {
                    var a = Vector<u8>.create();
                    var b = Vector<u8>.create();
                    writeJson(mut a, borrow first.metadata[i].value)!;
                    writeJson(mut b, borrow again.metadata[j].value)!;
                    Check.equalBytes(a.view(), b.view())?;
                    found = true;
                }
            }
            Check.isTrue(found, "a metadata entry written back")?;
        }
        // For PyIceberg to read (ADR-0098 slice 2's check).
        var path = textOf(dir.view());
        path.append(if (which == 0) "/list.avro" else "/manifest.avro")!;
        DurableFile.createNew(path.view())!.writeAt(written.view(), 0)!;
        which += 1;
    }
    // A record that does not fit: a manifest list's record with its path a number.
    let list = readAvro(fixtureBytes(AVRO_FIXTURE_LIST[..]).view()).ok()!;
    var broken = Vector<Json>.create();
    var record = cloneJson(borrow list.records[0])!;
    match (borrow mut record) {
        Json.Object(members) => {
            for (i in 0..members.length) {
                if (members[i].key.view() == "manifest_path".bytes()) { members[i].value = jsonInteger(7)!; }
            }
        }
        _ => {}
    }
    broken.push(record)!;
    Check.isTrue(writeAvro(list.metadata.view(), broken.view())!.isNull(), "a record that does not fit")?;
    return Ok();
}
