// A cluster shard's replica (ADR-0058, M6 item 2 slice c): the store over a Raft log, the Raft core, and the hard
// state file. It is the core's host: it persists entries in the journal, saves the term and vote, attaches entries
// to appends from the journal, and applies committed entries to the store. A leader takes one write at a time:
// `beginWrite`, then the store's own calls (which stage and persist entries of its term without applying them), then
// `finishWrite`, which proposes them; the write is acknowledged once the leader has applied it (`isApplied`). The
// next write waits for that, so its checks see every earlier one (ADR-0058 §8; pipelining is later work).
//
// Slice d: each replica checkpoints its applied state on its own, and its core then forgets the entries the
// checkpoint holds; the leader compacts by proposing Relocate entries, and a follower removes the segments its
// checkpoint covers that hold nothing live (`maintain`). A follower behind the leader's checkpoint gets a snapshot: the
// leader's checkpoint and segments, which it installs as its store's next generation (`snapshot.cee`).
//
// The replica's directory: `raft-state.*` (term and vote), `store-generation.*` (which store directory is current),
// and `store-<16 hex>` (the store of that generation).
//
// The store is not the replica's (ADR-0060 §1): it is passed to everything that uses it, so a node can keep it behind
// the lock its shard's S3 server takes. A node locks the replica, then the store, never the other way round.

struct ReplicaConfig {
    id: u32;
    /// The group's configuration as it begins, before any Config record (ADR-0062).
    voters: Vector<u32>;
    learners: Vector<u32>;
    electionTicks: u32;
    heartbeatTicks: u32;
    maxAppendEntries: usize;
    seed: u64;
    store: StoreConfig;
}

/// A replica just opened, and its store.
struct OpenedReplica {
    replica: ShardReplica;
    store: ObjectStore;
}

struct ShardReplica {
    id: u32;
    core: RaftCore;
    private hard: HardStateFile;
    private generation: HardStateFile;
    private dir: String;
    private storeConfig: StoreConfig;
    /// Snapshots installed, for tests and stats.
    snapshotsInstalled: u64;
    /// Reads a quorum has confirmed: serve each once the store has applied its index.
    reads: Vector<RaftReadState>;

    /// Opens the replica in `dir`: the store (its journal a Raft log), the hard state, and a core holding the terms
    /// of the entries recovery found unapplied.
    fn open(dir: StringView, config: ReplicaConfig) -> Result<OpenedReplica, StoreError> {
        var storeConfig = config.store;
        storeConfig.journal.raftLog = true;
        let hard = sio(HardStateFile.open(dir))?;
        let generation = sio(HardStateFile.openNamed(dir, "store-generation"))?;
        let current = storeDirectory(dir, generation.term)?;
        removeOtherStores(dir, current.view())?;
        sio(Fs.ensureDirectory(current.view()))?;
        var store = ObjectStore.open(current.view(), storeConfig)?;
        store.setNodeId(config.id); // whose piece of a coded extent it holds (ADR-0064)
        let terms = store.takeRecoveredTerms();
        let configs = store.takeRecoveredConfigs();
        // The core starts at the store's checkpoint, which holds every entry up to it, and its configuration (or,
        // before any Config record, the group the replica was made with: ADR-0062 §2).
        let snapIndex = store.checkpointIndex();
        let snapTerm = store.checkpointEntryTerm();
        let base = match (decodeMembership(store.membershipBytes())) {
            Some(m) => m,
            null => RaftMembership { voters: config.voters, learners: config.learners },
        };
        var core = RaftCore.restore(
            RaftConfig {
                id: config.id,
                voters: base.voters,
                learners: base.learners,
                electionTicks: config.electionTicks,
                heartbeatTicks: config.heartbeatTicks,
                maxAppendEntries: config.maxAppendEntries,
                seed: config.seed,
            },
            RaftHardState { term: hard.term, vote: hard.vote, commit: 0 },
            snapIndex,
            snapTerm,
            terms,
        )?;
        // The configuration entries after the checkpoint, in order: the last is in force (ADR-0062 §1).
        for (k in 0..configs.length) {
            match (decodeMembership(configs[k].membership.view())) {
                Some(m) => { core.noteConfig(configs[k].index, m)?; }
                null => { return Err(StoreError.BadMeta(0, configs[k].index)); }
            }
        }
        var d = String.create();
        d.append(dir)?;
        let replica = ShardReplica {
            id: config.id,
            core: core,
            hard: hard,
            generation: generation,
            dir: d,
            storeConfig: storeConfig,
            snapshotsInstalled: 0,
            reads: Vector<RaftReadState>.create(),
        };
        return Ok(OpenedReplica { replica: replica, store: store });
    }

    /// Upkeep: a checkpoint when one is due, after which the core forgets what it holds; then compaction, the
    /// leader's as a write of Relocate entries (when no write is in flight), a follower's removing dead segments.
    fn maintain(borrow mut this, store: borrow mut ObjectStore) -> Result<void, StoreError> {
        if (store.checkpointDue() && store.checkpoint()?) { this.core.compact(store.checkpointIndex()); }
        if (this.core.isLeader()) {
            match (this.beginWrite(store)) {
                Ok(before) => {
                    let _ = store.compact(store.compactionBudget())?;
                    let _ = this.finishWrite(store, before)?;
                }
                Err(_) => {}
            }
        } else {
            let _ = store.compact(0)?;
        }
        // Lifecycle rules (the M12 exit review's A3): the leader applies them, as a write, so the deletes, aborts and
        // transitions are entries every replica applies; a follower's would be its own.
        let now = Clock.unixMillis();
        if (this.core.isLeader() && store.lifecycleDue(now)) {
            match (this.beginWrite(store)) {
                Ok(before) => {
                    // What a run persisted is proposed even if it stopped partway, so the journal and the core
                    // agree; a run that failed is tried again at the next upkeep.
                    let ran = store.applyLifecycleNoted(now);
                    let _ = this.finishWrite(store, before)?;
                    match (ran) {
                        Ok(_) => {}
                        Err(StoreError.NotLeader) => {}
                        Err(e) => { return Err(e); }
                    }
                }
                Err(_) => {}
            }
        }
        // Extents no one names any more, and none of the unapplied entries (ADR-0061 §4); whole copies of coded
        // extents decoded for reads an hour ago (ADR-0064 §5).
        let _ = store.sweepRaftOrphans(Clock.unixMillis())?;
        let _ = store.sweepDecoded(Clock.unixMillis())?;
        return Ok();
    }

    /// Installs a leader's snapshot as the store's next generation (snapshot.cee).
    fn installSnapshot(
        borrow mut this,
        store: borrow mut ObjectStore,
        s: borrow RaftSnapshot,
    ) -> Result<void, StoreError> {
        let next = this.generation.term + 1;
        let target = storeDirectory(this.dir.view(), next)?;
        removeStoreDirectory(target.view())?; // a leftover of an install that crashed before its switch
        sio(Fs.ensureDirectory(target.view()))?;
        writeSnapshotBundle(target.view(), s.data.view(), s.index, s.term)?;
        sio(this.generation.save(next, 0))?;
        let old = storeDirectory(this.dir.view(), next - 1)?;
        var installed = ObjectStore.open(target.view(), this.storeConfig)?;
        installed.setNodeId(this.id);
        let _ = installed.takeRecoveredTerms();
        if (installed.appliedIndex() != s.index) { return Err(StoreError.CheckpointCorrupt); }
        // The configuration the snapshot's checkpoint holds.
        match (decodeMembership(installed.membershipBytes())) {
            Some(m) => { this.core.installMembership(m)?; }
            null => {}
        }
        *store = installed;
        removeStoreDirectory(old.view())?;
        this.snapshotsInstalled += 1;
        return Ok();
    }

    fn isLeader(borrow this) -> bool => this.core.isLeader();

    /// Proposes a change of the group (ADR-0062 §1): its entry's index, or null when the core refuses it.
    fn changeMembers(borrow mut this, m: RaftMembership) -> Result<u64?, StoreError> {
        return Ok(this.core.proposeConfig(m)?);
    }

    /// Before a write: the index of the last entry, or NotLeader when this replica does not lead or an earlier write
    /// is not applied yet.
    fn beginWrite(borrow this, store: borrow ObjectStore) -> Result<u64, StoreError> {
        if (!this.core.isLeader()) { return Err(StoreError.NotLeader); }
        let last = store.lastEntry();
        if (last != this.core.lastIndex() || store.appliedIndex() != last) { return Err(StoreError.NotLeader); }
        return Ok(last);
    }

    /// After a write: proposes the entries it staged and persisted; the last one's index, which the write is
    /// acknowledged at. Null when it staged nothing.
    fn finishWrite(borrow mut this, store: borrow mut ObjectStore, before: u64) -> Result<u64?, StoreError> {
        // Some of the store's calls stage without committing (group commit's deferred writes): persist them first.
        store.persistEntries()?;
        let last = store.lastEntry();
        var index = before + 1;
        while (index <= last) {
            // The entry is in the journal already: the core keeps its term, the host its data.
            match (this.core.propose(Vector<u8>.create())?) {
                Some(i) => {
                    if (i != index) { panic("replica: the core and the journal disagree on an index"); }
                }
                null => { return Err(StoreError.NotLeader); }
            }
            index += 1;
        }
        if (last == before) { return Ok(null); }
        return Ok(Some(last));
    }

    /// Whether the entry at `index` is applied here: on the leader, that a write is acknowledged.
    /// A message from another replica of the shard.
    fn step(borrow mut this, m: RaftMessage) -> Result<void, StoreError> {
        this.core.step(m)?;
        return Ok();
    }

    fn tick(borrow mut this) -> Result<void, StoreError> {
        this.core.tick()?;
        return Ok();
    }

    /// Does what the core asks (raft.cee's contract), and puts the messages to send in `out`.
    fn drain(
        borrow mut this,
        store: borrow mut ObjectStore,
        out: borrow mut Vector<RaftMessage>,
    ) -> Result<void, StoreError> {
        while (this.core.hasReady()) {
            var ready = this.core.ready()?;
            // 0. A snapshot replaces the store; the core already starts after it.
            match (replace(mut ready.snapshot, null)) {
                Some(s) => { this.installSnapshot(store, borrow s)?; }
                null => {}
            }
            // 1. Entries: the leader's own are in the journal already; a follower's are the leader's records. One
            // whose index the journal has with another term starts a suffix to cut off.
            if (ready.entries.length > 0) {
                var entries = replace(mut ready.entries, Vector<RaftEntry>.create());
                reverseEntries(mut entries);
                var staged = false;
                while (true) {
                    let e = match (entries.pop()) {
                        Some(e) => e,
                        null => { break; }
                    };
                    if (e.index <= store.lastEntry()) {
                        if (store.entryTerm(e.index)? == e.term) { continue; }
                        store.truncateEntries(e.index - 1)?;
                    }
                    if (e.config) {
                        // The leader's configuration entry, made by its core: a Config record.
                        store.appendConfig(e.term, e.data.view())?;
                    } else if (e.data.length == 0) {
                        store.appendNoop(e.term)?;
                    } else {
                        store.appendEntry(e.data.view())?;
                        // Another leader's Config record: in force once persisted (ADR-0062 §1).
                        match (configOfRecord(e.data.view())) {
                            Some(m) => { this.core.noteConfig(e.index, m)?; }
                            null => {}
                        }
                    }
                    staged = true;
                }
                if (staged) { store.persistEntries()?; }
            }
            // 2. The term and vote, synced before anything that depends on them is sent.
            match (replace(mut ready.hardState, null)) {
                Some(h) => {
                    if (h.term != this.hard.term || h.vote != this.hard.vote) { sio(this.hard.save(h.term, h.vote))?; }
                }
                null => {}
            }
            // 3. Messages, appends with their entries read from the journal.
            var messages = replace(mut ready.messages, Vector<RaftMessage>.create());
            reverseMessages(mut messages);
            while (true) {
                var m = match (messages.pop()) {
                    Some(m) => m,
                    null => { break; }
                };
                if (m.kind == RAFT_SNAPSHOT) {
                    // The core compacts only to the store's checkpoints, so the snapshot it names is the newest.
                    if (m.index != store.checkpointIndex()) {
                        panic("replica: a snapshot that is not the checkpoint");
                    }
                    m.data = store.snapshotBundle()?;
                }
                if (m.kind == RAFT_APPEND) {
                    var i = m.index + 1;
                    while (i <= m.index + m.count) {
                        let data = store.entryBytes(i)?;
                        let term = store.entryTerm(i)?;
                        m.entries.push(RaftEntry { term: term, index: i, data: data, config: false })?;
                        i += 1;
                    }
                    m.count = 0;
                }
                out.push(m)?;
            }
            // 4. Committed entries, applied from the journal.
            if (ready.applyFrom <= ready.applyTo) { store.applyEntries(ready.applyFrom, ready.applyTo)?; }
            for (k in 0..ready.reads.length) {
                this.reads.push(RaftReadState { id: ready.reads[k].id, index: ready.reads[k].index })?;
            }
            this.core.advance();
            store.setLeaderTerm(if (this.core.isLeader()) this.core.term else 0);
        }
        return Ok();
    }
}

/// Removes the store directories of `dir` other than `current`: the old generation of a snapshot install that crashed
/// after its switch, or the new one of one that crashed before it.
fn removeOtherStores(dir: StringView, current: StringView) -> Result<void, StoreError> {
    let names = match (Directory.list(dir)) {
        Ok(n) => n,
        Err(_) => { return Ok(); }
    };
    for (i in 0..names.length) {
        let name = names[i].view();
        if (!(name.length == 22 && name.startsWith("store-"))) { continue; }
        var path = String.create();
        path.append(dir)?;
        path.append("/")?;
        path.append(name)?;
        if (path.view() != current) { removeStoreDirectory(path.view())?; }
    }
    return Ok();
}

fn reverseMessages(v: borrow mut Vector<RaftMessage>) {
    if (v.length < 2) { return; }
    var i = 0usize;
    var j = v.length - 1;
    while (i < j) {
        v.swap(i, j);
        i += 1;
        j -= 1;
    }
}

/// The configuration a Config record (whole, as a leader encoded it) holds; null for any other record.
fn configOfRecord(record: Slice<u8>) -> RaftMembership? {
    let h = match (decodeHeader(record)) {
        Ok(h) => h,
        Err(_) => { return null; }
    };
    let isConfig = match (h.kind) {
        RecordType.Config => true,
        _ => false,
    };
    if (!isConfig) { return null; }
    let metaEnd = RECORD_HEADER_LEN + h.metaLen as usize;
    if (metaEnd > record.length) { return null; }
    return decodeMembership(record[RECORD_HEADER_LEN..metaEnd]);
}
