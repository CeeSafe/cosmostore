// S3 on a cluster (ADR-0060, M6 item 4 slice b). Each shard's store has an S3 server of its own inside the node, on a
// loopback port: the whole S3 layer, unchanged. The node's S3 port is the front: it finds a request's shard from its
// bucket and sends the request to the shard's leader, itself or another node (`POST /s3` on that node's peer port).
// The leader takes writes one at a time per shard; it holds a write's response until the entries the write staged are
// committed and applied, and answers a read only after a ReadIndex round and the apply it names.
import web_core;
import web_transport;
import web_http;
import web_server;
import web_client;

/// How long the front waits for a leader, a read round, or a commit before it answers 503.
const FRONT_WAIT_MS: u64 = 2000;
const FRONT_COMMIT_MS: u64 = 5000;
const FRONT_POLL_MS: u64 = 1;
/// The largest request or response body the front holds: inline objects only, until item 5.
const FRONT_MAX_BODY: usize = 67108864;

/// A request or a response, as bytes: what goes to a shard's S3 server, or between nodes.
struct RawMessage {
    /// A request's method and target; a response's status.
    method: Vector<u8>;
    target: Vector<u8>;
    status: u16;
    names: Vector<Vector<u8>>;
    values: Vector<Vector<u8>>;
    body: Vector<u8>;

    fn empty() -> RawMessage => RawMessage {
        method: Vector<u8>.create(),
        target: Vector<u8>.create(),
        status: 0,
        names: Vector<Vector<u8>>.create(),
        values: Vector<Vector<u8>>.create(),
        body: Vector<u8>.create(),
    };

    fn addHeader(borrow mut this, name: Slice<u8>, value: Slice<u8>) -> Result<void, AllocError> {
        var n = Vector<u8>.create();
        for (b in name) { n.push(lowerAscii(b))?; }
        var v = Vector<u8>.create();
        v.extend(value)?;
        this.names.push(n)?;
        this.values.push(v)?;
        return Ok();
    }
}

fn pushBytes32(out: borrow mut Vector<u8>, b: Slice<u8>) -> Result<void, AllocError> {
    out.pushLE(truncate<u32>(b.length))?;
    out.extend(b)?;
    return Ok();
}

/// u16 status, then u32 + bytes of the method and of the target, u32 header count with u32 + bytes of each name and
/// value, u32 + bytes of the body.
fn encodeRaw(out: borrow mut Vector<u8>, m: borrow RawMessage) -> Result<void, AllocError> {
    out.pushLE(m.status)?;
    pushBytes32(out, m.method.view())?;
    pushBytes32(out, m.target.view())?;
    out.pushLE(truncate<u32>(m.names.length))?;
    for (i in 0..m.names.length) {
        pushBytes32(out, m.names[i].view())?;
        pushBytes32(out, m.values[i].view())?;
    }
    pushBytes32(out, m.body.view())?;
    return Ok();
}

fn decodeRaw(bytes: Slice<u8>) -> Result<RawMessage, WireFault> {
    var r = WireReader { at: 0 };
    var m = RawMessage.empty();
    m.status = r.u16Of(bytes)?;
    m.method = r.bytesOf(bytes)?;
    m.target = r.bytesOf(bytes)?;
    let count = r.u32Of(bytes)?;
    if (count > 1024) { return Err(WireFault.TooMany); }
    var i = 0u32;
    while (i < count) {
        let n = r.bytesOf(bytes)?;
        let v = r.bytesOf(bytes)?;
        if (m.names.push(n).isErr() || m.values.push(v).isErr()) { return Err(WireFault.OutOfMemory); }
        i += 1;
    }
    m.body = r.bytesOf(bytes)?;
    if (r.at != bytes.length) { return Err(WireFault.Long); }
    return Ok(m);
}

/// The bucket a path names: its first segment (path-style addressing); empty for `/`.
fn bucketOfTarget(target: Slice<u8>) -> Slice<u8> {
    var end = target.length;
    for (i in 0..target.length) {
        if (target[i] == 0x3F) { // '?'
            end = i;
            break;
        }
    }
    let path = target[0..end];
    if (path.length < 2 || path[0] != 0x2F) { return target[0..0]; }
    var stop = path.length;
    for (i in 1..path.length) {
        if (path[i] == 0x2F) {
            stop = i;
            break;
        }
    }
    return path[1..stop];
}

/// A bucket's shard (ADR-0060 §3): the first 8 bytes of SHA-256(cluster name ‖ bucket), modulo the shard count.
fn shardOfBucket(file: borrow ClusterFile, bucket: Slice<u8>) -> u32 {
    var h = Sha256.create();
    h.update(file.name[..]);
    h.update(bucket);
    let d = h.finish();
    return truncate<u32>(d[..].readBE<u64>(0) % (file.shards as u64));
}

/// What the node reads once for its shards' S3 servers: STS's keys and the roles file's text (ADR-0078 §2), the
/// website domain (§3).
struct NodeS3Setup {
    keys: Vector<MasterKey>;
    /// SSE-S3's master keys and the KMS keys (`--sse-key-file`, `--kms-key-file`, ADR-0092 §2), the same on every
    /// node: an object sealed through one node is read through any.
    sseKeys: Vector<MasterKey>;
    kmsKeys: Vector<MasterKey>;
    rolesText: Vector<u8>;
    /// The roles, parsed once for every shard's S3 server and reloaded with their places (ADR-0096 §1).
    roleSets: Arc<RoleSets>?;
    websiteDomain: Vector<u8>;
    /// `--domain`: virtual-hosted requests' domain (ADR-0078 §5).
    domain: Vector<u8>;
    /// The notification targets file's text (ADR-0078 §4).
    notifyTargetsText: Vector<u8>;
    /// The replication targets file's text (ADR-0078 §4), wiped once the node has opened: it holds secrets.
    replicationTargetsText: Vector<u8>;
    /// The node's own front, `http://<address>`: where its delivery task sends replicas into the cluster's buckets.
    frontUrl: Vector<u8>;
    /// The node's queue of access log lines, which every shard's S3 server feeds (ADR-0078 §4), and how often a
    /// target's lines become an object (`--access-log-seconds`).
    accessLines: Channel<AccessLogEntry>;
    accessLogEveryMs: u64;
    /// A day, for inventory reports (`--inventory-day-seconds`, shorter for tests).
    inventoryDayMs: u64;
    /// How often a shard's leader runs its buckets' lifecycle rules (the M12 exit review's A3); an hour by default.
    lifecycleEveryMs: u64;
    /// A day for table maintenance (`--tables-day-seconds`, ADR-0086 §5).
    tablesDayMs: u64;
    /// `--zone-id`: the zone of the cluster's directory buckets, the same on every node (ADR-0080 §8).
    zoneId: Vector<u8>;
}

/// What a shard's S3 server needs that the node gives it: its store, the node's credentials, STS's keys and roles.
fn clusterS3App(
    store: Arc<AsyncMutex<ObjectStore>>,
    writers: WriterFactory,
    credentials: Arc<CredentialSets>,
    sts: borrow NodeS3Setup,
) -> Result<S3App, AllocError> {
    let roles = match (borrow sts.roleSets) {
        Some(r) => r.clone(),
        null => Arc<RoleSets>.create(RoleSets.create(match (parseRolesFile(sts.rolesText.view())) {
            Ok(r) => r,
            Err(_) => Vector<StsRole>.create(), // checked when the node started
        })?)?,
    };
    var barriers = Vector<AsyncMutex<u8>>.create();
    for (i in 0..BARRIERS) { barriers.push(AsyncMutex<u8>.create(0)?)?; }
    return Ok(S3App {
        store: store,
        credentials: credentials,
        requests: AtomicU64.create(0),
        domain: copyBytes(sts.domain.view())?,
        websiteDomain: copyBytes(sts.websiteDomain.view())?,
        zoneId: copyBytes(sts.zoneId.view())?,
        tablesDayMs: sts.tablesDayMs,
        commitTurn: AsyncMutex<u8>.create(0)?,
        published: AtomicU64.create(0),
        syncing: AtomicBool.create(false),
        syncingBatch: AtomicU64.create(0),
        syncingLast: AtomicU64.create(0),
        barriers: barriers,
        leading: AtomicBool.create(false),
        leadingBatch: AtomicU64.create(0),
        writers: writers,
        latencies: Latencies.create()?,
        bodyBuffers: Channel<Vector<u8>>.create(BODY_BUFFERS)?,
        // "Some", for good: another leader's writes reach this store without passing here (ADR-0060).
        policyBuckets: AtomicU64.create(1),
        denyBuckets: AtomicU64.create(1),
        secure: false,
        notifyTargets: match (parseTargets(sts.notifyTargetsText.view())?) {
            Some(t) => t,
            null => Vector<NotifyTarget>.create(), // checked when the node started
        },
        sseKeys: copyKeys(sts.sseKeys.view())?,
        stsKeys: copyKeys(sts.keys.view())?,
        roles: roles,
        kmsKeys: copyKeys(sts.kmsKeys.view())?,
        corsBuckets: AtomicU64.create(1),
        encryptedBuckets: AtomicU64.create(1),
        audit: null,
        accessLog: Some(AccessLog { lines: sts.accessLines.clone(), dropped: AtomicU64.create(0) }),
        // "Some", for good, as policies are.
        loggingBuckets: AtomicU64.create(1),
        // "Some", for good, as policies are (ADR-0078 §5).
        accessPointBuckets: AtomicU64.create(1),
        // "Some", for good, as policies are.
        replicationBuckets: AtomicU64.create(1),
        replicationTargetIds: replicationTargetIdsOf(sts.replicationTargetsText.view())?,
        rates: RateLimiter.create(0, 0)?,
        cluster: true,
    });
}

/// The ids of a replication targets file's endpoints (checked when the node started).
fn replicationTargetIdsOf(text: Slice<u8>) -> Result<Vector<Vector<u8>>, AllocError> {
    var ids = Vector<Vector<u8>>.create();
    match (parseReplicationTargets(text)?) {
        Some(targets) => {
            for (i in 0..targets.length) { ids.push(copyBytes(targets[i].id.view())?)?; }
        }
        null => {}
    }
    return Ok(ids);
}

async fn frontPause(ms: u64) -> bool {
    return (await Timer.sleep(ms)).isOk();
}

fn frontClient() -> Client? {
    var options = ClientOptions.defaults();
    options.totalMs = 30000;
    options.retry = RetryPolicy.never();
    return match (Client.create(options, null)) {
        Ok(c) => Some(c),
        Err(_) => null,
    };
}

/// Sends `raw` to `url` (a shard's S3 server, or a node's peer port with `signed` headers), and reads the response
/// whole. The client's own `host` goes with it: its signature covers it.
async fn exchangeRaw(
    shared: borrow NodeShared,
    url: StringView,
    raw: borrow RawMessage,
    signedPath: StringView?,
    body: Slice<u8>,
) -> Result<RawMessage, NodeFault> {
    let client = match (frontClient()) {
        Some(c) => c,
        null => { return Err(NodeFault.OutOfMemory); }
    };
    let method = match (signedPath) {
        Some(_) => Method.Post,
        null => Methods.parse(raw.method.view()),
    };
    // A shard's S3 server is asked for the request's own path and query; a node's peer port for its fixed path.
    var full = textOf(url);
    if (signedPath.isNull()) {
        let target = StringView.fromUtf8(raw.target.view()) ?? "/";
        if (full.append(target).isErr()) { return Err(NodeFault.OutOfMemory); }
    }
    var request = match (ClientRequest.create(method, full.view())) {
        Ok(r) => r,
        Err(_) => { return Err(NodeFault.Net); }
    };
    match (signedPath) {
        Some(path) => {
            if (!signRequest(
                mut request,
                borrow shared.file,
                shared.secret.view(),
                shared.id,
                "POST",
                path,
                body,
                peerNow(shared),
            )) {
                return Err(NodeFault.OutOfMemory);
            }
        }
        null => {
            for (i in 0..raw.names.length) {
                let n = raw.names[i].view();
                if (Ascii.equalsIgnoringCase(n, "host")) {
                    if (request.setAuthority(raw.values[i].view()).isErr()) { return Err(NodeFault.Net); }
                    continue;
                }
                let hop = Ascii.equalsIgnoringCase(n, "content-length") ||
                    Ascii.equalsIgnoringCase(n, "transfer-encoding") || Ascii.equalsIgnoringCase(n, "connection") ||
                    Ascii.equalsIgnoringCase(n, "expect") || Ascii.equalsIgnoringCase(n, "keep-alive");
                if (hop) { continue; }
                let name = StringView.fromUtf8(n) ?? "";
                if (request.header(name, raw.values[i].view()).isErr()) { return Err(NodeFault.Net); }
            }
        }
    }
    var content = match (BytesBody.of(body)) {
        Ok(b) => b,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    var response = match (await client.send(request, mut content)) {
        Ok(r) => r,
        // Refused at connect: nothing was sent (a client of its own, which never retries), so a write was not done.
        Err(ClientError.Net(NetError.Io(IoError.ConnectionRefused))) => { return Err(NodeFault.Unreached); }
        Err(_) => { return Err(NodeFault.Net); }
    };
    var out = RawMessage.empty();
    out.status = response.status();
    var fields = HeaderBlock.create();
    if (response.fields(mut fields).isErr()) { return Err(NodeFault.Net); }
    for (i in 0..fields.count()) {
        if (out.addHeader(fields.name(i), fields.value(i)).isErr()) { return Err(NodeFault.OutOfMemory); }
    }
    if ((await response.readToEnd(mut out.body, FRONT_MAX_BODY)).isErr()) { return Err(NodeFault.Net); }
    let _ = await response.finish(borrow client);
    await client.shutdown();
    return Ok(out);
}

fn statusOnly(status: u16) -> RawMessage {
    var m = RawMessage.empty();
    m.status = status;
    return m;
}

/// The slot of `shard` on this node, if it holds one.
fn slotOf(shared: borrow NodeShared, shard: u32) -> usize? {
    for (i in 0..shared.slots.length) {
        if (shared.slots[i].shard == shard) { return Some(i); }
    }
    return null;
}

/// Whether this node's replica of the slot leads, and the leader it knows of (0: none).
async fn leaderOf(slot: borrow ShardSlot) -> Result<u32, NodeFault> {
    var guard = match (await slot.replica.lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    return Ok(guard.data().core.leader);
}

/// The replica's state that a leader's request waits on: its role and term, its last and applied entries.
struct LeaderView {
    leads: bool;
    term: u64;
    last: u64;
    applied: u64;
    coreLast: u64;
}

async fn viewOf(slot: borrow ShardSlot) -> Result<LeaderView, NodeFault> {
    var guard = match (await slot.replica.lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let r = guard.data();
    var storeGuard = match (await slot.store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let st = storeGuard.data();
    return Ok(LeaderView {
        leads: r.core.isLeader(),
        term: r.core.term,
        last: st.lastEntry(),
        applied: st.appliedIndex(),
        coreLast: r.core.lastIndex(),
    });
}

/// Proposes what the shard's S3 server staged and persisted since `before`; the last index and the term, or null if
/// it staged nothing (or this replica stopped leading: its entries will be cut off).
async fn proposeStaged(
    shared: borrow NodeShared,
    slot: borrow ShardSlot,
    requestId: [u8; 16]?,
    answer: Slice<u8>,
) -> Result<LeaderView?, NodeFault> {
    var guard = match (await slot.replica.lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let r = guard.data();
    var storeGuard = match (await slot.store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let st = storeGuard.data();
    if (!r.core.isLeader()) { return Ok(null); }
    let before = r.core.lastIndex();
    let term = r.core.term;
    let proposed = await Async.blocking(() => proposeAndDrain(r, st, before, requestId, answer));
    let out = match (proposed) {
        Ok(o) => o,
        Err(e) => {
            await noteFailure(slot, e);
            return Ok(null);
        }
    };
    let last = st.lastEntry();
    await enqueue(shared, slot.shard, out.messages)?;
    if (!out.any) { return Ok(null); }
    return Ok(Some(LeaderView { leads: true, term: term, last: last, applied: st.appliedIndex(), coreLast: last }));
}

struct Proposed {
    any: bool;
    messages: Vector<RaftMessage>;
}

fn proposeAndDrain(
    r: borrow mut ShardReplica,
    st: borrow mut ObjectStore,
    before: u64,
    requestId: [u8; 16]?,
    answer: Slice<u8>,
) -> Result<Proposed, StoreError> {
    // A write that staged entries, with an id: its session after them (ADR-0068 §2).
    match (requestId) {
        Some(id) => {
            if (st.lastEntry() > before) { st.stageSession(id, answer)?; }
        }
        null => {}
    }
    let last = r.finishWrite(st, before)?;
    var out = Vector<RaftMessage>.create();
    r.drain(st, mut out)?;
    return Ok(Proposed { any: last.isSome(), messages: out });
}

/// A write on the leader (ADR-0060 §5): behind the shard's gate, after everything earlier is applied; its response
/// held until its entries are committed and applied in the term they were proposed in.
async fn leadWrite(shared: borrow NodeShared, at: usize, raw: borrow RawMessage) -> Result<RawMessage, NodeFault> {
    let slot = borrow shared.slots[at];
    var gate = match (await slot.gate.lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let _held = gate.data();
    var waited = 0u64;
    while (true) {
        let v = await viewOf(slot)?;
        if (!v.leads) { return Ok(statusOnly(421)); }
        if (v.applied == v.last && v.coreLast == v.last) { break; }
        if (waited >= FRONT_COMMIT_MS || !(await frontPause(FRONT_POLL_MS))) { return Ok(statusOnly(503)); }
        waited += FRONT_POLL_MS;
    }
    // Done before (ADR-0068 §4): everything this replica holds is applied, so its table has every session there is.
    let requestId = requestIdOf(raw);
    match (requestId) {
        Some(id) => {
            match (await sessionOfSlot(slot, id)?) {
                Some(e) => {
                    if (!e.kept) { return Ok(statusOnly(503)); }
                    return match (decodeRaw(e.answer.view())) {
                        Ok(answer) => Ok(answer),
                        Err(_) => Ok(statusOnly(503)),
                    };
                }
                null => {}
            }
        }
        null => {}
    }
    let response = await exchangeRaw(shared, slot.s3url.view(), raw, null, raw.body.view())?;
    // The extents the write staged, on a majority before its entries are proposed (ADR-0061 §1).
    if (!(await pushExtents(shared, slot)?)) {
        await abandonStaged(slot);
        return Ok(statusOnly(503));
    }
    // Its session, after its entries and proposed with them (ADR-0068 §2).
    var session = Vector<u8>.create();
    if (requestId.isSome() && encodeRaw(mut session, borrow response).isErr()) { return Err(NodeFault.OutOfMemory); }
    let proposed = match (await proposeStaged(shared, slot, requestId, session.view())?) {
        Some(p) => p,
        null => {
            // Nothing staged (a refusal, a delete of nothing): the answer stands; or no longer the leader, and what it
            // staged is cut off by the next one: 503, the outcome unknown to the client.
            let v = await viewOf(slot)?;
            if (v.leads) { return Ok(response); }
            return Ok(statusOnly(503));
        }
    };
    waited = 0;
    while (true) {
        let v = await viewOf(slot)?;
        if (v.applied >= proposed.last) {
            // Applied: the entry at the index is committed; its term says it is this write's.
            if ((await entryTermOf(slot, proposed.last))? == proposed.term) { return Ok(response); }
            return Ok(statusOnly(503));
        }
        if (!v.leads || v.term != proposed.term) { return Ok(statusOnly(503)); }
        if (waited >= FRONT_COMMIT_MS || !(await frontPause(FRONT_POLL_MS))) { return Ok(statusOnly(503)); }
        waited += FRONT_POLL_MS;
    }
    return Ok(statusOnly(503));
}

/// The extents the entries after the core's last name, persisted first: what a write staged.
fn stagedExtents(st: borrow mut ObjectStore, after: u64) -> Result<Vector<u64>, StoreError> {
    st.persistEntries()?;
    let last = st.lastEntry();
    if (last <= after) { return Ok(Vector<u64>.create()); }
    return st.extentsOfEntries(after + 1, last);
}

/// Sends the extents a write staged to every other replica of the shard at once; whether a majority, this one
/// counting, holds them all (ADR-0061 §1, §2).
async fn pushExtents(shared: borrow NodeShared, slot: borrow ShardSlot) -> Result<bool, NodeFault> {
    var files = Vector<Vector<u8>>.create();
    var ids = Vector<u64>.create();
    {
        var guard = match (await slot.replica.lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let after = guard.data().core.lastIndex();
        var storeGuard = match (await slot.store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let st = storeGuard.data();
        ids = match (await Async.blocking(() => stagedExtents(st, after))) {
            Ok(i) => i,
            Err(_) => { return Ok(false); }
        };
        for (k in 0..ids.length) {
            let id = ids[k];
            match (await Async.blocking(() => st.extentFileBytes(id))) {
                Ok(b) => {
                    if (files.push(b).isErr()) { return Err(NodeFault.OutOfMemory); }
                }
                Err(_) => { return Ok(false); }
            }
        }
    }
    if (ids.length == 0) { return Ok(true); }
    // The shard's group as it is now (ADR-0062): its voters count for the majority, its learners get them too.
    let placed = await shardGroupOf(slot)?;
    let votersOf = await votersOfSlot(slot)?;
    let held = AtomicU64.create(1); // this replica's
    let heldRef = borrow held;
    let shard = slot.shard;
    let fileView = borrow files;
    let idView = borrow ids;
    let _ = await Async.scope(NodeFault.OutOfMemory, (s) => {
        for (p in 0..placed.length) {
            let peer = placed[p];
            if (peer == shared.id) { continue; }
            s.spawn(async move () => {
                if (await pushAll(shared, peer, shard, idView, fileView)) { let _ = heldRef.fetchAdd(1); }
                return Ok();
            });
        }
    });
    // A majority of the voters, this one counting if it votes.
    return Ok(held.load() >= (votersOf.length as u64) / 2 + 1);
}

/// The shard's group as this replica knows it: its voters and learners.
async fn shardGroupOf(slot: borrow ShardSlot) -> Result<Vector<u32>, NodeFault> {
    var guard = match (await slot.replica.lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let m = borrow guard.data().core.members;
    var out = Vector<u32>.create();
    for (v in m.voters.view()) {
        if (out.push(v).isErr()) { return Err(NodeFault.OutOfMemory); }
    }
    for (l in m.learners.view()) {
        if (out.push(l).isErr()) { return Err(NodeFault.OutOfMemory); }
    }
    return Ok(out);
}

async fn votersOfSlot(slot: borrow ShardSlot) -> Result<Vector<u32>, NodeFault> {
    var guard = match (await slot.replica.lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    var out = Vector<u32>.create();
    for (v in guard.data().core.members.voters.view()) {
        if (out.push(v).isErr()) { return Err(NodeFault.OutOfMemory); }
    }
    return Ok(out);
}

/// Pushes every extent to node `peer`; whether it took them all.
async fn pushAll(
    shared: borrow NodeShared,
    peer: u32,
    shard: u32,
    ids: borrow Vector<u64>,
    files: borrow Vector<Vector<u8>>,
) -> bool {
    let url = match (peerUrl(shared, peer, "/extent")) {
        Some(u) => u,
        null => { return false; }
    };
    for (k in 0..ids.length) {
        var body = Vector<u8>.create();
        let built = body.pushLE(shard).isOk() && body.pushLE(ids[k]).isOk() && body.extend(files[k].view()).isOk();
        if (!built) { return false; }
        let empty = RawMessage.empty();
        match (await exchangeRaw(shared, url.view(), borrow empty, Some("/extent"), body.view())) {
            Ok(reply) => {
                if (reply.status != 204) { return false; }
            }
            Err(_) => { return false; }
        }
    }
    return true;
}

/// `http://<peer's address><path>`.
fn peerUrl(shared: borrow NodeShared, node: u32, path: StringView) -> String? {
    return match (shared.file.node(node)) {
        Some(n) => {
            var url = textOf("http://");
            if (appendPeerAddress(mut url, n.peer).isErr() || url.append(path).isErr()) { null } else { Some(url) }
        }
        null => null,
    };
}

/// The request id a forwarded write carries (ADR-0068 §1), or null.
fn requestIdOf(raw: borrow RawMessage) -> [u8; 16]? {
    for (i in 0..raw.names.length) {
        if (raw.names[i].view() != "x-cosmo-request".bytes()) { continue; }
        var id = [0u8; 16];
        if (raw.values[i].length != 32 || !hexInto(raw.values[i].view(), mut id[..])) { return null; }
        return Some(id);
    }
    return null;
}

async fn sessionOfSlot(slot: borrow ShardSlot, id: [u8; 16]) -> Result<SessionEntry?, NodeFault> {
    var storeGuard = match (await slot.store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    return Ok(storeGuard.data().sessionOf(id));
}

/// Cuts off the entries a write staged but could not get its extents to a majority for: uncommitted, this leader's.
async fn abandonStaged(slot: borrow ShardSlot) {
    var guard = match (await slot.replica.lock()) {
        Ok(g) => g,
        Err(_) => { return; }
    };
    let after = guard.data().core.lastIndex();
    var storeGuard = match (await slot.store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return; }
    };
    let st = storeGuard.data();
    match (await Async.blocking(() => st.truncateEntries(after))) {
        Ok() => {}
        Err(e) => { await noteFailure(slot, e); }
    }
}

/// Every two seconds, the extents each replica's versions and uploads name that it lacks, fetched from the shard's
/// other replicas and checked against their manifests (ADR-0061 §3).
async fn fetchForever(shared: borrow NodeShared) -> Result<void, NodeFault> {
    while (true) {
        if (!(await frontPause(2000))) { return Err(NodeFault.Net); }
        for (i in 0..shared.slots.length) {
            let slot = borrow shared.slots[i];
            if (slot.failed.load() != 0) { continue; }
            var missing = Vector<ExtentRef>.create();
            {
                var storeGuard = match (await slot.store.get().lock()) {
                    Ok(g) => g,
                    Err(_) => { return Err(NodeFault.Net); }
                };
                let st = storeGuard.data();
                missing = match (await Async.blocking(() => st.missingExtents(64))) {
                    Ok(m) => m,
                    Err(_) => { continue; }
                };
            }
            for (k in 0..missing.length) { await fetchExtent(shared, slot, borrow missing[k]); }
            // Coded extents: missing pieces rebuilt, wanted ones decoded (ADR-0064 §4, §5).
            let _ = await repairCoded(shared, slot);
        }
    }
    return Ok();
}

async fn fetchExtent(shared: borrow NodeShared, slot: borrow ShardSlot, want: borrow ExtentRef) {
    let placed = match (await shardGroupOf(slot)) {
        Ok(p) => p,
        Err(_) => { return; }
    };
    for (p in 0..placed.length) {
        if (placed[p] == shared.id) { continue; }
        let url = match (peerUrl(shared, placed[p], "/extent-fetch")) {
            Some(u) => u,
            null => { continue; }
        };
        var body = Vector<u8>.create();
        if (body.pushLE(slot.shard).isErr() || body.pushLE(want.id).isErr()) { return; }
        let empty = RawMessage.empty();
        let reply = match (await exchangeRaw(shared, url.view(), borrow empty, Some("/extent-fetch"), body.view())) {
            Ok(r) => r,
            Err(_) => { continue; }
        };
        if (reply.status != 200) { continue; }
        // The manifest's length and CRC32C, over the bytes after the header.
        let b = reply.body.view();
        if ((b.length as u64) != EXTENT_HEADER_LEN + want.length) { continue; }
        if (Crc32c.of(b[EXTENT_HEADER_LEN as usize..b.length]) != want.crc) { continue; }
        var storeGuard = match (await slot.store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return; }
        };
        let st = storeGuard.data();
        let id = want.id;
        if ((await Async.blocking(() => st.installExtent(id, b))).isOk()) {
            let _ = shared.extentsFetched.fetchAdd(1);
            return;
        }
    }
}

async fn entryTermOf(slot: borrow ShardSlot, index: u64) -> Result<u64, NodeFault> {
    var storeGuard = match (await slot.store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let st = storeGuard.data();
    // A read of the journal: on a worker.
    let term = await Async.blocking(() => st.entryTerm(index));
    return Ok(term.ok() ?? 0);
}

/// A read on the leader (ADR-0060 §6): a ReadIndex round, the apply it names, then the shard's S3 server.
async fn leadRead(shared: borrow NodeShared, at: usize, raw: borrow RawMessage) -> Result<RawMessage, NodeFault> {
    let slot = borrow shared.slots[at];
    let id = shared.readIds.fetchAdd(1) + 1;
    var waited = 0u64;
    // Asked of the core until it takes it: a new leader takes reads once its first entry is committed. The replica's
    // lock is let go before each pause: held across it, reads waiting here starve the tick that would let the core
    // step down or commit (ADR-0065: the chaos harness found a deposed leader stuck so for over a minute).
    while (true) {
        var taken = false;
        {
            var guard = match (await slot.replica.lock()) {
                Ok(g) => g,
                Err(_) => { return Err(NodeFault.Net); }
            };
            let r = guard.data();
            if (!r.core.isLeader()) { return Ok(statusOnly(421)); }
            taken = match (r.core.readIndex(id)) {
                Ok(t) => t,
                Err(_) => { return Err(NodeFault.OutOfMemory); }
            };
            if (taken) {
                var storeGuard = match (await slot.store.get().lock()) {
                    Ok(g) => g,
                    Err(_) => { return Err(NodeFault.Net); }
                };
                let st = storeGuard.data();
                let drained = await Async.blocking(() => drainOf(r, st));
                match (drained) {
                    Ok(out) => { await enqueue(shared, slot.shard, out)?; }
                    Err(e) => {
                        await noteFailure(slot, e);
                        return Ok(statusOnly(503));
                    }
                }
            }
        }
        if (taken) { break; }
        if (waited >= FRONT_WAIT_MS || !(await frontPause(FRONT_POLL_MS))) { return Ok(statusOnly(503)); }
        waited += FRONT_POLL_MS;
    }
    // The round's answer, and the index it names.
    var index = 0u64;
    waited = 0;
    while (true) {
        {
            var guard = match (await slot.replica.lock()) {
                Ok(g) => g,
                Err(_) => { return Err(NodeFault.Net); }
            };
            let r = guard.data();
            var k = 0usize;
            var found = false;
            while (k < r.reads.length) {
                if (r.reads[k].id == id) {
                    index = r.reads[k].index;
                    let _ = r.reads.swapRemove(k);
                    found = true;
                    break;
                }
                k += 1;
            }
            if (found) { break; }
            if (!r.core.isLeader()) { return Ok(statusOnly(421)); }
        }
        if (waited >= FRONT_WAIT_MS || !(await frontPause(FRONT_POLL_MS))) { return Ok(statusOnly(503)); }
        waited += FRONT_POLL_MS;
    }
    waited = 0;
    while (true) {
        let v = await viewOf(slot)?;
        if (v.applied >= index) { break; }
        if (waited >= FRONT_WAIT_MS || !(await frontPause(FRONT_POLL_MS))) { return Ok(statusOnly(503)); }
        waited += FRONT_POLL_MS;
    }
    return await exchangeRaw(shared, slot.s3url.view(), raw, null, raw.body.view());
}

/// Methods are case-sensitive tokens (RFC 9110 §9.1): a write is PUT, POST or DELETE exactly.
fn isWriteMethod(method: Slice<u8>) -> bool => match (Methods.parse(method)) {
    Method.Put => true,
    Method.Post => true,
    Method.Delete => true,
    _ => false,
};

/// A request for `shard` on this node as its leader; 421 when it is not.
async fn leadRequest(shared: borrow NodeShared, shard: u32, raw: borrow RawMessage) -> Result<RawMessage, NodeFault> {
    let at = match (slotOf(shared, shard)) {
        Some(i) => i,
        null => { return Ok(statusOnly(421)); }
    };
    if (shared.slots[at].failed.load() != 0) { return Ok(statusOnly(503)); }
    if (isWriteMethod(raw.method.view())) { return await leadWrite(shared, at, raw); }
    return await leadRead(shared, at, raw);
}

/// Sends a request for `shard` to its leader: this node, or the node it last heard of, or each node the shard is
/// placed on in turn; tries again while there is no leader, for up to FRONT_WAIT_MS.
async fn routeRequest(shared: borrow NodeShared, shard: u32, raw: borrow RawMessage) -> Result<RawMessage, NodeFault> {
    var waited = 0u64;
    var body = Vector<u8>.create();
    if (body.pushLE(shard).isErr() || encodeRaw(mut body, raw).isErr()) { return Err(NodeFault.OutOfMemory); }
    let placed = match (shared.file.placement(shard)) {
        Ok(p) => p,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    let write = isWriteMethod(raw.method.view());
    let once = requestIdOf(raw).isSome();
    var turn = 0usize;
    while (true) {
        var target = 0u32;
        match (slotOf(shared, shard)) {
            Some(at) => {
                let leader = await leaderOf(borrow shared.slots[at])?;
                if (leader == shared.id) {
                    let answer = await leadRequest(shared, shard, raw)?;
                    if (answer.status != 421) { return Ok(answer); }
                } else if (leader != 0) {
                    target = leader;
                } else {
                    // No leader heard of (a replica not in the shard's group): ask the roster's nodes in turn.
                    let n = borrow shared.file.nodes[turn % shared.file.nodes.length];
                    turn += 1;
                    if (n.id != shared.id) { target = n.id; }
                }
            }
            null => {
                // Not a shard of this node: ask its nodes in turn.
                target = placed[turn % placed.length];
                turn += 1;
            }
        }
        if (target != 0) {
            match (shared.file.node(target)) {
                Some(n) => {
                    var url = textOf("http://");
                    if (appendPeerAddress(mut url, n.peer).isErr() || url.append("/s3").isErr()) {
                        return Err(NodeFault.OutOfMemory);
                    }
                    let empty = RawMessage.empty();
                    match (await exchangeRaw(shared, url.view(), borrow empty, Some("/s3"), body.view())) {
                        Ok(reply) => {
                            if (reply.status == 200) {
                                match (decodeRaw(reply.body.view())) {
                                    Ok(answer) => { return Ok(answer); }
                                    Err(_) => { return Ok(statusOnly(502)); }
                                }
                            }
                            // 421: not the leader, refused before anything was staged; a read tries again on
                            // anything. A write that reached a leader may have been done: sent again, it would be
                            // done twice, the second time after writes that came between (ADR-0065: the chaos
                            // harness found it). Its outcome is the client's to find out.
                            // A write with a request id is done once however often it is sent (ADR-0068 §5).
                            if (write && !once && reply.status != 421 && reply.status != 403) {
                                return Ok(statusOnly(503));
                            }
                        }
                        Err(NodeFault.Unreached) => {}
                        Err(_) => {
                            if (write && !once) { return Ok(statusOnly(503)); }
                        }
                    }
                }
                null => {}
            }
        }
        if (waited >= FRONT_WAIT_MS || !(await frontPause(20))) { return Ok(statusOnly(503)); }
        waited += 20;
    }
    return Ok(statusOnly(503));
}

/// ListBuckets on a cluster (ADR-0060 §7): every shard's answer, each a linearizable read, the `<Bucket>` entries
/// merged by name into the first answer's frame.
async fn listAllBuckets(shared: borrow NodeShared, raw: borrow RawMessage) -> Result<RawMessage, NodeFault> {
    return await mergeShardLists(shared, raw, "Bucket", "Buckets");
}

/// `<open>…</close>` of `name`.
fn tagOf(name: StringView, close: bool) -> Result<Vector<u8>, AllocError> {
    var t = Vector<u8>.create();
    t.extend((if (close) "</" else "<").bytes())?;
    t.extend(name.bytes())?;
    t.push('>')?;
    return Ok(t);
}

/// Every shard's answer to `raw`, each a linearizable read, its `<item>` entries merged by their `<Name>` into the
/// first answer's `<list>`: ListBuckets (ADR-0060 §7), ListAccessPoints (ADR-0078 §5).
async fn mergeShardLists(
    shared: borrow NodeShared,
    raw: borrow RawMessage,
    item: StringView,
    list: StringView,
) -> Result<RawMessage, NodeFault> {
    let open1 = match (tagOf(item, false)) {
        Ok(t) => t,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    let close1 = match (tagOf(item, true)) {
        Ok(t) => t,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    let openList = match (tagOf(list, false)) {
        Ok(t) => t,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    let closeList = match (tagOf(list, true)) {
        Ok(t) => t,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    var first: RawMessage? = null;
    var entries = Vector<Vector<u8>>.create();
    var names = Vector<Vector<u8>>.create();
    var shard = 0u32;
    while (shard < shared.file.shards) {
        let answer = await routeRequest(shared, shard, raw)?;
        if (answer.status != 200) { return Ok(answer); }
        // Each `<Bucket>…</Bucket>`, by its name.
        let b = answer.body.view();
        var at = 0usize;
        while (true) {
            let open = match (indexOfFrom(b, open1.view(), at)) {
                Some(i) => i,
                null => { break; }
            };
            let close = match (indexOfFrom(b, close1.view(), open)) {
                Some(i) => i + close1.length,
                null => { break; }
            };
            let entry = b[open..close];
            let name = match (indexOfFrom(entry, "<Name>".bytes(), 0)) {
                Some(n) => match (indexOfFrom(entry, "</Name>".bytes(), n)) {
                    Some(e) => entry[n + 6..e],
                    null => entry[0..0],
                },
                null => entry[0..0],
            };
            var e = Vector<u8>.create();
            var nm = Vector<u8>.create();
            if (e.extend(entry).isErr() || nm.extend(name).isErr()) { return Err(NodeFault.OutOfMemory); }
            // Insertion by name.
            var k = names.length;
            while (k > 0 && compareBytes(names[k - 1].view(), nm.view()) > 0) { k -= 1; }
            if (entries.insert(k, e).isErr() || names.insert(k, nm).isErr()) { return Err(NodeFault.OutOfMemory); }
            at = close;
        }
        if (first.isNull()) { first = Some(answer); }
        shard += 1;
    }
    var out = match (first) {
        Some(f) => f,
        null => { return Ok(statusOnly(503)); }
    };
    // The frame: everything up to `<Buckets>` and from `</Buckets>`, the merged entries between.
    let b = out.body.view();
    let start = match (indexOfFrom(b, openList.view(), 0)) {
        Some(i) => i + openList.length,
        null => { return Ok(out); }
    };
    let end = match (indexOfFrom(b, closeList.view(), start)) {
        Some(i) => i,
        null => { return Ok(out); }
    };
    var merged = Vector<u8>.create();
    let built = merged.extend(b[0..start]).isOk();
    if (!built) { return Err(NodeFault.OutOfMemory); }
    for (i in 0..entries.length) {
        if (merged.extend(entries[i].view()).isErr()) { return Err(NodeFault.OutOfMemory); }
    }
    if (merged.extend(b[end..b.length]).isErr()) { return Err(NodeFault.OutOfMemory); }
    out.body = merged;
    return Ok(out);
}

fn indexOfFrom(hay: Slice<u8>, needle: Slice<u8>, from: usize) -> usize? {
    if (needle.length == 0 || hay.length < needle.length) { return null; }
    var i = from;
    while (i + needle.length <= hay.length) {
        var same = true;
        for (k in 0..needle.length) {
            if (hay[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) { return Some(i); }
        i += 1;
    }
    return null;
}

// --- The front's handler ---

struct FrontApp {
    shared: Arc<NodeShared>;
}

struct FrontHandler {}

/// An S3 error answer the front makes itself (no leader, no such operation on a cluster).
/// A raw message's header, by name, ignoring case.
fn rawField<region a>(m: borrow(a) RawMessage, name: StringView) -> Slice<a, u8>? {
    for (i in 0..m.names.length) {
        if (Ascii.equalsIgnoringCase(m.names[i].view(), name)) { return Some(m.values[i].view()); }
    }
    return null;
}

/// Whether this node's credentials accept the long-term key a request is signed with (the M13 exit review's A1). An
/// anonymous request, a session's (STS's or S3 Express's, whose parent the shard checks) and a node without S3 pass;
/// a key this node does not have, or has revoked, does not.
fn frontKeyAccepted(shared: borrow NodeShared, raw: borrow RawMessage) -> bool {
    let sets = match (borrow shared.credentials) {
        Some(c) => c,
        null => { return true; }
    };
    if (rawField(raw, "x-amz-security-token").isSome() || rawField(raw, "x-amz-s3session-token").isSome()) {
        return true;
    }
    let t = raw.target.view();
    let q = indexOfFrom(t, "?".bytes(), 0) ?? t.length;
    let query = if (q < t.length) t[q + 1..] else t[t.length..];
    if (indexOfFrom(query, "X-Amz-Security-Token=".bytes(), 0).isSome()) { return true; }
    var key = Vector<u8>.create();
    match (rawField(raw, "authorization")) {
        Some(a) => {
            match (parseAuthorization(a)) {
                Ok(h) => {
                    if (key.extend(h.accessKey.view()).isErr()) { return false; }
                }
                Err(_) => { return true; } // not SigV4: the shard answers it
            }
        }
        null => {
            // A presigned URL's credential: `X-Amz-Credential=<key>%2F<scope>`.
            let name = "X-Amz-Credential=".bytes();
            match (indexOfFrom(query, name, 0)) {
                Some(at) => {
                    let from = at + name.length;
                    var end = from;
                    while (end < query.length && query[end] != '&' && query[end] != '%' && query[end] != '/') {
                        end += 1;
                    }
                    if (key.extend(query[from..end]).isErr()) { return false; }
                }
                null => { return true; } // anonymous, or a POST form's (its fields are in the body)
            }
        }
    }
    let set = sets.get().view();
    for (i in 0..set.length) {
        if (!set[i].revoked && sameSignature(set[i].accessKey.view(), key.view())) { return true; }
    }
    return false;
}

fn frontError(code: StringView, status: u16) -> RawMessage {
    var m = statusOnly(status);
    var xml = Vector<u8>.create();
    let _ = xml.extend("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Error><Code>".bytes());
    let _ = xml.extend(code.bytes());
    let _ = xml.extend("</Code><Message>".bytes());
    let _ = xml.extend(code.bytes());
    let _ = xml.extend("</Message></Error>".bytes());
    let _ = m.addHeader("content-type".bytes(), "application/xml".bytes());
    m.body = xml;
    return m;
}

impl Handler<FrontApp> for FrontHandler {
    async fn handle(
        borrow this,
        ctx: borrow mut RequestContext<FrontApp>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        let shared = ctx.state().shared.get();
        var raw = RawMessage.empty();
        let target = request.path();
        let copied = raw.method.extend(request.methodToken()).isOk() && raw.target.extend(target.bytes()).isOk();
        if (!copied) { return Err(HandlerError.Internal); }
        match (request.query()) {
            Some(q) => {
                if (raw.target.push(0x3F).isErr() || raw.target.extend(q.bytes()).isErr()) {
                    return Err(HandlerError.Internal);
                }
            }
            null => {}
        }
        let fields = request.headers();
        // A request of this node's own delivery task (ADR-0078 §4) carries its stamp, under the cluster's secret: only
        // then do a replica's fields and a log delivery's pass (the M7 review's B2, B3); the shard's S3 server takes
        // them only signed by a long-term key as well.
        var stampSent = Vector<u8>.create();
        var amzDate = Vector<u8>.create();
        for (i in 0..fields.count()) {
            let name = fields.nameBytes(i);
            if (Ascii.equalsIgnoringCase(name, INTERNAL_FIELD) && stampSent.extend(fields.value(i)).isErr()) {
                return Err(HandlerError.Internal);
            }
            if (Ascii.equalsIgnoringCase(name, "x-amz-date") && amzDate.extend(fields.value(i)).isErr()) {
                return Err(HandlerError.Internal);
            }
        }
        var stamped = false;
        if (stampSent.length > 0 && amzDate.length > 0) {
            let t = raw.target.view();
            let q = indexOfFrom(t, "?".bytes(), 0) ?? t.length;
            let query = if (q < t.length) t[q + 1..] else t[t.length..];
            stamped = match (internalStamp(shared.secret.view(), raw.method.view(), t[0..q], query, amzDate.view())) {
                Ok(expected) => expected.length == stampSent.length && ConstantTime.equal(
                    expected.view(),
                    stampSent.view(),
                ),
                Err(_) => false,
            };
        }
        for (i in 0..fields.count()) {
            // The cluster's own headers are the nodes' to set: a client's go (ADR-0068 §1).
            let name = fields.nameBytes(i);
            let signedField = stamped && ((name.length >= 16 && Ascii.equalsIgnoringCase(
                name[0..16],
                "x-cosmo-replica-",
            )) || Ascii.equalsIgnoringCase(name, LOG_DELIVERY_FIELD));
            if (!signedField && name.length >= 8 && Ascii.equalsIgnoringCase(name[0..8], "x-cosmo-")) { continue; }
            if (raw.addHeader(name, fields.value(i)).isErr()) { return Err(HandlerError.Internal); }
        }
        // The request's key, checked against this node's own set too (the M13 exit review's A1): the shard's leader,
        // perhaps on another node, checks it against its own, so a key passes only when both nodes accept it, and a
        // revocation in this node's file holds through it whichever node leads.
        if (!frontKeyAccepted(shared, borrow raw)) {
            return await relay(exchange, frontError("InvalidAccessKeyId", 403), false);
        }
        // The client's address, for the shard's S3 server: its policies' `aws:SourceIp` and its access log lines
        // (ADR-0078 §4) are the client's, not this front's.
        match (ctx.connection().peerAddress()) {
            Some(a) => {
                var text = String.create();
                if (appendPeerAddress(mut text, a).isErr() || raw.addHeader(
                    PEER_FIELD.bytes(),
                    text.view().bytes(),
                ).isErr()) {
                    return Err(HandlerError.Internal);
                }
            }
            null => {}
        }
        // A write's request id (ADR-0068 §1): the node's prefix, then its count of requests.
        if (isWriteMethod(raw.method.view())) {
            var id = [0u8; 16];
            id[..].writeLE(0, shared.requestPrefix);
            id[..].writeLE(8, shared.requests.fetchAdd(1));
            var hex = Vector<u8>.create();
            if (appendHexBytes(mut hex, id[..]).isErr() || raw.addHeader(
                "x-cosmo-request".bytes(),
                hex.view(),
            ).isErr()) {
                return Err(HandlerError.Internal);
            }
        }
        var buf = Vector<u8>.create();
        if (buf.resize(65536, 0).isErr()) { return Err(HandlerError.Internal); }
        while (true) {
            let n = await exchange.read(mut buf.viewMut()[..])?;
            if (n == 0) { break; }
            if (raw.body.length + n > FRONT_MAX_BODY) {
                return await relay(exchange, frontError("EntityTooLarge", 400), false);
            }
            if (raw.body.extend(buf.view()[0..n]).isErr()) { return Err(HandlerError.Internal); }
        }
        // S3 Tables (ADR-0083 §7): routed by its table bucket, its hidden bucket's shard.
        if (tablesRequestRaw(borrow raw)) {
            let routed = match (await routeTablesRaw(shared, borrow raw)) {
                Ok(a) => a,
                Err(_) => frontError("InternalError", 500),
            };
            let head = Methods.parse(raw.method.view()) == Method.Head;
            return await relay(exchange, shownOf(routed), head);
        }
        // S3 Control (ADR-0078 §5): routed by an access point's claim in group 0, or by its bucket.
        if (isControlRequest(borrow raw)) {
            let routed = match (await routeControl(shared, mut raw)) {
                Ok(a) => a,
                Err(_) => frontError("InternalError", 500),
            };
            return await relay(exchange, shownOf(routed), false);
        }
        // A website request (ADR-0078 §3) names its bucket by its host, `<bucket>.<website domain>`; with `--domain`,
        // a virtual-hosted request by `<bucket>.<domain>` (ADR-0078 §5).
        var site = Vector<u8>.create();
        var hosted = Vector<u8>.create();
        for (i in 0..raw.names.length) {
            if (!Ascii.equalsIgnoringCase(raw.names[i].view(), "host")) { continue; }
            match (websiteBucketOf(raw.values[i].view(), shared.websiteDomain.view())) {
                Some(b) => {
                    if (site.extend(b).isErr()) { return Err(HandlerError.Internal); }
                }
                null => {}
            }
            if (virtualBucket(raw.values[i].view(), shared.domain.view(), mut hosted).isErr()) {
                return Err(HandlerError.Internal);
            }
        }
        let bucket = if (site.length > 0) site.view() else if (hosted.length > 0) hosted.view() else bucketOfTarget(
            raw.target.view(),
        );
        // An access point's alias, or `<name>-<account>` from its ARN's host (ADR-0078 §5): its bucket's shard. The
        // request goes as it came; the shard's S3 server finds the access point in its own store.
        var through = Vector<u8>.create();
        if (site.length == 0 && mayNameAccessPoint(bucket)) {
            match (await findClaim(shared, bucket, false, false)) {
                Ok(Some(c)) => { through = c.bucket; }
                Ok(null) => {}
                Err(_) => { return await relay(exchange, frontError("InternalError", 500), false); }
            }
        }
        let routed = if (through.length > 0) through.view() else bucket;
        let head = Methods.parse(raw.method.view()) == Method.Head;
        // A copy reads its source from its own shard's store: a source in another shard's bucket is not there.
        for (i in 0..raw.names.length) {
            if (!Ascii.equalsIgnoringCase(raw.names[i].view(), "x-amz-copy-source")) { continue; }
            let source = copySourceBucket(raw.values[i].view());
            if (source.length > 0 && shardOfBucket(
                borrow shared.file,
                source,
            ) != shardOfBucket(borrow shared.file, routed)) {
                return await relay(exchange, frontError("NotImplemented", 501), false);
            }
        }
        // STS (ADR-0078 §2): a POST to the service, answered by any shard's S3 server (shard 0's), since a session
        // token is sealed, not stored.
        let method = Methods.parse(raw.method.view());
        let answered = if (bucket.length == 0) {
            if (method == Method.Get) await listAllBuckets(
                shared,
                borrow raw,
            ) else if (method == Method.Post) await routeRequest(
                shared,
                0,
                borrow raw,
            ) else Ok(frontError("NotImplemented", 501))
        } else await routeRequest(shared, shardOfBucket(borrow shared.file, routed), borrow raw);
        let answer = match (answered) {
            Ok(a) => a,
            Err(_) => frontError("InternalError", 500),
        };
        // A bucket deleted takes its access points with it: their names are let go (ADR-0078 §5).
        let bucketGone = method == Method.Delete && answer.status == 204 && through.length == 0 && bucket.length > 0 &&
            site.length == 0 && namesBucketItself(raw.target.view(), hosted.length > 0);
        if (bucketGone && (await releaseBucketClaims(shared, bucket, Clock.unixMillis())).isErr()) {
            let _ = await AsyncConsole.writeError(
                "cosmostore: a deleted bucket's access point names were not let go\n",
            );
        }
        return await relay(exchange, shownOf(answer), head);
    }
}

/// A shard's answer as the client sees it: 503 without a body, or 421 (no leader took it), as ServiceUnavailable.
fn shownOf(answer: RawMessage) -> RawMessage {
    if ((answer.status == 503 && answer.body.length == 0) || answer.status == 421) {
        return frontError("ServiceUnavailable", 503);
    }
    return answer;
}

/// Sends a response as a shard's S3 server gave it: its status, its headers but the framing ones, its body. A HEAD's
/// answer keeps its Content-Length, the length GET would send, with no content.
async fn relay(exchange: borrow mut Exchange, m: RawMessage, head: bool) -> Result<void, HandlerError> {
    var declared: u64? = null;
    for (i in 0..m.names.length) {
        if (Ascii.equalsIgnoringCase(m.names[i].view(), "content-length")) {
            declared = (StringView.fromUtf8(m.values[i].view()) ?? "").parseInt<u64>();
        }
    }
    for (i in 0..m.names.length) {
        let n = m.names[i].view();
        let framing = Ascii.equalsIgnoringCase(
            n,
            "content-length",
        ) || Ascii.equalsIgnoringCase(n, "transfer-encoding") ||
            Ascii.equalsIgnoringCase(n, "connection") || Ascii.equalsIgnoringCase(n, "keep-alive") ||
            Ascii.equalsIgnoringCase(n, "date") || Ascii.equalsIgnoringCase(n, "server");
        if (framing) { continue; }
        let name = StringView.fromUtf8(n) ?? "";
        exchange.header(name, m.values[i].view())?;
    }
    if (head && m.body.length == 0) {
        match (declared) {
            Some(n) => {
                exchange.setStatus(statusOf(m.status));
                exchange.setContentLength(n);
                return await exchange.write("".bytes());
            }
            null => {}
        }
    }
    return await exchange.send(statusOf(m.status), m.body.view());
}

/// The bucket an `x-amz-copy-source` names: `bucket/key` or `/bucket/key`, the bucket before the first `/`.
fn copySourceBucket(source: Slice<u8>) -> Slice<u8> {
    let from: usize = if (source.length > 0 && source[0] == 0x2F) 1 else 0;
    var stop = source.length;
    for (i in from..source.length) {
        if (source[i] == 0x2F) {
            stop = i;
            break;
        }
    }
    return source[from..stop];
}

fn frontHandler() -> Result<Box<dyn Handler<FrontApp> + Send + Share>, RouteError> {
    match (Box.create(FrontHandler {})) {
        Ok(h) => {
            let d: Box<dyn Handler<FrontApp> + Send + Share> = h;
            return Ok(d);
        }
        Err(_) => { return Err(RouteError.OutOfMemory); }
    }
}

fn frontServer(app: FrontApp) -> Result<Server<FrontApp>, RouteError> {
    var limits = Limits.defaults();
    limits.maxBodyBytes = FRONT_MAX_BODY as u64;
    var server = Server<FrontApp>.create(app, limits)?;
    server.router().get("/*path", frontHandler()?)?;
    server.router().put("/*path", frontHandler()?)?;
    server.router().post("/*path", frontHandler()?)?;
    server.router().delete("/*path", frontHandler()?)?;
    server.router().add(Method.Head, "/*path", frontHandler()?)?;
    server.router().add(Method.Options, "/*path", frontHandler()?)?;
    return Ok(server);
}
