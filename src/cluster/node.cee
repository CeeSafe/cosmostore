// A cluster node (ADR-0059 §3, §6–§8, M6 item 3 slice b): the replicas of the shards placed on it, the peer port, a
// tick, and a sender per peer. `cosmostore node <dir> --cluster-file <path> --node <id>` runs one;
// `cosmostore cluster-status --cluster-file <path> --node <id>` asks one for its replicas' state.
//
// Each replica is behind its own lock. A message received is stepped on the event loop (the core does no I/O) and
// drained on a worker (`Async.blocking`: the journal and the hard state do I/O); so is each tick. What a replica sends
// goes to its peer's queue; that peer's sender takes the whole queue, posts it as one batch, and on a failure drops it
// (Raft sends again) and waits before the next.
import web_core;
import web_transport;
import web_http;
import web_server;
import web_client;

const NODE_TICK_MS: u64 = 100;
const NODE_MAINTAIN_TICKS: u64 = 50;
const NODE_SEND_IDLE_MS: u64 = 10;
const NODE_SEND_RETRY_MS: u64 = 100;
/// A batch can hold a snapshot: the store's inline payloads (ADR-0058 §9).
const NODE_MAX_BODY: u64 = 1073741824;

struct ShardSlot {
    shard: u32;
    replica: AsyncMutex<ShardReplica>;
    /// The replica's store, behind the lock its S3 server takes too (ADR-0060 §1): locked after the replica's.
    store: Arc<AsyncMutex<ObjectStore>>;
    /// Set once the replica's journal failed: it is left alone until the node restarts (fail-stop, ADR-0001).
    failed: AtomicU64;
    /// The shard's S3 server on loopback (ADR-0060 §2), empty without S3; and the gate a leader's writes pass one at
    /// a time (§5).
    s3url: String;
    gate: AsyncMutex<u8>;
    /// The maintenance runs its S3 server was asked for, which this node runs while it leads (ADR-0110 §5).
    asked: Arc<AsyncMutex<Vector<AskedRun>>>;
}

struct PeerLink {
    node: u32;
    url: String;
    queue: AsyncMutex<Vector<ShardMessage>>;
}

struct NodeShared {
    file: ClusterFile;
    /// The files the node was given, whose digests its status shows (ADR-0096 §6).
    files: Vector<WatchedFile>;
    /// The tag of the SSE-S3 key every node was last seen to hold as this node's first (`rewrapGate`), 0 for none: a
    /// leader re-wraps only under it (ADR-0100 §4, the M17 exit review).
    rewrapTag: AtomicU64;
    secret: Vector<u8>;
    id: u32;
    slots: Vector<ShardSlot>;
    peers: Vector<PeerLink>;
    nonces: AsyncMutex<NonceWindow>;
    /// Requests refused (ADR-0059 §4), batches that could not be sent, and ticks so far; batches sent and taken.
    refused: AtomicU64;
    unsent: AtomicU64;
    ticks: AtomicU64;
    sent: AtomicU64;
    received: AtomicU64;
    /// The ids of ReadIndex reads (ADR-0060 §6).
    readIds: AtomicU64;
    /// What this node's peer clock is off the machine's by (`--clock-skew-ms`, for the chaos harness, ADR-0065).
    clockSkewMs: i64;
    /// Write request ids (ADR-0068 §1): the node's id and a random number picked at start, then a count.
    requestPrefix: u64;
    requests: AtomicU64;
    /// `--website-domain` (ADR-0078 §3): a request to `<bucket>.<domain>` is that bucket's website.
    websiteDomain: Vector<u8>;
    /// `--domain` (ADR-0078 §5): a request to `<bucket>.<domain>` is that bucket's, virtual-hosted.
    domain: Vector<u8>;
    /// `--notify-targets` (ADR-0078 §4): the webhooks this node's leaders deliver to.
    notifyTargets: Arc<Reloaded<NotifyTarget>>;
    /// `--replication-targets` (ADR-0078 §4): the other endpoints replicas go to, with SSE's keys to open a sealed
    /// source (ADR-0092 §2).
    replication: ReplicaContext;
    /// The node's front and its credentials: a replica into a bucket of the cluster goes through the front, signed
    /// with the current first key, as a client's write.
    frontUrl: Vector<u8>;
    credentials: Arc<CredentialSets>?;
    /// The access log lines this node's shards' S3 servers queued, delivered as objects through the front.
    accessLog: AccessLogWriter;
    /// A day, for inventory reports (ADR-0078 §4).
    inventoryDayMs: u64;
    /// A day, for table maintenance (ADR-0086 §5).
    tablesDayMs: u64;
    /// `--tables-copy-pause-ms`, a test option (ADR-0110 §7).
    tablesCopyPauseMs: u64;
    /// Scrub (ADR-0063): how often a pass starts, and what passes found: versions checked, damage found, records
    /// repaired from a replica, extents fetched (a damaged one removed comes back this way, as a missing one does).
    scrubEveryMs: u64;
    /// How old an extent must be before its shard's leader codes it (ADR-0064 §1).
    codeAfterMs: u64;
    scrubChecked: AtomicU64;
    scrubDamaged: AtomicU64;
    scrubRepaired: AtomicU64;
    extentsFetched: AtomicU64;
}

struct NodeApp {
    shared: Arc<NodeShared>;
}

struct PeerHandler {}

/// Why a node stops.
enum NodeFault {
    OutOfMemory,
    Net,
    Store,
    /// A peer refused the connection: nothing was sent.
    Unreached,
}

fn replicaConfigOf(
    id: u32,
    voters: Vector<u32>,
    learners: Vector<u32>,
    shard: u32,
    segmentBytes: u64,
    lifecycleEveryMs: u64,
) -> ReplicaConfig {
    var store = StoreConfig.defaults();
    store.lifecycleEveryMillis = lifecycleEveryMs;
    store.journal.shardId = shard;
    // Smaller segments, checkpoints as often: a sealed segment is covered (and may be coded) soon after (ADR-0070).
    if (segmentBytes > 0) {
        store.journal.segmentTargetBytes = segmentBytes;
        if (segmentBytes < store.checkpointEveryBytes) { store.checkpointEveryBytes = segmentBytes; }
    }
    var seed = [0u8; 8];
    let _ = Random.fill(mut seed[..]);
    return ReplicaConfig {
        id: id,
        voters: voters,
        learners: learners,
        electionTicks: 10,
        heartbeatTicks: 1,
        maxAppendEntries: 64,
        seed: seed[..].readLE<u64>(0),
        store: store,
    };
}

/// Opens the replicas of the shards placed on node `id`, under `<dir>/shard-<2 hex>`, and the peer links.
/// A shard's S3 server, bound to its loopback port, to run beside the node (ADR-0060 §2).
struct InternalS3 {
    server: Server<S3App>;
    listener: Listener;
}

/// A node opened: what its tasks share, and its shards' S3 servers (none without S3).
struct NodeParts {
    shared: NodeShared;
    internals: Vector<InternalS3>;
}

fn openNode(
    dir: StringView,
    file: ClusterFile,
    secret: Vector<u8>,
    id: u32,
    credentials: Arc<CredentialSets>?,
    sts: borrow NodeS3Setup,
    scrubEveryMs: u64,
    codeAfterMs: u64,
    clockSkewMs: i64,
    joined: bool,
    segmentBytes: u64,
) -> Result<NodeParts, String> {
    if (file.node(id).isNull()) { return Err(textOf("this node is not in the cluster file")); }
    var slots = Vector<ShardSlot>.create();
    var internals = Vector<InternalS3>.create();
    // A slot for every shard, and for group 0 (ADR-0062 §3, as built): a node holds a replica of each, idle until its
    // group adds it, so a shard moving onto it needs nothing made on the fly. A shard begins on its initial placement;
    // group 0 on the first three active nodes, every other node of the roster its learner.
    var shards = Vector<u32>.create();
    var nextShard = 0u32;
    while (nextShard < file.shards) {
        if (shards.push(nextShard).isErr()) { return Err(textOf("out of memory")); }
        nextShard += 1;
    }
    if (shards.push(GROUP0_SHARD).isErr()) { return Err(textOf("out of memory")); }
    for (i in 0..shards.length) {
        let shard = shards[i];
        var base = match (baseMembers(borrow file, shard)) {
            Ok(b) => b,
            Err(_) => { return Err(textOf("out of memory")); }
        };
        // A node that joined (ADR-0066 §3): a shard it holds nothing of is one it is not in, whatever the cluster
        // began as; its leader adds it.
        if (joined) { base = withoutNode(borrow base, id); }
        let voters = base.voters;
        let learners = base.learners;
        var path = String.create();
        let named = path.append(
            dir,
        ).isOk() && (if (shard == GROUP0_SHARD) path.append("/group-0").isOk() else path.append(
            "/shard-",
        ).isOk() && appendHex2(mut path, shard).isOk());
        if (!named) { return Err(textOf("out of memory")); }
        match (Fs.ensureDirectory(path.view())) {
            Ok() => {}
            Err(_) => { return Err(textOf("a shard's directory cannot be made")); }
        }
        let opened = match (ShardReplica.open(
            path.view(),
            replicaConfigOf(id, voters, learners, shard, segmentBytes, sts.lifecycleEveryMs),
        )) {
            Ok(r) => r,
            Err(e) => { return Err(storeErrorLine(e)); }
        };
        // A `--table-s3` bucket S3 made before M9 is no table bucket: the node does not start (ADR-0084 §5).
        match (legacyTableBucket(borrow opened.store)) {
            Ok(Some(name)) => {
                return match (legacyTableBucketMessage(name.view())) {
                    Ok(m) => Err(m),
                    Err(_) => Err(textOf("out of memory")),
                };
            }
            Ok(null) => {}
            Err(e) => { return Err(storeErrorLine(e)); }
        }
        let writers = match (opened.store.writerFactory()) {
            Ok(w) => w,
            Err(_) => { return Err(textOf("out of memory")); }
        };
        let locked = match (AsyncMutex<ShardReplica>.create(opened.replica)) {
            Ok(l) => l,
            Err(_) => { return Err(textOf("out of memory")); }
        };
        let storeLocked = match (AsyncMutex<ObjectStore>.create(opened.store)) {
            Ok(l) => l,
            Err(_) => { return Err(textOf("out of memory")); }
        };
        let store = match (Arc<AsyncMutex<ObjectStore>>.create(storeLocked)) {
            Ok(a) => a,
            Err(_) => { return Err(textOf("out of memory")); }
        };
        let asked = match (AsyncMutex<Vector<AskedRun>>.create(Vector<AskedRun>.create())) {
            Ok(m) => match (Arc<AsyncMutex<Vector<AskedRun>>>.create(m)) {
                Ok(a) => a,
                Err(_) => { return Err(textOf("out of memory")); }
            },
            Err(_) => { return Err(textOf("out of memory")); }
        };
        // Its S3 server on a loopback port the system picks.
        var s3url = String.create();
        match (borrow credentials) {
            Some(c) => {
                let app = match (clusterS3App(store.clone(), writers, c.clone(), sts, asked.clone())) {
                    Ok(a) => a,
                    Err(_) => { return Err(textOf("out of memory")); }
                };
                let server = match (s3Server(app)) {
                    Ok(s) => s,
                    Err(_) => { return Err(textOf("cannot build the routes")); }
                };
                let listener = match (listenOn(SocketAddress.V4([127u8, 0, 0, 1], 0))) {
                    Ok(l) => l,
                    Err(_) => { return Err(textOf("a shard's S3 server cannot listen on loopback")); }
                };
                let bound = match (listener.localAddress()) {
                    Ok(a) => a,
                    Err(_) => { return Err(textOf("a shard's S3 server has no address")); }
                };
                let urlMade = s3url.append("http://").isOk() && appendPeerAddress(mut s3url, bound).isOk();
                if (!urlMade) { return Err(textOf("out of memory")); }
                if (internals.push(InternalS3 { server: server, listener: listener }).isErr()) {
                    return Err(textOf("out of memory"));
                }
            }
            null => {}
        }
        let gate = match (AsyncMutex<u8>.create(0)) {
            Ok(g) => g,
            Err(_) => { return Err(textOf("out of memory")); }
        };
        let slot = ShardSlot {
            shard: shard,
            replica: locked,
            store: store,
            failed: AtomicU64.create(0),
            s3url: s3url,
            gate: gate,
            asked: asked,
        };
        if (slots.push(slot).isErr()) { return Err(textOf("out of memory")); }
    }
    var peers = Vector<PeerLink>.create();
    for (i in 0..file.nodes.length) {
        let n = borrow file.nodes[i];
        if (n.id == id) { continue; }
        var url = String.create();
        let ok = url.append("http://").isOk() && appendPeerAddress(
            mut url,
            n.peer,
        ).isOk() && url.append("/raft").isOk();
        if (!ok) { return Err(textOf("out of memory")); }
        let queue = match (AsyncMutex<Vector<ShardMessage>>.create(Vector<ShardMessage>.create())) {
            Ok(q) => q,
            Err(_) => { return Err(textOf("out of memory")); }
        };
        if (peers.push(
            PeerLink { node: n.id, url: url, queue: queue },
        ).isErr()) { return Err(textOf("out of memory")); }
    }
    let nonces = match (AsyncMutex<NonceWindow>.create(NonceWindow.create())) {
        Ok(n) => n,
        Err(_) => { return Err(textOf("out of memory")); }
    };
    var files = Vector<WatchedFile>.create();
    for (i in 0..sts.watched.length) {
        let copied = match (copyBytes(sts.watched[i].name.view())) {
            Ok(name) => files.push(WatchedFile { name: name, path: textOf(sts.watched[i].path.view()) }).isOk(),
            Err(_) => false,
        };
        if (!copied) { return Err(textOf("out of memory")); }
    }
    let shared = NodeShared {
        file: file,
        files: files,
        rewrapTag: AtomicU64.create(0),
        secret: secret,
        id: id,
        slots: slots,
        peers: peers,
        nonces: nonces,
        refused: AtomicU64.create(0),
        unsent: AtomicU64.create(0),
        ticks: AtomicU64.create(0),
        sent: AtomicU64.create(0),
        received: AtomicU64.create(0),
        readIds: AtomicU64.create(0),
        clockSkewMs: clockSkewMs,
        requestPrefix: requestPrefixOf(id),
        websiteDomain: match (copyBytes(sts.websiteDomain.view())) {
            Ok(d) => d,
            Err(_) => { return Err(textOf("out of memory")); }
        },
        domain: match (copyBytes(sts.domain.view())) {
            Ok(d) => d,
            Err(_) => { return Err(textOf("out of memory")); }
        },
        notifyTargets: match (notifyListOf(sts)) {
            Ok(t) => t,
            Err(_) => { return Err(textOf("out of memory")); }
        },
        replication: ReplicaContext {
            targets: match (replicationListOf(sts)) {
                Ok(t) => t,
                Err(_) => { return Err(textOf("out of memory")); }
            },
            sseKeys: match (sharedOr(sts.sseSets.asBorrow(), sts.sseKeys.view())) {
                Ok(k) => k,
                Err(_) => { return Err(textOf("out of memory")); }
            },
            kmsKeys: match (sharedOr(sts.kmsSets.asBorrow(), sts.kmsKeys.view())) {
                Ok(k) => k,
                Err(_) => { return Err(textOf("out of memory")); }
            },
        },
        frontUrl: match (copyBytes(sts.frontUrl.view())) {
            Ok(u) => u,
            Err(_) => { return Err(textOf("out of memory")); }
        },
        credentials: credentials,
        accessLog: AccessLogWriter { lines: sts.accessLines.clone(), everyMs: sts.accessLogEveryMs },
        inventoryDayMs: sts.inventoryDayMs,
        tablesDayMs: sts.tablesDayMs,
        tablesCopyPauseMs: sts.tablesCopyPauseMs,
        requests: AtomicU64.create(0),
        scrubEveryMs: scrubEveryMs,
        codeAfterMs: codeAfterMs,
        scrubChecked: AtomicU64.create(0),
        scrubDamaged: AtomicU64.create(0),
        scrubRepaired: AtomicU64.create(0),
        extentsFetched: AtomicU64.create(0),
    };
    return Ok(NodeParts { shared: shared, internals: internals });
}

fn appendHex2(s: borrow mut String, v: u32) -> Result<void, AllocError> {
    let digits = "0123456789abcdef".bytes();
    var b = [digits[((v >> 4) & 0xF) as usize], digits[(v & 0xF) as usize]];
    s.append(StringView.fromUtf8(b[..])!)?;
    return Ok();
}

/// Where this node reaches its own front: its listening address, or loopback for one that listens on every address.
fn ownFrontAddress(a: SocketAddress) -> SocketAddress {
    return match (a) {
        SocketAddress.V4(ip, port) => if (ip[0] == 0 && ip[1] == 0 && ip[2] == 0 && ip[3] == 0) SocketAddress.V4(
            [127u8, 0, 0, 1],
            port,
        ) else a,
        SocketAddress.V6(ip, port, scope) => {
            var any = true;
            for (i in 0..16) {
                if (ip[i] != 0) { any = false; }
            }
            var loopback = [0u8; 16];
            loopback[15] = 1;
            if (any) SocketAddress.V6(loopback, port, scope) else a
        }
    };
}

/// `a.b.c.d:port` or `[v6]:port`.
fn appendPeerAddress(s: borrow mut String, a: SocketAddress) -> Result<void, AllocError> {
    var out = Vector<u8>.create();
    match (a) {
        SocketAddress.V4(ip, port) => {
            for (i in 0..4) {
                if (i > 0) { out.push(0x2E)?; }
                appendDecimal(mut out, ip[i] as u64)?;
            }
            out.push(0x3A)?;
            appendDecimal(mut out, port as u64)?;
        }
        SocketAddress.V6(ip, port, _) => {
            out.push(0x5B)?;
            for (g in 0..8) {
                if (g > 0) { out.push(0x3A)?; }
                let group = ((ip[g * 2] as u32) << 8) | (ip[g * 2 + 1] as u32);
                appendHexGroup(mut out, group)?;
            }
            out.extend("]:".bytes())?;
            appendDecimal(mut out, port as u64)?;
        }
    }
    s.append(StringView.fromUtf8(out.view())!)?;
    return Ok();
}

fn appendHexGroup(out: borrow mut Vector<u8>, v: u32) -> Result<void, AllocError> {
    let digits = "0123456789abcdef".bytes();
    var started = false;
    var shift = 12u32;
    loop {
        let d = (v >> shift) & 0xF;
        if (d != 0 || started || shift == 0) {
            out.push(digits[d as usize])?;
            started = true;
        }
        if (shift == 0) { break; }
        shift -= 4;
    }
    return Ok();
}

// --- The replicas' work ---

fn drainOf(r: borrow mut ShardReplica, store: borrow mut ObjectStore) -> Result<Vector<RaftMessage>, StoreError> {
    var out = Vector<RaftMessage>.create();
    r.drain(store, mut out)?;
    return Ok(out);
}

fn tickOf(
    r: borrow mut ShardReplica,
    store: borrow mut ObjectStore,
    maintain: bool,
    sseKeys: Slice<MasterKey>,
    iamShard: bool,
) -> Result<Vector<RaftMessage>, StoreError> {
    r.tick()?;
    var out = Vector<RaftMessage>.create();
    r.drain(store, mut out)?;
    if (maintain) {
        r.maintain(store)?;
        // The leader's re-wrap round (ADR-0100 §4), with the node's SSE-S3 keys as they are now.
        let _ = r.rewrap(store, sseKeys)?;
        // The IAM API's hidden bucket, made by its shard's leader (ADR-0104 §3).
        if (iamShard) { r.ensureBucket(store, IAM_BUCKET)?; }
        r.drain(store, mut out)?;
    }
    return Ok(out);
}

/// Puts what a replica of `shard` sends on its peers' queues.
async fn enqueue(shared: borrow NodeShared, shard: u32, messages: Vector<RaftMessage>) -> Result<void, NodeFault> {
    var all = messages;
    while (true) {
        let m = match (all.pop()) {
            Some(m) => m,
            null => { break; }
        };
        for (i in 0..shared.peers.length) {
            if (shared.peers[i].node != m.to) { continue; }
            var guard = match (await shared.peers[i].queue.lock()) {
                Ok(g) => g,
                Err(_) => { return Err(NodeFault.Net); }
            };
            if (guard.data().push(ShardMessage { shard: shard, message: m }).isErr()) {
                return Err(NodeFault.OutOfMemory);
            }
            break;
        }
    }
    return Ok();
}

async fn noteFailure(slot: borrow ShardSlot, e: StoreError) {
    if (slot.failed.swap(1) == 0) {
        var line = textOf("cosmostore: a shard's replica stopped: ");
        let _ = line.append(storeErrorLine(e).view());
        let _ = line.append("\n");
        let _ = await AsyncConsole.writeError(line.view());
    }
}

/// Steps a received message into its shard's replica, and drains it.
async fn deliver(shared: borrow NodeShared, sm: ShardMessage) -> Result<void, NodeFault> {
    for (i in 0..shared.slots.length) {
        let slot = borrow shared.slots[i];
        if (slot.shard != sm.shard) { continue; }
        if (slot.failed.load() != 0) { return Ok(); }
        var guard = match (await slot.replica.lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let r = guard.data();
        match (r.step(sm.message)) {
            Ok() => {}
            Err(e) => {
                await noteFailure(slot, e);
                return Ok();
            }
        }
        var storeGuard = match (await slot.store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let st = storeGuard.data();
        let drained = await Async.blocking(() => drainOf(r, st));
        match (drained) {
            Ok(out) => { return await enqueue(shared, slot.shard, out); }
            Err(e) => { await noteFailure(slot, e); }
        }
        return Ok();
    }
    return Ok(); // not a shard of this node: a stale sender
}

/// A tick of one replica that took this long is logged, with where the time went.
const SLOW_TICK_MS: i64 = 1000;

async fn noteSlowTick(shard: u32, replicaMs: i64, storeMs: i64, workMs: i64) {
    var line = textOf("cosmostore: a slow tick of shard ");
    let _ = line.appendNumber(shard as i64);
    let _ = line.append(": ");
    let _ = line.appendNumber(replicaMs);
    let _ = line.append(" ms for its replica's lock, ");
    let _ = line.appendNumber(storeMs);
    let _ = line.append(" for its store's, ");
    let _ = line.appendNumber(workMs);
    let _ = line.append(" working\n");
    let _ = await AsyncConsole.writeError(line.view());
}

/// Ticks every replica every NODE_TICK_MS, and runs their upkeep every NODE_MAINTAIN_TICKS.
async fn tickForever(shared: borrow NodeShared) -> Result<void, NodeFault> {
    while (true) {
        match (await Timer.sleep(NODE_TICK_MS)) {
            Ok() => {}
            Err(_) => { return Err(NodeFault.Net); }
        }
        let tick = shared.ticks.fetchAdd(1) + 1;
        let maintain = tick % NODE_MAINTAIN_TICKS == 0;
        for (i in 0..shared.slots.length) {
            let slot = borrow shared.slots[i];
            if (slot.failed.load() != 0) { continue; }
            let t0 = Clock.unixMillis();
            var guard = match (await slot.replica.lock()) {
                Ok(g) => g,
                Err(_) => { return Err(NodeFault.Net); }
            };
            let r = guard.data();
            let t1 = Clock.unixMillis();
            var storeGuard = match (await slot.store.get().lock()) {
                Ok(g) => g,
                Err(_) => { return Err(NodeFault.Net); }
            };
            let st = storeGuard.data();
            let t2 = Clock.unixMillis();
            // A leader re-wraps only under a first key every node was seen to hold (the M17 exit review).
            let held = shared.replication.sseKeys.get().view();
            let gate = shared.rewrapTag.load();
            let keys: Slice<MasterKey> = if (held.length > 0 && gate != 0 && keyTag(
                shared.secret.view(),
                borrow held[0],
            ) == gate) held
                else held[0..0];
            let iamShard = slot.shard == shardOfBucket(borrow shared.file, IAM_BUCKET.bytes());
            let ticked = await Async.blocking(() => tickOf(r, st, maintain, keys, iamShard));
            let t3 = Clock.unixMillis();
            if (t3 - t0 > SLOW_TICK_MS) { await noteSlowTick(slot.shard, t1 - t0, t2 - t1, t3 - t2); }
            match (ticked) {
                Ok(out) => { await enqueue(shared, slot.shard, out)?; }
                Err(e) => { await noteFailure(slot, e); }
            }
        }
    }
    return Ok();
}

/// The first half of this node's write request ids: its id, and a random number for this start of it.
fn requestPrefixOf(id: u32) -> u64 {
    var r = [0u8; 4];
    let _ = Random.fill(mut r[..]);
    return (id as u64) | ((r[..].readLE<u32>(0) as u64) << 32);
}

/// The time this node signs and checks peer requests by: the machine's, off by `--clock-skew-ms` (ADR-0065 §7).
fn peerNow(shared: borrow NodeShared) -> i64 => Clock.unixMillis() + shared.clockSkewMs;

/// The signed headers of a request from this node (or the operator, node 0).
fn signRequest(
    request: borrow mut ClientRequest,
    file: borrow ClusterFile,
    secret: Slice<u8>,
    node: u32,
    method: StringView,
    path: StringView,
    body: Slice<u8>,
    time: i64,
) -> bool {
    var nonce = [0u8; 16];
    if (Random.fill(mut nonce[..]).isErr()) { return false; }
    let signature = match (peerSignature(secret, method, path, file.digest[..], node, time, nonce[..], body)) {
        Ok(s) => s,
        Err(_) => { return false; }
    };
    var cluster = Vector<u8>.create();
    var sender = Vector<u8>.create();
    var when = Vector<u8>.create();
    var nonceHex = Vector<u8>.create();
    var signatureHex = Vector<u8>.create();
    let built = appendHexBytes(mut cluster, file.digest[..]).isOk() && appendDecimal(mut sender, node as u64).isOk() &&
        appendDecimal(mut when, truncate<u64>(time)).isOk() && appendHexBytes(mut nonceHex, nonce[..]).isOk() &&
        appendHexBytes(mut signatureHex, signature[..]).isOk();
    return built && request.header("x-cosmo-cluster", cluster.view()).isOk() &&
        request.header("x-cosmo-node", sender.view()).isOk() && request.header("x-cosmo-time", when.view()).isOk() &&
        request.header("x-cosmo-nonce", nonceHex.view()).isOk() &&
        request.header("x-cosmo-signature", signatureHex.view()).isOk();
}

/// Posts batch `body` to `url`, signed; whether the peer took it (204).
async fn postBatch(client: borrow Client, shared: borrow NodeShared, url: StringView, body: Slice<u8>) -> bool {
    var request = match (ClientRequest.create(Method.Post, url)) {
        Ok(r) => r,
        Err(_) => { return false; }
    };
    if (!signRequest(
        mut request,
        borrow shared.file,
        shared.secret.view(),
        shared.id,
        "POST",
        "/raft",
        body,
        peerNow(shared),
    )) {
        return false;
    }
    var content = match (BytesBody.of(body)) {
        Ok(b) => b,
        Err(_) => { return false; }
    };
    var response = match (await client.send(request, mut content)) {
        Ok(r) => r,
        Err(_) => { return false; }
    };
    let status = response.status();
    var answer = Vector<u8>.create();
    let _ = await response.readToEnd(mut answer, 65536);
    let _ = await response.finish(client);
    return status == 204;
}

/// Sends peer `at`'s queue as batches, one request at a time, for as long as the node runs.
async fn sendForever(shared: borrow NodeShared, at: usize) -> Result<void, NodeFault> {
    var options = ClientOptions.defaults();
    options.totalMs = 30000;
    options.retry = RetryPolicy.never();
    let client = match (Client.create(options, null)) {
        Ok(c) => c,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    let link = borrow shared.peers[at];
    while (true) {
        var batch = Vector<ShardMessage>.create();
        {
            var guard = match (await link.queue.lock()) {
                Ok(g) => g,
                Err(_) => { return Err(NodeFault.Net); }
            };
            let q = guard.data();
            while (true) {
                match (q.pop()) {
                    Some(m) => {
                        if (batch.push(m).isErr()) { return Err(NodeFault.OutOfMemory); }
                    }
                    null => { break; }
                }
            }
            reverseShardMessages(mut batch);
        }
        if (batch.length == 0) {
            match (await Timer.sleep(NODE_SEND_IDLE_MS)) {
                Ok() => {}
                Err(_) => { return Err(NodeFault.Net); }
            }
            continue;
        }
        var body = Vector<u8>.create();
        if (encodeBatch(mut body, batch.view()).isErr()) { return Err(NodeFault.OutOfMemory); }
        if (await postBatch(borrow client, shared, link.url.view(), body.view())) {
            let _ = shared.sent.fetchAdd(1);
        } else {
            let _ = shared.unsent.fetchAdd(1);
            match (await Timer.sleep(NODE_SEND_RETRY_MS)) {
                Ok() => {}
                Err(_) => { return Err(NodeFault.Net); }
            }
        }
    }
    return Ok();
}

// --- The peer port ---

/// A header's value, copied; empty when absent.
fn headerCopy(request: borrow Request, name: StringView) -> Vector<u8> {
    var out = Vector<u8>.create();
    let fields = request.headers();
    for (i in 0..fields.count()) {
        let n = fields.nameBytes(i);
        if (n.length != name.length) { continue; }
        var same = true;
        for (k in 0..n.length) {
            if (lowerAscii(n[k]) != name.bytes()[k]) { same = false; }
        }
        if (same) {
            let _ = out.extend(fields.value(i));
            return out;
        }
    }
    return out;
}

/// One line per replica: shard, role, term, leader, last, commit, applied.
async fn statusText(shared: borrow NodeShared) -> Result<Vector<u8>, NodeFault> {
    var out = Vector<u8>.create();
    let ok = out.extend("shard role term leader last commit applied voters learners\n".bytes()).isOk();
    if (!ok) { return Err(NodeFault.OutOfMemory); }
    // Before the counts below (ADR-0106 §1.1, the M20 exit review): a key shown retiring here was retired before any
    // count was taken, and a leader checks a write's key and commits it under one hold of the store's lock, so no
    // count misses a write sealed under it.
    // The master keys the node holds now, by id and a tag of their bytes (ADR-0100 §4, the M17 exit review): a leader
    // re-wraps only under a key every node holds, and a removal waits for every node to stop putting the key first.
    for (mode in ["s3", "kms"]) {
        let keys =
            if (mode == "s3") shared.replication.sseKeys.get().view() else shared.replication.kmsKeys.get().view();
        var line = out.extend("# keys ".bytes()).isOk() && out.extend(mode.bytes()).isOk() && out.push(0x20).isOk();
        for (i in 0..keys.length) {
            if (i > 0) { line = line && out.push(',').isOk(); }
            line = line && out.extend(keys[i].id.view()).isOk() && out.push(':').isOk() &&
                appendDecimal(mut out, keyTag(shared.secret.view(), borrow keys[i])).isOk();
            // A KMS key being removed (ADR-0106 §1.1): a removal's count waits until every node has it so.
            if (keys[i].retiring) { line = line && out.extend(":retiring".bytes()).isOk(); }
        }
        if (!(line && out.push(0x0A).isOk())) { return Err(NodeFault.OutOfMemory); }
    }
    for (i in 0..shared.slots.length) {
        let slot = borrow shared.slots[i];
        var guard = match (await slot.replica.lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let r = guard.data();
        var storeGuard = match (await slot.store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let st = storeGuard.data();
        let role = if (slot.failed.load() != 0) "failed" else match (r.core.role) {
            RAFT_LEADER => "leader",
            RAFT_CANDIDATE => "candidate",
            RAFT_PRE_CANDIDATE => "precandidate",
            _ => "follower",
        };
        let line = appendDecimal(mut out, slot.shard as u64).isOk() && out.push(0x20).isOk() &&
            out.extend(role.bytes()).isOk() && out.push(0x20).isOk() && appendDecimal(mut out, r.core.term).isOk() &&
            out.push(0x20).isOk() && appendDecimal(mut out, r.core.leader as u64).isOk() && out.push(0x20).isOk() &&
            appendDecimal(mut out, r.core.lastIndex()).isOk() && out.push(0x20).isOk() &&
            appendDecimal(mut out, r.core.commit).isOk() && out.push(0x20).isOk() &&
            appendDecimal(mut out, st.appliedIndex()).isOk() && out.push(0x20).isOk() &&
            appendIdList(mut out, r.core.members.voters.view()).isOk() && out.push(0x20).isOk() &&
            appendIdList(mut out, r.core.members.learners.view()).isOk() && out.push(0x0A).isOk();
        if (!line) { return Err(NodeFault.OutOfMemory); }
        // What still needs each master key, from the shards this node leads (ADR-0100 §4).
        if (slot.failed.load() == 0 && r.core.role == RAFT_LEADER) {
            // Only a leader caught up, with an entry of its own term committed and applied to `commit`, counts (the
            // M17 exit review): one just elected may hold committed entries it has not applied.
            let caughtUp = r.core.termAt(r.core.commit) == Some(r.core.term) && st.appliedIndex() >= r.core.commit;
            let report = if (!caughtUp) null else match (await Async.blocking(() => st.sealedReport())) {
                Ok(rep) => rep,
                Err(_) => null,
            };
            let reported = match (report) {
                Some(text) => {
                    var fine = true;
                    let all = StringView.fromUtf8(text.view()) ?? "";
                    for (piece in all.split("\n")) {
                        if (piece.length == 0) { continue; }
                        fine = fine && out.extend("# sealed ".bytes()).isOk() && appendDecimal(
                            mut out,
                            slot.shard as u64,
                        ).isOk() &&
                            out.push(0x20).isOk() && out.extend(piece.bytes()).isOk() && out.push(0x0A).isOk();
                    }
                    fine && out.extend("# sealed-led ".bytes()).isOk() && appendDecimal(
                        mut out,
                        slot.shard as u64,
                    ).isOk() && out.push(0x20).isOk() && appendDecimal(mut out, r.core.term).isOk() &&
                        out.push(0x0A).isOk()
                }
                null => out.extend("# sealed-unknown ".bytes()).isOk() && appendDecimal(
                    mut out,
                    slot.shard as u64,
                ).isOk() &&
                    out.push(0x0A).isOk(),
            };
            if (!reported) { return Err(NodeFault.OutOfMemory); }
        }
    }
    // The node's scrub (ADR-0063 §4).
    let scrub = out.extend("# scrub ".bytes()).isOk() && appendDecimal(mut out, shared.scrubChecked.load()).isOk() &&
        out.push(0x20).isOk() && appendDecimal(mut out, shared.scrubDamaged.load()).isOk() &&
        out.push(0x20).isOk() && appendDecimal(mut out, shared.scrubRepaired.load()).isOk() &&
        out.push(0x20).isOk() && appendDecimal(mut out, shared.extentsFetched.load()).isOk() &&
        out.push(0x0A).isOk();
    if (!scrub) { return Err(NodeFault.OutOfMemory); }
    // The peer port's traffic: ticks, batches sent, not sent, taken, requests refused.
    let peer = out.extend("# peer ".bytes()).isOk() && appendDecimal(mut out, shared.ticks.load()).isOk() &&
        out.push(0x20).isOk() && appendDecimal(mut out, shared.sent.load()).isOk() && out.push(0x20).isOk() &&
        appendDecimal(mut out, shared.unsent.load()).isOk() && out.push(0x20).isOk() &&
        appendDecimal(mut out, shared.received.load()).isOk() && out.push(0x20).isOk() &&
        appendDecimal(mut out, shared.refused.load()).isOk() && out.push(0x0A).isOk();
    if (!peer) { return Err(NodeFault.OutOfMemory); }
    // The digests of the files the node was given (ADR-0096 §6), read now.
    let secret = shared.secret.view();
    let files = shared.files.view();
    // The key files' digests are of the keys the node holds (ADR-0106 §2): a reload it refused shows as a difference.
    var inUse = Vector<InUseDigest>.create();
    for (kind in ["sse-key-file", "kms-key-file"]) {
        let keys =
            if (kind == "sse-key-file") shared.replication.sseKeys.get().view()
                else shared.replication.kmsKeys.get().view();
        match (keysDigest(secret, kind, keys)) {
            Ok(d) => {
                if (inUse.push(d).isErr()) { return Err(NodeFault.OutOfMemory); }
            }
            Err(_) => { return Err(NodeFault.OutOfMemory); }
        }
    }
    let used = inUse.view();
    let digests = await Async.blocking(() => fileDigestLines(secret, files, used));
    match (digests) {
        Ok(d) => {
            if (out.extend(d.view()).isErr()) { return Err(NodeFault.OutOfMemory); }
        }
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    }
    return Ok(out);
}

impl Handler<NodeApp> for PeerHandler {
    async fn handle(
        borrow this,
        ctx: borrow mut RequestContext<NodeApp>,
        request: borrow Request,
        exchange: borrow mut Exchange,
    ) -> Result<void, HandlerError> {
        let shared = ctx.state().shared.get();
        let path = request.path();
        let isRaft = request.method() == Method.Post && path == "/raft";
        let isStatus = request.method() == Method.Get && path == "/cluster/status";
        // The IAM API's records, for a node that holds no replica of their shard (ADR-0104 §4): signed as a peer's,
        // as they hold secrets.
        let isIam = request.method() == Method.Get && path == "/cluster/iam";
        // A client's S3 request forwarded by another node to this one as the shard's leader (ADR-0060 §4).
        let isS3 = request.method() == Method.Post && path == "/s3";
        // An extent pushed by a leader, or asked for by a replica that lacks it (ADR-0061 §2, §3).
        let isExtent = request.method() == Method.Post && path == "/extent";
        let isFetch = request.method() == Method.Post && path == "/extent-fetch";
        // An operator's change of the active nodes (ADR-0062 §5).
        let isActive = request.method() == Method.Post && path == "/cluster/active";
        // A replica's own copy of a record another replica found damaged (ADR-0063 §3).
        let isRecord = request.method() == Method.Post && path == "/record-fetch";
        // A piece of a coded extent another replica needs (ADR-0064 §4, §5).
        let isPiece = request.method() == Method.Post && path == "/piece-fetch";
        // An access point's name claimed, let go or looked up in group 0, by another node's front (ADR-0078 §5).
        let isClaim = request.method() == Method.Post && path == CLAIM_PATH;
        if (!isRaft && !isStatus && !isIam && !isS3 && !isExtent && !isFetch && !isActive && !isRecord && !isPiece &&
            !isClaim) {
            return await exchange.send(Status.notFound(), "".bytes());
        }
        // The body, whole: a batch is decoded only once its signature holds.
        var body = Vector<u8>.create();
        var buf = Vector<u8>.create();
        if (buf.resize(65536, 0).isErr()) { return Err(HandlerError.Internal); }
        while (true) {
            let n = await exchange.read(mut buf.viewMut()[..])?;
            if (n == 0) { break; }
            if ((body.length + n) as u64 > NODE_MAX_BODY) { return await exchange.send(statusOf(413), "".bytes()); }
            if (body.extend(buf.view()[0..n]).isErr()) { return Err(HandlerError.Internal); }
        }
        let headers = PeerHeaders {
            cluster: headerCopy(request, "x-cosmo-cluster"),
            node: headerCopy(request, "x-cosmo-node"),
            time: headerCopy(request, "x-cosmo-time"),
            nonce: headerCopy(request, "x-cosmo-nonce"),
            signature: headerCopy(request, "x-cosmo-signature"),
        };
        let method = if (isStatus || isIam) "GET" else "POST";
        var checked: Result<u32, PeerRefusal> = Err(PeerRefusal.Malformed);
        {
            var guard = match (await shared.nonces.lock()) {
                Ok(g) => g,
                Err(_) => { return Err(HandlerError.Internal); }
            };
            checked = checkPeerRequest(
                borrow shared.file,
                shared.secret.view(),
                shared.id,
                isStatus || isActive || isIam, // the operator's signature is what nodes' asks carry
                method,
                path,
                borrow headers,
                body.view(),
                peerNow(shared),
                mut guard.data(),
            );
        }
        if (checked.isErr()) {
            let _ = shared.refused.fetchAdd(1);
            return await exchange.send(statusOf(403), "".bytes());
        }
        if (isPiece) {
            return match (await pieceFor(shared, body.view())) {
                Some(bytes) => await exchange.send(Status.ok(), bytes.view()),
                null => await exchange.send(Status.notFound(), "".bytes()),
            };
        }
        if (isRecord) {
            return match (await recordFor(shared, body.view())) {
                Some(bytes) => await exchange.send(Status.ok(), bytes.view()),
                null => await exchange.send(Status.notFound(), "".bytes()),
            };
        }
        if (isClaim) {
            let answer = match (await changeClaim(shared, body.view())) {
                Ok(a) => a,
                Err(_) => claimAnswer(500),
            };
            return await exchange.send(statusOf(answer.status), answer.body.view());
        }
        if (isActive) {
            let status = match (await changeActive(shared, body.view())) {
                Ok(s) => s,
                Err(_) => 500u16,
            };
            return await exchange.send(statusOf(status), "".bytes());
        }
        if (isIam) {
            return match (await localIamRecord(shared)) {
                Some(bytes) => await exchange.send(Status.ok(), bytes.view()),
                null => await exchange.send(Status.notFound(), "".bytes()),
            };
        }
        if (isStatus) {
            let text = match (await statusText(shared)) {
                Ok(t) => t,
                Err(_) => { return Err(HandlerError.Internal); }
            };
            return await exchange.send(Status.ok(), text.view());
        }
        if (isExtent || isFetch) {
            if (body.length < 12) { return await exchange.send(Status.badRequest(), "".bytes()); }
            let shard = body.view().readLE<u32>(0);
            let id = body.view().readLE<u64>(4);
            let at = match (slotOf(shared, shard)) {
                Some(i) => i,
                null => { return await exchange.send(Status.notFound(), "".bytes()); }
            };
            // The store's lock only for the store's part: the answer is sent without it, since a slow or cut-off
            // peer would hold it until the send gave up.
            var installed = false;
            var found: Vector<u8>? = null;
            {
                var storeGuard = match (await shared.slots[at].store.get().lock()) {
                    Ok(g) => g,
                    Err(_) => { return Err(HandlerError.Internal); }
                };
                let st = storeGuard.data();
                if (isExtent) {
                    let file = body.view()[12..body.length];
                    installed = (await Async.blocking(() => st.installExtent(id, file))).isOk();
                } else {
                    found = (await Async.blocking(() => st.extentFileBytes(id))).ok();
                }
            }
            if (isExtent) {
                if (installed) { return await exchange.send(Status.noContent(), "".bytes()); }
                return await exchange.send(statusOf(500), "".bytes());
            }
            return match (found) {
                Some(bytes) => await exchange.send(Status.ok(), bytes.view()),
                null => await exchange.send(Status.notFound(), "".bytes()),
            };
        }
        if (isS3) {
            if (body.length < 4) { return await exchange.send(Status.badRequest(), "".bytes()); }
            let shard = body.view().readLE<u32>(0);
            let raw = match (decodeRaw(body.view()[4..body.length])) {
                Ok(r) => r,
                Err(_) => { return await exchange.send(Status.badRequest(), "".bytes()); }
            };
            let answer = match (await leadRequest(shared, shard, borrow raw)) {
                Ok(a) => a,
                Err(_) => { return Err(HandlerError.Internal); }
            };
            if (answer.status == 421) { return await exchange.send(statusOf(421), "".bytes()); }
            var encoded = Vector<u8>.create();
            if (encodeRaw(mut encoded, borrow answer).isErr()) { return Err(HandlerError.Internal); }
            return await exchange.send(Status.ok(), encoded.view());
        }
        var batch = match (decodeBatch(body.view())) {
            Ok(b) => b,
            Err(_) => { return await exchange.send(Status.badRequest(), "".bytes()); }
        };
        let _ = shared.received.fetchAdd(1);
        reverseShardMessages(mut batch);
        while (true) {
            let sm = match (batch.pop()) {
                Some(m) => m,
                null => { break; }
            };
            match (await deliver(shared, sm)) {
                Ok() => {}
                Err(_) => { return Err(HandlerError.Internal); }
            }
        }
        return await exchange.send(Status.noContent(), "".bytes());
    }
}

fn reverseShardMessages(v: borrow mut Vector<ShardMessage>) {
    if (v.length < 2) { return; }
    var i = 0usize;
    var j = v.length - 1;
    while (i < j) {
        v.swap(i, j);
        i += 1;
        j -= 1;
    }
}

fn peerHandler() -> Result<Box<dyn Handler<NodeApp> + Send + Share>, RouteError> {
    match (Box.create(PeerHandler {})) {
        Ok(h) => {
            let d: Box<dyn Handler<NodeApp> + Send + Share> = h;
            return Ok(d);
        }
        Err(_) => { return Err(RouteError.OutOfMemory); }
    }
}

/// The peer port, the tick, and a sender per peer, until one fails.
/// How often a node looks at its credentials and users files (ADR-0092 §1).
const CREDENTIALS_EVERY_MS: u64 = 2000;

/// The node's credentials and users files, reloaded as `serve` reloads its own whenever either changes: a key or a
/// user removed is refused at the node's next request, without a restart (ADR-0092 §1).
async fn credentialsForever(rotation: Rotation, shared: borrow NodeShared) -> Result<void, NodeFault> {
    var r = rotation;
    var cycle: u64 = 0;
    var iamSeen: u64 = 0;
    while (true) {
        if (!(await frontPause(CREDENTIALS_EVERY_MS))) { return Err(NodeFault.Net); }
        // Every fifth cycle (10 s): whether every node holds this node's first SSE-S3 key, for its leaders' re-wraps.
        cycle += 1;
        if (cycle % 5 == 0) { shared.rewrapTag.store(await rewrapGate(shared)); }
        // The IAM API's records, from the node's replica of their shard or a peer's (ADR-0104 §4).
        // Never older than one already taken (the M19 exit review): a lagging replica would bring a deleted key back.
        var iam = await nodeIamSnapshot(shared);
        let newest = match (borrow iam) {
            Some(s) => s.generation >= iamSeen,
            null => false,
        };
        if (newest) {
            iamSeen = match (borrow iam) {
                Some(s) => s.generation,
                null => iamSeen,
            };
        } else {
            iam = null;
        }
        await reloadCredentialsIfChanged(mut r, iam.asBorrow());
        await reloadNodeKeysIfChanged(mut r, shared);
        await reloadTargetsIfChanged(mut r);
    }
    return Ok();
}

/// A key's tag: the first 8 bytes of HMAC-SHA256 under the cluster's secret of its id and bytes, so nodes can tell
/// they hold the same key without showing it (never 0).
fn keyTag(secret: Slice<u8>, key: borrow MasterKey) -> u64 {
    var mac = HmacSha256.create(secret);
    mac.update("cosmostore key tag\n".bytes());
    mac.update(key.id.view());
    mac.update(":".bytes());
    let m = key.material();
    mac.update(m.b[..]);
    let d = mac.finish();
    let tag = d[..].readLE<u64>(0);
    return if (tag == 0) 1 else tag;
}

/// Every node's status, or null when one does not answer (the M17 exit review: a node not heard from may lead a shard
/// whose counts are not known, or hold a key first).
async fn everyStatus(shared: borrow NodeShared) -> Vector<Vector<u8>>? {
    var all = Vector<Vector<u8>>.create();
    for (i in 0..shared.file.nodes.length) {
        var url = textOf("http://");
        if (appendPeerAddress(mut url, shared.file.nodes[i].peer).isErr() || url.append("/cluster/status").isErr()) {
            return null;
        }
        var answer = Vector<u8>.create();
        let status = match (await askStatusWith(borrow shared.file, shared.secret.view(), url.view(), mut answer)) {
            Ok(s) => s,
            Err(_) => 0u16,
        };
        if (status != 200 || all.push(answer).isErr()) { return null; }
    }
    return Some(all);
}

// ---- The IAM API's records on a cluster (ADR-0104 §4) ----

/// The records from this node's replica of their shard, as `<generation>\n<record>`; null when it holds none, or they
/// do not read.
async fn localIamRecord(shared: borrow NodeShared) -> Vector<u8>? {
    let snapshot = await localIamSnapshot(shared) ?? { return null; };
    var out = Vector<u8>.create();
    if (appendDecimal(mut out, snapshot.generation).isErr() || out.push(0x0A).isErr()) { return null; }
    let bytes = encodeIamState(borrow snapshot.state).ok() ?? { return null; };
    if (out.extend(bytes.view()).isErr()) { return null; }
    return Some(out);
}

/// The records from this node's replica of their shard, if it holds one.
async fn localIamSnapshot(shared: borrow NodeShared) -> IamSnapshot? {
    let shard = shardOfBucket(borrow shared.file, IAM_BUCKET.bytes());
    let at = slotOf(shared, shard) ?? { return null; };
    return await readIamSnapshot(borrow shared.slots[at].store);
}

/// The records as every node's sets take them: from its own replica of their shard, or else from a peer that holds
/// one (signed, as status asks are). Null when none answers: the sets in use stay.
async fn nodeIamSnapshot(shared: borrow NodeShared) -> IamSnapshot? {
    match (await localIamSnapshot(shared)) {
        Some(s) => { return Some(s); }
        null => {}
    }
    for (i in 0..shared.file.nodes.length) {
        if (shared.file.nodes[i].id == shared.id) { continue; }
        var url = textOf("http://");
        if (appendPeerAddress(mut url, shared.file.nodes[i].peer).isErr() || url.append("/cluster/iam").isErr()) {
            return null;
        }
        var answer = Vector<u8>.create();
        let status = match (await askPathWith(
            borrow shared.file,
            shared.secret.view(),
            url.view(),
            "/cluster/iam",
            mut answer,
        )) {
            Ok(s) => s,
            Err(_) => 0u16,
        };
        if (status != 200) { continue; }
        let text = answer.view();
        var end: usize = 0;
        while (end < text.length && text[end] != 0x0A) { end += 1; }
        if (end >= text.length) { continue; }
        let generation = (StringView.fromUtf8(text[0..end]) ?? "").parseInt<u64>() ?? { continue; };
        let state = match (decodeIamState(text[end + 1..])) {
            Ok(Some(s)) => s,
            _ => { continue; }
        };
        Secret.wipe(mut answer[..]); // the records hold secrets
        return Some(IamSnapshot { state: state, generation: generation });
    }
    return null;
}

/// What still needs the keys `ids` (envelopes of `mode`) across the cluster (ADR-0100 §4, as the M17 exit review
/// amended it). Null, not known, unless every node answers; every shard has a leader of the shard's highest term seen
/// that reported its counts caught up; and, for SSE-S3, no node has one of `ids` first.
async fn clusterSealedUnder(shared: borrow NodeShared, mode: StringView, ids: Slice<Vector<u8>>) -> u64? {
    let statuses = await everyStatus(shared) ?? { return null; };
    var shards = Vector<u32>.create();
    var highest = Vector<u64>.create();
    var ledShard = Vector<u32>.create();
    var ledTerm = Vector<u64>.create();
    var total: u64 = 0;
    for (s in 0..statuses.length) {
        let text = StringView.fromUtf8(statuses[s].view()) ?? "";
        for (line in text.split("\n")) {
            if (line.length == 0) { continue; }
            var words = Vector<StringView>.create();
            for (w in line.split(" ")) {
                if (words.push(w).isErr()) { return null; }
            }
            if (line.startsWith("# sealed-unknown ")) { return null; }
            // A replica's line, `shard role term …`: the highest term each shard has.
            if (!line.startsWith("#") && !line.startsWith("shard")) {
                if (words.length < 3) { continue; }
                let shard = words[0].parseInt<u32>() ?? { continue; };
                let term = words[2].parseInt<u64>() ?? { continue; };
                var found = false;
                for (k in 0..shards.length) {
                    if (shards[k] == shard) {
                        found = true;
                        if (term > highest[k]) { highest[k] = term; }
                    }
                }
                if (!found && (shards.push(shard).isErr() || highest.push(term).isErr())) { return null; }
                continue;
            }
            if (line.startsWith("# sealed-led ") && words.length >= 4) {
                let shard = words[2].parseInt<u32>() ?? { continue; };
                let term = words[3].parseInt<u64>() ?? { continue; };
                if (ledShard.push(shard).isErr() || ledTerm.push(term).isErr()) { return null; }
                continue;
            }
            // A node that has a dropped SSE-S3 key first still seals new versions under it.
            if (mode == "s3" && line.startsWith("# keys s3 ") && words.length >= 4) {
                var first = words[3];
                match (first.indexOf(",")) {
                    Some(c) => { first = first[0..c]; }
                    null => {}
                }
                var id = first;
                match (first.indexOf(":")) {
                    Some(c) => { id = first[0..c]; }
                    null => {}
                }
                for (d in 0..ids.length) {
                    if (id.bytes() == ids[d].view()) { return null; }
                }
                continue;
            }
            // A node that still seals under a dropped KMS key (it has not retired it, ADR-0106 §1.1): its count would
            // not stay at 0.
            if (mode == "kms" && line.startsWith("# keys kms ")) {
                let list = StringView.fromUtf8(line.bytes()[11..]) ?? "";
                for (entry in list.split(",")) {
                    if (entry.length == 0) { continue; }
                    var id = entry;
                    match (entry.indexOf(":")) {
                        Some(c) => { id = entry[0..c]; }
                        null => {}
                    }
                    for (d in 0..ids.length) {
                        if (id.bytes() == ids[d].view() && !entry.endsWith(":retiring")) { return null; }
                    }
                }
                continue;
            }
            if (!line.startsWith("# sealed ") || words.length < 5) { continue; }
            // `# sealed <shard> <prefix> <n>` or `# sealed <shard> kms-default <id> <n>`.
            let n = words[words.length - 1].parseInt<u64>() ?? { continue; };
            for (d in 0..ids.length) {
                var prefix = textOf("v1.");
                if (prefix.append(mode).isErr() || prefix.append(".").isErr() ||
                    prefix.append(StringView.fromUtf8(ids[d].view()) ?? "").isErr() || prefix.append(".").isErr()) {
                    return null;
                }
                let matches = words[3] == prefix.view() ||
                    (mode == "kms" && words[3] == "kms-default" && words.length >= 6 &&
                        words[4].bytes() == ids[d].view());
                if (matches) { total += n; }
            }
        }
    }
    for (shard in 0..shared.file.shards) {
        var top: u64 = 0;
        for (k in 0..shards.length) {
            if (shards[k] == shard) { top = highest[k]; }
        }
        var current = false;
        for (j in 0..ledShard.length) {
            if (ledShard[j] == shard && ledTerm[j] == top) { current = true; }
        }
        if (!current) { return null; }
    }
    return Some(total);
}

/// Whether every node holds this node's first SSE-S3 key (ADR-0100 §4, the M17 exit review): its tag when so, the
/// tag a leader re-wraps under; 0 when not, or when a node did not answer.
async fn rewrapGate(shared: borrow NodeShared) -> u64 {
    let keys = shared.replication.sseKeys.get().view();
    if (keys.length == 0) { return 0; }
    let tag = keyTag(shared.secret.view(), borrow keys[0]);
    var want = Vector<u8>.create();
    if (want.extend(keys[0].id.view()).isErr() || want.push(':').isErr() || appendDecimal(mut want, tag).isErr()) {
        return 0;
    }
    let statuses = await everyStatus(shared) ?? { return 0; };
    for (s in 0..statuses.length) {
        let text = StringView.fromUtf8(statuses[s].view()) ?? "";
        var holds = false;
        for (line in text.split("\n")) {
            if (!line.startsWith("# keys s3 ")) { continue; }
            let list = StringView.fromUtf8(line.bytes()[10..]) ?? "";
            for (entry in list.split(",")) {
                if (entry.bytes() == want.view()) { holds = true; }
            }
        }
        if (!holds) { return 0; }
    }
    return tag;
}

/// The wait before a waiting removal asks the cluster again: 2 s first, then doubling, to a minute (ADR-0106 §2).
fn nextAskWait(lastMs: i64) -> i64 => if (lastMs <= 0) 2000 else if (lastMs >= 30000) 60000 else lastMs * 2;

/// The keys `ids` marked retiring in the file's set, with `fresh`'s new keys (ADR-0106 §1.1), on a worker thread (the
/// set's cell is a lock): 0 when taken, 1 out of memory, 2 when every cell is used.
fn retireKeys(k: borrow KeyRotation, ids: Slice<Vector<u8>>, fresh: Slice<MasterKey>) -> u8 {
    let retired = retiringSet(k.sets.get().view(), ids, fresh).ok() ?? { return 1; };
    return if (k.sets.get().replace(retired)) 0 else 2;
}

/// The node's key files reloaded (ADR-0096 §3, §6). A master key may be added, but a reload that removes or changes
/// one is refused (the M15 exit review): the node cannot count what the cluster still seals under it, since shards it
/// holds no replica of, entries not yet applied, and other nodes reloading on their own time all escape its count. A
/// key is retired by restarting the nodes with the new file, after re-sealing what it sealed. STS keys are taken.
async fn reloadNodeKeysIfChanged(r: borrow mut Rotation, shared: borrow NodeShared) {
    for (i in 0..r.keyFiles.length) {
        let k = borrow mut r.keyFiles[i];
        match (await Async.blocking(() => keyFileChange(k))) {
            KeyChange.Unchanged => {}
            KeyChange.Failed(message) => {
                let _ = await AsyncConsole.writeError(
                    "cosmostore: a key file reload failed, keeping the keys in use: ",
                );
                let _ = await AsyncConsole.writeError(message.view());
                let _ = await AsyncConsole.writeError("\n");
            }
            KeyChange.Fresh(fresh, dropped, modified) => {
                let mode = keyFileMode(k.kind);
                // A removal that waits asks the cluster less often as it goes on (ADR-0106 §2): 2 s, doubling to a
                // minute; a file changed since starts it over.
                let now = Clock.unixMillis();
                if (modified != k.waiting) {
                    k.askAtMs = 0;
                    k.askEveryMs = 0;
                } else if (now < k.askAtMs) {
                    continue;
                }
                // A KMS key is retired first (ADR-0106 §1.1, the owner's choice): this node seals nothing new under
                // it, and the count below waits until every node says the same.
                if (mode == "kms" && dropped.length > 0 && !allRetiring(k.sets.get().view(), dropped.view())) {
                    let ids = dropped.view();
                    let adds = fresh.view();
                    let taken = await Async.blocking(() => retireKeys(k, ids, adds));
                    if (taken == 1) { continue; } // out of memory: tried again next cycle
                    if (taken == 2) {
                        await refuseKeys(
                            k,
                            modified,
                            "the keys were reloaded too many times; restart to reload",
                            0,
                            borrow dropped,
                        );
                        continue;
                    }
                    var line = String.create();
                    let _ = line.append("cosmostore: ");
                    let _ = line.append(keyFileWhat(k.kind));
                    let _ = line.append(" reload: ");
                    let _ = line.append(StringView.fromUtf8(dropped[0].view()) ?? "?");
                    let _ = line.append(
                        " retiring, sealing nothing new; removed once the cluster holds nothing under it\n",
                    );
                    let _ = await AsyncConsole.writeError(line.view());
                    continue;
                }
                if (mode.length > 0 && dropped.length > 0) {
                    // Every shard's leader is asked what still needs the keys dropped (ADR-0100 §4, the owner's
                    // choice); the removal is taken only when every shard answers none.
                    match (await clusterSealedUnder(shared, mode, dropped.view())) {
                        Some(0) => {}
                        Some(n) => {
                            // Still needed: the removal waits, tried again each cycle, so it is taken once the
                            // leaders' re-wraps have moved what the key sealed (ADR-0100 §4); said once.
                            k.askEveryMs = nextAskWait(k.askEveryMs);
                            k.askAtMs = now + k.askEveryMs;
                            if (k.waiting != modified) {
                                k.waiting = modified;
                                var line = String.create();
                                let _ = line.append("cosmostore: ");
                                let _ = line.append(keyFileWhat(k.kind));
                                let _ = line.append(" reload waits: ");
                                let _ = line.appendNumber(n);
                                let _ = line.append(
                                    " versions, uploads or bucket encryption configurations still need the key it removes or changes (",
                                );
                                let _ = line.append(StringView.fromUtf8(dropped[0].view()) ?? "?");
                                let _ = line.append("); tried again each cycle\n");
                                let _ = await AsyncConsole.writeError(line.view());
                            }
                            continue;
                        }
                        null => {
                            // Not known yet (a node slow to answer, a leader just elected, a node not yet reloaded):
                            // tried again each cycle, said once (CI's slower runner found a refusal for good too
                            // strict).
                            k.askEveryMs = nextAskWait(k.askEveryMs);
                            k.askAtMs = now + k.askEveryMs;
                            if (k.waiting != modified) {
                                k.waiting = modified;
                                var line = String.create();
                                let _ = line.append("cosmostore: ");
                                let _ = line.append(keyFileWhat(k.kind));
                                let _ = line.append(
                                    " reload waits: a node did not answer, a shard's leader was not caught up, or a node has the key first; tried again each cycle\n",
                                );
                                let _ = await AsyncConsole.writeError(line.view());
                            }
                            continue;
                        }
                    }
                }
                let installed = await Async.blocking(() => installKeys(k, borrow fresh));
                if (installed) {
                    await reportKeys(k, modified, fresh.length);
                } else {
                    await refuseKeys(
                        k,
                        modified,
                        "the keys were reloaded too many times; restart to reload",
                        0,
                        borrow dropped,
                    );
                }
            }
        }
    }
}

async fn runNode(
    shared: borrow Arc<NodeShared>,
    server: Server<NodeApp>,
    address: SocketAddress,
    internals: Vector<InternalS3>,
    front: Server<FrontApp>?,
    frontAddress: SocketAddress,
    rotation: Rotation?,
) -> Result<void, NodeFault> {
    let frontListener = match (front) {
        Some(_) => match (listenOn(frontAddress)) {
            Ok(l) => Some(l),
            Err(_) => { return Err(NodeFault.Net); }
        },
        null => null,
    };
    let listener = match (listenOn(address)) {
        Ok(l) => l,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let drain = match (Drain.create()) {
        Ok(d) => d,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    let plain = PlainAcceptor {};
    let node = shared.get();
    var line = textOf("cosmostore: node ");
    var number = Vector<u8>.create();
    let _ = appendDecimal(mut number, node.id as u64);
    let _ = line.append(StringView.fromUtf8(number.view()) ?? "");
    let _ = line.append(
        if (frontListener.isSome()) " of the cluster, its peer and S3 ports open\n"
            else " of the cluster, its peer port open\n",
    );
    let _ = await AsyncConsole.write(line.view());
    let peers = node.peers.length;
    var servers = internals;
    let scoped = await Async.scope(NodeFault.OutOfMemory, (s) => {
        s.spawn(async move () => {
            match (await server.run(listener, borrow plain, ConnectionLimits.defaults(), drain)) {
                Ok(_) => { return Err(NodeFault.Net); }
                Err(_) => { return Err(NodeFault.Net); }
            }
        });
        // The shards' S3 servers, and the front.
        while (true) {
            let inner = match (servers.pop()) {
                Some(i) => i,
                null => { break; }
            };
            s.spawn(async move () => {
                let d = match (Drain.create()) {
                    Ok(d) => d,
                    Err(_) => { return Err(NodeFault.OutOfMemory); }
                };
                let p = PlainAcceptor {};
                match (await inner.server.run(inner.listener, borrow p, ConnectionLimits.defaults(), d)) {
                    Ok(_) => { return Err(NodeFault.Net); }
                    Err(_) => { return Err(NodeFault.Net); }
                }
            });
        }
        match (front) {
            Some(f) => {
                match (frontListener) {
                    Some(fl) => {
                        s.spawn(async move () => {
                            let d = match (Drain.create()) {
                                Ok(d) => d,
                                Err(_) => { return Err(NodeFault.OutOfMemory); }
                            };
                            let p = PlainAcceptor {};
                            match (await f.run(fl, borrow p, ConnectionLimits.defaults(), d)) {
                                Ok(_) => { return Err(NodeFault.Net); }
                                Err(_) => { return Err(NodeFault.Net); }
                            }
                        });
                    }
                    null => {}
                }
            }
            null => {}
        }
        // The credentials and users files, reloaded when they change (ADR-0092 §1).
        match (rotation) {
            Some(r) => { s.spawn(async move () => await credentialsForever(r, node)); }
            null => {}
        }
        s.spawn(async () => await tickForever(node));
        s.spawn(async () => await fetchForever(node));
        s.spawn(async () => await rebalanceForever(node));
        s.spawn(async () => await scrubForever(node));
        s.spawn(async () => await deliverClusterForever(node));
        s.spawn(async () => await accessLogClusterForever(node));
        s.spawn(async () => await inventoryClusterForever(node));
        s.spawn(async () => await tablesMaintenanceClusterForever(node));
        s.spawn(async () => await codeForever(node));
        for (i in 0..peers) {
            let at = i;
            s.spawn(async move () => await sendForever(node, at));
        }
    });
    return scoped;
}

/// `cosmostore node <dir> --cluster-file <path> --node <id>`.
fn nodeCommand() -> i32 {
    let dir = Process.argument(2) ?? "";
    if (dir.length == 0 || dir.startsWith("--")) { return 2; }
    let args = match (clusterArguments(3)) {
        Some(a) => a,
        null => { return 2; }
    };
    let id = args.node;
    let loaded = match (loadCluster(args.file.view())) {
        Ok(l) => l,
        Err(message) => {
            Console.writeErrorLine(message.view());
            return 1;
        }
    };
    var address = match (loaded.file.node(id)) {
        Some(n) => n.peer,
        null => {
            Console.writeErrorLine("cosmostore: this node is not in the cluster file");
            return 1;
        }
    };
    // `--peer-listen`: the peer port listens here instead of at the cluster file's address, which a proxy in front of
    // it holds (the chaos harness's, ADR-0065).
    match (borrow args.peerListen) {
        Some(text) => {
            address = match (listenAddress(text.view())) {
                Some(a) => a,
                null => { return 2; }
            };
        }
        null => {}
    }
    // S3 on the node (ADR-0060): `--listen` and `--credentials`, both or neither.
    if (args.listen.isSome() != args.credentials.isSome()) { return 2; }
    var credentials: Arc<CredentialSets>? = null;
    // The node's files, watched as `serve` watches its own (ADR-0092 §1).
    var rotation: Rotation? = null;
    var frontAddress = SocketAddress.V4([127u8, 0, 0, 1], 0);
    match (borrow args.credentials) {
        Some(path) => {
            let usersPath = match (borrow args.users) {
                Some(u) => u.view(),
                null => "",
            };
            let first = match (readCredentialsWithUsers(path.view(), usersPath)) {
                Ok(c) => c,
                Err(message) => {
                    Console.writeErrorLine(message.view());
                    return 1;
                }
            };
            credentials = match (CredentialSets.create(first)) {
                Ok(sets) => match (Arc<CredentialSets>.create(sets)) {
                    Ok(a) => Some(a),
                    Err(_) => { return 1; }
                },
                Err(_) => { return 1; }
            };
            match (borrow credentials) {
                Some(sets) => {
                    if (usersPath.length > 0) { noteFileUsersAt(sets.get(), usersPath); }
                }
                null => {}
            }
            match (borrow credentials) {
                Some(sets) => {
                    rotation = Some(Rotation {
                        sets: sets.clone(),
                        path: textOf(path.view()),
                        modified: Fs.modifiedMillis(path.view()).ok() ?? 0,
                        failed: 0,
                        usersPath: textOf(usersPath),
                        usersModified: if (usersPath.length == 0) 0 else Fs.modifiedMillis(usersPath).ok() ?? 0,
                        roles: null,
                        iamGeneration: 0,
                        keyFiles: Vector<KeyRotation>.create(),
                        rewrapAfter: null,
                        notifyFile: null,
                        replicationFile: null,
                    });
                }
                null => {}
            }
            let listenText = match (borrow args.listen) {
                Some(l) => l.view(),
                null => "",
            };
            frontAddress = match (listenAddress(listenText)) {
                Some(a) => a,
                null => { return 2; }
            };
        }
        null => {}
    }
    // How this directory starts (ADR-0066): its marker's way; or, empty, as --init or --join says, a join only once
    // the node's peers say it is in no shard's voters.
    let decision = match (startOf(dir, loaded.file.digest[..], id, args.init, args.join)) {
        Ok(d) => d,
        Err(message) => {
            Console.writeErrorLine(message.view());
            return 2;
        }
    };
    let joined = match (decision.start) {
        NodeStart.Join => true,
        NodeStart.Init => false,
    };
    if (decision.fresh) {
        if (joined) {
            let refusal = match (Async.run(checkNotAVoter(borrow loaded, id))) {
                Ok(r) => r,
                Err(_) => Some(textOf("cosmostore: the node's peers could not be asked")),
            };
            match (refusal) {
                Some(message) => {
                    Console.writeErrorLine(message.view());
                    return 1;
                }
                null => {}
            }
        }
        match (Fs.ensureDirectory(dir)) {
            Ok() => {}
            Err(_) => {
                Console.writeErrorLine("cosmostore: the node directory cannot be made");
                return 1;
            }
        }
        match (writeMarker(dir, loaded.file.digest[..], id, decision.start)) {
            Ok() => {}
            Err(message) => {
                Console.writeErrorLine(message.view());
                return 1;
            }
        }
    }
    let scrubMs = (args.scrubSeconds ?? 3600) * 1000;
    let codeMs = (args.codeAfterSeconds ?? 86400) * 1000;
    // STS (ADR-0078 §2): read and checked before any shard opens; each shard's S3 server takes its own copy.
    var sts = NodeS3Setup {
        keys: Vector<MasterKey>.create(),
        sseKeys: Vector<MasterKey>.create(),
        kmsKeys: Vector<MasterKey>.create(),
        stsSets: null,
        notifyList: null,
        watched: Vector<WatchedFile>.create(),
        replicationList: null,
        sseSets: null,
        kmsSets: null,
        rolesText: Vector<u8>.create(),
        roleSets: null,
        websiteDomain: Vector<u8>.create(),
        domain: Vector<u8>.create(),
        notifyTargetsText: Vector<u8>.create(),
        replicationTargetsText: Vector<u8>.create(),
        frontUrl: Vector<u8>.create(),
        accessLines: match (Channel<AccessLogEntry>.create(ACCESS_LOG_QUEUE)) {
            Ok(c) => c,
            Err(_) => { return 1; }
        },
        accessLogEveryMs: (args.accessLogSeconds ?? 300) * 1000,
        inventoryDayMs: (args.inventoryDaySeconds ?? 86400) * 1000,
        lifecycleEveryMs: (args.lifecycleSeconds ?? 3600) * 1000,
        tablesDayMs: (args.tablesDaySeconds ?? 86400) * 1000,
        tablesCopyPauseMs: args.tablesCopyPauseMs ?? 0,
        restoreHourMs: (args.restoreHourSeconds ?? 3600) * 1000,
        zoneId: Vector<u8>.create(),
    };
    {
        var url = textOf("http://");
        if (appendPeerAddress(mut url, ownFrontAddress(frontAddress)).isErr() || sts.frontUrl.extend(
            url.view().bytes(),
        ).isErr()) {
            return 1;
        }
    }
    match (borrow args.replicationTargets) {
        Some(path) => {
            sts.replicationTargetsText = match (readSmallFile(path.view(), "replication targets file")) {
                Ok(t) => t,
                Err(message) => {
                    Console.writeErrorLine(message.view());
                    return 1;
                }
            };
            match (parseReplicationTargets(sts.replicationTargetsText.view())) {
                Ok(Some(t)) => {
                    sts.replicationList = sharedList(t).ok();
                    if (sts.replicationList.isNull()) { return 1; }
                }
                _ => {
                    Console.writeErrorLine(
                        "cosmostore: the replication targets file needs lines of `<id> <http or https url> <access key> <secret key> [region]`, each id once",
                    );
                    return 1;
                }
            }
        }
        null => {}
    }
    match (borrow args.notifyTargets) {
        Some(path) => {
            sts.notifyTargetsText = match (readSmallFile(path.view(), "notification targets file")) {
                Ok(t) => t,
                Err(message) => {
                    Console.writeErrorLine(message.view());
                    return 1;
                }
            };
            match (parseTargets(sts.notifyTargetsText.view())) {
                Ok(Some(t)) => {
                    sts.notifyList = sharedList(t).ok();
                    if (sts.notifyList.isNull()) { return 1; }
                }
                _ => {
                    Console.writeErrorLine(
                        "cosmostore: the notification targets file needs lines of `<id> <http or https url>`, each id once",
                    );
                    return 1;
                }
            }
        }
        null => {}
    }
    match (borrow args.websiteDomain) {
        Some(d) => {
            for (c in d.view().bytes()) {
                if (sts.websiteDomain.push(if (c >= 'A' && c <= 'Z') c + 32 else c).isErr()) { return 1; }
            }
        }
        null => {}
    }
    // Directory buckets' zone (ADR-0080 §8).
    match (borrow args.zoneId) {
        Some(z) => {
            if (!isZoneId(z.view().bytes())) {
                Console.writeErrorLine("cosmostore: --zone-id is 1 to 20 of a-z, 0-9 and '-', e.g. local-az1");
                return 1;
            }
            if (sts.zoneId.extend(z.view().bytes()).isErr()) { return 1; }
        }
        null => {}
    }
    match (borrow args.domain) {
        Some(d) => {
            for (c in d.view().bytes()) {
                if (sts.domain.push(if (c >= 'A' && c <= 'Z') c + 32 else c).isErr()) { return 1; }
            }
        }
        null => {}
    }
    // SSE's keys (ADR-0092 §2): read at start, as `serve` reads them; a file that does not read stops the node.
    match (borrow args.sseKeys) {
        Some(path) => {
            sts.sseKeys = match (readSseKeys(path.view())) {
                Ok(k) => k,
                Err(message) => {
                    Console.writeErrorLine(message.view());
                    return 1;
                }
            };
        }
        null => {}
    }
    match (borrow args.kmsKeys) {
        Some(path) => {
            sts.kmsKeys = match (readSseKeys(path.view())) {
                Ok(k) => k,
                Err(message) => {
                    Console.writeErrorLine(message.view());
                    return 1;
                }
            };
        }
        null => {}
    }
    match (borrow args.stsKeys) {
        Some(path) => {
            sts.keys = match (readSseKeys(path.view())) {
                Ok(k) => k,
                Err(message) => {
                    Console.writeErrorLine(message.view());
                    return 1;
                }
            };
        }
        null => {}
    }
    // The key files' sets, shared by every shard's S3 server and the delivery task, and reloaded (ADR-0096 §3, §6).
    let made = match (sharedKeys(match (copyKeys(sts.keys.view())) {
        Ok(k) => k,
        Err(_) => { return 1; }
    })) {
        Ok(a) => a,
        Err(_) => { return 1; }
    };
    let sseMade = match (sharedKeys(match (copyKeys(sts.sseKeys.view())) {
        Ok(k) => k,
        Err(_) => { return 1; }
    })) {
        Ok(a) => a,
        Err(_) => { return 1; }
    };
    let kmsMade = match (sharedKeys(match (copyKeys(sts.kmsKeys.view())) {
        Ok(k) => k,
        Err(_) => { return 1; }
    })) {
        Ok(a) => a,
        Err(_) => { return 1; }
    };
    match (borrow mut rotation) {
        Some(r) => {
            for (kind in [KEY_FILE_STS, KEY_FILE_SSE, KEY_FILE_KMS]) {
                let given =
                    if (kind == KEY_FILE_STS) borrow args.stsKeys else if (kind == KEY_FILE_SSE) borrow args.sseKeys
                        else borrow args.kmsKeys;
                match (given) {
                    Some(path) => {
                        let sets = if (kind == KEY_FILE_STS) made.clone() else if (kind == KEY_FILE_SSE) sseMade.clone()
                            else kmsMade.clone();
                        let pushed = r.keyFiles.push(KeyRotation {
                            sets: sets,
                            path: textOf(path.view()),
                            kind: kind,
                            modified: Fs.modifiedMillis(path.view()).ok() ?? 0,
                            failed: 0,
                            waiting: 0,
                            askAtMs: 0,
                            askEveryMs: 0,
                        });
                        if (pushed.isErr()) { return 1; }
                    }
                    null => {}
                }
            }
        }
        null => {}
    }
    sts.stsSets = Some(made);
    // The start's copies of the keys are wiped, now that the shared sets hold them (ADR-0100 §5): they would
    // outlive a key's removal.
    sts.keys = Vector<MasterKey>.create();
    sts.sseKeys = Vector<MasterKey>.create();
    sts.kmsKeys = Vector<MasterKey>.create();
    // The target files, reloaded with the credentials (ADR-0096 §5).
    match (borrow mut rotation) {
        Some(r) => {
            match (borrow args.notifyTargets) {
                Some(path) => {
                    match (borrow sts.notifyList) {
                        Some(list) => {
                            r.notifyFile = Some(TargetRotation<NotifyTarget> {
                                list: list.clone(),
                                path: textOf(path.view()),
                                modified: Fs.modifiedMillis(path.view()).ok() ?? 0,
                                failed: 0,
                            });
                        }
                        null => {}
                    }
                }
                null => {}
            }
            match (borrow args.replicationTargets) {
                Some(path) => {
                    match (borrow sts.replicationList) {
                        Some(list) => {
                            r.replicationFile = Some(TargetRotation<ReplicationTarget> {
                                list: list.clone(),
                                path: textOf(path.view()),
                                modified: Fs.modifiedMillis(path.view()).ok() ?? 0,
                                failed: 0,
                            });
                        }
                        null => {}
                    }
                }
                null => {}
            }
        }
        null => {}
    }
    sts.sseSets = Some(sseMade);
    sts.kmsSets = Some(kmsMade);
    match (borrow args.roles) {
        Some(path) => {
            if (args.stsKeys.isNull()) {
                Console.writeErrorLine("cosmostore: --roles-file needs --sts-key-file");
                return 2;
            }
            sts.rolesText = match (readSmallFile(path.view(), "roles file")) {
                Ok(t) => t,
                Err(message) => {
                    Console.writeErrorLine(message.view());
                    return 1;
                }
            };
            let parsedRoles = match (parseRolesFile(sts.rolesText.view())) {
                Ok(r) => r,
                Err(_) => {
                    Console.writeErrorLine(
                        "cosmostore: the roles file has a line that is not `<name> <max seconds> <policy JSON>`, or a policy CosmoStore does not take",
                    );
                    return 1;
                }
            };
            // One set for every shard's S3 server, reloaded by the node's task with its credentials (ADR-0096 §1, §6).
            let sets = match (RoleSets.create(parsedRoles)) {
                Ok(s) => match (Arc<RoleSets>.create(s)) {
                    Ok(a) => a,
                    Err(_) => { return 1; }
                },
                Err(_) => { return 1; }
            };
            match (borrow mut rotation) {
                Some(r) => {
                    r.roles = Some(RoleRotation {
                        sets: sets.clone(),
                        path: textOf(path.view()),
                        modified: Fs.modifiedMillis(path.view()).ok() ?? 0,
                        failed: 0,
                        iamGeneration: 0,
                    });
                }
                null => {}
            }
            sts.roleSets = Some(sets);
        }
        null => {}
    }
    // The files whose digests the node's status shows (ADR-0096 §6), by their options' names.
    watchFile(mut sts.watched, "credentials", args.credentials.asBorrow());
    watchFile(mut sts.watched, "users-file", args.users.asBorrow());
    watchFile(mut sts.watched, "roles-file", args.roles.asBorrow());
    watchFile(mut sts.watched, "sts-key-file", args.stsKeys.asBorrow());
    watchFile(mut sts.watched, "sse-key-file", args.sseKeys.asBorrow());
    watchFile(mut sts.watched, "kms-key-file", args.kmsKeys.asBorrow());
    watchFile(mut sts.watched, "notify-targets", args.notifyTargets.asBorrow());
    watchFile(mut sts.watched, "replication-targets", args.replicationTargets.asBorrow());
    let parts = match (openNode(
        dir,
        loaded.file,
        loaded.secret,
        id,
        credentials,
        borrow sts,
        scrubMs,
        codeMs,
        args.clockSkewMs ?? 0,
        joined,
        (args.segmentMb ?? 0) * 1048576,
    )) {
        Ok(s) => s,
        Err(message) => {
            Console.writeErrorLine(message.view());
            return 1;
        }
    };
    // The replication targets' secrets: parsed, so the text goes.
    Secret.wipe(mut sts.replicationTargetsText[..]);
    let withS3 = parts.internals.length > 0;
    let arc = match (Arc<NodeShared>.create(parts.shared)) {
        Ok(a) => a,
        Err(_) => { return 1; }
    };
    var limits = Limits.defaults();
    limits.maxBodyBytes = NODE_MAX_BODY;
    let app = NodeApp { shared: arc.clone() };
    var server = match (Server<NodeApp>.create(app, limits)) {
        Ok(s) => s,
        Err(_) => { return 1; }
    };
    let routed = match (peerHandler()) {
        Ok(h) => server.router().post("/raft", h).isOk(),
        Err(_) => false,
    } && match (peerHandler()) {
        Ok(h) => server.router().get("/cluster/status", h).isOk(),
        Err(_) => false,
    } && match (peerHandler()) {
        Ok(h) => server.router().get("/cluster/iam", h).isOk(),
        Err(_) => false,
    };
    let routedS3 = match (peerHandler()) {
        Ok(h) => server.router().post("/s3", h).isOk(),
        Err(_) => false,
    } && match (peerHandler()) {
        Ok(h) => server.router().post("/extent", h).isOk(),
        Err(_) => false,
    } && match (peerHandler()) {
        Ok(h) => server.router().post("/extent-fetch", h).isOk(),
        Err(_) => false,
    } && match (peerHandler()) {
        Ok(h) => server.router().post("/cluster/active", h).isOk(),
        Err(_) => false,
    } && match (peerHandler()) {
        Ok(h) => server.router().post("/record-fetch", h).isOk(),
        Err(_) => false,
    } && match (peerHandler()) {
        Ok(h) => server.router().post("/piece-fetch", h).isOk(),
        Err(_) => false,
    } && match (peerHandler()) {
        Ok(h) => server.router().post(CLAIM_PATH, h).isOk(),
        Err(_) => false,
    };
    if (!routed || !routedS3) { return 1; }
    var front: Server<FrontApp>? = null;
    if (withS3) {
        front = match (frontServer(FrontApp { shared: arc.clone() })) {
            Ok(f) => Some(f),
            Err(_) => { return 1; }
        };
    }
    match (Async.run(runNode(borrow arc, server, address, parts.internals, front, frontAddress, rotation))) {
        Ok(_) => { return 1; }
        Err(_) => { return 1; }
    }
}

/// A file the node was given, by its option's name, for its digest; none when the option is not given.
fn watchFile(out: borrow mut Vector<WatchedFile>, name: StringView, path: borrow String?) {
    match (path) {
        Some(p) => {
            match (copyBytes(name.bytes())) {
                Ok(n) => { let _ = out.push(WatchedFile { name: n, path: textOf(p.view()) }); }
                Err(_) => {}
            }
        }
        null => {}
    }
}

/// `--cluster-file <path> --node <id>`, from argument `from` on.
struct ClusterArguments {
    file: String;
    node: u32;
    /// S3 on the node (ADR-0060): where its front listens, and the credentials file.
    listen: String?;
    credentials: String?;
    /// The users file (ADR-0088 §5): the same on every node, as the credentials file.
    users: String?;
    /// How often a scrub pass starts (ADR-0063 §1); how old an extent is before it is coded (ADR-0064 §1).
    scrubSeconds: u64?;
    codeAfterSeconds: u64?;
    /// Where the peer port listens, when not at the cluster file's address (ADR-0065).
    peerListen: String?;
    /// How far off the machine's clock this node signs and checks peer requests (testing only, ADR-0065 §7).
    clockSkewMs: i64?;
    /// The size a shard's journal segments are sealed at, in MiB (0: the default, 128).
    segmentMb: u64?;
    /// STS on the node's S3 port (ADR-0078 §2): the token keys and the roles, the same files on every node.
    stsKeys: String?;
    /// `--sse-key-file` and `--kms-key-file` (ADR-0092 §2).
    sseKeys: String?;
    kmsKeys: String?;
    roles: String?;
    /// Website hosting on the node's S3 port (ADR-0078 §3).
    websiteDomain: String?;
    /// Directory buckets' zone (ADR-0080 §8).
    zoneId: String?;
    /// Virtual-hosted requests, `<bucket>.<domain>`, as `serve`'s domain (ADR-0078 §5).
    domain: String?;
    /// The webhooks event notifications go to (ADR-0078 §4).
    notifyTargets: String?;
    /// The other endpoints replication goes to (ADR-0078 §4).
    replicationTargets: String?;
    /// How often a target bucket's access log lines become an object (ADR-0078 §4).
    accessLogSeconds: u64?;
    /// A day for inventory reports, 1 to 86400 seconds (tests).
    inventoryDaySeconds: u64?;
    /// A day for table maintenance, 1 to 86400 seconds (tests).
    tablesDaySeconds: u64?;
    /// A test option (ADR-0110 §7): a wait between a compaction bin's copy and its put, 1 to 600000 ms.
    tablesCopyPauseMs: u64?;
    /// `--restore-hour-seconds` (ADR-0102 §6): an hour of a restore's times, and a day of its `Days`.
    restoreHourSeconds: u64?;
    /// How often lifecycle rules run on each shard's leader, 1 to 86400 seconds (tests; an hour by default).
    lifecycleSeconds: u64?;
    /// How an empty directory starts (ADR-0066): the cluster's formation, or joining it.
    init: bool;
    join: bool;
}

fn clusterArguments(from: usize) -> ClusterArguments? {
    var file: String? = null;
    var node: u32? = null;
    var listen: String? = null;
    var credentials: String? = null;
    var users: String? = null;
    var scrubSeconds: u64? = null;
    var codeAfterSeconds: u64? = null;
    var peerListen: String? = null;
    var clockSkewMs: i64? = null;
    var segmentMb: u64? = null;
    var stsKeys: String? = null;
    var sseKeys: String? = null;
    var kmsKeys: String? = null;
    var roles: String? = null;
    var websiteDomain: String? = null;
    var zoneId: String? = null;
    var domain: String? = null;
    var notifyTargets: String? = null;
    var replicationTargets: String? = null;
    var accessLogSeconds: u64? = null;
    var inventoryDaySeconds: u64? = null;
    var tablesDaySeconds: u64? = null;
    var tablesCopyPauseMs: u64? = null;
    var restoreHourSeconds: u64? = null;
    var lifecycleSeconds: u64? = null;
    var init = false;
    var join = false;
    var at = from;
    while (true) {
        let option = match (Process.argument(at)) {
            Some(o) => o,
            null => { break; }
        };
        // The two flags without a value.
        if (option == "--init" || option == "--join") {
            if (option == "--init") { init = true; } else { join = true; }
            at += 1;
            continue;
        }
        let value = Process.argument(at + 1) ?? "";
        if (value.length == 0) { return null; }
        if (option == "--cluster-file") {
            file = Some(textOf(value));
        } else if (option == "--node") {
            node = value.parseInt<u32>();
            if (node.isNull()) { return null; }
        } else if (option == "--listen") {
            listen = Some(textOf(value));
        } else if (option == "--credentials") {
            credentials = Some(textOf(value));
        } else if (option == "--users-file") {
            users = Some(textOf(value));
        } else if (option == "--peer-listen") {
            peerListen = Some(textOf(value));
        } else if (option == "--segment-mb") {
            segmentMb = value.parseInt<u64>();
            if (segmentMb.isNull() || (segmentMb ?? 0) == 0) { return null; }
        } else if (option == "--clock-skew-ms") {
            clockSkewMs = value.parseInt<i64>();
            if (clockSkewMs.isNull()) { return null; }
        } else if (option == "--code-after-seconds") {
            codeAfterSeconds = value.parseInt<u64>();
            if (codeAfterSeconds.isNull()) { return null; }
        } else if (option == "--sts-key-file") {
            stsKeys = Some(textOf(value));
        } else if (option == "--sse-key-file") {
            sseKeys = Some(textOf(value));
        } else if (option == "--kms-key-file") {
            kmsKeys = Some(textOf(value));
        } else if (option == "--roles-file") {
            roles = Some(textOf(value));
        } else if (option == "--website-domain") {
            websiteDomain = Some(textOf(value));
        } else if (option == "--zone-id") {
            zoneId = Some(textOf(value));
        } else if (option == "--domain") {
            domain = Some(textOf(value));
        } else if (option == "--notify-targets") {
            notifyTargets = Some(textOf(value));
        } else if (option == "--replication-targets") {
            replicationTargets = Some(textOf(value));
        } else if (option == "--access-log-seconds") {
            accessLogSeconds = value.parseInt<u64>();
            if ((accessLogSeconds ?? 0) == 0) { return null; }
        } else if (option == "--inventory-day-seconds") {
            inventoryDaySeconds = value.parseInt<u64>();
            let n = inventoryDaySeconds ?? 0;
            if (n < 1 || n > 86400) { return null; }
        } else if (option == "--lifecycle-seconds") {
            lifecycleSeconds = value.parseInt<u64>();
            let n = lifecycleSeconds ?? 0;
            if (n < 1 || n > 86400) { return null; }
        } else if (option == "--tables-day-seconds") {
            tablesDaySeconds = value.parseInt<u64>();
            let n = tablesDaySeconds ?? 0;
            if (n < 1 || n > 86400) { return null; }
        } else if (option == "--tables-copy-pause-ms") {
            tablesCopyPauseMs = value.parseInt<u64>();
            let n = tablesCopyPauseMs ?? 0;
            if (n < 1 || n > 600000) { return null; }
        } else if (option == "--restore-hour-seconds") {
            restoreHourSeconds = value.parseInt<u64>();
            let n = restoreHourSeconds ?? 0;
            if (n < 1 || n > 3600) { return null; }
        } else if (option == "--scrub-seconds") {
            scrubSeconds = value.parseInt<u64>();
            if (scrubSeconds.isNull() || (scrubSeconds ?? 0) == 0) { return null; }
        } else {
            return null;
        }
        at += 2;
    }
    return match (file) {
        Some(f) => match (node) {
            Some(n) => Some(ClusterArguments {
                file: f,
                node: n,
                listen: listen,
                credentials: credentials,
                users: users,
                scrubSeconds: scrubSeconds,
                codeAfterSeconds: codeAfterSeconds,
                peerListen: peerListen,
                clockSkewMs: clockSkewMs,
                segmentMb: segmentMb,
                stsKeys: stsKeys,
                sseKeys: sseKeys,
                kmsKeys: kmsKeys,
                roles: roles,
                websiteDomain: websiteDomain,
                zoneId: zoneId,
                domain: domain,
                notifyTargets: notifyTargets,
                replicationTargets: replicationTargets,
                accessLogSeconds: accessLogSeconds,
                inventoryDaySeconds: inventoryDaySeconds,
                tablesDaySeconds: tablesDaySeconds,
                tablesCopyPauseMs: tablesCopyPauseMs,
                restoreHourSeconds: restoreHourSeconds,
                lifecycleSeconds: lifecycleSeconds,
                init: init,
                join: join,
            }),
            null => null,
        },
        null => null,
    };
}

/// The cluster file and its secret, or why not.
struct LoadedCluster {
    file: ClusterFile;
    secret: Vector<u8>;
}

fn loadCluster(path: StringView) -> Result<LoadedCluster, String> {
    let bytes = readSmallFile(path, "the cluster file")?;
    let text = match (StringView.fromUtf8(bytes.view())) {
        Some(t) => t,
        null => { return Err(textOf("cosmostore: the cluster file is not UTF-8")); }
    };
    let file = match (parseClusterFile(text)) {
        Ok(f) => f,
        Err(e) => {
            var line = textOf("cosmostore: the cluster file, line ");
            var n = Vector<u8>.create();
            let _ = appendDecimal(mut n, e.line as u64);
            let _ = line.append(StringView.fromUtf8(n.view()) ?? "");
            let _ = line.append(": ");
            let _ = line.append(clusterFaultText(e.fault));
            return Err(line);
        }
    };
    let keyText = readSmallFile(file.secretFile.view(), "the cluster's secret file")?;
    var trimmed = Vector<u8>.create();
    for (b in keyText.view()) {
        if (b != 0x0A && b != 0x0D && b != 0x20) { let _ = trimmed.push(b); }
    }
    var secret = Vector<u8>.create();
    let decoded = decodeBase64(trimmed.view(), mut secret).isOk() && secret.length == 32;
    if (!decoded) { return Err(textOf("cosmostore: the cluster's secret file is not base64 of 32 bytes")); }
    return Ok(LoadedCluster { file: file, secret: secret });
}

/// `cosmostore cluster-status --cluster-file <path> --node <id>`: asks the node, signed as the operator.
fn clusterStatusCommand() -> i32 {
    let args = match (clusterArguments(2)) {
        Some(a) => a,
        null => { return 2; }
    };
    let loaded = match (loadCluster(args.file.view())) {
        Ok(l) => l,
        Err(message) => {
            Console.writeErrorLine(message.view());
            return 1;
        }
    };
    let peer = match (loaded.file.node(args.node)) {
        Some(n) => n.peer,
        null => {
            Console.writeErrorLine("cosmostore: that node is not in the cluster file");
            return 1;
        }
    };
    var url = textOf("http://");
    if (appendPeerAddress(mut url, peer).isErr() || url.append("/cluster/status").isErr()) { return 1; }
    var answer = Vector<u8>.create();
    let status = match (Async.run(askStatus(borrow loaded, url.view(), mut answer))) {
        Ok(s) => s,
        Err(_) => 0u16,
    };
    if (status != 200) {
        Console.writeErrorLine("cosmostore: the node did not answer (or refused the request)");
        return 1;
    }
    Console.write(StringView.fromUtf8(answer.view()) ?? "");
    // Every node's files, compared (ADR-0096 §6).
    let compared = match (Async.run(compareNodeFiles(borrow loaded))) {
        Ok(c) => c,
        Err(_) => { return 1; }
    };
    Console.write(StringView.fromUtf8(compared.view()) ?? "");
    return 0;
}

/// Asks every node of the cluster file for its status, and compares the digests of their files (ADR-0096 §6).
async fn compareNodeFiles(loaded: borrow LoadedCluster) -> Result<Vector<u8>, AllocError> {
    var nodes = Vector<NodeDigests>.create();
    for (i in 0..loaded.file.nodes.length) {
        let n = borrow loaded.file.nodes[i];
        var url = textOf("http://");
        appendPeerAddress(mut url, n.peer)?;
        url.append("/cluster/status")?;
        var answer = Vector<u8>.create();
        let status = match (await askStatus(loaded, url.view(), mut answer)) {
            Ok(s) => s,
            Err(_) => 0u16,
        };
        nodes.push(NodeDigests {
            node: n.id,
            answered: status == 200,
            lines: if (status == 200) digestLinesOf(answer.view())? else Vector<Vector<u8>>.create(),
        })?;
    }
    return compareDigests(nodes.view());
}

/// Before a node joins on an empty directory (ADR-0066 §2): a majority of its peers answer, and none lists it among a
/// shard's voters (a voter that lost its disk must be taken out first, `cluster-leave`). Why not, or null.
async fn checkNotAVoter(loaded: borrow LoadedCluster, id: u32) -> Result<String?, NodeFault> {
    var others = 0usize;
    var answered = 0usize;
    var views = Vector<ShardView>.create();
    for (i in 0..loaded.file.nodes.length) {
        let n = borrow loaded.file.nodes[i];
        if (n.id == id) { continue; }
        others += 1;
        var url = textOf("http://");
        if (appendPeerAddress(mut url, n.peer).isErr() || url.append("/cluster/status").isErr()) {
            return Err(NodeFault.OutOfMemory);
        }
        var answer = Vector<u8>.create();
        let status = match (await askStatus(loaded, url.view(), mut answer)) {
            Ok(s) => s,
            Err(_) => 0u16,
        };
        if (status != 200) { continue; }
        answered += 1;
        if (shardViews(answer.view(), mut views).isErr()) { return Err(NodeFault.OutOfMemory); }
    }
    if (votesInSomeShard(views.view(), id)) {
        var line = textOf("cosmostore: node ");
        let _ = line.appendNumber(id as i64);
        let _ = line.append(
            " is still a voter of a shard, as its leader sees it: take it out with cluster-leave, wait until no shard lists it, then start it with --join",
        );
        return Ok(Some(line));
    }
    if (answered < others / 2 + 1) {
        var line = textOf("cosmostore: only ");
        let _ = line.appendNumber(truncate<i64>(answered));
        let _ = line.append(" of the node's ");
        let _ = line.appendNumber(truncate<i64>(others));
        let _ = line.append(" peers answered: a majority must, to show it is in no shard's voters, before it joins");
        return Ok(Some(line));
    }
    return Ok(null);
}

async fn askStatus(
    loaded: borrow LoadedCluster,
    url: StringView,
    answer: borrow mut Vector<u8>,
) -> Result<u16, NodeFault> => await askStatusWith(borrow loaded.file, loaded.secret.view(), url, answer);

/// `askStatus` with a cluster file and secret: a node asks its peers so, as the operator does (ADR-0100 §4).
async fn askStatusWith(
    file: borrow ClusterFile,
    secret: Slice<u8>,
    url: StringView,
    answer: borrow mut Vector<u8>,
) -> Result<u16, NodeFault> => await askPathWith(file, secret, url, "/cluster/status", answer);

/// A signed GET of a peer's `path` (`/cluster/status`, `/cluster/iam`), as the operator.
async fn askPathWith(
    file: borrow ClusterFile,
    secret: Slice<u8>,
    url: StringView,
    path: StringView,
    answer: borrow mut Vector<u8>,
) -> Result<u16, NodeFault> {
    var options = ClientOptions.defaults();
    options.totalMs = 10000;
    options.retry = RetryPolicy.never();
    let client = match (Client.create(options, null)) {
        Ok(c) => c,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    var request = match (ClientRequest.create(Method.Get, url)) {
        Ok(r) => r,
        Err(_) => { return Err(NodeFault.Net); }
    };
    if (!signRequest(
        mut request,
        file,
        secret,
        0,
        "GET",
        path,
        "".bytes(),
        Clock.unixMillis(),
    )) {
        return Err(NodeFault.OutOfMemory);
    }
    var none = NoBody {};
    var response = match (await client.send(request, mut none)) {
        Ok(r) => r,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let status = response.status();
    if ((await response.readToEnd(answer, 1048576)).isErr()) { return Err(NodeFault.Net); }
    let _ = await response.finish(client);
    await client.shutdown();
    return Ok(status);
}

/// `1,2,3`, or `-` for none.
fn appendIdList(out: borrow mut Vector<u8>, ids: Slice<u32>) -> Result<void, AllocError> {
    if (ids.length == 0) { return out.push(0x2D); }
    for (i in 0..ids.length) {
        if (i > 0) { out.push(0x2C)?; }
        appendDecimal(out, ids[i] as u64)?;
    }
    return Ok();
}
