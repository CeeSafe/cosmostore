// Membership and placement on a running cluster (ADR-0062 §3–§5, M6 item 6 slice c, as built). The cluster file is the
// roster: every node that may take part, with its address. Group 0, a Raft group of its own (shard GROUP0_SHARD), holds
// which of them are active, as the object `active` of its store's bucket `cosmo-system`; its voters are the first three
// nodes active when the cluster begins, and every other node of the roster is its learner, so each node holds a copy.
// A shard's target is the placement rule (ADR-0059 §2) over the active nodes; each shard's leader moves its shard there
// one change at a time (ADR-0062 §4): a target node not in the group joins as a learner, a learner that has caught up is
// promoted, and a voter the target leaves out is removed once every target node votes.
import web_core;
import web_http;
import web_client;

const GROUP0_SHARD: u32 = 65535;
const GROUP0_VOTERS: usize = 3;
const SYSTEM_BUCKET: StringView = "cosmo-system";
const ACTIVE_KEY: StringView = "active";
const REBALANCE_EVERY_MS: u64 = 1000;

/// The configuration a shard (or group 0) begins in, before any Config record.
fn baseMembers(file: borrow ClusterFile, shard: u32) -> Result<RaftMembership, AllocError> {
    let active = file.initialActive()?;
    if (shard != GROUP0_SHARD) { return RaftMembership.of(file.placementAmong(shard, active.view())?.view()); }
    var voters = Vector<u32>.create();
    for (i in 0..active.length) {
        if (voters.length < GROUP0_VOTERS) { voters.push(active[i])?; }
    }
    var learners = Vector<u32>.create();
    for (i in 0..file.nodes.length) {
        let id = file.nodes[i].id;
        var voter = false;
        for (v in voters.view()) {
            if (v == id) { voter = true; }
        }
        if (!voter) { learners.push(id)?; }
    }
    return Ok(RaftMembership { voters: voters, learners: learners });
}

/// `m` with node `id` in neither its voters nor its learners.
fn withoutNode(m: borrow RaftMembership, id: u32) -> RaftMembership {
    var voters = Vector<u32>.create();
    var learners = Vector<u32>.create();
    for (v in m.voters.view()) {
        if (v != id && voters.push(v).isErr()) { return RaftMembership { voters: voters, learners: learners }; }
    }
    for (l in m.learners.view()) {
        if (l != id && learners.push(l).isErr()) { return RaftMembership { voters: voters, learners: learners }; }
    }
    return RaftMembership { voters: voters, learners: learners };
}

fn encodeIds(ids: Slice<u32>) -> Result<Vector<u8>, AllocError> {
    var out = Vector<u8>.create();
    out.pushLE(truncate<u32>(ids.length))?;
    for (id in ids) { out.pushLE(id)?; }
    return Ok(out);
}

fn decodeIds(b: Slice<u8>) -> Vector<u32>? {
    if (b.length < 4) { return null; }
    let n = b.readLE<u32>(0) as usize;
    if (n > 255 || b.length != 4 + n * 4) { return null; }
    var out = Vector<u32>.create();
    for (i in 0..n) {
        if (out.push(b.readLE<u32>(4 + i * 4)).isErr()) { return null; }
    }
    return Some(out);
}

fn contains(ids: Slice<u32>, id: u32) -> bool {
    for (x in ids) {
        if (x == id) { return true; }
    }
    return false;
}

/// Group 0's active set as this node's copy has it applied; the cluster file's before group 0 wrote one.
async fn readActive(shared: borrow NodeShared) -> Result<Vector<u32>, NodeFault> {
    let initial = match (shared.file.initialActive()) {
        Ok(a) => a,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    let at = match (slotOf(shared, GROUP0_SHARD)) {
        Some(i) => i,
        null => { return Ok(initial); }
    };
    var storeGuard = match (await shared.slots[at].store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let st = storeGuard.data();
    let got = await Async.blocking(() => st.getObject(SYSTEM_BUCKET, ACTIVE_KEY));
    return match (got) {
        Ok(bytes) => Ok(decodeIds(bytes.view()) ?? initial),
        Err(_) => Ok(initial),
    };
}

/// What one of group 0's writes does to its system bucket.
enum Group0Change {
    MakeBucket,
    Put,
    Delete,
}

/// One of group 0's writes: the system bucket, or an object of it put or deleted (the active set, an access point's
/// claim). The bucket is a write of its own, committed before the next: in a Raft log a record is not applied when it
/// is staged, ADR-0058, so a bucket made in a write is not there for it.
fn writeGroup0Record(
    r: borrow mut ShardReplica,
    st: borrow mut ObjectStore,
    change: Group0Change,
    key: StringView,
    bytes: Slice<u8>,
) -> Result<u64?, StoreError> {
    let before = r.beginWrite(st)?;
    let staged = match (change) {
        Group0Change.MakeBucket => st.createBucket(SYSTEM_BUCKET),
        Group0Change.Put => match (st.putObject(
            SYSTEM_BUCKET,
            key,
            "application/octet-stream",
            bytes,
            PutCondition.None,
        )) {
            Ok(_) => Ok(),
            Err(e) => Err(e),
        },
        Group0Change.Delete => st.deleteObject(SYSTEM_BUCKET, key),
    };
    match (staged) {
        Ok() => {}
        Err(e) => {
            // Nothing of a failed write may stay in the journal unproposed: the next write would never start.
            let _ = st.truncateEntries(before);
            return Err(e);
        }
    }
    return r.finishWrite(st, before);
}

/// Writes the active set through group 0, as its leader here, and waits for it to be applied: true when it is, in
/// the term it was proposed in. The system bucket first, if group 0 has none yet.
async fn writeActive(shared: borrow NodeShared, ids: Slice<u32>) -> Result<bool, NodeFault> {
    let at = match (slotOf(shared, GROUP0_SHARD)) {
        Some(i) => i,
        null => { return Ok(false); }
    };
    let slot = borrow shared.slots[at];
    var gate = match (await slot.gate.lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let _held = gate.data();
    var hasBucket = true;
    {
        var storeGuard = match (await slot.store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        hasBucket = storeGuard.data().bucketExists(SYSTEM_BUCKET).ok() ?? false;
    }
    if (!hasBucket && !(await group0Write(shared, slot, Group0Change.MakeBucket, ACTIVE_KEY, "".bytes())?)) {
        return Ok(false);
    }
    let bytes = match (encodeIds(ids)) {
        Ok(b) => b,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    return await group0Write(shared, slot, Group0Change.Put, ACTIVE_KEY, bytes.view());
}

/// One write of group 0, as its leader here, behind its gate (the caller's): proposed, and waited for until applied;
/// true when it is, in the term it was proposed in.
async fn group0Write(
    shared: borrow NodeShared,
    slot: borrow ShardSlot,
    change: Group0Change,
    key: StringView,
    bytes: Slice<u8>,
) -> Result<bool, NodeFault> {
    var index = 0u64;
    var term = 0u64;
    {
        var guard = match (await slot.replica.lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let r = guard.data();
        if (!r.core.isLeader()) { return Ok(false); }
        term = r.core.term;
        var storeGuard = match (await slot.store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let st = storeGuard.data();
        let written = await Async.blocking(() => writeGroup0Record(r, st, change, key, bytes));
        index = match (written) {
            Ok(Some(i)) => i,
            _ => { return Ok(false); }
        };
        let drained = await Async.blocking(() => drainOf(r, st));
        match (drained) {
            Ok(out) => { await enqueue(shared, slot.shard, out)?; }
            Err(e) => {
                await noteFailure(slot, e);
                return Ok(false);
            }
        }
    }
    var waited = 0u64;
    while (waited < FRONT_COMMIT_MS) {
        let v = await viewOf(slot)?;
        if (v.applied >= index) { return Ok((await entryTermOf(slot, index))? == term); }
        if (!v.leads) { return Ok(false); }
        if (!(await frontPause(FRONT_POLL_MS))) { return Ok(false); }
        waited += FRONT_POLL_MS;
    }
    return Ok(false);
}

/// Group 0's voters among the active nodes (ADR-0067 §1): its active voters kept, in their order; then active nodes in
/// failure domains not yet among them, in the roster's order; then any active nodes; at most GROUP0_VOTERS.
fn group0Target(file: borrow ClusterFile, active: Slice<u32>, voters: Slice<u32>) -> Result<Vector<u32>, AllocError> {
    var out = Vector<u32>.create();
    for (v in voters) {
        if (out.length < GROUP0_VOTERS && contains(active, v)) { out.push(v)?; }
    }
    for (pass in 0..2) {
        for (i in 0..file.nodes.length) {
            if (out.length >= GROUP0_VOTERS) { break; }
            let n = borrow file.nodes[i];
            if (!contains(active, n.id) || contains(out.view(), n.id)) { continue; }
            var domainTaken = false;
            for (o in out.view()) {
                match (file.node(o)) {
                    Some(m) => {
                        if (m.domain.view() == n.domain.view()) { domainTaken = true; }
                    }
                    null => {}
                }
            }
            if (pass == 0 && domainTaken) { continue; }
            out.push(n.id)?;
        }
    }
    return Ok(out);
}

/// One step of group 0 toward `target` voters, as its leader (ADR-0067 §2): every roster node stays in it, a voter
/// or a learner, since every node reads the active set from it. A target learner that has caught up becomes a voter;
/// then a voter the target leaves out becomes a learner (the leader too, which then steps down). True when a change
/// was proposed.
fn group0Step(r: borrow mut ShardReplica, target: Slice<u32>) -> Result<bool, StoreError> {
    if (!r.core.isLeader()) { return Ok(false); }
    let m = r.core.members.copy()?;
    for (t in target) {
        if (m.isVoter(t)) { continue; }
        if (!m.isLearner(t)) {
            var next = m.copy()?;
            next.learners.push(t)?;
            return Ok(r.changeMembers(next)?.isSome());
        }
        let caughtUp = match (r.core.peerAt(t)) {
            Some(p) => r.core.peers[p].matched >= r.core.commit,
            null => false,
        };
        if (!caughtUp) { return Ok(false); } // wait for it
        var next = m.copy()?;
        var k = 0usize;
        while (k < next.learners.length) {
            if (next.learners[k] == t) { let _ = next.learners.remove(k); } else { k += 1; }
        }
        next.voters.push(t)?;
        return Ok(r.changeMembers(next)?.isSome());
    }
    for (v in m.voters.view()) {
        if (contains(target, v)) { continue; }
        var next = m.copy()?;
        var k = 0usize;
        while (k < next.voters.length) {
            if (next.voters[k] == v) { let _ = next.voters.remove(k); } else { k += 1; }
        }
        next.learners.push(v)?;
        return Ok(r.changeMembers(next)?.isSome());
    }
    return Ok(false);
}

/// One step of shard `r` toward `target` (ADR-0062 §4), as its leader: true when a change was proposed.
fn rebalanceStep(r: borrow mut ShardReplica, target: Slice<u32>) -> Result<bool, StoreError> {
    if (!r.core.isLeader()) { return Ok(false); }
    let m = r.core.members.copy()?;
    // A learner of the target that has caught up becomes a voter.
    for (l in m.learners.view()) {
        if (!contains(target, l)) { continue; }
        let caughtUp = match (r.core.peerAt(l)) {
            Some(p) => r.core.peers[p].matched >= r.core.commit,
            null => false,
        };
        if (!caughtUp) { return Ok(false); } // wait for it
        var next = m.copy()?;
        var k = 0usize;
        while (k < next.learners.length) {
            if (next.learners[k] == l) { let _ = next.learners.remove(k); } else { k += 1; }
        }
        next.voters.push(l)?;
        return Ok(r.changeMembers(next)?.isSome());
    }
    // A target node not in the group joins as a learner.
    for (t in target) {
        if (m.isVoter(t) || m.isLearner(t)) { continue; }
        var next = m.copy()?;
        next.learners.push(t)?;
        return Ok(r.changeMembers(next)?.isSome());
    }
    // A learner the target leaves out goes.
    for (l in m.learners.view()) {
        if (contains(target, l)) { continue; }
        var next = m.copy()?;
        var k = 0usize;
        while (k < next.learners.length) {
            if (next.learners[k] == l) { let _ = next.learners.remove(k); } else { k += 1; }
        }
        return Ok(r.changeMembers(next)?.isSome());
    }
    // Every target node votes: a voter the target leaves out goes (the leader too, which then steps down).
    for (v in m.voters.view()) {
        if (contains(target, v)) { continue; }
        var next = m.copy()?;
        var k = 0usize;
        while (k < next.voters.length) {
            if (next.voters[k] == v) { let _ = next.voters.remove(k); } else { k += 1; }
        }
        return Ok(r.changeMembers(next)?.isSome());
    }
    return Ok(false);
}

fn rebalanceAndDrain(
    r: borrow mut ShardReplica,
    st: borrow mut ObjectStore,
    target: Slice<u32>,
    group0: bool,
) -> Result<Vector<RaftMessage>, StoreError> {
    let _ = if (group0) group0Step(r, target)? else rebalanceStep(r, target)?;
    var out = Vector<RaftMessage>.create();
    r.drain(st, mut out)?;
    return Ok(out);
}

/// Every REBALANCE_EVERY_MS: group 0's leader writes the cluster file's active set if group 0 has none yet; each
/// shard this node leads takes one step toward its target.
async fn rebalanceForever(shared: borrow NodeShared) -> Result<void, NodeFault> {
    while (true) {
        if (!(await frontPause(REBALANCE_EVERY_MS))) { return Err(NodeFault.Net); }
        let active = await readActive(shared)?;
        // Group 0's first record: the active set the cluster began with.
        match (slotOf(shared, GROUP0_SHARD)) {
            Some(g) => {
                let leads = (await viewOf(borrow shared.slots[g]))?.leads;
                if (leads) {
                    var has = true;
                    {
                        var storeGuard = match (await shared.slots[g].store.get().lock()) {
                            Ok(x) => x,
                            Err(_) => { return Err(NodeFault.Net); }
                        };
                        let st = storeGuard.data();
                        has = match (st.bucketExists(SYSTEM_BUCKET)) {
                            Ok(h) => h,
                            Err(_) => true,
                        };
                    }
                    // The store's lock is released: writeActive takes it again.
                    if (!has) { let _ = await writeActive(shared, active.view())?; }
                }
            }
            null => {}
        }
        for (i in 0..shared.slots.length) {
            let slot = borrow shared.slots[i];
            if (slot.failed.load() != 0) { continue; }
            var guard = match (await slot.replica.lock()) {
                Ok(g) => g,
                Err(_) => { return Err(NodeFault.Net); }
            };
            let r = guard.data();
            if (!r.core.isLeader()) { continue; }
            // Group 0 moves too (ADR-0067): three voters among the active nodes, every other roster node its
            // learner; a shard, to its placement among them.
            let group0 = slot.shard == GROUP0_SHARD;
            let target = match (if (group0) group0Target(
                borrow shared.file,
                active.view(),
                r.core.members.voters.view(),
            ) else shared.file.placementAmong(
                slot.shard,
                active.view(),
            )) {
                Ok(t) => t,
                Err(_) => { return Err(NodeFault.OutOfMemory); }
            };
            var storeGuard = match (await slot.store.get().lock()) {
                Ok(g) => g,
                Err(_) => { return Err(NodeFault.Net); }
            };
            let st = storeGuard.data();
            let stepped = await Async.blocking(() => rebalanceAndDrain(r, st, target.view(), group0));
            match (stepped) {
                Ok(out) => { await enqueue(shared, slot.shard, out)?; }
                Err(e) => { await noteFailure(slot, e); }
            }
        }
    }
    return Ok();
}

/// `POST /cluster/active` (an operator's, signed): u8 1 to make node `id` active, 2 to drain it; u32 the node. 200
/// once group 0 has applied the new set; 421 when this node does not lead group 0.
async fn changeActive(shared: borrow NodeShared, body: Slice<u8>) -> Result<u16, NodeFault> {
    if (body.length != 5) { return Ok(400); }
    let op = body[0];
    let id = body.readLE<u32>(1);
    if (shared.file.node(id).isNull() || (op != 1 && op != 2)) { return Ok(400); }
    match (slotOf(shared, GROUP0_SHARD)) {
        Some(g) => {
            if (!(await viewOf(borrow shared.slots[g]))?.leads) { return Ok(421); }
        }
        null => { return Ok(421); }
    }
    let current = await readActive(shared)?;
    var next = Vector<u32>.create();
    for (a in current.view()) {
        if (a != id && next.push(a).isErr()) { return Err(NodeFault.OutOfMemory); }
    }
    if (op == 1 && next.push(id).isErr()) { return Err(NodeFault.OutOfMemory); }
    if ((next.length as u64) < (shared.file.replicas as u64)) { return Ok(409); } // not enough left to hold every shard
    if (await writeActive(shared, next.view())?) { return Ok(200); }
    return Ok(503);
}

/// `cosmostore cluster-join` and `cluster-leave --cluster-file <path> --node <id>`: asks each node of the roster in turn
/// until group 0's leader takes it.
fn clusterActiveCommand(op: u8) -> i32 {
    let args = match (clusterArguments(2)) {
        Some(a) => a,
        null => { return 2; }
    };
    let loaded = match (loadCluster(args.file.view())) {
        Ok(l) => l,
        Err(message) => {
            Console.writeErrorLine(message.view());
            return 1;
        }
    };
    var body = Vector<u8>.create();
    if (body.push(op).isErr() || body.pushLE(args.node).isErr()) { return 1; }
    // Each node in turn, for about fifteen seconds: a group 0 between leaders, or a write that needs a moment, answers
    // 421 or 503 at once, so the rounds pause (ten back to back were over in milliseconds).
    for (attempt in 0..30) {
        if (attempt > 0) { let _ = Async.run(Timer.sleep(500)); }
        for (i in 0..loaded.file.nodes.length) {
            var url = textOf("http://");
            if (appendPeerAddress(
                mut url,
                loaded.file.nodes[i].peer,
            ).isErr() || url.append("/cluster/active").isErr()) {
                return 1;
            }
            let status = match (Async.run(askActive(borrow loaded, url.view(), body.view()))) {
                Ok(s) => s,
                Err(_) => 0u16,
            };
            if (status == 200) { return 0; }
            if (status == 409) {
                Console.writeErrorLine("cosmostore: too few active nodes would be left to hold every shard");
                return 1;
            }
        }
    }
    Console.writeErrorLine("cosmostore: no node took the change (no leader of group 0?)");
    return 1;
}

async fn askActive(loaded: borrow LoadedCluster, url: StringView, body: Slice<u8>) -> Result<u16, NodeFault> {
    var options = ClientOptions.defaults();
    options.totalMs = 10000;
    options.retry = RetryPolicy.never();
    let client = match (Client.create(options, null)) {
        Ok(c) => c,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    var request = match (ClientRequest.create(Method.Post, url)) {
        Ok(r) => r,
        Err(_) => { return Err(NodeFault.Net); }
    };
    if (!signRequest(
        mut request,
        borrow loaded.file,
        loaded.secret.view(),
        0,
        "POST",
        "/cluster/active",
        body,
        Clock.unixMillis(),
    )) {
        return Err(NodeFault.OutOfMemory);
    }
    var content = match (BytesBody.of(body)) {
        Ok(b) => b,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    var response = match (await client.send(request, mut content)) {
        Ok(r) => r,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let status = response.status();
    var answer = Vector<u8>.create();
    let _ = await response.readToEnd(mut answer, 65536);
    let _ = await response.finish(client);
    await client.shutdown();
    return Ok(status);
}

// --- Scrub and repair (ADR-0063) ---

const SCRUB_STEP_VERSIONS: usize = 256;

/// A request for a record: u32 shard, u32 length, 16 version id, u16 + bytes bucket, u16 + bytes key.
fn encodeRecordAsk(shard: u32, d: borrow ScrubDamage) -> Result<Vector<u8>, AllocError> {
    var out = Vector<u8>.create();
    out.pushLE(shard)?;
    out.pushLE(d.length)?;
    out.extend(d.versionId[..])?;
    out.pushLE(truncate<u16>(d.bucket.length))?;
    out.extend(d.bucket.view())?;
    out.pushLE(truncate<u16>(d.key.length))?;
    out.extend(d.key.view())?;
    return Ok(out);
}

/// This node's copy of the record another replica asks for, or null.
async fn recordFor(shared: borrow NodeShared, body: Slice<u8>) -> Vector<u8>? {
    if (body.length < 26) { return null; }
    let shard = body.readLE<u32>(0);
    let length = body.readLE<u32>(4);
    var versionId = [0u8; 16];
    for (i in 0..16) { versionId[i] = body[8 + i]; }
    let bl = body.readLE<u16>(24) as usize;
    if (body.length < 26 + bl + 2) { return null; }
    let bucket = body[26..26 + bl];
    let kl = body.readLE<u16>(26 + bl) as usize;
    if (body.length != 28 + bl + kl) { return null; }
    let key = body[28 + bl..28 + bl + kl];
    let at = match (slotOf(shared, shard)) {
        Some(i) => i,
        null => { return null; }
    };
    var storeGuard = match (await shared.slots[at].store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return null; }
    };
    let st = storeGuard.data();
    let found = await Async.blocking(() => st.recordOfVersion(bucket, key, versionId, length));
    return match (found) {
        Ok(r) => r,
        Err(_) => null,
    };
}

/// Puts one damaged record right from the first of the shard's other replicas that has it whole.
async fn repairFromReplica(shared: borrow NodeShared, slot: borrow ShardSlot, d: borrow ScrubDamage) -> bool {
    let group = match (await shardGroupOf(slot)) {
        Ok(g) => g,
        Err(_) => { return false; }
    };
    let ask = match (encodeRecordAsk(slot.shard, d)) {
        Ok(a) => a,
        Err(_) => { return false; }
    };
    for (p in 0..group.length) {
        if (group[p] == shared.id) { continue; }
        let url = match (peerUrl(shared, group[p], "/record-fetch")) {
            Some(u) => u,
            null => { continue; }
        };
        let empty = RawMessage.empty();
        let reply = match (await exchangeRaw(shared, url.view(), borrow empty, Some("/record-fetch"), ask.view())) {
            Ok(r) => r,
            Err(_) => { continue; }
        };
        if (reply.status != 200) { continue; }
        var storeGuard = match (await slot.store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return false; }
        };
        let st = storeGuard.data();
        let bucket = d.bucket.view();
        let key = d.key.view();
        let id = d.versionId;
        let record = reply.body.view();
        match (await Async.blocking(() => st.repairRecord(bucket, key, id, record))) {
            Ok(true) => { return true; }
            _ => {}
        }
    }
    return false;
}

/// Every `scrubEveryMs`, a pass over each replica's live versions (ADR-0063 §1): damaged extents removed for fetching to
/// replace, damaged records repaired from another replica's copy.
async fn scrubForever(shared: borrow NodeShared) -> Result<void, NodeFault> {
    while (true) {
        if (!(await frontPause(shared.scrubEveryMs))) { return Err(NodeFault.Net); }
        for (i in 0..shared.slots.length) {
            let slot = borrow shared.slots[i];
            if (slot.failed.load() != 0) { continue; }
            var after: IndexKey? = null;
            while (true) {
                var page = ScrubPage { checked: 0, damages: Vector<ScrubDamage>.create(), next: null };
                {
                    var storeGuard = match (await slot.store.get().lock()) {
                        Ok(g) => g,
                        Err(_) => { return Err(NodeFault.Net); }
                    };
                    let st = storeGuard.data();
                    let from = replace(mut after, null);
                    page = match (await Async.blocking(() => st.scrubStep(borrow from, SCRUB_STEP_VERSIONS))) {
                        Ok(p) => p,
                        Err(_) => { break; }
                    };
                }
                let _ = shared.scrubChecked.fetchAdd(page.checked);
                for (k in 0..page.damages.length) {
                    let d = borrow page.damages[k];
                    let _ = shared.scrubDamaged.fetchAdd(1);
                    if (d.extent) {
                        var storeGuard = match (await slot.store.get().lock()) {
                            Ok(g) => g,
                            Err(_) => { return Err(NodeFault.Net); }
                        };
                        let st = storeGuard.data();
                        let id = d.id;
                        await Async.blocking(() => st.quarantineExtent(id));
                        let _ = shared.scrubRepaired.fetchAdd(1); // fetching puts it back
                    } else if (await repairFromReplica(shared, slot, d)) {
                        let _ = shared.scrubRepaired.fetchAdd(1);
                    } else {
                        var line = textOf("cosmostore: scrub: a damaged record no replica could repair, shard ");
                        var n = Vector<u8>.create();
                        let _ = appendDecimal(mut n, slot.shard as u64);
                        let _ = line.append(StringView.fromUtf8(n.view()) ?? "");
                        let _ = line.append("\n");
                        let _ = await AsyncConsole.writeError(line.view());
                    }
                }
                match (page.next) {
                    Some(k) => { after = Some(k); }
                    null => { break; }
                }
            }
        }
    }
    return Ok();
}
