// Table maintenance on a cluster (ADR-0086 §5, ADR-0110, ADR-0128): every hour of a day, each shard this node leads
// lists its tables from its store and runs each one's jobs as the leader's gated steps (`tables_steps.cee`), not as
// requests to its own front; the runs a client asked for (`maintenance-run`) within a second. A loop per shard.
import web_core;
import web_transport;
import web_http;
import web_client;

/// The asks kept in a shard's store (ADR-0128 §3), queued for its new leader's loop, each once.
async fn queueKeptAsks(slot: borrow ShardSlot) -> Result<void, NodeFault> {
    var kept = Vector<AskedRun>.create();
    {
        var guard = match (await slot.store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let st = guard.data();
        kept = match (await Async.blocking(() => askedRunsOf(st))) {
            Ok(k) => k,
            Err(_) => { return Ok(); } // read again by the next leader; the day's pass runs every job
        };
    }
    var queue = match (await slot.asked.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let runs = queue.data();
    while (kept.length > 0) {
        let k = kept.remove(0);
        var there = false;
        for (r in runs.view()) {
            if (r.kind.view() == k.kind.view() && r.table.bucket.view() == k.table.bucket.view() &&
                r.table.ns.view() == k.table.ns.view() && r.table.name.view() == k.table.name.view()) {
                there = true;
            }
        }
        if (!there && runs.push(k).isErr()) { return Err(NodeFault.OutOfMemory); }
    }
    return Ok();
}

/// One shard's table maintenance on this node (ADR-0128 §4, M22's B3): every hour of a day while this node leads it,
/// each table's jobs, run as the leader's gated steps (ADR-0110 §5); and, within a second, the runs its S3 servers
/// were asked for. Each shard has its own loop, so one shard's long compaction holds up no other's asks or passes.
async fn tablesMaintenanceShardForever(shared: borrow NodeShared, i: usize) -> Result<void, NodeFault> {
    let slot = borrow shared.slots[i];
    if (slot.shard == GROUP0_SHARD) { return Ok(); }
    let every = if (shared.tablesDayMs / 24 > 0) shared.tablesDayMs / 24 else 1;
    var sincePass: u64 = 0;
    let tick: u64 = if (every < 1000) every else 1000;
    // Table replication's copies go through the node's front (ADR-0138 §4).
    var options = ClientOptions.defaults();
    options.totalMs = 60000;
    options.retry = RetryPolicy.never();
    let client = match (Client.create(options, deliveryConnector())) {
        Ok(c) => c,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    // The term this node last queued the shard's kept asks in as its leader (0: none): a term it leads in anew, once
    // it has applied what its log holds, has them queued (the M31 exit review: a term, not whether it led, so that a
    // leadership lost and regained within a long run counts; and caught up, so that an ask the last leader committed
    // is read).
    var queuedTerm: u64 = 0;
    while (true) {
        if (!(await frontPause(tick))) { return Err(NodeFault.Net); }
        sincePass += tick;
        let pass = sincePass >= every;
        if (pass) { sincePass = 0; }
        if (slot.failed.load() != 0) { continue; }
        // The asks its last leader kept and did not run, queued (ADR-0128 §3, M22's B2).
        let view = await viewOf(slot)?;
        let leads = view.leads;
        if (leads && view.term != queuedTerm && view.applied == view.last && view.coreLast == view.last) {
            await queueKeptAsks(slot)?;
            queuedTerm = view.term;
        }
        // The runs asked for, taken from the queue: a shard this node does not lead drops them (its leader's server
        // is asked instead).
        var asked = Vector<AskedRun>.create();
        {
            var queue = match (await slot.asked.get().lock()) {
                Ok(g) => g,
                Err(_) => { return Err(NodeFault.Net); }
            };
            let runs = queue.data();
            while (runs.length > 0) {
                if (asked.push(runs.remove(0)).isErr()) { return Err(NodeFault.OutOfMemory); }
            }
        }
        if (!pass && asked.length == 0) { continue; }
        if (!leads) { continue; }
        for (k in 0..asked.length) {
            await maintainOnShard(shared, i, borrow asked[k].table, asked[k].kind.view())?;
            // An ask made while it ran is answered by this run, not run again (ADR-0110 §5, the M22 exit review's
            // finding 4).
            var queue = match (await slot.asked.get().lock()) {
                Ok(g) => g,
                Err(_) => { return Err(NodeFault.Net); }
            };
            let runs = queue.data();
            var at: usize = 0;
            while (at < runs.length) {
                let r = borrow runs[at];
                let same = r.kind.view() == asked[k].kind.view() &&
                    r.table.bucket.view() == asked[k].table.bucket.view() &&
                    r.table.ns.view() == asked[k].table.ns.view() &&
                    r.table.name.view() == asked[k].table.name.view();
                if (same) {
                    let _ = runs.remove(at);
                } else {
                    at += 1;
                }
            }
        }
        // Each tick, the asks of a shard this node leads copied (ADR-0138 §4).
        if (leads) { let _ = await replicationOnShard(shared, i, borrow client); }
        if (!pass) { continue; }
        var tables = Vector<MaintainedTable>.create();
        {
            var guard = match (await slot.store.get().lock()) {
                Ok(g) => g,
                Err(_) => { return Err(NodeFault.Net); }
            };
            let st = guard.data();
            tables = match (await Async.blocking(() => maintainedTables(st))) {
                Ok(t) => t,
                Err(_) => { continue; }
            };
        }
        for (k in 0..tables.length) {
            // A replica's snapshots and files are its source's (ADR-0138 §2): only its unreferenced files removed.
            var replica = false;
            {
                var guard = match (await slot.store.get().lock()) {
                    Ok(g) => g,
                    Err(_) => { return Err(NodeFault.Net); }
                };
                let st = guard.data();
                let t = borrow tables[k];
                replica = (await Async.blocking(() => isReplicaTable(st, t))).ok() ?? false;
            }
            // Compaction between them, as `serve` runs it (ADR-0098 §4).
            for (kind in [SNAPSHOT_MANAGEMENT, COMPACTION, UNREFERENCED_REMOVAL]) {
                if (replica && kind.bytes() != UNREFERENCED_REMOVAL.bytes()) { continue; }
                await maintainOnShard(shared, i, borrow tables[k], kind.bytes())?;
            }
            if (leads) { await reconcileOnShard(shared, i, borrow tables[k])?; }
        }
        // Then each table bucket's orphaned files (ADR-0136 §3).
        await orphansOnShard(shared, i)?;
    }
    return Err(NodeFault.Net);
}
