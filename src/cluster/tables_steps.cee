// Table maintenance on a cluster as the leader's gated steps (ADR-0110 §1, §2): each step that writes takes the
// shard's gate, stages its entries under the store's lock, pushes its extents, proposes, and waits until they are
// applied, as `leadWrite` does after its forward; the reads and the copies run off the gate. The steps are the same
// functions `serve`'s run calls (`table_compaction.cee`); the run is the leader's own, not a request, so no front
// timeout applies to it (§5).

/// Before a gated step, under the gate: this replica leads, in the run's term (`term`: 0 for the run's first step,
/// which sets it), and everything it holds is applied (as `leadWrite` waits). False when it does not lead, its term
/// changed since the run began (ADR-0110 §1, the M22 exit review's finding 5), or nothing settled within
/// FRONT_COMMIT_MS.
async fn stepReady(slot: borrow ShardSlot, term: borrow mut u64) -> Result<bool, NodeFault> {
    var waited = 0u64;
    while (true) {
        let v = await viewOf(slot)?;
        if (!v.leads) { return Ok(false); }
        if (*term != 0 && v.term != *term) { return Ok(false); }
        if (v.applied == v.last && v.coreLast == v.last) {
            *term = v.term;
            return Ok(true);
        }
        if (waited >= FRONT_COMMIT_MS || !(await frontPause(FRONT_POLL_MS))) { return Ok(false); }
        waited += FRONT_POLL_MS;
    }
    return Ok(false);
}

/// After a gated step staged its entries, still under the gate: its extents on a majority, its entries proposed, and
/// committed and applied in the term they were proposed in. True when they are (or it staged nothing and still
/// leads); false when this replica stopped leading or a majority did not take them, and the run ends there.
async fn stepCommit(shared: borrow NodeShared, slot: borrow ShardSlot) -> Result<bool, NodeFault> {
    if (!(await pushExtents(shared, slot)?)) {
        await abandonStaged(slot);
        return Ok(false);
    }
    let proposed = match (await proposeStaged(shared, slot, null, "".bytes())?) {
        Some(p) => p,
        null => { return Ok((await viewOf(slot)?).leads); }
    };
    var waited = 0u64;
    while (true) {
        let v = await viewOf(slot)?;
        if (v.applied >= proposed.last) { return Ok((await entryTermOf(slot, proposed.last))? == proposed.term); }
        if (!v.leads || v.term != proposed.term) { return Ok(false); }
        if (waited >= FRONT_COMMIT_MS || !(await frontPause(FRONT_POLL_MS))) { return Ok(false); }
        waited += FRONT_POLL_MS;
    }
    return Ok(false);
}

/// A table's compaction on the shard this replica leads (ADR-0110 §2): the plan and footers read off the gate; each
/// bin's bytes copied off it, then its put one gated step; the commit one gated step. A step that fails because this
/// replica stopped leading ends the run: what it put is no snapshot's, and unreferenced removal takes it.
async fn compactOnShard(
    shared: borrow NodeShared,
    at: usize,
    t: borrow MaintainedTable,
    nowMs: i64,
    pauseMs: u64,
) -> Result<void, NodeFault> {
    let slot = borrow shared.slots[at];
    let store = borrow slot.store;
    var term: u64 = 0;
    // The plan: a gated step, as it may write the job's status (a strategy not done, a table it cannot plan): a write
    // staged off the gate would be proposed by no one, and hold up the shard's every write after it.
    var planned: CompactionDraft? = null;
    {
        var gate = match (await slot.gate.lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let _held = gate.data();
        if (!(await stepReady(slot, mut term)?)) { return Ok(); }
        let tableKeys = TableKeys { sse: shared.replication.sseKeys.clone(), kms: shared.replication.kmsKeys.clone() };
        planned = match (await lockedPlan(store, t, nowMs, borrow tableKeys)) {
            Ok(d) => d,
            Err(_) => null,
        };
        if (!(await stepCommit(shared, slot)?)) { return Ok(); }
    }
    var draft = match (planned) {
        Some(d) => d,
        null => { return Ok(); }
    };
    match (await Async.blocking(() => readFooterLengths(mut draft))) {
        Ok() => {}
        Err(_) => { return Ok(); }
    }
    {
        var guard = match (await store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let st = guard.data();
        let dr = borrow mut draft;
        await Async.blocking(() => pinFooters(st, dr));
    }
    match (await Async.blocking(() => finishPlan(mut draft))) {
        Ok() => {}
        Err(_) => { return Ok(); }
    }
    var plan = draft.plan;
    var outputs = Vector<CompactionOutput>.create();
    var joined = Vector<usize>.create();
    var outOfMemory = false;
    for (b in 0..plan.bins.length) {
        // Merged, or joined when its merge fails (the M23 exit review); an input changed waits for the next run.
        var written = match (await copiedBin(store, mut plan, b)) {
            Ok(Some(w)) => w,
            _ => { continue; }
        };
        let p = borrow plan;
        if (pauseMs > 0 && !(await frontPause(pauseMs))) { return Err(NodeFault.Net); }
        // The bin's put: one gated step, with its own extent push.
        var gate = match (await slot.gate.lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let _held = gate.data();
        if (!(await stepReady(slot, mut term)?)) { return Ok(); }
        {
            var guard = match (await store.get().lock()) {
                Ok(g) => g,
                Err(_) => { return Err(NodeFault.Net); }
            };
            let st = guard.data();
            let obj = borrow written.obj;
            let seal = written.seal.view();
            match (await Async.blocking(() => putBin(st, p, b, obj, seal))) {
                Ok(Some(o)) => {
                    // A merged file's metrics, from its rows (ADR-0114 §2).
                    var out = o;
                    out.metrics = written.metrics;
                    if (outputs.push(out).isErr() || joined.push(b).isErr()) { outOfMemory = true; }
                }
                _ => {}
            }
        }
        // Committed even when out of memory: what the step staged must be proposed, or the shard's every write after
        // it waits (the M22 exit review's finding 2); the run ends after.
        if (!(await stepCommit(shared, slot)?) || outOfMemory) { return Ok(); }
    }
    // Each partition's position deletes rewritten (ADR-0120): pinned under the store, read and written off it, and
    // put in a gated step of its own, as a bin is.
    if (plan.deleteRewrites.length > 0) {
        let live = match (await Async.blocking(() => liveDataFiles(borrow plan, joined.view()))) {
            Ok(l) => l,
            Err(_) => { return Ok(); }
        };
        for (r in 0..plan.deleteRewrites.length) {
            if (!rewriteNeedsRead(borrow plan, r, borrow live)) { continue; }
            var prepared: DeleteRewriteCopy? = null;
            {
                var guard = match (await store.get().lock()) {
                    Ok(g) => g,
                    Err(_) => { return Err(NodeFault.Net); }
                };
                let st = guard.data();
                let p = borrow plan;
                prepared = match (await Async.blocking(() => prepareDeleteRewrite(st, p, r))) {
                    Ok(c) => c,
                    Err(_) => null,
                };
            }
            var copy = prepared ?? { continue; };
            let lv = borrow live;
            let w = match (await Async.blocking(() => writeDeleteRewrite(mut copy, lv))) {
                Ok(Some(w)) => w,
                _ => { continue; }
            };
            if (pauseMs > 0 && !(await frontPause(pauseMs))) { return Err(NodeFault.Net); }
            var gate = match (await slot.gate.lock()) {
                Ok(g) => g,
                Err(_) => { return Err(NodeFault.Net); }
            };
            let _held = gate.data();
            if (!(await stepReady(slot, mut term)?)) { return Ok(); }
            {
                var guard = match (await store.get().lock()) {
                    Ok(g) => g,
                    Err(_) => { return Err(NodeFault.Net); }
                };
                let st = guard.data();
                let p = borrow mut plan;
                let wr = borrow w;
                let _ = await Async.blocking(() => putDeleteRewrite(st, p, r, wr));
            }
            if (!(await stepCommit(shared, slot)?)) { return Ok(); }
        }
    }
    // The commit, or the job's status when there is nothing to commit: one gated step.
    var leftover = Vector<Vector<u8>>.create();
    var gate = match (await slot.gate.lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let _held = gate.data();
    if (!(await stepReady(slot, mut term)?)) { return Ok(); }
    {
        var guard = match (await store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let st = guard.data();
        let o = borrow outputs;
        let j = joined.view();
        let lo = borrow mut leftover;
        let _ = await Async.blocking(() => finishCompaction(st, mut plan, o, j, nowMs, lo));
    }
    if (!(await stepCommit(shared, slot)?) || leftover.length == 0) { return Ok(); }
    // A failed commit's files, written in its own step and so not deleted there: deleted in one more (finding 1).
    if (!(await stepReady(slot, mut term)?)) { return Ok(); }
    {
        var guard = match (await store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let st = guard.data();
        let hidden = plan.hidden.view();
        let keys = leftover.view();
        await Async.blocking(() => deleteLeftovers(st, hidden, keys));
    }
    let _ = await stepCommit(shared, slot)?;
    return Ok();
}

/// Snapshot management on the shard this replica leads (ADR-0110 §3): one gated step.
async fn snapshotsOnShard(
    shared: borrow NodeShared,
    at: usize,
    t: borrow MaintainedTable,
    nowMs: i64,
    dayMs: i64,
) -> Result<void, NodeFault> {
    let slot = borrow shared.slots[at];
    var term: u64 = 0;
    var gate = match (await slot.gate.lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let _held = gate.data();
    if (!(await stepReady(slot, mut term)?)) { return Ok(); }
    {
        var guard = match (await slot.store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let st = guard.data();
        let tableKeys = TableKeys { sse: shared.replication.sseKeys.clone(), kms: shared.replication.kmsKeys.clone() };
        let keys = borrow tableKeys;
        let _ = await Async.blocking(() => maintainTable(st, t, nowMs, dayMs, keys));
    }
    let _ = await stepCommit(shared, slot)?;
    return Ok();
}

/// Unreferenced removal on the shard this replica leads (ADR-0110 §4): its reads off the gate; its sweep (or its
/// failure's status) one gated step.
async fn removeOnShard(
    shared: borrow NodeShared,
    at: usize,
    t: borrow MaintainedTable,
    nowMs: i64,
    dayMs: i64,
) -> Result<void, NodeFault> {
    let slot = borrow shared.slots[at];
    let tableKeys = TableKeys { sse: shared.replication.sseKeys.clone(), kms: shared.replication.kmsKeys.clone() };
    var read = match (await readUnreferenced(borrow slot.store, t, borrow tableKeys)) {
        Ok(Some(r)) => r,
        _ => { return Ok(); }
    };
    var term: u64 = 0;
    var gate = match (await slot.gate.lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let _held = gate.data();
    if (!(await stepReady(slot, mut term)?)) { return Ok(); }
    {
        var guard = match (await slot.store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let st = guard.data();
        let r = borrow mut read;
        let _ = await Async.blocking(() => finishUnreferenced(st, r, nowMs, dayMs));
    }
    let _ = await stepCommit(shared, slot)?;
    return Ok();
}

/// A compaction's permit (ADR-0128 §4): waited for while the node runs `tablesCompactions` of them; false when the
/// node is stopping.
async fn compactionPermit(shared: borrow NodeShared) -> Result<bool, NodeFault> {
    while (true) {
        if (shared.compactionsRunning.fetchAdd(1) < shared.tablesCompactions) { return Ok(true); }
        let _ = shared.compactionsRunning.fetchSub(1);
        if (!(await frontPause(200))) { return Ok(false); }
    }
    return Ok(false);
}

/// One job of a table on the shard this replica leads, by its kind.
async fn maintainOnShard(
    shared: borrow NodeShared,
    at: usize,
    t: borrow MaintainedTable,
    kind: Slice<u8>,
) -> Result<void, NodeFault> {
    let nowMs = Clock.unixMillis();
    let dayMs = truncate<i64>(shared.tablesDayMs);
    if (kind == SNAPSHOT_MANAGEMENT.bytes()) { return await snapshotsOnShard(shared, at, t, nowMs, dayMs); }
    if (kind == COMPACTION.bytes()) {
        // A permit of the node's `--tables-compactions` (ADR-0128 §4): shards compact side by side, a bounded number
        // at once. It is given back on every path, as no drop may take a lock.
        if (!(await compactionPermit(shared)?)) { return Err(NodeFault.Net); }
        let done = await compactOnShard(shared, at, t, nowMs, shared.tablesCopyPauseMs);
        let _ = shared.compactionsRunning.fetchSub(1);
        return done;
    }
    if (kind == UNREFERENCED_REMOVAL.bytes()) { return await removeOnShard(shared, at, t, nowMs, dayMs); }
    return Ok();
}
