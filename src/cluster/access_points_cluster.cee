// Access Points on a cluster (ADR-0078 §5). An access point's configuration is its bucket's, on the bucket's shard, as
// on `serve` (ADR-0076 §2). Its name, which must be unique in the cluster, and the bucket and alias it goes with are
// a claim in group 0: the object `access-point/<name>` of its system bucket, `<bucket>\n<alias>`, which every node
// holds a copy of. The front claims a name before the shard makes the access point, and resolves an alias or an ARN's
// host by the claims, so that it can route such a request to the bucket's shard.
import web_core;
import web_http;
import web_client;

const CLAIM_PREFIX: StringView = "access-point/";
/// The peer path group 0's leader takes claims on (signed by a node, never an operator).
const CLAIM_PATH: StringView = "/cluster/access-point";
/// Claims `name` for `bucket` with `alias`, pending: 201 with `<alias, token>` when made now (or taken over from a
/// pending claim older than CLAIM_PENDING_MS); 200 with `<alias, "">` when the bucket's and confirmed already; 503
/// while another create's pending claim is fresh; 409 when another bucket's and confirmed.
const CLAIM_TAKE: u8 = 1;
/// After DeleteAccessPoint (or the shard not having it): lets `name` go if it is `bucket`'s and confirmed. A pending
/// claim is its creator's to confirm or abandon.
const CLAIM_RELEASE: u8 = 2;
/// After DeleteBucket: lets go every confirmed name of `bucket` confirmed before `<ms>`, the time the delete was
/// answered (a name claimed again for a bucket made again since is kept).
const CLAIM_RELEASE_BUCKET: u8 = 3;
/// Finds a claim by name, or by what a request's bucket says (an alias, `<name>-<account>`): 200 with
/// `<name, bucket, alias>`, or 404. A read of the leader's copy, which has every claim answered.
const CLAIM_FIND: u8 = 4;
/// The shard made it (or has it): `name`'s pending claim with `token` is confirmed; a claim that is gone is made
/// again, confirmed; 409 when another's.
const CLAIM_CONFIRM: u8 = 5;
/// The shard refused the create for good: `name`'s pending claim with `token` goes.
const CLAIM_ABANDON: u8 = 6;
/// How long a pending claim holds its name: past it, its create is taken to have failed, and the name may be claimed.
const CLAIM_PENDING_MS: i64 = 60000;

struct AccessPointClaim {
    name: Vector<u8>;
    bucket: Vector<u8>;
    alias: Vector<u8>;
    confirmed: bool;
    /// The creating request's, while pending (and kept once confirmed).
    token: Vector<u8>;
    /// When it was claimed, or confirmed: group 0 leader's clock.
    madeMs: i64;
}

struct ClaimAnswer {
    status: u16;
    body: Vector<u8>;
}

fn claimAnswer(status: u16) -> ClaimAnswer {
    return ClaimAnswer { status: status, body: Vector<u8>.create() };
}

fn claimKey(name: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var k = Vector<u8>.create();
    k.extend(CLAIM_PREFIX.bytes())?;
    k.extend(name)?;
    return Ok(k);
}

/// A field: a u16 length and its bytes; one over 65,535 bytes goes as an empty field, which every op refuses.
fn pushField(out: borrow mut Vector<u8>, f: Slice<u8>) -> Result<void, AllocError> {
    if (f.length > 65535) {
        out.pushLE(0u16)?;
        return Ok();
    }
    out.pushLE(truncate<u16>(f.length))?;
    return out.extend(f);
}

/// Three fields, each a u16 length and its bytes.
fn claimFields(a: Slice<u8>, b: Slice<u8>, c: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var out = Vector<u8>.create();
    pushField(mut out, a)?;
    pushField(mut out, b)?;
    pushField(mut out, c)?;
    return Ok(out);
}

/// A peer request's body: the op, then its three fields.
fn claimRequest(op: u8, a: Slice<u8>, b: Slice<u8>, c: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var out = Vector<u8>.create();
    out.push(op)?;
    pushField(mut out, a)?;
    pushField(mut out, b)?;
    pushField(mut out, c)?;
    return Ok(out);
}

fn claimField<region a>(body: Slice<a, u8>, at: borrow mut usize) -> Slice<a, u8>? {
    if (at + 2 > body.length) { return null; }
    let n = body.readLE<u16>(at) as usize;
    if (at + 2 + n > body.length) { return null; }
    let f = body[at + 2..at + 2 + n];
    at = at + 2 + n;
    return Some(f);
}

/// A claim's stored value: `<bucket>\n<alias>\n<c or p>\n<token>\n<ms>`; the first two alone (as first built) are
/// a confirmed claim of no time.
fn encodeClaim(c: borrow AccessPointClaim) -> Result<Vector<u8>, AllocError> {
    var out = Vector<u8>.create();
    out.extend(c.bucket.view())?;
    out.push('\n')?;
    out.extend(c.alias.view())?;
    out.push('\n')?;
    out.push(if (c.confirmed) 'c' else 'p')?;
    out.push('\n')?;
    out.extend(c.token.view())?;
    out.push('\n')?;
    appendDecimal(mut out, checkedTruncate<u64>(c.madeMs) ?? 0)?;
    return Ok(out);
}

fn decodeClaim(name: Slice<u8>, b: Slice<u8>) -> Result<AccessPointClaim?, AllocError> {
    var pieces = Vector<Slice<u8>>.create();
    var from = 0usize;
    for (i in 0..b.length) {
        if (b[i] == '\n') {
            pieces.push(b[from..i])?;
            from = i + 1;
        }
    }
    pieces.push(b[from..])?;
    if (pieces.length != 2 && pieces.length != 5) { return Ok(null); }
    var c = AccessPointClaim {
        name: copyBytes(name)?,
        bucket: copyBytes(pieces[0])?,
        alias: copyBytes(pieces[1])?,
        confirmed: true,
        token: Vector<u8>.create(),
        madeMs: 0,
    };
    if (pieces.length == 5) {
        c.confirmed = pieces[2] == "c".bytes();
        c.token = copyBytes(pieces[3])?;
        c.madeMs = (StringView.fromUtf8(pieces[4]) ?? "").parseInt<i64>() ?? 0;
    }
    return Ok(Some(c));
}

/// The claim of `name` as `st` (a copy of group 0) has it.
fn storedClaim(st: borrow mut ObjectStore, name: Slice<u8>) -> Result<AccessPointClaim?, AllocError> {
    let key = claimKey(name)?;
    let keyView = StringView.fromUtf8(key.view()) ?? "";
    let bytes = match (st.getObject(SYSTEM_BUCKET, keyView)) {
        Ok(b) => b,
        Err(_) => { return Ok(null); }
    };
    return decodeClaim(name, bytes.view());
}

/// The names claimed under `prefix`, every page of them.
fn claimedNames(st: borrow mut ObjectStore, prefix: Slice<u8>) -> Result<Vector<Vector<u8>>, AllocError> {
    var out = Vector<Vector<u8>>.create();
    let full = claimKey(prefix)?;
    let fullView = StringView.fromUtf8(full.view()) ?? "";
    var after = Vector<u8>.create();
    while (true) {
        let page = match (st.listObjects(SYSTEM_BUCKET, fullView, "", after.view(), false, 1000)) {
            Ok(p) => p,
            Err(_) => { return Ok(out); }
        };
        for (i in 0..page.keys.length) {
            out.push(copyBytes(page.keys[i].view()[CLAIM_PREFIX.length..])?)?;
        }
        if (!page.truncated || page.keys.length == 0) { break; }
        after.clear();
        after.extend(page.keys[page.keys.length - 1].view())?;
    }
    return Ok(out);
}

/// The access point a request's bucket names (ADR-0076 §3): `<name>-<account>` from its ARN's host, or its alias,
/// `<the name's first 30>-<20 letters>-s3alias`, found among the names it begins with (at least 3 letters, as every
/// name has).
fn claimNamedBy(st: borrow mut ObjectStore, token: Slice<u8>) -> Result<AccessPointClaim?, AllocError> {
    if (!mayNameAccessPoint(token)) { return Ok(null); }
    if (accountSuffixed(token)) {
        match (storedClaim(st, token[0..token.length - 13])?) {
            Some(c) => { return Ok(Some(c)); }
            null => {}
        }
    }
    let tail = "-s3alias".bytes();
    if (token.length <= tail.length + 21 || token[token.length - tail.length..] != tail) { return Ok(null); }
    var stem = token[0..token.length - tail.length - 20];
    if (stem.length > 0 && stem[stem.length - 1] == '-') { stem = stem[0..stem.length - 1]; }
    if (stem.length < 3) { return Ok(null); }
    let names = claimedNames(st, stem)?;
    for (i in 0..names.length) {
        match (storedClaim(st, names[i].view())?) {
            Some(c) => {
                if (c.alias.view() == token) { return Ok(Some(c)); }
            }
            null => {}
        }
    }
    return Ok(null);
}

fn lookClaim(st: borrow mut ObjectStore, token: Slice<u8>, byName: bool) -> Result<AccessPointClaim?, AllocError> {
    if (byName) { return storedClaim(st, token); }
    return claimNamedBy(st, token);
}

/// This node's copy of group 0: the claim `token` names.
async fn localClaim(shared: borrow NodeShared, token: Slice<u8>, byName: bool) -> Result<AccessPointClaim?, NodeFault> {
    let at = match (slotOf(shared, GROUP0_SHARD)) {
        Some(i) => i,
        null => { return Ok(null); }
    };
    var guard = match (await shared.slots[at].store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let st = guard.data();
    return match (await Async.blocking(() => lookClaim(st, token, byName))) {
        Ok(c) => Ok(c),
        Err(_) => Err(NodeFault.OutOfMemory),
    };
}

/// The claim `token` names: this node's copy first, then, for S3 Control's calls, group 0's leader, whose copy has
/// every claim answered (a copy here may be a moment behind, just after a CreateAccessPoint through another node).
/// A request's bucket is resolved by this node's copy alone: a bucket named like an alias costs no peer request.
async fn findClaim(
    shared: borrow NodeShared,
    token: Slice<u8>,
    byName: bool,
    askLeader: bool,
) -> Result<AccessPointClaim?, NodeFault> {
    match (await localClaim(shared, token, byName)?) {
        Some(c) => { return Ok(Some(c)); }
        null => {}
    }
    if (!askLeader) { return Ok(null); }
    let body = match (claimRequest(CLAIM_FIND, token, if (byName) "1".bytes() else "".bytes(), "".bytes())) {
        Ok(b) => b,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    let answer = await askClaims(shared, body.view())?;
    if (answer.status != 200) { return Ok(null); }
    let b = answer.body.view();
    var at = 0usize;
    let name = claimField(b, mut at) ?? "".bytes();
    let bucket = claimField(b, mut at) ?? "".bytes();
    let alias = claimField(b, mut at) ?? "".bytes();
    if (name.length == 0 || bucket.length == 0) { return Ok(null); }
    return match (claimOf(name, bucket, alias)) {
        Ok(c) => Ok(Some(c)),
        Err(_) => Err(NodeFault.OutOfMemory),
    };
}

fn claimOf(name: Slice<u8>, bucket: Slice<u8>, alias: Slice<u8>) -> Result<AccessPointClaim, AllocError> {
    return Ok(AccessPointClaim {
        name: copyBytes(name)?,
        bucket: copyBytes(bucket)?,
        alias: copyBytes(alias)?,
        confirmed: true,
        token: Vector<u8>.create(),
        madeMs: 0,
    });
}

/// Sends a claim's op to group 0's leader: this node if it leads, else each node in turn, for up to FRONT_WAIT_MS.
/// 503 when none took it.
async fn askClaims(shared: borrow NodeShared, body: Slice<u8>) -> Result<ClaimAnswer, NodeFault> {
    var waited = 0u64;
    while (true) {
        let here = await changeClaim(shared, body)?;
        if (here.status != 421) { return Ok(here); }
        for (i in 0..shared.file.nodes.length) {
            let n = borrow shared.file.nodes[i];
            if (n.id == shared.id) { continue; }
            var url = textOf("http://");
            if (appendPeerAddress(mut url, n.peer).isErr() || url.append(CLAIM_PATH).isErr()) {
                return Err(NodeFault.OutOfMemory);
            }
            let empty = RawMessage.empty();
            match (await exchangeRaw(shared, url.view(), borrow empty, Some(CLAIM_PATH), body)) {
                Ok(reply) => {
                    if (reply.status != 421 && reply.status != 403) {
                        return Ok(ClaimAnswer { status: reply.status, body: reply.body });
                    }
                }
                Err(_) => {}
            }
        }
        if (waited >= FRONT_WAIT_MS || !(await frontPause(50))) { return Ok(claimAnswer(503)); }
        waited += 50;
    }
    return Ok(claimAnswer(503));
}

/// One write of a claim, the system bucket made first if group 0 has none yet.
async fn claimWrite(
    shared: borrow NodeShared,
    slot: borrow ShardSlot,
    change: Group0Change,
    key: Slice<u8>,
    bytes: Slice<u8>,
) -> Result<bool, NodeFault> {
    var hasBucket = true;
    {
        var storeGuard = match (await slot.store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        hasBucket = storeGuard.data().bucketExists(SYSTEM_BUCKET).ok() ?? false;
    }
    if (!hasBucket) {
        let deleting = match (change) {
            Group0Change.Delete => true,
            _ => false,
        };
        if (deleting) { return Ok(true); } // nothing to delete
        if (!(await group0Write(shared, slot, Group0Change.MakeBucket, "", "".bytes())?)) { return Ok(false); }
    }
    let keyView = StringView.fromUtf8(key) ?? "";
    return await group0Write(shared, slot, change, keyView, bytes);
}

/// Writes `c` as its name's claim: 200, or 503 when group 0 did not take it.
async fn writeClaim(
    shared: borrow NodeShared,
    slot: borrow ShardSlot,
    c: borrow AccessPointClaim,
) -> Result<u16, NodeFault> {
    let key = match (claimKey(c.name.view())) {
        Ok(k) => k,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    let value = match (encodeClaim(c)) {
        Ok(v) => v,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    if (await claimWrite(shared, slot, Group0Change.Put, key.view(), value.view())?) { return Ok(200); }
    return Ok(503);
}

async fn dropClaim(shared: borrow NodeShared, slot: borrow ShardSlot, name: Slice<u8>) -> Result<u16, NodeFault> {
    let key = match (claimKey(name)) {
        Ok(k) => k,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    if (await claimWrite(shared, slot, Group0Change.Delete, key.view(), "".bytes())?) { return Ok(200); }
    return Ok(503);
}

/// What a take of a name for `bucket` finds, `held` being its claim: 201, a claim to make (none, or a pending one
/// past CLAIM_PENDING_MS); 200, the bucket's and confirmed; 409, another bucket's and confirmed; 503, another create's
/// pending claim, in flight (whichever bucket: it is not known yet whether it will be made).
fn takeDecision(held: borrow AccessPointClaim?, bucket: Slice<u8>, now: i64) -> u16 {
    return match (held) {
        Some(c) => {
            if (c.confirmed) {
                if (c.bucket.view() == bucket) 200u16 else 409u16
            } else if (now - c.madeMs < CLAIM_PENDING_MS) {
                503u16
            } else {
                201u16
            }
        }
        null => 201u16,
    };
}

fn newClaimToken() -> Vector<u8>? {
    var random = [0u8; 16];
    if (Random.fill(mut random[..]).isErr()) { return null; }
    var hex = Vector<u8>.create();
    if (appendHexBytes(mut hex, random[..]).isErr()) { return null; }
    return Some(hex);
}

/// `POST /cluster/access-point` (ADR-0078 §5), a node's, on group 0's leader: 421 elsewhere. A find reads the
/// leader's copy; every other op runs behind group 0's gate, once everything its replica holds is applied, so that it
/// reads every claim made before.
async fn changeClaim(shared: borrow NodeShared, body: Slice<u8>) -> Result<ClaimAnswer, NodeFault> {
    if (body.length < 1) { return Ok(claimAnswer(400)); }
    let op = body[0];
    var at = 1usize;
    let first = claimField(body, mut at) ?? "".bytes();
    let second = claimField(body, mut at) ?? "".bytes();
    let third = claimField(body, mut at) ?? "".bytes();
    let g = match (slotOf(shared, GROUP0_SHARD)) {
        Some(i) => i,
        null => { return Ok(claimAnswer(421)); }
    };
    let slot = borrow shared.slots[g];
    if (!(await viewOf(slot))?.leads) { return Ok(claimAnswer(421)); }
    if (op == CLAIM_FIND) {
        // Every claim answered was applied here before its answer (group0Write waits for it): no gate, no wait.
        return match (await localClaim(shared, first, second == "1".bytes())?) {
            Some(c) => match (claimFields(c.name.view(), c.bucket.view(), c.alias.view())) {
                Ok(b) => Ok(ClaimAnswer { status: 200, body: b }),
                Err(_) => Err(NodeFault.OutOfMemory),
            },
            null => Ok(claimAnswer(404)),
        };
    }
    var gate = match (await slot.gate.lock()) {
        Ok(gd) => gd,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let _held = gate.data();
    var waited = 0u64;
    while (true) {
        let v = await viewOf(slot)?;
        if (!v.leads) { return Ok(claimAnswer(421)); }
        if (v.applied == v.last && v.coreLast == v.last) { break; }
        if (waited >= FRONT_COMMIT_MS || !(await frontPause(FRONT_POLL_MS))) { return Ok(claimAnswer(503)); }
        waited += FRONT_POLL_MS;
    }
    let now = Clock.unixMillis();
    if (op == CLAIM_RELEASE_BUCKET) {
        if (first.length == 0) { return Ok(claimAnswer(400)); }
        let before = (StringView.fromUtf8(second) ?? "").parseInt<i64>() ?? 0;
        var names = Vector<Vector<u8>>.create();
        {
            var guard = match (await slot.store.get().lock()) {
                Ok(gd) => gd,
                Err(_) => { return Err(NodeFault.Net); }
            };
            let st = guard.data();
            let all = match (await Async.blocking(() => claimedNames(st, "".bytes()))) {
                Ok(a) => a,
                Err(_) => { return Err(NodeFault.OutOfMemory); }
            };
            for (i in 0..all.length) {
                let name = all[i].view();
                let held = match (await Async.blocking(() => storedClaim(st, name))) {
                    Ok(c) => c,
                    Err(_) => { return Err(NodeFault.OutOfMemory); }
                };
                match (held) {
                    Some(c) => {
                        let gone = c.bucket.view() == first && c.confirmed && c.madeMs < before;
                        if (gone && names.push(c.name).isErr()) { return Err(NodeFault.OutOfMemory); }
                    }
                    null => {}
                }
            }
        }
        for (i in 0..names.length) {
            if ((await dropClaim(shared, slot, names[i].view())?) != 200) { return Ok(claimAnswer(503)); }
        }
        return Ok(claimAnswer(200));
    }
    if (!accessPointNameOk(first)) { return Ok(claimAnswer(400)); }
    let held = await localClaim(shared, first, true)?;
    if (op == CLAIM_RELEASE) {
        if (second.length == 0) { return Ok(claimAnswer(400)); }
        let mine = match (borrow held) {
            Some(c) => c.bucket.view() == second && c.confirmed,
            null => false,
        };
        if (!mine) { return Ok(claimAnswer(200)); }
        return Ok(claimAnswer(await dropClaim(shared, slot, first)?));
    }
    if (op == CLAIM_ABANDON) {
        if (second.length == 0) { return Ok(claimAnswer(400)); }
        let mine = match (borrow held) {
            Some(c) => !c.confirmed && c.token.view() == second,
            null => false,
        };
        if (!mine) { return Ok(claimAnswer(200)); }
        return Ok(claimAnswer(await dropClaim(shared, slot, first)?));
    }
    if (op == CLAIM_CONFIRM) {
        // first: name; second: token; third: `<bucket>\n<alias>`, to make it again if it is gone.
        if (second.length == 0) { return Ok(claimAnswer(400)); }
        var claim = match (held) {
            Some(c) => c,
            null => {
                let cut = indexOfFrom(third, "\n".bytes(), 0) ?? third.length;
                if (cut == 0 || cut >= third.length) { return Ok(claimAnswer(400)); }
                match (claimOf(first, third[0..cut], third[cut + 1..])) {
                    Ok(c) => c,
                    Err(_) => { return Err(NodeFault.OutOfMemory); }
                }
            }
        };
        if (claim.confirmed && claim.token.view() == second) { return Ok(claimAnswer(200)); }
        let ours = claim.token.length == 0 || claim.token.view() == second;
        if (!ours) { return Ok(claimAnswer(409)); }
        claim.confirmed = true;
        claim.token.clear();
        if (claim.token.extend(second).isErr()) { return Err(NodeFault.OutOfMemory); }
        claim.madeMs = now;
        return Ok(claimAnswer(await writeClaim(shared, slot, borrow claim)?));
    }
    if (op != CLAIM_TAKE) { return Ok(claimAnswer(400)); }
    if (second.length == 0 || third.length == 0) { return Ok(claimAnswer(400)); }
    let decided = takeDecision(held, second, now);
    if (decided == 200) {
        let alias = match (borrow held) {
            Some(c) => c.alias.view(),
            null => "".bytes(),
        };
        return match (claimFields(alias, "".bytes(), "".bytes())) {
            Ok(b) => Ok(ClaimAnswer { status: 200, body: b }),
            Err(_) => Err(NodeFault.OutOfMemory),
        };
    }
    if (decided != 201) { return Ok(claimAnswer(decided)); }
    let token = match (newClaimToken()) {
        Some(t) => t,
        null => { return Ok(claimAnswer(503)); }
    };
    var claim = match (claimOf(first, second, third)) {
        Ok(c) => c,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    claim.confirmed = false;
    claim.token = token;
    claim.madeMs = now;
    if ((await writeClaim(shared, slot, borrow claim)?) != 200) { return Ok(claimAnswer(503)); }
    return match (claimFields(third, claim.token.view(), "".bytes())) {
        Ok(b) => Ok(ClaimAnswer { status: 201, body: b }),
        Err(_) => Err(NodeFault.OutOfMemory),
    };
}

// ---- The front's part ----

/// Whether a request is S3 Control's (ADR-0076 §1): `x-amz-account-id`, and a path under `/v20180820/`.
fn isControlRequest(raw: borrow RawMessage) -> bool {
    let prefix = "/v20180820/".bytes();
    let t = raw.target.view();
    if (t.length < prefix.length || t[0..prefix.length] != prefix) { return false; }
    for (i in 0..raw.names.length) {
        if (Ascii.equalsIgnoringCase(raw.names[i].view(), "x-amz-account-id")) { return true; }
    }
    return false;
}

/// The query parameter `name` of a request's target, as it came.
fn targetParam<region a>(target: Slice<a, u8>, name: StringView) -> Slice<a, u8>? {
    var at = match (indexOfFrom(target, "?".bytes(), 0)) {
        Some(i) => i + 1,
        null => { return null; }
    };
    let n = name.bytes();
    while (at < target.length) {
        var end = at;
        while (end < target.length && target[end] != '&') { end += 1; }
        let pair = target[at..end];
        if (pair.length > n.length && pair[0..n.length] == n && pair[n.length] == '=') {
            return Some(pair[n.length + 1..]);
        }
        at = end + 1;
    }
    return null;
}

/// Whether a request names its bucket itself, not a key or a sub-resource: `/<bucket>`, or `/` virtual-hosted; a
/// presigned URL's `X-Amz-…` parameters are no sub-resource.
fn namesBucketItself(target: Slice<u8>, hosted: bool) -> bool {
    var path = target;
    match (indexOfFrom(target, "?".bytes(), 0)) {
        Some(q) => {
            path = target[0..q];
            var at = q + 1;
            while (at < target.length) {
                var end = at;
                while (end < target.length && target[end] != '&') { end += 1; }
                let pair = target[at..end];
                let signing = pair.length >= 6 && Ascii.equalsIgnoringCase(pair[0..6], "x-amz-");
                if (pair.length > 0 && !signing) { return false; }
                at = end + 1;
            }
        }
        null => {}
    }
    if (hosted) { return path == "/".bytes(); }
    if (path.length < 2) { return false; }
    let rest = path[1..];
    return match (indexOfFrom(rest, "/".bytes(), 0)) {
        Some(i) => i == rest.length - 1,
        null => true,
    };
}

/// Lets go every name a bucket's access points had, once the bucket is deleted (its shard deleted them with it): those
/// confirmed before `answeredMs`. A name left claimed is let go by a DeleteAccessPoint of it.
async fn releaseBucketClaims(shared: borrow NodeShared, bucket: Slice<u8>, answeredMs: i64) -> Result<void, NodeFault> {
    var ms = Vector<u8>.create();
    if (appendDecimal(mut ms, checkedTruncate<u64>(answeredMs) ?? 0).isErr()) { return Err(NodeFault.OutOfMemory); }
    let body = match (claimRequest(CLAIM_RELEASE_BUCKET, bucket, ms.view(), "".bytes())) {
        Ok(b) => b,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    let _ = await askClaims(shared, body.view())?;
    return Ok();
}

/// S3 Control on a cluster (ADR-0078 §5). ListAccessPoints of a bucket goes to its shard, of every bucket to every
/// shard, merged; one access point's call to its bucket's shard, found by its claim (NoSuchAccessPoint without one);
/// CreateAccessPoint claims the name first. Anything else goes to shard 0, whose S3 server says what is wrong with it.
async fn routeControl(shared: borrow NodeShared, raw: borrow mut RawMessage) -> Result<RawMessage, NodeFault> {
    let base = "/v20180820/accesspoint".bytes();
    var name = Vector<u8>.create();
    var policyCall = false;
    // 0: something else; 1: every access point; 2: a bucket's (its name in `name`); 3: one (its name in `name`).
    var kind = 0u8;
    {
        let t = raw.target.view();
        let q = indexOfFrom(t, "?".bytes(), 0) ?? t.length;
        let path = t[0..q];
        if (path.length >= base.length && path[0..base.length] == base) {
            let rest = path[base.length..];
            if (rest.length == 0) {
                match (targetParam(t, "bucket")) {
                    Some(b) => {
                        kind = 2;
                        if (name.extend(b).isErr()) { return Err(NodeFault.OutOfMemory); }
                    }
                    null => { kind = 1; }
                }
            } else if (rest[0] == '/') {
                let tail = rest[1..];
                let slash = indexOfFrom(tail, "/".bytes(), 0) ?? tail.length;
                let one = tail[0..slash];
                if (accessPointNameOk(one) && (slash == tail.length || tail[slash..] == "/policy".bytes())) {
                    kind = 3;
                    policyCall = slash < tail.length;
                    if (name.extend(one).isErr()) { return Err(NodeFault.OutOfMemory); }
                }
            }
        }
    }
    let method = Methods.parse(raw.method.view());
    if (kind == 1 && method == Method.Get) {
        return await mergeShardLists(shared, raw, "AccessPoint", "AccessPointList");
    }
    if (kind == 2) { return await routeRequest(shared, shardOfBucket(borrow shared.file, name.view()), raw); }
    if (kind != 3) { return await routeRequest(shared, 0, raw); }
    if (method == Method.Put && !policyCall) { return await createThroughClaim(shared, raw, name.view()); }
    let claim = match (await findClaim(shared, name.view(), true, true)?) {
        Some(c) => c,
        null => { return Ok(frontError("NoSuchAccessPoint", 404)); }
    };
    let answer = await routeRequest(shared, shardOfBucket(borrow shared.file, claim.bucket.view()), raw)?;
    // Deleted, or not on its bucket's shard (its bucket gone with it): its name is let go.
    let gone = answer.status == 204 || (answer.status == 404 && (indexOfFrom(
        answer.body.view(),
        "<Code>NoSuchAccessPoint</Code>".bytes(),
        0,
    ).isSome() || indexOfFrom(answer.body.view(), "<Code>NoSuchBucket</Code>".bytes(), 0).isSome()));
    if (method == Method.Delete && !policyCall && gone) {
        let body = match (claimRequest(CLAIM_RELEASE, name.view(), claim.bucket.view(), "".bytes())) {
            Ok(b) => b,
            Err(_) => { return Err(NodeFault.OutOfMemory); }
        };
        let _ = await askClaims(shared, body.view())?;
    }
    return Ok(answer);
}

/// Whether `name` is a bucket name S3 takes: 3 to 63 of a-z, 0-9, `.` and `-`.
fn bucketNameOk(name: Slice<u8>) -> bool {
    if (name.length < 3 || name.length > 63) { return false; }
    for (c in name) {
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '-')) { return false; }
    }
    return true;
}

/// Whether a request carries a signature, in its `Authorization` field or a presigned URL's query: one without is
/// anonymous, which S3 Control refuses, and is sent on without a claim.
fn signedRequest(raw: borrow RawMessage) -> bool {
    for (i in 0..raw.names.length) {
        if (Ascii.equalsIgnoringCase(raw.names[i].view(), "authorization")) { return true; }
    }
    let t = raw.target.view();
    let needle = "x-amz-signature=".bytes();
    if (t.length < needle.length) { return false; }
    for (i in 0..t.length - needle.length + 1) {
        if (Ascii.equalsIgnoringCase(t[i..i + needle.length], "x-amz-signature=")) { return true; }
    }
    return false;
}

/// Sends a claim op, its answer not waited on for good.
async fn tellClaims(
    shared: borrow NodeShared,
    op: u8,
    a: Slice<u8>,
    b: Slice<u8>,
    c: Slice<u8>,
) -> Result<u16, NodeFault> {
    let body = match (claimRequest(op, a, b, c)) {
        Ok(x) => x,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    return Ok((await askClaims(shared, body.view())?).status);
}

/// CreateAccessPoint on a cluster: the name claimed in group 0 for the bucket with an alias (the front's), pending
/// with a token only this request has; then made on the bucket's shard with that alias. Made there (or there
/// already: AccessPointAlreadyOwnedByYou), the claim is confirmed; refused for good, abandoned, by its token, so no
/// other request's create is undone. Unknown (5xx), it stays pending: the client's retry waits for it, and after
/// CLAIM_PENDING_MS it may be claimed again. A claim the bucket has, confirmed, is kept whatever the shard answers.
async fn createThroughClaim(
    shared: borrow NodeShared,
    raw: borrow mut RawMessage,
    name: Slice<u8>,
) -> Result<RawMessage, NodeFault> {
    var bucket = Vector<u8>.create();
    let found = match (rawElement(raw.body.view(), "Bucket", mut bucket)) {
        Ok(f) => f,
        Err(_) => false,
    };
    // A request the shard will refuse whatever the claims say goes there without one: no body's bucket, a name S3
    // would not take, no signature.
    if (!found || !bucketNameOk(bucket.view()) || !signedRequest(raw)) { return await routeRequest(shared, 0, raw); }
    var alias = Vector<u8>.create();
    match (accessPointAlias(name, mut alias)) {
        Ok(true) => {}
        Ok(false) => { return Ok(frontError("InternalError", 500)); }
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    }
    let body = match (claimRequest(CLAIM_TAKE, name, bucket.view(), alias.view())) {
        Ok(b) => b,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    let claimed = await askClaims(shared, body.view())?;
    if (claimed.status == 409) { return Ok(frontError("AccessPointAlreadyOwnedByYou", 409)); }
    if (claimed.status != 200 && claimed.status != 201) { return Ok(statusOnly(503)); }
    var at = 0usize;
    let given = claimField(claimed.body.view(), mut at) ?? "".bytes();
    let token = claimField(claimed.body.view(), mut at) ?? "".bytes();
    if (given.length == 0 || (claimed.status == 201 && token.length == 0)) { return Ok(statusOnly(503)); }
    if (raw.addHeader(ACCESS_POINT_ALIAS_FIELD.bytes(), given).isErr()) { return Err(NodeFault.OutOfMemory); }
    let answer = await routeRequest(shared, shardOfBucket(borrow shared.file, bucket.view()), raw)?;
    if (claimed.status != 201) { return Ok(answer); }
    let there = indexOfFrom(answer.body.view(), "<Code>AccessPointAlreadyOwnedByYou</Code>".bytes(), 0).isSome();
    if (answer.status == 200 || there) {
        var again = Vector<u8>.create();
        let built = again.extend(bucket.view()).isOk() && again.push('\n').isOk() && again.extend(given).isOk();
        if (!built) { return Err(NodeFault.OutOfMemory); }
        if ((await tellClaims(shared, CLAIM_CONFIRM, name, token, again.view())?) == 409) {
            let _ = await AsyncConsole.writeError(
                "cosmostore: an access point was made whose name another took meanwhile\n",
            );
        }
    } else if (answer.status >= 400 && answer.status < 500) {
        let _ = await tellClaims(shared, CLAIM_ABANDON, name, token, "".bytes())?;
    }
    return Ok(answer);
}
