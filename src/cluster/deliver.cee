// The outbox on a cluster (ADR-0078 §4): each shard whose replica on this node leads delivers its events, in order,
// as `serve` does, then proposes an OutboxDelivered record behind the shard's gate, so every replica drops them and a
// new leader goes on from there.
import web_core;
import web_transport;
import web_http;
import web_client;

/// Delivers one batch of a shard's events, if this node's replica leads it: the LSN of the last one delivered (0:
/// none), and whether one failed.
async fn deliverShard(
    shared: borrow NodeShared,
    slot: borrow ShardSlot,
    client: borrow Client,
) -> Result<DeliveredBatch, NodeFault> {
    var batch = DeliveredBatch { last: 0, failed: false };
    {
        var guard = match (await slot.replica.lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        if (!guard.data().core.isLeader()) { return Ok(batch); }
    }
    var events = Vector<OutboxEvent>.create();
    {
        var guard = match (await slot.store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        // Copies out of memory: on the event loop.
        events = match (guard.data().pendingEvents(DELIVERY_BATCH)) {
            Ok(e) => e,
            Err(_) => { return Ok(batch); }
        };
    }
    for (i in 0..events.length) {
        let e = borrow events[i];
        for (t in 0..e.targets.length) {
            if (isReplicationTarget(e.targets[t].view())) {
                if (!(await replicateOnCluster(shared, slot, client, e, e.targets[t].view()[1..])?)) {
                    batch.failed = true;
                    break;
                }
                continue;
            }
            let url = match (targetUrl(shared.notifyTargets.view(), e.targets[t].view())) {
                Some(u) => u,
                null => { continue; } // a target the file no longer has
            };
            var json = Vector<u8>.create();
            if (eventJson(e, t, mut json).isErr() || !(await postEvent(client, url, json.view()))) {
                batch.failed = true;
                break;
            }
        }
        if (batch.failed) { break; }
        batch.last = e.lsn;
    }
    if (batch.last == 0) { return Ok(batch); }
    // Where it stopped, as a record of the shard's log, behind the gate the leader's writes pass (ADR-0060 §5).
    var gate = match (await slot.gate.lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let _held = gate.data();
    {
        var guard = match (await slot.store.get().lock()) {
            Ok(g) => g,
            Err(_) => { return Err(NodeFault.Net); }
        };
        let st = guard.data();
        let last = batch.last;
        // The record is written to the journal: on a worker thread.
        if ((await Async.blocking(() => st.eventsNoted(last, false))).isErr()) {
            batch.last = 0;
            return Ok(batch);
        }
    }
    // Not leading any more: the record is cut off with the rest, and the next leader delivers them again.
    let proposed = match (await proposeStaged(shared, slot, null, "".bytes())?) {
        Some(p) => p,
        null => { return Ok(batch); }
    };
    // Applied before the next batch, which would otherwise find the same events still waiting here and send them
    // again; as a write waits for its entries (ADR-0060 §5).
    var waited = 0u64;
    while (true) {
        let v = await viewOf(slot)?;
        if (v.applied >= proposed.last || !v.leads || v.term != proposed.term) { break; }
        if (waited >= FRONT_COMMIT_MS || !(await frontPause(FRONT_POLL_MS))) { break; }
        waited += FRONT_POLL_MS;
    }
    return Ok(batch);
}

/// Where a replica into a bucket of the cluster goes: the node's own front, signed with the current first key that is
/// not revoked. Null without credentials (no S3 on this node, so no events either).
fn selfTarget(shared: borrow NodeShared) -> Result<ReplicationTarget?, AllocError> {
    let sets = match (borrow shared.credentials) {
        Some(c) => c,
        null => { return Ok(null); }
    };
    let keys = sets.get().view();
    for (i in 0..keys.length) {
        if (keys[i].revoked) { continue; }
        return Ok(Some(ReplicationTarget {
            id: copyBytes("self".bytes())?,
            url: copyBytes(shared.frontUrl.view())?,
            accessKey: copyBytes(keys[i].accessKey.view())?,
            secret: copyBytes(keys[i].secret.view())?,
            region: copyBytes("us-east-1".bytes())?,
        }));
    }
    return Ok(null);
}

/// One replication target of an event (ADR-0078 §4): a bucket of the cluster, through the node's own front with the
/// source's id and ETag (the bucket may be another shard's); another endpoint, as on `serve` (ADR-0077 §6). True when
/// done, or refused for good (then noted behind the shard's gate, so the version reads FAILED); false to try again.
async fn replicateOnCluster(
    shared: borrow NodeShared,
    slot: borrow ShardSlot,
    client: borrow Client,
    e: borrow OutboxEvent,
    destination: Slice<u8>,
) -> Result<bool, NodeFault> {
    let src = StringView.fromUtf8(e.bucket.view()) ?? "";
    let key = StringView.fromUtf8(e.key.view()) ?? "";
    var outcome = RemoteOutcome.Refused; // a target the file no longer has
    if (isRemoteDestination(destination)) {
        let colon = pieceEnd(destination, 0, ':');
        let targetId = destination[0..colon];
        let bucket = destination[colon + 1..];
        for (i in 0..shared.replication.targets.length) {
            if (shared.replication.targets[i].id.view() != targetId) { continue; }
            outcome = await sendRemote(
                borrow slot.store,
                borrow shared.replication,
                client,
                borrow shared.replication.targets[i],
                e,
                src,
                key,
                bucket,
                false,
            );
        }
    } else {
        let front = match (selfTarget(shared)) {
            Ok(t) => t,
            Err(_) => { return Err(NodeFault.OutOfMemory); }
        };
        match (front) {
            Some(t) => {
                outcome = await sendRemote(
                    borrow slot.store,
                    borrow shared.replication,
                    client,
                    borrow t,
                    e,
                    src,
                    key,
                    destination,
                    true,
                );
            }
            null => {}
        }
    }
    match (outcome) {
        RemoteOutcome.Done => { return Ok(true); }
        RemoteOutcome.Again => { return Ok(false); }
        RemoteOutcome.Refused => {}
    }
    let _ = await AsyncConsole.writeError("cosmostore: a replica was refused by its destination: ");
    let _ = await AsyncConsole.writeError(src);
    let _ = await AsyncConsole.writeError("/");
    let _ = await AsyncConsole.writeError(key);
    let _ = await AsyncConsole.writeError("\n");
    // A record of the shard's log, as the delivery record is: behind the gate the leader's writes pass, and proposed
    // with that record (or the next write).
    var gate = match (await slot.gate.lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let _held = gate.data();
    var guard = match (await slot.store.get().lock()) {
        Ok(g) => g,
        Err(_) => { return Err(NodeFault.Net); }
    };
    let st = guard.data();
    let id = e.versionId;
    let k = e.key.view();
    // Not noted (the journal failed): tried again, rather than reported done.
    return Ok((await Async.blocking(() => st.noteReplicationFailure(src, k, id))).isOk());
}

struct DeliveredBatch {
    last: u64;
    failed: bool;
}

/// Every shard this node leads, delivered in turn; a failure waits 1 s, doubling to 60 s, as on `serve` (ADR-0048).
async fn deliverClusterForever(shared: borrow NodeShared) -> Result<void, NodeFault> {
    var options = ClientOptions.defaults();
    options.totalMs = 60000;
    options.retry = RetryPolicy.never();
    let client = match (Client.create(options, deliveryConnector())) {
        Ok(c) => c,
        Err(_) => { return Err(NodeFault.OutOfMemory); }
    };
    var wait = DELIVERY_RETRY_MS;
    while (true) {
        var failed = false;
        var any = false;
        for (i in 0..shared.slots.length) {
            let slot = borrow shared.slots[i];
            if (slot.failed.load() != 0) { continue; }
            let batch = await deliverShard(shared, slot, borrow client)?;
            if (batch.failed) { failed = true; }
            if (batch.last > 0) { any = true; }
        }
        if (failed) {
            if (!(await frontPause(wait))) { return Err(NodeFault.Net); }
            wait = if (wait * 2 > DELIVERY_RETRY_MOST_MS) DELIVERY_RETRY_MOST_MS else wait * 2;
        } else {
            wait = DELIVERY_RETRY_MS;
            if (!any && !(await frontPause(DELIVERY_IDLE_MS))) { return Err(NodeFault.Net); }
        }
    }
    return Err(NodeFault.Net);
}
