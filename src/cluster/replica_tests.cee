// Three replicas of a shard in one process, over an in-memory network (ADR-0058, M6 item 2 slice c). A workload of
// writes, each acknowledged once its leader has applied it, runs under the fault sweeps of ADR-0004: every I/O
// operation of every replica fails in turn, once, from then on, torn, or followed by a power cut of all three (the
// crash model). Then the replicas are opened again from their disks, and must elect, agree with each other, hold
// every acknowledged write, and take another.

const CLUSTER_KEYS: usize = 5;

/// A replica and its store, side by side, as a test holds them (a node keeps the store behind a lock, ADR-0060 §1).
struct TestReplica {
    replica: ShardReplica;
    store: ObjectStore;

    fn open(dir: StringView, config: ReplicaConfig) -> Result<TestReplica, StoreError> {
        let o = ShardReplica.open(dir, config)?;
        return Ok(TestReplica { replica: o.replica, store: o.store });
    }

    fn isLeader(borrow this) -> bool => this.replica.isLeader();

    fn beginWrite(borrow this) -> Result<u64, StoreError> => this.replica.beginWrite(borrow this.store);

    fn finishWrite(borrow mut this, before: u64) -> Result<u64?, StoreError> =>
        this.replica.finishWrite(mut this.store, before);

    fn isApplied(borrow this, index: u64) -> bool => this.store.appliedIndex() >= index;

    fn step(borrow mut this, m: RaftMessage) -> Result<void, StoreError> => this.replica.step(m);

    fn tick(borrow mut this) -> Result<void, StoreError> => this.replica.tick();

    fn drain(borrow mut this, out: borrow mut Vector<RaftMessage>) -> Result<void, StoreError> =>
        this.replica.drain(mut this.store, out);

    fn maintain(borrow mut this) -> Result<void, StoreError> => this.replica.maintain(mut this.store);
}

fn replicaConfig(id: u32, seed: u64, upkeep: bool) -> ReplicaConfig {
    var voters = Vector<u32>.create();
    for (v in 1..4) { voters.push(truncate<u32>(v))!; }
    var store = storeConfig();
    store.journal = JournalConfig { segmentTargetBytes: 2048, maxBatchBytes: 65536, shardId: 0, raftLog: true };
    if (upkeep) {
        // Checkpoints and compaction often: a follower cut off for a while falls behind the leader's checkpoint.
        store.journal.segmentTargetBytes = 1024;
        store.checkpointEveryBytes = 1024;
    }
    return ReplicaConfig {
        id: id,
        voters: voters,
        learners: Vector<u32>.create(),
        electionTicks: 10,
        heartbeatTicks: 2,
        maxAppendEntries: 4,
        seed: seed,
        store: store,
    };
}

struct Cluster {
    replicas: Vector<TestReplica>;
    net: Vector<RaftMessage>;
    /// Replicas cut off from the others: what they send and what is sent to them is lost.
    cut: [bool; 3];
    /// Every replica runs its upkeep (checkpoints, compaction) each round.
    upkeep: bool;
}

fn replicaDir(root: StringView, id: u32) -> String {
    var d = String.create();
    d.append(root)!;
    d.append(if (id == 1) "/r1" else if (id == 2) "/r2" else "/r3")!;
    return d;
}

fn clusterOpen(root: StringView, seed: u64) -> Result<Cluster, StoreError> => clusterOpenWith(root, seed, false);

fn clusterOpenWith(root: StringView, seed: u64, upkeep: bool) -> Result<Cluster, StoreError> {
    var replicas = Vector<TestReplica>.create();
    for (i in 1..4) {
        let id = truncate<u32>(i);
        let dir = replicaDir(root, id);
        sio(Fs.ensureDirectory(dir.view()))?;
        replicas.push(TestReplica.open(dir.view(), replicaConfig(id, seed, upkeep))?)?;
    }
    return Ok(Cluster { replicas: replicas, net: Vector<RaftMessage>.create(), cut: [false; 3], upkeep: upkeep });
}

/// One round: every message sent so far is delivered, in order, and then every replica ticks.
fn clusterStep(c: borrow mut Cluster) -> Result<void, StoreError> {
    var due = replace(mut c.net, Vector<RaftMessage>.create());
    reverseMessages(mut due);
    while (true) {
        let m = match (due.pop()) {
            Some(m) => m,
            null => { break; }
        };
        let at = (m.to - 1) as usize;
        if (c.cut[at] || c.cut[(m.from - 1) as usize]) { continue; }
        c.replicas[at].step(m)?;
        c.replicas[at].drain(mut c.net)?;
    }
    for (i in 0..c.replicas.length) {
        c.replicas[i].tick()?;
        c.replicas[i].drain(mut c.net)?;
        if (c.upkeep) {
            c.replicas[i].maintain()?;
            c.replicas[i].drain(mut c.net)?;
        }
    }
    return Ok();
}

fn clusterLeader(c: borrow Cluster) -> usize? {
    for (i in 0..c.replicas.length) {
        if (c.replicas[i].isLeader()) { return Some(i); }
    }
    return null;
}

/// Steps until a replica leads and may take a write; its place.
fn awaitLeader(c: borrow mut Cluster) -> Result<usize?, StoreError> {
    for (round in 0..300) {
        match (clusterLeader(c)) {
            Some(i) => {
                if (c.replicas[i].beginWrite().isOk()) { return Ok(Some(i)); }
            }
            null => {}
        }
        clusterStep(c)?;
    }
    return Ok(null);
}

/// What the workload had acknowledged, and the write it had not: a key's value (0: absent), and whether the
/// bucket exists.
struct ClusterModel {
    bucket: bool;
    bucketPending: bool;
    values: [u64; 5];
    pendingKey: usize;
    pendingValue: u64;
    hasPending: bool;
    acked: u64;
}

fn clusterKey(k: usize) -> StringView =>
    if (k == 0) "k0" else if (k == 1) "k1" else if (k == 2) "k2" else if (k == 3) "k3" else "k4";

/// The bucket, then twelve writes: puts of values 100 and on, a delete every fourth. Stops at the first error, as a
/// power cut would.
fn clusterWorkload(root: StringView, seed: u64, model: borrow mut ClusterModel) {
    var c = match (clusterOpen(root, seed)) {
        Ok(c) => c,
        Err(_) => { return; }
    };
    // An error is a fault the sweep injected: the workload stops there, as a power cut would stop it.
    let _ = runWorkload(mut c, model);
}

fn runWorkload(c: borrow mut Cluster, model: borrow mut ClusterModel) -> Result<void, StoreError> {
    for (op in 0usize..13usize) {
        let at = match (awaitLeader(c)?) {
            Some(i) => i,
            null => { return Ok(); }
        };
        let before = c.replicas[at].beginWrite()?;
        let k = (op + 4) % CLUSTER_KEYS;
        let value = 100 + (op as u64);
        model.hasPending = true;
        if (op == 0) {
            model.bucketPending = true;
            c.replicas[at].store.createBucket("bkt")?;
        } else if (op % 4 == 0) {
            model.pendingKey = k;
            model.pendingValue = 0;
            c.replicas[at].store.deleteObject("bkt", clusterKey(k))?;
        } else {
            model.pendingKey = k;
            model.pendingValue = value;
            var data = Vector<u8>.create();
            data.pushLE(value)?;
            let _ = c.replicas[at].store.putObject("bkt", clusterKey(k), "text/plain", data.view(), PutCondition.None)?;
        }
        // A write that changes nothing (a delete of a missing key) stages nothing, and is acknowledged at once.
        let index = c.replicas[at].finishWrite(before)? ?? before;
        var rounds = 0;
        while (!c.replicas[at].isApplied(index)) {
            if (rounds > 300) { return Ok(); }
            clusterStep(c)?;
            rounds += 1;
        }
        // Acknowledged.
        if (op == 0) {
            model.bucket = true;
        } else {
            model.values[k] = model.pendingValue;
        }
        model.hasPending = false;
        model.bucketPending = false;
        model.acked += 1;
    }
    return Ok();
}

fn emptyModel() -> ClusterModel => ClusterModel {
    bucket: false,
    bucketPending: false,
    values: [0u64; 5],
    pendingKey: 0,
    pendingValue: 0,
    hasPending: false,
    acked: 0,
};

/// The value a replica holds for key `k`: 0 when absent.
fn heldValue(r: borrow TestReplica, k: usize) -> Result<u64, TestFailure> {
    match (r.store.getObject("bkt", clusterKey(k))) {
        Ok(data) => {
            if (data.length != 8) { return Err(TestFailure.create("a value of the wrong length")); }
            return Ok(data.readLE<u64>(0));
        }
        Err(StoreError.NoSuchKey) => { return Ok(0); }
        Err(StoreError.NoSuchBucket) => { return Ok(0); }
        Err(_) => { return Err(TestFailure.create("a read failed")); }
    }
}

/// Opens the replicas again, lets them elect and catch up, and checks them against the model and each other; then
/// one more write must be acknowledged and reach all three.
fn checkCluster(root: StringView, seed: u64, model: borrow ClusterModel) -> Result<void, TestFailure> {
    var c = match (clusterOpen(root, seed + 1)) {
        Ok(c) => c,
        Err(_) => { return Err(TestFailure.create("a replica did not open after the fault")); }
    };
    let at = match (awaitLeader(mut c)) {
        Ok(Some(i)) => i,
        _ => { return Err(TestFailure.create("no leader after the fault")); }
    };
    // Every replica applies everything the leader has, its new term's entry included.
    let target = c.replicas[at].store.lastEntry();
    for (round in 0..300) {
        var done = true;
        for (i in 0..3) {
            if (!c.replicas[i].isApplied(target)) { done = false; }
        }
        if (done) { break; }
        clusterStep(mut c)!;
    }
    for (i in 0..3) {
        Check.isTrue(c.replicas[i].isApplied(target), "a replica did not catch up")?;
        Check.equalU64(target, c.replicas[i].store.appliedIndex())?;
    }
    let bucket = c.replicas[0].store.bucketExists("bkt")!;
    Check.isTrue(bucket || !model.bucket, "an acknowledged bucket was lost")?;
    for (k in 0..CLUSTER_KEYS) {
        let held = heldValue(borrow c.replicas[0], k)?;
        for (i in 1..3) { Check.equalU64(held, heldValue(borrow c.replicas[i], k)?)?; } // they agree
        let ok = held == model.values[k] || (model.hasPending && model.pendingKey == k && held == model.pendingValue);
        Check.isTrue(ok, "a replica holds neither the acknowledged value nor the one being written")?;
    }
    // It takes another write, which reaches all three.
    if (bucket) {
        let before = c.replicas[at].beginWrite()!;
        var data = Vector<u8>.create();
        data.pushLE(999u64)!;
        let _ = c.replicas[at].store.putObject("bkt", "k0", "text/plain", data.view(), PutCondition.None)!;
        let index = c.replicas[at].finishWrite(before)! ?? 0;
        for (round in 0..300) {
            if (c.replicas[0].isApplied(index) && c.replicas[1].isApplied(index) && c.replicas[2].isApplied(index)) {
                break;
            }
            clusterStep(mut c)!;
        }
        for (i in 0..3) { Check.equalU64(999, heldValue(borrow c.replicas[i], 0)?)?; }
    }
    return Ok();
}

@test
fn replicasAgreeWithoutFaults() -> Result<void, TestFailure> {
    let root = scratchDirectory("cluster-clean");
    var model = emptyModel();
    clusterWorkload(root.view(), 3, mut model);
    Check.equalU64(13, model.acked)?;
    checkCluster(root.view(), 3, borrow model)?;
    removeTree(root.view());
    return Ok();
}

fn sweepCluster(name: StringView, mode: SweepMode) -> Result<void, TestFailure> {
    Faults.elideSyncs(true);
    let root = scratchDirectory(name);
    Faults.countOperations();
    var clean = emptyModel();
    clusterWorkload(root.view(), 3, mut clean);
    Faults.disarm();
    Check.equalU64(13, clean.acked)?;
    let points = Faults.seen();
    Check.isTrue(points > 100, "the workload performs I/O")?;
    for (n in 1..points + 1) {
        removeTree(root.view());
        Fs.ensureDirectory(root.view())!;
        armMode(borrow mode, n);
        var model = emptyModel();
        clusterWorkload(root.view(), 3, mut model);
        Faults.disarm();
        if (isCrash(borrow mode)) {
            Check.equalU64(0, Faults.violations())?;
            Faults.crash(root.view())!;
        }
        checkCluster(root.view(), 3, borrow model)?;
    }
    removeTree(root.view());
    Faults.elideSyncs(false);
    return Ok();
}

@test
fn replicasFaultsOnce() -> Result<void, TestFailure> => sweepCluster("cluster-once", SweepMode.Once);

@test
fn replicasFaultsSticky() -> Result<void, TestFailure> => sweepCluster("cluster-sticky", SweepMode.Sticky);

@test
fn replicasFaultsTorn() -> Result<void, TestFailure> => sweepCluster("cluster-torn", SweepMode.StickyTorn);

@test
fn replicasFaultsCrash() -> Result<void, TestFailure> => sweepCluster("cluster-crash", SweepMode.Crash);

/// A follower cut off while the leader writes (overwriting the same keys, so segments empty out), checkpoints and
/// compacts; then it rejoins, behind the leader's checkpoint, and must catch up from a snapshot. Stops at the first
/// error, as a power cut would.
/// Returns each replica's checkpoint index when it stopped: published checkpoints and installed snapshots are
/// durable, so none may come back lower after a crash.
fn snapshotWorkload(root: StringView, seed: u64, model: borrow mut ClusterModel) -> [u64; 3] {
    var c = match (clusterOpenWith(root, seed, true)) {
        Ok(c) => c,
        Err(_) => { return [0u64; 3]; }
    };
    let _ = runSnapshotWorkload(mut c, model);
    var floors = [0u64; 3];
    for (i in 0..3) { floors[i] = c.replicas[i].store.checkpointIndex(); }
    return floors;
}

fn runSnapshotWorkload(c: borrow mut Cluster, model: borrow mut ClusterModel) -> Result<void, StoreError> {
    for (op in 0usize..31usize) {
        let at = match (awaitLeader(c)?) {
            Some(i) => i,
            null => { return Ok(); }
        };
        if (op == 1) { c.cut[(at + 1) % 3] = true; }
        let before = c.replicas[at].beginWrite()?;
        let k = op % CLUSTER_KEYS;
        let value = 1000 + (op as u64);
        model.hasPending = true;
        if (op == 0) {
            model.bucketPending = true;
            c.replicas[at].store.createBucket("bkt")?;
        } else {
            model.pendingKey = k;
            model.pendingValue = value;
            var data = Vector<u8>.create();
            data.pushLE(value)?;
            data.resize(200, 7)?; // larger records fill segments sooner
            data.viewMut().writeLE(0, value);
            let _ = c.replicas[at].store.putObject("bkt", clusterKey(k), "text/plain", data.view(), PutCondition.None)?;
        }
        let index = c.replicas[at].finishWrite(before)? ?? before;
        var rounds = 0;
        while (!c.replicas[at].isApplied(index)) {
            if (rounds > 300) { return Ok(); }
            clusterStep(c)?;
            rounds += 1;
        }
        if (op == 0) { model.bucket = true; } else { model.values[k] = model.pendingValue; }
        model.hasPending = false;
        model.bucketPending = false;
        model.acked += 1;
    }
    // The follower rejoins and catches up.
    c.cut = [false; 3];
    for (round in 0..300) {
        var behind = false;
        let last = c.replicas[0].store.appliedIndex().max(c.replicas[1].store.appliedIndex()).max(
            c.replicas[2].store.appliedIndex(),
        );
        for (i in 0..3) {
            if (c.replicas[i].store.appliedIndex() < last) { behind = true; }
        }
        if (!behind) { return Ok(); }
        clusterStep(c)?;
    }
    return Ok();
}

/// A value's first 8 bytes; the snapshot workload pads its values to 200 bytes.
fn heldValuePadded(r: borrow TestReplica, k: usize) -> Result<u64, TestFailure> {
    match (r.store.getObject("bkt", clusterKey(k))) {
        Ok(data) => {
            if (data.length < 8) { return Err(TestFailure.create("a value of the wrong length")); }
            return Ok(data.readLE<u64>(0));
        }
        Err(StoreError.NoSuchKey) => { return Ok(0); }
        Err(StoreError.NoSuchBucket) => { return Ok(0); }
        Err(_) => { return Err(TestFailure.create("a read failed")); }
    }
}

/// `checkCluster` for the snapshot workload: reopened with upkeep, they elect, catch up (a snapshot where one is
/// needed), agree, and hold every acknowledged write.
fn checkSnapshotCluster(
    root: StringView,
    seed: u64,
    model: borrow ClusterModel,
    floors: [u64; 3],
) -> Result<void, TestFailure> {
    var c = match (clusterOpenWith(root, seed + 1, true)) {
        Ok(c) => c,
        Err(_) => { return Err(TestFailure.create("a replica did not open after the fault")); }
    };
    for (i in 0..3) {
        Check.isTrue(
            c.replicas[i].store.checkpointIndex() >= floors[i],
            "a replica came back without a checkpoint or snapshot it had made durable",
        )?;
    }
    let at = match (awaitLeader(mut c)) {
        Ok(Some(i)) => i,
        _ => { return Err(TestFailure.create("no leader after the fault")); }
    };
    let target = c.replicas[at].store.lastEntry();
    for (round in 0..400) {
        if (c.replicas[0].isApplied(target) && c.replicas[1].isApplied(target) && c.replicas[2].isApplied(target)) {
            break;
        }
        match (clusterStep(mut c)) {
            Ok() => {}
            Err(_) => { return Err(TestFailure.create("a replica failed while catching up")); }
        }
    }
    for (i in 0..3) { Check.isTrue(c.replicas[i].isApplied(target), "a replica did not catch up")?; }
    let bucket = c.replicas[0].store.bucketExists("bkt")!;
    Check.isTrue(bucket || !model.bucket, "an acknowledged bucket was lost")?;
    for (k in 0..CLUSTER_KEYS) {
        let held = heldValuePadded(borrow c.replicas[0], k)?;
        for (i in 1..3) { Check.equalU64(held, heldValuePadded(borrow c.replicas[i], k)?)?; }
        let ok = held == model.values[k] || (model.hasPending && model.pendingKey == k && held == model.pendingValue);
        Check.isTrue(ok, "a replica holds neither the acknowledged value nor the one being written")?;
    }
    return Ok();
}

/// The clean snapshot workload, and what it did: snapshots installed, segments compacted away, bytes relocated. Its
/// replicas are closed when it returns.
fn snapshotRun(root: StringView, model: borrow mut ClusterModel) -> Result<[u64; 3], TestFailure> {
    var c = match (clusterOpenWith(root, 5, true)) {
        Ok(c) => c,
        Err(_) => { return Err(TestFailure.create("the replicas did not open")); }
    };
    if (runSnapshotWorkload(mut c, model).isErr()) { return Err(TestFailure.create("the workload failed")); }
    var done = [0u64; 3];
    for (i in 0..3) {
        done[0] += c.replicas[i].replica.snapshotsInstalled;
        done[1] += c.replicas[i].store.counters().segmentsCompacted;
        done[2] += c.replicas[i].store.counters().compactionBytesCopied;
    }
    return Ok(done);
}

@test
fn replicasCatchUpFromASnapshot() -> Result<void, TestFailure> {
    let root = scratchDirectory("cluster-snapshot");
    var model = emptyModel();
    let done = snapshotRun(root.view(), mut model)?;
    Check.equalU64(31, model.acked)?;
    Check.isTrue(done[0] >= 1, "the follower caught up from a snapshot")?;
    Check.isTrue(done[1] >= 3, "segments were compacted away")?;
    Check.isTrue(done[2] > 0, "the leader relocated live payloads")?;
    checkSnapshotCluster(root.view(), 5, borrow model, [0u64; 3])?;
    removeTree(root.view());
    return Ok();
}

fn sweepSnapshots(name: StringView, mode: SweepMode) -> Result<void, TestFailure> {
    Faults.elideSyncs(true);
    let root = scratchDirectory(name);
    Faults.countOperations();
    var clean = emptyModel();
    let _ = snapshotWorkload(root.view(), 5, mut clean);
    Faults.disarm();
    Check.equalU64(31, clean.acked)?;
    let points = Faults.seen();
    // Every third operation, so the sweep stays within a few minutes; the cluster sweeps above cover each one.
    var n = 1u64;
    while (n <= points) {
        removeTree(root.view());
        Fs.ensureDirectory(root.view())!;
        armMode(borrow mode, n);
        var model = emptyModel();
        let floors = snapshotWorkload(root.view(), 5, mut model);
        Faults.disarm();
        if (isCrash(borrow mode)) {
            Check.equalU64(0, Faults.violations())?;
            Faults.crash(root.view())!;
        }
        checkSnapshotCluster(root.view(), 5, borrow model, floors)?;
        n += 3;
    }
    removeTree(root.view());
    Faults.elideSyncs(false);
    return Ok();
}

@test
fn snapshotsFaultsOnce() -> Result<void, TestFailure> => sweepSnapshots("snapshot-once", SweepMode.Once);

@test
fn snapshotsFaultsTorn() -> Result<void, TestFailure> => sweepSnapshots("snapshot-torn", SweepMode.StickyTorn);

@test
fn snapshotsFaultsCrash() -> Result<void, TestFailure> => sweepSnapshots("snapshot-crash", SweepMode.Crash);
