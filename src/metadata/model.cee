// The object model and its record encodings (ADR-001 §meta). Versions are first-class from
// the start: an unversioned bucket's objects carry the null version id (all zero bytes).

const VERSION_ID_LEN: usize = 16;
const META_FORMAT_VERSION: u8 = 1;
const MAX_BUCKET_NAME: usize = 63;
const MAX_KEY_BYTES: usize = 1024;
const MAX_CONTENT_TYPE: usize = 1024;
/// The most bytes of user metadata (`x-amz-meta-*` names and values, S3's 2 KiB) and of every stored field together.
const MAX_USER_METADATA: usize = 2048;
const MAX_METADATA_BYTES: usize = 8192;

/// The null version id, used by unversioned buckets.
fn nullVersionId() -> [u8; 16] => [0u8; 16];

/// Byte-wise lexicographic order, as S3 lists keys (UTF-8 binary order).
fn compareBytes(a: Slice<u8>, b: Slice<u8>) -> i32 {
    let n = if (a.length < b.length) a.length else b.length;
    for (i in 0..n) {
        if (a[i] != b[i]) { return if (a[i] < b[i]) -1 else 1; }
    }
    if (a.length == b.length) { return 0; }
    return if (a.length < b.length) -1 else 1;
}

fn startsWithBytes(s: Slice<u8>, prefix: Slice<u8>) -> bool {
    if (prefix.length > s.length) { return false; }
    for (i in 0..prefix.length) {
        if (s[i] != prefix[i]) { return false; }
    }
    return true;
}

/// Where `needle` first occurs in `s` at or after `from`.
fn findBytes(s: Slice<u8>, needle: Slice<u8>, from: usize) -> usize? {
    if (needle.length == 0 || needle.length > s.length) { return null; }
    var i = from;
    while (i + needle.length <= s.length) {
        if (startsWithBytes(s[i..], needle)) { return i; }
        i += 1;
    }
    return null;
}

fn copyBytes(s: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var v = Vector<u8>.create();
    v.extend(s)?;
    return Ok(v);
}

/// A key of the object index: bucket and object key.
struct IndexKey {
    bucket: Vector<u8>;
    key: Vector<u8>;
}

impl HashKey<IndexKey> for IndexKey {
    fn hash(borrow this, h: borrow mut Hasher) {
        h.u64(this.bucket.length as u64);
        h.bytes(this.bucket.view());
        h.bytes(this.key.view());
    }

    fn sameAs(borrow this, other: borrow IndexKey) -> bool =>
        this.bucket.view() == other.bucket.view() && this.key.view() == other.key.view();
}

/// A bucket's name as a map key.
struct BucketKey {
    name: Vector<u8>;
}

impl HashKey<BucketKey> for BucketKey {
    fn hash(borrow this, h: borrow mut Hasher) {
        h.bytes(this.name.view());
    }

    fn sameAs(borrow this, other: borrow BucketKey) -> bool => this.name.view() == other.name.view();
}

enum VersionKind {
    Object,
    DeleteMarker,
}

/// One version of a key, as the index holds it.
struct ObjectVersion {
    versionId: [u8; 16];
    /// The LSN of the record that created it: also the key's generation for conditional writes.
    lsn: u64;
    kind: VersionKind;
    size: u64;
    mtimeMillis: i64;
    md5: [u8; 16];
    contentType: Vector<u8>;
    payload: PayloadLocator;
    /// The whole record, for space accounting.
    recordSegment: u64;
    recordLength: u32;
    /// The object's extents, in order; empty for an inline object (its bytes are at `payload`).
    extents: Vector<ExtentRef>;
    /// User metadata and stored headers (ADR-0012), as put meta carries them; empty for none.
    metadata: Vector<u8>;
    /// The checksum and part layout (ADR-0015, `decodeExtras`); empty for none.
    extras: Vector<u8>;
    /// A multipart object's part count, 0 for a single PUT. A multipart object's `md5` is its ETag's digest, the MD5
    /// of its parts' MD5s, not the MD5 of its bytes (ADR-0009).
    parts: u32;
}

/// Decoded meta of a PutInline or PutExtent record.
struct PutMeta {
    bucket: Vector<u8>;
    key: Vector<u8>;
    versionId: [u8; 16];
    mtimeMillis: i64;
    size: u64;
    md5: [u8; 16];
    contentType: Vector<u8>;
    /// The metadata section (`metadataAdd`'s format), empty when it has no pairs.
    metadata: Vector<u8>;
    /// PutInline / PutExtent only: the extras section after it (ADR-0015), empty when absent.
    extras: Vector<u8>;
}

/// Decoded meta of a Relocate record: which version the copied payload belongs to.
struct RelocateMeta {
    bucket: Vector<u8>;
    key: Vector<u8>;
    versionId: [u8; 16];
    /// The version's generation (the LSN of the record that created it).
    generation: u64;
}

/// Decoded meta of a DeleteVersion or DeleteMarker record.
struct DeleteMeta {
    bucket: Vector<u8>;
    key: Vector<u8>;
    versionId: [u8; 16];
    mtimeMillis: i64;
}

enum MetaFault {
    Short,
    BadVersion,
    TooLong,
    @from OutOfMemory(AllocError),
}

fn pushText16(out: borrow mut Vector<u8>, s: Slice<u8>) -> Result<void, AllocError> {
    out.pushLE(truncate<u16>(s.length))?;
    out.extend(s)?;
    return Ok();
}

/// PutInline / PutExtent meta v1:
///   u8 format version, u16+bytes bucket, u16+bytes key, 16 version id, i64 mtime ms,
///   u64 size, 16 md5, u16+bytes content type, u16 user metadata pairs (each u16+bytes, u16+bytes). `metadata` is
///   that last section, from `metadataAdd` (empty: no pairs).
fn encodePutMeta(
    out: borrow mut Vector<u8>,
    bucket: Slice<u8>,
    key: Slice<u8>,
    versionId: [u8; 16],
    mtimeMillis: i64,
    size: u64,
    md5: [u8; 16],
    contentType: Slice<u8>,
    metadata: Slice<u8>,
) -> Result<void, AllocError> {
    out.pushLE(META_FORMAT_VERSION)?;
    pushText16(out, bucket)?;
    pushText16(out, key)?;
    out.extend(versionId[..])?;
    out.pushLE(mtimeMillis)?;
    out.pushLE(size)?;
    out.extend(md5[..])?;
    pushText16(out, contentType)?;
    appendMetadataSection(out, metadata)?;
    return Ok();
}

// ---- Metadata (ADR-0012) ----

/// One stored field: a lowercase name (`x-amz-meta-*`, or a header S3 keeps such as `content-encoding`) and its value.
struct MetaPair {
    name: Vector<u8>;
    value: Vector<u8>;
}

/// Adds a pair to a metadata blob: u16 pair count, then per pair u16+bytes name and u16+bytes value.
fn metadataAdd(blob: borrow mut Vector<u8>, name: Slice<u8>, value: Slice<u8>) -> Result<void, AllocError> {
    if (blob.length == 0) { blob.pushLE(0u16)?; }
    let count = blob.view().readLE<u16>(0);
    blob.viewMut().writeLE(0, count + 1);
    pushText16(blob, name)?;
    pushText16(blob, value)?;
    return Ok();
}

/// A blob's section in a record or checkpoint: the blob, or a zero count for none.
fn appendMetadataSection(out: borrow mut Vector<u8>, metadata: Slice<u8>) -> Result<void, AllocError> {
    if (metadata.length == 0) {
        out.pushLE(0u16)?;
    } else {
        out.extend(metadata)?;
    }
    return Ok();
}

/// Reads a metadata section at `at`, checking every pair, and returns it as a blob (empty for none).
fn readMetadataSection(bytes: Slice<u8>, at: borrow mut usize) -> Result<Vector<u8>, MetaFault> {
    let start: usize = at;
    need(bytes, at, 2)?;
    let pairs = bytes.readLE<u16>(at);
    at += 2;
    for (i in 0..pairs) {
        let _ = readText16(bytes, at)?;
        let _ = readText16(bytes, at)?;
    }
    if (pairs == 0) { return Ok(Vector<u8>.create()); }
    return Ok(copyBytes(bytes[start..at])?);
}

/// The pairs of a metadata blob.
fn metadataPairs(blob: Slice<u8>) -> Result<Vector<MetaPair>, MetaFault> {
    var pairs = Vector<MetaPair>.create();
    if (blob.length == 0) { return Ok(pairs); }
    var at: usize = 2;
    let n = blob.readLE<u16>(0);
    for (i in 0..n) {
        let name = readText16(blob, mut at)?;
        let value = readText16(blob, mut at)?;
        pairs.push(MetaPair { name: name, value: value })?;
    }
    return Ok(pairs);
}

/// DeleteVersion / DeleteMarker meta v1: u8 format version, u16+bytes bucket, u16+bytes key,
/// 16 version id, i64 mtime ms.
fn encodeDeleteMeta(
    out: borrow mut Vector<u8>,
    bucket: Slice<u8>,
    key: Slice<u8>,
    versionId: [u8; 16],
    mtimeMillis: i64,
) -> Result<void, AllocError> {
    out.pushLE(META_FORMAT_VERSION)?;
    pushText16(out, bucket)?;
    pushText16(out, key)?;
    out.extend(versionId[..])?;
    out.pushLE(mtimeMillis)?;
    return Ok();
}

/// BucketCreate / BucketDelete meta v1: u8 format version, u16+bytes name, i64 mtime ms.
fn encodeBucketMeta(out: borrow mut Vector<u8>, name: Slice<u8>, mtimeMillis: i64) -> Result<void, AllocError> {
    out.pushLE(META_FORMAT_VERSION)?;
    pushText16(out, name)?;
    out.pushLE(mtimeMillis)?;
    return Ok();
}

/// Relocate meta v1: u8 format version, u16+bytes bucket, u16+bytes key, 16 version id,
/// u64 generation. The payload is the version's inline bytes.
fn encodeRelocateMeta(
    out: borrow mut Vector<u8>,
    bucket: Slice<u8>,
    key: Slice<u8>,
    versionId: [u8; 16],
    generation: u64,
) -> Result<void, AllocError> {
    out.pushLE(META_FORMAT_VERSION)?;
    pushText16(out, bucket)?;
    pushText16(out, key)?;
    out.extend(versionId[..])?;
    out.pushLE(generation)?;
    return Ok();
}

fn need(bytes: Slice<u8>, at: usize, n: usize) -> Result<void, MetaFault> {
    if (at + n > bytes.length) { return Err(MetaFault.Short); }
    return Ok();
}

fn readText16(bytes: Slice<u8>, at: borrow mut usize) -> Result<Vector<u8>, MetaFault> {
    need(bytes, at, 2)?;
    let n = bytes.readLE<u16>(at) as usize;
    at += 2;
    need(bytes, at, n)?;
    let v = copyBytes(bytes[at..at + n])?;
    at += n;
    return Ok(v);
}

fn readId16(bytes: Slice<u8>, at: borrow mut usize) -> Result<[u8; 16], MetaFault> {
    need(bytes, at, 16)?;
    var id = [0u8; 16];
    id[..].copyFrom(bytes[at..at + 16]);
    at += 16;
    return Ok(id);
}

fn readU64(bytes: Slice<u8>, at: borrow mut usize) -> Result<u64, MetaFault> {
    need(bytes, at, 8)?;
    let v = bytes.readLE<u64>(at);
    at += 8;
    return Ok(v);
}

fn readI64(bytes: Slice<u8>, at: borrow mut usize) -> Result<i64, MetaFault> {
    need(bytes, at, 8)?;
    let v = bytes.readLE<i64>(at);
    at += 8;
    return Ok(v);
}

fn checkVersion(bytes: Slice<u8>, at: borrow mut usize) -> Result<void, MetaFault> {
    need(bytes, at, 1)?;
    if (bytes[at] != META_FORMAT_VERSION) { return Err(MetaFault.BadVersion); }
    at += 1;
    return Ok();
}

fn readU32(bytes: Slice<u8>, at: borrow mut usize) -> Result<u32, MetaFault> {
    need(bytes, at, 4)?;
    let v = bytes.readLE<u32>(at);
    at += 4;
    return Ok(v);
}

/// PutInline / PutExtent meta: the put meta, then an extras section (ADR-0015) unless the record is older.
fn decodePutMeta(bytes: Slice<u8>) -> Result<PutMeta, MetaFault> {
    var at: usize = 0;
    var m = decodePutMetaAt(bytes, mut at)?;
    if (at < bytes.length) { m.extras = readExtrasSection(bytes, mut at)?; }
    if (at != bytes.length) { return Err(MetaFault.TooLong); }
    return Ok(m);
}

/// Decodes PutInline / PutExtent meta from `at`, user metadata included, and leaves `at` after it.
fn decodePutMetaAt(bytes: Slice<u8>, at: borrow mut usize) -> Result<PutMeta, MetaFault> {
    checkVersion(bytes, at)?;
    let bucket = readText16(bytes, at)?;
    let key = readText16(bytes, at)?;
    let versionId = readId16(bytes, at)?;
    let mtime = readI64(bytes, at)?;
    let size = readU64(bytes, at)?;
    let md5 = readId16(bytes, at)?;
    let contentType = readText16(bytes, at)?;
    let metadata = readMetadataSection(bytes, at)?;
    return Ok(PutMeta {
        bucket: bucket,
        key: key,
        versionId: versionId,
        mtimeMillis: mtime,
        size: size,
        md5: md5,
        contentType: contentType,
        metadata: metadata,
        extras: Vector<u8>.create(),
    });
}

fn decodeDeleteMeta(bytes: Slice<u8>) -> Result<DeleteMeta, MetaFault> {
    var at: usize = 0;
    checkVersion(bytes, mut at)?;
    let bucket = readText16(bytes, mut at)?;
    let key = readText16(bytes, mut at)?;
    let versionId = readId16(bytes, mut at)?;
    let mtime = readI64(bytes, mut at)?;
    return Ok(DeleteMeta { bucket: bucket, key: key, versionId: versionId, mtimeMillis: mtime });
}

fn decodeRelocateMeta(bytes: Slice<u8>) -> Result<RelocateMeta, MetaFault> {
    var at: usize = 0;
    checkVersion(bytes, mut at)?;
    let bucket = readText16(bytes, mut at)?;
    let key = readText16(bytes, mut at)?;
    let versionId = readId16(bytes, mut at)?;
    let generation = readU64(bytes, mut at)?;
    return Ok(RelocateMeta { bucket: bucket, key: key, versionId: versionId, generation: generation });
}

fn decodeBucketName(bytes: Slice<u8>) -> Result<Vector<u8>, MetaFault> {
    var at: usize = 0;
    checkVersion(bytes, mut at)?;
    return readText16(bytes, mut at);
}

/// The mtime of BucketCreate / BucketDelete meta.
fn decodeBucketMillis(bytes: Slice<u8>) -> Result<i64, MetaFault> {
    var at: usize = 0;
    checkVersion(bytes, mut at)?;
    let _ = readText16(bytes, mut at)?;
    return readI64(bytes, mut at);
}

/// S3 general-purpose bucket naming rules (3-63 chars; lowercase letters, digits, '.', '-';
/// starts and ends with a letter or digit; no "..", not an IPv4 address).
fn isValidBucketName(name: Slice<u8>) -> bool {
    if (name.length < 3 || name.length > MAX_BUCKET_NAME) { return false; }
    var dotsOnlyDigits = true;
    var dots = 0;
    for (i in 0..name.length) {
        let c = name[i];
        let lower = c >= 'a' && c <= 'z';
        let digit = c >= '0' && c <= '9';
        if (!(lower || digit || c == '.' || c == '-')) { return false; }
        if ((i == 0 || i + 1 == name.length) && !(lower || digit)) { return false; }
        if (c == '.') {
            dots += 1;
            if (i > 0 && name[i - 1] == '.') { return false; }
        } else if (!digit) {
            dotsOnlyDigits = false;
        }
    }
    return !(dotsOnlyDigits && dots == 3);
}

@test
fn putMetaRoundTrip() -> Result<void, TestFailure> {
    var out = Vector<u8>.create();
    let bucket = "photos";
    let key = "2026/11/06/cat.jpg";
    let ctype = "image/jpeg";
    var vid = nullVersionId();
    vid[3] = 9;
    let md5 = Md5.of(key.bytes());
    var meta = Vector<u8>.create();
    metadataAdd(mut meta, "x-amz-meta-mtime".bytes(), "1700000000".bytes())!;
    metadataAdd(mut meta, "content-encoding".bytes(), "gzip".bytes())!;
    encodePutMeta(mut out, bucket.bytes(), key.bytes(), vid, 1700000000000, 12345, md5, ctype.bytes(), meta.view())!;
    let m = match (decodePutMeta(out.view())) {
        Ok(m) => m,
        Err(_) => { return Check.fail("decodes"); }
    };
    Check.equalBytes(bucket.bytes(), m.bucket.view())?;
    Check.equalBytes(key.bytes(), m.key.view())?;
    Check.equalBytes(vid[..], m.versionId[..])?;
    Check.equalU64(12345, m.size)?;
    Check.equalBytes(md5[..], m.md5[..])?;
    Check.equalBytes(ctype.bytes(), m.contentType.view())?;
    Check.equalBytes(meta.view(), m.metadata.view())?;
    let pairs = metadataPairs(m.metadata.view())!;
    Check.equalU64(2, pairs.length as u64)?;
    Check.equalBytes("content-encoding".bytes(), pairs[1].name.view())?;
    Check.equalBytes("gzip".bytes(), pairs[1].value.view())?;
    // Every truncation is rejected, never misread.
    for (n in 0..out.length) {
        match (decodePutMeta(out.view()[0..n])) {
            Ok(_) => { return Check.fail("a truncated meta must not decode"); }
            Err(_) => {}
        }
    }
    return Ok();
}

@test
fn bucketNames() -> Result<void, TestFailure> {
    let good = ["abc", "my-bucket", "my.bucket.2", "a1b"];
    for (n in good) { Check.isTrue(isValidBucketName(n.bytes()), "valid bucket name")?; }
    let bad = ["ab", "-abc", "abc-", "ABC", "a..b", "192.168.1.1", "a_b", "abc."];
    for (n in bad) { Check.isTrue(!isValidBucketName(n.bytes()), "invalid bucket name")?; }
    return Ok();
}

@test
fn byteOrdering() -> Result<void, TestFailure> {
    let a = "a";
    let ab = "ab";
    let b = "b";
    Check.isTrue(compareBytes(a.bytes(), ab.bytes()) < 0, "a < ab")?;
    Check.isTrue(compareBytes(ab.bytes(), b.bytes()) < 0, "ab < b")?;
    Check.isTrue(compareBytes(b.bytes(), b.bytes()) == 0, "b == b")?;
    return Ok();
}
