// The object model and its record encodings (ADR-001 §meta). Versions are first-class from
// the start: an unversioned bucket's objects carry the null version id (all zero bytes).

const VERSION_ID_LEN: usize = 16;
const META_FORMAT_VERSION: u8 = 1;
const MAX_BUCKET_NAME: usize = 63;
const MAX_KEY_BYTES: usize = 1024;
const MAX_CONTENT_TYPE: usize = 1024;
/// The most bytes of user metadata (`x-amz-meta-*` names and values, S3's 2 KiB) and of every stored field together.
const MAX_USER_METADATA: usize = 2048;
/// Every stored field together, tags included (ADR-0017: ten tags of 128 and 256 characters, URL-encoded).
const MAX_METADATA_BYTES: usize = 16384;
/// The stored field that holds a version's tags: their URL-encoded `k=v&k2=v2` form, as `x-amz-tagging` sends them.
const TAGS_FIELD: StringView = "x-amz-tagging";
/// The stored field that holds a version's ACL (ADR-0045), when it is not the private one: three characters, the
/// permissions of the owner, of everyone and of every authenticated requester, each `ACL_BASE` and its ACL bits.
const ACL_FIELD: StringView = "x-amz-acl";
const ACL_BASE: u8 = 0x40;
const ACL_READ: u8 = 1;
const ACL_WRITE: u8 = 2;
const ACL_READ_ACP: u8 = 4;
const ACL_WRITE_ACP: u8 = 8;
const ACL_FULL_CONTROL: u8 = 16;
/// The places of the three grantees in a stored ACL.
const ACL_OWNER: usize = 0;
const ACL_ALL_USERS: usize = 1;
const ACL_AUTHENTICATED: usize = 2;

/// Whether `value` is an ACL as it is stored: empty for the private one, or its three characters.
fn isAclValue(value: Slice<u8>) -> bool {
    if (value.length == 0) { return true; }
    if (value.length != 3) { return false; }
    for (i in 0..3) {
        if (value[i] < ACL_BASE || value[i] >= ACL_BASE + 32) { return false; }
    }
    return true;
}

/// The null version id, used by unversioned buckets.
fn nullVersionId() -> [u8; 16] => [0u8; 16];

fn isNullVersionId(id: [u8; 16]) -> bool {
    for (i in 0..16) {
        if (id[i] != 0) { return false; }
    }
    return true;
}

/// Byte-wise lexicographic order, as S3 lists keys (UTF-8 binary order).
fn compareBytes(a: Slice<u8>, b: Slice<u8>) -> i32 {
    let n = if (a.length < b.length) a.length else b.length;
    for (i in 0..n) {
        if (a[i] != b[i]) { return if (a[i] < b[i]) -1 else 1; }
    }
    if (a.length == b.length) { return 0; }
    return if (a.length < b.length) -1 else 1;
}

fn startsWithBytes(s: Slice<u8>, prefix: Slice<u8>) -> bool {
    if (prefix.length > s.length) { return false; }
    for (i in 0..prefix.length) {
        if (s[i] != prefix[i]) { return false; }
    }
    return true;
}

/// Where `needle` first occurs in `s` at or after `from`.
fn findBytes(s: Slice<u8>, needle: Slice<u8>, from: usize) -> usize? {
    if (needle.length == 0 || needle.length > s.length) { return null; }
    var i = from;
    while (i + needle.length <= s.length) {
        if (startsWithBytes(s[i..], needle)) { return i; }
        i += 1;
    }
    return null;
}

fn copyBytes(s: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var v = Vector<u8>.create();
    v.extend(s)?;
    return Ok(v);
}

/// A key of the object index: the bucket's number and the object key. The number is the store's, given when the bucket
/// is created or recovered and never written to disk (ADR-0027), so a key does not carry its own copy of the bucket's
/// name.
struct IndexKey {
    bucket: u32;
    key: Vector<u8>;
}

impl HashKey<IndexKey> for IndexKey {
    fn hash(borrow this, h: borrow mut Hasher) {
        h.u64(this.bucket as u64);
        h.bytes(this.key.view());
    }

    fn sameAs(borrow this, other: borrow IndexKey) -> bool =>
        this.bucket == other.bucket && this.key.view() == other.key.view();
}

/// The index's order (ADR-0026): by bucket number, then by key, bytewise, as S3 lists a bucket's keys (UTF-8 binary
/// order). Buckets are never listed across, so their numbers only keep each bucket's keys together.
impl OrderKey<IndexKey> for IndexKey {
    fn compareKey(borrow this, other: borrow IndexKey) -> i32 {
        if (this.bucket != other.bucket) { return if (this.bucket < other.bucket) -1 else 1; }
        return this.key.compareKey(borrow other.key);
    }
}

/// A bucket's name as a map key.
struct BucketKey {
    name: Vector<u8>;
}

impl HashKey<BucketKey> for BucketKey {
    fn hash(borrow this, h: borrow mut Hasher) {
        h.bytes(this.name.view());
    }

    fn sameAs(borrow this, other: borrow BucketKey) -> bool => this.name.view() == other.name.view();
}

enum VersionKind {
    Object,
    DeleteMarker,
}

/// One version of a key, as the index holds it.
struct ObjectVersion {
    versionId: [u8; 16];
    /// The LSN of the record that created it: also the key's generation for conditional writes.
    lsn: u64;
    kind: VersionKind;
    size: u64;
    mtimeMillis: i64;
    md5: [u8; 16];
    contentType: Vector<u8>;
    payload: PayloadLocator;
    /// The whole record, for space accounting.
    recordSegment: u64;
    recordLength: u32;
    /// The object's extents, in order; empty for an inline object (its bytes are at `payload`).
    extents: Vector<ExtentRef>;
    /// User metadata and stored headers (ADR-0012), as put meta carries them; empty for none.
    metadata: Vector<u8>;
    /// The checksum and part layout (ADR-0015, `decodeExtras`); empty for none.
    extras: Vector<u8>;
    /// A multipart object's part count, 0 for a single PUT. A multipart object's `md5` is its ETag's digest, the MD5
    /// of its parts' MD5s, not the MD5 of its bytes (ADR-0009).
    parts: u32;
}

fn isDeleteMarker(v: borrow ObjectVersion) -> bool => match (v.kind) {
    VersionKind.DeleteMarker => true,
    _ => false,
};

/// Decoded meta of a PutInline or PutExtent record.
struct PutMeta {
    bucket: Vector<u8>;
    key: Vector<u8>;
    versionId: [u8; 16];
    mtimeMillis: i64;
    size: u64;
    md5: [u8; 16];
    contentType: Vector<u8>;
    /// The metadata section (`metadataAdd`'s format), empty when it has no pairs.
    metadata: Vector<u8>;
    /// PutInline / PutExtent only: the extras section after it (ADR-0015), empty when absent.
    extras: Vector<u8>;
    /// A replica's part count (ADR-0077 §3), so its ETag is its source's: a u32 after the extras section, which only
    /// a replica of a multipart object has; else 0.
    parts: u32;
}

/// Decoded meta of a Relocate record: which version the copied payload belongs to.
struct RelocateMeta {
    bucket: Vector<u8>;
    key: Vector<u8>;
    versionId: [u8; 16];
    /// The version's generation (the LSN of the record that created it).
    generation: u64;
}

/// Decoded meta of a Rename record (ADR-0081): the source key's version of `generation` becomes `to`'s.
struct RenameMeta {
    bucket: Vector<u8>;
    from: Vector<u8>;
    to: Vector<u8>;
    generation: u64;
}

/// Decoded meta of a DeleteVersion or DeleteMarker record.
struct DeleteMeta {
    bucket: Vector<u8>;
    key: Vector<u8>;
    versionId: [u8; 16];
    mtimeMillis: i64;
}

enum MetaFault {
    Short,
    BadVersion,
    TooLong,
    @from OutOfMemory(AllocError),
}

fn pushText16(out: borrow mut Vector<u8>, s: Slice<u8>) -> Result<void, AllocError> {
    out.pushLE(truncate<u16>(s.length))?;
    out.extend(s)?;
    return Ok();
}

/// PutInline / PutExtent meta v1:
///   u8 format version, u16+bytes bucket, u16+bytes key, 16 version id, i64 mtime ms,
///   u64 size, 16 md5, u16+bytes content type, u16 user metadata pairs (each u16+bytes, u16+bytes). `metadata` is
///   that last section, from `metadataAdd` (empty: no pairs).
fn encodePutMeta(
    out: borrow mut Vector<u8>,
    bucket: Slice<u8>,
    key: Slice<u8>,
    versionId: [u8; 16],
    mtimeMillis: i64,
    size: u64,
    md5: [u8; 16],
    contentType: Slice<u8>,
    metadata: Slice<u8>,
) -> Result<void, AllocError> {
    out.pushLE(META_FORMAT_VERSION)?;
    pushText16(out, bucket)?;
    pushText16(out, key)?;
    out.extend(versionId[..])?;
    out.pushLE(mtimeMillis)?;
    out.pushLE(size)?;
    out.extend(md5[..])?;
    pushText16(out, contentType)?;
    appendMetadataSection(out, metadata)?;
    return Ok();
}

// ---- Metadata (ADR-0012) ----

/// One stored field: a lowercase name (`x-amz-meta-*`, or a header S3 keeps such as `content-encoding`) and its value.
struct MetaPair {
    name: Vector<u8>;
    value: Vector<u8>;
}

/// Adds a pair to a metadata blob: u16 pair count, then per pair u16+bytes name and u16+bytes value.
fn metadataAdd(blob: borrow mut Vector<u8>, name: Slice<u8>, value: Slice<u8>) -> Result<void, AllocError> {
    if (blob.length == 0) { blob.pushLE(0u16)?; }
    let count = blob.view().readLE<u16>(0);
    blob.viewMut().writeLE(0, count + 1);
    pushText16(blob, name)?;
    pushText16(blob, value)?;
    return Ok();
}

/// A blob's section in a record or checkpoint: the blob, or a zero count for none.
fn appendMetadataSection(out: borrow mut Vector<u8>, metadata: Slice<u8>) -> Result<void, AllocError> {
    if (metadata.length == 0) {
        out.pushLE(0u16)?;
    } else {
        out.extend(metadata)?;
    }
    return Ok();
}

/// Reads a metadata section at `at`, checking every pair, and returns it as a blob (empty for none).
fn readMetadataSection(bytes: Slice<u8>, at: borrow mut usize) -> Result<Vector<u8>, MetaFault> {
    let start: usize = at;
    need(bytes, at, 2)?;
    let pairs = bytes.readLE<u16>(at);
    at += 2;
    for (i in 0..pairs) {
        let _ = readText16(bytes, at)?;
        let _ = readText16(bytes, at)?;
    }
    if (pairs == 0) { return Ok(Vector<u8>.create()); }
    return Ok(copyBytes(bytes[start..at])?);
}

/// `blob` with the pair `name` set to `value`, or removed for an empty `value`; the other pairs keep their order.
fn metadataReplace(blob: Slice<u8>, name: Slice<u8>, value: Slice<u8>) -> Result<Vector<u8>, MetaFault> {
    var out = Vector<u8>.create();
    let pairs = metadataPairs(blob)?;
    for (i in 0..pairs.length) {
        if (pairs[i].name.view() != name) { metadataAdd(mut out, pairs[i].name.view(), pairs[i].value.view())?; }
    }
    if (value.length > 0) { metadataAdd(mut out, name, value)?; }
    return Ok(out);
}

/// The stored field of an object's storage class (ADR-0090 §1): absent for STANDARD, as S3 does not name it.
const STORAGE_CLASS_FIELD: StringView = "x-amz-storage-class";

/// An object's stored storage class, empty for STANDARD (or metadata that does not decode).
fn storageClassIn(blob: Slice<u8>) -> Result<Vector<u8>, AllocError> =>
    match (metadataValue(blob, STORAGE_CLASS_FIELD.bytes())) {
        Ok(v) => Ok(v),
        Err(MetaFault.OutOfMemory(e)) => Err(e),
        Err(_) => Ok(Vector<u8>.create()),
    };

/// The value of the pair `name`, empty if there is none.
fn metadataValue(blob: Slice<u8>, name: Slice<u8>) -> Result<Vector<u8>, MetaFault> {
    let pairs = metadataPairs(blob)?;
    for (i in 0..pairs.length) {
        if (pairs[i].name.view() == name) { return Ok(copyBytes(pairs[i].value.view())?); }
    }
    return Ok(Vector<u8>.create());
}

/// SetTags meta v1: u8 format version, u16+bytes bucket, u16+bytes key, 16 version id, u64 generation (the version's
/// LSN), u16+bytes tags (URL-encoded; empty: no tags). ADR-0017.
fn encodeSetTagsMeta(
    out: borrow mut Vector<u8>,
    bucket: Slice<u8>,
    key: Slice<u8>,
    versionId: [u8; 16],
    generation: u64,
    tags: Slice<u8>,
) -> Result<void, AllocError> {
    out.pushLE(META_FORMAT_VERSION)?;
    pushText16(out, bucket)?;
    pushText16(out, key)?;
    out.extend(versionId[..])?;
    out.pushLE(generation)?;
    pushText16(out, tags)?;
    return Ok();
}

/// The SetTags meta's later formats, which set another field of the version in place of its tags: its ACL
/// (ADR-0045), or its object lock (ADR-0047).
const SET_ACL_FORMAT: u8 = 2;
const SET_LOCK_FORMAT: u8 = 3;
/// A SetTags record that sets a version's storage class (ADR-0090 §2): a lifecycle transition.
const SET_CLASS_FORMAT: u8 = 4;
/// A SetTags record that sets a version's SSE-S3 envelope (ADR-0100 §2): its data key re-wrapped under another
/// master key, its bytes untouched.
const SET_ENVELOPE_FORMAT: u8 = 5;

/// A SetTags record that sets a version's restore state (ADR-0102 §4): `<ready ms> <expiry ms> [<class>]`.
const SET_RESTORE_FORMAT: u8 = 6;
/// The metadata field a restore's state is kept in.
const RESTORE_FIELD: StringView = "x-cosmo-restore";

/// Whether a value is a restore's state: two decimal times, ready before expiry, then the class it is for (the M18 exit
/// review; a state without one, as first written, is taken too).
fn isRestoreValue(value: Slice<u8>) -> bool => restorePartsOf(value).isSome();

/// A restore state's parts, as kept: `<ready> <expiry>[ <class>[ <sent>]]`. `sent` is what the upkeep has said of
/// it (ADR-0106 §4): RESTORE_SENT_NONE, RESTORE_SENT_DONE once its s3:ObjectRestore:Completed event was raised,
/// RESTORE_SENT_EXPIRED once its :Delete was. `classAt` and `classEnd` are where its class is (equal: none).
struct RestoreParts {
    readyMs: i64;
    expiryMs: i64;
    classAt: usize;
    classEnd: usize;
    sent: u8;
}

const RESTORE_SENT_NONE: u8 = 0;
const RESTORE_SENT_DONE: u8 = 1;
const RESTORE_SENT_EXPIRED: u8 = 2;

fn restorePartsOf(value: Slice<u8>) -> RestoreParts? {
    let text = StringView.fromUtf8(value) ?? { return null; };
    let space = text.indexOf(" ") ?? { return null; };
    let ready = text[0..space].parseInt<i64>() ?? { return null; };
    let rest = text[space + 1..];
    let expiryEnd = rest.indexOf(" ") ?? rest.length;
    let expiry = rest[0..expiryEnd].parseInt<i64>() ?? { return null; };
    if (ready < 0 || ready > expiry) { return null; }
    var parts = RestoreParts {
        readyMs: ready,
        expiryMs: expiry,
        classAt: value.length,
        classEnd: value.length,
        sent: 0,
    };
    if (expiryEnd == rest.length) { return parts; }
    let start = space + 1 + expiryEnd + 1;
    var end = start;
    while (end < value.length && value[end] != ' ') { end += 1; }
    let made = value[start..end];
    if (made != "GLACIER".bytes() && made != "DEEP_ARCHIVE".bytes()) { return null; }
    parts.classAt = start;
    parts.classEnd = end;
    if (end == value.length) { return parts; }
    let mark = value[end + 1..];
    if (mark == "c".bytes()) {
        parts.sent = RESTORE_SENT_DONE;
    } else if (mark == "d".bytes()) {
        parts.sent = RESTORE_SENT_EXPIRED;
    } else {
        return null;
    }
    return parts;
}

/// Whether a value is one a re-wrap may set: an SSE-S3 envelope (`v1.s3.<id>.<nonce>.<wrapped>`), never KMS's or
/// SSE-C's.
fn isRewrapValue(value: Slice<u8>) -> bool {
    if (value.length < 7 || value[0..6] != "v1.s3.".bytes()) { return false; }
    var dots = 0;
    for (i in 0..value.length) {
        if (value[i] == '.') { dots += 1; }
    }
    return dots >= 4;
}

/// The storage classes an object may record (ADR-0090 §1), in S3's waterfall order: a transition only moves an
/// object later in it. STANDARD is not recorded (an empty value).
const STORED_STORAGE_CLASSES: [StringView; 7] =
    ["REDUCED_REDUNDANCY", "STANDARD_IA", "INTELLIGENT_TIERING", "ONEZONE_IA", "GLACIER_IR", "GLACIER", "DEEP_ARCHIVE"];

/// Whether a stored class value is one an object may record: empty (STANDARD) or one of STORED_STORAGE_CLASSES.
fn isStoredClassValue(value: Slice<u8>) -> bool {
    if (value.length == 0) { return true; }
    for (c in STORED_STORAGE_CLASSES) {
        if (c.bytes() == value) { return true; }
    }
    return false;
}

/// A class's place in S3's waterfall: STANDARD and REDUCED_REDUNDANCY 0, then STANDARD_IA, INTELLIGENT_TIERING,
/// ONEZONE_IA, GLACIER_IR.
fn storageClassRank(value: Slice<u8>) -> u32 {
    if (value.length == 0 || value == "STANDARD".bytes() || value == "REDUCED_REDUNDANCY".bytes()) { return 0; }
    for (i in 1..STORED_STORAGE_CLASSES.length) {
        if (STORED_STORAGE_CLASSES[i].bytes() == value) { return truncate<u32>(i); }
    }
    return 0;
}

/// Whether `value` is one a SetTags record of `format` may set: checked when the record is decoded, and before it is
/// written, so the journal never holds one its replay would refuse (the M18 restore record's test found the gap).
fn setFieldValueOk(format: u8, value: Slice<u8>) -> bool {
    if (format == SET_ACL_FORMAT) { return isAclValue(value); }
    if (format == SET_LOCK_FORMAT) { return decodeLock(value).isSome(); }
    if (format == SET_CLASS_FORMAT) { return isStoredClassValue(value); }
    if (format == SET_ENVELOPE_FORMAT) { return isRewrapValue(value); }
    if (format == SET_RESTORE_FORMAT) { return isRestoreValue(value); }
    return true;
}

/// The metadata field a SetTags record of `format` sets.
fn setTagsField(format: u8) -> StringView =>
    if (format == SET_ACL_FORMAT) ACL_FIELD else if (format == SET_LOCK_FORMAT) LOCK_FIELD else if (format ==
        SET_CLASS_FORMAT) STORAGE_CLASS_FIELD else if (format == SET_ENVELOPE_FORMAT) ENVELOPE_FIELD else if (format ==
        SET_RESTORE_FORMAT) RESTORE_FIELD else TAGS_FIELD;

/// SetTags meta v2, v3 and v4: as v1 with format 2, 3 or 4, and the last field is the version's ACL, its object lock,
/// or its storage class, as it is stored (empty: the private ACL; no lock; STANDARD) in place of its tags.
fn encodeSetFieldMeta(
    out: borrow mut Vector<u8>,
    format: u8,
    bucket: Slice<u8>,
    key: Slice<u8>,
    versionId: [u8; 16],
    generation: u64,
    value: Slice<u8>,
) -> Result<void, AllocError> {
    out.pushLE(format)?;
    pushText16(out, bucket)?;
    pushText16(out, key)?;
    out.extend(versionId[..])?;
    out.pushLE(generation)?;
    pushText16(out, value)?;
    return Ok();
}

struct SetTagsMeta {
    bucket: Vector<u8>;
    key: Vector<u8>;
    versionId: [u8; 16];
    generation: u64;
    /// The tags, or the ACL or lock of the later formats.
    tags: Vector<u8>;
    /// 1: the record sets the tags; SET_ACL_FORMAT, SET_LOCK_FORMAT: that field.
    format: u8;
}

fn decodeSetTagsMeta(bytes: Slice<u8>) -> Result<SetTagsMeta, MetaFault> {
    var at: usize = 0;
    need(bytes, at, 1)?;
    let format = bytes[at];
    if (format == SET_ACL_FORMAT || format == SET_LOCK_FORMAT || format == SET_CLASS_FORMAT ||
        format == SET_ENVELOPE_FORMAT || format == SET_RESTORE_FORMAT) {
        at += 1;
    } else {
        checkVersion(bytes, mut at)?;
    }
    let bucket = readText16(bytes, mut at)?;
    let key = readText16(bytes, mut at)?;
    let versionId = readId16(bytes, mut at)?;
    let generation = readU64(bytes, mut at)?;
    let tags = readText16(bytes, mut at)?;
    if (at != bytes.length) { return Err(MetaFault.TooLong); }
    if (!setFieldValueOk(format, tags.view())) { return Err(MetaFault.TooLong); }
    return Ok(SetTagsMeta {
        bucket: bucket,
        key: key,
        versionId: versionId,
        generation: generation,
        tags: tags,
        format: format,
    });
}

/// The value of the pair `name` in a metadata blob, without a copy; null if there is none, or the blob is not one.
fn metadataFind<region a>(blob: Slice<a, u8>, name: Slice<u8>) -> Slice<a, u8>? {
    if (blob.length < 2) { return null; }
    let pairs = blob.readLE<u16>(0);
    var at: usize = 2;
    for (i in 0..pairs) {
        if (at + 2 > blob.length) { return null; }
        let nameLen = blob.readLE<u16>(at) as usize;
        at += 2;
        if (at + nameLen + 2 > blob.length) { return null; }
        let found = blob[at..at + nameLen] == name;
        at += nameLen;
        let valueLen = blob.readLE<u16>(at) as usize;
        at += 2;
        if (at + valueLen > blob.length) { return null; }
        if (found) { return Some(blob[at..at + valueLen]); }
        at += valueLen;
    }
    return null;
}

// ---- Object lock (ADR-0047) ----

/// The stored field that holds a version's object lock: its retention mode (`N` none, `G` governance,
/// `C` compliance), its legal hold (`0`, `1`), a dot, and the time its retention ends, in ms. No field: no lock.
const LOCK_FIELD: StringView = "x-amz-object-lock";
const LOCK_NONE: u8 = 'N';
const LOCK_GOVERNANCE: u8 = 'G';
const LOCK_COMPLIANCE: u8 = 'C';

/// A version's retention and legal hold.
struct ObjectLock {
    mode: u8;
    /// When the retention ends, in ms since the epoch; 0 without one.
    until: i64;
    hold: bool;
}

fn noLock() -> ObjectLock => ObjectLock { mode: LOCK_NONE, until: 0, hold: false };

/// A lock as its field holds it; nothing for no retention and no hold.
fn encodeLock(l: ObjectLock, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    if (l.mode == LOCK_NONE && !l.hold) { return Ok(); }
    out.push(l.mode)?;
    out.push(if (l.hold) '1' else '0')?;
    out.push('.')?;
    var digits = [0u8; 20];
    var n: usize = 0;
    var v = if (l.mode == LOCK_NONE || l.until < 0) 0 else l.until;
    while (true) {
        digits[n] = '0' + truncate<u8>(v % 10);
        n += 1;
        v = v / 10;
        if (v == 0) { break; }
    }
    while (n > 0) {
        n -= 1;
        out.push(digits[n])?;
    }
    return Ok();
}

/// A stored lock: no lock for an empty field, null for a field that is not one.
fn decodeLock(text: Slice<u8>) -> ObjectLock? {
    if (text.length == 0) { return Some(noLock()); }
    if (text.length < 4 || text.length > 22 || text[2] != '.') { return null; }
    let mode = text[0];
    if (mode != LOCK_NONE && mode != LOCK_GOVERNANCE && mode != LOCK_COMPLIANCE) { return null; }
    if (text[1] != '0' && text[1] != '1') { return null; }
    var until: i64 = 0;
    for (i in 3..text.length) {
        if (text[i] < '0' || text[i] > '9') { return null; }
        until = until * 10 + ((text[i] - '0') as i64);
    }
    if (mode == LOCK_NONE && (until != 0 || text[1] == '0')) { return null; }
    return Some(ObjectLock { mode: mode, until: until, hold: text[1] == '1' });
}

/// The lock of a version with this metadata: none without the field, or with one that does not read.
fn lockOfMetadata(blob: Slice<u8>) -> ObjectLock => match (metadataFind(blob, LOCK_FIELD.bytes())) {
    Some(text) => decodeLock(text) ?? noLock(),
    null => noLock(),
};

/// Whether a lock keeps its version from being removed at `now` (ADR-0047 §4): a legal hold always, compliance
/// retention until it ends, governance retention until it ends unless the request may bypass it.
fn lockHolds(l: ObjectLock, now: i64, bypass: bool) -> bool {
    if (l.hold) { return true; }
    if (l.mode == LOCK_NONE || l.until <= now) { return false; }
    return l.mode == LOCK_COMPLIANCE || !bypass;
}

/// Whether a version's retention may become `next` at `now` (ADR-0047 §3): freely once it has ended; compliance
/// only longer; governance longer in its own mode, or anything with a bypass.
fn lockChangeAllowed(old: ObjectLock, next: ObjectLock, now: i64, bypass: bool) -> bool {
    if (old.mode == LOCK_NONE || old.until <= now) { return true; }
    if (old.mode == LOCK_COMPLIANCE) { return next.mode == LOCK_COMPLIANCE && next.until >= old.until; }
    return (next.mode == LOCK_GOVERNANCE && next.until >= old.until) || bypass;
}

/// The pairs of a metadata blob.
fn metadataPairs(blob: Slice<u8>) -> Result<Vector<MetaPair>, MetaFault> {
    var pairs = Vector<MetaPair>.create();
    if (blob.length == 0) { return Ok(pairs); }
    var at: usize = 2;
    let n = blob.readLE<u16>(0);
    for (i in 0..n) {
        let name = readText16(blob, mut at)?;
        let value = readText16(blob, mut at)?;
        pairs.push(MetaPair { name: name, value: value })?;
    }
    return Ok(pairs);
}

/// DeleteVersion / DeleteMarker meta v1: u8 format version, u16+bytes bucket, u16+bytes key,
/// 16 version id, i64 mtime ms.
fn encodeDeleteMeta(
    out: borrow mut Vector<u8>,
    bucket: Slice<u8>,
    key: Slice<u8>,
    versionId: [u8; 16],
    mtimeMillis: i64,
) -> Result<void, AllocError> {
    out.pushLE(META_FORMAT_VERSION)?;
    pushText16(out, bucket)?;
    pushText16(out, key)?;
    out.extend(versionId[..])?;
    out.pushLE(mtimeMillis)?;
    return Ok();
}

/// BucketCreate / BucketDelete meta v1: u8 format version, u16+bytes name, i64 mtime ms.
fn encodeBucketMeta(out: borrow mut Vector<u8>, name: Slice<u8>, mtimeMillis: i64) -> Result<void, AllocError> {
    out.pushLE(META_FORMAT_VERSION)?;
    pushText16(out, name)?;
    out.pushLE(mtimeMillis)?;
    return Ok();
}

/// Relocate meta v1: u8 format version, u16+bytes bucket, u16+bytes key, 16 version id,
/// u64 generation. The payload is the version's inline bytes.
fn encodeRelocateMeta(
    out: borrow mut Vector<u8>,
    bucket: Slice<u8>,
    key: Slice<u8>,
    versionId: [u8; 16],
    generation: u64,
) -> Result<void, AllocError> {
    out.pushLE(META_FORMAT_VERSION)?;
    pushText16(out, bucket)?;
    pushText16(out, key)?;
    out.extend(versionId[..])?;
    out.pushLE(generation)?;
    return Ok();
}

fn encodeRenameMeta(
    out: borrow mut Vector<u8>,
    bucket: Slice<u8>,
    from: Slice<u8>,
    to: Slice<u8>,
    generation: u64,
) -> Result<void, AllocError> {
    out.pushLE(META_FORMAT_VERSION)?;
    pushText16(out, bucket)?;
    pushText16(out, from)?;
    pushText16(out, to)?;
    out.pushLE(generation)?;
    return Ok();
}

fn need(bytes: Slice<u8>, at: usize, n: usize) -> Result<void, MetaFault> {
    if (at + n > bytes.length) { return Err(MetaFault.Short); }
    return Ok();
}

fn readText16(bytes: Slice<u8>, at: borrow mut usize) -> Result<Vector<u8>, MetaFault> {
    need(bytes, at, 2)?;
    let n = bytes.readLE<u16>(at) as usize;
    at += 2;
    need(bytes, at, n)?;
    let v = copyBytes(bytes[at..at + n])?;
    at += n;
    return Ok(v);
}

fn readId16(bytes: Slice<u8>, at: borrow mut usize) -> Result<[u8; 16], MetaFault> {
    need(bytes, at, 16)?;
    var id = [0u8; 16];
    id[..].copyFrom(bytes[at..at + 16]);
    at += 16;
    return Ok(id);
}

fn readU64(bytes: Slice<u8>, at: borrow mut usize) -> Result<u64, MetaFault> {
    need(bytes, at, 8)?;
    let v = bytes.readLE<u64>(at);
    at += 8;
    return Ok(v);
}

fn readI64(bytes: Slice<u8>, at: borrow mut usize) -> Result<i64, MetaFault> {
    need(bytes, at, 8)?;
    let v = bytes.readLE<i64>(at);
    at += 8;
    return Ok(v);
}

fn checkVersion(bytes: Slice<u8>, at: borrow mut usize) -> Result<void, MetaFault> {
    need(bytes, at, 1)?;
    if (bytes[at] != META_FORMAT_VERSION) { return Err(MetaFault.BadVersion); }
    at += 1;
    return Ok();
}

fn readU32(bytes: Slice<u8>, at: borrow mut usize) -> Result<u32, MetaFault> {
    need(bytes, at, 4)?;
    let v = bytes.readLE<u32>(at);
    at += 4;
    return Ok(v);
}

/// PutInline / PutExtent meta: the put meta, then an extras section (ADR-0015) unless the record is older.
fn decodePutMeta(bytes: Slice<u8>) -> Result<PutMeta, MetaFault> {
    var at: usize = 0;
    var m = decodePutMetaAt(bytes, mut at)?;
    if (at < bytes.length) { m.extras = readExtrasSection(bytes, mut at)?; }
    if (at < bytes.length) {
        m.parts = readU32(bytes, mut at)?;
        if (m.parts == 0 || m.parts > 10000) { return Err(MetaFault.TooLong); }
    }
    if (at != bytes.length) { return Err(MetaFault.TooLong); }
    return Ok(m);
}

/// Decodes PutInline / PutExtent meta from `at`, user metadata included, and leaves `at` after it.
fn decodePutMetaAt(bytes: Slice<u8>, at: borrow mut usize) -> Result<PutMeta, MetaFault> {
    checkVersion(bytes, at)?;
    let bucket = readText16(bytes, at)?;
    let key = readText16(bytes, at)?;
    let versionId = readId16(bytes, at)?;
    let mtime = readI64(bytes, at)?;
    let size = readU64(bytes, at)?;
    let md5 = readId16(bytes, at)?;
    let contentType = readText16(bytes, at)?;
    let metadata = readMetadataSection(bytes, at)?;
    return Ok(PutMeta {
        bucket: bucket,
        key: key,
        versionId: versionId,
        mtimeMillis: mtime,
        size: size,
        md5: md5,
        contentType: contentType,
        metadata: metadata,
        extras: Vector<u8>.create(),
        parts: 0,
    });
}

fn decodeDeleteMeta(bytes: Slice<u8>) -> Result<DeleteMeta, MetaFault> {
    var at: usize = 0;
    checkVersion(bytes, mut at)?;
    let bucket = readText16(bytes, mut at)?;
    let key = readText16(bytes, mut at)?;
    let versionId = readId16(bytes, mut at)?;
    let mtime = readI64(bytes, mut at)?;
    return Ok(DeleteMeta { bucket: bucket, key: key, versionId: versionId, mtimeMillis: mtime });
}

fn decodeRelocateMeta(bytes: Slice<u8>) -> Result<RelocateMeta, MetaFault> {
    var at: usize = 0;
    checkVersion(bytes, mut at)?;
    let bucket = readText16(bytes, mut at)?;
    let key = readText16(bytes, mut at)?;
    let versionId = readId16(bytes, mut at)?;
    let generation = readU64(bytes, mut at)?;
    return Ok(RelocateMeta { bucket: bucket, key: key, versionId: versionId, generation: generation });
}

fn decodeRenameMeta(bytes: Slice<u8>) -> Result<RenameMeta, MetaFault> {
    var at: usize = 0;
    checkVersion(bytes, mut at)?;
    let bucket = readText16(bytes, mut at)?;
    let from = readText16(bytes, mut at)?;
    let to = readText16(bytes, mut at)?;
    let generation = readU64(bytes, mut at)?;
    if (at != bytes.length) { return Err(MetaFault.TooLong); }
    return Ok(RenameMeta { bucket: bucket, from: from, to: to, generation: generation });
}

fn decodeBucketName(bytes: Slice<u8>) -> Result<Vector<u8>, MetaFault> {
    var at: usize = 0;
    checkVersion(bytes, mut at)?;
    return readText16(bytes, mut at);
}

/// The mtime of BucketCreate / BucketDelete meta.
fn decodeBucketMillis(bytes: Slice<u8>) -> Result<i64, MetaFault> {
    var at: usize = 0;
    checkVersion(bytes, mut at)?;
    let _ = readText16(bytes, mut at)?;
    return readI64(bytes, mut at);
}

/// BucketCreate meta of a directory bucket (ADR-0080 §2): `encodeBucketMeta`'s, then u16+bytes its zone id. A
/// BucketCreate without it is a general-purpose bucket's.
fn encodeDirectoryBucketMeta(
    out: borrow mut Vector<u8>,
    name: Slice<u8>,
    mtimeMillis: i64,
    zone: Slice<u8>,
) -> Result<void, AllocError> {
    encodeBucketMeta(out, name, mtimeMillis)?;
    pushText16(out, zone)?;
    return Ok();
}

/// The zone id of BucketCreate meta: empty for a general-purpose bucket.
fn decodeBucketZone(bytes: Slice<u8>) -> Result<Vector<u8>, MetaFault> {
    var at: usize = 0;
    checkVersion(bytes, mut at)?;
    let _ = readText16(bytes, mut at)?;
    let _ = readI64(bytes, mut at)?;
    if (at == bytes.length) { return Ok(Vector<u8>.create()); }
    let zone = readText16(bytes, mut at)?;
    if (at != bytes.length || !isZoneId(zone.view())) { return Err(MetaFault.TooLong); }
    return Ok(zone);
}

/// A zone id (ADR-0080 §1): 1 to 20 of a-z, 0-9 and `-`, beginning and ending with a letter or digit, and no `--`
/// (which would make a directory bucket's name ambiguous).
fn isZoneId(zone: Slice<u8>) -> bool {
    if (zone.length == 0 || zone.length > 20) { return false; }
    for (i in 0..zone.length) {
        let c = zone[i];
        let alnum = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9');
        if (!alnum && c != '-') { return false; }
        if ((i == 0 || i + 1 == zone.length) && !alnum) { return false; }
        if (c == '-' && i > 0 && zone[i - 1] == '-') { return false; }
    }
    return true;
}

/// The suffix every directory bucket's name ends with (ADR-0080).
const DIRECTORY_SUFFIX: StringView = "--x-s3";

/// Whether `name` has a directory bucket's suffix: such a name is never a general-purpose bucket's.
fn isDirectoryShaped(name: Slice<u8>) -> bool {
    let s = DIRECTORY_SUFFIX.bytes();
    return name.length >= s.length && name[name.length - s.length..] == s;
}

/// S3's rules for a directory bucket's name in `zone` (ADR-0080): `<base>--<zone>--x-s3`, 3 to 63 characters in
/// all; the base of a-z, 0-9 and `-`, beginning and ending with a letter or digit; not beginning `xn--`, `sthree-`
/// or `amzn-s3-demo-`.
fn isDirectoryBucketName(name: Slice<u8>, zone: Slice<u8>) -> bool {
    if (name.length < 3 || name.length > MAX_BUCKET_NAME || !isZoneId(zone) || !isDirectoryShaped(name)) {
        return false;
    }
    let tail = DIRECTORY_SUFFIX.bytes().length + zone.length + 2;
    if (name.length <= tail) { return false; }
    let base = name[0..name.length - tail];
    let middle = name[base.length..name.length - DIRECTORY_SUFFIX.bytes().length];
    if (middle.length != zone.length + 2 || middle[0] != '-' || middle[1] != '-' || middle[2..] != zone) {
        return false;
    }
    for (prefix in ["xn--", "sthree-", "amzn-s3-demo-"]) {
        if (base.length >= prefix.length && base[0..prefix.length] == prefix.bytes()) { return false; }
    }
    for (i in 0..base.length) {
        let c = base[i];
        let alnum = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9');
        if (!alnum && c != '-') { return false; }
        if ((i == 0 || i + 1 == base.length) && !alnum) { return false; }
    }
    return true;
}

/// S3 general-purpose bucket naming rules (3-63 chars; lowercase letters, digits, '.', '-';
/// starts and ends with a letter or digit; no "..", not an IPv4 address).
/// A table bucket's store bucket (ADR-0083 §2): a valid bucket name, then `--table-s3`, so up to 73 characters.
/// The store's own hidden bucket (ADR-0104 §3): the IAM API's records, secrets among them. Its name is no S3 name, so
/// no client names it; the S3 layer refuses every request that tries (`isHiddenBucketName`).
fn isHiddenStoreBucket(name: Slice<u8>) -> bool => name == "_cosmostore-iam".bytes();

fn isTableBucketStoreName(name: Slice<u8>) -> bool {
    let suffix = "--table-s3".bytes();
    if (name.length <= suffix.length || name[name.length - suffix.length..] != suffix) { return false; }
    return isValidBucketName(name[0..name.length - suffix.length]);
}

fn isValidBucketName(name: Slice<u8>) -> bool {
    if (name.length < 3 || name.length > MAX_BUCKET_NAME) { return false; }
    var dotsOnlyDigits = true;
    var dots = 0;
    for (i in 0..name.length) {
        let c = name[i];
        let lower = c >= 'a' && c <= 'z';
        let digit = c >= '0' && c <= '9';
        if (!(lower || digit || c == '.' || c == '-')) { return false; }
        if ((i == 0 || i + 1 == name.length) && !(lower || digit)) { return false; }
        if (c == '.') {
            dots += 1;
            if (i > 0 && name[i - 1] == '.') { return false; }
        } else if (!digit) {
            dotsOnlyDigits = false;
        }
    }
    return !(dotsOnlyDigits && dots == 3);
}

@test
fn putMetaRoundTrip() -> Result<void, TestFailure> {
    var out = Vector<u8>.create();
    let bucket = "photos";
    let key = "2026/11/06/cat.jpg";
    let ctype = "image/jpeg";
    var vid = nullVersionId();
    vid[3] = 9;
    let md5 = Md5.of(key.bytes());
    var meta = Vector<u8>.create();
    metadataAdd(mut meta, "x-amz-meta-mtime".bytes(), "1700000000".bytes())!;
    metadataAdd(mut meta, "content-encoding".bytes(), "gzip".bytes())!;
    encodePutMeta(mut out, bucket.bytes(), key.bytes(), vid, 1700000000000, 12345, md5, ctype.bytes(), meta.view())!;
    let m = match (decodePutMeta(out.view())) {
        Ok(m) => m,
        Err(_) => { return Check.fail("decodes"); }
    };
    Check.equalBytes(bucket.bytes(), m.bucket.view())?;
    Check.equalBytes(key.bytes(), m.key.view())?;
    Check.equalBytes(vid[..], m.versionId[..])?;
    Check.equalU64(12345, m.size)?;
    Check.equalBytes(md5[..], m.md5[..])?;
    Check.equalBytes(ctype.bytes(), m.contentType.view())?;
    Check.equalBytes(meta.view(), m.metadata.view())?;
    let pairs = metadataPairs(m.metadata.view())!;
    Check.equalU64(2, pairs.length as u64)?;
    Check.equalBytes("content-encoding".bytes(), pairs[1].name.view())?;
    Check.equalBytes("gzip".bytes(), pairs[1].value.view())?;
    // Every truncation is rejected, never misread.
    for (n in 0..out.length) {
        match (decodePutMeta(out.view()[0..n])) {
            Ok(_) => { return Check.fail("a truncated meta must not decode"); }
            Err(_) => {}
        }
    }
    return Ok();
}

@test
fn bucketNames() -> Result<void, TestFailure> {
    let good = ["abc", "my-bucket", "my.bucket.2", "a1b"];
    for (n in good) { Check.isTrue(isValidBucketName(n.bytes()), "valid bucket name")?; }
    let bad = ["ab", "-abc", "abc-", "ABC", "a..b", "192.168.1.1", "a_b", "abc."];
    for (n in bad) { Check.isTrue(!isValidBucketName(n.bytes()), "invalid bucket name")?; }
    return Ok();
}

@test
fn byteOrdering() -> Result<void, TestFailure> {
    let a = "a";
    let ab = "ab";
    let b = "b";
    Check.isTrue(compareBytes(a.bytes(), ab.bytes()) < 0, "a < ab")?;
    Check.isTrue(compareBytes(ab.bytes(), b.bytes()) < 0, "ab < b")?;
    Check.isTrue(compareBytes(b.bytes(), b.bytes()) == 0, "b == b")?;
    return Ok();
}
