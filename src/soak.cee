// The M2 exit test (ROADMAP): a long overwrite/delete churn against one store, meant to run for 24 hours under
// tools/soak.sh, which kills the process with SIGKILL at random moments and starts it again.
//
//   cosmostore soak <dir> <seconds> <keys> <capacity-bytes>
//
// Every operation is logged twice in <dir>/soak.log: an intent before the store is called and an ack after it
// returned Ok. The log is written without syncing, which survives a process kill (the test's crash), not a power
// cut. At each start the model is rebuilt from the log, and the store must hold, for every key, the last acked
// state, or the state of the one operation that was in flight when the process was killed. Then the churn goes
// on, and once a minute one line of numbers is printed:
//   elapsed, operations, live bytes (the model's), used bytes (the store's), their ratio, segments, objects,
//   writes refused for space, checkpoints, segments compacted.

const SOAK_PUT: u32 = 1;
const SOAK_DELETE: u32 = 2;
const SOAK_INTENT: u32 = 0x100;
const SOAK_RECORD: usize = 24;

/// What the model expects of a key: no object (seed 0), or the object whose bytes `seed` and `size` make.
struct KeyState {
    seed: u64;
    size: u64;
}

/// The soak's run: the store, the model, and the counters.
struct Soak {
    model: Vector<KeyState>;
    log: DurableFile;
    logEnd: u64;
    keys: u64;
    rng: u64;
    operations: u64;
    refused: u64;
    checkpoints: u64;
    compacted: u64;
}

/// xorshift64.
fn soakNext(x: borrow mut u64) -> u64 {
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    return x;
}

/// An object's bytes: a stream determined by its seed.
fn soakBytes(seed: u64, size: u64, into: borrow mut Vector<u8>) {
    into.clear();
    var x = seed.wrappingMul(0x9E3779B97F4A7C15) | 1;
    var left = size;
    while (left > 0) {
        let w = soakNext(mut x);
        var word = [0u8; 8];
        word.writeLE(0, w);
        let n = if (left < 8) left as usize else 8;
        into.extend(word[0..n])!;
        left -= n as u64;
    }
}

fn soakKeyName(into: borrow mut String, k: u64) {
    into.clear();
    into.append("key/")!;
    into.appendNumber(k % 61)!;
    into.append("/")!;
    into.appendNumber(k)!;
}

/// Mostly small objects stored inline, and some that span extents (up to 1.5 MiB).
fn soakSize(r: u64) -> u64 => if (r % 10 < 7) 64 + r % 16000 else 131072 + r % 1441792;

impl Soak {
    fn append(borrow mut this, key: u64, kind: u32, seed: u64, size: u64) {
        var rec = [0u8; 24];
        rec.writeLE(0, truncate<u32>(key));
        rec.writeLE(4, kind);
        rec.writeLE(8, seed);
        rec.writeLE(16, size);
        this.log.writeAt(rec[..], this.logEnd)!;
        this.logEnd += SOAK_RECORD as u64;
    }

    /// Rewrites the log as one ack per key that holds an object: written aside, synced, then renamed over the log,
    /// so a kill at any moment leaves the old log or the new one. Keeps restarts fast in a 24-hour run.
    fn compactLog(borrow mut this, dir: StringView) {
        var path = String.create();
        path.append(dir)!;
        path.append("/soak.log")!;
        var aside = String.create();
        aside.append(dir)!;
        aside.append("/soak.log.new")!;
        let _ = Fs.unlink(aside.view());
        var out = Vector<u8>.create();
        for (k in 0..this.model.length) {
            let s = this.model[k];
            if (s.seed == 0) { continue; }
            var rec = [0u8; 24];
            rec.writeLE(0, truncate<u32>(k));
            rec.writeLE(4, SOAK_PUT);
            rec.writeLE(8, s.seed);
            rec.writeLE(16, s.size);
            out.extend(rec[..])!;
        }
        {
            let file = DurableFile.createNew(aside.view())!;
            file.writeAt(out.view(), 0)!;
            file.syncData()!;
        }
        Fs.rename(aside.view(), path.view())!;
        Fs.syncDirectory(dir)!;
        this.log = DurableFile.openReadWrite(path.view())!;
        this.logEnd = out.length as u64;
    }

    fn liveBytes(borrow this) -> u64 {
        var total: u64 = 0;
        for (s in this.model.view()) {
            total += s.size;
        }
        return total;
    }
}

/// Rebuilds the model from the log: the acked state of every key, and the one operation in flight, if any.
fn soakReplay(soak: borrow mut Soak, pending: borrow mut KeyState, pendingKey: borrow mut u64) {
    let size = soak.log.size()!;
    var bytes = Vector<u8>.create();
    bytes.resize(size as usize, 0)!;
    soak.log.readExactAt(bytes.viewMut(), 0)!;
    let whole = (size / SOAK_RECORD as u64) * SOAK_RECORD as u64; // a torn last record is dropped
    var at: usize = 0;
    pendingKey = 0xFFFFFFFFFFFFFFFF;
    while ((at as u64) < whole) {
        let key = bytes.view().readLE<u32>(at) as u64;
        let kind = bytes.view().readLE<u32>(at + 4);
        let seed = bytes.view().readLE<u64>(at + 8);
        let length = bytes.view().readLE<u64>(at + 16);
        if ((kind & SOAK_INTENT) != 0) {
            pendingKey = key;
            pending = KeyState {
                seed: if ((kind & 0xFF) == SOAK_PUT) seed else 0,
                size: if ((kind & 0xFF) == SOAK_PUT) length else 0,
            };
        } else {
            soak.model[key as usize] = KeyState {
                seed: if (kind == SOAK_PUT) seed else 0,
                size: if (kind == SOAK_PUT) length else 0,
            };
            pendingKey = 0xFFFFFFFFFFFFFFFF;
        }
        soak.operations += 1;
        if (seed > soak.rng) { soak.rng = seed; }
        at += SOAK_RECORD;
    }
    soak.logEnd = whole;
    soak.operations = soak.operations / 2;
}

/// Whether the store holds `state` for key `k`.
fn soakHolds(
    store: borrow ObjectStore,
    k: u64,
    state: borrow KeyState,
    name: borrow mut String,
    buffer: borrow mut Vector<u8>,
) -> bool {
    soakKeyName(name, k);
    return match (store.getObject("soak", name.view())) {
        Ok(got) => {
            if (state.seed == 0) {
                false
            } else {
                soakBytes(state.seed, state.size, buffer);
                got.view() == buffer.view()
            }
        }
        Err(StoreError.NoSuchKey) => state.seed == 0,
        Err(_) => false,
    };
}

fn soakLine(line: borrow mut String, label: StringView, value: u64) {
    line.append(label)!;
    line.appendNumber(value)!;
}

/// Writes a finished line to standard error, which is not buffered, so a line survives the SIGKILL that ends a run
/// (CeeSafe has no Console.flush: CEESAFE_GAPS G25).
fn soakEmit(line: borrow mut String) {
    Console.writeErrorLine(line.view());
    line.clear();
}

/// `cosmostore soak <dir> <seconds> <keys> <capacity-bytes>`; exit status 1 if the store ever disagrees with the
/// model, fails fsck, or stops accepting writes for good.
fn soak() -> i32 {
    let dir = Process.argument(2) ?? "";
    if (dir.length == 0) { usage(); }
    var line = String.create();
    let seconds = argU64(3);
    let keys = argU64(4);
    let capacity = argU64(5);
    if (keys == 0) { usage(); }
    var config = StoreConfig.defaults();
    config.capacityBytes = capacity;
    config.reserveBytes = if (capacity == 0) 0 else capacity / 8;
    config.checkpointEveryBytes = 64 * 1048576;
    let openStart = elapsedMillis();
    var store = match (ObjectStore.open(dir, config)) {
        Ok(s) => s,
        Err(e) => {
            line.append("FAIL open: ")!;
            line.append(describe(e))!;
            soakEmit(mut line);
            return 1;
        }
    };
    let openMillis = elapsedMillis() - openStart;
    match (store.createBucket("soak")) {
        Ok() => {}
        Err(StoreError.BucketAlreadyExists) => {}
        Err(e) => {
            line.append("FAIL bucket: ")!;
            line.append(describe(e))!;
            soakEmit(mut line);
            return 1;
        }
    }
    var logPath = String.create();
    logPath.append(dir)!;
    logPath.append("/soak.log")!;
    var model = Vector<KeyState>.create();
    model.resize(keys as usize, KeyState { seed: 0, size: 0 })!;
    var soak = Soak {
        model: model,
        log: DurableFile.openReadWrite(logPath.view())!,
        logEnd: 0,
        keys: keys,
        rng: 1,
        operations: 0,
        refused: 0,
        checkpoints: 0,
        compacted: 0,
    };
    var pending = KeyState { seed: 0, size: 0 };
    var pendingKey: u64 = 0;
    soakReplay(mut soak, mut pending, mut pendingKey);
    // The store against the model: acked state everywhere, or the in-flight operation's for its key.
    var name = String.create();
    var buffer = Vector<u8>.create();
    let verifyStart = elapsedMillis();
    var bad: u64 = 0;
    for (k in 0..keys) {
        let acked = soak.model[k as usize];
        if (soakHolds(borrow store, k, borrow acked, mut name, mut buffer)) { continue; }
        if (k == pendingKey && soakHolds(borrow store, k, borrow pending, mut name, mut buffer)) {
            // The in-flight operation had reached the disk. The log records that, so a later replay, where other
            // acks follow this intent, still knows it.
            soak.model[k as usize] = pending;
            soak.append(k, if (pending.seed == 0) SOAK_DELETE else SOAK_PUT, pending.seed, pending.size);
            continue;
        }
        bad += 1;
        line.append("FAIL key ")!;
        line.appendNumber(k)!;
        line.append(" does not hold its acknowledged state: acked seed ")!;
        line.appendNumber(acked.seed)!;
        line.append(" size ")!;
        line.appendNumber(acked.size)!;
        line.append(if (k == pendingKey) ", in flight seed " else ", nothing in flight")!;
        if (k == pendingKey) {
            line.appendNumber(pending.seed)!;
            line.append(" size ")!;
            line.appendNumber(pending.size)!;
        }
        soakKeyName(mut name, k);
        match (store.getObject("soak", name.view())) {
            Ok(got) => {
                line.append("; the store has ")!;
                line.appendNumber(got.length)!;
                line.append(" bytes")!;
            }
            Err(e) => {
                line.append("; the store says ")!;
                line.append(describe(e))!;
            }
        }
        soakEmit(mut line);
    }
    soak.compactLog(dir);
    let report = store.verify()!;
    line.append("start: recovery ")!;
    line.appendNumber(openMillis)!;
    soakLine(mut line, " ms, model check ", truncate<u64>(elapsedMillis() - verifyStart));
    soakLine(mut line, " ms, operations so far ", soak.operations);
    soakLine(mut line, ", objects ", report.objects);
    soakLine(mut line, ", fsck problems ", report.problems.length as u64);
    soakLine(mut line, ", used ", store.usedBytes());
    soakLine(mut line, ", live ", soak.liveBytes());
    line.append("")!;
    soakEmit(mut line);
    if (bad > 0 || report.problems.length > 0) { return 1; }
    // The churn.
    let start = elapsedMillis();
    var lastReport = start;
    var refusedRun: u64 = 0;
    var rng = soak.rng.wrappingMul(0x2545F4914F6CDD1D) | 1;
    while (elapsedMillis() - start < saturatingTruncate<i64>(seconds * 1000)) {
        let r = soakNext(mut rng);
        let k = r % keys;
        soakKeyName(mut name, k);
        let choice = (r >> 32) % 100;
        if (choice < 60) {
            let seed = soakNext(mut rng) | 1;
            let size = soakSize(soakNext(mut rng));
            soakBytes(seed, size, mut buffer);
            soak.append(k, SOAK_PUT | SOAK_INTENT, seed, size);
            match (store.putObject("soak", name.view(), "", buffer.view(), PutCondition.None)) {
                Ok(_) => {
                    soak.append(k, SOAK_PUT, seed, size);
                    soak.model[k as usize] = KeyState { seed: seed, size: size };
                    refusedRun = 0;
                }
                Err(StoreError.InsufficientStorage) => {
                    // Refused before anything was written: the key keeps its acked state.
                    soak.append(
                        k,
                        if (soak.model[k as usize].seed == 0) SOAK_DELETE else SOAK_PUT,
                        soak.model[k as usize].seed,
                        soak.model[k as usize].size,
                    );
                    soak.refused += 1;
                    refusedRun += 1;
                    if (refusedRun > 100000) {
                        line.append("FAIL writes refused 100,000 times in a row: the store does not free space")!;
                        soakEmit(mut line);
                        return 1;
                    }
                }
                Err(e) => {
                    line.append("FAIL put: ")!;
                    line.append(describe(e))!;
                    soakEmit(mut line);
                    return 1;
                }
            }
        } else if (choice < 85) {
            soak.append(k, SOAK_DELETE | SOAK_INTENT, 0, 0);
            match (store.deleteObject("soak", name.view())) {
                Ok() => {
                    soak.append(k, SOAK_DELETE, 0, 0);
                    soak.model[k as usize] = KeyState { seed: 0, size: 0 };
                }
                Err(e) => {
                    line.append("FAIL delete: ")!;
                    line.append(describe(e))!;
                    soakEmit(mut line);
                    return 1;
                }
            }
        } else {
            let state = soak.model[k as usize];
            if (!soakHolds(borrow store, k, borrow state, mut name, mut buffer)) {
                line.append("FAIL key ")!;
                line.appendNumber(k)!;
                line.append(" reads back wrong")!;
                soakEmit(mut line);
                return 1;
            }
        }
        soak.operations += 1;
        if (soak.logEnd > 67108864) { soak.compactLog(dir); }
        if (soak.operations % 256 == 0) {
            match (store.maintain()) {
                Ok(m) => {
                    if (m.checkpointed) { soak.checkpoints += 1; }
                    soak.compacted += m.compaction.segmentsRemoved;
                }
                Err(e) => {
                    line.append("FAIL maintain: ")!;
                    line.append(describe(e))!;
                    soakEmit(mut line);
                    return 1;
                }
            }
        }
        let now = elapsedMillis();
        if (now - lastReport >= 60000) {
            lastReport = now;
            let live = soak.liveBytes();
            let used = store.usedBytes();
            soakLine(mut line, "t ", truncate<u64>((now - start) / 1000));
            soakLine(mut line, " s, ops ", soak.operations);
            soakLine(mut line, ", live ", live);
            soakLine(mut line, ", used ", used);
            soakLine(mut line, ", ratio% ", if (live == 0) 0 else used * 100 / live);
            soakLine(mut line, ", segments ", store.segmentCount() as u64);
            soakLine(mut line, ", objects ", store.objectCount() as u64);
            soakLine(mut line, ", refused ", soak.refused);
            soakLine(mut line, ", checkpoints ", soak.checkpoints);
            soakLine(mut line, ", compacted ", soak.compacted);
            line.append("")!;
            soakEmit(mut line);
        }
    }
    line.append("done")!;
    soakEmit(mut line);
    return 0;
}
