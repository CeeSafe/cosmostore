// SHA-1 (FIPS 180-4): S3's `x-amz-checksum-sha1` (ADR-0090 §4). lib/std has SHA-256 but not SHA-1 (CEESAFE_GAPS G26),
// so it is computed here in plain CeeSafe, as CRC-32 is, and checked against FIPS 180's vectors.

struct Sha1 {
    private h: [u32; 5];
    private block: [u8; 64];
    private filled: usize;
    private total: u64;

    fn create() -> Sha1 => Sha1 {
        h: [0x67452301u32, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0],
        block: [0u8; 64],
        filled: 0,
        total: 0,
    };

    fn update(borrow mut this, bytes: Slice<u8>) {
        for (i in 0..bytes.length) {
            this.block[this.filled] = bytes[i];
            this.filled += 1;
            if (this.filled == 64) {
                this.compress();
                this.filled = 0;
            }
        }
        this.total = this.total.wrappingAdd(bytes.length as u64);
    }

    fn finish(borrow mut this) -> [u8; 20] {
        let bits = this.total.wrappingMul(8);
        this.block[this.filled] = 0x80;
        this.filled += 1;
        if (this.filled > 56) {
            while (this.filled < 64) {
                this.block[this.filled] = 0;
                this.filled += 1;
            }
            this.compress();
            this.filled = 0;
        }
        while (this.filled < 56) {
            this.block[this.filled] = 0;
            this.filled += 1;
        }
        for (k in 0..8) { this.block[56 + k] = truncate<u8>(bits >> ((7 - k) * 8) as u64); }
        this.compress();
        var out = [0u8; 20];
        for (i in 0..5) {
            out[i * 4] = truncate<u8>(this.h[i] >> 24);
            out[i * 4 + 1] = truncate<u8>(this.h[i] >> 16);
            out[i * 4 + 2] = truncate<u8>(this.h[i] >> 8);
            out[i * 4 + 3] = truncate<u8>(this.h[i]);
        }
        return out;
    }

    fn of(bytes: Slice<u8>) -> [u8; 20] {
        var s = Sha1.create();
        s.update(bytes);
        return s.finish();
    }

    private fn compress(borrow mut this) {
        var w = [0u32; 80];
        for (t in 0..16) {
            w[t] = (this.block[t * 4] as u32 << 24) | (this.block[t * 4 + 1] as u32 << 16) |
                (this.block[t * 4 + 2] as u32 << 8) | (this.block[t * 4 + 3] as u32);
        }
        for (t in 16..80) { w[t] = rotl1(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1); }
        var a = this.h[0];
        var b = this.h[1];
        var c = this.h[2];
        var d = this.h[3];
        var e = this.h[4];
        for (t in 0..80) {
            let f = if (t < 20) (b & c) | ((b ^ 0xFFFFFFFF) & d) else if (t < 40) b ^ c ^ d
                else if (t < 60) (b & c) | (b & d) | (c & d) else b ^ c ^ d;
            let k: u32 = if (t < 20) 0x5A827999 else if (t < 40) 0x6ED9EBA1 else if (t < 60) 0x8F1BBCDC else 0xCA62C1D6;
            let temp = rotl1(a, 5).wrappingAdd(f).wrappingAdd(e).wrappingAdd(k).wrappingAdd(w[t]);
            e = d;
            d = c;
            c = rotl1(b, 30);
            b = a;
            a = temp;
        }
        this.h[0] = this.h[0].wrappingAdd(a);
        this.h[1] = this.h[1].wrappingAdd(b);
        this.h[2] = this.h[2].wrappingAdd(c);
        this.h[3] = this.h[3].wrappingAdd(d);
        this.h[4] = this.h[4].wrappingAdd(e);
    }
}

/// `x` rotated left by `n` (1 to 31) bits.
fn rotl1(x: u32, n: u32) -> u32 => (x << n) | (x >> (32 - n));

/// FIPS 180's vectors: "abc", the empty message, the two-block one, and a million `a`s fed in pieces.
@test
fn sha1MatchesFips180() -> Result<void, TestFailure> {
    Check.equalBytes(hexBytes("a9993e364706816aba3e25717850c26c9cd0d89d").view(), Sha1.of("abc".bytes())[..])?;
    Check.equalBytes(hexBytes("da39a3ee5e6b4b0d3255bfef95601890afd80709").view(), Sha1.of("".bytes())[..])?;
    Check.equalBytes(
        hexBytes("84983e441c3bd26ebaae4aa1f95129e5e54670f1").view(),
        Sha1.of("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes())[..],
    )?;
    var s = Sha1.create();
    let chunk = [0x61u8; 1000];
    for (i in 0..1000) { s.update(chunk[..]); }
    Check.equalBytes(hexBytes("34aa973cd4c4daa4f61eeb2bdbad27316534016f").view(), s.finish()[..])?;
    return Ok();
}

fn hexBytes(text: StringView) -> Vector<u8> {
    var out = Vector<u8>.create();
    let t = text.bytes();
    var i: usize = 0;
    while (i + 1 < t.length) {
        let hi = if (t[i] >= 'a') t[i] - 'a' + 10 else t[i] - '0';
        let lo = if (t[i + 1] >= 'a') t[i + 1] - 'a' + 10 else t[i + 1] - '0';
        out.push(hi * 16 + lo)!;
        i += 2;
    }
    return out;
}

/// The padding's edges (the M12 exit review's C3): messages of 55, 56, 63, 64 and 65 bytes, whose length field fits
/// in the last block or needs another; digests from Python's hashlib.
@test
fn sha1PadsAtEveryEdge() -> Result<void, TestFailure> {
    let wants = [
        "c1c8bbdc22796e28c0e15163d20899b65621d65a",
        "c2db330f6083854c99d4b5bfb6e8f29f201be699",
        "03f09f5b158a7a8cdad920bddc29b81c18a551f5",
        "0098ba824b5c16427bd7a1122a5a442a25ec644d",
        "11655326c708d70319be2610e8a57d9a5b959d3b",
    ];
    let lengths = [55usize, 56, 63, 64, 65];
    for (i in 0..5) {
        var message = Vector<u8>.create();
        message.resize(lengths[i], 'a')!;
        Check.equalBytes(hexBytes(wants[i]).view(), Sha1.of(message.view())[..])?;
    }
    return Ok();
}
