// CRC32C (Castagnoli), the checksum of every journal record (ADR-001).
// Slicing-by-8 over the tables in crc32c_tables.cee. A hardware (SSE4.2 / ARMv8 CRC)
// path is future work: see CEESAFE_GAPS.md G9.

/// A running CRC32C.
struct Crc32c {
    private state: u32;

    fn create() -> Crc32c => Crc32c { state: 0xFFFFFFFF };

    /// Feeds `data`.
    fn update(borrow mut this, data: Slice<u8>) {
        var c = this.state;
        var i: usize = 0;
        let n = data.length;
        while (i + 8 <= n) {
            let lo = c ^ data.readLE<u32>(i);
            let hi = data.readLE<u32>(i + 4);
            c = CRC32C_TABLE[7 * 256 + (lo & 0xFF) as usize] ^
                CRC32C_TABLE[6 * 256 + ((lo >> 8) & 0xFF) as usize] ^
                CRC32C_TABLE[5 * 256 + ((lo >> 16) & 0xFF) as usize] ^
                CRC32C_TABLE[4 * 256 + (lo >> 24) as usize] ^
                CRC32C_TABLE[3 * 256 + (hi & 0xFF) as usize] ^
                CRC32C_TABLE[2 * 256 + ((hi >> 8) & 0xFF) as usize] ^
                CRC32C_TABLE[1 * 256 + ((hi >> 16) & 0xFF) as usize] ^
                CRC32C_TABLE[(hi >> 24) as usize];
            i += 8;
        }
        while (i < n) {
            c = CRC32C_TABLE[((c ^ data[i] as u32) & 0xFF) as usize] ^ (c >> 8);
            i += 1;
        }
        this.state = c;
    }

    /// The checksum of everything fed so far.
    fn value(borrow this) -> u32 => this.state ^ 0xFFFFFFFF;

    /// The checksum of `data` in one call.
    fn of(data: Slice<u8>) -> u32 {
        var c = Crc32c.create();
        c.update(data);
        return c.value();
    }
}

@test
fn crc32cKnownVectors() -> Result<void, TestFailure> {
    // RFC 3720 §B.4 vectors and the classic check value (oracle: tools/gen_crc32c.py's bitwise CRC).
    let check = "123456789";
    Check.equalU64(0xE3069283, Crc32c.of(check.bytes()) as u64)?;
    let zeros = [0u8; 32];
    Check.equalU64(0x8A9136AA, Crc32c.of(zeros[..]) as u64)?;
    let ones = [0xFFu8; 32];
    Check.equalU64(0x62A8AB43, Crc32c.of(ones[..]) as u64)?;
    var inc = [0u8; 32];
    for (i in 0..inc.length) { inc[i] = truncate<u8>(i); }
    Check.equalU64(0x46DD794E, Crc32c.of(inc[..]) as u64)?;
    Check.equalU64(0, Crc32c.of(zeros[0..0]) as u64)?;
    return Ok();
}

@test
fn crc32cStreamingMatchesOneShot() -> Result<void, TestFailure> {
    var data = [0u8; 1000];
    for (i in 0..data.length) { data[i] = truncate<u8>(i * 31 + 7); }
    let whole = Crc32c.of(data[..]);
    for (split in 0..data.length) {
        var c = Crc32c.create();
        c.update(data[..split]);
        c.update(data[split..]);
        Check.equalU64(whole as u64, c.value() as u64)?;
    }
    return Ok();
}
