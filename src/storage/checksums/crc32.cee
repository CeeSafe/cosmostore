// The big-endian bytes of the CRCs, as S3 base64-encodes them. CRC-32 itself (IEEE 802.3, the AWS CLI's default
// `x-amz-checksum-crc32`) is lib/std's `Crc32` since ceesafec 0.87.0, on the CPU's CRC instructions (CeeSafe ADR 0194,
// CEESAFE_GAPS G26); CosmoStore's own, a byte at a time, is gone.

/// The big-endian bytes of a CRC, as S3 base64-encodes it.
fn crc32Bytes(v: u32) -> [u8; 4] =>
    [truncate<u8>(v >> 24), truncate<u8>(v >> 16), truncate<u8>(v >> 8), truncate<u8>(v)];

fn crc64Bytes(v: u64) -> [u8; 8] => [
    truncate<u8>(v >> 56),
    truncate<u8>(v >> 48),
    truncate<u8>(v >> 40),
    truncate<u8>(v >> 32),
    truncate<u8>(v >> 24),
    truncate<u8>(v >> 16),
    truncate<u8>(v >> 8),
    truncate<u8>(v),
];
