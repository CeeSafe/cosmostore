// MD5 (RFC 1321), for S3 ETags and Content-MD5 only. Never used for integrity: records use CRC32C.

const MD5_S: [u32; 64] = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
];

const MD5_K: [u32; 64] = [
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
];

/// A running MD5.
struct Md5 {
    private a: u32;
    private b: u32;
    private c: u32;
    private d: u32;
    private block: [u8; 64];
    private used: usize;
    private total: u64;

    fn create() -> Md5 => Md5 {
        a: 0x67452301,
        b: 0xefcdab89,
        c: 0x98badcfe,
        d: 0x10325476,
        block: [0u8; 64],
        used: 0,
        total: 0,
    };

    fn update(borrow mut this, data: Slice<u8>) {
        this.total += data.length as u64;
        var i: usize = 0;
        if (this.used > 0) {
            while (this.used < 64 && i < data.length) {
                this.block[this.used] = data[i];
                this.used += 1;
                i += 1;
            }
            if (this.used < 64) { return; }
            let full = this.block;
            this.compress(full[..]);
            this.used = 0;
        }
        while (i + 64 <= data.length) {
            this.compress(data[i..i + 64]);
            i += 64;
        }
        while (i < data.length) {
            this.block[this.used] = data[i];
            this.used += 1;
            i += 1;
        }
    }

    /// The 16-byte digest; the hasher is spent.
    fn finish(this) -> [u8; 16] {
        var h = this;
        let bits = h.total * 8;
        let pad = [0x80u8];
        h.update(pad[..]);
        let zero = [0u8; 64];
        let fill = if (h.used <= 56) 56 - h.used else 120 - h.used;
        h.update(zero[0..fill]);
        var length = [0u8; 8];
        {
            let w = borrow mut length[..];
            w.writeLE(0, bits);
        }
        h.update(length[..]);
        var out = [0u8; 16];
        {
            let w = borrow mut out[..];
            w.writeLE(0, h.a);
            w.writeLE(4, h.b);
            w.writeLE(8, h.c);
            w.writeLE(12, h.d);
        }
        return out;
    }

    fn compress(borrow mut this, chunk: Slice<u8>) {
        var m = [0u32; 16];
        for (i in 0..16) { m[i] = chunk.readLE<u32>(i * 4); }
        var a = this.a;
        var b = this.b;
        var c = this.c;
        var d = this.d;
        for (i in 0..64) {
            var f: u32 = 0;
            var g: usize = 0;
            if (i < 16) {
                f = (b & c) | ((b ^ 0xFFFFFFFF) & d);
                g = i;
            } else if (i < 32) {
                f = (d & b) | ((d ^ 0xFFFFFFFF) & c);
                g = (5 * i + 1) % 16;
            } else if (i < 48) {
                f = b ^ c ^ d;
                g = (3 * i + 5) % 16;
            } else {
                f = c ^ (b | (d ^ 0xFFFFFFFF));
                g = (7 * i) % 16;
            }
            let sum = a.wrappingAdd(f).wrappingAdd(MD5_K[i]).wrappingAdd(m[g]);
            a = d;
            d = c;
            c = b;
            b = b.wrappingAdd(rotateLeft32(sum, MD5_S[i]));
        }
        this.a = this.a.wrappingAdd(a);
        this.b = this.b.wrappingAdd(b);
        this.c = this.c.wrappingAdd(c);
        this.d = this.d.wrappingAdd(d);
    }

    fn of(data: Slice<u8>) -> [u8; 16] {
        var h = Md5.create();
        h.update(data);
        return h.finish();
    }
}

fn rotateLeft32(x: u32, n: u32) -> u32 => (x << n) | (x >> (32 - n));

/// Lower-case hex of `bytes` appended to `out`.
fn appendHex(out: borrow mut String, bytes: Slice<u8>) -> Result<void, AllocError> {
    let digits = "0123456789abcdef";
    for (i in 0..bytes.length) {
        var pair = [0u8; 2];
        pair[0] = digits.bytes()[(bytes[i] >> 4) as usize];
        pair[1] = digits.bytes()[(bytes[i] & 0xF) as usize];
        out.append(StringView.fromUtf8(pair[..])!)?;
    }
    return Ok();
}

fn md5Hex(data: Slice<u8>) -> String {
    let d = Md5.of(data);
    var s = String.create();
    appendHex(mut s, d[..])!;
    return s;
}

@test
fn md5Rfc1321Vectors() -> Result<void, TestFailure> {
    // RFC 1321 §A.5 test suite.
    let empty = "";
    Check.equalText("d41d8cd98f00b204e9800998ecf8427e", md5Hex(empty.bytes()).view())?;
    let a = "a";
    Check.equalText("0cc175b9c0f1b6a831c399e269772661", md5Hex(a.bytes()).view())?;
    let abc = "abc";
    Check.equalText("900150983cd24fb0d6963f7d28e17f72", md5Hex(abc.bytes()).view())?;
    let digest = "message digest";
    Check.equalText("f96b697d7cb7938d525a2f31aaf161d0", md5Hex(digest.bytes()).view())?;
    let alpha = "abcdefghijklmnopqrstuvwxyz";
    Check.equalText("c3fcd3d76192e4007dfb496cca67e13b", md5Hex(alpha.bytes()).view())?;
    let mixed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
    Check.equalText("d174ab98d277d9f5a5611c2c9f419d9f", md5Hex(mixed.bytes()).view())?;
    let digits = "12345678901234567890123456789012345678901234567890123456789012345678901234567890";
    Check.equalText("57edf4a22be3c955ac49da2e2107b67a", md5Hex(digits.bytes()).view())?;
    return Ok();
}

@test
fn md5StreamingMatchesOneShot() -> Result<void, TestFailure> {
    var data = [0u8; 300];
    for (i in 0..data.length) { data[i] = truncate<u8>(i * 7); }
    let whole = Md5.of(data[..]);
    for (split in 0..data.length) {
        var h = Md5.create();
        h.update(data[..split]);
        h.update(data[split..]);
        let d = h.finish();
        Check.equalBytes(whole[..], d[..])?;
    }
    return Ok();
}
