// CRC32C and MD5 are lib/std's (CeeSafe 0.19, ADR 0075 §2.5). These tests pin the values CosmoStore's on-disk
// formats depend on (journal records, segment, extent and checkpoint headers, ETags), so a library change that
// altered them would fail here first.

/// Lower-case hex of `bytes` appended to `out`.
fn appendHex(out: borrow mut String, bytes: Slice<u8>) -> Result<void, AllocError> {
    let digits = "0123456789abcdef";
    for (i in 0..bytes.length) {
        var pair = [0u8; 2];
        pair[0] = digits.bytes()[(bytes[i] >> 4) as usize];
        pair[1] = digits.bytes()[(bytes[i] & 0xF) as usize];
        out.append(StringView.fromUtf8(pair[..])!)?;
    }
    return Ok();
}

fn md5Hex(data: Slice<u8>) -> String {
    let d = Md5.of(data);
    var s = String.create();
    appendHex(mut s, d[..])!;
    return s;
}

@test
fn crc32cKnownVectors() -> Result<void, TestFailure> {
    // RFC 3720 §B.4 vectors and the classic check value.
    let check = "123456789";
    Check.equalU64(0xE3069283, Crc32c.of(check.bytes()) as u64)?;
    let zeros = [0u8; 32];
    Check.equalU64(0x8A9136AA, Crc32c.of(zeros[..]) as u64)?;
    let ones = [0xFFu8; 32];
    Check.equalU64(0x62A8AB43, Crc32c.of(ones[..]) as u64)?;
    var inc = [0u8; 32];
    for (i in 0..inc.length) { inc[i] = truncate<u8>(i); }
    Check.equalU64(0x46DD794E, Crc32c.of(inc[..]) as u64)?;
    Check.equalU64(0, Crc32c.of([]) as u64)?;
    return Ok();
}

@test
fn crc32cStreamingMatchesOneShot() -> Result<void, TestFailure> {
    var data = [0u8; 1000];
    for (i in 0..data.length) { data[i] = truncate<u8>(i * 31 + 7); }
    let whole = Crc32c.of(data[..]);
    for (split in 0..data.length) {
        var c = Crc32c.create();
        c.update(data[..split]);
        c.update(data[split..]);
        Check.equalU64(whole as u64, c.finish() as u64)?;
    }
    return Ok();
}

@test
fn md5Rfc1321Vectors() -> Result<void, TestFailure> {
    // RFC 1321 §A.5 test suite.
    Check.equalText("d41d8cd98f00b204e9800998ecf8427e", md5Hex("".bytes()).view())?;
    Check.equalText("0cc175b9c0f1b6a831c399e269772661", md5Hex("a".bytes()).view())?;
    Check.equalText("900150983cd24fb0d6963f7d28e17f72", md5Hex("abc".bytes()).view())?;
    Check.equalText("f96b697d7cb7938d525a2f31aaf161d0", md5Hex("message digest".bytes()).view())?;
    Check.equalText("c3fcd3d76192e4007dfb496cca67e13b", md5Hex("abcdefghijklmnopqrstuvwxyz".bytes()).view())?;
    let mixed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
    Check.equalText("d174ab98d277d9f5a5611c2c9f419d9f", md5Hex(mixed.bytes()).view())?;
    let digits = "12345678901234567890123456789012345678901234567890123456789012345678901234567890";
    Check.equalText("57edf4a22be3c955ac49da2e2107b67a", md5Hex(digits.bytes()).view())?;
    return Ok();
}
