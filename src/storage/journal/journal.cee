// The per-shard journal: the single write-ahead log and the home of small payloads (ADR-001).
//
// A journal is a directory of segment files `seg-<16 hex digits>.cj`. Records are appended to
// the newest segment. Callers stage records, then `commit` writes the batch with one positional
// write and one data sync. Only after `commit` returns Ok may a caller publish or acknowledge
// any record of the batch.
//
// Recovery invariants:
// - Sealed segments (every segment but the newest) were fully synced before the next one was
//   created, so any invalid record in one is corruption: opening fails.
// - The newest segment may end in a torn batch. A batch is written only after the previous
//   batch's sync succeeded, and a batch is at most `maxBatchBytes`. So if the first invalid
//   record is at X, every valid record at or after X + maxBatchBytes belongs to a later,
//   acknowledged batch: that is corruption, and opening fails. Otherwise the tail from X is
//   unacknowledged and is truncated.
// - A failed write or sync puts the journal in the failed state: nothing more is accepted
//   until it is reopened, because after a failed fsync the OS may have dropped dirty pages.

const SEGMENT_MAGIC: u64 = 0x31304745534A5343; // "CSJSEG01" in file order
const SEGMENT_HEADER_LEN: usize = 64;
const SEGMENT_FORMAT_VERSION: u16 = 1;

struct JournalConfig {
    /// A segment is sealed and a new one started once it reaches this size.
    segmentTargetBytes: u64;
    /// The most bytes one commit writes; also the torn-tail window of recovery.
    maxBatchBytes: usize;
    shardId: u32;

    fn defaults() -> JournalConfig => JournalConfig {
        segmentTargetBytes: 134217728,
        maxBatchBytes: 33554432,
        shardId: 0,
    };
}

enum JournalError {
    @from Io(IoFailure),
    @from OutOfMemory(AllocError),
    /// An invalid record where only valid ones may be: (segment id, offset).
    Corrupt(u64, u64),
    BadSegmentHeader(u64),
    /// A record larger than MAX_RECORD_LEN, or a batch larger than maxBatchBytes.
    TooLarge,
    /// A previous write or sync failed; reopen the journal.
    Failed,
    /// Recovery from a checkpoint needs this segment, and it is missing.
    MissingSegment(u64),
    /// The active segment cannot be removed.
    ActiveSegment,
}

/// Where recovery starts. Segments before `segment` are covered by a checkpoint whose last LSN
/// is `lsn` (ADR-0005). They are not scanned, and are kept only for the inline payloads that
/// live versions still point to.
struct JournalStart {
    segment: u64;
    lsn: u64;

    /// No checkpoint: scan everything.
    fn beginning() -> JournalStart => JournalStart { segment: 0, lsn: 0 };
}

/// A sealed segment that recovery did not scan, and its size.
struct SegmentFile {
    id: u64;
    size: u64;
}

/// Where a staged record will be: its segment, its offset there, and its LSN.
struct RecordPosition {
    segmentId: u64;
    offset: u64;
    lsn: u64;
}

/// The bytes of a payload inside a segment.
struct PayloadLocator {
    segmentId: u64;
    offset: u64;
    length: u32;
}

/// A batch written but not yet durable (`Journal.writeStaged`): its own handle of the segment,
/// so the sync can run on a worker thread without the journal.
struct SyncTicket {
    private file: DurableFile;
    lastLsn: u64;

    /// Makes the batch durable (F_FULLFSYNC on macOS). Pass the result to `finishSync`.
    fn sync(borrow this) -> Result<void, IoFailure> => this.file.syncData();
}

struct Journal {
    private dir: String;
    private file: DurableFile;
    private segmentId: u64;
    /// The end of the last durable batch in the active segment.
    private writeOffset: u64;
    /// The end of the bytes written to the active segment: `writeOffset`, plus the batch in flight.
    private writtenEnd: u64;
    /// A batch written by `writeStaged` whose sync has not finished: its last LSN, records and end.
    private inflight: bool;
    private inflightLast: u64;
    private inflightCount: u32;
    private inflightEnd: u64;
    private nextLsn: u64;
    private pending: Vector<u8>;
    private pendingCount: u32;
    private failed: bool;
    private config: JournalConfig;
    /// Stats: data syncs performed and records committed.
    private syncs: u64;
    private committed: u64;
    /// Sealed segments that recovery skipped (before the checkpoint's segment), with sizes.
    private unscanned: Vector<SegmentFile>;
    /// Read handles of sealed segments, so a GET of an inline object does not open a file.
    /// A cache: a segment missing from it is opened per read.
    private sealedFiles: HashMap<u64, DurableFile>;

    /// Opens (or creates) the journal in `dir`, replaying every valid record through `visit`
    /// in LSN order: visit(segment id, record offset, header, whole record bytes).
    fn open(
        dir: StringView,
        config: JournalConfig,
        visit: borrow mut fn(u64, u64, borrow RecordHeader, Slice<u8>),
    ) -> Result<Journal, JournalError> => Journal.openFrom(dir, config, JournalStart.beginning(), visit);

    /// Opens the journal, replaying only the records after `start` (ADR-0005). The segment
    /// `start.segment` must exist, and its records must follow `start.lsn`.
    fn openFrom(
        dir: StringView,
        config: JournalConfig,
        start: JournalStart,
        visit: borrow mut fn(u64, u64, borrow RecordHeader, Slice<u8>),
    ) -> Result<Journal, JournalError> {
        Fs.ensureDirectory(dir)?;
        var ids = listSegmentIds(dir)?;
        var nextLsn: u64 = start.lsn + 1;
        var buffer = Vector<u8>.create();
        var unscanned = Vector<SegmentFile>.create();
        var sealedFiles = HashMap<u64, DurableFile>.create();
        if (ids.length == 0) {
            if (start.segment > 0) { return Err(JournalError.MissingSegment(start.segment)); }
            let first = Journal.createSegment(dir, 1, nextLsn, config.shardId)?;
            return Ok(Journal.make(dir, first, 1, SEGMENT_HEADER_LEN as u64, nextLsn, config, unscanned, sealedFiles)?);
        }
        var scanning = false;
        for (i in 0..ids.length) {
            let id = ids[i];
            let last = i + 1 == ids.length;
            let path = segmentPath(dir, id)?;
            if (id < start.segment) {
                if (last) { return Err(JournalError.MissingSegment(start.segment)); }
                let sealed = DurableFile.openRead(path.view())?;
                unscanned.push(SegmentFile { id: id, size: sealed.size()? })?;
                let _ = sealedFiles.put(id, sealed)?;
                continue;
            }
            if (!scanning && start.segment > 0 && id != start.segment) {
                return Err(JournalError.MissingSegment(start.segment));
            }
            scanning = true;
            let file = DurableFile.openReadWrite(path.view())?;
            let size = file.size()?;
            let headerOk = readSegmentHeader(borrow file, size, id)?;
            if (!headerOk) {
                if (!last) { return Err(JournalError.BadSegmentHeader(id)); }
                // The newest segment's creation was torn: start it again.
                file.truncateTo(0)?;
                writeSegmentHeader(borrow file, id, nextLsn, config.shardId)?;
                file.syncData()?;
                return Ok(
                    Journal.make(dir, file, id, SEGMENT_HEADER_LEN as u64, nextLsn, config, unscanned, sealedFiles)?,
                );
            }
            let end = scanSegment(borrow file, id, size, last, config.maxBatchBytes, mut nextLsn, mut buffer, visit)?;
            if (last) {
                if (end != size) {
                    file.truncateTo(end)?;
                    file.syncData()?;
                }
                return Ok(Journal.make(dir, file, id, end, nextLsn, config, unscanned, sealedFiles)?);
            }
            let _ = sealedFiles.put(id, file)?;
        }
        return Err(JournalError.Corrupt(0, 0)); // unreachable: the loop returns on the last segment
    }

    fn make(
        dir: StringView,
        file: DurableFile,
        segmentId: u64,
        writeOffset: u64,
        nextLsn: u64,
        config: JournalConfig,
        unscanned: Vector<SegmentFile>,
        sealedFiles: HashMap<u64, DurableFile>,
    ) -> Result<Journal, JournalError> {
        var d = String.create();
        d.append(dir)?;
        return Ok(Journal {
            dir: d,
            file: file,
            segmentId: segmentId,
            writeOffset: writeOffset,
            writtenEnd: writeOffset,
            inflight: false,
            inflightLast: 0,
            inflightCount: 0,
            inflightEnd: writeOffset,
            nextLsn: nextLsn,
            pending: Vector<u8>.create(),
            pendingCount: 0,
            failed: false,
            config: config,
            syncs: 0,
            committed: 0,
            unscanned: unscanned,
            sealedFiles: sealedFiles,
        });
    }

    /// Creates segment `id` with its header, durably (file and directory entry).
    fn createSegment(dir: StringView, id: u64, firstLsn: u64, shardId: u32) -> Result<DurableFile, JournalError> {
        let path = segmentPath(dir, id)?;
        let file = DurableFile.createNew(path.view())?;
        writeSegmentHeader(borrow file, id, firstLsn, shardId)?;
        file.syncData()?;
        Fs.syncDirectory(dir)?;
        return Ok(file);
    }

    /// The LSN the next staged record gets.
    fn upcomingLsn(borrow this) -> u64 => this.nextLsn;

    /// Records staged and not yet committed.
    fn pendingRecords(borrow this) -> u32 => this.pendingCount;

    /// Bytes staged and not yet committed.
    fn pendingBytes(borrow this) -> usize => this.pending.length;

    fn syncCount(borrow this) -> u64 => this.syncs;

    /// Whether a write, sync or rotation failed; the journal refuses records until reopened.
    fn isFailed(borrow this) -> bool => this.failed;

    fn committedCount(borrow this) -> u64 => this.committed;

    fn activeSegment(borrow this) -> u64 => this.segmentId;

    /// Adds a record to the current batch. It is not durable until `commit` returns Ok.
    fn stage(
        borrow mut this,
        kind: RecordType,
        meta: Slice<u8>,
        payload: Slice<u8>,
    ) -> Result<RecordPosition, JournalError> {
        if (this.failed) { return Err(JournalError.Failed); }
        let length = recordLength(meta.length, payload.length);
        if (length > MAX_RECORD_LEN) { return Err(JournalError.TooLarge); }
        if (this.pending.length + length > this.config.maxBatchBytes) { return Err(JournalError.TooLarge); }
        let position = RecordPosition {
            segmentId: this.segmentId,
            offset: this.writtenEnd + this.pending.length as u64,
            lsn: this.nextLsn,
        };
        encodeRecord(mut this.pending, kind, 0, this.nextLsn, 0, meta, payload)?;
        this.nextLsn += 1;
        this.pendingCount += 1;
        return Ok(position);
    }

    /// Whether staging `metaLen` + `payloadLen` more bytes would overflow the batch.
    fn wouldOverflow(borrow this, metaLen: usize, payloadLen: usize) -> bool =>
        this.pending.length + recordLength(metaLen, payloadLen) > this.config.maxBatchBytes;

    /// Whether the active segment is full, so the next commit with nothing in flight rotates it.
    fn needsRotation(borrow this) -> bool => this.writtenEnd >= this.config.segmentTargetBytes;

    /// Whether a batch written by `writeStaged` is waiting for its sync.
    fn hasInflight(borrow this) -> bool => this.inflight;

    /// Makes every staged record durable with one write and one sync, together with a batch in
    /// flight (`writeStaged`), then rotates the segment if it is full. On error the journal is
    /// failed; the batch may or may not have reached the disk, and must not be published.
    fn commit(borrow mut this) -> Result<void, JournalError> {
        if (this.failed) { return Err(JournalError.Failed); }
        if (this.pendingCount == 0 && !this.inflight) { return Ok(); }
        match (this.file.writeAt(this.pending.view(), this.writtenEnd)) {
            Ok() => {}
            Err(e) => { return this.fail(e); }
        }
        match (this.file.syncData()) {
            Ok() => {}
            Err(e) => { return this.fail(e); }
        }
        this.syncs += 1;
        this.committed += this.pendingCount as u64;
        if (this.inflight) { this.committed += this.inflightCount as u64; }
        this.inflight = false;
        this.writtenEnd += this.pending.length as u64;
        this.writeOffset = this.writtenEnd;
        this.pending.clear();
        this.pendingCount = 0;
        // The batch is durable, so it is acknowledged even if the rotation fails: the caller
        // must publish it. A failed rotation fails the journal, so the next commit reports it.
        if (this.writeOffset >= this.config.segmentTargetBytes) {
            let _ = this.rotate();
        }
        return Ok();
    }

    /// Group commit, first half (ADR-0022): writes the staged batch without syncing it, and
    /// returns a ticket whose `sync` makes it durable. The sync runs without the caller's lock,
    /// while later records are staged; `finishSync` then records its result. Returns null when
    /// nothing is staged, or when a batch is already in flight (one at a time). On error the
    /// journal is failed.
    fn writeStaged(borrow mut this) -> Result<SyncTicket?, JournalError> {
        if (this.failed) { return Err(JournalError.Failed); }
        if (this.pendingCount == 0 || this.inflight) { return Ok(null); }
        let path = segmentPath(this.dir.view(), this.segmentId)?;
        let handle = match (DurableFile.openReadWrite(path.view())) {
            Ok(f) => f,
            Err(e) => {
                let _ = this.fail(e);
                return Err(JournalError.Io(e));
            }
        };
        match (this.file.writeAt(this.pending.view(), this.writtenEnd)) {
            Ok() => {}
            Err(e) => {
                let _ = this.fail(e);
                return Err(JournalError.Io(e));
            }
        }
        this.writtenEnd += this.pending.length as u64;
        this.inflight = true;
        this.inflightLast = this.nextLsn - 1;
        this.inflightCount = this.pendingCount;
        this.inflightEnd = this.writtenEnd;
        this.pending.clear();
        this.pendingCount = 0;
        return Ok(SyncTicket { file: handle, lastLsn: this.inflightLast });
    }

    /// Group commit, second half: records the result of a ticket's sync. Ok(true) means the
    /// ticket's batch is durable now and must be published; Ok(false), that `commit` already
    /// made it durable (or it is not this journal's batch). A failed sync fails the journal.
    fn finishSync(borrow mut this, lastLsn: u64, synced: Result<void, IoFailure>) -> Result<bool, JournalError> {
        if (!this.inflight || this.inflightLast != lastLsn) {
            if (this.failed) { return Err(JournalError.Failed); }
            return Ok(false);
        }
        if (this.failed) { return Err(JournalError.Failed); }
        match (synced) {
            Ok() => {}
            Err(e) => {
                let _ = this.fail(e);
                return Err(JournalError.Io(e));
            }
        }
        this.syncs += 1;
        this.committed += this.inflightCount as u64;
        this.inflight = false;
        this.writeOffset = this.inflightEnd;
        // Rotate only when nothing is staged: staged records hold positions in this segment.
        if (this.pendingCount == 0 && this.writeOffset >= this.config.segmentTargetBytes) {
            let _ = this.rotate();
        }
        return Ok(true);
    }

    /// Discards the staged records (used when a batch cannot be built).
    fn discardPending(borrow mut this) {
        this.nextLsn -= this.pendingCount as u64;
        this.pending.clear();
        this.pendingCount = 0;
    }

    fn fail(borrow mut this, e: IoFailure) -> Result<void, JournalError> {
        this.failed = true;
        this.inflight = false;
        this.pending.clear();
        this.pendingCount = 0;
        return Err(JournalError.Io(e));
    }

    fn rotate(borrow mut this) -> Result<void, JournalError> {
        let id = this.segmentId + 1;
        match (Journal.createSegment(this.dir.view(), id, this.nextLsn, this.config.shardId)) {
            Ok(file) => {
                // Keep a read handle of the segment being sealed (best effort: a cache).
                match (segmentPath(this.dir.view(), this.segmentId)) {
                    Ok(path) => {
                        match (DurableFile.openRead(path.view())) {
                            Ok(sealed) => { let _ = this.sealedFiles.put(this.segmentId, sealed); }
                            Err(_) => {}
                        }
                    }
                    Err(_) => {}
                }
                this.file = file;
                this.segmentId = id;
                this.writeOffset = SEGMENT_HEADER_LEN as u64;
                this.writtenEnd = this.writeOffset;
                return Ok();
            }
            Err(e) => {
                this.failed = true;
                return Err(e);
            }
        }
    }

    /// Reads committed bytes of a segment: `into.length` bytes at `offset`.
    fn readAt(borrow this, segmentId: u64, offset: u64, into: SliceMut<u8>) -> Result<void, JournalError> {
        if (segmentId == this.segmentId) {
            if (offset + into.length as u64 > this.writeOffset) { return Err(JournalError.Corrupt(segmentId, offset)); }
            return Ok(this.file.readExactAt(into, offset)?);
        }
        match (this.sealedFiles.get(borrow segmentId)) {
            Some(f) => { return Ok(f.readExactAt(into, offset)?); }
            null => {}
        }
        let path = segmentPath(this.dir.view(), segmentId)?;
        let file = DurableFile.openRead(path.view())?;
        return Ok(file.readExactAt(into, offset)?);
    }

    /// Sealed segments that recovery skipped, with their sizes.
    fn unscannedSegments(borrow this) -> Slice<SegmentFile> => this.unscanned.view();

    /// Commits anything staged, then seals the active segment and starts the next one, unless
    /// the active segment holds no records. Returns the active segment id afterwards: every
    /// record committed so far is in an earlier segment.
    fn sealActive(borrow mut this) -> Result<u64, JournalError> {
        this.commit()?;
        if (this.failed) { return Err(JournalError.Failed); }
        if (this.writeOffset > SEGMENT_HEADER_LEN as u64) { this.rotate()?; }
        return Ok(this.segmentId);
    }

    /// Removes a sealed segment's file. Sync the directory afterwards (`syncDirectory`).
    fn removeSegment(borrow mut this, id: u64) -> Result<void, JournalError> {
        if (id >= this.segmentId) { return Err(JournalError.ActiveSegment); }
        let path = segmentPath(this.dir.view(), id)?;
        let _ = this.sealedFiles.remove(borrow id);
        return Ok(Fs.unlink(path.view())?);
    }

    /// Makes created and removed segment files durable.
    fn syncDirectory(borrow this) -> Result<void, JournalError> => Ok(Fs.syncDirectory(this.dir.view())?);

    /// Reads the whole record at `offset` and verifies it: header, body CRC and trailer, and its
    /// length is `totalLen`. Compaction copies payloads only through this, so corruption is never
    /// copied under a fresh checksum.
    fn readRecord(borrow this, segmentId: u64, offset: u64, totalLen: u32) -> Result<Vector<u8>, JournalError> {
        var out = Vector<u8>.create();
        out.resize(totalLen as usize, 0)?;
        this.readAt(segmentId, offset, mut out.viewMut())?;
        match (decodeRecord(out.view())) {
            Ok(h) => {
                if (h.totalLen != totalLen) { return Err(JournalError.Corrupt(segmentId, offset)); }
            }
            Err(_) => { return Err(JournalError.Corrupt(segmentId, offset)); }
        }
        return Ok(out);
    }

    /// Reads a payload into a new vector and checks nothing more: the record was verified when
    /// it was written or recovered. (Scrub re-verifies whole records.)
    fn readPayload(borrow this, at: PayloadLocator) -> Result<Vector<u8>, JournalError> {
        var out = Vector<u8>.create();
        out.resize(at.length as usize, 0)?;
        this.readAt(at.segmentId, at.offset, mut out.viewMut())?;
        return Ok(out);
    }
}

/// `<dir>/seg-<id as 16 hex digits>.cj`
fn segmentPath(dir: StringView, id: u64) -> Result<String, JournalError> {
    var s = String.create();
    s.append(dir)?;
    s.append("/seg-")?;
    appendHex16(mut s, id)?;
    s.append(".cj")?;
    return Ok(s);
}

fn appendHex16(s: borrow mut String, value: u64) -> Result<void, AllocError> {
    let digits = "0123456789abcdef";
    var buffer = [0u8; 16];
    for (i in 0..16) {
        let shift = truncate<u64>((15 - i) * 4);
        let nibble = (value >> shift) & 0xF;
        buffer[i] = digits.bytes()[nibble as usize];
    }
    s.append(StringView.fromUtf8(buffer[..])!)?;
    return Ok();
}

/// The segment ids in `dir`, ascending.
fn listSegmentIds(dir: StringView) -> Result<Vector<u64>, JournalError> {
    let names = match (Directory.list(dir)) {
        Ok(n) => n,
        Err(_) => { return Err(JournalError.Io(IoFailure { op: IoOp.Open, errno: 0 })); }
    };
    var ids = Vector<u64>.create();
    for (i in 0..names.length) {
        let name = names[i].view();
        if (name.length == 23 && name.startsWith("seg-") && name.endsWith(".cj")) {
            match (name[4..20].parseIntRadix<u64>(16)) {
                Some(id) => { ids.push(id)?; }
                null => {}
            }
        }
    }
    ids.viewMut().sortBy((a, b) => if (a < b) -1 else if (a > b) 1 else 0);
    return Ok(ids);
}

fn writeSegmentHeader(file: borrow DurableFile, id: u64, firstLsn: u64, shardId: u32) -> Result<void, JournalError> {
    var h = [0u8; 64];
    h.writeLE(0, SEGMENT_MAGIC);
    h.writeLE(8, SEGMENT_FORMAT_VERSION);
    h.writeLE(10, truncate<u16>(SEGMENT_HEADER_LEN));
    h.writeLE(12, 0u32);
    h.writeLE(16, id);
    h.writeLE(24, firstLsn);
    h.writeLE(32, shardId);
    h.writeLE(40, Clock.unixMillis());
    let crc = Crc32c.of(h[0..60]);
    h.writeLE(60, crc);
    file.writeAt(h[..], 0)?;
    return Ok();
}

/// Whether the segment starts with a valid header for `id`.
/// Whether the segment's header is valid. A read error is an error, not an invalid header:
/// recovery reinitialises a newest segment whose header is invalid, which must never happen
/// to one that merely could not be read.
fn readSegmentHeader(file: borrow DurableFile, size: u64, id: u64) -> Result<bool, JournalError> {
    if (size < SEGMENT_HEADER_LEN as u64) { return Ok(false); }
    var h = [0u8; 64];
    file.readExactAt(mut h[..], 0)?;
    let r = h[..];
    if (r.readLE<u32>(60) != Crc32c.of(r[0..60])) { return Ok(false); }
    return Ok(
        r.readLE<u64>(0) == SEGMENT_MAGIC && r.readLE<u16>(8) == SEGMENT_FORMAT_VERSION && r.readLE<u64>(16) == id,
    );
}

/// Replays one segment's valid records. Returns the end of the last valid record.
fn scanSegment(
    file: borrow DurableFile,
    id: u64,
    size: u64,
    last: bool,
    maxBatchBytes: usize,
    nextLsn: borrow mut u64,
    buffer: borrow mut Vector<u8>,
    visit: borrow mut fn(u64, u64, borrow RecordHeader, Slice<u8>),
) -> Result<u64, JournalError> {
    var offset = SEGMENT_HEADER_LEN as u64;
    var header = [0u8; 48];
    while (offset < size) {
        let fault = match (readRecordAt(file, offset, size, mut header, buffer)) {
            Ok(h) => {
                if (h.lsn < nextLsn) { return Err(JournalError.Corrupt(id, offset)); }
                visit(id, offset, borrow h, buffer.view());
                nextLsn = h.lsn + 1;
                offset += h.totalLen as u64;
                false
            }
            Err(JournalError.Corrupt(_, _)) => true,
            Err(e) => { return Err(e); }
        };
        if (fault) {
            if (!last) { return Err(JournalError.Corrupt(id, offset)); }
            if (laterAcknowledgedRecord(file, offset, size, maxBatchBytes, buffer)?) {
                return Err(JournalError.Corrupt(id, offset));
            }
            return Ok(offset);
        }
    }
    return Ok(offset);
}

/// Reads and verifies the record at `offset` into `buffer`. An invalid or torn record is
/// Corrupt(0, offset); I/O failures are Io.
fn readRecordAt(
    file: borrow DurableFile,
    offset: u64,
    size: u64,
    header: borrow mut [u8; 48],
    buffer: borrow mut Vector<u8>,
) -> Result<RecordHeader, JournalError> {
    if (size - offset < RECORD_HEADER_LEN as u64) { return Err(JournalError.Corrupt(0, offset)); }
    file.readExactAt(mut header[..], offset)?;
    let h = match (decodeHeader(header[..])) {
        Ok(h) => h,
        Err(_) => { return Err(JournalError.Corrupt(0, offset)); }
    };
    if (size - offset < h.totalLen as u64) { return Err(JournalError.Corrupt(0, offset)); }
    buffer.clear();
    buffer.resize(h.totalLen as usize, 0)?;
    file.readExactAt(mut buffer.viewMut(), offset)?;
    match (verifyRecordBody(borrow h, buffer.view())) {
        Ok() => {}
        Err(_) => { return Err(JournalError.Corrupt(0, offset)); }
    }
    return Ok(h);
}

/// Whether a valid record starts at or after `torn + maxBatchBytes`: proof that the invalid
/// record at `torn` was in an acknowledged batch (see the recovery invariants above).
fn laterAcknowledgedRecord(
    file: borrow DurableFile,
    torn: u64,
    size: u64,
    maxBatchBytes: usize,
    buffer: borrow mut Vector<u8>,
) -> Result<bool, JournalError> {
    let from = torn + maxBatchBytes as u64;
    if (from >= size) { return Ok(false); }
    let length = match (checkedTruncate<usize>(size - from)) {
        Some(n) => n,
        null => { return Err(JournalError.TooLarge); }
    };
    buffer.clear();
    buffer.resize(length, 0)?;
    file.readExactAt(mut buffer.viewMut(), from)?;
    let bytes = buffer.view();
    var i: usize = 0;
    while (i + RECORD_HEADER_LEN <= bytes.length) {
        if (bytes.readLE<u32>(i) == RECORD_MAGIC && isValidRecord(bytes[i..])) { return Ok(true); }
        i += 1;
    }
    return Ok(false);
}
