// The per-shard journal: the single write-ahead log and the home of small payloads (ADR-001).
//
// A journal is a directory of segment files `seg-<16 hex digits>.cj`. Records are appended to
// the newest segment. Callers stage records, then `commit` writes the batch with one positional
// write and one data sync. Only after `commit` returns Ok may a caller publish or acknowledge
// any record of the batch.
//
// Recovery invariants:
// - Sealed segments (every segment but the newest) were fully synced before the next one was
//   created, so any invalid record in one is corruption: opening fails.
// - The newest segment may end in a torn batch. A batch is written only after the previous
//   batch's sync succeeded, and a batch is at most `maxBatchBytes`. So if the first invalid
//   record is at X, every valid record at or after X + maxBatchBytes belongs to a later,
//   acknowledged batch: that is corruption, and opening fails. Otherwise the tail from X is
//   unacknowledged and is truncated.
// - A failed write or sync puts the journal in the failed state: nothing more is accepted
//   until it is reopened, because after a failed fsync the OS may have dropped dirty pages.
//
// A Raft log (ADR-0058, `raftLog`): every record is an entry, its LSN its Raft index and its term at least 1;
// segment headers carry flag bit 0, and opening refuses a segment of the other kind. A segment is sealed only once
// its last entry is committed (`markCommitted`), so an uncommitted suffix is always in the active segment, where
// `truncateAfter` cuts it off. Terms never go down along the log.

const SEGMENT_MAGIC: u64 = 0x31304745534A5343; // "CSJSEG01" in file order
const SEGMENT_HEADER_LEN: usize = 64;
const SEGMENT_FORMAT_VERSION: u16 = 1;
/// Segment header flag bit 0: a Raft log (ADR-0058 §1).
const SEGMENT_FLAG_RAFT: u32 = 1;
/// A Raft log keeps the position of every this-many-th entry, so an entry is found by reading forward from one.
const ENTRY_INDEX_EVERY: u64 = 64;

struct JournalConfig {
    /// A segment is sealed and a new one started once it reaches this size.
    segmentTargetBytes: u64;
    /// The most bytes one commit writes; also the torn-tail window of recovery.
    maxBatchBytes: usize;
    shardId: u32;
    /// A cluster shard's Raft log (ADR-0058), not a single node's journal.
    raftLog: bool;

    fn defaults() -> JournalConfig => JournalConfig {
        segmentTargetBytes: 134217728,
        maxBatchBytes: 33554432,
        shardId: 0,
        raftLog: false,
    };
}

enum JournalError {
    @from Io(IoFailure),
    @from OutOfMemory(AllocError),
    /// An invalid record where only valid ones may be: (segment id, offset).
    Corrupt(u64, u64),
    BadSegmentHeader(u64),
    /// A record larger than MAX_RECORD_LEN, or a batch larger than maxBatchBytes.
    TooLarge,
    /// A previous write or sync failed; reopen the journal.
    Failed,
    /// Recovery from a checkpoint needs this segment, and it is missing.
    MissingSegment(u64),
    /// The active segment cannot be removed.
    ActiveSegment,
    /// A segment of the other kind: a Raft log's in a single node's journal, or the other way round (ADR-0058 §1).
    WrongMode(u64),
    /// A Raft entry out of place: the LSN the journal expected, or a term of 0 or below the previous entry's.
    OutOfOrder(u64),
}

/// Where recovery starts. Segments before `segment` are covered by a checkpoint whose last LSN
/// is `lsn` (ADR-0005). They are not scanned, and are kept only for the inline payloads that
/// live versions still point to. Records of `segment` up to `lsn` are skipped, not replayed: a Raft log's
/// checkpoint does not seal (ADR-0058 §3).
struct JournalStart {
    segment: u64;
    lsn: u64;

    /// No checkpoint: scan everything.
    fn beginning() -> JournalStart => JournalStart { segment: 0, lsn: 0 };
}

/// A sealed segment that recovery did not scan, and its size; or the bytes of records recovery skipped in one.
struct SegmentFile {
    id: u64;
    size: u64;
}

/// Where a staged record will be: its segment, its offset there, and its LSN.
struct RecordPosition {
    segmentId: u64;
    offset: u64;
    lsn: u64;
}

/// Where a Raft log's entry is (ADR-0058): kept for every ENTRY_INDEX_EVERY-th entry and each segment's first.
struct EntryPosition {
    lsn: u64;
    segment: u64;
    offset: u64;
}

/// A written entry found by its LSN.
struct EntryFound {
    segment: u64;
    offset: u64;
    header: RecordHeader;
}

/// The bytes of a payload inside a segment.
struct PayloadLocator {
    segmentId: u64;
    offset: u64;
    length: u32;
}

/// A batch written but not yet durable (`Journal.writeStaged`): its own handle of the segment,
/// so the sync can run on a worker thread without the journal.
struct SyncTicket {
    private file: DurableFile;
    lastLsn: u64;

    /// Makes the batch durable (F_FULLFSYNC on macOS). Pass the result to `finishSync`.
    fn sync(borrow this) -> Result<void, IoFailure> => this.file.syncData();
}

struct Journal {
    private dir: String;
    private file: DurableFile;
    private segmentId: u64;
    /// The end of the last durable batch in the active segment.
    private writeOffset: u64;
    /// The end of the bytes written to the active segment: `writeOffset`, plus the batch in flight.
    private writtenEnd: u64;
    /// A batch written by `writeStaged` whose sync has not finished: its last LSN, records and end.
    private inflight: bool;
    private inflightLast: u64;
    private inflightCount: u32;
    private inflightEnd: u64;
    private nextLsn: u64;
    private pending: Vector<u8>;
    private pendingCount: u32;
    private failed: bool;
    /// The I/O failure that failed the journal, for the log (ADR-0039).
    private failure: IoFailure?;
    private config: JournalConfig;
    /// Stats: data syncs performed and records committed.
    private syncs: u64;
    private committed: u64;
    /// Stats: rotations that failed and left the journal running, and group commits that synced under the caller's
    /// lock because the sync ticket's handle could not be opened (ADR-0039).
    private rotationFailures: u64;
    private syncHandleFallbacks: u64;
    /// Sealed segments that recovery skipped (before the checkpoint's segment), with sizes.
    private unscanned: Vector<SegmentFile>;
    /// Read handles of sealed segments, so a GET of an inline object does not open a file.
    /// A cache: a segment missing from it is opened per read.
    private sealedFiles: HashMap<u64, DurableFile>;
    /// A Raft log (ADR-0058): the last entry known to be committed, the last entry's term, and where entries are.
    private committedLsn: u64;
    private lastTerm: u64;
    private entryIndex: Vector<EntryPosition>;
    /// Bytes of the records recovery skipped (ADR-0058 §3), by segment.
    private skipped: Vector<SegmentFile>;
    /// The last LSN whose record is durable (synced).
    private durable: u64;

    /// Opens (or creates) the journal in `dir`, replaying every valid record through `visit`
    /// in LSN order: visit(segment id, record offset, header, whole record bytes).
    fn open(
        dir: StringView,
        config: JournalConfig,
        visit: borrow mut fn(u64, u64, borrow RecordHeader, Slice<u8>),
    ) -> Result<Journal, JournalError> => Journal.openFrom(dir, config, JournalStart.beginning(), visit);

    /// Opens the journal, replaying only the records after `start` (ADR-0005). The segment
    /// `start.segment` must exist, and its records must follow `start.lsn`.
    fn openFrom(
        dir: StringView,
        config: JournalConfig,
        start: JournalStart,
        visit: borrow mut fn(u64, u64, borrow RecordHeader, Slice<u8>),
    ) -> Result<Journal, JournalError> {
        Fs.ensureDirectory(dir)?;
        var ids = listSegmentIds(dir)?;
        var nextLsn: u64 = start.lsn + 1;
        var buffer = Vector<u8>.create();
        var unscanned = Vector<SegmentFile>.create();
        var sealedFiles = HashMap<u64, DurableFile>.create();
        var scan = ScanState {
            raft: config.raftLog,
            skipThrough: start.lsn,
            lastSkipped: 0,
            lastTerm: 0,
            index: Vector<EntryPosition>.create(),
            skipped: Vector<SegmentFile>.create(),
        };
        if (ids.length == 0) {
            if (start.segment > 0) { return Err(JournalError.MissingSegment(start.segment)); }
            let first = Journal.createSegment(dir, 1, nextLsn, config.shardId, config.raftLog)?;
            return Ok(
                Journal.make(dir, first, 1, SEGMENT_HEADER_LEN as u64, nextLsn, config, unscanned, sealedFiles, scan)?,
            );
        }
        var scanning = false;
        for (i in 0..ids.length) {
            let id = ids[i];
            let last = i + 1 == ids.length;
            let path = segmentPath(dir, id)?;
            if (id < start.segment) {
                if (last) { return Err(JournalError.MissingSegment(start.segment)); }
                let sealed = DurableFile.openRead(path.view())?;
                unscanned.push(SegmentFile { id: id, size: sealed.size()? })?;
                let _ = sealedFiles.put(id, sealed)?;
                continue;
            }
            if (!scanning && start.segment > 0 && id != start.segment) {
                return Err(JournalError.MissingSegment(start.segment));
            }
            scanning = true;
            let file = DurableFile.openReadWrite(path.view())?;
            let size = file.size()?;
            let headerOk = readSegmentHeader(borrow file, size, id, config.raftLog)?;
            if (!headerOk) {
                if (!last) { return Err(JournalError.BadSegmentHeader(id)); }
                // The newest segment's creation was torn: start it again.
                file.truncateTo(0)?;
                writeSegmentHeader(borrow file, id, nextLsn, config.shardId, config.raftLog)?;
                file.syncData()?;
                return Ok(
                    Journal.make(
                        dir,
                        file,
                        id,
                        SEGMENT_HEADER_LEN as u64,
                        nextLsn,
                        config,
                        unscanned,
                        sealedFiles,
                        scan,
                    )?,
                );
            }
            let end = scanSegment(
                borrow file,
                id,
                size,
                last,
                config.maxBatchBytes,
                mut nextLsn,
                mut buffer,
                mut scan,
                visit,
            )?;
            if (last) {
                if (end != size) {
                    file.truncateTo(end)?;
                    file.syncData()?;
                }
                return Ok(Journal.make(dir, file, id, end, nextLsn, config, unscanned, sealedFiles, scan)?);
            }
            let _ = sealedFiles.put(id, file)?;
        }
        return Err(JournalError.Corrupt(0, 0)); // unreachable: the loop returns on the last segment
    }

    fn make(
        dir: StringView,
        file: DurableFile,
        segmentId: u64,
        writeOffset: u64,
        nextLsn: u64,
        config: JournalConfig,
        unscanned: Vector<SegmentFile>,
        sealedFiles: HashMap<u64, DurableFile>,
        scan: ScanState,
    ) -> Result<Journal, JournalError> {
        var d = String.create();
        d.append(dir)?;
        return Ok(Journal {
            durable: nextLsn - 1,
            committedLsn: scan.skipThrough,
            lastTerm: scan.lastTerm,
            entryIndex: scan.index,
            skipped: scan.skipped,
            dir: d,
            file: file,
            segmentId: segmentId,
            writeOffset: writeOffset,
            writtenEnd: writeOffset,
            inflight: false,
            inflightLast: 0,
            inflightCount: 0,
            inflightEnd: writeOffset,
            nextLsn: nextLsn,
            pending: Vector<u8>.create(),
            pendingCount: 0,
            failed: false,
            failure: null,
            config: config,
            syncs: 0,
            committed: 0,
            rotationFailures: 0,
            syncHandleFallbacks: 0,
            unscanned: unscanned,
            sealedFiles: sealedFiles,
        });
    }

    /// Creates segment `id` with its header, durably (file and directory entry).
    fn createSegment(
        dir: StringView,
        id: u64,
        firstLsn: u64,
        shardId: u32,
        raft: bool,
    ) -> Result<DurableFile, JournalError> {
        let path = segmentPath(dir, id)?;
        let file = DurableFile.createNew(path.view())?;
        Journal.initSegment(borrow file, dir, id, firstLsn, shardId, raft)?;
        return Ok(file);
    }

    /// Writes a new segment's header and makes the file and its directory entry durable.
    fn initSegment(
        file: borrow DurableFile,
        dir: StringView,
        id: u64,
        firstLsn: u64,
        shardId: u32,
        raft: bool,
    ) -> Result<void, JournalError> {
        writeSegmentHeader(file, id, firstLsn, shardId, raft)?;
        file.syncData()?;
        Fs.syncDirectory(dir)?;
        return Ok();
    }

    /// The LSN the next staged record gets.
    fn upcomingLsn(borrow this) -> u64 => this.nextLsn;

    /// Records staged and not yet committed.
    fn pendingRecords(borrow this) -> u32 => this.pendingCount;

    /// Bytes staged and not yet committed.
    fn pendingBytes(borrow this) -> usize => this.pending.length;

    fn syncCount(borrow this) -> u64 => this.syncs;

    /// Whether a write or sync failed (or a failed rotation could not be undone); the journal refuses records until
    /// reopened.
    fn isFailed(borrow this) -> bool => this.failed;

    /// The I/O failure that failed the journal, if one did.
    fn failureCause(borrow this) -> IoFailure? => this.failure;

    /// Rotations that failed and left the journal running (ADR-0039).
    fn rotationFailureCount(borrow this) -> u64 => this.rotationFailures;

    /// Group commits whose sync handle could not be opened, so they synced under the caller's lock (ADR-0039).
    fn syncHandleFallbackCount(borrow this) -> u64 => this.syncHandleFallbacks;

    fn committedCount(borrow this) -> u64 => this.committed;

    fn activeSegment(borrow this) -> u64 => this.segmentId;

    /// Adds a record to the current batch. It is not durable until `commit` returns Ok. A Raft log takes entries
    /// (`stageEntry`, `appendEncoded`) instead.
    fn stage(
        borrow mut this,
        kind: RecordType,
        meta: Slice<u8>,
        payload: Slice<u8>,
    ) -> Result<RecordPosition, JournalError> {
        if (this.config.raftLog) { return Err(JournalError.WrongMode(this.segmentId)); }
        return this.stageWith(kind, 0, meta, payload);
    }

    /// A Raft log's next entry, of `term`, made by this replica as leader (ADR-0058 §1): its LSN is its index.
    fn stageEntry(
        borrow mut this,
        kind: RecordType,
        term: u64,
        meta: Slice<u8>,
        payload: Slice<u8>,
    ) -> Result<RecordPosition, JournalError> {
        if (!this.config.raftLog) { return Err(JournalError.WrongMode(this.segmentId)); }
        if (term == 0 || term < this.lastTerm) { return Err(JournalError.OutOfOrder(this.nextLsn)); }
        let at = this.stageWith(kind, term, meta, payload)?;
        this.lastTerm = term;
        this.noteEntry(borrow at)?;
        return Ok(at);
    }

    /// A Raft log's next entry as a leader encoded it (a follower's): checked whole, and staged byte for byte, so
    /// every replica holds the same record at the same LSN.
    fn appendEncoded(borrow mut this, record: Slice<u8>) -> Result<RecordPosition, JournalError> {
        if (this.failed) { return Err(JournalError.Failed); }
        if (!this.config.raftLog) { return Err(JournalError.WrongMode(this.segmentId)); }
        let h = match (decodeRecord(record)) {
            Ok(h) => h,
            Err(_) => { return Err(JournalError.Corrupt(0, 0)); }
        };
        if (record.length != h.totalLen as usize) { return Err(JournalError.Corrupt(0, 0)); }
        if (h.lsn != this.nextLsn || h.term == 0 || h.term < this.lastTerm) {
            return Err(JournalError.OutOfOrder(this.nextLsn));
        }
        if (this.pending.length + record.length > this.config.maxBatchBytes) { return Err(JournalError.TooLarge); }
        let at = RecordPosition {
            segmentId: this.segmentId,
            offset: this.writtenEnd + this.pending.length as u64,
            lsn: this.nextLsn,
        };
        this.pending.extend(record)?;
        this.nextLsn += 1;
        this.pendingCount += 1;
        this.lastTerm = h.term;
        this.noteEntry(borrow at)?;
        return Ok(at);
    }

    fn noteEntry(borrow mut this, at: borrow RecordPosition) -> Result<void, AllocError> {
        if (at.offset == SEGMENT_HEADER_LEN as u64 || at.lsn % ENTRY_INDEX_EVERY == 0 || this.entryIndex.length == 0) {
            this.entryIndex.push(EntryPosition { lsn: at.lsn, segment: at.segmentId, offset: at.offset })?;
        }
        return Ok();
    }

    /// Where written entry `lsn` is, and its header: read forward from the nearest kept position before it.
    fn entryAt(borrow this, lsn: u64) -> Result<EntryFound, JournalError> {
        var k = this.entryIndex.length;
        while (k > 0 && this.entryIndex[k - 1].lsn > lsn) { k -= 1; }
        if (k == 0 || lsn >= this.nextLsn - this.pendingCount as u64) { return Err(JournalError.OutOfOrder(lsn)); }
        let segment = this.entryIndex[k - 1].segment;
        var offset = this.entryIndex[k - 1].offset;
        var header = [0u8; 48];
        while (true) {
            this.readAt(segment, offset, mut header[..])?;
            let h = match (decodeHeader(header[..])) {
                Ok(h) => h,
                Err(_) => { return Err(JournalError.Corrupt(segment, offset)); }
            };
            if (h.lsn == lsn) { return Ok(EntryFound { segment: segment, offset: offset, header: h }); }
            if (h.lsn > lsn) { return Err(JournalError.OutOfOrder(lsn)); }
            offset += h.totalLen as u64;
        }
        return Err(JournalError.OutOfOrder(lsn)); // unreachable
    }

    /// The whole record of written entry `lsn`, verified: what a leader sends a follower (ADR-0058 §7).
    fn entryBytes(borrow this, lsn: u64) -> Result<Vector<u8>, JournalError> {
        let at = this.entryAt(lsn)?;
        return this.readRecord(at.segment, at.offset, at.header.totalLen);
    }

    /// The last LSN whose record is durable.
    fn durableLsn(borrow this) -> u64 => this.durable;

    /// The last entry written or staged, and its term (a Raft log).
    fn lastLsn(borrow this) -> u64 => this.nextLsn - 1;

    fn lastEntryTerm(borrow this) -> u64 => this.lastTerm;

    fn committedThrough(borrow this) -> u64 => this.committedLsn;

    /// Bytes of the records recovery skipped, by segment (ADR-0058 §3).
    fn skippedSegments(borrow this) -> Slice<SegmentFile> => this.skipped.view();

    /// Whether the active segment may be sealed: a single node's always; a Raft log's once every entry in it is
    /// committed (ADR-0058 §4).
    fn mayRotate(borrow this) -> bool => !this.config.raftLog || this.committedLsn + 1 >= this.nextLsn;

    /// A Raft log's entries through `lsn` are committed; a full segment whose entries all are is sealed now.
    fn markCommitted(borrow mut this, lsn: u64) {
        if (lsn > this.committedLsn) { this.committedLsn = lsn; }
        if (this.config.raftLog && !this.failed && this.pendingCount == 0 && !this.inflight &&
            this.writeOffset >= this.config.segmentTargetBytes && this.mayRotate()) {
            let _ = this.rotate();
        }
    }

    /// Cuts a Raft log's entries after `lsn` off, durably, before any other entry is staged (ADR-0058 §4): the
    /// suffix a new leader does not have. Nothing may be staged or in flight. They are uncommitted, so all in the
    /// active segment; cutting a committed entry is a bug.
    fn truncateAfter(borrow mut this, lsn: u64) -> Result<void, JournalError> {
        if (this.failed) { return Err(JournalError.Failed); }
        if (!this.config.raftLog) { return Err(JournalError.WrongMode(this.segmentId)); }
        if (lsn + 1 >= this.nextLsn) { return Ok(); }
        if (this.pendingCount > 0) { return Err(JournalError.OutOfOrder(this.nextLsn)); }
        // A batch in flight (a deposed leader's write, its sync running without the store's lock): made durable
        // first, so the cut below starts from a synced end; its ticket's late sync then finds it is not this
        // journal's batch (`finishSync`), and it is never published.
        if (this.inflight) { this.commit()?; }
        if (lsn < this.committedLsn) { panic("journal: cutting off a committed entry"); }
        let at = this.entryAt(lsn + 1)?;
        if (at.segment != this.segmentId) { panic("journal: an uncommitted entry in a sealed segment"); }
        match (this.file.truncateTo(at.offset)) {
            Ok() => {}
            Err(e) => { return this.fail(e); }
        }
        match (this.file.syncData()) {
            Ok() => {}
            Err(e) => { return this.fail(e); }
        }
        this.writeOffset = at.offset;
        this.writtenEnd = at.offset;
        this.inflightEnd = at.offset;
        this.nextLsn = lsn + 1;
        this.durable = lsn;
        while (this.entryIndex.length > 0 && this.entryIndex[this.entryIndex.length - 1].lsn > lsn) {
            let _ = this.entryIndex.pop();
        }
        this.lastTerm = match (this.entryAt(lsn)) {
            Ok(e) => e.header.term,
            Err(_) => 0,
        };
        return Ok();
    }

    fn stageWith(
        borrow mut this,
        kind: RecordType,
        term: u64,
        meta: Slice<u8>,
        payload: Slice<u8>,
    ) -> Result<RecordPosition, JournalError> {
        if (this.failed) { return Err(JournalError.Failed); }
        let length = recordLength(meta.length, payload.length);
        if (length > MAX_RECORD_LEN) { return Err(JournalError.TooLarge); }
        if (this.pending.length + length > this.config.maxBatchBytes) { return Err(JournalError.TooLarge); }
        let position = RecordPosition {
            segmentId: this.segmentId,
            offset: this.writtenEnd + this.pending.length as u64,
            lsn: this.nextLsn,
        };
        encodeRecord(mut this.pending, kind, 0, this.nextLsn, term, meta, payload)?;
        this.nextLsn += 1;
        this.pendingCount += 1;
        return Ok(position);
    }

    /// Whether staging `metaLen` + `payloadLen` more bytes would overflow the batch.
    fn wouldOverflow(borrow this, metaLen: usize, payloadLen: usize) -> bool =>
        this.pending.length + recordLength(metaLen, payloadLen) > this.config.maxBatchBytes;

    /// Whether the active segment is full, so the next commit with nothing in flight rotates it.
    fn needsRotation(borrow this) -> bool => this.writtenEnd >= this.config.segmentTargetBytes;

    /// Whether a batch written by `writeStaged` is waiting for its sync.
    fn hasInflight(borrow this) -> bool => this.inflight;

    /// Makes every staged record durable with one write and one sync, together with a batch in
    /// flight (`writeStaged`), then rotates the segment if it is full. On error the journal is
    /// failed; the batch may or may not have reached the disk, and must not be published.
    fn commit(borrow mut this) -> Result<void, JournalError> {
        if (this.failed) { return Err(JournalError.Failed); }
        if (this.pendingCount == 0 && !this.inflight) { return Ok(); }
        match (this.file.writeAt(this.pending.view(), this.writtenEnd)) {
            Ok() => {}
            Err(e) => { return this.fail(e); }
        }
        match (this.file.syncData()) {
            Ok() => {}
            Err(e) => { return this.fail(e); }
        }
        this.syncs += 1;
        this.durable = this.nextLsn - 1;
        this.committed += this.pendingCount as u64;
        if (this.inflight) { this.committed += this.inflightCount as u64; }
        this.inflight = false;
        this.writtenEnd += this.pending.length as u64;
        this.writeOffset = this.writtenEnd;
        this.pending.clear();
        this.pendingCount = 0;
        // The batch is durable, so it is acknowledged even if the rotation fails: the caller
        // must publish it. A failed rotation fails the journal, so the next commit reports it.
        if (this.writeOffset >= this.config.segmentTargetBytes && this.mayRotate()) {
            let _ = this.rotate();
        }
        return Ok();
    }

    /// Group commit, first half (ADR-0022): writes the staged batch without syncing it, and
    /// returns a ticket whose `sync` makes it durable. The sync runs without the caller's lock,
    /// while later records are staged; `finishSync` then records its result. Returns null when
    /// nothing is staged, when a batch is already in flight (one at a time), or when the ticket's
    /// handle cannot be opened (out of descriptors): then nothing was written, and the caller
    /// commits the batch with `commit` (ADR-0039). A failed write fails the journal.
    fn writeStaged(borrow mut this) -> Result<SyncTicket?, JournalError> {
        if (this.failed) { return Err(JournalError.Failed); }
        if (this.pendingCount == 0 || this.inflight) { return Ok(null); }
        let path = segmentPath(this.dir.view(), this.segmentId)?;
        let handle = match (DurableFile.openReadWrite(path.view())) {
            Ok(f) => f,
            Err(_) => {
                // Nothing was written, so the journal is as it was: the batch stays staged, and the caller commits it
                // with the journal's own handle (ADR-0039).
                this.syncHandleFallbacks += 1;
                return Ok(null);
            }
        };
        match (this.file.writeAt(this.pending.view(), this.writtenEnd)) {
            Ok() => {}
            Err(e) => {
                let _ = this.fail(e);
                return Err(JournalError.Io(e));
            }
        }
        this.writtenEnd += this.pending.length as u64;
        this.inflight = true;
        this.inflightLast = this.nextLsn - 1;
        this.inflightCount = this.pendingCount;
        this.inflightEnd = this.writtenEnd;
        this.pending.clear();
        this.pendingCount = 0;
        return Ok(SyncTicket { file: handle, lastLsn: this.inflightLast });
    }

    /// Group commit, second half: records the result of a ticket's sync. Ok(true) means the
    /// ticket's batch is durable now and must be published; Ok(false), that `commit` already
    /// made it durable (or it is not this journal's batch). A failed sync fails the journal.
    fn finishSync(borrow mut this, lastLsn: u64, synced: Result<void, IoFailure>) -> Result<bool, JournalError> {
        if (!this.inflight || this.inflightLast != lastLsn) {
            if (this.failed) { return Err(JournalError.Failed); }
            return Ok(false);
        }
        if (this.failed) { return Err(JournalError.Failed); }
        match (synced) {
            Ok() => {}
            Err(e) => {
                let _ = this.fail(e);
                return Err(JournalError.Io(e));
            }
        }
        this.syncs += 1;
        this.durable = this.inflightLast;
        this.committed += this.inflightCount as u64;
        this.inflight = false;
        this.writeOffset = this.inflightEnd;
        // Rotate only when nothing is staged: staged records hold positions in this segment.
        if (this.pendingCount == 0 && this.writeOffset >= this.config.segmentTargetBytes && this.mayRotate()) {
            let _ = this.rotate();
        }
        return Ok(true);
    }

    /// Discards the staged records (used when a batch cannot be built).
    fn discardPending(borrow mut this) {
        this.nextLsn -= this.pendingCount as u64;
        while (this.entryIndex.length > 0 && this.entryIndex[this.entryIndex.length - 1].lsn >= this.nextLsn) {
            let _ = this.entryIndex.pop();
        }
        this.pending.clear();
        this.pendingCount = 0;
    }

    fn fail(borrow mut this, e: IoFailure) -> Result<void, JournalError> {
        this.failed = true;
        this.failure = e;
        this.inflight = false;
        this.pending.clear();
        this.pendingCount = 0;
        return Err(JournalError.Io(e));
    }

    /// Starts the next segment. If that fails, the journal keeps the active segment, which grows past its target until
    /// a later commit rotates (ADR-0039), unless a file was left that cannot be removed: a crash could then find it as
    /// the newest segment with this one sealed behind it, and a torn batch here would read as corruption (ADR-0001).
    /// Then the journal fails.
    fn rotate(borrow mut this) -> Result<void, JournalError> {
        let id = this.segmentId + 1;
        let path = segmentPath(this.dir.view(), id)?;
        let file = match (DurableFile.createNew(path.view())) {
            Ok(f) => f,
            Err(e) => {
                // An existing file is not this rotation's: leave it, and stop.
                if (e.isAlreadyExists()) {
                    this.failed = true;
                    this.failure = e;
                }
                this.rotationFailures += 1;
                return Err(JournalError.Io(e));
            }
        };
        match (Journal.initSegment(
            borrow file,
            this.dir.view(),
            id,
            this.nextLsn,
            this.config.shardId,
            this.config.raftLog,
        )) {
            Ok() => {}
            Err(e) => {
                // The new file must be gone, durably, before the active segment takes another record.
                let removed = match (Fs.unlink(path.view())) {
                    Ok() => Fs.syncDirectory(this.dir.view()).isOk(),
                    Err(_) => false,
                };
                if (!removed) {
                    this.failed = true;
                    this.failure = match (e) {
                        JournalError.Io(f) => f,
                        _ => null,
                    };
                }
                this.rotationFailures += 1;
                return Err(e);
            }
        }
        // Keep a read handle of the segment being sealed (best effort: a cache).
        match (segmentPath(this.dir.view(), this.segmentId)) {
            Ok(sealedPath) => {
                match (DurableFile.openRead(sealedPath.view())) {
                    Ok(sealed) => { let _ = this.sealedFiles.put(this.segmentId, sealed); }
                    Err(_) => {}
                }
            }
            Err(_) => {}
        }
        this.file = file;
        this.segmentId = id;
        this.writeOffset = SEGMENT_HEADER_LEN as u64;
        this.writtenEnd = this.writeOffset;
        return Ok();
    }

    /// Reads written bytes of a segment: `into.length` bytes at `offset`. In the active segment that includes a batch
    /// in flight (written, its sync not done): a Raft log's entries are read there, by their index, whether or not
    /// they are durable yet (ADR-0065: a new leader's entry for the index of one in flight is compared with it).
    fn readAt(borrow this, segmentId: u64, offset: u64, into: SliceMut<u8>) -> Result<void, JournalError> {
        if (segmentId == this.segmentId) {
            if (offset + into.length as u64 > this.writtenEnd) { return Err(JournalError.Corrupt(segmentId, offset)); }
            return Ok(this.file.readExactAt(into, offset)?);
        }
        match (this.sealedFiles.get(borrow segmentId)) {
            Some(f) => { return Ok(f.readExactAt(into, offset)?); }
            null => {}
        }
        let path = segmentPath(this.dir.view(), segmentId)?;
        let file = DurableFile.openRead(path.view())?;
        return Ok(file.readExactAt(into, offset)?);
    }

    /// Writes `bytes` over a damaged record at `offset` of segment `id`, and syncs it (ADR-0063 §3): the record as
    /// another replica holds it, byte for byte. The one write below a segment's synced end; a crash during it leaves the
    /// record as damaged as it was, or repaired.
    fn repairAt(borrow this, id: u64, offset: u64, bytes: Slice<u8>) -> Result<void, JournalError> {
        if (id == this.segmentId) {
            if (offset + bytes.length as u64 > this.writeOffset) { return Err(JournalError.Corrupt(id, offset)); }
            this.file.writeAt(bytes, offset)?;
            this.file.syncData()?;
            return Ok();
        }
        let path = segmentPath(this.dir.view(), id)?;
        let file = DurableFile.openReadWrite(path.view())?;
        if (offset + bytes.length as u64 > file.size()?) { return Err(JournalError.Corrupt(id, offset)); }
        file.writeAt(bytes, offset)?;
        file.syncData()?;
        return Ok();
    }

    /// Where segment `id`'s durable bytes end: the active segment's last synced batch, or a sealed segment's size.
    fn durableEnd(borrow this, id: u64) -> Result<u64, JournalError> {
        if (id == this.segmentId) { return Ok(this.writeOffset); }
        let path = segmentPath(this.dir.view(), id)?;
        return Ok(DurableFile.openRead(path.view())?.size()?);
    }

    /// Sealed segments that recovery skipped, with their sizes.
    fn unscannedSegments(borrow this) -> Slice<SegmentFile> => this.unscanned.view();

    /// Commits anything staged, then seals the active segment and starts the next one, unless
    /// the active segment holds no records. Returns the active segment id afterwards: every
    /// record committed so far is in an earlier segment.
    fn sealActive(borrow mut this) -> Result<u64, JournalError> {
        this.commit()?;
        if (this.failed) { return Err(JournalError.Failed); }
        if (this.writeOffset > SEGMENT_HEADER_LEN as u64 && this.mayRotate()) { this.rotate()?; }
        return Ok(this.segmentId);
    }

    /// Removes a sealed segment's file. Sync the directory afterwards (`syncDirectory`).
    fn removeSegment(borrow mut this, id: u64) -> Result<void, JournalError> {
        if (id >= this.segmentId) { return Err(JournalError.ActiveSegment); }
        let path = segmentPath(this.dir.view(), id)?;
        let _ = this.sealedFiles.remove(borrow id);
        var k = 0usize;
        while (k < this.entryIndex.length) {
            if (this.entryIndex[k].segment == id) { let _ = this.entryIndex.remove(k); } else { k += 1; }
        }
        return Ok(Fs.unlink(path.view())?);
    }

    /// Makes created and removed segment files durable.
    fn syncDirectory(borrow this) -> Result<void, JournalError> => Ok(Fs.syncDirectory(this.dir.view())?);

    /// Reads the whole record at `offset` and verifies it: header, body CRC and trailer, and its
    /// length is `totalLen`. Compaction copies payloads only through this, so corruption is never
    /// copied under a fresh checksum.
    fn readRecord(borrow this, segmentId: u64, offset: u64, totalLen: u32) -> Result<Vector<u8>, JournalError> {
        var out = Vector<u8>.create();
        out.resize(totalLen as usize, 0)?;
        this.readAt(segmentId, offset, mut out.viewMut())?;
        checkRecord(out.view(), segmentId, offset, totalLen)?;
        return Ok(out);
    }

    /// The path of segment `id`'s file, for a reader that opens it without the journal (`readRecordFile`).
    fn segmentFile(borrow this, id: u64) -> Result<String, JournalError> => segmentPath(this.dir.view(), id);

    /// Reads a payload into a new vector and checks nothing more: the record was verified when
    /// it was written or recovered. (Scrub re-verifies whole records.)
    fn readPayload(borrow this, at: PayloadLocator) -> Result<Vector<u8>, JournalError> {
        var out = Vector<u8>.create();
        out.resize(at.length as usize, 0)?;
        this.readAt(at.segmentId, at.offset, mut out.viewMut())?;
        return Ok(out);
    }
}

/// Whether `bytes` is one whole, valid record of `totalLen` bytes.
fn checkRecord(bytes: Slice<u8>, segmentId: u64, offset: u64, totalLen: u32) -> Result<void, JournalError> {
    match (decodeRecord(bytes)) {
        Ok(h) => {
            if (h.totalLen != totalLen) { return Err(JournalError.Corrupt(segmentId, offset)); }
        }
        Err(_) => { return Err(JournalError.Corrupt(segmentId, offset)); }
    }
    return Ok();
}

/// Reads and verifies a published record from its segment's file, as `Journal.readRecord` does, but without the
/// journal: through a handle of its own, so it can run without the store's lock (ADR-0024). The caller keeps the
/// segment from being removed meanwhile (a segment pin).
fn readRecordFile(path: StringView, segmentId: u64, offset: u64, totalLen: u32) -> Result<Vector<u8>, JournalError> {
    var out = Vector<u8>.create();
    out.resize(totalLen as usize, 0)?;
    let file = DurableFile.openRead(path)?;
    file.readExactAt(mut out.viewMut(), offset)?;
    checkRecord(out.view(), segmentId, offset, totalLen)?;
    return Ok(out);
}

/// `<dir>/seg-<id as 16 hex digits>.cj`
fn segmentPath(dir: StringView, id: u64) -> Result<String, JournalError> {
    var s = String.create();
    s.append(dir)?;
    s.append("/seg-")?;
    appendHex16(mut s, id)?;
    s.append(".cj")?;
    return Ok(s);
}

fn appendHex16(s: borrow mut String, value: u64) -> Result<void, AllocError> {
    let digits = "0123456789abcdef";
    var buffer = [0u8; 16];
    for (i in 0..16) {
        let shift = truncate<u64>((15 - i) * 4);
        let nibble = (value >> shift) & 0xF;
        buffer[i] = digits.bytes()[nibble as usize];
    }
    s.append(StringView.fromUtf8(buffer[..])!)?;
    return Ok();
}

/// The segment ids in `dir`, ascending.
fn listSegmentIds(dir: StringView) -> Result<Vector<u64>, JournalError> {
    let names = match (Directory.list(dir)) {
        Ok(n) => n,
        Err(_) => { return Err(JournalError.Io(IoFailure { op: IoOp.Open, errno: 0 })); }
    };
    var ids = Vector<u64>.create();
    for (i in 0..names.length) {
        let name = names[i].view();
        if (name.length == 23 && name.startsWith("seg-") && name.endsWith(".cj")) {
            match (name[4..20].parseIntRadix<u64>(16)) {
                Some(id) => { ids.push(id)?; }
                null => {}
            }
        }
    }
    ids.viewMut().sortBy((a, b) => if (a < b) -1 else if (a > b) 1 else 0);
    return Ok(ids);
}

fn writeSegmentHeader(
    file: borrow DurableFile,
    id: u64,
    firstLsn: u64,
    shardId: u32,
    raft: bool,
) -> Result<void, JournalError> {
    var h = [0u8; 64];
    h.writeLE(0, SEGMENT_MAGIC);
    h.writeLE(8, SEGMENT_FORMAT_VERSION);
    h.writeLE(10, truncate<u16>(SEGMENT_HEADER_LEN));
    h.writeLE(12, if (raft) SEGMENT_FLAG_RAFT else 0u32);
    h.writeLE(16, id);
    h.writeLE(24, firstLsn);
    h.writeLE(32, shardId);
    h.writeLE(40, Clock.unixMillis());
    let crc = Crc32c.of(h[0..60]);
    h.writeLE(60, crc);
    file.writeAt(h[..], 0)?;
    return Ok();
}

/// Whether the segment starts with a valid header for `id`.
/// Whether the segment's header is valid. A read error is an error, not an invalid header:
/// recovery reinitialises a newest segment whose header is invalid, which must never happen
/// to one that merely could not be read.
/// A valid header of the other kind (a Raft log's, or a single node's) is WrongMode.
fn readSegmentHeader(file: borrow DurableFile, size: u64, id: u64, raft: bool) -> Result<bool, JournalError> {
    if (size < SEGMENT_HEADER_LEN as u64) { return Ok(false); }
    var h = [0u8; 64];
    file.readExactAt(mut h[..], 0)?;
    let r = h[..];
    if (r.readLE<u32>(60) != Crc32c.of(r[0..60])) { return Ok(false); }
    let valid = r.readLE<u64>(0) == SEGMENT_MAGIC && r.readLE<u16>(8) == SEGMENT_FORMAT_VERSION &&
        r.readLE<u64>(16) == id;
    if (valid && ((r.readLE<u32>(12) & SEGMENT_FLAG_RAFT) != 0) != raft) { return Err(JournalError.WrongMode(id)); }
    return Ok(valid);
}

/// What recovery carries from segment to segment: which records it skips (ADR-0058 §3), and for a Raft log the
/// terms seen and the entry positions kept.
struct ScanState {
    raft: bool;
    skipThrough: u64;
    lastSkipped: u64;
    lastTerm: u64;
    index: Vector<EntryPosition>;
    skipped: Vector<SegmentFile>;
}

/// Replays one segment's valid records. Returns the end of the last valid record.
fn scanSegment(
    file: borrow DurableFile,
    id: u64,
    size: u64,
    last: bool,
    maxBatchBytes: usize,
    nextLsn: borrow mut u64,
    buffer: borrow mut Vector<u8>,
    scan: borrow mut ScanState,
    visit: borrow mut fn(u64, u64, borrow RecordHeader, Slice<u8>),
) -> Result<u64, JournalError> {
    var offset = SEGMENT_HEADER_LEN as u64;
    var header = [0u8; 48];
    var skippedHere = 0u64;
    while (offset < size) {
        let fault = match (readRecordAt(file, offset, size, mut header, buffer)) {
            Ok(h) => {
                if (scan.raft) {
                    // Entries have terms, which never go down along the log.
                    if (h.term == 0 || h.term < scan.lastTerm) { return Err(JournalError.Corrupt(id, offset)); }
                    scan.lastTerm = h.term;
                }
                if (h.lsn <= scan.skipThrough) {
                    // Covered by the checkpoint: counted, not replayed.
                    if (h.lsn <= scan.lastSkipped) { return Err(JournalError.Corrupt(id, offset)); }
                    scan.lastSkipped = h.lsn;
                    skippedHere += h.totalLen as u64;
                    offset += h.totalLen as u64;
                    continue;
                }
                if (h.lsn < nextLsn || (scan.raft && h.lsn != nextLsn)) {
                    return Err(JournalError.Corrupt(id, offset));
                }
                if (scan.raft && (offset == SEGMENT_HEADER_LEN as u64 || h.lsn % ENTRY_INDEX_EVERY == 0 ||
                    scan.index.length == 0)) {
                    scan.index.push(EntryPosition { lsn: h.lsn, segment: id, offset: offset })?;
                }
                visit(id, offset, borrow h, buffer.view());
                nextLsn = h.lsn + 1;
                offset += h.totalLen as u64;
                false
            }
            Err(JournalError.Corrupt(_, _)) => true,
            Err(e) => { return Err(e); }
        };
        if (fault) {
            if (!last) { return Err(JournalError.Corrupt(id, offset)); }
            if (laterAcknowledgedRecord(file, offset, size, maxBatchBytes, buffer)?) {
                return Err(JournalError.Corrupt(id, offset));
            }
            if (skippedHere > 0) { scan.skipped.push(SegmentFile { id: id, size: skippedHere })?; }
            return Ok(offset);
        }
    }
    if (skippedHere > 0) { scan.skipped.push(SegmentFile { id: id, size: skippedHere })?; }
    return Ok(offset);
}

/// Reads and verifies the record at `offset` into `buffer`. An invalid or torn record is
/// Corrupt(0, offset); I/O failures are Io.
fn readRecordAt(
    file: borrow DurableFile,
    offset: u64,
    size: u64,
    header: borrow mut [u8; 48],
    buffer: borrow mut Vector<u8>,
) -> Result<RecordHeader, JournalError> {
    if (size - offset < RECORD_HEADER_LEN as u64) { return Err(JournalError.Corrupt(0, offset)); }
    file.readExactAt(mut header[..], offset)?;
    let h = match (decodeHeader(header[..])) {
        Ok(h) => h,
        Err(_) => { return Err(JournalError.Corrupt(0, offset)); }
    };
    if (size - offset < h.totalLen as u64) { return Err(JournalError.Corrupt(0, offset)); }
    buffer.clear();
    buffer.resize(h.totalLen as usize, 0)?;
    file.readExactAt(mut buffer.viewMut(), offset)?;
    match (verifyRecordBody(borrow h, buffer.view())) {
        Ok() => {}
        Err(_) => { return Err(JournalError.Corrupt(0, offset)); }
    }
    return Ok(h);
}

/// Whether a valid record starts at or after `torn + maxBatchBytes`: proof that the invalid
/// record at `torn` was in an acknowledged batch (see the recovery invariants above).
fn laterAcknowledgedRecord(
    file: borrow DurableFile,
    torn: u64,
    size: u64,
    maxBatchBytes: usize,
    buffer: borrow mut Vector<u8>,
) -> Result<bool, JournalError> {
    let from = torn + maxBatchBytes as u64;
    if (from >= size) { return Ok(false); }
    let length = match (checkedTruncate<usize>(size - from)) {
        Some(n) => n,
        null => { return Err(JournalError.TooLarge); }
    };
    buffer.clear();
    buffer.resize(length, 0)?;
    file.readExactAt(mut buffer.viewMut(), from)?;
    let bytes = buffer.view();
    var i: usize = 0;
    while (i + RECORD_HEADER_LEN <= bytes.length) {
        if (bytes.readLE<u32>(i) == RECORD_MAGIC && isValidRecord(bytes[i..])) { return Ok(true); }
        i += 1;
    }
    return Ok(false);
}
