// Durable file primitives: a safe wrapper over durable_shim.c (ADR-0002). Every operation
// passes through the fault-injection hooks of faults.cee (ADR-0004).
//
// Everything that must survive a crash goes through DurableFile. The rules:
// - `writeAt` places bytes; they are not durable until `syncData` returns Ok.
// - A newly created or renamed file is not durable until its directory is synced
//   with `Fs.syncDirectory`.

extern "C" {
    @effects()
    fn cosmo_open(path: *CChar, flags: i32) -> i32;
    @effects()
    fn cosmo_close(fd: i32) -> i32;
    fn cosmo_pread(fd: i32, buf: *mut u8, len: usize, offset: u64) -> i64;
    fn cosmo_pwrite_all(fd: i32, buf: *u8, len: usize, offset: u64) -> i64;
    fn cosmo_sync_data(fd: i32) -> i32;
    fn cosmo_sync_dir(path: *CChar) -> i32;
    @effects()
    fn cosmo_size(fd: i32) -> i64;
    fn cosmo_truncate(fd: i32, length: u64) -> i32;
    fn cosmo_rename(from: *CChar, to: *CChar) -> i32;
    fn cosmo_unlink(path: *CChar) -> i32;
    fn cosmo_mkdir(path: *CChar) -> i32;
}

const O_READ: i32 = 1;
// The shim's flags (durable_shim.c): READ 1, RW 2, CREATE 4, EXCL 8.
const O_RW_CREATE: i32 = 6;
const O_RW_CREATE_EXCL: i32 = 14;

const ERRNO_ENOENT: i32 = 2;
const ERRNO_EEXIST: i32 = 17;

/// Which operation failed.
enum IoOp {
    Open,
    Read,
    Write,
    Sync,
    SyncDir,
    Size,
    Truncate,
    Rename,
    Unlink,
    Mkdir,
    PathTooLong,
    OutOfMemory,
}

/// A failed I/O operation: the operation and the OS error number (0 when not an OS error).
struct IoFailure {
    op: IoOp;
    errno: i32;

    fn os(op: IoOp, code: i64) -> IoFailure => IoFailure { op: op, errno: truncate<i32>(0 - code) };

    fn isNotFound(borrow this) -> bool => this.errno == ERRNO_ENOENT;

    fn isAlreadyExists(borrow this) -> bool => this.errno == ERRNO_EEXIST;
}

fn ioOpName(op: IoOp) -> StringView => match (op) {
    IoOp.Open => "open",
    IoOp.Read => "read",
    IoOp.Write => "write",
    IoOp.Sync => "sync",
    IoOp.SyncDir => "sync directory",
    IoOp.Size => "size",
    IoOp.Truncate => "truncate",
    IoOp.Rename => "rename",
    IoOp.Unlink => "unlink",
    IoOp.Mkdir => "mkdir",
    IoOp.PathTooLong => "path too long",
    IoOp.OutOfMemory => "out of memory",
};

const PATH_MAX_BYTES: usize = 4095;

/// A path copied into a NUL-terminated buffer for C.
struct CPath {
    bytes: [u8; 4096];
    length: usize;

    fn from(path: StringView) -> Result<CPath, IoFailure> {
        if (path.length > PATH_MAX_BYTES) {
            return Err(IoFailure { op: IoOp.PathTooLong, errno: 0 });
        }
        var p = CPath { bytes: [0u8; 4096], length: path.length };
        let src = path.bytes();
        for (i in 0..src.length) {
            if (src[i] == 0) {
                return Err(IoFailure { op: IoOp.PathTooLong, errno: 0 });
            }
            p.bytes[i] = src[i];
        }
        return Ok(p);
    }

    fn pointer(borrow this) -> *CChar => borrow this.bytes[0] as *u8 as *CChar;
}

/// Filesystem operations on paths.
struct Fs {
    /// Makes created, renamed and removed entries of `dir` durable.
    /// Safety: the CPath buffer is NUL-terminated and outlives the call.
    fn syncDirectory(dir: StringView) -> Result<void, IoFailure> {
        let p = CPath.from(dir)?;
        if (faultHit(IoOp.SyncDir)) { return Err(injected(IoOp.SyncDir)); }
        if (!syncsElided()) {
            let r = unsafe { cosmo_sync_dir(p.pointer()) };
            if (r < 0) { return Err(IoFailure.os(IoOp.SyncDir, r as i64)); }
        }
        trackDirectorySynced(dir);
        return Ok();
    }

    /// Atomically replaces `to` with `from`. Sync the directory afterwards.
    /// Safety: both CPath buffers are NUL-terminated and outlive the call.
    fn rename(from: StringView, to: StringView) -> Result<void, IoFailure> {
        let a = CPath.from(from)?;
        let b = CPath.from(to)?;
        if (faultHit(IoOp.Rename)) { return Err(injected(IoOp.Rename)); }
        let r = unsafe { cosmo_rename(a.pointer(), b.pointer()) };
        if (r < 0) { return Err(IoFailure.os(IoOp.Rename, r as i64)); }
        return Ok();
    }

    /// Removes a file.
    /// Safety: the CPath buffer is NUL-terminated and outlives the call.
    fn unlink(path: StringView) -> Result<void, IoFailure> {
        let p = CPath.from(path)?;
        if (faultHit(IoOp.Unlink)) { return Err(injected(IoOp.Unlink)); }
        let r = unsafe { cosmo_unlink(p.pointer()) };
        if (r < 0) { return Err(IoFailure.os(IoOp.Unlink, r as i64)); }
        trackRemoved(path);
        return Ok();
    }

    /// Creates a directory if it does not exist. A new directory's entry is made durable by
    /// syncing the directory that holds it.
    /// Safety: the CPath buffer is NUL-terminated and outlives the call.
    fn ensureDirectory(path: StringView) -> Result<void, IoFailure> {
        let p = CPath.from(path)?;
        if (faultHit(IoOp.Mkdir)) { return Err(injected(IoOp.Mkdir)); }
        let r = unsafe { cosmo_mkdir(p.pointer()) };
        if (r == 0 - ERRNO_EEXIST) { return Ok(); }
        if (r < 0) { return Err(IoFailure.os(IoOp.Mkdir, r as i64)); }
        let _ = trackCreated(path, true);
        return Fs.syncDirectory(Fs.parentOf(path));
    }

    /// The directory part of a path: everything before the last '/', or "." if there is none.
    fn parentOf(path: StringView) -> StringView {
        let bytes = path.bytes();
        var cut = bytes.length;
        while (cut > 0) {
            if (bytes[cut - 1] == 0x2F) { break; }
            cut -= 1;
        }
        if (cut == 0) { return "."; }
        if (cut == 1) { return "/"; }
        return StringView.fromUtf8(bytes[0..cut - 1]) ?? ".";
    }
}

/// An open file with positional I/O and explicit durability.
struct DurableFile {
    private fd: i32;
    /// The crash model's registry slot (faults.cee), or NO_SLOT.
    private slot: u32;

    /// Opens an existing file for reading.
    fn openRead(path: StringView) -> Result<DurableFile, IoFailure> => DurableFile.openWith(path, O_READ);

    /// Opens a file for reading and writing, creating it if missing.
    fn openReadWrite(path: StringView) -> Result<DurableFile, IoFailure> => DurableFile.openWith(path, O_RW_CREATE);

    /// Creates a new file for reading and writing; fails if it exists.
    fn createNew(path: StringView) -> Result<DurableFile, IoFailure> => DurableFile.openWith(path, O_RW_CREATE_EXCL);

    /// Safety: the CPath buffer is NUL-terminated and outlives the call.
    fn openWith(path: StringView, flags: i32) -> Result<DurableFile, IoFailure> {
        let p = CPath.from(path)?;
        if (faultHit(IoOp.Open)) { return Err(injected(IoOp.Open)); }
        let fd = unsafe { cosmo_open(p.pointer(), flags) };
        if (fd < 0) { return Err(IoFailure.os(IoOp.Open, fd as i64)); }
        var file = DurableFile { fd: fd, slot: NO_SLOT };
        if (tracking()) {
            if (flags == O_RW_CREATE_EXCL) {
                file.slot = trackCreated(path, false);
            } else if (flags == O_RW_CREATE) {
                file.slot = trackOpened(path, file.rawSize()?);
            }
        }
        return Ok(file);
    }

    /// Reads up to `into.length` bytes at `offset`; returns how many were read (0 at the end).
    /// Safety: the pointer and length come from one live SliceMut.
    fn readAt(borrow this, into: SliceMut<u8>, offset: u64) -> Result<usize, IoFailure> {
        if (into.length == 0) { return Ok(0); }
        if (faultHit(IoOp.Read)) { return Err(injected(IoOp.Read)); }
        let n = unsafe { cosmo_pread(this.fd, into.ptr, into.length, offset) };
        if (n < 0) { return Err(IoFailure.os(IoOp.Read, n)); }
        return Ok(checkedTruncate<usize>(n)!);
    }

    /// Reads exactly `into.length` bytes at `offset`; a short file is an error (EIO-like, errno 0).
    fn readExactAt(borrow this, into: SliceMut<u8>, offset: u64) -> Result<void, IoFailure> {
        var done: usize = 0;
        while (done < into.length) {
            let n = this.readAt(mut into[done..], offset + done as u64)?;
            if (n == 0) { return Err(IoFailure { op: IoOp.Read, errno: 0 }); }
            done += n;
        }
        return Ok();
    }

    /// Writes all of `bytes` at `offset`. Not durable until `syncData`.
    /// Safety: the pointer and length come from one live Slice.
    fn writeAt(borrow this, bytes: Slice<u8>, offset: u64) -> Result<void, IoFailure> {
        if (bytes.length == 0) { return Ok(); }
        trackWrite(this.slot, offset);
        if (faultHit(IoOp.Write)) {
            if (tornWrites() && bytes.length > 1) { let _ = this.rawWriteAt(bytes[0..bytes.length / 2], offset); }
            return Err(injected(IoOp.Write));
        }
        return this.rawWriteAt(bytes, offset);
    }

    /// Safety: the pointer and length come from one live Slice.
    fn rawWriteAt(borrow this, bytes: Slice<u8>, offset: u64) -> Result<void, IoFailure> {
        let n = unsafe { cosmo_pwrite_all(this.fd, bytes.ptr, bytes.length, offset) };
        if (n < 0) { return Err(IoFailure.os(IoOp.Write, n)); }
        return Ok();
    }

    /// Makes written data, and the size needed to read it, durable (F_FULLFSYNC on macOS).
    /// Safety: the descriptor is owned by this value and open.
    fn syncData(borrow this) -> Result<void, IoFailure> {
        if (faultHit(IoOp.Sync)) { return Err(injected(IoOp.Sync)); }
        if (!syncsElided()) {
            let r = unsafe { cosmo_sync_data(this.fd) };
            if (r < 0) { return Err(IoFailure.os(IoOp.Sync, r as i64)); }
        }
        if (this.slot != NO_SLOT) { trackSynced(this.slot, this.rawSize()?); }
        return Ok();
    }

    /// The file's size in bytes.
    /// Safety: the descriptor is owned by this value and open.
    fn size(borrow this) -> Result<u64, IoFailure> {
        if (faultHit(IoOp.Size)) { return Err(injected(IoOp.Size)); }
        return this.rawSize();
    }

    /// Safety: the descriptor is owned by this value and open.
    fn rawSize(borrow this) -> Result<u64, IoFailure> {
        let n = unsafe { cosmo_size(this.fd) };
        if (n < 0) { return Err(IoFailure.os(IoOp.Size, n)); }
        return Ok(checkedTruncate<u64>(n)!);
    }

    /// Cuts or extends the file to `length` bytes.
    /// Safety: the descriptor is owned by this value and open.
    fn truncateTo(borrow this, length: u64) -> Result<void, IoFailure> {
        if (faultHit(IoOp.Truncate)) { return Err(injected(IoOp.Truncate)); }
        let r = unsafe { cosmo_truncate(this.fd, length) };
        if (r < 0) { return Err(IoFailure.os(IoOp.Truncate, r as i64)); }
        trackTruncated(this.slot, length);
        return Ok();
    }

    /// Safety: the descriptor is owned by this value and closed exactly once, here.
    drop {
        unsafe { cosmo_close(this.fd); }
    }
}
