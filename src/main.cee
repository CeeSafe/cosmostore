// cosmostore: command-line entry point.
//
//   cosmostore bench <dir> <objects> <size-bytes> <batch>
//       Writes <objects> objects of <size-bytes> each, committing <batch> per sync (1 = one
//       sync per PUT), then reopens the store and verifies every byte.
//   cosmostore soak <dir> <seconds> <keys> <capacity-bytes>
//       The M2 churn test (src/soak.cee, tools/soak.sh).
//   cosmostore serve <dir> <[address:]port> <credentials-file> [domain] [--tls-cert <pem> --tls-key <pem>]
//       Serves the store over the S3 API (ADR-0008), on 127.0.0.1 unless an address is given (`0.0.0.0:9000`,
//       `[::]:9000`), over TLS with a certificate chain and key (ADR-0016), reloaded when its files change
//       (ADR-0019). `--maintain-seconds` (10) and `--upload-expiry-hours` (168; 0 never) tune the upkeep. The credentials file has one
//       `access-key secret-key` pair per line. With a domain, a Host of `<bucket>.<domain>` addresses the
//       bucket as well as `/<bucket>/` paths (ADR-0011).
//   cosmostore fsck <dir>
//       Opens the store (recovery) and verifies every live object's records, extents and MD5
//       (ADR-0006). Exit status 1 if anything is wrong.

fn usage() -> never {
    Console.writeErrorLine("usage: cosmostore bench <dir> <objects> <size-bytes> <batch>");
    Console.writeErrorLine("       cosmostore fsck <dir>");
    Console.writeErrorLine("       cosmostore soak <dir> <seconds> <keys> <capacity-bytes>");
    Console.writeErrorLine(
        "       cosmostore serve <dir> <[address:]port> <credentials-file> [domain] [--tls-cert <pem> --tls-key <pem>]",
    );
    Console.writeErrorLine(
        "                        [--maintain-seconds <n>] [--upload-expiry-hours <n>]",
    );
    Process.exit(2);
}

fn die(message: StringView) -> never {
    Console.writeErrorLine(message);
    Process.exit(1);
}

fn argU64(i: usize) -> u64 {
    let text = Process.argument(i) ?? "";
    return match (text.parseInt<u64>()) {
        Some(v) => v,
        null => { usage(); }
    };
}

fn describe(e: StoreError) -> StringView => match (e) {
    StoreError.Journal(JournalError.Io(f)) => ioOpName(f.op),
    StoreError.Journal(JournalError.Corrupt(_, _)) => "journal corrupt",
    StoreError.Journal(_) => "journal error",
    StoreError.BadMeta(_, _) => "bad record meta",
    StoreError.OutOfMemory(_) => "out of memory",
    StoreError.NoSuchBucket => "no such bucket",
    StoreError.NoSuchKey => "no such key",
    StoreError.EntityTooLarge => "entity too large",
    StoreError.DataCorrupt => "data corrupt",
    StoreError.CheckpointCorrupt => "checkpoint corrupt",
    StoreError.InsufficientStorage => "insufficient storage",
    StoreError.Io(f) => ioOpName(f.op),
    _ => "store error",
};

fn objectName(into: borrow mut String, i: u64) {
    into.clear();
    into.append("obj/")!;
    into.appendNumber(i % 97)!;
    into.append("/")!;
    into.appendNumber(i)!;
}

/// A deterministic byte stream per object (xorshift64), produced in chunks.
struct Pattern {
    x: u64;

    fn forObject(i: u64) -> Pattern => Pattern { x: i.wrappingMul(0x9E3779B97F4A7C15).wrappingAdd(1) };

    /// Fills `into` with the next bytes of the stream, 8 at a time.
    fn fill(borrow mut this, into: SliceMut<u8>) {
        var k: usize = 0;
        while (k < into.length) {
            this.x = this.x ^ (this.x << 13);
            this.x = this.x ^ (this.x >> 7);
            this.x = this.x ^ (this.x << 17);
            var word = [0u8; 8];
            word.writeLE(0, this.x);
            let n = if (into.length - k < 8) into.length - k else 8;
            into[k..k + n].copyFrom(word[0..n]);
            k += n;
        }
    }
}

const CHUNK: u64 = 1048576;

fn writeRate(label: StringView, count: u64, size: u64, millis: i64) {
    Console.write(label);
    Console.write(": ");
    Console.write(count);
    Console.write(" in ");
    Console.write(millis);
    Console.write(" ms");
    if (millis > 0) {
        let ms = truncate<u64>(millis);
        Console.write(" = ");
        Console.write(count * 1000 / ms);
        Console.write(" ops/s");
        if (size > 0) {
            Console.write(", ");
            Console.write(count * size / 1048576 * 1000 / ms);
            Console.write(" MiB/s");
        }
    }
    Console.writeLine("");
}

fn bench() {
    let dir = Process.argument(2) ?? "";
    if (dir.length == 0) { usage(); }
    let count = argU64(3);
    let size = argU64(4);
    let batch = argU64(5);
    if (batch == 0) { usage(); }
    let config = StoreConfig.defaults();
    var chunk = Vector<u8>.create();
    chunk.resize(CHUNK as usize, 0)!;
    var expected = Vector<u8>.create();
    expected.resize(CHUNK as usize, 0)!;
    var name = String.create();
    let ctype = "application/octet-stream";
    {
        var store = match (ObjectStore.open(dir, config)) {
            Ok(s) => s,
            Err(e) => { die(describe(e)); }
        };
        match (store.createBucket("bench")) {
            Ok() => {}
            Err(StoreError.BucketAlreadyExists) => {}
            Err(e) => { die(describe(e)); }
        }
        let before = store.journalSyncs();
        let start = elapsedMillis();
        for (i in 0u64..count) {
            objectName(mut name, i);
            // Stream the object through a writer in chunks: inline if small, extents if not.
            var writer = match (store.newWriter()) {
                Ok(w) => w,
                Err(e) => { die(describe(e)); }
            };
            var pattern = Pattern.forObject(i);
            var left = size;
            while (left > 0) {
                let n = if (left < CHUNK) left else CHUNK;
                pattern.fill(mut chunk.viewMut()[0..n as usize]);
                match (writer.write(chunk.view()[0..n as usize])) {
                    Ok() => {}
                    Err(f) => { die(ioOpName(f.op)); }
                }
                left -= n;
            }
            let obj = match (writer.finish()) {
                Ok(o) => o,
                Err(f) => { die(ioOpName(f.op)); }
            };
            match (store.stageObject("bench", name.view(), ctype, borrow obj)) {
                Ok(_) => {}
                Err(e) => { die(describe(e)); }
            }
            if ((i + 1) % batch == 0) {
                match (store.commitStaged()) {
                    Ok(_) => {}
                    Err(e) => { die(describe(e)); }
                }
            }
        }
        match (store.commitStaged()) {
            Ok(_) => {}
            Err(e) => { die(describe(e)); }
        }
        let elapsed = elapsedMillis() - start;
        writeRate("put", count, size, elapsed);
        Console.write("journal syncs: ");
        Console.writeLine(store.journalSyncs() - before);
    }
    // Reopen (full recovery), checkpoint, reopen from the checkpoint, then stream-verify
    // every byte.
    {
        let start = elapsedMillis();
        var full = match (ObjectStore.open(dir, config)) {
            Ok(s) => s,
            Err(e) => { die(describe(e)); }
        };
        writeRate("recover (full replay)", full.recordsApplied(), 0, elapsedMillis() - start);
        let written = elapsedMillis();
        match (full.checkpoint()) {
            Ok(_) => {}
            Err(e) => { die(describe(e)); }
        }
        writeRate("checkpoint", full.objectCount() as u64, 0, elapsedMillis() - written);
    }
    let start = elapsedMillis();
    var store = match (ObjectStore.open(dir, config)) {
        Ok(s) => s,
        Err(e) => { die(describe(e)); }
    };
    writeRate("recover (checkpoint)", store.objectCount() as u64, 0, elapsedMillis() - start);
    let readStart = elapsedMillis();
    for (i in 0u64..count) {
        objectName(mut name, i);
        var reader = match (store.openReader("bench", name.view(), 0, size)) {
            Ok(r) => r,
            Err(e) => { die(describe(e)); }
        };
        var pattern = Pattern.forObject(i);
        var left = size;
        while (left > 0) {
            let n = if (left < CHUNK) left else CHUNK;
            pattern.fill(mut expected.viewMut()[0..n as usize]);
            var got: usize = 0;
            while (got < n as usize) {
                let r = match (reader.read(mut chunk.viewMut()[got..n as usize])) {
                    Ok(r) => r,
                    Err(e) => { die(describe(e)); }
                };
                if (r == 0) { die("verification failed: object too short"); }
                got += r;
            }
            if (chunk.view()[0..got] != expected.view()[0..got]) { die("verification failed: bytes differ"); }
            left -= n;
        }
    }
    writeRate("get+verify", count, size, elapsedMillis() - readStart);
}

fn main() {
    let command = Process.argument(1) ?? "";
    if (command == "bench") {
        bench();
        return;
    }
    if (command == "fsck") {
        Process.exit(fsck());
    }
    if (command == "soak") {
        Process.exit(soak());
    }
    if (command == "serve") {
        Process.exit(serve());
    }
    usage();
}

fn faultName(f: borrow VerifyFault) -> StringView => match (f) {
    VerifyFault.Corrupt => "corrupt",
    VerifyFault.Missing => "missing extent",
    VerifyFault.Mismatch => "size or MD5 mismatch",
    VerifyFault.Unreadable => "unreadable",
};

/// `cosmostore fsck <dir>`: one line per problem, then a summary; 1 if anything is wrong.
fn fsck() -> i32 {
    let dir = Process.argument(2) ?? "";
    if (dir.length == 0) { usage(); }
    let store = match (ObjectStore.open(dir, StoreConfig.defaults())) {
        Ok(s) => s,
        Err(e) => {
            Console.write("cannot open the store: ");
            Console.writeLine(describe(e));
            return 1;
        }
    };
    let report = match (store.verify()) {
        Ok(r) => r,
        Err(e) => { die(describe(e)); }
    };
    for (p in report.problems.view()) {
        Console.write(StringView.fromUtf8(p.bucket.view()) ?? "?");
        Console.write("/");
        Console.write(StringView.fromUtf8(p.key.view()) ?? "?");
        Console.write(": ");
        Console.writeLine(faultName(borrow p.fault));
    }
    Console.write("objects ");
    Console.write(report.objects);
    Console.write(", bytes ");
    Console.write(report.bytes);
    Console.write(", problems ");
    Console.write(report.problems.length);
    Console.write(", orphan extents ");
    Console.writeLine(report.orphanExtents);
    return if (report.problems.length == 0) 0 else 1;
}

/// Milliseconds on the monotonic clock, for the benchmark's durations (a wall-clock jump cannot skew them).
fn elapsedMillis() -> i64 => saturatingTruncate<i64>(Clock.monotonicNanos() / 1000000);
