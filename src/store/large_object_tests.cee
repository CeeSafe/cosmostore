// Large-object (extent) tests: ADR-0003. Expected values come from the generated source bytes.

/// inlineMax 16 KiB, extents of 64 KiB (storeConfig in object_store_tests.cee).
fn patterned(length: usize, seed: u64) -> Vector<u8> {
    var v = Vector<u8>.create();
    var x = seed.wrappingMul(0x9E3779B97F4A7C15).wrappingAdd(7);
    for (i in 0..length) {
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        v.push(truncate<u8>(x))!;
    }
    return v;
}

fn extentFiles(dir: StringView) -> u64 {
    var path = String.create();
    path.append(dir)!;
    path.append("/extents")!;
    let names = Directory.list(path.view())!;
    var n: u64 = 0;
    for (i in 0..names.length) {
        if (extentIdFromName(names[i].view()).isSome()) { n += 1; }
    }
    return n;
}

@test
fn largeInlineAndExtentBoundaries() -> Result<void, TestFailure> {
    let dir = scratchDirectory("large-boundary");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    s.createBucket("bkt")!;
    let ctype = "application/octet-stream";
    // Exactly inlineMax stays inline; one more byte goes to an extent; sizes around the
    // extent size split into one or two extents.
    let sizes = [0u64, 1, 16384, 16385, 65535, 65536, 65537, 200000];
    let files = [0u64, 0, 0, 1, 2, 3, 5, 9];
    for (i in 0..sizes.length) {
        let data = patterned(sizes[i] as usize, i as u64);
        var name = String.create();
        name.append("obj-")!;
        name.appendNumber(i)!;
        let put = s.putObject("bkt", name.view(), ctype, data.view(), PutCondition.None)!;
        let digest = Md5.of(data.view());
        Check.equalBytes(digest[..], put.md5[..])?;
        let got = s.getObject("bkt", name.view())!;
        Check.equalBytes(data.view(), got.view())?;
        Check.equalU64(files[i], extentFiles(dir.view()))?;
    }
    removeTree(dir.view());
    return Ok();
}

@test
fn largeRangeReadsAcrossExtents() -> Result<void, TestFailure> {
    let dir = scratchDirectory("large-range");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    s.createBucket("bkt")!;
    let data = patterned(300000, 42); // 5 extents: 4 x 64 KiB + 37856 bytes
    let ctype = "application/octet-stream";
    s.putObject("bkt", "big", ctype, data.view(), PutCondition.None)!;
    let points = [0u64, 1, 65535, 65536, 65537, 131072, 196607, 262144, 299999, 300000];
    for (a in 0..points.length) {
        for (b in a..points.length) {
            let got = s.getObjectRange("bkt", "big", points[a], points[b])!;
            Check.equalBytes(data.view()[points[a] as usize..points[b] as usize], got.view())?;
        }
    }
    // A range past the end is clamped.
    let tail = s.getObjectRange("bkt", "big", 299990, 999999)!;
    Check.equalU64(10, tail.length as u64)?;
    // Small reads through a reader cross extent boundaries correctly.
    var reader = s.openReader("bkt", "big", 65530, 65550)!;
    var out = Vector<u8>.create();
    var chunk = [0u8; 3];
    while (true) {
        let n = reader.read(mut chunk[..])!;
        if (n == 0) { break; }
        out.extend(chunk[0..n])!;
    }
    Check.equalBytes(data.view()[65530..65550], out.view())?;
    removeTree(dir.view());
    return Ok();
}

@test
fn largeOverwriteAndDeleteRemoveExtents() -> Result<void, TestFailure> {
    let dir = scratchDirectory("large-reap");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    s.createBucket("bkt")!;
    let ctype = "application/octet-stream";
    let big = patterned(150000, 1); // 3 extents
    s.putObject("bkt", "k", ctype, big.view(), PutCondition.None)!;
    Check.equalU64(3, extentFiles(dir.view()))?;
    let other = patterned(70000, 2); // 2 extents; the first object's 3 are reaped
    s.putObject("bkt", "k", ctype, other.view(), PutCondition.None)!;
    Check.equalU64(2, extentFiles(dir.view()))?;
    let small = patterned(100, 3); // inline; the 2 are reaped
    s.putObject("bkt", "k", ctype, small.view(), PutCondition.None)!;
    Check.equalU64(0, extentFiles(dir.view()))?;
    s.putObject("bkt", "k2", ctype, big.view(), PutCondition.None)!;
    s.deleteObject("bkt", "k2")!;
    Check.equalU64(0, extentFiles(dir.view()))?;
    // A refused conditional PUT removes the extents it wrote.
    s.putObject("bkt", "k3", ctype, big.view(), PutCondition.None)!;
    match (s.putObject("bkt", "k3", ctype, other.view(), PutCondition.IfAbsent)) {
        Err(StoreError.PreconditionFailed) => {}
        _ => { return Check.fail("If-None-Match on an existing key"); }
    }
    Check.equalU64(3, extentFiles(dir.view()))?;
    Check.equalBytes(big.view(), s.getObject("bkt", "k3")!.view())?;
    removeTree(dir.view());
    return Ok();
}

@test
fn largeRecoveryAndOrphanSweep() -> Result<void, TestFailure> {
    let dir = scratchDirectory("large-recover");
    let ctype = "application/octet-stream";
    let big = patterned(140000, 9);
    {
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        s.createBucket("bkt")!;
        s.putObject("bkt", "kept", ctype, big.view(), PutCondition.None)!;
        // An upload that finished writing but whose record never committed (a crash between
        // ObjectWriter.finish and the journal commit): its extents are orphans.
        var w = s.newWriter()!;
        w.write(big.view())!;
        let unpublished = w.finish()!;
        Check.equalU64(6, extentFiles(dir.view()))?;
    }
    let s = ObjectStore.open(dir.view(), storeConfig())!;
    Check.equalU64(3, extentFiles(dir.view()))?;
    Check.equalBytes(big.view(), s.getObject("bkt", "kept")!.view())?;
    let info = s.headObject("bkt", "kept")!;
    Check.equalU64(140000, info.size)?;
    removeTree(dir.view());
    return Ok();
}

@test
fn largeAbandonedWriterCleansUp() -> Result<void, TestFailure> {
    let dir = scratchDirectory("large-abandon");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    {
        var w = s.newWriter()!;
        let big = patterned(200000, 4);
        w.write(big.view())!;
        Check.isTrue(extentFiles(dir.view()) > 0, "the writer spilled to extents")?;
    } // dropped without finish (a client disconnect): its extents are queued for the store
    // The drop does no I/O (it may run in async code, ADR-0008), so the next reap removes them.
    s.maintain()!;
    Check.equalU64(0, extentFiles(dir.view()))?;
    // A commit reaps them too.
    {
        var w = s.newWriter()!;
        w.write(patterned(200000, 5).view())!;
    }
    s.createBucket("bkt")!;
    Check.equalU64(0, extentFiles(dir.view()))?;
    removeTree(dir.view());
    return Ok();
}

@test
fn largeCorruptExtentIsDetected() -> Result<void, TestFailure> {
    let dir = scratchDirectory("large-corrupt");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    s.createBucket("bkt")!;
    let ctype = "application/octet-stream";
    let big = patterned(100000, 5);
    s.putObject("bkt", "k", ctype, big.view(), PutCondition.None)!;
    // Flip one byte in every extent file.
    var path = String.create();
    path.append(dir.view())!;
    path.append("/extents")!;
    let names = Directory.list(path.view())!;
    for (i in 0..names.length) {
        var file = String.create();
        file.append(path.view())!;
        file.append("/")!;
        file.append(names[i].view())!;
        var bytes = readWhole(file.view());
        bytes[100] = bytes[100] ^ 0x20;
        writeWhole(file.view(), bytes.view());
    }
    match (s.getObject("bkt", "k")) {
        Err(StoreError.DataCorrupt) => {}
        _ => { return Check.fail("a corrupt extent must be reported, not served"); }
    }
    removeTree(dir.view());
    return Ok();
}

/// A copy of a directory's files: names and bytes.
struct FileSnapshot {
    names: Vector<String>;
    contents: Vector<Vector<u8>>;
}

fn snapshotFiles(dir: StringView, into: borrow mut FileSnapshot) {
    let names = Directory.list(dir)!;
    for (i in 0..names.length) {
        var path = String.create();
        path.append(dir)!;
        path.append("/")!;
        path.append(names[i].view())!;
        var name = String.create();
        name.append(names[i].view())!;
        into.names.push(name)!;
        into.contents.push(readWhole(path.view()))!;
    }
}

fn restoreFiles(dir: StringView, snapshot: borrow FileSnapshot) {
    for (i in 0..snapshot.names.length) {
        var path = String.create();
        path.append(dir)!;
        path.append("/")!;
        path.append(snapshot.names[i].view())!;
        writeWhole(path.view(), snapshot.contents[i].view());
    }
}

@test
fn largeCrashAtEveryJournalByte() -> Result<void, TestFailure> {
    // Overwrite a large object with another. For every crash point of the journal, with every
    // extent ever written still on disk (a crash happens before reaping), recovery must give
    // exactly one whole version, and the orphan sweep must leave only that version's extents.
    let source = scratchDirectory("large-crash-source");
    let ctype = "application/octet-stream";
    let v1 = patterned(90000, 11);  // 2 extents of 64 KiB max
    let v2 = patterned(140000, 12); // 3 extents (2 x 65536 + 8928)
    var extents = FileSnapshot { names: Vector<String>.create(), contents: Vector<Vector<u8>>.create() };
    var sourceExtents = String.create();
    sourceExtents.append(source.view())!;
    sourceExtents.append("/extents")!;
    {
        var s = ObjectStore.open(source.view(), storeConfig())!;
        s.createBucket("bkt")!;
        s.putObject("bkt", "k", ctype, v1.view(), PutCondition.None)!;
        snapshotFiles(sourceExtents.view(), mut extents); // v1's extents, before they are reaped
        s.putObject("bkt", "k", ctype, v2.view(), PutCondition.None)!;
        snapshotFiles(sourceExtents.view(), mut extents); // v2's
    }
    Check.equalU64(5, extents.names.length as u64)?;
    let segment = segmentPath(source.view(), 1)!;
    let whole = readWhole(segment.view());
    let dir = scratchDirectory("large-crash");
    var targetExtents = String.create();
    targetExtents.append(dir.view())!;
    targetExtents.append("/extents")!;
    var outcomes = [0u64; 3]; // none, v1, v2
    for (cut in SEGMENT_HEADER_LEN..whole.length + 1) {
        removeTree(targetExtents.view());
        Fs.ensureDirectory(targetExtents.view())!;
        restoreFiles(targetExtents.view(), borrow extents);
        writeWhole(segmentPath(dir.view(), 1)!.view(), whole.view()[0..cut]);
        let s = ObjectStore.open(dir.view(), storeConfig())!;
        let found = match (s.bucketExists("bkt")!) {
            false => null,
            true => match (s.getObject("bkt", "k")) {
                Ok(v) => Some(v),
                Err(StoreError.NoSuchKey) => null,
                Err(_) => { return Check.fail("unexpected error"); }
            },
        };
        match (found) {
            Some(v) => {
                let isV1 = v.view() == v1.view();
                let isV2 = v.view() == v2.view();
                Check.isTrue(isV1 || isV2, "the object is one whole version")?;
                Check.equalU64(if (isV1) 2 else 3, extentFiles(dir.view()))?;
                if (isV1) { outcomes[1] += 1; } else { outcomes[2] += 1; }
            }
            null => {
                Check.equalU64(0, extentFiles(dir.view()))?;
                outcomes[0] += 1;
            }
        }
    }
    Check.isTrue(outcomes[0] > 0 && outcomes[1] > 0 && outcomes[2] > 0, "every outcome is reached")?;
    removeTree(targetExtents.view());
    removeTree(dir.view());
    removeTree(sourceExtents.view());
    removeTree(source.view());
    return Ok();
}

/// ADR-0034: an extent reader is ready without I/O; an inline record is not, and `open` reads it.
@test
fn extentReadersAreReadyWithoutOpening() -> Result<void, TestFailure> {
    let dir = scratchDirectory("large-ready");
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    s.createBucket("bkt")!;
    let ctype = "application/octet-stream";
    let large = patterned(100000, 7);
    s.putObject("bkt", "large", ctype, large.view(), PutCondition.None)!;
    s.putObject("bkt", "small", ctype, "inline bytes".bytes(), PutCondition.None)!;
    // In extents: ready at once, and only once.
    var p = s.prepareReader("bkt", "large", 0, 0xFFFFFFFFFFFFFFFF)!;
    var r = match (p.takeReady()) {
        Some(reader) => reader,
        null => { return Err(TestFailure.create("an extent reader is ready")); }
    };
    Check.isTrue(p.takeReady().isNull(), "taken once")?;
    var got = Vector<u8>.create();
    var buf = Vector<u8>.create();
    buf.resize(30000, 0)!;
    while (true) {
        let n = r.read(buf.viewMut())!;
        if (n == 0) { break; }
        got.extend(buf.view()[0..n])!;
    }
    Check.equalBytes(large.view(), got.view())?;
    // Inline: not ready; open reads the record.
    var q = s.prepareReader("bkt", "small", 0, 0xFFFFFFFFFFFFFFFF)!;
    Check.isTrue(q.takeReady().isNull(), "an inline record needs reading")?;
    var inline = q.open()!;
    match (inline.takeInline()) {
        Some(b) => { Check.equalBytes("inline bytes".bytes(), b.view())?; }
        null => { return Err(TestFailure.create("an opened inline reader holds the bytes")); }
    }
    removeTree(dir.view());
    return Ok();
}
