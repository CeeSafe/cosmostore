// Bucket tags and lifecycle rules in the store (ADR-0020).

fn rule(id: StringView, prefix: StringView, days: u32) -> LifecycleRule => LifecycleRule {
    id: copyBytes(id.bytes())!,
    enabled: true,
    prefix: copyBytes(prefix.bytes())!,
    tags: Vector<Vector<u8>>.create(),
    hasSizeAbove: false,
    sizeAbove: 0,
    hasSizeBelow: false,
    sizeBelow: 0,
    expirationDays: days,
    expirationDate: 0,
    abortDays: 0,
    legacyPrefix: false,
    expiredDeleteMarker: false,
    noncurrentDays: 0,
    newerNoncurrent: 0,
    transitions: Vector<RuleTransition>.create(),
    noncurrentTransitions: Vector<RuleTransition>.create(),
};

@test
fn bucketConfigSurvivesAndGoesWithTheBucket() -> Result<void, TestFailure> {
    let dir = scratchDirectory("bucket-config");
    var rules = Vector<LifecycleRule>.create();
    rules.push(rule("all", "", 1))!;
    var blob = Vector<u8>.create();
    encodeLifecycle(rules.view(), mut blob)!;
    {
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        s.createBucket("bkt")!;
        s.setBucketConfig("bkt", BUCKET_CONFIG_TAGS, "env=prod".bytes())!;
        s.setBucketConfig("bkt", BUCKET_CONFIG_LIFECYCLE, blob.view())!;
        Check.equalBytes("env=prod".bytes(), s.bucketConfig("bkt", BUCKET_CONFIG_TAGS)!.view())?;
        match (s.setBucketConfig("none", BUCKET_CONFIG_TAGS, "a=b".bytes())) {
            Err(StoreError.NoSuchBucket) => {}
            _ => { return Check.fail("config on a missing bucket"); }
        }
    }
    for (round in 0..2) {
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        Check.equalBytes("env=prod".bytes(), s.bucketConfig("bkt", BUCKET_CONFIG_TAGS)!.view())?;
        Check.equalBytes(blob.view(), s.bucketConfig("bkt", BUCKET_CONFIG_LIFECYCLE)!.view())?;
        if (round == 0) { let _ = s.checkpoint()!; }
        if (round == 1) {
            s.setBucketConfig("bkt", BUCKET_CONFIG_TAGS, "".bytes())!; // cleared
            s.deleteBucket("bkt")!;
            s.createBucket("bkt")!;
        }
    }
    let s = ObjectStore.open(dir.view(), storeConfig())!;
    Check.equalU64(0, s.bucketConfig("bkt", BUCKET_CONFIG_TAGS)!.length as u64)?;
    Check.equalU64(0, s.bucketConfig("bkt", BUCKET_CONFIG_LIFECYCLE)!.length as u64)?; // a new bucket starts bare
    removeTree(dir.view());
    return Ok();
}

@test
fn lifecycleExpiresAndAborts() -> Result<void, TestFailure> {
    let dir = scratchDirectory("lifecycle");
    var s = ObjectStore.open(dir.view(), uploadConfig())!;
    s.createBucket("bkt")!;
    putText(mut s, "bkt", "logs/a", "a");
    putText(mut s, "bkt", "logs/b", "b");
    putText(mut s, "bkt", "keep/c", "c");
    let _ = s.putObject("bkt", "logs/big", "", patterned(100000, 1).view(), PutCondition.None)!;
    // Tagged: only `tmp=yes` objects under tmp/ expire.
    var meta = Vector<u8>.create();
    metadataAdd(mut meta, TAGS_FIELD.bytes(), "tmp=yes".bytes())!;
    var w = s.newWriter()!;
    w.write("t".bytes())!;
    let obj = w.finish()!;
    let _ = s.putFinishedWith("bkt", "tmp/tagged", "", meta.view(), "".bytes(), borrow obj, PutCondition.None)!;
    putText(mut s, "bkt", "tmp/untagged", "u");
    let upload = s.createUpload("bkt", "logs/upload", "")!;
    let _ = sendPart(mut s, "bkt", "logs/upload", upload, 1, patterned(70000, 2).view())!;
    var rules = Vector<LifecycleRule>.create();
    var logs = rule("logs", "logs/", 30);
    logs.hasSizeBelow = true;
    logs.sizeBelow = 1000; // the 100 kB object stays
    logs.abortDays = 2;
    rules.push(logs)!;
    var tmp = rule("tmp", "tmp/", 1);
    tmp.tags.push(copyBytes("tmp=yes".bytes())!)!;
    rules.push(tmp)!;
    var off = rule("off", "keep/", 1);
    off.enabled = false;
    rules.push(off)!;
    var blob = Vector<u8>.create();
    encodeLifecycle(rules.view(), mut blob)!;
    s.setBucketConfig("bkt", BUCKET_CONFIG_LIFECYCLE, blob.view())!;
    let now = Clock.unixMillis();
    // Today nothing has expired.
    let today = s.applyLifecycle(now)!;
    Check.equalU64(0, today.objectsExpired + today.uploadsAborted)?;
    // In three days: the tagged tmp object and the old upload, not the 30-day logs.
    let later = s.applyLifecycle(now + 3 * DAY_MILLIS)!;
    Check.equalU64(1, later.objectsExpired)?;
    Check.equalU64(1, later.uploadsAborted)?;
    Check.isTrue(s.headObject("bkt", "tmp/tagged").isErr(), "the tagged object expired")?;
    Check.isTrue(s.headObject("bkt", "tmp/untagged").isOk(), "the untagged one stays")?;
    Check.equalU64(0, s.uploadCount() as u64)?;
    // In 32 days: the small logs; the big one, and the disabled rule's object, stay.
    let month = s.applyLifecycle(now + 32 * DAY_MILLIS)!;
    Check.equalU64(2, month.objectsExpired)?;
    Check.isTrue(s.headObject("bkt", "logs/big").isOk(), "above the size ceiling")?;
    Check.isTrue(s.headObject("bkt", "keep/c").isOk(), "a disabled rule")?;
    Check.equalU64(3, s.objectCount() as u64)?;
    // A date rule expires from its date on.
    var dated = rule("dated", "keep/", 0);
    dated.expirationDate = now + 5 * DAY_MILLIS;
    var one = Vector<LifecycleRule>.create();
    one.push(dated)!;
    encodeLifecycle(one.view(), mut blob)!;
    s.setBucketConfig("bkt", BUCKET_CONFIG_LIFECYCLE, blob.view())!;
    Check.equalU64(0, s.applyLifecycle(now + 4 * DAY_MILLIS)!.objectsExpired)?;
    Check.equalU64(1, s.applyLifecycle(now + 5 * DAY_MILLIS)!.objectsExpired)?;
    removeTree(dir.view());
    return Ok();
}

/// A bucket policy (ADR-0043) is kept as it was put: through recovery from the journal and from a format 7
/// checkpoint, listed by `bucketPolicies`, cleared, and gone with its bucket.
@test
fn bucketPolicySurvivesAndGoesWithTheBucket() -> Result<void, TestFailure> {
    let dir = scratchDirectory("bucket-policy");
    let doc =
        "{\"Statement\": {\"Effect\": \"Allow\", \"Principal\": \"*\", \"Action\": \"s3:GetObject\", \"Resource\": \"arn:aws:s3:::pub/*\"}}";
    {
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        s.createBucket("pub")!;
        s.createBucket("other")!;
        s.createBucket("plain")!;
        s.setBucketConfig("pub", BUCKET_CONFIG_POLICY, doc.bytes())!;
        s.setBucketConfig("other", BUCKET_CONFIG_POLICY, "{\"x\": 1}".bytes())!; // the store keeps any bytes
        // At most 20 KiB, as S3 takes.
        var big = Vector<u8>.create();
        big.resize(MAX_STORED_POLICY_BYTES + 1, 'x')!;
        match (s.setBucketConfig("plain", BUCKET_CONFIG_POLICY, big.view())) {
            Err(StoreError.MetadataTooLarge) => {}
            _ => { return Check.fail("a policy over 20 KiB"); }
        }
        match (s.setBucketConfig("plain", 9, "x".bytes())) {
            Err(StoreError.InvalidKey) => {}
            _ => { return Check.fail("a kind of configuration there is not"); }
        }
    }
    for (round in 0..3) {
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        Check.equalBytes(doc.bytes(), s.bucketConfig("pub", BUCKET_CONFIG_POLICY)!.view())?;
        Check.equalU64(0, s.bucketConfig("plain", BUCKET_CONFIG_POLICY)!.length as u64)?;
        let all = s.bucketPolicies()!;
        if (round < 2) {
            Check.equalU64(2, all.names.length as u64)?;
            let at: usize = if (all.names[0].view() == "pub".bytes()) 0 else 1;
            Check.equalBytes("pub".bytes(), all.names[at].view())?;
            Check.equalBytes(doc.bytes(), all.documents[at].view())?;
            Check.equalBytes("other".bytes(), all.names[1 - at].view())?;
        } else {
            Check.equalU64(1, all.names.length as u64)?;
        }
        if (round == 0) { let _ = s.checkpoint()!; } // format 7 holds the policies
        if (round == 1) {
            s.setBucketConfig("other", BUCKET_CONFIG_POLICY, "".bytes())!; // cleared
            let _ = s.checkpoint()!;
        }
    }
    {
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        s.deleteBucket("pub")!;
        s.createBucket("pub")!;
    }
    let s = ObjectStore.open(dir.view(), storeConfig())!;
    Check.equalU64(0, s.bucketConfig("pub", BUCKET_CONFIG_POLICY)!.length as u64)?; // a new bucket starts bare
    Check.equalU64(0, s.bucketPolicies()!.names.length as u64)?;
    removeTree(dir.view());
    return Ok();
}

/// A public-access block (ADR-0044) is one byte of settings: through recovery from the journal and from a format 8
/// checkpoint, cleared, and gone with its bucket. A block with every setting off is still a block.
@test
fn publicAccessBlockSurvivesAndGoesWithTheBucket() -> Result<void, TestFailure> {
    let dir = scratchDirectory("public-access-block");
    {
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        s.createBucket("shut")!;
        s.createBucket("bare")!;
        s.createBucket("plain")!;
        s.setBucketConfig("shut", BUCKET_CONFIG_PUBLIC_ACCESS, [12u8][..])!;
        s.setBucketConfig("bare", BUCKET_CONFIG_PUBLIC_ACCESS, [0u8][..])!;
        match (s.setBucketConfig("plain", BUCKET_CONFIG_PUBLIC_ACCESS, [16u8][..])) {
            Err(StoreError.InvalidKey) => {}
            _ => { return Check.fail("a setting there is not"); }
        }
        match (s.setBucketConfig("plain", BUCKET_CONFIG_PUBLIC_ACCESS, [1u8, 2u8][..])) {
            Err(StoreError.InvalidKey) => {}
            _ => { return Check.fail("two bytes"); }
        }
        match (s.setBucketConfig("plain", 9, "x".bytes())) {
            Err(StoreError.InvalidKey) => {}
            _ => { return Check.fail("a kind of configuration there is not"); }
        }
    }
    for (round in 0..3) {
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        Check.equalBytes([12u8][..], s.bucketConfig("shut", BUCKET_CONFIG_PUBLIC_ACCESS)!.view())?;
        Check.equalU64(0, s.bucketConfig("plain", BUCKET_CONFIG_PUBLIC_ACCESS)!.length as u64)?;
        let bare = s.bucketConfig("bare", BUCKET_CONFIG_PUBLIC_ACCESS)!;
        if (round < 2) {
            Check.equalBytes([0u8][..], bare.view())?;
        } else {
            Check.equalU64(0, bare.length as u64)?;
        }
        if (round == 0) { let _ = s.checkpoint()!; } // format 8 holds the blocks
        if (round == 1) {
            s.setBucketConfig("bare", BUCKET_CONFIG_PUBLIC_ACCESS, "".bytes())!; // cleared
            let _ = s.checkpoint()!;
        }
    }
    {
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        s.deleteBucket("shut")!;
        s.createBucket("shut")!;
    }
    let s = ObjectStore.open(dir.view(), storeConfig())!;
    Check.equalU64(0, s.bucketConfig("shut", BUCKET_CONFIG_PUBLIC_ACCESS)!.length as u64)?; // a new bucket starts bare
    removeTree(dir.view());
    return Ok();
}

@test
fn defaultEncryptionSurvivesReplayAndCheckpoints() -> Result<void, TestFailure> {
    let dir = scratchDirectory("bucket-encryption");
    {
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        s.createBucket("bkt")!;
        s.createBucket("other")!;
        Check.equalU64(0, s.encryptedBucketCount())?;
        // `AES256`, `aws:kms` or `aws:kms <id>`, or nothing (ADR-0046 §5, ADR-0055).
        Check.isTrue(s.setBucketConfig("bkt", BUCKET_CONFIG_ENCRYPTION, "DES".bytes()).isErr(), "refused")?;
        Check.isTrue(s.setBucketConfig("bkt", BUCKET_CONFIG_ENCRYPTION, "aws:kms:dsse".bytes()).isErr(), "refused")?;
        s.setBucketConfig("other", BUCKET_CONFIG_ENCRYPTION, "aws:kms orders".bytes())!;
        s.setBucketConfig("other", BUCKET_CONFIG_ENCRYPTION, "".bytes())!;
        s.setBucketConfig("bkt", BUCKET_CONFIG_ENCRYPTION, "AES256".bytes())!;
        Check.equalU64(1, s.encryptedBucketCount())?;
    }
    {
        // From the journal.
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        Check.equalBytes("AES256".bytes(), s.bucketConfig("bkt", BUCKET_CONFIG_ENCRYPTION)!.view())?;
        Check.equalU64(0, s.bucketConfig("other", BUCKET_CONFIG_ENCRYPTION)!.length as u64)?;
        s.checkpoint()!;
    }
    {
        // From a checkpoint; then cleared.
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        Check.equalBytes("AES256".bytes(), s.bucketConfig("bkt", BUCKET_CONFIG_ENCRYPTION)!.view())?;
        Check.equalU64(1, s.encryptedBucketCount())?;
        s.setBucketConfig("bkt", BUCKET_CONFIG_ENCRYPTION, "".bytes())!;
        s.checkpoint()!;
    }
    var s = ObjectStore.open(dir.view(), storeConfig())!;
    Check.equalU64(0, s.encryptedBucketCount())?;
    removeTree(dir.view());
    return Ok();
}

fn transitionTo(days: u32, newer: u32, named: StringView) -> RuleTransition =>
    RuleTransition { days: days, date: 0, newer: newer, storageClass: copyBytes(named.bytes())! };

fn classOf(s: borrow ObjectStore, bucket: StringView, key: StringView, id: [u8; 16]?) -> Vector<u8> =>
    storageClassIn(s.headObjectOf(bucket, key, id)!.metadata.view())!;

/// Lifecycle transitions (ADR-0090 §2): a current object moves along S3's waterfall as its days pass, never back,
/// and a noncurrent version by the days since it stopped being current; the class is a SetTags record, so it is kept
/// through recovery.
@test
fn lifecycleTransitionsRecordClasses() -> Result<void, TestFailure> {
    let dir = scratchDirectory("lifecycle-transitions");
    let now = Clock.unixMillis();
    {
        var s = ObjectStore.open(dir.view(), uploadConfig())!;
        s.createBucket("bkt")!;
        putText(mut s, "bkt", "a", "a");
        putText(mut s, "bkt", "b", "b");
        var rules = Vector<LifecycleRule>.create();
        var tiers = rule("tiers", "", 0);
        tiers.hasSizeAbove = true;
        tiers.hasSizeAbove = true; // a size filter: S3's 128 KB floor does not apply
        tiers.transitions.push(transitionTo(30, 0, "STANDARD_IA"))!;
        tiers.transitions.push(transitionTo(90, 0, "GLACIER_IR"))!;
        rules.push(tiers)!;
        var blob = Vector<u8>.create();
        encodeLifecycle(rules.view(), mut blob)!;
        let back = decodeLifecycle(blob.view())!;
        Check.equalU64(2, back[0].transitions.length as u64)?;
        Check.equalBytes("GLACIER_IR".bytes(), back[0].transitions[1].storageClass.view())?;
        s.setBucketConfig("bkt", BUCKET_CONFIG_LIFECYCLE, blob.view())!;
        Check.equalU64(0, s.applyLifecycle(now)!.transitioned)?;
        Check.equalU64(2, s.applyLifecycle(now + 31 * DAY_MILLIS)!.transitioned)?;
        Check.equalBytes("STANDARD_IA".bytes(), classOf(borrow s, "bkt", "a", null).view())?;
        Check.equalU64(0, s.applyLifecycle(now + 32 * DAY_MILLIS)!.transitioned)?;
        Check.equalU64(2, s.applyLifecycle(now + 91 * DAY_MILLIS)!.transitioned)?;
        Check.equalBytes("GLACIER_IR".bytes(), classOf(borrow s, "bkt", "b", null).view())?;
        // Never back up the waterfall, and nothing more to do.
        Check.equalU64(0, s.applyLifecycle(now + 400 * DAY_MILLIS)!.transitioned)?;
        // Without a size filter, S3's floor: objects under 128 KB stay where they are.
        s.createBucket("floor")!;
        putText(mut s, "floor", "tiny", "t");
        let _ = s.putObject("floor", "large", "", patterned(200000, 3).view(), PutCondition.None)!;
        var floor = Vector<LifecycleRule>.create();
        var plain = rule("plain", "", 0);
        plain.transitions.push(transitionTo(30, 0, "STANDARD_IA"))!;
        floor.push(plain)!;
        encodeLifecycleWith(floor.view(), true, mut blob)!;
        Check.isTrue(lifecycleAll128k(blob.view()), "the bucket's minimum kept")?;
        Check.equalU64(1, decodeLifecycle(blob.view())!.length as u64)?;
        s.setBucketConfig("floor", BUCKET_CONFIG_LIFECYCLE, blob.view())!;
        Check.equalU64(1, s.applyLifecycle(now + 31 * DAY_MILLIS)!.transitioned)?;
        Check.equalU64(0, classOf(borrow s, "floor", "tiny", null).length as u64)?;
        Check.equalBytes("STANDARD_IA".bytes(), classOf(borrow s, "floor", "large", null).view())?;
        // A noncurrent version moves by the days since a newer one was written; the current one stays.
        s.createBucket("ver")!;
        setVersioning(mut s, "ver", VERSIONING_ENABLED);
        let old = putVersion(mut s, "ver", "k", "one").versionId;
        let _ = putVersion(mut s, "ver", "k", "two");
        var noncurrent = rule("old", "", 0);
        noncurrent.hasSizeAbove = true;
        noncurrent.noncurrentTransitions.push(transitionTo(30, 0, "ONEZONE_IA"))!;
        var one = Vector<LifecycleRule>.create();
        one.push(noncurrent)!;
        encodeLifecycle(one.view(), mut blob)!;
        s.setBucketConfig("ver", BUCKET_CONFIG_LIFECYCLE, blob.view())!;
        Check.equalU64(1, s.applyLifecycle(now + 31 * DAY_MILLIS)!.transitioned)?;
        Check.equalBytes("ONEZONE_IA".bytes(), classOf(borrow s, "ver", "k", Some(old)).view())?;
        Check.equalU64(0, classOf(borrow s, "ver", "k", null).length as u64)?;
    }
    // Recovery keeps the classes, from the journal and from a checkpoint (the M12 exit review's C2).
    {
        var s = ObjectStore.open(dir.view(), uploadConfig())!;
        Check.equalBytes("GLACIER_IR".bytes(), classOf(borrow s, "bkt", "a", null).view())?;
        Check.isTrue(s.checkpoint()!, "a checkpoint")?;
    }
    let s = ObjectStore.open(dir.view(), uploadConfig())!;
    Check.equalBytes("GLACIER_IR".bytes(), classOf(borrow s, "bkt", "a", null).view())?;
    Check.equalBytes("STANDARD_IA".bytes(), classOf(borrow s, "floor", "large", null).view())?;
    removeTree(dir.view());
    return Ok();
}

/// A transition's record, cut at every byte (ADR-0004): recovery gives the version its old class or its new one,
/// never anything else.
@test
fn transitionCrashAtEveryByteIsConsistent() -> Result<void, TestFailure> {
    let source = scratchDirectory("transition-crash-source");
    let now = Clock.unixMillis();
    {
        var s = ObjectStore.open(source.view(), storeConfig())!;
        s.createBucket("bkt")!;             // record 1
        putText(mut s, "bkt", "k", "body"); // 2
        var rules = Vector<LifecycleRule>.create();
        var tiers = rule("tiers", "", 0);
        tiers.hasSizeAbove = true;
        tiers.hasSizeAbove = true; // a size filter: S3's 128 KB floor does not apply
        tiers.transitions.push(transitionTo(30, 0, "STANDARD_IA"))!;
        rules.push(tiers)!;
        var blob = Vector<u8>.create();
        encodeLifecycle(rules.view(), mut blob)!;
        s.setBucketConfig("bkt", BUCKET_CONFIG_LIFECYCLE, blob.view())!;           // 3
        Check.equalU64(1, s.applyLifecycle(now + 31 * DAY_MILLIS)!.transitioned)?; // 4
    }
    let segment = segmentPath(source.view(), 1)!;
    let whole = readWhole(segment.view());
    let dir = scratchDirectory("transition-crash");
    let target = segmentPath(dir.view(), 1)!;
    var last: u64 = 0;
    for (cut in SEGMENT_HEADER_LEN..whole.length + 1) {
        writeWhole(target.view(), whole.view()[0..cut]);
        let s = ObjectStore.open(dir.view(), storeConfig())!;
        let records = s.recordsApplied();
        Check.isTrue(records >= last, "recovery never goes backwards as the cut grows")?;
        last = records;
        if (records < 2) { continue; }
        let named = classOf(borrow s, "bkt", "k", null);
        if (records >= 4) {
            Check.equalBytes("STANDARD_IA".bytes(), named.view())?;
        } else {
            Check.equalU64(0, named.length as u64)?;
        }
    }
    Check.equalU64(4, last)?;
    removeTree(source.view());
    removeTree(dir.view());
    return Ok();
}

/// One version with no room in its metadata for a storage class (the M12 exit review's A1) is skipped by its
/// transition; the run goes on, and another bucket's objects still expire.
@test
fn lifecycleSkipsAVersionWithNoRoomForItsClass() -> Result<void, TestFailure> {
    let dir = scratchDirectory("lifecycle-full-metadata");
    var s = ObjectStore.open(dir.view(), uploadConfig())!;
    s.createBucket("aaa")!;
    s.createBucket("zzz")!;
    var meta = Vector<u8>.create();
    var big = Vector<u8>.create();
    big.resize(MAX_METADATA_BYTES - 40, 'x')!;
    metadataAdd(mut meta, "cache-control".bytes(), big.view())!;
    Check.isTrue(meta.length <= MAX_METADATA_BYTES, "the object is within the limit")?;
    var w = s.newWriter()!;
    w.write("f".bytes())!;
    let obj = w.finish()!;
    let _ = s.putFinishedWith("aaa", "full", "", meta.view(), "".bytes(), borrow obj, PutCondition.None)!;
    putText(mut s, "aaa", "small", "s");
    putText(mut s, "zzz", "old", "o");
    var moved = Vector<LifecycleRule>.create();
    var tiers = rule("tiers", "", 0);
    tiers.hasSizeAbove = true;
    tiers.transitions.push(transitionTo(30, 0, "GLACIER_IR"))!;
    moved.push(tiers)!;
    var blob = Vector<u8>.create();
    encodeLifecycle(moved.view(), mut blob)!;
    s.setBucketConfig("aaa", BUCKET_CONFIG_LIFECYCLE, blob.view())!;
    var expire = Vector<LifecycleRule>.create();
    expire.push(rule("old", "", 1))!;
    encodeLifecycle(expire.view(), mut blob)!;
    s.setBucketConfig("zzz", BUCKET_CONFIG_LIFECYCLE, blob.view())!;
    let report = s.applyLifecycle(Clock.unixMillis() + 31 * DAY_MILLIS)!;
    Check.equalU64(1, report.transitioned)?;   // the small one; the full one is skipped
    Check.equalU64(1, report.objectsExpired)?; // the other bucket's object still expires
    Check.equalU64(0, classOf(borrow s, "aaa", "full", null).length as u64)?;
    Check.equalBytes("GLACIER_IR".bytes(), classOf(borrow s, "aaa", "small", null).view())?;
    removeTree(dir.view());
    return Ok();
}

/// The requester a configuration records (ADR-0094 §1): logging v2, inventory v2 and replication v3 carry it, written
/// only with one; the older versions still read, with none.
@test
fn configurationsRecordTheirRequester() -> Result<void, TestFailure> {
    // Logging.
    var t = LoggingTarget {
        bucket: copyBytes("logs".bytes())!,
        prefix: copyBytes("in/".bytes())!,
        requester: Vector<u8>.create(),
        keys: LOG_KEYS_SIMPLE,
    };
    var blob = Vector<u8>.create();
    encodeLogging(borrow t, mut blob)!;
    Check.equalU64(1, blob[0] as u64)?;
    Check.equalU64(0, decodeLogging(blob.view())!.requester.length as u64)?;
    t.requester.extend("user reader R1".bytes())!;
    blob.clear();
    encodeLogging(borrow t, mut blob)!;
    Check.equalU64(2, blob[0] as u64)?;
    Check.equalBytes("user reader R1".bytes(), decodeLogging(blob.view())!.requester.view())?;
    // Inventory.
    var configs = Vector<InventoryConfig>.create();
    configs.push(InventoryConfig {
        id: copyBytes("daily".bytes())!,
        enabled: true,
        destination: copyBytes("reports".bytes())!,
        prefix: Vector<u8>.create(),
        days: 1,
        allVersions: false,
        filter: Vector<u8>.create(),
        fields: 0,
        requester: copyBytes("role auditor".bytes())!,
    })!;
    blob.clear();
    encodeInventory(configs.view(), mut blob)!;
    Check.equalU64(2, blob[0] as u64)?;
    Check.equalBytes("role auditor".bytes(), decodeInventory(blob.view())![0].requester.view())?;
    configs[0].requester.clear();
    blob.clear();
    encodeInventory(configs.view(), mut blob)!;
    Check.equalU64(1, blob[0] as u64)?;
    Check.equalU64(0, decodeInventory(blob.view())![0].requester.length as u64)?;
    // Replication: each rule carries it; with a class too (v3 holds both).
    var rules = Vector<ReplicationRule>.create();
    rules.push(ReplicationRule {
        id: copyBytes("all".bytes())!,
        priority: 1,
        enabled: true,
        prefix: Vector<u8>.create(),
        deleteMarkers: false,
        destination: copyBytes("dst".bytes())!,
        storageClass: copyBytes("STANDARD_IA".bytes())!,
        requester: copyBytes("user writer W1".bytes())!,
    })!;
    blob.clear();
    encodeReplication(rules.view(), mut blob)!;
    Check.equalU64(3, blob[0] as u64)?;
    let back = decodeReplication(blob.view())!;
    Check.equalBytes("user writer W1".bytes(), back[0].requester.view())?;
    Check.equalBytes("STANDARD_IA".bytes(), back[0].storageClass.view())?;
    rules[0].requester.clear();
    blob.clear();
    encodeReplication(rules.view(), mut blob)!;
    Check.equalU64(2, blob[0] as u64)?;
    Check.equalU64(0, decodeReplication(blob.view())![0].requester.length as u64)?;
    return Ok();
}
