// The embedded object store: one journal shard plus the v0 in-memory index (ROADMAP M1).
//
// Every change follows one path: build the record, stage it, commit the batch (one write, one
// sync), then apply it to the index with `applyRecord`, the same function recovery replays.
// So the live state and the recovered state are the same function of the journal.

struct StoreConfig {
    journal: JournalConfig;
    /// Objects up to this size are stored inline in the journal; larger ones go to extents.
    inlineMaxBytes: usize;
    /// The largest extent file (ADR-0003).
    extentMaxBytes: u64;
    /// The largest object a single PUT may store (S3: 5 GiB).
    maxObjectBytes: u64;
    /// `maintain` checkpoints once this many journal bytes were committed since the last
    /// checkpoint (0: never). It bounds recovery's replay (ADR-0005).
    checkpointEveryBytes: u64;
    /// A sealed segment covered by the checkpoint is compacted when its live inline bytes are
    /// below this percentage of its size.
    compactBelowLivePercent: u64;
    /// The most live bytes one `compact` call copies.
    compactMaxCopyBytes: u64;
    /// The most bytes the store may occupy, journal and extents together (0: no limit beyond the volume's). Writes
    /// also stop when the volume's available space, measured at open and each upkeep round, would fall into the
    /// reserve (ADR-0006, ADR-0040).
    capacityBytes: u64;
    /// Kept free below `capacityBytes`, and on the volume, for what frees space or keeps the store recoverable:
    /// deletes, checkpoints and compaction never count against it, writes do (ADR-0006, ADR-0040).
    reserveBytes: u64;
    /// The least size of a multipart upload's parts, all but the last (S3: 5 MiB), and the largest object an upload
    /// may complete (S3: 5 TiB). ADR-0009.
    minPartBytes: u64;
    maxUploadBytes: u64;
    /// `maintain` aborts uploads started longer ago than this (0: never), so an abandoned upload does not keep its
    /// parts forever (ADR-0017).
    uploadExpiryMillis: u64;
    /// How often `maintain` applies buckets' lifecycle rules (0: never); S3 runs them about daily (ADR-0020).
    lifecycleEveryMillis: u64;

    fn defaults() -> StoreConfig => StoreConfig {
        journal: JournalConfig.defaults(),
        inlineMaxBytes: 131072,
        extentMaxBytes: 67108864,
        maxObjectBytes: 5368709120,
        checkpointEveryBytes: 67108864,
        compactBelowLivePercent: 50,
        compactMaxCopyBytes: 67108864,
        capacityBytes: 0,
        reserveBytes: 268435456,
        minPartBytes: 5242880,
        maxUploadBytes: 5497558138880,
        uploadExpiryMillis: 604800000, // 7 days
        lifecycleEveryMillis: 3600000, // an hour
    };
}

enum StoreError {
    @from Journal(JournalError),
    /// A journal record whose meta does not decode: (segment, offset).
    BadMeta(u64, u64),
    @from OutOfMemory(AllocError),
    /// A cluster shard's replica that does not lead is asked to write (ADR-0058).
    NotLeader,
    /// What a cluster shard cannot replicate yet: extents (ADR-0058 §10, until M6 item 5).
    NotReplicated,
    /// A coded extent this replica holds only a piece of, noted as wanted for decoding (ADR-0064 §5).
    ExtentWanted,
    InvalidBucketName,
    InvalidKey,
    NoSuchBucket,
    BucketAlreadyExists,
    BucketNotEmpty,
    NoSuchKey,
    EntityTooLarge,
    PreconditionFailed,
    /// Extent or directory I/O failed.
    Io(IoFailure),
    /// Stored bytes do not match their checksum.
    DataCorrupt,
    /// The newest checkpoint fails its checks (ADR-0005).
    CheckpointCorrupt,
    /// The write would take the store into its reserve (ADR-0006); deletes still work.
    InsufficientStorage,
    /// Multipart (ADR-0009): no such upload for this bucket and key; a named part is missing or has another ETag;
    /// parts not in ascending order; a part other than the last below `minPartBytes`; a part number outside 1-10000.
    NoSuchUpload,
    InvalidPart,
    InvalidPartOrder,
    EntityTooSmall,
    InvalidPartNumber,
    /// The stored fields are larger than MAX_METADATA_BYTES (ADR-0012).
    MetadataTooLarge,
    /// A completed object's checksum is not the one the client named (ADR-0015).
    BadDigest,
    /// The key has no version with the id asked for (ADR-0041).
    NoSuchVersion,
    /// The version asked for is a delete marker: it has nothing to read.
    MethodNotAllowed,
    /// The bucket's state does not allow the change: object lock needs versioning enabled, and keeps it so
    /// (ADR-0047).
    InvalidBucketState,
    /// The version is under retention or a legal hold: it stays, and so does its retention.
    ObjectLocked,
    /// The bucket has no object lock configuration: its versions cannot be locked.
    ObjectLockOff,
    /// The write would take the bucket past its quota (ADR-0052).
    QuotaExceeded,
}

fn sio<T>(r: Result<T, IoFailure>) -> Result<T, StoreError> => match (r) {
    Ok(v) => Ok(v),
    Err(e) => Err(if (e.op == IoOp.Read && e.errno == -1) StoreError.DataCorrupt else StoreError.Io(e)),
};

/// A write's precondition, checked atomically with the write.
enum PutCondition {
    None,
    /// If-None-Match: * — only if the key has no current object.
    IfAbsent,
    /// If-Match on the generation (the LSN of the current version).
    IfGeneration(u64),
}

/// A bucket in a listing.
struct BucketEntry {
    name: Vector<u8>;
    createdMillis: i64;
    /// A directory bucket (ADR-0080).
    directory: bool;
}

struct BucketInfo {
    /// The bucket's number in index keys (ADR-0027): given in memory by `StoreState.addBucket`, never on disk.
    number: u32;
    createdMillis: i64;
    objects: u64;
    /// The bytes of the bucket's versions, as S3 reports their sizes (ADR-0052). Counted as records are applied,
    /// and again from a checkpoint's objects: never stored.
    bytes: u64;
    /// The bucket's quota as it is stored: 16 bytes, the most bytes and the most versions (0: no limit); empty for
    /// none (ADR-0052).
    quota: Vector<u8>;
    /// The bucket's default encryption (ADR-0046 §5): `AES256` for SSE-S3, empty for none.
    encryption: Vector<u8>;
    /// Its server access logging (ADR-0072), as stored; empty for none.
    logging: Vector<u8>;
    /// Its website configuration (ADR-0073), as stored; empty for none.
    website: Vector<u8>;
    /// Its inventory configurations (ADR-0074), as stored; empty for none.
    inventory: Vector<u8>;
    /// Its access points (ADR-0076), as stored; empty for none.
    accessPoints: Vector<u8>;
    /// Its replication rules (ADR-0077), as stored; empty for none.
    replication: Vector<u8>;
    /// The replications a remote destination refused (ADR-0077 §7), as stored; empty for none.
    replicationFailures: Vector<u8>;
    /// The bucket's tags (canonical, as object tags are) and lifecycle rules (`encodeLifecycle`); empty for none
    /// (ADR-0020).
    tags: Vector<u8>;
    lifecycle: Vector<u8>;
    /// VERSIONING_OFF, VERSIONING_ENABLED or VERSIONING_SUSPENDED (ADR-0041).
    versioning: u8;
    /// The bucket policy's JSON as it was put; empty for none (ADR-0043).
    policy: Vector<u8>;
    /// The public-access block: empty for none, or one byte of the PUBLIC_ACCESS bits (ADR-0044).
    publicAccess: Vector<u8>;
    /// The bucket's ACL as it is stored; empty for the private one (ADR-0045).
    acl: Vector<u8>;
    /// The object lock configuration as it is stored; empty for a bucket without object lock (ADR-0047).
    objectLock: Vector<u8>;
    /// The notification rules as they are stored; empty for none (ADR-0048).
    notification: Vector<u8>;
    /// The CORS rules as they are stored; empty for none (ADR-0049).
    cors: Vector<u8>;
    /// A directory bucket's zone id (ADR-0080 §2), from its BucketCreate record; empty for a general-purpose bucket.
    zone: Vector<u8>;
}

/// Space use of one segment, for compaction (ADR-0005). `liveBytes` counts the records that
/// hold the inline payload of a current version: once a checkpoint covers the segment, they are
/// all that must be copied before it can be removed.
struct SegmentUsage {
    totalBytes: u64;
    liveBytes: u64;
}

/// What `compact` did.
struct CompactStats {
    segmentsRemoved: u64;
    bytesFreed: u64;
    /// Live inline payloads copied into Relocate records, and their bytes.
    relocated: u64;
    bytesCopied: u64;
}

/// The store's work since it opened, for the stats endpoint and benchmarks (ADR-0021): from these, syncs per 1,000
/// writes and write amplification (bytes written per payload byte accepted).
struct StoreCounters {
    /// Object and part bytes accepted for commit.
    payloadBytes: u64;
    /// Bytes written: journal records (inline payloads included), extent files (headers included), checkpoints.
    journalBytesWritten: u64;
    extentBytesWritten: u64;
    checkpointBytesWritten: u64;
    /// Live inline payload bytes compaction copied (they are in journalBytesWritten too).
    compactionBytesCopied: u64;
    segmentsCompacted: u64;
    checkpoints: u64;
    /// Upkeep's holds of the store (ADR-0029): each checkpoint step and each `upkeep`, how many took
    /// UPKEEP_SLOW_MICROS or more, and the longest, in microseconds.
    upkeepHolds: u64;
    upkeepSlowHolds: u64;
    upkeepLongestMicros: u64;
}

/// What `maintain` did.
struct MaintenanceReport {
    checkpointed: bool;
    compaction: CompactStats;
    /// Uploads aborted for their age.
    uploadsExpired: u64;
    /// What lifecycle rules did this time (zeros when they did not run).
    lifecycle: LifecycleReport;
    /// How long each part held the store, in microseconds (ADR-0029); the checkpoint's only when it ran here.
    reapMicros: u64;
    checkpointMicros: u64;
    compactionMicros: u64;
    lifecycleMicros: u64;
    totalMicros: u64;
}

/// One bucket, for the admin API (ADR-0054): what it holds, its quota (0: no limit), its versioning, and which
/// configurations it has, as bits in the order policy, ACL, public-access block, object lock, lifecycle rules,
/// notification rules, CORS rules.
struct BucketSummary {
    name: Vector<u8>;
    createdMillis: i64;
    objects: u64;
    bytes: u64;
    maxBytes: u64;
    maxObjects: u64;
    versioning: u8;
    set: u32;
}

/// The buckets that have a policy, and their policies' JSON (ADR-0043).
struct BucketPolicies {
    names: Vector<Vector<u8>>;
    documents: Vector<Vector<u8>>;
}

/// What one application of the lifecycle rules did.
struct LifecycleReport {
    /// Current objects expired: deleted, or, in a bucket with versioning, put under a delete marker.
    objectsExpired: u64;
    uploadsAborted: u64;
    /// Noncurrent versions removed, and delete markers removed that were their key's only version (ADR-0042).
    versionsExpired: u64;
    markersRemoved: u64;
    /// Versions moved to another storage class by a transition (ADR-0090 §2).
    transitioned: u64;
}

/// A version a transition moves: its key, id and new class.
struct ClassMove {
    key: Vector<u8>;
    versionId: [u8; 16];
    storageClass: Vector<u8>;
}

/// A live inline version that compaction copies.
struct Relocation {
    bucket: Vector<u8>;
    key: Vector<u8>;
    versionId: [u8; 16];
    generation: u64;
    segment: u64;
    recordOffset: u64;
    recordLength: u32;
    payloadLength: u32;
}

/// A compaction in steps (ADR-0029): `ObjectStore.beginCompaction`, `compactionPlanStep` until the index is planned,
/// then `readBatch` (without the store) and `compactionCopyStep` (under it) until every copy is made, and
/// `finishCompaction`.
struct CompactionJob {
    /// The chosen segments, with their files' paths for `readBatch`.
    chosen: HashMap<u64, String>;
    plan: Vector<Relocation>;
    /// The last index key planned (null: none yet).
    planned: IndexKey?;
    /// The next copy to read.
    next: usize;
    /// The records read for the next copy step: `plan[batchStart..]`, in order.
    batch: Vector<Vector<u8>>;
    batchStart: usize;
    stats: CompactStats;

    /// Reads and verifies the next copies' records, about `maxBytes` of them, from their segments' files (I/O,
    /// without the store: only compaction removes segments, and it has not yet). Returns whether it read any.
    fn readBatch(borrow mut this, maxBytes: u64) -> Result<bool, StoreError> {
        this.batch.clear();
        this.batchStart = this.next;
        var bytes: u64 = 0;
        while (this.next < this.plan.length && (bytes == 0 || bytes < maxBytes)) {
            let r = borrow this.plan[this.next];
            let path = match (this.chosen.get(borrow r.segment)) {
                Some(p) => p.view(),
                null => { return Err(StoreError.DataCorrupt); } // planned only from chosen segments
            };
            let record = match (readRecordFile(path, r.segment, r.recordOffset, r.recordLength)) {
                Ok(b) => b,
                Err(JournalError.Corrupt(_, _)) => { return Err(StoreError.DataCorrupt); }
                Err(e) => { return Err(StoreError.Journal(e)); }
            };
            bytes += record.length as u64;
            this.batch.push(record)?;
            this.next += 1;
        }
        return Ok(this.batch.length > 0);
    }
}

/// What HEAD returns.
struct ObjectInfo {
    size: u64;
    mtimeMillis: i64;
    md5: [u8; 16];
    generation: u64;
    contentType: Vector<u8>;
    /// A multipart object's part count (its ETag is `md5-parts`), else 0.
    parts: u32;
    /// User metadata and stored headers (ADR-0012), as a blob (`metadataPairs` reads it).
    metadata: Vector<u8>;
    /// The checksum and part layout (ADR-0015), as a blob (`decodeExtras` reads it).
    extras: Vector<u8>;
    /// The version's id: the null id in a bucket without versioning (ADR-0041).
    versionId: [u8; 16];
    /// Whether the bucket's versioning is enabled or suspended: its responses then name the version.
    versioned: bool;
}

struct PutOutcome {
    md5: [u8; 16];
    generation: u64;
    parts: u32;
    /// The version's checksum and part layout (ADR-0015).
    extras: Vector<u8>;
    /// The new version's id: the null id unless the bucket's versioning is enabled (ADR-0041).
    versionId: [u8; 16];
}

/// One version of a key, as `ObjectStore.versionsOf` lists them.
struct VersionEntry {
    versionId: [u8; 16];
    generation: u64;
    deleteMarker: bool;
    size: u64;
    mtimeMillis: i64;
    md5: [u8; 16];
    parts: u32;
}

fn objectInfoOf(v: borrow ObjectVersion) -> Result<ObjectInfo, StoreError> => Ok(ObjectInfo {
    size: v.size,
    mtimeMillis: v.mtimeMillis,
    md5: v.md5,
    generation: v.lsn,
    contentType: copyBytes(v.contentType.view())?,
    parts: v.parts,
    metadata: copyBytes(v.metadata.view())?,
    extras: copyBytes(v.extras.view())?,
    versionId: v.versionId,
    versioned: false,
});

/// One version in a page of `ObjectStore.listVersions`.
struct ListedVersion {
    key: Vector<u8>;
    versionId: [u8; 16];
    /// The key's newest version.
    latest: bool;
    deleteMarker: bool;
    size: u64;
    mtimeMillis: i64;
    md5: [u8; 16];
    parts: u32;
    /// Its storage class, empty for STANDARD (ADR-0090 §1).
    storageClass: Vector<u8>;
}

/// One page of a bucket's versions (ADR-0041): keys in byte order, each key's versions newest first, and rolled-up
/// common prefixes after them.
struct VersionPage {
    versions: Vector<ListedVersion>;
    commonPrefixes: Vector<Vector<u8>>;
    truncated: bool;
    /// Where the next page starts: after this key's version with `nextVersionId`, or, when the page ended with a
    /// common prefix (`nextIsPrefix`), after every key under it.
    nextKey: Vector<u8>;
    nextVersionId: [u8; 16];
    nextIsPrefix: bool;
}

/// One entry of `ObjectStore.deleteMany`: a key, and the version to remove for good, if one is named.
struct DeleteTarget {
    key: Vector<u8>;
    versionId: [u8; 16]?;
    /// The request may remove a version under governance retention (ADR-0047 §4).
    bypassGovernance: bool;
}

/// What a delete did, or staged (ADR-0041).
struct DeleteOutcome {
    /// False for a key that is empty or too long: nothing was written for it.
    valid: bool;
    /// The record's LSN, for a deferred delete to wait on; null when nothing was written.
    lsn: u64?;
    /// The delete marker written (no version was named, in a bucket with versioning), or the id of the version
    /// removed. Null when neither: a bucket without versioning and no version named.
    versionId: [u8; 16]?;
    /// A delete marker was written, or the version removed was one.
    deleteMarker: bool;
    /// The version named is under retention or a legal hold: nothing was written, and it stays (ADR-0047).
    locked: bool;
}

/// One page of a listing: keys and rolled-up common prefixes, both in byte order.
/// A bucket made by a leader's staged entry, not yet applied (ADR-0128 §1).
struct StagedBucket {
    name: Vector<u8>;
    lsn: u64;
    /// The versioning its request staged for it (VERSIONING_OFF until one does): a lock its request sets next needs
    /// it enabled, as S3's CreateBucket with object lock sets both (the M31 exit review).
    versioning: u8;
}

struct ListPage {
    keys: Vector<Vector<u8>>;
    sizes: Vector<u64>;
    /// Each key's MD5 (its ETag) and modification time, in Unix milliseconds.
    md5s: Vector<[u8; 16]>;
    mtimes: Vector<i64>;
    /// Each key's part count (0: not multipart).
    parts: Vector<u32>;
    /// Each key's storage class, empty for STANDARD (ADR-0090 §1).
    classes: Vector<Vector<u8>>;
    /// Each key's restore state as kept (`x-cosmo-restore`, ADR-0102 §5), empty for none: ListObjectsV2's
    /// `RestoreStatus` (ADR-0106 §4).
    restores: Vector<Vector<u8>>;
    commonPrefixes: Vector<Vector<u8>>;
    truncated: bool;
    /// The last key or prefix returned, for the next page's `startAfter`.
    nextMarker: Vector<u8>;
    nextMarkerIsPrefix: bool;
}

/// Index entries a checkpoint step encodes under the store (ADR-0028): about 0.7 MB and a millisecond or two.
const CHECKPOINT_STEP_ENTRIES: usize = 4096;

/// Index entries a compaction plan step reads, and the bytes of records a copy step stages and commits (ADR-0029).
const COMPACTION_PLAN_ENTRIES: usize = 4096;
const COMPACTION_COPY_BYTES: u64 = 1048576;

/// An upkeep hold of the store this long or longer is slow (ADR-0029): counted, and logged by the server.
const UPKEEP_SLOW_MICROS: u64 = 10000;

/// The bucket number of a lookup key whose bucket is not there (ADR-0027): never given to a bucket.
const NO_BUCKET: u32 = 0xFFFFFFFF;

/// Everything recovery rebuilds from the journal.
/// How many index keys a leader's look for extents to code reads at a time (ADR-0064 §1).
const CODING_SCAN_KEYS: usize = 512;
/// How long a coded extent's whole copy, decoded for reads, is kept (ADR-0064 §5).
const DECODED_KEEP_MS: i64 = 3600000;

struct StoreState {
    /// In (bucket, key) order, so a listing seeks to its first key and reads only its page (ADR-0026).
    index: VersionIndex;
    buckets: HashMap<BucketKey, BucketInfo>;
    /// Each bucket's name by its number, and the next number to give (ADR-0027).
    bucketNames: HashMap<u32, Vector<u8>>;
    nextBucket: u32;
    segments: HashMap<u64, SegmentUsage>;
    records: u64;
    /// Extents of versions superseded or deleted by applied records; the store removes the
    /// files once the records are durable (they always are when applied).
    deadExtents: Vector<ExtentRef>;
    /// The bytes of the live versions' and the uploads' extent files, headers included (ADR-0006).
    extentBytes: u64;
    /// Multipart uploads in progress (ADR-0009).
    uploads: HashMap<UploadKey, Upload>;
    /// The latest completions, oldest first, so a retried Complete gets its first answer (ADR-0014). Rebuilt from
    /// the journal after the newest checkpoint, and never written to one.
    completions: Vector<Completion>;
    /// The events of applied records still to be delivered (ADR-0048).
    outbox: Outbox;
    /// A cluster shard's replica: the configuration of the last Config record applied, as its bytes (ADR-0062 §2);
    /// empty before one.
    membership: Vector<u8>;
    /// The coded extents, by id (ADR-0064).
    coded: HashMap<u64, CodedExtent>;
    /// A shard's recent write sessions, by request id (ADR-0068).
    sessions: SessionTable;

    fn create() -> StoreState => StoreState {
        index: VersionIndex.create(),
        buckets: HashMap<BucketKey, BucketInfo>.create(),
        bucketNames: HashMap<u32, Vector<u8>>.create(),
        nextBucket: 0,
        segments: HashMap<u64, SegmentUsage>.create(),
        records: 0,
        deadExtents: Vector<ExtentRef>.create(),
        extentBytes: 0,
        uploads: HashMap<UploadKey, Upload>.create(),
        completions: Vector<Completion>.create(),
        outbox: Outbox.create(),
        membership: Vector<u8>.create(),
        coded: HashMap<u64, CodedExtent>.create(),
        sessions: SessionTable.create(),
    };

    /// Queues the event of a record just applied, if its bucket has a notification rule for it (ADR-0048 §2).
    /// Nothing while no bucket has rules, and nothing for a record the delivery cursor is past: recovery applies
    /// those again.
    fn noteEvent(
        borrow mut this,
        kind: u8,
        bucket: Slice<u8>,
        key: Slice<u8>,
        versionId: [u8; 16],
        size: u64,
        md5: [u8; 16],
        parts: u32,
        mtimeMillis: i64,
        lsn: u64,
    ) -> Result<void, StoreError> {
        if (this.outbox.buckets == 0 || lsn <= this.outbox.cursor) { return Ok(); }
        let k = BucketKey { name: copyBytes(bucket)? };
        var blob = Vector<u8>.create();
        var replicationBlob = Vector<u8>.create();
        match (this.buckets.get(borrow k)) {
            Some(b) => {
                blob = copyBytes(b.notification.view())?;
                replicationBlob = copyBytes(b.replication.view())?;
            }
            null => { return Ok(); }
        }
        if (blob.length == 0 && replicationBlob.length == 0) { return Ok(); }
        let rules = match (decodeNotification(blob.view())) {
            Ok(r) => r,
            Err(_) => Vector<NotificationRule>.create(),
        };
        let replication = match (decodeReplication(replicationBlob.view())) {
            Ok(r) => r,
            Err(_) => Vector<ReplicationRule>.create(),
        };
        var e = OutboxEvent {
            lsn: lsn,
            kind: kind,
            bucket: copyBytes(bucket)?,
            key: copyBytes(key)?,
            versionId: versionId,
            size: size,
            md5: md5,
            parts: parts,
            mtimeMillis: mtimeMillis,
            ruleIds: Vector<Vector<u8>>.create(),
            targets: Vector<Vector<u8>>.create(),
            requesters: Vector<Vector<u8>>.create(),
        };
        for (i in 0..rules.length) {
            if (!ruleTakesEvent(borrow rules[i], kind, key)) { continue; }
            e.ruleIds.push(copyBytes(rules[i].id.view())?)?;
            e.targets.push(copyBytes(rules[i].target.view())?)?;
            e.requesters.push(Vector<u8>.create())?;
        }
        // Each destination once, however many rules name it (ADR-0077 §2).
        for (i in 0..replication.length) {
            if (!replicationTakes(borrow replication[i], kind, key)) { continue; }
            if (!replicationRuleDecides(replication.view(), i, key)) { continue; }
            let target = replicationTarget(replication[i].destination.view())?;
            var seen = false;
            for (t in 0..e.targets.length) {
                if (e.targets[t].view() == target.view()) { seen = true; }
            }
            if (seen) { continue; }
            e.ruleIds.push(copyBytes(replication[i].id.view())?)?;
            e.targets.push(target)?;
            // Its rule's requester, as it is now (ADR-0094 §1): the replica is decided as it, whatever the rule
            // becomes before it is delivered (the M14 exit review's A3).
            e.requesters.push(copyBytes(replication[i].requester.view())?)?;
        }
        if (e.targets.length > 0) { this.outbox.add(e)?; }
        return Ok();
    }

    /// The key's current object: its newest version, unless that is a delete marker (ADR-0041).
    fn current(borrow this, key: borrow IndexKey) -> borrow(this) ObjectVersion? {
        let v = this.index.get(key)?;
        if (isDeleteMarker(v)) { return null; }
        return v;
    }

    /// Releases a superseded or deleted version: its record bytes and its extents.
    fn retire(borrow mut this, old: borrow ObjectVersion) -> Result<void, StoreError> {
        let freed = extentFileBytes(old);
        this.extentBytes = if (this.extentBytes > freed) this.extentBytes - freed else 0;
        if (old.extents.length == 0) { this.releaseRecord(old.recordSegment, old.recordLength); }
        for (i in 0..old.extents.length) {
            this.deadExtents.push(old.extents[i])?;
        }
        return Ok();
    }

    /// Adds bucket `name` under a new number; one that is already there keeps its number, and its info is replaced.
    /// Returns whether it was new.
    fn addBucket(borrow mut this, name: Vector<u8>, info: BucketInfo) -> Result<bool, StoreError> {
        var entry = info;
        let k = BucketKey { name: copyBytes(name.view())? };
        match (this.buckets.get(borrow k)) {
            Some(b) => {
                entry.number = b.number;
                let _ = this.buckets.put(k, entry)?;
                return Ok(false);
            }
            null => {}
        }
        if (this.nextBucket == NO_BUCKET) { return Err(StoreError.InsufficientStorage); }                // 4 billion creations
        if (entry.notification.length > 0 || entry.replication.length > 0) { this.outbox.buckets += 1; } // from a checkpoint
        entry.number = this.nextBucket;
        // If the second put fails, the name stays under a number no bucket has, and the next add reuses the number.
        this.bucketNames.put(entry.number, name)?;
        this.buckets.put(k, entry)?;
        this.nextBucket += 1;
        return Ok(true);
    }

    /// Removes bucket `name` and its number.
    fn removeBucket(borrow mut this, name: Slice<u8>) -> Result<void, StoreError> {
        let k = BucketKey { name: copyBytes(name)? };
        match (this.buckets.remove(borrow k)) {
            Some(b) => {
                let had = b.notification.length > 0 || b.replication.length > 0;
                if (had && this.outbox.buckets > 0) { this.outbox.buckets -= 1; }
                let _ = this.bucketNames.remove(borrow b.number);
            }
            null => {}
        }
        return Ok();
    }

    /// The key to look `bucket`'s `key` up by. A bucket that is not there gets NO_BUCKET, which no bucket has, so the
    /// key finds nothing, as a bucket with no keys would.
    fn keyFor(borrow this, bucket: Slice<u8>, key: Slice<u8>) -> Result<IndexKey, StoreError> {
        let k = BucketKey { name: copyBytes(bucket)? };
        let number = match (this.buckets.get(borrow k)) {
            Some(b) => b.number,
            null => NO_BUCKET,
        };
        return Ok(IndexKey { bucket: number, key: copyBytes(key)? });
    }

    /// The index key of `bucket`'s `key`, or null if there is no such bucket.
    fn indexKey(borrow this, bucket: Slice<u8>, key: Slice<u8>) -> Result<IndexKey?, StoreError> {
        let k = BucketKey { name: copyBytes(bucket)? };
        return match (this.buckets.get(borrow k)) {
            Some(b) => Ok(IndexKey { bucket: b.number, key: copyBytes(key)? }),
            null => Ok(null),
        };
    }

    /// The name of bucket number `number` (empty if there is none).
    fn bucketName(borrow this, number: u32) -> Slice<u8> => match (this.bucketNames.get(borrow number)) {
        Some(n) => n.view(),
        null => "".bytes(),
    };

    fn hasBucket(borrow this, name: Slice<u8>) -> Result<bool, StoreError> {
        let k = BucketKey { name: copyBytes(name)? };
        return Ok(this.buckets.contains(borrow k));
    }

    fn addSegmentBytes(borrow mut this, segment: u64, total: u64, live: u64) -> Result<void, StoreError> {
        match (this.segments.getMut(borrow segment)) {
            Some(u) => {
                u.totalBytes += total;
                u.liveBytes += live;
                return Ok();
            }
            null => {}
        }
        this.segments.put(segment, SegmentUsage { totalBytes: total, liveBytes: live })?;
        return Ok();
    }

    fn releaseRecord(borrow mut this, segment: u64, length: u32) {
        match (this.segments.getMut(borrow segment)) {
            Some(u) => { u.liveBytes = if (u.liveBytes > length as u64) u.liveBytes - length as u64 else 0; }
            null => {}
        }
    }

    /// A version of `bucket` came (`up`) or went: the bucket's count of versions, and of their bytes (ADR-0052).
    fn bumpObjects(borrow mut this, bucket: Slice<u8>, up: bool, size: u64) -> Result<void, StoreError> {
        let k = BucketKey { name: copyBytes(bucket)? };
        match (this.buckets.getMut(borrow k)) {
            Some(b) => {
                if (up) {
                    b.objects += 1;
                    b.bytes += size;
                } else {
                    b.objects -= 1;
                    b.bytes = if (b.bytes > size) b.bytes - size else 0;
                }
            }
            null => {}
        }
        return Ok();
    }

    /// A version of `bucket` was replaced in place: its bytes went and the new one's came.
    fn swapBytes(borrow mut this, bucket: Slice<u8>, came: u64, went: u64) -> Result<void, StoreError> {
        let k = BucketKey { name: copyBytes(bucket)? };
        match (this.buckets.getMut(borrow k)) {
            Some(b) => { b.bytes = if (b.bytes + came > went) b.bytes + came - went else 0; }
            null => {}
        }
        return Ok();
    }
}

/// The bytes a version's extent files occupy: each extent's data and its header.
fn extentFileBytes(v: borrow ObjectVersion) -> u64 {
    var total: u64 = 0;
    for (i in 0..v.extents.length) {
        total += v.extents[i].length + EXTENT_HEADER_LEN;
    }
    return total;
}

/// Applies one committed record to the state. Recovery and live writes both call this.
/// `meta` is the record's meta bytes; the payload starts right after it in the segment.
/// `manifest` is the payload of a PutExtent record (empty otherwise).
fn applyRecord(
    state: borrow mut StoreState,
    kind: RecordType,
    lsn: u64,
    segment: u64,
    offset: u64,
    totalLen: u32,
    meta: Slice<u8>,
    payloadLen: u32,
    manifest: Slice<u8>,
) -> Result<void, StoreError> {
    state.records += 1;
    let isPut = match (kind) {
        RecordType.PutInline => true,
        RecordType.PutExtent => true,
        _ => false,
    };
    if (isPut) {
        let m = match (decodePutMeta(meta)) {
            Ok(m) => m,
            Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
        };
        let extents = match (kind) {
            RecordType.PutExtent => match (decodeManifest(manifest)) {
                Ok(e) => e,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            },
            _ => Vector<ExtentRef>.create(),
        };
        state.extentBytes += extentRefBytes(extents.view());
        let parts = m.parts;
        return applyPut(state, m, extents, parts, lsn, segment, offset, totalLen, meta.length, payloadLen);
    }
    match (kind) {
        RecordType.UploadComplete => {
            let c = match (decodeUploadCompleteMeta(meta)) {
                Ok(c) => c,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            let extents = match (decodeManifest(manifest)) {
                Ok(e) => e,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            if (!takeCompletedUpload(state, c.id, extents.view())?) {
                state.extentBytes += extentRefBytes(extents.view());
            }
            rememberCompletion(state, borrow c, lsn)?;
            return applyPut(state, c.put, extents, c.parts, lsn, segment, offset, totalLen, meta.length, payloadLen);
        }
        RecordType.SetTags => {
            // Like Relocate: it changes the version only if the key still has it. Its record is never
            // live: the index and every later checkpoint hold the tags.
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let m = match (decodeSetTagsMeta(meta)) {
                Ok(m) => m,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            let key = match (state.indexKey(m.bucket.view(), m.key.view())?) {
                Some(k) => k,
                null => { return Ok(); } // no such bucket: no such version
            };
            let tags = m.tags;
            let generation = m.generation;
            let versionId = m.versionId;
            // The record's later formats set the version's ACL (ADR-0045) or lock (ADR-0047).
            let field = setTagsField(m.format);
            // A re-wrap (ADR-0100 §2) moves the version's count from its old envelope's key to the new one's.
            var movedFrom: Vector<u8>? = null;
            var unknownAfter = false;
            // A restore's state (ADR-0106 §4): the event it raises, from the state before and after, so replay raises
            // the same; and the version watched for the events its times raise.
            var restoreEvent: u8 = 0;
            var eventSize: u64 = 0;
            var eventMd5 = [0u8; 16];
            var eventParts: u32 = 0;
            var eventMtime: i64 = 0;
            match (state.index.findMut(borrow key, versionId)) {
                Some(v) => {
                    if (v.lsn == generation) {
                        if (m.format == SET_RESTORE_FORMAT) {
                            restoreEvent = restoreEventOf(
                                metadataFind(v.metadata.view(), RESTORE_FIELD.bytes()),
                                tags.view(),
                            );
                            eventSize = v.size;
                            eventMd5 = v.md5;
                            eventParts = v.parts;
                            eventMtime = v.mtimeMillis;
                        }
                        if (m.format == SET_ENVELOPE_FORMAT) {
                            match (envelopePrefixOf(v)) {
                                Some(p) => {
                                    // Out of memory, the counts are marked not known, never the record corrupt (the
                                    // M17 exit review).
                                    movedFrom = copyBytes(p).ok();
                                    if (movedFrom.isNull()) { unknownAfter = true; }
                                }
                                null => {}
                            }
                        }
                        v.metadata = match (metadataReplace(v.metadata.view(), field.bytes(), tags.view())) {
                            Ok(b) => b,
                            Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
                        };
                    }
                }
                null => {}
            }
            match (movedFrom) {
                Some(from) => {
                    var dots = 0;
                    var end = tags.length;
                    for (i in 0..tags.length) {
                        if (tags[i] == '.') {
                            dots += 1;
                            if (dots == 3) {
                                end = i + 1;
                                break;
                            }
                        }
                    }
                    state.index.envelopeMoved(from.view(), tags.view()[0..end]);
                }
                null => {}
            }
            if (unknownAfter) { state.index.markSealedUnknown(); }
            if (m.format == SET_RESTORE_FORMAT) {
                state.index.watchRestoreOf(borrow key, versionId);
            }
            if (restoreEvent != 0) {
                state.noteEvent(
                    restoreEvent,
                    m.bucket.view(),
                    m.key.view(),
                    versionId,
                    eventSize,
                    eventMd5,
                    eventParts,
                    eventMtime,
                    lsn,
                )?;
            }
        }
        RecordType.UploadCreate => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            if (applyUploadCreate(state, meta).isErr()) { return Err(StoreError.BadMeta(segment, offset)); }
        }
        RecordType.UploadPart => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let extents = match (decodeManifest(manifest)) {
                Ok(e) => e,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            if (applyUploadPart(state, meta, extents).isErr()) { return Err(StoreError.BadMeta(segment, offset)); }
        }
        RecordType.UploadAbort => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            if (applyUploadAbort(state, meta).isErr()) { return Err(StoreError.BadMeta(segment, offset)); }
        }
        RecordType.DeleteVersion => {
            // The delete record itself is garbage as soon as it is applied, except as a
            // tombstone until the segments holding older versions are compacted.
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let m = match (decodeDeleteMeta(meta)) {
                Ok(m) => m,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            match (state.indexKey(m.bucket.view(), m.key.view())?) {
                Some(key) => {
                    match (state.index.removeVersion(borrow key, m.versionId)) {
                        Some(old) => {
                            state.retire(borrow old)?;
                            state.bumpObjects(m.bucket.view(), false, old.size)?;
                            state.noteEvent(
                                EVENT_DELETE,
                                m.bucket.view(),
                                m.key.view(),
                                m.versionId,
                                0,
                                [0u8; 16],
                                0,
                                m.mtimeMillis,
                                lsn,
                            )?;
                        }
                        null => {}
                    }
                }
                null => {}
            }
        }
        RecordType.DeleteMarker => {
            // Never live: the index and every later checkpoint hold the marker.
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let m = match (decodeDeleteMeta(meta)) {
                Ok(m) => m,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            match (state.indexKey(m.bucket.view(), m.key.view())?) {
                Some(key) => {
                    var marker = vacantVersion();
                    marker.versionId = m.versionId;
                    marker.lsn = lsn;
                    marker.kind = VersionKind.DeleteMarker;
                    marker.mtimeMillis = m.mtimeMillis;
                    installVersion(state, m.bucket.view(), key, marker)?;
                    state.noteEvent(
                        EVENT_MARKER,
                        m.bucket.view(),
                        m.key.view(),
                        m.versionId,
                        0,
                        [0u8; 16],
                        0,
                        m.mtimeMillis,
                        lsn,
                    )?;
                }
                null => {}
            }
        }
        RecordType.BucketCreate => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let name = match (decodeBucketName(meta)) {
                Ok(n) => n,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            let created = match (decodeBucketMillis(meta)) {
                Ok(t) => t,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            let zone = match (decodeBucketZone(meta)) {
                Ok(z) => z,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            let info = BucketInfo {
                number: 0,
                createdMillis: created,
                objects: 0,
                bytes: 0,
                quota: Vector<u8>.create(),
                encryption: Vector<u8>.create(),
                logging: Vector<u8>.create(),
                website: Vector<u8>.create(),
                inventory: Vector<u8>.create(),
                accessPoints: Vector<u8>.create(),
                replication: Vector<u8>.create(),
                replicationFailures: Vector<u8>.create(),
                tags: Vector<u8>.create(),
                lifecycle: Vector<u8>.create(),
                versioning: VERSIONING_OFF,
                policy: Vector<u8>.create(),
                publicAccess: Vector<u8>.create(),
                acl: Vector<u8>.create(),
                objectLock: Vector<u8>.create(),
                notification: Vector<u8>.create(),
                cors: Vector<u8>.create(),
                zone: zone,
            };
            let _ = state.addBucket(name, info)?;
        }
        RecordType.BucketConfig => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let m = match (decodeBucketConfigMeta(meta)) {
                Ok(m) => m,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            let configKind = m.kind;
            let value = m.value;
            let k = BucketKey { name: m.bucket };
            // The count of buckets with notification rules follows the rules (ADR-0048 §6).
            var gained = false;
            var lost = false;
            match (state.buckets.getMut(borrow k)) {
                Some(b) => {
                    // A bucket has rules while it has notification rules or replication rules (ADR-0077 §2).
                    if (configKind == BUCKET_CONFIG_NOTIFICATION || configKind == BUCKET_CONFIG_REPLICATION) {
                        let before = b.notification.length > 0 || b.replication.length > 0;
                        let other = if (configKind == BUCKET_CONFIG_NOTIFICATION) b.replication.length > 0
                            else b.notification.length > 0;
                        let after = other || value.length > 0;
                        gained = !before && after;
                        lost = before && !after;
                    }
                    if (configKind == BUCKET_CONFIG_TAGS) {
                        b.tags = value;
                    } else if (configKind == BUCKET_CONFIG_LIFECYCLE) {
                        b.lifecycle = value;
                    } else if (configKind == BUCKET_CONFIG_POLICY) {
                        b.policy = value;
                    } else if (configKind == BUCKET_CONFIG_PUBLIC_ACCESS) {
                        b.publicAccess = value;
                    } else if (configKind == BUCKET_CONFIG_ACL) {
                        b.acl = value;
                    } else if (configKind == BUCKET_CONFIG_OBJECT_LOCK) {
                        b.objectLock = value;
                    } else if (configKind == BUCKET_CONFIG_NOTIFICATION) {
                        b.notification = value;
                    } else if (configKind == BUCKET_CONFIG_CORS) {
                        b.cors = value;
                    } else if (configKind == BUCKET_CONFIG_QUOTA) {
                        b.quota = value;
                    } else if (configKind == BUCKET_CONFIG_ENCRYPTION) {
                        b.encryption = value;
                    } else if (configKind == BUCKET_CONFIG_LOGGING) {
                        b.logging = value;
                    } else if (configKind == BUCKET_CONFIG_WEBSITE) {
                        b.website = value;
                    } else if (configKind == BUCKET_CONFIG_INVENTORY) {
                        b.inventory = value;
                    } else if (configKind == BUCKET_CONFIG_ACCESS_POINTS) {
                        b.accessPoints = value;
                    } else if (configKind == BUCKET_CONFIG_REPLICATION) {
                        b.replication = value;
                    } else if (configKind == BUCKET_CONFIG_REPLICATION_FAILURES) {
                        b.replicationFailures = value;
                    } else {
                        b.versioning = value[0]; // one valid byte: `decodeBucketConfigMeta` checked it
                    }
                }
                null => {}
            }
            if (gained) { state.outbox.buckets += 1; }
            if (lost && state.outbox.buckets > 0) { state.outbox.buckets -= 1; }
        }
        RecordType.Relocate => {
            let m = match (decodeRelocateMeta(meta)) {
                Ok(m) => m,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            // The copy takes over only if the key still has the version it copied; otherwise
            // it is garbage from the moment it is written.
            var moved = false;
            var oldSegment: u64 = 0;
            var oldLength: u32 = 0;
            let found = match (state.indexKey(m.bucket.view(), m.key.view())?) {
                Some(key) => state.index.findMut(borrow key, m.versionId),
                null => null,
            };
            match (found) {
                Some(v) => {
                    if (v.lsn == m.generation && v.extents.length == 0 && !isDeleteMarker(v)) {
                        oldSegment = v.recordSegment;
                        oldLength = v.recordLength;
                        v.payload = PayloadLocator {
                            segmentId: segment,
                            offset: offset + (RECORD_HEADER_LEN + meta.length) as u64,
                            length: payloadLen,
                        };
                        v.recordSegment = segment;
                        v.recordLength = totalLen;
                        moved = true;
                    }
                }
                null => {}
            }
            if (moved) { state.releaseRecord(oldSegment, oldLength); }
            state.addSegmentBytes(segment, totalLen as u64, if (moved) totalLen as u64 else 0)?;
        }
        RecordType.Rename => {
            // Never live: the index and every later checkpoint hold the move (ADR-0081 §1).
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let m = match (decodeRenameMeta(meta)) {
                Ok(m) => m,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            applyRename(state, borrow m)?;
        }
        RecordType.BucketDelete => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let name = match (decodeBucketName(meta)) {
                Ok(n) => n,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            dropBucketUploads(state, name.view())?;
            state.removeBucket(name.view())?;
        }
        RecordType.Config => {
            state.membership.clear();
            state.membership.extend(meta)?;
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
        }
        RecordType.Coded => {
            match (decodeCoded(meta)) {
                Some(c) => { let _ = state.coded.put(c.id, c)?; }
                null => { return Err(StoreError.BadMeta(segment, offset)); }
            }
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
        }
        RecordType.OutboxDelivered => {
            // A shard's leader delivered the events up to an LSN (ADR-0078 §4): every replica drops them.
            if (meta.length != 8) { return Err(StoreError.BadMeta(segment, offset)); }
            state.outbox.deliveredTo(meta.readLE<u64>(0));
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
        }
        RecordType.Session => {
            // A write's request id and answer (ADR-0068): `manifest` is the payload here.
            if (meta.length != 17) { return Err(StoreError.BadMeta(segment, offset)); }
            var id = [0u8; 16];
            id[..].copyFrom(meta[0..16]);
            var answer = Vector<u8>.create();
            answer.extend(manifest)?;
            state.sessions.put(SessionEntry { id: id, index: lsn, kept: meta[16] == 1, answer: answer })?;
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
        }
        _ => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
        }
    }
    return Ok();
}

/// Applies a PutInline, PutExtent or UploadComplete record whose meta is `m`. Its extents are already counted in
/// `extentBytes`.
fn applyPut(
    state: borrow mut StoreState,
    m: PutMeta,
    extents: Vector<ExtentRef>,
    parts: u32,
    lsn: u64,
    segment: u64,
    offset: u64,
    totalLen: u32,
    metaLen: usize,
    payloadLen: u32,
) -> Result<void, StoreError> {
    // Only an inline payload keeps its record live: an extent manifest is in the index, and
    // in every checkpoint (ADR-0005).
    let live = if (extents.length == 0) totalLen as u64 else 0;
    state.addSegmentBytes(segment, totalLen as u64, live)?;
    state.noteEvent(
        if (parts > 0) EVENT_COMPLETE else EVENT_PUT,
        m.bucket.view(),
        m.key.view(),
        m.versionId,
        m.size,
        m.md5,
        parts,
        m.mtimeMillis,
        lsn,
    )?;
    let key = state.indexKey(m.bucket.view(), m.key.view())?;
    let bucket = m.bucket;
    let version = ObjectVersion {
        versionId: m.versionId,
        lsn: lsn,
        kind: VersionKind.Object,
        size: m.size,
        mtimeMillis: m.mtimeMillis,
        md5: m.md5,
        contentType: m.contentType,
        payload: PayloadLocator {
            segmentId: segment,
            offset: offset + (RECORD_HEADER_LEN + metaLen) as u64,
            length: payloadLen,
        },
        recordSegment: segment,
        recordLength: totalLen,
        extents: extents,
        parts: parts,
        metadata: m.metadata,
        extras: m.extras,
    };
    match (key) {
        Some(k) => { installVersion(state, bucket.view(), k, version)?; }
        // Admission checks the bucket under the lock, so this does not happen. If it did, the version would have no
        // bucket to be listed in: it is retired at once, its extents reaped and its record dead.
        null => { state.retire(borrow version)?; }
    }
    return Ok();
}

/// Makes `version` the newest version of `key` in `bucket` (ADR-0041). With the null id it replaces the key's null
/// version, wherever that is in the chain; with another id it only adds. The bucket's count is of versions.
/// A Rename record's move (ADR-0081 §1): if the source key's current version is still the one of `generation`, the
/// destination key gets it, with its locator, metadata and dates, and the source key has none; the destination's
/// previous version is retired as an overwrite's. Otherwise nothing changes. Its payload stays where it is, so the
/// segments' live bytes do not change.
fn applyRename(state: borrow mut StoreState, m: borrow RenameMeta) -> Result<void, StoreError> {
    let from = match (state.indexKey(m.bucket.view(), m.from.view())?) {
        Some(k) => k,
        null => { return Ok(); } // no such bucket
    };
    let current = match (state.index.get(borrow from)) {
        Some(v) => v.lsn == m.generation && isNullVersionId(v.versionId) && !isDeleteMarker(v),
        null => false,
    };
    if (!current) { return Ok(); }
    let moved = match (state.index.removeVersion(borrow from, nullVersionId())) {
        Some(v) => v,
        null => { return Ok(); }
    };
    state.bumpObjects(m.bucket.view(), false, moved.size)?;
    let to = match (state.indexKey(m.bucket.view(), m.to.view())?) {
        Some(k) => k,
        null => { return Ok(); }
    };
    return installVersion(state, m.bucket.view(), to, moved);
}

fn installVersion(
    state: borrow mut StoreState,
    bucket: Slice<u8>,
    key: IndexKey,
    version: ObjectVersion,
) -> Result<void, StoreError> {
    let size = version.size;
    if (!isNullVersionId(version.versionId)) {
        state.index.push(key, version)?;
        return state.bumpObjects(bucket, true, size);
    }
    let newestIsNull = match (state.index.get(borrow key)) {
        Some(v) => isNullVersionId(v.versionId),
        null => {
            let _ = state.index.put(key, version)?;
            return state.bumpObjects(bucket, true, size);
        }
    };
    if (newestIsNull) {
        // In place, as an unversioned bucket's overwrite always was: nothing to allocate, and the count stays.
        match (state.index.put(key, version)?) {
            Some(old) => {
                state.retire(borrow old)?;
                state.swapBytes(bucket, size, old.size)?;
            }
            null => { state.swapBytes(bucket, size, 0)?; }
        }
        return Ok();
    }
    let k = copyIndexKey(borrow key)?;
    state.index.push(key, version)?;
    state.bumpObjects(bucket, true, size)?;
    match (state.index.removeOlder(borrow k, nullVersionId())) {
        Some(old) => {
            state.retire(borrow old)?;
            state.bumpObjects(bucket, false, old.size)?;
        }
        null => {}
    }
    return Ok();
}

/// A staged delete: its record's LSN, and the id it carries (a delete marker's, or the null id).
struct StagedDelete {
    lsn: u64;
    versionId: [u8; 16];
}

/// Everything a reader has left, in memory.
fn readRemaining(reader: borrow mut ObjectReader) -> Result<Vector<u8>, StoreError> {
    var out = Vector<u8>.create();
    var chunk = Vector<u8>.create();
    chunk.resize(65536, 0)?;
    while (true) {
        let n = reader.read(mut chunk.viewMut())?;
        if (n == 0) { break; }
        out.extend(chunk.view()[0..n])?;
    }
    return Ok(out);
}

/// A staged write waiting for its batch to commit before it is applied.
struct PendingApply {
    kind: RecordType;
    lsn: u64;
    segment: u64;
    offset: u64;
    total: u32;
    meta: Vector<u8>;
    payloadLen: u32;
    /// The PutExtent manifest (empty for other records).
    manifest: Vector<u8>;
}

/// What fsck found wrong with one object (ADR-0006).
enum VerifyFault {
    /// A record or extent fails its CRC, or an extent is short.
    Corrupt,
    /// An extent file is missing.
    Missing,
    /// The bytes read back are not the object's size or MD5.
    Mismatch,
    /// Another I/O error.
    Unreadable,
}

struct VerifyProblem {
    bucket: Vector<u8>;
    key: Vector<u8>;
    fault: VerifyFault;
}

/// What `ObjectStore.verify` found.
struct VerifyReport {
    objects: u64;
    bytes: u64;
    problems: Vector<VerifyProblem>;
    orphanExtents: usize;
}

fn verifyFault(e: StoreError) -> VerifyFault => match (e) {
    StoreError.DataCorrupt => VerifyFault.Corrupt,
    StoreError.Journal(JournalError.Corrupt(_, _)) => VerifyFault.Corrupt,
    StoreError.Io(f) =>
        if (f.isNotFound()) VerifyFault.Missing else if (f.op ==
            IoOp.Read) VerifyFault.Corrupt else VerifyFault.Unreadable,
    _ => VerifyFault.Unreadable,
};

/// What admission adds for a write's journal record and the extent headers of a small object (ADR-0006).
const ADMIT_RECORD_BYTES: u64 = 4096;

/// What a bucket's rules can take at all at one time, worked out once a run so that the pass, which looks at every
/// version of the bucket, spends one comparison on a version no rule can take yet (ADR-0042 §9).
struct LifecycleCutoffs {
    /// A current object, or a lone delete marker, written after this (Unix milliseconds) is not due by any rule's
    /// `Expiration`; -1 when no rule has one.
    current: i64;
    /// A version that became noncurrent after this is not due by any rule; -1 when no rule expires them.
    noncurrent: i64;
    /// Some rule has `ExpiredObjectDeleteMarker`: a lone marker may go whatever its age.
    markers: bool;
}

fn lifecycleCutoffs(rules: Slice<LifecycleRule>, nowMillis: i64) -> LifecycleCutoffs {
    var cut = LifecycleCutoffs { current: -1, noncurrent: -1, markers: false };
    for (i in 0..rules.length) {
        let r = borrow rules[i];
        if (!r.enabled) { continue; }
        // Due means the days added to the time, rounded up to midnight, have passed: never before the days have.
        if (r.expirationDays > 0) { cut.current = cut.current.max(nowMillis - (r.expirationDays as i64) * DAY_MILLIS); }
        if (r.expirationDate > 0 && nowMillis >= r.expirationDate) { cut.current = 0x7FFFFFFFFFFFFFFF; }
        if (r.noncurrentDays > 0) {
            cut.noncurrent = cut.noncurrent.max(nowMillis - (r.noncurrentDays as i64) * DAY_MILLIS);
        }
        if (r.expiredDeleteMarker) { cut.markers = true; }
    }
    return cut;
}

/// Whether some rule deletes this version at `nowMillis` (ADR-0042 §3). Current (`noncurrent` false): an object
/// whose `Expiration`, counted from `sinceMillis` (its modification time), has passed. Noncurrent: a version, delete
/// markers too, whose `NoncurrentVersionExpiration` has passed since it stopped being current (`sinceMillis`), with
/// at least the rule's count of `newer` noncurrent versions kept.
fn lifecycleTakes(
    rules: Slice<LifecycleRule>,
    key: Slice<u8>,
    v: borrow ObjectVersion,
    noncurrent: bool,
    newer: u32,
    sinceMillis: i64,
    nowMillis: i64,
) -> bool {
    let marker = isDeleteMarker(v);
    for (i in 0..rules.length) {
        let r = borrow rules[i];
        // The cheap parts first: the pass looks at every version of the bucket, and nearly none is due.
        if (!r.enabled || !startsWithBytes(key, r.prefix.view())) { continue; }
        if (noncurrent && newer < r.newerNoncurrent) { continue; }
        let at = if (noncurrent) noncurrentExpiresAt(r, sinceMillis) else expiresAt(r, sinceMillis);
        let due = match (at) {
            Some(t) => nowMillis >= t,
            null => false,
        };
        if (!due) { continue; }
        if (marker) {
            if (ruleTakesMarker(r, key)) { return true; }
            continue;
        }
        // The rest of the filter; the tags are read out of the metadata only for a rule that filters by them.
        var tags = Vector<u8>.create();
        if (r.tags.length > 0) {
            match (metadataValue(v.metadata.view(), TAGS_FIELD.bytes())) {
                Ok(t) => { tags = t; }
                Err(_) => {}
            }
        }
        if (ruleMatches(r, key, v.size, tags.view())) { return true; }
    }
    return false;
}

/// The class a rule's transition moves this version to at `nowMillis` (ADR-0090 §2): of the transitions due, the one
/// furthest along S3's waterfall, if it is further than the version's own class; empty for none. Current
/// (`noncurrent` false): counted from `sinceMillis`, its modification time, or a date. Noncurrent: from when it
/// stopped being current, with at least the transition's count of `newer` noncurrent versions kept.
fn transitionTarget(
    rules: Slice<LifecycleRule>,
    key: Slice<u8>,
    v: borrow ObjectVersion,
    noncurrent: bool,
    newer: u32,
    sinceMillis: i64,
    nowMillis: i64,
) -> Result<Vector<u8>, AllocError> {
    var best = Vector<u8>.create();
    if (isDeleteMarker(v)) { return Ok(best); }
    let present = storageClassIn(v.metadata.view())?;
    var bestRank = storageClassRank(present.view());
    for (i in 0..rules.length) {
        let r = borrow rules[i];
        let all = if (noncurrent) r.noncurrentTransitions.view() else r.transitions.view();
        if (all.length == 0 || !r.enabled || !startsWithBytes(key, r.prefix.view())) { continue; }
        var tags = Vector<u8>.create();
        if (r.tags.length > 0) {
            match (metadataValue(v.metadata.view(), TAGS_FIELD.bytes())) {
                Ok(t) => { tags = t; }
                Err(_) => {}
            }
        }
        if (!ruleMatches(r, key, v.size, tags.view())) { continue; }
        // S3's floor: an object under 128 KB does not transition, unless its rule filters by size.
        if (!r.hasSizeAbove && !r.hasSizeBelow && v.size < TRANSITION_MINIMUM_BYTES) { continue; }
        for (t in all) {
            if (noncurrent && newer < t.newer) { continue; }
            let at = if (t.date > 0) t.date else {
                let d = sinceMillis + (t.days as i64) * DAY_MILLIS;
                ((d + DAY_MILLIS - 1) / DAY_MILLIS) * DAY_MILLIS
            };
            if (nowMillis < at) { continue; }
            let rank = storageClassRank(t.storageClass.view());
            // A version whose metadata has no room for the class stays as it is: it is skipped, not a run's error
            // (the M12 exit review's A1).
            if (rank > bestRank && !classFits(v.metadata.view(), t.storageClass.view())) { continue; }
            if (rank > bestRank) {
                bestRank = rank;
                best.clear();
                best.extend(t.storageClass.view())?;
            }
        }
    }
    return Ok(best);
}

/// Whether a version's metadata has room for `storageClass` within MAX_METADATA_BYTES.
fn classFits(metadata: Slice<u8>, storageClass: Slice<u8>) -> bool => match (metadataReplace(
    metadata,
    STORAGE_CLASS_FIELD.bytes(),
    storageClass,
)) {
    Ok(b) => b.length <= MAX_METADATA_BYTES,
    Err(_) => false,
};

/// Whether some rule removes a delete marker that is its key's only version (ADR-0042 §3): one with
/// `ExpiredObjectDeleteMarker`, or an `Expiration` that has passed since the marker was written.
fn lifecycleTakesLoneMarker(rules: Slice<LifecycleRule>, key: Slice<u8>, writtenMillis: i64, nowMillis: i64) -> bool {
    for (r in rules) {
        if (!ruleTakesMarker(r, key)) { continue; }
        if (r.expiredDeleteMarker) { return true; }
        match (expiresAt(r, writtenMillis)) {
            Some(t) => {
                if (nowMillis >= t) { return true; }
            }
            null => {}
        }
    }
    return false;
}

/// The most objects one bucket's lifecycle rules delete in one run (ADR-0020).
const LIFECYCLE_BATCH: usize = 1000;

/// Abandoned extents queued between reaps; more are left to the orphan sweep at open.
const ABANDONED_CAPACITY: usize = 4096;

/// What a scrub step found damaged (ADR-0063): an extent (`extent`, its `id`), or an inline version's record (where it
/// is: `segment`, `offset`, `length`), and the version it belongs to.
/// A version to re-wrap (ADR-0100 §3): where it is, and its envelope as read.
struct RewrapItem {
    bucket: Vector<u8>;
    key: Vector<u8>;
    versionId: [u8; 16];
    envelope: Vector<u8>;
}

/// A step of the re-wrap pass: the versions found, and where the next step starts (null: the index's end).
struct RewrapPage {
    items: Vector<RewrapItem>;
    next: IndexKey?;
}

struct ScrubDamage {
    extent: bool;
    bucket: Vector<u8>;
    key: Vector<u8>;
    versionId: [u8; 16];
    id: u64;
    segment: u64;
    offset: u64;
    length: u32;
}

/// One scrub step: versions checked, what was damaged, and the key to go on after (null: the pass is done).
struct ScrubPage {
    checked: u64;
    damages: Vector<ScrubDamage>;
    next: IndexKey?;
}

/// A Config record found unapplied on recovery: its index and membership bytes.
struct RecoveredConfig {
    index: u64;
    membership: Vector<u8>;
}

/// A snapshot bundle (ADR-0058 §9): u64 magic "CSSNAP01", u64 index, u64 term, u32 file count, then per file u16 name
/// length, the name, u64 length, u32 CRC32C of the bytes, the bytes.
const SNAPSHOT_MAGIC: u64 = 0x313050414E535343; // "CSSNAP01" in file order

/// Appends the first `length` bytes of the file at `path` to a bundle, as `name`.
fn appendBundleFile(
    bundle: borrow mut Vector<u8>,
    name: StringView,
    path: StringView,
    length: u64,
) -> Result<void, StoreError> {
    let file = sio(DurableFile.openRead(path))?;
    let n = match (checkedTruncate<usize>(length)) {
        Some(n) => n,
        null => { return Err(StoreError.EntityTooLarge); }
    };
    var bytes = Vector<u8>.create();
    bytes.resize(n, 0)?;
    sio(file.readExactAt(mut bytes.viewMut(), 0))?;
    bundle.pushLE(truncate<u16>(name.length))?;
    bundle.extend(name.bytes())?;
    bundle.pushLE(length)?;
    bundle.pushLE(Crc32c.of(bytes.view()))?;
    bundle.extend(bytes.view())?;
    return Ok();
}

/// `seg-<16 hex>.cj`, a segment's file name.
fn segmentName(id: u64) -> Result<String, StoreError> {
    var s = String.create();
    s.append("seg-")?;
    appendHex16(mut s, id)?;
    s.append(".cj")?;
    return Ok(s);
}

/// `ckpt-<16 hex>.ck`, a checkpoint's file name.
fn checkpointName(lsn: u64) -> Result<String, StoreError> {
    var s = String.create();
    s.append("ckpt-")?;
    appendHex16Text(mut s, lsn)?;
    s.append(".ck")?;
    return Ok(s);
}

/// `ObjectStore.stageRecord` on the journal alone, so the meta may be another of the store's fields.
fn stageIn(
    journal: borrow mut Journal,
    raft: bool,
    term: u64,
    kind: RecordType,
    meta: Slice<u8>,
    payload: Slice<u8>,
) -> Result<RecordPosition, StoreError> {
    if (!raft) { return Ok(journal.stage(kind, meta, payload)?); }
    // A record that names extents is proposed only once a majority holds them (ADR-0061 §1): the node's front sees to it.
    if (term == 0) { return Err(StoreError.NotLeader); }
    return Ok(journal.stageEntry(kind, term, meta, payload)?);
}

/// Applies a durable batch's records to the state, in order.
fn applyBatch(
    state: borrow mut StoreState,
    batch: borrow Vector<PendingApply>,
    sinceCheckpoint: borrow mut u64,
    counts: borrow mut StoreCounters,
) -> Result<void, StoreError> {
    for (i in 0..batch.length) {
        let p = borrow batch[i];
        sinceCheckpoint += p.total as u64;
        counts.journalBytesWritten += p.total as u64;
        applyRecord(
            mut state,
            p.kind,
            p.lsn,
            p.segment,
            p.offset,
            p.total,
            p.meta.view(),
            p.payloadLen,
            p.manifest.view(),
        )?;
    }
    return Ok();
}

/// The later of two positions in the index; null is the end, after everything.
fn laterOf(
    index: borrow VersionIndex,
    a: OrderedCursor?,
    b: OrderedCursor?,
) -> OrderedCursor? {
    let x = match (a) {
        Some(c) => c,
        null => { return null; }
    };
    let y = match (b) {
        Some(c) => c,
        null => { return null; }
    };
    return if (index.keyAt(x).compareKey(index.keyAt(y)) >= 0) x else y;
}

/// The first index entry after `marker` in `bucket`; with `wholePrefix`, after every key that starts with `marker`
/// (the first key at or after the prefix's end: the marker without its trailing 0xFF bytes, its last byte
/// incremented). Null when nothing in the bucket follows.
fn seekPast(
    index: borrow VersionIndex,
    bucket: u32,
    marker: Slice<u8>,
    wholePrefix: bool,
) -> Result<OrderedCursor?, AllocError> {
    if (!wholePrefix) {
        let after = IndexKey { bucket: bucket, key: copyBytes(marker)? };
        return Ok(index.seekAfter(borrow after));
    }
    var end = copyBytes(marker)?;
    while (end.length > 0 && end[end.length - 1] == 0xFF) { let _ = end.pop(); }
    // Every key after an all-0xFF marker starts with it: nothing in the bucket follows.
    if (end.length == 0) { return Ok(null); }
    let last = end.length - 1;
    end[last] = end[last] + 1;
    let from = IndexKey { bucket: bucket, key: end };
    return Ok(index.seek(borrow from));
}

/// A RenameObject's `x-amz-client-token` and what it renamed, kept in memory for `RENAME_TOKEN_MS` (ADR-0081 §4).
struct RenameToken {
    token: Vector<u8>;
    bucket: Vector<u8>;
    from: Vector<u8>;
    to: Vector<u8>;
    expiresMs: i64;
}

/// What a RenameObject's client token says: a new request, one already done with the same parameters, or a token
/// used for another rename.
enum RenameRetry {
    New,
    Done,
    Mismatch,
}

const RENAME_TOKEN_MS: i64 = 600000;
const RENAME_TOKENS_KEPT: usize = 4096;

struct ObjectStore {
    private journal: Journal;
    /// The client tokens of recent renames (ADR-0081 §4): memory only, so a restart forgets them.
    private renameTokens: Vector<RenameToken>;
    private state: StoreState;
    private config: StoreConfig;
    private scratch: Vector<u8>;
    private pendingApplies: Vector<PendingApply>;
    /// The batch written by `beginGroupSync` whose sync has not finished (ADR-0022).
    private inflightApplies: Vector<PendingApply>;
    /// Every record with a lower LSN is published (durable and applied).
    private publishedNext: u64;
    private extentDir: String;
    private dir: String;
    /// The newest durable checkpoint: its LSN and the first segment it does not cover
    /// (0, 0: none). Only segments before `checkpointSegment` may be compacted.
    private checkpointLsn: u64;
    private checkpointSegment: u64;
    /// Journal bytes committed since that checkpoint.
    private sinceCheckpoint: u64;
    /// Extents that open readers may still read (ADR-0007), and the retired ones that wait for them.
    private pins: ExtentPins;
    /// Segments whose records readers are reading without the store (ADR-0024): compaction leaves them on disk.
    private segmentPins: ExtentPins;
    private deferred: Vector<DeferredExtent>;
    private deferredBytes: u64;
    /// Extents of writers dropped unfinished, for the store to remove: a drop may run in async code, which must not
    /// do I/O, so it only queues them here.
    private abandoned: Channel<u64>;
    /// When `maintain` last applied lifecycle rules (Unix milliseconds).
    private lifecycleRan: i64;
    private counts: StoreCounters;
    /// The volume as last measured (ADR-0040): its size, the bytes this process could write then, and what the store
    /// occupied then, so admission can count what it wrote since. Not measured: no volume limit.
    private volumeMeasured: bool;
    private volumeTotal: u64;
    private volumeAvailable: u64;
    private usedAtMeasure: u64;
    /// A cluster shard's replica (ADR-0058): records are Raft entries, staged in `term` when this replica leads,
    /// persisted when committed to the journal, and applied only when Raft commits them (`applyEntries`).
    private raft: bool;
    private term: u64;
    /// The buckets this leader's staged, unapplied entries make, with each one's entry (ADR-0128 §1): a write into one
    /// is taken, as a request that makes a bucket and writes into it does on `serve`. Reads do not see them.
    private stagedBuckets: Vector<StagedBucket>;
    /// The terms of the entries recovery found after the checkpoint, unapplied, for the replica's Raft core; and the
    /// Config records among them, as (index, membership bytes).
    private recoveredTerms: Vector<u64>;
    private recoveredConfigs: Vector<RecoveredConfig>;
    /// The term of the last applied entry, and of the newest checkpoint's (a Raft log; 0 on a single node).
    private appliedTerm: u64;
    private checkpointTerm: u64;
    /// A cluster replica's node (whose piece of a coded extent it holds), and the coded extents reads want decoded.
    private nodeId: u32;
    private wanted: Channel<u64>;
    /// The coded extents this replica has a whole copy of (decoded for reads), known without I/O: reads on the
    /// event loop look here (ADR-0023).
    private wholeCoded: HashMap<u64, bool>;
    /// Where the leader's look for extents to code left off (`codingCandidates`).
    private codingAfter: IndexKey?;

    /// Opens the store in `dir`: loads the newest checkpoint, if any, then replays the journal
    /// records after it.
    fn open(dir: StringView, config: StoreConfig) -> Result<ObjectStore, StoreError> {
        sio(Fs.ensureDirectory(dir))?;
        removeCheckpoints(dir, 0, true); // interrupted checkpoint writes
        let complete = listCheckpoints(dir, false)?;
        var state = StoreState.create();
        var start = JournalStart.beginning();
        var startTerm = 0u64;
        if (complete.length > 0) {
            let loaded = readCheckpoint(dir, complete[complete.length - 1])?;
            start = JournalStart { segment: loaded.segment, lsn: loaded.lsn };
            startTerm = loaded.term;
            state = loaded.state;
            // The checkpointed versions' inline records are live in the segments they cover.
            var live = Vector<SegmentFile>.create();
            var cursor = state.index.first();
            while (true) {
                let i = match (cursor) {
                    Some(c) => c,
                    null => { break; }
                };
                cursor = state.index.next(i);
                var slot = state.index.slotAt(i);
                while (slot != NO_VERSION_SLOT) {
                    let v = state.index.versionAt(slot);
                    if (v.extents.length == 0 && !isDeleteMarker(v)) {
                        live.push(SegmentFile { id: v.recordSegment, size: v.recordLength as u64 })?;
                    }
                    slot = state.index.olderOf(slot);
                }
            }
            for (i in 0..live.length) { state.addSegmentBytes(live[i].id, 0, live[i].size)?; }
        }
        // The outbox: the checkpoint's events the cursor is not past, then those of the records replayed
        // (ADR-0048 §3).
        var delivered = readOutboxCursor(dir)?;
        // A Raft log's replicas have no cursor file: their records say what was delivered (ADR-0078 §4). The
        // checkpoint holds every event undelivered when it was written, so everything before its first one, or before
        // its LSN when it holds none, was delivered; the records replayed say the rest.
        if (config.journal.raftLog) {
            delivered =
                if (state.outbox.head < state.outbox.events.length) state.outbox.events[state.outbox.head].lsn - 1
                    else start.lsn;
        }
        state.outbox.deliveredTo(delivered);
        state.outbox.delivered = 0;
        var failure: StoreError? = null;
        let raft = config.journal.raftLog;
        var recoveredTerms = Vector<u64>.create();
        var recoveredConfigs = Vector<RecoveredConfig>.create();
        let journal = Journal.openFrom(dir, config.journal, start, (segment, offset, header, bytes) => {
            if (failure.isSome()) { return; }
            if (raft) {
                // A Raft log's entries after the checkpoint may yet be cut off: applied when Raft commits them.
                match (recoveredTerms.push(header.term)) {
                    Ok() => {}
                    Err(e) => { failure = StoreError.OutOfMemory(e); }
                }
                let isConfig = match (header.kind) {
                    RecordType.Config => true,
                    _ => false,
                };
                if (isConfig) {
                    var m = Vector<u8>.create();
                    let metaEnd = RECORD_HEADER_LEN + header.metaLen as usize;
                    let kept = m.extend(bytes[RECORD_HEADER_LEN..metaEnd]).isOk() &&
                        recoveredConfigs.push(RecoveredConfig { index: header.lsn, membership: m }).isOk();
                    if (!kept) { failure = StoreError.OutOfMemory(AllocError.OutOfMemory); }
                }
                return;
            }
            let metaEnd = RECORD_HEADER_LEN + header.metaLen as usize;
            let payloadEnd = metaEnd + header.payloadLen as usize;
            let manifest = if (payloadToApply(header.kind)) bytes[metaEnd..payloadEnd] else bytes[0..0];
            match (applyRecord(
                mut state,
                header.kind,
                header.lsn,
                segment,
                offset,
                header.totalLen,
                bytes[RECORD_HEADER_LEN..metaEnd],
                header.payloadLen,
                manifest,
            )) {
                Ok() => {}
                Err(e) => { failure = e; }
            }
        })?;
        match (failure) {
            Some(e) => { return Err(e); }
            null => {}
        }
        let skipped = journal.skippedSegments();
        for (i in 0..skipped.length) { state.addSegmentBytes(skipped[i].id, skipped[i].size, 0)?; }
        let unscanned = journal.unscannedSegments();
        for (i in 0..unscanned.length) {
            // Records only, as the live store counts a segment: its header is not part of it.
            let header = SEGMENT_HEADER_LEN as u64;
            let records = if (unscanned[i].size > header) unscanned[i].size - header else 0;
            state.addSegmentBytes(unscanned[i].id, records, 0)?;
        }
        // The checkpoint can name records in segments that compaction removed after it: Relocate records later in
        // the journal, now replayed, moved those versions out. Such a segment is accounted for with nothing in it,
        // and it must not be kept, or compaction would try to remove its file again (ADR-0005; found by the soak).
        var gone = Vector<u64>.create();
        for (i in 0..state.segments.length()) {
            let id: u64 = state.segments.keyAt(i);
            if (id >= start.segment) { continue; }
            var present = false;
            for (u in unscanned) {
                if (u.id == id) { present = true; }
            }
            if (!present) { gone.push(id)?; }
        }
        for (id in gone.view()) { let _ = state.segments.remove(borrow id); }
        if (complete.length > 0) { removeCheckpoints(dir, start.lsn, false); }
        var root = String.create();
        root.append(dir)?;
        var extentDir = String.create();
        extentDir.append(dir)?;
        extentDir.append("/extents")?;
        sio(Fs.ensureDirectory(extentDir.view()))?;
        let publishedNext = if (raft) start.lsn + 1 else journal.upcomingLsn();
        var store = ObjectStore {
            journal: journal,
            state: state,
            config: config,
            scratch: Vector<u8>.create(),
            pendingApplies: Vector<PendingApply>.create(),
            renameTokens: Vector<RenameToken>.create(),
            inflightApplies: Vector<PendingApply>.create(),
            publishedNext: publishedNext,
            extentDir: extentDir,
            dir: root,
            checkpointLsn: start.lsn,
            checkpointSegment: start.segment,
            sinceCheckpoint: 0,
            pins: ExtentPins.create(),
            segmentPins: ExtentPins.create(),
            abandoned: Channel<u64>.create(ABANDONED_CAPACITY)?,
            deferred: Vector<DeferredExtent>.create(),
            deferredBytes: 0,
            lifecycleRan: 0,
            volumeMeasured: false,
            volumeTotal: 0,
            volumeAvailable: 0,
            usedAtMeasure: 0,
            raft: raft,
            term: 0,
            stagedBuckets: Vector<StagedBucket>.create(),
            recoveredTerms: recoveredTerms,
            recoveredConfigs: recoveredConfigs,
            appliedTerm: startTerm,
            checkpointTerm: startTerm,
            nodeId: 0,
            wanted: Channel<u64>.create(256)?,
            wholeCoded: HashMap<u64, bool>.create(),
            codingAfter: null,
            counts: StoreCounters {
                payloadBytes: 0,
                journalBytesWritten: 0,
                extentBytesWritten: 0,
                checkpointBytesWritten: 0,
                compactionBytesCopied: 0,
                segmentsCompacted: 0,
                checkpoints: 0,
                upkeepHolds: 0,
                upkeepSlowHolds: 0,
                upkeepLongestMicros: 0,
            },
        };
        // Every extent not referenced by a live version is garbage: superseded or deleted
        // versions, and uploads that never committed (ADR-0003).
        store.state.deadExtents.clear();
        // Not in a Raft log: the entries after the checkpoint are not applied yet, and their extents would look like
        // orphans (ADR-0061 §4). Upkeep sweeps there, carefully.
        if (!store.raft) { store.sweepOrphanExtents()?; }
        store.measureVolume();
        // Which coded extents have a whole copy here.
        for (i in 0..store.state.coded.length()) {
            let id: u64 = store.state.coded.keyAt(i);
            let path = store.wholePathOf(id)?;
            if (ObjectStore.fileExists(path.view())) { let _ = store.wholeCoded.put(id, true)?; }
        }
        return Ok(store);
    }

    /// Measures the volume that holds the store (ADR-0040). A failed measurement keeps the last one: admission goes on
    /// with what it knew, and the next upkeep round asks again.
    fn measureVolume(borrow mut this) {
        match (Fs.space(this.dir.view())) {
            Ok(v) => { this.noteVolume(v.total, v.available); }
            Err(_) => {}
        }
    }

    /// Takes a measurement of the volume: `available` is what this process could write when the store occupied what
    /// it occupies now.
    fn noteVolume(borrow mut this, total: u64, available: u64) {
        this.volumeMeasured = true;
        this.volumeTotal = total;
        this.volumeAvailable = available;
        this.usedAtMeasure = this.usedBytes();
    }

    /// The volume's size and the bytes still available to the store's writes by its estimate, null when not measured
    /// (ADR-0040).
    fn volumeSpace(borrow this) -> VolumeSpace? {
        if (!this.volumeMeasured) { return null; }
        return VolumeSpace { total: this.volumeTotal, free: this.volumeEstimate(), available: this.volumeEstimate() };
    }

    /// The bytes available on the volume now, by estimate: the last measurement, less what the store has grown since.
    /// What it shrank is not credited until the next measurement.
    fn volumeEstimate(borrow this) -> u64 {
        let used = this.usedBytes();
        let grown = if (used > this.usedAtMeasure) used - this.usedAtMeasure else 0;
        return if (grown >= this.volumeAvailable) 0 else this.volumeAvailable - grown;
    }

    /// Removes extent files that no live version references. Only safe while no writer is
    /// in progress, so it runs at open.
    fn sweepOrphanExtents(borrow mut this) -> Result<usize, StoreError> {
        let orphans = this.orphanExtents()?;
        for (id in orphans.view()) {
            removeExtent(this.extentDir.view(), id);
        }
        return Ok(orphans.length);
    }

    // --- Extents on a cluster (ADR-0061) ---

    /// The extents the entries `from` to `to` name: the new extents of PutExtent and UploadPart records (an
    /// UploadComplete's are its parts', pushed with them). What a leader pushes before it proposes them.
    fn extentsOfEntries(borrow this, from: u64, to: u64) -> Result<Vector<u64>, StoreError> {
        var out = Vector<u64>.create();
        var lsn = from;
        while (lsn <= to) {
            let at = this.journal.entryAt(lsn)?;
            let h = borrow at.header;
            let fresh = match (h.kind) {
                RecordType.PutExtent => true,
                RecordType.UploadPart => true,
                _ => false,
            };
            if (fresh) {
                let record = this.journal.readRecord(at.segment, at.offset, h.totalLen)?;
                let metaEnd = RECORD_HEADER_LEN + h.metaLen as usize;
                let payloadEnd = metaEnd + h.payloadLen as usize;
                let refs = match (decodeManifest(record[metaEnd..payloadEnd])) {
                    Ok(r) => r,
                    Err(_) => { return Err(StoreError.BadMeta(at.segment, at.offset)); }
                };
                for (k in 0..refs.length) { out.push(refs[k].id)?; }
            }
            lsn += 1;
        }
        return Ok(out);
    }

    /// Where the store's extent files are.
    fn extentDirectory(borrow this) -> StringView => this.extentDir.view();

    // --- Write sessions (ADR-0068) ---

    /// The session of request `id`, if this replica has applied one.
    fn sessionOf(borrow this, id: [u8; 16]) -> SessionEntry? => this.state.sessions.find(id);

    /// Stages the Session record of a write the leader did (ADR-0068 §2): its id and answer, or only that it was done
    /// when the answer is over SESSION_ANSWER_MAX.
    fn stageSession(borrow mut this, id: [u8; 16], answer: Slice<u8>) -> Result<void, StoreError> {
        let kept = answer.length <= SESSION_ANSWER_MAX;
        let meta = sessionMeta(id, kept)?;
        let empty = Vector<u8>.create();
        let _ = this.stageRecord(RecordType.Session, meta.view(), if (kept) answer else empty.view())?;
        return Ok();
    }

    // --- Coded extents (ADR-0064) ---

    /// This replica's node, whose piece of a coded extent it holds.
    fn setNodeId(borrow mut this, id: u32) { this.nodeId = id; }

    fn codedOf(borrow this, id: u64) -> Result<CodedExtent?, StoreError> {
        return match (this.state.coded.get(borrow id)) {
            Some(c) => Ok(Some(c.copy()?)),
            null => Ok(null),
        };
    }

    fn fileExists(path: StringView) -> bool => DurableFile.openRead(path).isOk();

    // A coded thing's whole copy (ADR-0070): an extent's file, or a segment's.

    fn wholePathOf(borrow this, id: u64) -> Result<String, StoreError> {
        if (this.codedIsSegment(id)) { return Ok(this.journal.segmentFile(segmentOfCoded(id))?); }
        return Ok(extentPath(this.extentDir.view(), id)?);
    }

    /// The coded bytes of `id`'s whole copy, `length` of them; null when there is none here or it is not that long.
    fn wholeDataOf(borrow this, id: u64, length: u64) -> Result<Vector<u8>?, StoreError> {
        if (this.codedIsSegment(id)) {
            let path = this.wholePathOf(id)?;
            let file = match (DurableFile.openRead(path.view())) {
                Ok(f) => f,
                Err(e) => {
                    if (e.isNotFound()) { return Ok(null); }
                    return Err(StoreError.Io(e));
                }
            };
            if (sio(file.size())? != length) { return Ok(null); }
            var out = Vector<u8>.create();
            out.resize(length as usize, 0)?;
            sio(file.readExactAt(mut out.viewMut(), 0))?;
            return Ok(Some(out));
        }
        let bytes = match (this.extentFileBytes(id)) {
            Ok(b) => b,
            Err(StoreError.Io(e)) => {
                if (e.isNotFound()) { return Ok(null); }
                return Err(StoreError.Io(e));
            }
            Err(e) => { return Err(e); }
        };
        if ((bytes.length as u64) != EXTENT_HEADER_LEN + length) { return Ok(null); }
        var out = Vector<u8>.create();
        out.extend(bytes.view()[EXTENT_HEADER_LEN as usize..bytes.length])?;
        return Ok(Some(out));
    }

    fn removeWholeOf(borrow mut this, id: u64) -> Result<void, StoreError> {
        if (this.codedIsSegment(id)) {
            match (this.journal.removeSegment(segmentOfCoded(id))) {
                Ok() => {}
                Err(JournalError.Io(e)) => {
                    if (!e.isNotFound()) { return Err(StoreError.Journal(JournalError.Io(e))); }
                }
                Err(e) => { return Err(StoreError.Journal(e)); }
            }
            sio(Fs.syncDirectory(this.dir.view()))?;
            return Ok();
        }
        removeExtent(this.extentDir.view(), id);
        return Ok();
    }

    /// Whether coding `id` is a sealed segment's (ADR-0070): as its record says.
    fn codedIsSegment(borrow this, id: u64) -> bool => match (this.state.coded.get(borrow id)) {
        Some(c) => c.segment,
        null => false,
    };

    /// Whether sealed segment `segment` is coded (ADR-0070).
    fn segmentIsCoded(borrow this, segment: u64) -> bool {
        let id = segmentCodedId(segment);
        return this.state.coded.contains(borrow id);
    }

    /// Whether `id`'s whole copy here is the bytes its coding was made of (its first piece's CRC, a slice of it); true
    /// when there is none (nothing to keep).
    fn wholeMatches(borrow this, id: u64) -> Result<bool, StoreError> {
        let c = match (this.state.coded.get(borrow id)) {
            Some(c) => c.copy()?,
            null => { return Ok(true); }
        };
        let data = match (this.wholeDataOf(id, c.length)?) {
            Some(d) => d,
            null => {
                // A file of another length is not it either.
                let path = this.wholePathOf(id)?;
                return Ok(!ObjectStore.fileExists(path.view()));
            }
        };
        let rs = match (ReedSolomon.create(c.k as usize, c.m as usize)?) {
            Some(r) => r,
            null => { return Ok(false); }
        };
        return Ok(Crc32c.of(rs.piece(data.view(), 0)?.view()) == c.crcs[0]);
    }

    /// Whether a read holds `id`'s whole copy open.
    fn wholePinned(borrow this, id: u64) -> bool =>
        if (this.codedIsSegment(id)) this.segmentPins.isPinned(segmentOfCoded(id)) else this.pins.isPinned(id);

    /// Sealed segments a leader codes (ADR-0070 §1): wholly before the checkpoint's segment, at least
    /// SEGMENT_CODE_MIN_BYTES, mostly live (compaction would not take them), not coded, not pinned, their files older
    /// than `before`. At most `most`.
    fn segmentCodingCandidates(borrow this, before: i64, most: usize) -> Result<Vector<u64>, StoreError> {
        var out = Vector<u64>.create();
        for (i in 0..this.state.segments.length()) {
            if (out.length >= most) { break; }
            let id: u64 = this.state.segments.keyAt(i);
            let u = this.state.segments.valueAt(i);
            if (id >= this.checkpointSegment || this.segmentIsCoded(id)) { continue; }
            if (u.liveBytes == 0 || u.liveBytes * 100 < u.totalBytes * this.config.compactBelowLivePercent) {
                continue;
            }
            if (this.segmentPins.isPinned(id)) { continue; }
            let path = this.journal.segmentFile(id)?;
            let file = match (DurableFile.openRead(path.view())) {
                Ok(f) => f,
                Err(_) => { continue; }
            };
            if (sio(file.size())? < SEGMENT_CODE_MIN_BYTES) { continue; }
            match (Fs.modifiedMillis(path.view())) {
                Ok(m) => {
                    if (m < before) { out.push(id)?; }
                }
                Err(_) => {}
            }
        }
        return Ok(out);
    }

    /// Stages the Coded record of sealed segment `segment` for the voters `holders` (ADR-0070 §2): its file read whole,
    /// its pieces made for their CRCs. Whether it was staged.
    fn stageCodedSegment(borrow mut this, segment: u64, holders: Slice<u32>) -> Result<bool, StoreError> {
        let id = segmentCodedId(segment);
        let n = holders.length;
        if (n < 3 || this.state.coded.contains(borrow id) || segment >= this.checkpointSegment) { return Ok(false); }
        let path = this.journal.segmentFile(segment)?;
        let file = match (DurableFile.openRead(path.view())) {
            Ok(f) => f,
            Err(_) => { return Ok(false); }
        };
        let size = sio(file.size())?;
        var data = Vector<u8>.create();
        data.resize(size as usize, 0)?;
        sio(file.readExactAt(mut data.viewMut(), 0))?;
        let m = (n - 1) / 2;
        let k = n - m;
        let rs = match (ReedSolomon.create(k, m)?) {
            Some(r) => r,
            null => { return Ok(false); }
        };
        var crcs = Vector<u32>.create();
        for (i in 0..n) { crcs.push(Crc32c.of(rs.piece(data.view(), i)?.view()))?; }
        var holderIds = Vector<u32>.create();
        for (x in holders) { holderIds.push(x)?; }
        let c = CodedExtent {
            id: id,
            k: truncate<u32>(k),
            m: truncate<u32>(m),
            length: size,
            pieceLength: rs.pieceLength(size),
            holders: holderIds,
            crcs: crcs,
            segment: true,
        };
        var meta = Vector<u8>.create();
        encodeCoded(mut meta, borrow c)?;
        let empty = Vector<u8>.create();
        let _ = this.stageRecord(RecordType.Coded, meta.view(), empty.view())?;
        return Ok(true);
    }

    /// A coded segment with nothing live left: its pieces and coding go (it has no file to remove).
    fn dropCodedSegment(borrow mut this, segment: u64) -> Result<void, StoreError> {
        let id = segmentCodedId(segment);
        // Its whole copy, if a read had it decoded, while the coding still says it is a segment's.
        this.removeWholeOf(id)?;
        match (this.state.coded.remove(borrow id)) {
            Some(c) => {
                for (p in 0..c.holders.length) {
                    match (piecePath(this.extentDir.view(), id, p)) {
                        Ok(path) => { let _ = Fs.unlink(path.view()); }
                        Err(_) => {}
                    }
                }
            }
            null => {}
        }
        let _ = this.wholeCoded.remove(borrow id);
        return Ok();
    }

    /// A Coded record applied: this replica writes its piece from its whole copy, synced, and only then removes the
    /// copy (kept while a read has it pinned, for `sweepDecoded`); without a whole copy it writes nothing, and its
    /// piece is missing (`missingPieces`).
    fn convertToPiece(borrow mut this, id: u64) -> Result<void, StoreError> {
        if (!this.state.coded.contains(borrow id)) { return Ok(); }
        let _ = this.pieceFromWhole(id)?;
        // A segment whose file is not the bytes the leader coded stays whole (ADR-0070 §4): its records' places are
        // this replica's, and only its own copy has them there. (Segments are the same on every replica, so this is a
        // guard, not a path taken.)
        if (this.codedIsSegment(id) && !this.wholeMatches(id)?) {
            let full = this.wholePathOf(id)?;
            if (ObjectStore.fileExists(full.view())) { let _ = this.wholeCoded.put(id, true)?; }
            return Ok();
        }
        if (this.wholePinned(id)) {
            let full = this.wholePathOf(id)?;
            if (ObjectStore.fileExists(full.view())) { let _ = this.wholeCoded.put(id, true)?; }
            return Ok();
        }
        this.removeWholeOf(id)?;
        let _ = this.wholeCoded.remove(borrow id);
        return Ok();
    }

    /// Writes this replica's piece of coded extent `id` from its whole copy, when it holds a piece, lacks it, and has
    /// a whole copy whose piece has the record's CRC. Whether it wrote one; an error when the copy could not be read
    /// or the piece not written, and then the copy must stay.
    fn pieceFromWhole(borrow mut this, id: u64) -> Result<bool, StoreError> {
        let c = match (this.state.coded.get(borrow id)) {
            Some(c) => c.copy()?,
            null => { return Ok(false); }
        };
        let i = match (c.pieceOf(this.nodeId)) {
            Some(i) => i,
            null => { return Ok(false); }
        };
        if (this.pieceFileOk(borrow c, i)?) { return Ok(false); }
        // No whole copy is no piece; a copy that cannot be read is an error, so that the caller keeps it (a copy
        // removed with no piece written would be the data lost here).
        let data = match (this.wholeDataOf(id, c.length)?) {
            Some(d) => d,
            null => { return Ok(false); }
        };
        let rs = match (ReedSolomon.create(c.k as usize, c.m as usize)?) {
            Some(r) => r,
            null => { return Ok(false); }
        };
        let piece = rs.piece(data.view(), i)?;
        if (Crc32c.of(piece.view()) != c.crcs[i]) { return Ok(false); } // not the bytes the leader coded
        this.writePiece(id, i, piece.view())?;
        return Ok(true);
    }

    /// Whether piece `index` of `c` is here at its length (a stat, no read: its CRC is scrub's to check).
    fn pieceFileOk(borrow this, c: borrow CodedExtent, index: usize) -> Result<bool, StoreError> {
        let path = piecePath(this.extentDir.view(), c.id, index)?;
        return match (DurableFile.openRead(path.view())) {
            Ok(f) => match (f.size()) {
                Ok(n) => Ok(n == c.pieceLength),
                Err(_) => Ok(false),
            },
            Err(_) => Ok(false),
        };
    }

    /// Whether this replica's piece of coded extent `id` is here but damaged (its length or CRC wrong): scrub's
    /// check (ADR-0064 §6).
    fn pieceDamaged(borrow this, id: u64) -> Result<bool, StoreError> {
        let c = match (this.state.coded.get(borrow id)) {
            Some(c) => c,
            null => { return Ok(false); }
        };
        let i = match (c.pieceOf(this.nodeId)) {
            Some(i) => i,
            null => { return Ok(false); }
        };
        let path = piecePath(this.extentDir.view(), id, i)?;
        if (!ObjectStore.fileExists(path.view())) { return Ok(false); }
        return Ok(this.pieceBytes(id, i)?.isNull());
    }

    /// Whether a read of `v` must wait for a coded extent to be decoded here; if so, the extent is noted as wanted
    /// (ADR-0064 §5).
    fn wantsDecode(borrow this, v: borrow ObjectVersion) -> bool {
        // An inline version in a coded segment (ADR-0070 §3).
        if (v.extents.length == 0) {
            let id = segmentCodedId(v.recordSegment);
            if (!this.state.coded.contains(borrow id) || this.wholeCoded.contains(borrow id)) { return false; }
            let _ = this.wanted.trySend(id);
            return true;
        }
        var wants = false;
        for (e in 0..v.extents.length) {
            let id = v.extents[e].id;
            if (!this.state.coded.contains(borrow id) || this.wholeCoded.contains(borrow id)) { continue; }
            // Every one of them, so one retry finds them all.
            let _ = this.wanted.trySend(id);
            wants = true;
        }
        return wants;
    }

    fn writePiece(borrow mut this, id: u64, index: usize, bytes: Slice<u8>) -> Result<void, StoreError> {
        let path = piecePath(this.extentDir.view(), id, index)?;
        match (Fs.unlink(path.view())) {
            Ok() => {}
            Err(e) => {
                if (!e.isNotFound()) { return Err(StoreError.Io(e)); }
            }
        }
        let file = sio(DurableFile.createNew(path.view()))?;
        sio(file.writeAt(bytes, 0))?;
        sio(file.syncData())?;
        sio(Fs.syncDirectory(this.extentDir.view()))?;
        return Ok();
    }

    /// Piece `index` of coded extent `id`, as this replica holds it, checked against the record's CRC.
    fn pieceBytes(borrow this, id: u64, index: usize) -> Result<Vector<u8>?, StoreError> {
        let c = match (this.state.coded.get(borrow id)) {
            Some(c) => c,
            null => { return Ok(null); }
        };
        if (index >= c.crcs.length) { return Ok(null); }
        let path = piecePath(this.extentDir.view(), id, index)?;
        let file = match (DurableFile.openRead(path.view())) {
            Ok(f) => f,
            Err(_) => { return Ok(null); }
        };
        if (sio(file.size())? != c.pieceLength) { return Ok(null); }
        var out = Vector<u8>.create();
        out.resize(c.pieceLength as usize, 0)?;
        sio(file.readExactAt(mut out.viewMut(), 0))?;
        if (Crc32c.of(out.view()) != c.crcs[index]) { return Ok(null); }
        return Ok(Some(out));
    }

    /// Installs piece `index` of coded extent `id`, once checked against the record's CRC (ADR-0064 §4).
    fn installPiece(borrow mut this, id: u64, index: usize, bytes: Slice<u8>) -> Result<bool, StoreError> {
        let ok = match (this.state.coded.get(borrow id)) {
            Some(c) => index < c.crcs.length && (bytes.length as u64) == c.pieceLength && Crc32c.of(
                bytes,
            ) == c.crcs[index],
            null => false,
        };
        if (!ok) { return Ok(false); }
        this.writePiece(id, index, bytes)?;
        return Ok(true);
    }

    /// The coded extents whose piece this replica holds but lacks: (id, index), at most `most`. A whole copy here
    /// gives its piece first (a crash between applying a Coded record and writing the piece leaves one). A damaged
    /// piece is scrub's to find and remove (ADR-0064 §6), and then it is missing.
    fn missingPieces(borrow mut this, most: usize) -> Result<Vector<[u64; 2]>, StoreError> {
        var lacking = Vector<[u64; 2]>.create();
        for (i in 0..this.state.coded.length()) {
            if (lacking.length >= most) { break; }
            let c = this.state.coded.valueAt(i);
            match (c.pieceOf(this.nodeId)) {
                Some(p) => {
                    if (!this.pieceFileOk(c, p)?) { lacking.push([c.id, p as u64])?; }
                }
                null => {}
            }
        }
        var out = Vector<[u64; 2]>.create();
        for (x in lacking.view()) {
            if (!this.pieceFromWhole(x[0])?) { out.push(x)?; }
        }
        return Ok(out);
    }

    /// The coded extents reads wanted decoded since the last call (ADR-0064 §5).
    fn takeWanted(borrow this) -> Vector<u64> {
        var out = Vector<u64>.create();
        while (true) {
            match (this.wanted.tryRecv()) {
                Some(id) => {
                    var seen = false;
                    for (x in out.view()) {
                        if (x == id) { seen = true; }
                    }
                    if (!seen && out.push(id).isErr()) { break; }
                }
                null => { break; }
            }
        }
        return out;
    }

    /// A coded extent decoded again (ADR-0064 §5): written as an extent file, with its header, synced.
    fn installDecoded(borrow mut this, id: u64, data: Slice<u8>) -> Result<void, StoreError> {
        if (this.codedIsSegment(id)) {
            // A segment's whole copy is its file again, as it was before it was coded (synced, its directory synced).
            let path = this.wholePathOf(id)?;
            let _ = Fs.unlink(path.view());
            let file = sio(DurableFile.createNew(path.view()))?;
            sio(file.writeAt(data, 0))?;
            sio(file.syncData())?;
            sio(Fs.syncDirectory(this.dir.view()))?;
            let _ = this.wholeCoded.put(id, true)?;
            return Ok();
        }
        var bytes = Vector<u8>.create();
        bytes.resize(EXTENT_HEADER_LEN as usize, 0)?;
        bytes.viewMut().writeLE(0, EXTENT_MAGIC);
        bytes.viewMut().writeLE(8, id);
        bytes.viewMut().writeLE(16, Clock.unixMillis());
        let crc = Crc32c.of(bytes.view()[0..60]);
        bytes.viewMut().writeLE(60, crc);
        bytes.extend(data)?;
        this.installExtent(id, bytes.view())?;
        let _ = this.wholeCoded.put(id, true)?;
        return Ok();
    }

    /// Extents of live versions, not coded, whose files are older than `before` (Unix ms): what a leader codes, at
    /// most `most`. Each call looks at up to CODING_SCAN_KEYS keys after the last call's, from the first again at the
    /// end, so a large index costs a little each time.
    fn codingCandidates(borrow mut this, before: i64, most: usize) -> Result<Vector<ExtentRef>, StoreError> {
        var out = Vector<ExtentRef>.create();
        var cursor = match (this.codingAfter.asBorrow()) {
            Some(k) => this.state.index.seekAfter(k),
            null => this.state.index.first(),
        };
        var seen = 0usize;
        var last: IndexKey? = null;
        while (out.length < most && seen < CODING_SCAN_KEYS) {
            let i = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            cursor = this.state.index.next(i);
            seen += 1;
            last = copyIndexKey(this.state.index.keyAt(i))?;
            var slot = this.state.index.slotAt(i);
            while (slot != NO_VERSION_SLOT) {
                let v = this.state.index.versionAt(slot);
                slot = this.state.index.olderOf(slot);
                for (e in 0..v.extents.length) {
                    let ext = v.extents[e];
                    if (this.state.coded.contains(borrow ext.id) || out.length >= most) { continue; }
                    var dup = false;
                    for (o in out.view()) {
                        if (o.id == ext.id) { dup = true; }
                    }
                    if (dup) { continue; }
                    let path = extentPath(this.extentDir.view(), ext.id)?;
                    match (Fs.modifiedMillis(path.view())) {
                        Ok(m) => {
                            if (m < before) { out.push(ext)?; }
                        }
                        Err(_) => {}
                    }
                }
            }
        }
        this.codingAfter = if (cursor.isNull()) null else last;
        return Ok(out);
    }

    /// Stages the Coded record of extent `ext` for the voters `holders` (a leader's, ADR-0064 §3): its whole copy
    /// read and checked against the manifest, its pieces made for their CRCs. Whether it was staged.
    fn stageCoded(borrow mut this, ext: ExtentRef, holders: Slice<u32>) -> Result<bool, StoreError> {
        let id = ext.id;
        let n = holders.length;
        if (n < 3 || this.state.coded.contains(borrow id)) { return Ok(false); }
        let m = (n - 1) / 2;
        let k = n - m;
        let bytes = match (this.extentFileBytes(id)) {
            Ok(b) => b,
            Err(_) => { return Ok(false); }
        };
        let h = bytes.view();
        if ((h.length as u64) != EXTENT_HEADER_LEN + ext.length || h.readLE<u64>(0) != EXTENT_MAGIC ||
            h.readLE<u64>(8) != id || Crc32c.of(h[EXTENT_HEADER_LEN as usize..h.length]) != ext.crc) {
            return Ok(false);
        }
        let data = bytes.view()[EXTENT_HEADER_LEN as usize..bytes.length];
        let rs = match (ReedSolomon.create(k, m)?) {
            Some(r) => r,
            null => { return Ok(false); }
        };
        var crcs = Vector<u32>.create();
        for (i in 0..n) { crcs.push(Crc32c.of(rs.piece(data, i)?.view()))?; }
        var holderIds = Vector<u32>.create();
        for (x in holders) { holderIds.push(x)?; }
        let c = CodedExtent {
            id: id,
            k: truncate<u32>(k),
            m: truncate<u32>(m),
            length: data.length as u64,
            pieceLength: rs.pieceLength(data.length as u64),
            holders: holderIds,
            crcs: crcs,
            segment: false,
        };
        var meta = Vector<u8>.create();
        encodeCoded(mut meta, borrow c)?;
        let empty = Vector<u8>.create();
        let _ = this.stageRecord(RecordType.Coded, meta.view(), empty.view())?;
        return Ok(true);
    }

    /// Coded extents with a holder that no longer votes in the shard (it left, ADR-0062), each with the holders it
    /// should have: the departed replaced by a voter that holds no piece of it. At most `most`; none when no voter is
    /// free to take one (the M6 exit review's F1: a piece whose holder left was never made again).
    fn recodeCandidates(borrow this, voters: Slice<u32>, most: usize) -> Result<Vector<RecodeCandidate>, StoreError> {
        var out = Vector<RecodeCandidate>.create();
        for (i in 0..this.state.coded.length()) {
            if (out.length >= most) { break; }
            let c = this.state.coded.valueAt(i);
            var holders = c.holders.clone()?;
            var changed = false;
            for (h in 0..holders.length) {
                var votes = false;
                for (v in voters) {
                    if (v == holders[h]) { votes = true; }
                }
                if (votes) { continue; }
                // The first voter that holds no piece of it.
                var free: u32? = null;
                for (v in voters) {
                    var holds = false;
                    for (x in holders.view()) {
                        if (x == v) { holds = true; }
                    }
                    if (!holds && free.isNull()) { free = Some(v); }
                }
                match (free) {
                    Some(f) => {
                        holders[h] = f;
                        changed = true;
                    }
                    null => {}
                }
            }
            if (changed) { out.push(RecodeCandidate { id: c.id, holders: holders })?; }
        }
        return Ok(out);
    }

    /// Stages the Coded record of extent `id` with new `holders` (ADR-0064, as re-homed by the exit review's F1): its
    /// coding as it is, the pieces' holders changed. Whether it was staged: not when it is not coded, or the holders
    /// are not as many.
    fn stageRecode(borrow mut this, id: u64, holders: Slice<u32>) -> Result<bool, StoreError> {
        let old = match (this.state.coded.get(borrow id)) {
            Some(c) => c.copy()?,
            null => { return Ok(false); }
        };
        if (holders.length != old.holders.length) { return Ok(false); }
        var c = old;
        c.holders.clear();
        for (h in holders) { c.holders.push(h)?; }
        var meta = Vector<u8>.create();
        encodeCoded(mut meta, borrow c)?;
        let empty = Vector<u8>.create();
        let _ = this.stageRecord(RecordType.Coded, meta.view(), empty.view())?;
        return Ok(true);
    }

    /// Removes whole copies of coded extents decoded for reads an hour or more ago (ADR-0064 §5), and ones a crash or
    /// a pinned read left; this replica's piece is written from the copy first when it lacks it.
    fn sweepDecoded(borrow mut this, now: i64) -> Result<usize, StoreError> {
        var gone = Vector<u64>.create();
        for (i in 0..this.wholeCoded.length()) {
            let id: u64 = this.wholeCoded.keyAt(i);
            if (this.wholePinned(id)) { continue; }
            let path = this.wholePathOf(id)?;
            match (Fs.modifiedMillis(path.view())) {
                Ok(m) => {
                    if (m < now - DECODED_KEEP_MS) { gone.push(id)?; }
                }
                Err(_) => { gone.push(id)?; }
            }
        }
        for (id in gone.view()) {
            let _ = this.pieceFromWhole(id)?;
            this.removeWholeOf(id)?;
            let _ = this.wholeCoded.remove(borrow id);
        }
        return Ok(gone.length);
    }

    /// After scrub found coded extent `id` damaged (ADR-0064 §6): its whole copy, a decoded one, removed, and this
    /// replica's piece when it is the damaged part; fetching rebuilds or decodes what is then missing.
    fn quarantineCoded(borrow mut this, id: u64) -> Result<void, StoreError> {
        if (this.pieceDamaged(id)?) {
            let c = match (this.state.coded.get(borrow id)) {
                Some(c) => c,
                null => { return Ok(); }
            };
            match (c.pieceOf(this.nodeId)) {
                Some(i) => {
                    let path = piecePath(this.extentDir.view(), id, i)?;
                    let _ = Fs.unlink(path.view());
                }
                null => {}
            }
        }
        if (!this.pins.isPinned(id)) {
            removeExtent(this.extentDir.view(), id);
            let _ = this.wholeCoded.remove(borrow id);
        }
        return Ok();
    }

    // --- Scrub and repair (ADR-0063) ---

    /// Checks up to `max` live versions after `after` (from the first when null): an inline version's record read and
    /// verified, an extent read whole and checked against its manifest. What it finds damaged, and where to go on.
    fn scrubStep(borrow this, after: borrow (IndexKey?), max: usize) -> Result<ScrubPage, StoreError> {
        var page = ScrubPage { checked: 0, damages: Vector<ScrubDamage>.create(), next: null };
        var cursor = match (after.asBorrow()) {
            Some(k) => this.state.index.seekAfter(k),
            null => this.state.index.first(),
        };
        var seen = 0usize;
        while (seen < max) {
            let i = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            cursor = this.state.index.next(i);
            seen += 1;
            let k = this.state.index.keyAt(i);
            if (seen == max && cursor.isSome()) { page.next = copyIndexKey(k)?; }
            var slot = this.state.index.slotAt(i);
            while (slot != NO_VERSION_SLOT) {
                let v = this.state.index.versionAt(slot);
                slot = this.state.index.olderOf(slot);
                if (isDeleteMarker(v)) { continue; }
                page.checked += 1;
                if (v.extents.length == 0) {
                    match (this.readLiveRecord(v)) {
                        Ok(_) => {}
                        Err(StoreError.DataCorrupt) => {
                            page.damages.push(ScrubDamage {
                                extent: false,
                                bucket: copyBytes(this.state.bucketName(k.bucket))?,
                                key: copyBytes(k.key.view())?,
                                versionId: v.versionId,
                                id: 0,
                                segment: v.recordSegment,
                                offset: v.payload.offset + v.payload.length as u64 + RECORD_TRAILER_LEN as u64 -
                                    v.recordLength as u64,
                                length: v.recordLength,
                            })?;
                        }
                        Err(_) => {}
                    }
                    continue;
                }
                for (e in 0..v.extents.length) {
                    let want = borrow v.extents[e];
                    // A coded extent: this replica's piece checked too (ADR-0064 §6).
                    let pieceHurt = this.state.coded.contains(borrow want.id) && this.pieceDamaged(want.id)?;
                    let whole = !pieceHurt && match (this.extentFileBytes(want.id)) {
                        Ok(b) => {
                            let h = b.view();
                            (h.length as u64) == EXTENT_HEADER_LEN + want.length && h.readLE<u64>(0) == EXTENT_MAGIC &&
                                h.readLE<u64>(8) == want.id && h.readLE<u32>(60) == Crc32c.of(h[0..60]) &&
                                Crc32c.of(h[EXTENT_HEADER_LEN as usize..h.length]) == want.crc
                        }
                        Err(_) => true, // missing: fetching sees to it (ADR-0061 §3)
                    };
                    if (!whole) {
                        page.damages.push(ScrubDamage {
                            extent: true,
                            bucket: copyBytes(this.state.bucketName(k.bucket))?,
                            key: copyBytes(k.key.view())?,
                            versionId: v.versionId,
                            id: want.id,
                            segment: 0,
                            offset: 0,
                            length: 0,
                        })?;
                    }
                }
            }
        }
        return Ok(page);
    }

    /// Removes a damaged extent's file, so that fetching what is missing puts a good copy back (ADR-0063 §2).
    fn quarantineExtent(borrow mut this, id: u64) {
        if (this.state.coded.contains(borrow id)) {
            let _ = this.quarantineCoded(id);
            return;
        }
        removeExtent(this.extentDir.view(), id);
    }

    /// This replica's live record of a version, whole and verified, when it is inline and `length` bytes long: what
    /// another replica asks for to repair its own (ADR-0063 §3).
    fn recordOfVersion(
        borrow this,
        bucket: Slice<u8>,
        key: Slice<u8>,
        versionId: [u8; 16],
        length: u32,
    ) -> Result<Vector<u8>?, StoreError> {
        if (!this.state.hasBucket(bucket)?) { return Ok(null); }
        let k = this.state.keyFor(bucket, key)?;
        let v = match (this.state.index.find(borrow k, versionId)) {
            Some(v) => v,
            null => { return Ok(null); }
        };
        if (v.extents.length != 0 || isDeleteMarker(v) || v.recordLength != length) { return Ok(null); }
        return match (this.readLiveRecord(v)) {
            Ok(b) => Ok(Some(b)),
            Err(_) => Ok(null),
        };
    }

    /// Writes another replica's copy of a version's record over this replica's damaged one (ADR-0063 §3), once it is
    /// checked: a valid record of the same length, in the same place the version names, whose payload has the
    /// version's MD5 (a sealed one: its length). Whether it was written.
    fn repairRecord(
        borrow mut this,
        bucket: Slice<u8>,
        key: Slice<u8>,
        versionId: [u8; 16],
        record: Slice<u8>,
    ) -> Result<bool, StoreError> {
        if (!this.state.hasBucket(bucket)?) { return Ok(false); }
        let k = this.state.keyFor(bucket, key)?;
        let v = match (this.state.index.find(borrow k, versionId)) {
            Some(v) => v,
            null => { return Ok(false); }
        };
        if (v.extents.length != 0 || record.length != v.recordLength as usize) { return Ok(false); }
        let h = match (decodeRecord(record)) {
            Ok(h) => h,
            Err(_) => { return Ok(false); }
        };
        if (h.payloadLen != v.payload.length) { return Ok(false); }
        let end = record.length - RECORD_TRAILER_LEN;
        let payload = record[end - h.payloadLen as usize..end];
        if (!isSealed(v) && v.parts == 0 && Md5.of(payload)[..] != v.md5[..]) { return Ok(false); }
        let offset = v.payload.offset + v.payload.length as u64 + RECORD_TRAILER_LEN as u64 - v.recordLength as u64;
        this.journal.repairAt(v.recordSegment, offset, record)?;
        return Ok(true);
    }

    /// Extent `id`'s file, whole: what a leader pushes, or a replica sends one that lacks it.
    fn extentFileBytes(borrow this, id: u64) -> Result<Vector<u8>, StoreError> {
        let path = extentPath(this.extentDir.view(), id)?;
        let file = sio(DurableFile.openRead(path.view()))?;
        let size = sio(file.size())?;
        let n = match (checkedTruncate<usize>(size)) {
            Some(n) => n,
            null => { return Err(StoreError.EntityTooLarge); }
        };
        var out = Vector<u8>.create();
        out.resize(n, 0)?;
        sio(file.readExactAt(mut out.viewMut(), 0))?;
        return Ok(out);
    }

    /// Installs extent `id` as another replica sent it (ADR-0061 §2): its header checked, written in place of one of
    /// the same id, synced, and the directory synced.
    fn installExtent(borrow mut this, id: u64, bytes: Slice<u8>) -> Result<void, StoreError> {
        if ((bytes.length as u64) < EXTENT_HEADER_LEN) { return Err(StoreError.DataCorrupt); }
        let header = bytes[0..64];
        if (header.readLE<u64>(0) != EXTENT_MAGIC || header.readLE<u64>(8) != id ||
            header.readLE<u32>(60) != Crc32c.of(header[0..60])) {
            return Err(StoreError.DataCorrupt);
        }
        let path = extentPath(this.extentDir.view(), id)?;
        match (Fs.unlink(path.view())) {
            Ok() => {}
            Err(e) => {
                if (!e.isNotFound()) { return Err(StoreError.Io(e)); }
            }
        }
        let file = sio(DurableFile.createNew(path.view()))?;
        sio(file.writeAt(bytes, 0))?;
        sio(file.syncData())?;
        sio(Fs.syncDirectory(this.extentDir.view()))?;
        return Ok();
    }

    /// The extents this store's versions and uploads name that it does not have, with their lengths and CRCs: what a
    /// replica fetches (ADR-0061 §3).
    fn missingExtents(borrow this, most: usize) -> Result<Vector<ExtentRef>, StoreError> {
        let names = match (Directory.list(this.extentDir.view())) {
            Ok(n) => n,
            Err(_) => { return Err(StoreError.Io(IoFailure { op: IoOp.Open, errno: 0 })); }
        };
        var present = HashMap<u64, bool>.create();
        for (i in 0..names.length) {
            match (extentIdFromName(names[i].view())) {
                Some(id) => { let _ = present.put(id, true)?; }
                null => {}
            }
        }
        var missing = Vector<ExtentRef>.create();
        var seen = HashMap<u64, bool>.create();
        var cursor = this.state.index.first();
        while (missing.length < most) {
            let i = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            cursor = this.state.index.next(i);
            var slot = this.state.index.slotAt(i);
            while (slot != NO_VERSION_SLOT) {
                let v = this.state.index.versionAt(slot);
                for (k in 0..v.extents.length) {
                    let e = borrow v.extents[k];
                    // A coded extent is pieces, not a missing file (ADR-0064).
                    if (this.state.coded.contains(borrow e.id)) { continue; }
                    if (!present.contains(borrow e.id) && !seen.contains(borrow e.id)) {
                        let _ = seen.put(e.id, true)?;
                        missing.push(ExtentRef { id: e.id, length: e.length, crc: e.crc })?;
                    }
                }
                slot = this.state.index.olderOf(slot);
            }
        }
        for (i in 0..this.state.uploads.length()) {
            let u = this.state.uploads.valueAt(i);
            for (p in 0..u.parts.length) {
                for (e in u.parts[p].extents.view()) {
                    if (missing.length >= most) { break; }
                    if (!present.contains(borrow e.id) && !seen.contains(borrow e.id)) {
                        let _ = seen.put(e.id, true)?;
                        missing.push(ExtentRef { id: e.id, length: e.length, crc: e.crc })?;
                    }
                }
            }
        }
        return Ok(missing);
    }

    /// A Raft log's orphan sweep (ADR-0061 §4): an extent no version or upload names, no entry after the applied
    /// index names, and whose file is older than ten minutes.
    fn sweepRaftOrphans(borrow mut this, now: i64) -> Result<usize, StoreError> {
        let orphans = this.orphanExtents()?;
        if (orphans.length == 0) { return Ok(0); }
        let tail = this.extentsOfTail()?;
        var removed = 0usize;
        for (id in orphans.view()) {
            var pending = false;
            for (t in tail.view()) {
                if (t == id) { pending = true; }
            }
            if (pending) { continue; }
            let path = extentPath(this.extentDir.view(), id)?;
            let modified = match (Fs.modifiedMillis(path.view())) {
                Ok(m) => m,
                Err(_) => { continue; }
            };
            if (modified > now - 600000) { continue; }
            removeExtent(this.extentDir.view(), id);
            removed += 1;
        }
        return Ok(removed);
    }

    /// Every extent the unapplied entries name, an UploadComplete's included.
    fn extentsOfTail(borrow this) -> Result<Vector<u64>, StoreError> {
        var out = Vector<u64>.create();
        var lsn = this.appliedIndex() + 1;
        let last = this.journal.durableLsn();
        while (lsn <= last) {
            let at = this.journal.entryAt(lsn)?;
            let h = borrow at.header;
            if (carriesManifest(h.kind)) {
                let record = this.journal.readRecord(at.segment, at.offset, h.totalLen)?;
                let metaEnd = RECORD_HEADER_LEN + h.metaLen as usize;
                let payloadEnd = metaEnd + h.payloadLen as usize;
                match (decodeManifest(record[metaEnd..payloadEnd])) {
                    Ok(refs) => {
                        for (k in 0..refs.length) { out.push(refs[k].id)?; }
                    }
                    Err(_) => {}
                }
            }
            lsn += 1;
        }
        return Ok(out);
    }

    /// The extent files that no live version references.
    fn orphanExtents(borrow this) -> Result<Vector<u64>, StoreError> {
        var live = HashMap<u64, bool>.create();
        var cursor = this.state.index.first();
        while (true) {
            let i = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            cursor = this.state.index.next(i);
            var slot = this.state.index.slotAt(i);
            while (slot != NO_VERSION_SLOT) {
                let v = this.state.index.versionAt(slot);
                for (k in 0..v.extents.length) {
                    let _ = live.put(v.extents[k].id, true)?;
                }
                slot = this.state.index.olderOf(slot);
            }
        }
        for (i in 0..this.state.uploads.length()) {
            let u = this.state.uploads.valueAt(i);
            for (p in 0..u.parts.length) {
                for (e in u.parts[p].extents.view()) { let _ = live.put(e.id, true)?; }
            }
        }
        let names = match (Directory.list(this.extentDir.view())) {
            Ok(n) => n,
            Err(_) => { return Err(StoreError.Io(IoFailure { op: IoOp.Open, errno: 0 })); }
        };
        var orphans = Vector<u64>.create();
        for (i in 0..names.length) {
            match (extentIdFromName(names[i].view())) {
                Some(id) => {
                    if (!live.contains(borrow id) && !this.isDeferred(id)) { orphans.push(id)?; }
                }
                null => {}
            }
        }
        return Ok(orphans);
    }

    /// Whether extent `id` is retired and waits for its readers (ADR-0007).
    fn isDeferred(borrow this, id: u64) -> bool {
        for (d in this.deferred.view()) {
            if (d.id == id) { return true; }
        }
        return false;
    }

    /// fsck (ADR-0006): reads every live object through the reader, which verifies each journal record and each
    /// extent's CRC, and compares the bytes' MD5 with the stored one. Also counts extent files that no version
    /// references. Changes nothing.
    fn verify(borrow this) -> Result<VerifyReport, StoreError> {
        var report = VerifyReport {
            objects: 0,
            bytes: 0,
            problems: Vector<VerifyProblem>.create(),
            orphanExtents: this.orphanExtents()?.length,
        };
        var chunk = Vector<u8>.create();
        chunk.resize(65536, 0)?;
        var cursor = this.state.index.first();
        while (true) {
            let i = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            cursor = this.state.index.next(i);
            let k = this.state.index.keyAt(i);
            var slot = this.state.index.slotAt(i);
            while (slot != NO_VERSION_SLOT) {
                let v = this.state.index.versionAt(slot);
                slot = this.state.index.olderOf(slot);
                if (isDeleteMarker(v)) { continue; } // nothing stored to read
                this.verifyVersion(k, v, mut chunk, mut report)?;
            }
        }
        return Ok(report);
    }

    /// Reads one version whole and checks its size and MD5; a fault goes into `report`.
    fn verifyVersion(
        borrow this,
        k: borrow IndexKey,
        v: borrow ObjectVersion,
        chunk: borrow mut Vector<u8>,
        report: borrow mut VerifyReport,
    ) -> Result<void, StoreError> {
        report.objects += 1;
        // A coded extent's bytes are pieces on several nodes: the cluster's scrub checks them (ADR-0064 §6).
        for (e in 0..v.extents.length) {
            if (this.state.coded.contains(
                borrow v.extents[e].id,
            ) && !this.wholeCoded.contains(borrow v.extents[e].id)) {
                return Ok();
            }
        }
        let segment = segmentCodedId(v.recordSegment);
        if (v.extents.length == 0 && this.state.coded.contains(
            borrow segment,
        ) && !this.wholeCoded.contains(borrow segment)) {
            return Ok();
        }
        var fault: VerifyFault? = null;
        match (this.openVersionUnpinned(v, 0, 0xFFFFFFFFFFFFFFFF)) {
            Ok(reader) => {
                var r = reader;
                var md5 = Md5.create();
                var size: u64 = 0;
                loop {
                    match (r.read(mut chunk.viewMut())) {
                        Ok(n) => {
                            if (n == 0) { break; }
                            md5.update(chunk.view()[0..n]);
                            size += n as u64;
                        }
                        Err(e) => {
                            fault = verifyFault(e);
                            break;
                        }
                    }
                }
                report.bytes += size;
                if (fault.isNull()) {
                    let digest = md5.finish();
                    if (isSealed(v)) {
                        // Sealed bytes (ADR-0046): the MD5 is the plaintext's, which only a key opens; their length
                        // is their chunks', and the extents' CRCs and each chunk's tag cover them.
                        let partSizes = match (decodeExtras(v.extras.view())) {
                            Ok(e) => e.partSizes,
                            Err(_) => Vector<u64>.create(),
                        };
                        let expected = sealedLengthOf(v, partSizes.view());
                        if (expected.isNull() || size != (expected ?? 0)) { fault = VerifyFault.Mismatch; }
                    } else if (size != v.size || (v.parts == 0 && digest[..] != v.md5[..])) {
                        // A multipart object's MD5 is its ETag's, not its bytes' (ADR-0009): its extents' CRCs cover
                        // it.
                        fault = VerifyFault.Mismatch;
                    }
                }
            }
            Err(e) => { fault = verifyFault(e); }
        }
        match (fault) {
            Some(f) => {
                report.problems.push(VerifyProblem {
                    bucket: copyBytes(this.state.bucketName(k.bucket))?,
                    key: copyBytes(k.key.view())?,
                    fault: f,
                })?;
            }
            null => {}
        }
        return Ok();
    }

    /// Removes the extent files of versions retired by records that are now durable. An extent that an open reader
    /// pins waits in `deferred` until the reader is dropped (ADR-0007).
    fn reapExtents(borrow mut this) {
        this.reapDeferred();
        this.reapAbandoned();
        for (i in 0..this.state.deadExtents.length) {
            let ext = this.state.deadExtents[i];
            // A coded extent's pieces and coding go with it (ADR-0064).
            let _ = this.wholeCoded.remove(borrow ext.id);
            match (this.state.coded.remove(borrow ext.id)) {
                Some(c) => {
                    for (p in 0..c.holders.length) {
                        match (piecePath(this.extentDir.view(), ext.id, p)) {
                            Ok(path) => { let _ = Fs.unlink(path.view()); }
                            Err(_) => {}
                        }
                    }
                }
                null => {}
            }
            if (!this.pins.isPinned(ext.id)) {
                removeExtent(this.extentDir.view(), ext.id);
                continue;
            }
            let fileBytes = ext.length + EXTENT_HEADER_LEN;
            match (this.deferred.push(DeferredExtent { id: ext.id, fileBytes: fileBytes })) {
                Ok() => { this.deferredBytes += fileBytes; }
                // Never unlinked under its reader: the file is left for the next open's orphan sweep.
                Err(_) => {}
            }
        }
        this.state.deadExtents.clear();
    }

    /// Removes the extents that dropped writers queued.
    fn reapAbandoned(borrow mut this) {
        while (true) {
            match (this.abandoned.tryRecv()) {
                Some(id) => { removeExtent(this.extentDir.view(), id); }
                null => { return; }
            }
        }
    }

    /// Removes the deferred extents that no reader pins any more.
    fn reapDeferred(borrow mut this) {
        var i: usize = 0;
        while (i < this.deferred.length) {
            let d = this.deferred[i];
            if (this.pins.isPinned(d.id)) {
                i += 1;
                continue;
            }
            removeExtent(this.extentDir.view(), d.id);
            this.deferredBytes = if (this.deferredBytes > d.fileBytes) this.deferredBytes - d.fileBytes else 0;
            let _ = this.deferred.swapRemove(i);
        }
    }

    /// The largest object kept inline in the journal.
    fn inlineMaxBytes(borrow this) -> usize => this.config.inlineMaxBytes;

    /// A writer for a new object's bytes; commit it with `putFinished` or `stageFinished`.
    fn newWriter(borrow this) -> Result<ObjectWriter, StoreError> =>
        Ok(ObjectWriter.create(
            this.extentDir.view(),
            this.config.inlineMaxBytes,
            this.config.extentMaxBytes,
            this.abandoned.clone(),
        )?);

    /// What `newWriter` uses, none of which changes while the store is open: a caller may keep it and make writers
    /// without the store (ADR-0032). Its writers are the store's, committed or discarded the same way.
    fn writerFactory(borrow this) -> Result<WriterFactory, AllocError> {
        var dir = String.create();
        dir.append(this.extentDir.view())?;
        return Ok(WriterFactory {
            dir: dir,
            inlineMax: this.config.inlineMaxBytes,
            extentMax: this.config.extentMaxBytes,
            abandoned: this.abandoned.clone(),
        });
    }

    /// Removes the extents of a finished object that will not be committed.
    fn discardFinished(borrow this, obj: borrow FinishedObject) {
        match (borrow obj.body) {
            ObjectBody.Extents(extents) => {
                for (i in 0..extents.length) { removeExtent(this.extentDir.view(), extents[i].id); }
            }
            ObjectBody.Inline(_) => {}
        }
    }

    /// Stages one record, commits it durably, and applies it. Any staged batch commits with it.
    fn commitOne(borrow mut this, kind: RecordType, payload: Slice<u8>) -> Result<u64, StoreError> {
        this.commitStaged()?;
        let pos = stageIn(mut this.journal, this.raft, this.term, kind, this.scratch.view(), payload)?;
        this.journal.commit()?;
        if (this.raft) { return Ok(pos.lsn); } // applied when Raft commits it
        let total = truncate<u32>(recordLength(this.scratch.length, payload.length));
        this.sinceCheckpoint += total as u64;
        this.counts.journalBytesWritten += total as u64;
        applyRecord(
            mut this.state,
            kind,
            pos.lsn,
            pos.segmentId,
            pos.offset,
            total,
            this.scratch.view(),
            truncate<u32>(payload.length),
            if (payloadToApply(kind)) payload else payload[0..0],
        )?;
        this.publishedNext = pos.lsn + 1;
        this.reapExtents();
        return Ok(pos.lsn);
    }

    /// Stages a record: a single node's, or in a cluster shard an entry of this replica's term as leader (ADR-0058).
    /// A cluster shard writes no extents until they replicate (ADR-0058 §10, M6 item 5).
    fn stageRecord(
        borrow mut this,
        kind: RecordType,
        meta: Slice<u8>,
        payload: Slice<u8>,
    ) -> Result<RecordPosition, StoreError> =>
        stageIn(mut this.journal, this.raft, this.term, kind, meta, payload);

    // --- A cluster shard's replica (ADR-0058, M6 item 2 slice c) ---

    /// Whether this store is a cluster shard's replica.
    fn isReplica(borrow this) -> bool => this.raft;

    /// The term this replica stages entries in while it leads; 0 while it does not (writes are then NotLeader).
    fn setLeaderTerm(borrow mut this, term: u64) {
        // A change of term ends what this replica staged as leader: whether it commits is no longer its to know.
        if (term != this.term) { this.stagedBuckets.clear(); }
        this.term = term;
    }

    /// Whether a write may go into `bucket`: it is there, or a staged entry of this leader's makes it (ADR-0128 §1).
    fn bucketForWrite(borrow this, bucket: Slice<u8>) -> Result<bool, StoreError> {
        if (this.state.hasBucket(bucket)?) { return Ok(true); }
        for (b in this.stagedBuckets.view()) {
            if (b.name.view() == bucket) { return Ok(true); }
        }
        return Ok(false);
    }

    /// A bucket made by the entry at `lsn`, staged by this leader: taken for writes until it applies or is cut off.
    fn noteStagedBucket(borrow mut this, name: Slice<u8>, lsn: u64) -> Result<void, StoreError> {
        if (this.raft) {
            this.stagedBuckets.push(StagedBucket { name: copyBytes(name)?, lsn: lsn, versioning: VERSIONING_OFF })?;
        }
        return Ok();
    }

    /// The staged buckets whose entries are past `lsn`'s applied end (`after` false), or cut off after it (true).
    fn dropStagedBuckets(borrow mut this, lsn: u64, after: bool) {
        var at: usize = 0;
        while (at < this.stagedBuckets.length) {
            let gone = if (after) this.stagedBuckets[at].lsn > lsn else this.stagedBuckets[at].lsn <= lsn;
            if (gone) {
                let _ = this.stagedBuckets.remove(at);
            } else {
                at += 1;
            }
        }
    }

    /// The terms of the unapplied entries recovery found, once: for the replica's Raft core.
    fn takeRecoveredTerms(borrow mut this) -> Vector<u64> => replace(mut this.recoveredTerms, Vector<u64>.create());

    /// The Config records among them, once (ADR-0062 §2).
    fn takeRecoveredConfigs(borrow mut this) -> Vector<RecoveredConfig> =>
        replace(mut this.recoveredConfigs, Vector<RecoveredConfig>.create());

    /// The configuration of the last Config record applied (the checkpoint's, after an open), as its bytes.
    fn membershipBytes(borrow this) -> Slice<u8> => this.state.membership.view();

    /// A leader's configuration entry, staged as a Config record; `persistEntries` makes it durable.
    fn appendConfig(borrow mut this, term: u64, membership: Slice<u8>) -> Result<void, StoreError> {
        this.checkWritable()?;
        let empty = Vector<u8>.create();
        let _ = this.journal.stageEntry(RecordType.Config, term, membership, empty.view())?;
        return Ok();
    }

    /// The index the store's state is at: every entry up to it is applied.
    fn appliedIndex(borrow this) -> u64 => this.publishedNext - 1;

    /// The last entry in the journal, and its term.
    fn lastEntry(borrow this) -> u64 => this.journal.lastLsn();

    fn lastEntryTerm(borrow this) -> u64 => this.journal.lastEntryTerm();

    /// The term of written entry `lsn`.
    fn entryTerm(borrow this, lsn: u64) -> Result<u64, StoreError> => Ok(this.journal.entryAt(lsn)?.header.term);

    /// Written entry `lsn`, its whole record: what a leader sends.
    fn entryBytes(borrow this, lsn: u64) -> Result<Vector<u8>, StoreError> => Ok(this.journal.entryBytes(lsn)?);

    /// A follower stages an entry as its leader encoded it; `persistEntries` makes it durable.
    fn appendEntry(borrow mut this, record: Slice<u8>) -> Result<void, StoreError> {
        this.checkWritable()?;
        let _ = this.journal.appendEncoded(record)?;
        return Ok();
    }

    /// A new leader's first entry, which changes nothing, staged; `persistEntries` makes it durable.
    fn appendNoop(borrow mut this, term: u64) -> Result<void, StoreError> {
        this.checkWritable()?;
        let empty = Vector<u8>.create();
        let _ = this.journal.stageEntry(RecordType.Noop, term, empty.view(), empty.view())?;
        return Ok();
    }

    /// Makes the staged entries durable, without applying them.
    fn persistEntries(borrow mut this) -> Result<void, StoreError> {
        this.checkWritable()?;
        // The journal's own commit: entries staged by the replica (a follower's, a new leader's first) are not in
        // the store's pending applies, which a Raft log does not use.
        this.pendingApplies.clear();
        this.inflightApplies.clear();
        this.journal.commit()?;
        return Ok();
    }

    /// Cuts the entries after `lsn` off, durably: a suffix the leader does not have.
    fn truncateEntries(borrow mut this, lsn: u64) -> Result<void, StoreError> {
        this.checkWritable()?;
        // The buckets those entries made go with them, before the cut: a write is never taken into one that is gone.
        this.dropStagedBuckets(lsn, true);
        return Ok(this.journal.truncateAfter(lsn)?);
    }

    /// Applies the committed entries `from` to `to`, in order, from the journal: the same records on every replica,
    /// so the same state.
    fn applyEntries(borrow mut this, from: u64, to: u64) -> Result<void, StoreError> {
        var lsn = from;
        while (lsn <= to) {
            if (lsn != this.publishedNext) {
                return Err(StoreError.Journal(JournalError.OutOfOrder(this.publishedNext)));
            }
            let at = this.journal.entryAt(lsn)?;
            let record = this.journal.readRecord(at.segment, at.offset, at.header.totalLen)?;
            let h = borrow at.header;
            let metaEnd = RECORD_HEADER_LEN + h.metaLen as usize;
            let payloadEnd = metaEnd + h.payloadLen as usize;
            let manifest = if (payloadToApply(h.kind)) record[metaEnd..payloadEnd] else record[0..0];
            this.sinceCheckpoint += h.totalLen as u64;
            this.counts.journalBytesWritten += h.totalLen as u64;
            applyRecord(
                mut this.state,
                h.kind,
                lsn,
                at.segment,
                at.offset,
                h.totalLen,
                record[RECORD_HEADER_LEN..metaEnd],
                h.payloadLen,
                manifest,
            )?;
            this.publishedNext = lsn + 1;
            this.appliedTerm = h.term;
            if (this.stagedBuckets.length > 0) { this.dropStagedBuckets(lsn, false); } // applied: in the state now
            let coded = match (h.kind) {
                RecordType.Coded => decodeCoded(record[RECORD_HEADER_LEN..metaEnd]),
                _ => null,
            };
            match (coded) {
                Some(c) => { this.convertToPiece(c.id)?; }
                null => {}
            }
            lsn += 1;
        }
        this.journal.markCommitted(to);
        this.reapExtents();
        return Ok();
    }

    /// Every mutation starts here. After a journal failure the in-memory state may lag what is
    /// on disk (a failed batch may still have reached it), so no write may be acknowledged,
    /// not even one that would change nothing, such as deleting a key that looks missing.
    fn checkWritable(borrow this) -> Result<void, StoreError> {
        if (this.journal.isFailed()) { return Err(StoreError.Journal(JournalError.Failed)); }
        return Ok();
    }

    /// The bytes the store occupies: every journal segment and every live extent file (ADR-0006). Extents of
    /// retired versions are removed as soon as their records commit, so they are not counted.
    fn usedBytes(borrow this) -> u64 => this.journalBytes() + this.state.extentBytes + this.deferredBytes;

    /// Admits a write of `incoming` object bytes, plus its record, unless it would take the store into its
    /// reserve: InsufficientStorage. Deletes, checkpoints and compaction never ask (ADR-0006).
    /// The volume counts too, as measured (ADR-0040): the write and the reserve must fit in what is left of it.
    fn admit(borrow this, incoming: u64) -> Result<void, StoreError> {
        let capacity = this.config.capacityBytes;
        if (capacity > 0) {
            let need = this.usedBytes() + incoming + ADMIT_RECORD_BYTES + this.config.reserveBytes;
            if (need > capacity) { return Err(StoreError.InsufficientStorage); }
        }
        if (this.volumeMeasured) {
            let need = incoming + ADMIT_RECORD_BYTES + this.config.reserveBytes;
            if (need > this.volumeEstimate()) { return Err(StoreError.InsufficientStorage); }
        }
        return Ok();
    }

    /// A general-purpose bucket; a name with a directory bucket's suffix is not one (ADR-0080 §2).
    fn createBucket(borrow mut this, name: StringView) -> Result<void, StoreError> {
        this.checkWritable()?;
        let valid = isValidBucketName(name.bytes()) || isTableBucketStoreName(name.bytes()) ||
            isHiddenStoreBucket(name.bytes());
        if (!valid || isDirectoryShaped(name.bytes())) { return Err(StoreError.InvalidBucketName); }
        if (this.bucketForWrite(name.bytes())?) { return Err(StoreError.BucketAlreadyExists); }
        this.scratch.clear();
        encodeBucketMeta(mut this.scratch, name.bytes(), Clock.unixMillis())?;
        let empty = [0u8; 1];
        let lsn = this.commitOne(RecordType.BucketCreate, empty[0..0])?;
        this.noteStagedBucket(name.bytes(), lsn)?;
        return Ok();
    }

    /// A directory bucket in `zone` (ADR-0080 §2): one BucketCreate record that carries the zone, so the bucket is
    /// never seen without it.
    fn createDirectoryBucket(borrow mut this, name: StringView, zone: Slice<u8>) -> Result<void, StoreError> {
        this.checkWritable()?;
        if (!isDirectoryBucketName(name.bytes(), zone)) { return Err(StoreError.InvalidBucketName); }
        if (this.bucketForWrite(name.bytes())?) { return Err(StoreError.BucketAlreadyExists); }
        this.scratch.clear();
        encodeDirectoryBucketMeta(mut this.scratch, name.bytes(), Clock.unixMillis(), zone)?;
        let empty = [0u8; 1];
        let lsn = this.commitOne(RecordType.BucketCreate, empty[0..0])?;
        this.noteStagedBucket(name.bytes(), lsn)?;
        return Ok();
    }

    /// A bucket's zone id if it is a directory bucket, empty if it is not; NoSuchBucket if there is none.
    fn bucketZone(borrow this, name: StringView) -> Result<Vector<u8>, StoreError> {
        let k = BucketKey { name: copyBytes(name.bytes())? };
        return match (this.state.buckets.get(borrow k)) {
            Some(b) => Ok(copyBytes(b.zone.view())?),
            null => Err(StoreError.NoSuchBucket),
        };
    }

    fn deleteBucket(borrow mut this, name: StringView) -> Result<void, StoreError> {
        this.checkWritable()?;
        let k = BucketKey { name: copyBytes(name.bytes())? };
        match (this.state.buckets.get(borrow k)) {
            Some(b) => {
                if (b.objects > 0) { return Err(StoreError.BucketNotEmpty); }
            }
            null => { return Err(StoreError.NoSuchBucket); }
        }
        this.scratch.clear();
        encodeBucketMeta(mut this.scratch, name.bytes(), Clock.unixMillis())?;
        let empty = [0u8; 1];
        this.commitOne(RecordType.BucketDelete, empty[0..0])?;
        return Ok();
    }

    fn bucketExists(borrow this, name: StringView) -> Result<bool, StoreError> => this.state.hasBucket(name.bytes());

    /// When a bucket was made (Unix milliseconds).
    fn bucketCreatedMillis(borrow this, name: StringView) -> Result<i64, StoreError> {
        let k = BucketKey { name: copyBytes(name.bytes())? };
        return match (this.state.buckets.get(borrow k)) {
            Some(b) => Ok(b.createdMillis),
            null => Err(StoreError.NoSuchBucket),
        };
    }

    /// Sets the current version's tags (URL-encoded; empty removes them), without a new version: its ETag, generation
    /// and modification time stay (ADR-0017). One SetTags record, durable before this returns.
    fn setTags(borrow mut this, bucket: StringView, key: StringView, tags: Slice<u8>) -> Result<void, StoreError> =>
        this.setTagsOf(bucket, key, null, tags);

    /// `setTags` of the current version (no id), or of the version with the id (ADR-0041): NoSuchVersion if the key
    /// has none such, MethodNotAllowed for a delete marker.
    fn setTagsOf(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16]?,
        tags: Slice<u8>,
    ) -> Result<void, StoreError> => this.setFieldOf(bucket, key, id, tags, META_FORMAT_VERSION);

    /// Sets the ACL of the current version, or of the version with the id, as `setTagsOf` sets tags: `acl` as it is
    /// stored, empty for the private one (ADR-0045). One SetTags record of the second format.
    fn setAclOf(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16]?,
        acl: Slice<u8>,
    ) -> Result<void, StoreError> {
        if (!isAclValue(acl)) { return Err(StoreError.InvalidKey); }
        return this.setFieldOf(bucket, key, id, acl, SET_ACL_FORMAT);
    }

    fn setFieldOf(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16]?,
        tags: Slice<u8>,
        format: u8,
    ) -> Result<void, StoreError> {
        this.commitStaged()?;
        this.stageFieldOf(bucket, key, id, tags, format)?;
        this.commitStaged()?;
        return Ok();
    }

    /// `setFieldOf`'s record, staged: it is synced, and applied, with the next commit of the batch. The version is
    /// found as the index has it now, so a batch stages each version once (the lifecycle's transitions, ADR-0090 §2).
    fn stageFieldOf(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16]?,
        tags: Slice<u8>,
        format: u8,
    ) -> Result<void, StoreError> {
        let field = setTagsField(format);
        if (!setFieldValueOk(format, tags)) { return Err(StoreError.InvalidKey); }
        this.checkWritable()?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        var generation: u64 = 0;
        var versionId = [0u8; 16];
        let found = match (id) {
            Some(i) => match (this.state.index.find(borrow k, i)) {
                Some(v) => {
                    if (isDeleteMarker(v)) { return Err(StoreError.MethodNotAllowed); }
                    Some(v)
                }
                null => { return Err(StoreError.NoSuchVersion); }
            },
            null => this.state.current(borrow k),
        };
        match (found) {
            Some(v) => {
                generation = v.lsn;
                versionId = v.versionId;
                let next = match (metadataReplace(v.metadata.view(), field.bytes(), tags)) {
                    Ok(b) => b,
                    Err(_) => { return Err(StoreError.DataCorrupt); }
                };
                if (next.length > MAX_METADATA_BYTES) { return Err(StoreError.MetadataTooLarge); }
            }
            null => { return Err(StoreError.NoSuchKey); }
        }
        var meta = Vector<u8>.create();
        if (format != META_FORMAT_VERSION) {
            encodeSetFieldMeta(mut meta, format, bucket.bytes(), key.bytes(), versionId, generation, tags)?;
        } else {
            encodeSetTagsMeta(mut meta, bucket.bytes(), key.bytes(), versionId, generation, tags)?;
        }
        let _ = this.stageMetaRecord(RecordType.SetTags, meta)?;
        return Ok();
    }

    /// The bucket names, in byte order.
    fn listBuckets(borrow this) -> Result<Vector<Vector<u8>>, StoreError> {
        var names = Vector<Vector<u8>>.create();
        for (i in 0..this.state.buckets.length()) {
            let k = this.state.buckets.keyAt(i);
            names.push(copyBytes(k.name.view())?)?;
        }
        names.viewMut().sortBy((a, b) => compareBytes(a.view(), b.view()));
        return Ok(names);
    }

    /// The buckets in name order, with their creation times (Unix milliseconds).
    fn listBucketInfo(borrow this) -> Result<Vector<BucketEntry>, StoreError> {
        var entries = Vector<BucketEntry>.create();
        for (i in 0..this.state.buckets.length()) {
            entries.push(BucketEntry {
                name: copyBytes(this.state.buckets.keyAt(i).name.view())?,
                createdMillis: this.state.buckets.valueAt(i).createdMillis,
                directory: this.state.buckets.valueAt(i).zone.length > 0,
            })?;
        }
        entries.viewMut().sortBy((a, b) => compareBytes(a.name.view(), b.name.view()));
        return Ok(entries);
    }

    fn checkKey(key: StringView) -> Result<void, StoreError> {
        if (key.length == 0 || key.length > MAX_KEY_BYTES) { return Err(StoreError.InvalidKey); }
        return Ok();
    }

    /// The current version's generation, or null if the key has no object.
    fn currentGeneration(borrow this, bucket: StringView, key: StringView) -> Result<u64?, StoreError> {
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        return Ok(match (this.state.current(borrow k)) {
            Some(v) => v.lsn,
            null => null,
        });
    }

    /// Stores an object durably. When this returns Ok the object is on stable storage and
    /// visible to GET, HEAD and LIST.
    fn putObject(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        data: Slice<u8>,
        condition: PutCondition,
    ) -> Result<PutOutcome, StoreError> {
        let obj = this.writeAll(data)?;
        return this.putFinished(bucket, key, contentType, borrow obj, condition);
    }

    /// Runs `data` through a writer: inline if small, extents if not.
    fn writeAll(borrow this, data: Slice<u8>) -> Result<FinishedObject, StoreError> {
        if (data.length as u64 > this.config.maxObjectBytes) { return Err(StoreError.EntityTooLarge); }
        this.admit(data.length as u64)?; // before any byte reaches an extent
        var w = this.newWriter()?;
        sio(w.write(data))?;
        return sio(w.finish());
    }

    /// Commits a finished object as the key's current version, if `condition` holds. On a
    /// refusal its extents are removed; after a journal failure they are left for the orphan
    /// sweep, since the record may have reached the disk.
    fn putFinished(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        obj: borrow FinishedObject,
        condition: PutCondition,
    ) -> Result<PutOutcome, StoreError> =>
        this.putFinishedWith(bucket, key, contentType, "".bytes(), "".bytes(), obj, condition);

    /// `putFinished` with stored fields, a blob from `metadataAdd` (ADR-0012), and its checksum, a blob from
    /// `ObjectExtras.encode` (ADR-0015).
    /// Like `putFinishedWith`, but an unconditional PUT is only staged: it is published, and may
    /// be acknowledged, once `isPublished(outcome.generation)` (group commit, ADR-0022). A
    /// conditional PUT is checked against every earlier write, so it commits as `putFinishedWith`.
    fn putFinishedDeferred(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        metadata: Slice<u8>,
        extras: Slice<u8>,
        obj: borrow FinishedObject,
        condition: PutCondition,
    ) -> Result<PutOutcome, StoreError> {
        match (condition) {
            PutCondition.None => {}
            _ => { return this.putFinishedWith(bucket, key, contentType, metadata, extras, obj, condition); }
        }
        if (metadata.length > MAX_METADATA_BYTES) {
            this.discardFinished(obj);
            return Err(StoreError.MetadataTooLarge);
        }
        match (this.checkPut(bucket, key, contentType, obj, condition)) {
            Ok() => {}
            Err(e) => {
                this.discardFinished(obj);
                return Err(e);
            }
        }
        let id = this.versionIdFor(bucket.bytes(), key.bytes())?;
        let lsn = this.stageFinished(bucket, key, contentType, metadata, extras, id, obj)?;
        return Ok(PutOutcome { md5: obj.md5, generation: lsn, parts: 0, extras: copyBytes(extras)?, versionId: id });
    }

    /// `putFinishedDeferred` for an unconditional PUT of an inline object, in memory only, so async code may call it
    /// (ADR-0031). null, with nothing staged, when the object is not inline or the batch must be committed first:
    /// the caller then takes `putFinishedDeferred` on a worker thread.
    fn putInlineDeferred(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        metadata: Slice<u8>,
        extras: Slice<u8>,
        obj: borrow FinishedObject,
    ) -> Result<PutOutcome?, StoreError> {
        match (borrow obj.body) {
            ObjectBody.Inline(_) => {}
            ObjectBody.Extents(_) => { return Ok(null); }
        }
        // An inline object has no extents, so a refusal has nothing to discard.
        if (metadata.length > MAX_METADATA_BYTES) { return Err(StoreError.MetadataTooLarge); }
        this.checkPut(bucket, key, contentType, obj, PutCondition.None)?;
        let id = this.versionIdFor(bucket.bytes(), key.bytes())?;
        return match (this.stageWithoutCommit(bucket, key, contentType, metadata, extras, id, obj)?) {
            Some(lsn) => Ok(Some(PutOutcome {
                md5: obj.md5,
                generation: lsn,
                parts: 0,
                extras: copyBytes(extras)?,
                versionId: id,
            })),
            null => Ok(null),
        };
    }

    fn putFinishedWith(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        metadata: Slice<u8>,
        extras: Slice<u8>,
        obj: borrow FinishedObject,
        condition: PutCondition,
    ) -> Result<PutOutcome, StoreError> {
        // Staged writes must be visible to the precondition check.
        match (this.commitStaged()) {
            Ok(_) => {}
            Err(e) => { return Err(e); }
        }
        if (metadata.length > MAX_METADATA_BYTES) {
            this.discardFinished(obj);
            return Err(StoreError.MetadataTooLarge);
        }
        match (this.checkPut(bucket, key, contentType, obj, condition)) {
            Ok() => {}
            Err(e) => {
                this.discardFinished(obj);
                return Err(e);
            }
        }
        let id = this.versionIdFor(bucket.bytes(), key.bytes())?;
        let lsn = this.stageFinished(bucket, key, contentType, metadata, extras, id, obj)?;
        this.commitStaged()?;
        return Ok(PutOutcome { md5: obj.md5, generation: lsn, parts: 0, extras: copyBytes(extras)?, versionId: id });
    }

    fn checkPut(
        borrow this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        obj: borrow FinishedObject,
        condition: PutCondition,
    ) -> Result<void, StoreError> {
        this.checkWritable()?;
        ObjectStore.checkKey(key)?;
        if (contentType.length > MAX_CONTENT_TYPE) { return Err(StoreError.InvalidKey); }
        if (!this.bucketForWrite(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        if (obj.size > this.config.maxObjectBytes) { return Err(StoreError.EntityTooLarge); }
        this.admit(obj.size)?;
        this.checkQuota(bucket.bytes(), key.bytes(), obj.size)?;
        let current = this.currentGeneration(bucket, key)?;
        match (condition) {
            PutCondition.None => {}
            PutCondition.IfAbsent => {
                if (current.isSome()) { return Err(StoreError.PreconditionFailed); }
            }
            PutCondition.IfGeneration(g) => {
                if ((current ?? 0) != g) { return Err(StoreError.PreconditionFailed); }
            }
        }
        return Ok();
    }

    /// Stages an unconditional PUT into the current batch (group commit). It is neither durable
    /// nor visible until `commitStaged` returns Ok; a full batch is committed first.
    fn stagePut(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        data: Slice<u8>,
    ) -> Result<[u8; 16], StoreError> {
        let obj = this.writeAll(data)?;
        this.stageObject(bucket, key, contentType, borrow obj)?;
        return Ok(obj.md5);
    }

    /// Stages an unconditional PUT of a finished object into the current batch; on a refusal
    /// its extents are removed.
    fn stageObject(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        obj: borrow FinishedObject,
    ) -> Result<u64, StoreError> {
        match (this.checkPut(bucket, key, contentType, obj, PutCondition.None)) {
            Ok() => {}
            Err(e) => {
                this.discardFinished(obj);
                return Err(e);
            }
        }
        let id = this.versionIdFor(bucket.bytes(), key.bytes())?;
        return this.stageFinished(bucket, key, contentType, "".bytes(), "".bytes(), id, obj);
    }

    /// Stages the record that publishes a finished object; returns its LSN (its generation).
    /// The object's extents are already durable (ObjectWriter.finish), as ADR-0001 requires.
    fn stageFinished(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        metadata: Slice<u8>,
        extras: Slice<u8>,
        versionId: [u8; 16],
        obj: borrow FinishedObject,
    ) -> Result<u64, StoreError> {
        let locked = this.lockMetadata(bucket.bytes(), metadata)?;
        let rec = match (locked) {
            Some(m) => encodePut(bucket, key, contentType, m.view(), extras, versionId, obj)?,
            null => encodePut(bucket, key, contentType, metadata, extras, versionId, obj)?,
        };
        // A full segment rotates at a commit with nothing staged after it (ADR-0022).
        if (this.mustCommitBefore(borrow rec, obj)) { this.commitStaged()?; }
        return this.stageEncoded(rec, obj);
    }

    /// `stageFinished` in memory only, so async code may call it (ADR-0031): null, with nothing staged, when the
    /// batch must be committed first.
    fn stageWithoutCommit(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        metadata: Slice<u8>,
        extras: Slice<u8>,
        versionId: [u8; 16],
        obj: borrow FinishedObject,
    ) -> Result<u64?, StoreError> {
        let locked = this.lockMetadata(bucket.bytes(), metadata)?;
        let rec = match (locked) {
            Some(m) => encodePut(bucket, key, contentType, m.view(), extras, versionId, obj)?,
            null => encodePut(bucket, key, contentType, metadata, extras, versionId, obj)?,
        };
        if (this.mustCommitBefore(borrow rec, obj)) { return Ok(null); }
        return Ok(Some(this.stageEncoded(rec, obj)?));
    }

    /// QuotaExceeded if a new version of `size` bytes at `key` would take the bucket past its quota (ADR-0052 §2).
    /// In a bucket whose versioning is not enabled the key's null version goes as the new one comes: its bytes are
    /// not counted against the new one, and the count of versions stays. Counted against what is published: writes
    /// staged or in their sync are not in the bucket's totals yet.
    fn checkQuota(borrow this, bucket: Slice<u8>, key: Slice<u8>, size: u64) -> Result<void, StoreError> {
        let k = BucketKey { name: copyBytes(bucket)? };
        let b = match (this.state.buckets.get(borrow k)) {
            Some(b) => b,
            null => { return Ok(); }
        };
        if (b.quota.length != 16) { return Ok(); }
        let maxBytes = b.quota.view().readLE<u64>(0);
        let maxObjects = b.quota.view().readLE<u64>(8);
        var went: u64 = 0;
        var replaces = false;
        if (b.versioning != VERSIONING_ENABLED) {
            let ik = this.state.keyFor(bucket, key)?;
            match (this.state.index.find(borrow ik, nullVersionId())) {
                Some(v) => {
                    went = v.size;
                    replaces = true;
                }
                null => {}
            }
        }
        let kept = if (b.bytes > went) b.bytes - went else 0;
        if (maxBytes > 0 && kept + size > maxBytes) { return Err(StoreError.QuotaExceeded); }
        if (maxObjects > 0 && !replaces && b.objects + 1 > maxObjects) { return Err(StoreError.QuotaExceeded); }
        return Ok();
    }

    /// A bucket's use: the bytes of its versions and how many it has, delete markers included.
    fn bucketUsage(borrow this, bucket: StringView) -> Result<[u64; 2], StoreError> {
        let k = BucketKey { name: copyBytes(bucket.bytes())? };
        return match (this.state.buckets.get(borrow k)) {
            Some(b) => Ok([b.bytes, b.objects]),
            null => Err(StoreError.NoSuchBucket),
        };
    }

    /// Every bucket, in the order of their names, with what it holds and what is set on it (ADR-0054).
    fn bucketSummaries(borrow this) -> Result<Vector<BucketSummary>, StoreError> {
        var out = Vector<BucketSummary>.create();
        let names = this.listBuckets()?;
        for (i in 0..names.length) {
            let k = BucketKey { name: copyBytes(names[i].view())? };
            let b = match (this.state.buckets.get(borrow k)) {
                Some(b) => b,
                null => { continue; }
            };
            var set: u32 = 0;
            let fields = [
                b.policy.length, b.acl.length, b.publicAccess.length, b.objectLock.length, b.lifecycle.length,
                b.notification.length, b.cors.length,
            ];
            for (f in 0..fields.length) {
                if (fields[f] > 0) { set |= 1u32 << truncate<u32>(f); }
            }
            out.push(BucketSummary {
                name: copyBytes(names[i].view())?,
                createdMillis: b.createdMillis,
                objects: b.objects,
                bytes: b.bytes,
                maxBytes: if (b.quota.length == 16) b.quota.view().readLE<u64>(0) else 0,
                maxObjects: if (b.quota.length == 16) b.quota.view().readLE<u64>(8) else 0,
                versioning: b.versioning,
                set: set,
            })?;
        }
        return Ok(out);
    }

    /// How many buckets have CORS rules (ADR-0049 §4).
    /// Buckets with a default encryption (ADR-0046 §5).
    fn encryptedBucketCount(borrow this) -> u64 {
        var n: u64 = 0;
        for (i in 0..this.state.buckets.length()) {
            if (this.state.buckets.valueAt(i).encryption.length > 0) { n += 1; }
        }
        return n;
    }

    /// The buckets with access points (ADR-0076): their names and access points, as stored.
    fn accessPointBuckets(borrow this) -> Result<BucketPolicies, StoreError> {
        var out = BucketPolicies { names: Vector<Vector<u8>>.create(), documents: Vector<Vector<u8>>.create() };
        for (i in 0..this.state.buckets.length()) {
            let b = this.state.buckets.valueAt(i);
            if (b.accessPoints.length == 0) { continue; }
            out.names.push(copyBytes(this.state.buckets.keyAt(i).name.view())?)?;
            out.documents.push(copyBytes(b.accessPoints.view())?)?;
        }
        return Ok(out);
    }

    fn replicationBucketCount(borrow this) -> u64 {
        var n: u64 = 0;
        for (i in 0..this.state.buckets.length()) {
            if (this.state.buckets.valueAt(i).replication.length > 0) { n += 1; }
        }
        return n;
    }

    /// A source version's replication status (ADR-0077 §4): REPLICATION_NONE when no rule takes the key;
    /// COMPLETED when every destination has its id; PENDING while its event waits; else FAILED.
    fn replicationStatusOf(
        borrow this,
        bucket: Slice<u8>,
        key: Slice<u8>,
        versionId: [u8; 16],
        lsn: u64,
    ) -> Result<u8, StoreError> {
        let k = BucketKey { name: copyBytes(bucket)? };
        var blob = Vector<u8>.create();
        var failures = Vector<u8>.create();
        match (this.state.buckets.get(borrow k)) {
            Some(b) => {
                blob = copyBytes(b.replication.view())?;
                failures = copyBytes(b.replicationFailures.view())?;
            }
            null => { return Ok(REPLICATION_NONE); }
        }
        let rules = match (decodeReplication(blob.view())) {
            Ok(r) => r,
            Err(_) => { return Ok(REPLICATION_NONE); }
        };
        var taken = false;
        var missing = false;
        for (i in 0..rules.length) {
            if (!replicationTakes(borrow rules[i], EVENT_PUT, key)) { continue; }
            taken = true;
            let destination = rules[i].destination.view();
            // Another endpoint's: done unless refused, which is noted (ADR-0077 §7). So is, on a cluster, a bucket
            // of another shard: its replica went through the front, and a refusal is noted (ADR-0078 §4).
            let elsewhere = this.raft && !this.state.hasBucket(destination)?;
            if (isRemoteDestination(destination) || elsewhere) {
                if (failuresHave(failures.view(), key, versionId)) { return Ok(REPLICATION_FAILED); }
                if (lsn > this.state.outbox.cursor) { missing = true; }
                continue;
            }
            if (!this.state.hasBucket(destination)?) {
                missing = true;
                continue;
            }
            let dk = this.state.keyFor(destination, key)?;
            if (this.state.index.slotOf(borrow dk, versionId) == NO_VERSION_SLOT) { missing = true; }
        }
        if (!taken) { return Ok(REPLICATION_NONE); }
        if (!missing) { return Ok(REPLICATION_COMPLETED); }
        return Ok(if (lsn > this.state.outbox.cursor) REPLICATION_PENDING else REPLICATION_FAILED);
    }

    /// Notes that a remote destination refused a version's replica (ADR-0077 §7).
    fn noteReplicationFailure(
        borrow mut this,
        bucket: StringView,
        key: Slice<u8>,
        versionId: [u8; 16],
    ) -> Result<void, StoreError> {
        let stored = this.bucketConfig(bucket, BUCKET_CONFIG_REPLICATION_FAILURES)?;
        var next = Vector<u8>.create();
        failuresWith(stored.view(), key, versionId, mut next)?;
        return this.setBucketConfig(bucket, BUCKET_CONFIG_REPLICATION_FAILURES, next.view());
    }

    fn accessPointBucketCount(borrow this) -> u64 {
        var n: u64 = 0;
        for (i in 0..this.state.buckets.length()) {
            if (this.state.buckets.valueAt(i).accessPoints.length > 0) { n += 1; }
        }
        return n;
    }

    /// The buckets with inventory configurations (ADR-0074): their names and configurations, as stored.
    fn inventoryBuckets(borrow this) -> Result<BucketPolicies, StoreError> {
        var out = BucketPolicies { names: Vector<Vector<u8>>.create(), documents: Vector<Vector<u8>>.create() };
        for (i in 0..this.state.buckets.length()) {
            let b = this.state.buckets.valueAt(i);
            if (b.inventory.length == 0) { continue; }
            out.names.push(copyBytes(this.state.buckets.keyAt(i).name.view())?)?;
            out.documents.push(copyBytes(b.inventory.view())?)?;
        }
        return Ok(out);
    }

    /// How many buckets log their requests (ADR-0072): none, and a request looks nothing up.
    fn loggingBucketCount(borrow this) -> u64 {
        var n: u64 = 0;
        for (i in 0..this.state.buckets.length()) {
            if (this.state.buckets.valueAt(i).logging.length > 0) { n += 1; }
        }
        return n;
    }

    fn corsBucketCount(borrow this) -> u64 {
        var n: u64 = 0;
        for (i in 0..this.state.buckets.length()) {
            if (this.state.buckets.valueAt(i).cors.length > 0) { n += 1; }
        }
        return n;
    }

    /// The oldest events still to be delivered, at most `most`, as copies (ADR-0048 §4).
    fn pendingEvents(borrow this, most: usize) -> Result<Vector<OutboxEvent>, StoreError> {
        var out = Vector<OutboxEvent>.create();
        var i = this.state.outbox.head;
        while (i < this.state.outbox.events.length && out.length < most) {
            out.push(cloneEvent(borrow this.state.outbox.events[i])?)?;
            i += 1;
        }
        return Ok(out);
    }

    /// Every event up to `lsn` is delivered: they leave the outbox, and the cursor file says so, durably, before
    /// this returns. A crash before it delivers them again. On a Raft log an `OutboxDelivered` record is staged
    /// instead, for the shard's leader to propose; applied on every replica, it drops them (ADR-0078 §4).
    fn eventsDelivered(borrow mut this, lsn: u64) -> Result<void, StoreError> {
        if (this.raft) {
            var meta = Vector<u8>.create();
            meta.pushLE(lsn)?;
            let _ = this.stageMetaRecord(RecordType.OutboxDelivered, meta)?;
            this.commitStaged()?;
            return Ok();
        }
        // The cursor first: if it cannot be written the events stay, in memory and in the next checkpoint, and
        // are delivered again. Dropped first, a checkpoint could leave them out while the disk still asks for them.
        writeOutboxCursor(this.dir.view(), lsn)?;
        this.state.outbox.deliveredTo(lsn);
        return Ok();
    }

    /// What the delivery task did with a batch: every event up to `lsn` is delivered (0: none), and one delivery
    /// failed and will be tried again.
    fn eventsNoted(borrow mut this, lsn: u64, failed: bool) -> Result<void, StoreError> {
        if (failed) { this.state.outbox.failures += 1; }
        if (lsn == 0) { return Ok(); }
        return this.eventsDelivered(lsn);
    }

    /// The outbox's counts: events waiting, and since the store was opened those queued, delivered and dropped, and
    /// the deliveries that failed.
    fn outboxCounts(borrow this) -> [u64; 5] => [
        this.state.outbox.pending() as u64,
        this.state.outbox.queued,
        this.state.outbox.delivered,
        this.state.outbox.dropped,
        this.state.outbox.failures,
    ];

    /// A bucket's object lock configuration as it is stored; empty without one, or without the bucket.
    fn lockConfigOf(borrow this, bucket: Slice<u8>) -> Result<Vector<u8>, StoreError> {
        let k = BucketKey { name: copyBytes(bucket)? };
        return Ok(match (this.state.buckets.get(borrow k)) {
            Some(b) => copyBytes(b.objectLock.view())?,
            null => Vector<u8>.create(),
        });
    }

    /// The metadata a new version of `bucket` is written with, when it is not `metadata` as given (ADR-0047 §2): a
    /// version that brings no lock gets the bucket's default retention, from now. ObjectLockOff for a lock in a
    /// bucket without object lock.
    fn lockMetadata(borrow this, bucket: Slice<u8>, metadata: Slice<u8>) -> Result<Vector<u8>?, StoreError> {
        let config = this.lockConfigOf(bucket)?;
        let given = metadataFind(metadata, LOCK_FIELD.bytes()).isSome();
        if (config.length == 0) {
            if (given) { return Err(StoreError.ObjectLockOff); }
            return Ok(null);
        }
        if (given) { return Ok(null); }
        let d = match (decodeLockConfig(config.view())) {
            Some(d) => d,
            null => { return Ok(null); }
        };
        if (d.mode == LOCK_NONE) { return Ok(null); }
        var text = Vector<u8>.create();
        encodeLock(
            ObjectLock { mode: d.mode, until: lockDefaultUntil(d, Clock.unixMillis()), hold: false },
            mut text,
        )?;
        return match (metadataReplace(metadata, LOCK_FIELD.bytes(), text.view())) {
            Ok(m) => Ok(Some(m)),
            Err(_) => Err(StoreError.DataCorrupt),
        };
    }

    /// Changes the lock of the current version, or of the version with the id, in place (ADR-0047 §3): its
    /// retention, its legal hold, or both. ObjectLockOff in a bucket without object lock; ObjectLocked for a
    /// retention the version's own does not allow without `bypass`. One SetTags record of the third format.
    fn setLockOf(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16]?,
        retention: ObjectLock?,
        hold: bool?,
        bypass: bool,
    ) -> Result<void, StoreError> {
        this.commitStaged()?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        if (this.lockConfigOf(bucket.bytes())?.length == 0) { return Err(StoreError.ObjectLockOff); }
        let info = this.headObjectOf(bucket, key, id)?;
        var next = lockOfMetadata(info.metadata.view());
        match (retention) {
            Some(r) => {
                if (!lockChangeAllowed(next, r, Clock.unixMillis(), bypass)) { return Err(StoreError.ObjectLocked); }
                next.mode = r.mode;
                next.until = if (r.mode == LOCK_NONE) 0 else r.until;
            }
            null => {}
        }
        match (hold) {
            Some(h) => { next.hold = h; }
            null => {}
        }
        var text = Vector<u8>.create();
        encodeLock(next, mut text)?;
        return this.setFieldOf(bucket, key, id, text.view(), SET_LOCK_FORMAT);
    }

    /// A bucket's versioning state; VERSIONING_OFF for a bucket that is not there.
    fn versioningOf(borrow this, bucket: Slice<u8>) -> Result<u8, StoreError> {
        let k = BucketKey { name: copyBytes(bucket)? };
        match (this.state.buckets.get(borrow k)) {
            Some(b) => { return Ok(b.versioning); }
            null => {}
        }
        // A staged bucket's, as its request staged it (ADR-0128 §1).
        for (b in this.stagedBuckets.view()) {
            if (b.name.view() == bucket) { return Ok(b.versioning); }
        }
        return Ok(VERSIONING_OFF);
    }

    /// The id of a version about to be written to `key` (ADR-0041 §3): a new one when the bucket's versioning is
    /// enabled, else the null id.
    fn versionIdFor(borrow this, bucket: Slice<u8>, key: Slice<u8>) -> Result<[u8; 16], StoreError> {
        if (this.versioningOf(bucket)? != VERSIONING_ENABLED) { return Ok(nullVersionId()); }
        let k = this.state.keyFor(bucket, key)?;
        var id = [0u8; 16];
        while (true) {
            Random.fill(mut id[..])!;
            if (!isNullVersionId(id) && this.state.index.slotOf(borrow k, id) == NO_VERSION_SLOT) { break; }
        }
        return Ok(id);
    }

    /// A replica (ADR-0077 §3): `obj`, the source version's stored bytes, as a version of `key` with the source's
    /// version id, MD5 and part count, so its ETag and id are the source's. Its bucket's versioning must be enabled.
    /// False, with nothing written, when the key already has a version with that id: delivery is at least once, so a
    /// replica may be asked for again.
    fn putReplica(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        versionId: [u8; 16],
        md5: [u8; 16],
        parts: u32,
        contentType: StringView,
        metadata: Slice<u8>,
        extras: Slice<u8>,
        obj: borrow FinishedObject,
    ) -> Result<bool, StoreError> {
        match (this.commitStaged()) {
            Ok(_) => {}
            Err(e) => {
                this.discardFinished(obj);
                return Err(e);
            }
        }
        let refused = metadata.length > MAX_METADATA_BYTES || isNullVersionId(versionId) || parts > 10000;
        if (refused || this.versioningOf(bucket.bytes())? != VERSIONING_ENABLED) {
            this.discardFinished(obj);
            return Err(StoreError.InvalidKey);
        }
        match (this.checkPut(bucket, key, contentType, obj, PutCondition.None)) {
            Ok() => {}
            Err(e) => {
                this.discardFinished(obj);
                return Err(e);
            }
        }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        if (this.state.index.slotOf(borrow k, versionId) != NO_VERSION_SLOT) {
            this.discardFinished(obj);
            return Ok(false);
        }
        let rec = encodeReplicaPut(bucket, key, contentType, metadata, extras, versionId, md5, parts, obj)?;
        if (this.mustCommitBefore(borrow rec, obj)) { this.commitStaged()?; }
        let _ = this.stageEncoded(rec, obj)?;
        this.commitStaged()?;
        return Ok(true);
    }

    /// A replicated delete marker (ADR-0077 §3): a marker on `key` with its source's id; false, with nothing written,
    /// when the key already has a version with that id.
    fn putReplicaMarker(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        versionId: [u8; 16],
    ) -> Result<bool, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        ObjectStore.checkKey(key)?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        if (isNullVersionId(versionId) || this.versioningOf(bucket.bytes())? != VERSIONING_ENABLED) {
            return Err(StoreError.InvalidKey);
        }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        if (this.state.index.slotOf(borrow k, versionId) != NO_VERSION_SLOT) { return Ok(false); }
        let _ = this.stageDeleteRecord(
            RecordType.DeleteMarker,
            bucket.bytes(),
            key.bytes(),
            versionId,
            Clock.unixMillis(),
        )?;
        this.commitStaged()?;
        return Ok(true);
    }

    /// Whether a record must wait for a commit: it would overflow the segment, or the segment is due to rotate.
    fn mustCommitBefore(borrow this, rec: borrow EncodedPut, obj: borrow FinishedObject) -> bool {
        let payloadLength = match (borrow obj.body) {
            ObjectBody.Inline(data) => data.length,
            ObjectBody.Extents(_) => rec.manifest.length,
        };
        return this.journal.wouldOverflow(rec.meta.length, payloadLength) || this.journal.needsRotation();
    }

    /// Stages an encoded PUT record into the current batch; returns its LSN.
    fn stageEncoded(borrow mut this, rec: EncodedPut, obj: borrow FinishedObject) -> Result<u64, StoreError> {
        this.pendingApplies.reserve(1)?;
        let payload = match (borrow obj.body) {
            ObjectBody.Inline(data) => data.view(),
            ObjectBody.Extents(_) => rec.manifest.view(),
        };
        let pos = this.stageRecord(rec.kind, rec.meta.view(), payload)?;
        let total = truncate<u32>(recordLength(rec.meta.length, payload.length));
        let payloadLen = truncate<u32>(payload.length);
        match (borrow obj.body) {
            ObjectBody.Inline(_) => {}
            ObjectBody.Extents(extents) => { this.counts.extentBytesWritten += extentRefBytes(extents.view()); }
        }
        this.counts.payloadBytes += obj.size;
        this.pendingApplies.push(PendingApply {
            kind: rec.kind,
            lsn: pos.lsn,
            segment: pos.segmentId,
            offset: pos.offset,
            total: total,
            meta: rec.meta,
            payloadLen: payloadLen,
            manifest: rec.manifest,
        })?;
        return Ok(pos.lsn);
    }

    /// Commits the staged batch, and a batch in flight, with one write and one sync, then
    /// publishes them in LSN order. Returns how many writes were published. On error nothing
    /// staged or in flight is published.
    fn commitStaged(borrow mut this) -> Result<usize, StoreError> {
        if (this.pendingApplies.length == 0 && this.inflightApplies.length == 0) { return Ok(0); }
        match (this.journal.commit()) {
            Ok() => {}
            Err(e) => {
                this.pendingApplies.clear();
                this.inflightApplies.clear();
                return Err(StoreError.Journal(e));
            }
        }
        let n = this.inflightApplies.length + this.pendingApplies.length;
        if (this.raft) {
            // Persisted; applied when Raft commits them, from the journal.
            this.inflightApplies.clear();
            this.pendingApplies.clear();
            return Ok(n);
        }
        applyBatch(mut this.state, borrow this.inflightApplies, mut this.sinceCheckpoint, mut this.counts)?;
        applyBatch(mut this.state, borrow this.pendingApplies, mut this.sinceCheckpoint, mut this.counts)?;
        this.inflightApplies.clear();
        this.pendingApplies.clear();
        this.publishedNext = this.journal.upcomingLsn();
        this.reapExtents();
        return Ok(n);
    }

    /// Group commit, first half (ADR-0022): writes the staged batch to the journal without
    /// syncing it, and returns the ticket to sync it with, without the store's lock. Null when
    /// nothing is staged or a batch is already in flight.
    fn beginGroupSync(borrow mut this) -> Result<SyncTicket?, StoreError> {
        if (this.pendingApplies.length == 0 || this.inflightApplies.length > 0) { return Ok(null); }
        match (this.journal.writeStaged()) {
            Ok(Some(ticket)) => {
                let staged = replace(mut this.pendingApplies, Vector<PendingApply>.create());
                this.inflightApplies = staged;
                return Ok(ticket);
            }
            Ok(null) => { return Ok(null); }
            Err(e) => {
                this.pendingApplies.clear();
                return Err(StoreError.Journal(e));
            }
        }
    }

    /// Group commit, second half: takes the ticket's sync result and, if that made the batch
    /// durable, publishes it. A failed sync fails the journal, and the batch is never published.
    fn finishGroupSync(borrow mut this, lastLsn: u64, synced: Result<void, IoFailure>) -> Result<void, StoreError> {
        match (this.journal.finishSync(lastLsn, synced)) {
            Ok(true) => {}
            Ok(false) => { return Ok(); }
            Err(e) => {
                this.inflightApplies.clear();
                return Err(StoreError.Journal(e));
            }
        }
        if (this.raft) {
            this.inflightApplies.clear();
            return Ok();
        }
        applyBatch(mut this.state, borrow this.inflightApplies, mut this.sinceCheckpoint, mut this.counts)?;
        this.inflightApplies.clear();
        this.publishedNext = lastLsn + 1;
        this.reapExtents();
        return Ok();
    }

    /// Whether the record at `lsn` is published: durable, applied, and safe to acknowledge.
    /// In a cluster shard's replica, published means durable: the record is persisted, and the node holds its answer
    /// until Raft commits and applies it (ADR-0060 §5).
    fn isPublished(borrow this, lsn: u64) -> bool =>
        if (this.raft) lsn <= this.journal.durableLsn() else lsn < this.publishedNext;

    /// The LSN after the last published record: every lower one is published.
    fn publishedBelow(borrow this) -> u64 => if (this.raft) this.journal.durableLsn() + 1 else this.publishedNext;

    /// Whether a write that is staged or in flight can no longer be published: the journal failed.
    fn hasFailed(borrow this) -> bool => this.journal.isFailed();

    fn headObject(borrow this, bucket: StringView, key: StringView) -> Result<ObjectInfo, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        let v = match (this.state.current(borrow k)) {
            Some(v) => v,
            null => { return Err(StoreError.NoSuchKey); }
        };
        var info = objectInfoOf(v)?;
        info.versioned = this.versioningOf(bucket.bytes())? != VERSIONING_OFF;
        return Ok(info);
    }

    /// `headObject` (no id) or `headVersion`.
    fn headObjectOf(
        borrow this,
        bucket: StringView,
        key: StringView,
        versionId: [u8; 16]?,
    ) -> Result<ObjectInfo, StoreError> => match (versionId) {
        Some(id) => this.headVersion(bucket, key, id),
        null => this.headObject(bucket, key),
    };

    /// The id of the delete marker that is the key's newest version, if it is one (ADR-0041): why a read of the key
    /// finds no object.
    fn currentMarker(borrow this, bucket: StringView, key: StringView) -> Result<[u8; 16]?, StoreError> {
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        let slot = this.state.index.headSlot(borrow k);
        if (slot == NO_VERSION_SLOT) { return Ok(null); }
        let v = this.state.index.versionAt(slot);
        if (isDeleteMarker(v)) { return Ok(Some(v.versionId)); }
        return Ok(null);
    }

    /// The bucket's versioning: VERSIONING_OFF, VERSIONING_ENABLED or VERSIONING_SUSPENDED.
    fn versioningState(borrow this, bucket: StringView) -> Result<u8, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        return this.versioningOf(bucket.bytes());
    }

    /// `headObject` of one version by its id (ADR-0041): NoSuchVersion if the key has none such, MethodNotAllowed
    /// for a delete marker.
    fn headVersion(
        borrow this,
        bucket: StringView,
        key: StringView,
        versionId: [u8; 16],
    ) -> Result<ObjectInfo, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        let v = match (this.state.index.find(borrow k, versionId)) {
            Some(v) => v,
            null => { return Err(StoreError.NoSuchVersion); }
        };
        if (isDeleteMarker(v)) { return Err(StoreError.MethodNotAllowed); }
        var info = objectInfoOf(v)?;
        info.versioned = this.versioningOf(bucket.bytes())? != VERSIONING_OFF;
        return Ok(info);
    }

    /// The key's versions, newest first, delete markers among them (ADR-0041); none for a key that has none.
    fn versionsOf(borrow this, bucket: StringView, key: StringView) -> Result<Vector<VersionEntry>, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        var out = Vector<VersionEntry>.create();
        var slot = this.state.index.headSlot(borrow k);
        while (slot != NO_VERSION_SLOT) {
            let v = this.state.index.versionAt(slot);
            out.push(VersionEntry {
                versionId: v.versionId,
                generation: v.lsn,
                deleteMarker: isDeleteMarker(v),
                size: v.size,
                mtimeMillis: v.mtimeMillis,
                md5: v.md5,
                parts: v.parts,
            })?;
            slot = this.state.index.olderOf(slot);
        }
        return Ok(out);
    }

    /// The bytes of one version by its id, whole, in memory.
    fn getObjectVersion(
        borrow this,
        bucket: StringView,
        key: StringView,
        versionId: [u8; 16],
    ) -> Result<Vector<u8>, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        let v = match (this.state.index.find(borrow k, versionId)) {
            Some(v) => v,
            null => { return Err(StoreError.NoSuchVersion); }
        };
        if (isDeleteMarker(v)) { return Err(StoreError.MethodNotAllowed); }
        var reader = this.openVersionUnpinned(v, 0, 0xFFFFFFFFFFFFFFFF)?;
        return readRemaining(mut reader);
    }

    /// A reader of the current version's stored bytes `[from, to)`, clamped to their length: the object's size, or
    /// its chunks' for a sealed one (ADR-0046 §2).
    fn openReader(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        from: u64,
        to: u64,
    ) -> Result<ObjectReader, StoreError> {
        var prepared = this.prepareReader(bucket, key, from, to)?;
        return prepared.open();
    }

    /// `prepareReader` of one version by its id (ADR-0041): NoSuchVersion if the key has none such,
    /// MethodNotAllowed for a delete marker.
    fn prepareVersionReader(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        versionId: [u8; 16],
        from: u64,
        to: u64,
    ) -> Result<PreparedReader, StoreError> => this.prepareReaderOf(bucket, key, versionId, from, to);

    /// The first half of `openReader`, with no I/O (ADR-0024): the version's lookup and its pins. `open` then reads
    /// without the store, so it may run without the store's lock: the pins keep the version's extents, or the
    /// segment holding its inline record, on disk until the reader is dropped.
    fn prepareReader(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        from: u64,
        to: u64,
    ) -> Result<PreparedReader, StoreError> => this.prepareReaderOf(bucket, key, null, from, to);

    /// `prepareReader` of the current version (no id), or of the version with the id.
    fn prepareReaderOf(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        versionId: [u8; 16]?,
        from: u64,
        to: u64,
    ) -> Result<PreparedReader, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        let v = match (versionId) {
            Some(id) => match (this.state.index.find(borrow k, id)) {
                Some(v) => {
                    if (isDeleteMarker(v)) { return Err(StoreError.MethodNotAllowed); }
                    v
                }
                null => { return Err(StoreError.NoSuchVersion); }
            },
            null => match (this.state.current(borrow k)) {
                Some(v) => v,
                null => { return Err(StoreError.NoSuchKey); }
            },
        };
        // Offsets of what is stored, which for a sealed version is longer than its size (ADR-0046 §2).
        let stored = storedLengthOf(v);
        let end = if (to > stored) stored else to;
        let start = if (from > end) end else from;
        if (v.extents.length != 0) {
            // A coded extent with no whole copy here: wanted, decoded by the node, and the client's retry reads it
            // (ADR-0064 §5).
            if (this.wantsDecode(v)) { return Err(StoreError.ExtentWanted); }
            var refs = Vector<ExtentRef>.create();
            refs.extend(v.extents.view())?;
            let extents = ExtentReader.create(this.extentDir.view(), refs, start, end)?;
            let pin = this.pins.pin(v.extents.view())?;
            return Ok(PreparedReader {
                reader: ObjectReader { inline: Vector<u8>.create(), inlinePosition: 0, extents: extents, pin: pin },
                record: null,
            });
        }
        // In a coded segment with no whole copy here: wanted, as a coded extent is (ADR-0070 §3).
        if (this.wantsDecode(v)) { return Err(StoreError.ExtentWanted); }
        let payloadStart = v.recordLength as usize - RECORD_TRAILER_LEN - v.payload.length as usize;
        let path = match (this.journal.segmentFile(v.recordSegment)) {
            Ok(p) => p,
            Err(e) => { return Err(StoreError.Journal(e)); }
        };
        let record = InlineRecord {
            path: path,
            segment: v.recordSegment,
            offset: v.payload.offset + v.payload.length as u64 + RECORD_TRAILER_LEN as u64 - v.recordLength as u64,
            length: v.recordLength,
            from: payloadStart + start as usize,
            to: payloadStart + end as usize,
            pin: this.segmentPins.pinOne(v.recordSegment)?,
        };
        return Ok(PreparedReader { reader: null, record: record });
    }

    /// A reader that does not pin its extents: only for reads that end before the store is released (fsck,
    /// `getObjectRange`), since no reap can run while the store is borrowed.
    fn openUnpinned(
        borrow this,
        bucket: StringView,
        key: StringView,
        from: u64,
        to: u64,
    ) -> Result<ObjectReader, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        let v = match (this.state.current(borrow k)) {
            Some(v) => v,
            null => { return Err(StoreError.NoSuchKey); }
        };
        return this.openVersionUnpinned(v, from, to);
    }

    /// `openUnpinned` of one version, current or not.
    fn openVersionUnpinned(
        borrow this,
        v: borrow ObjectVersion,
        from: u64,
        to: u64,
    ) -> Result<ObjectReader, StoreError> {
        let stored = storedLengthOf(v);
        let end = if (to > stored) stored else to;
        let start = if (from > end) end else from;
        if (v.extents.length == 0) {
            // The whole record is read and verified, so a GET never serves rotted bytes:
            // recovery no longer scans the segments a checkpoint covers (ADR-0005).
            let record = this.readLiveRecord(v)?;
            let payloadStart = v.recordLength as usize - RECORD_TRAILER_LEN - v.payload.length as usize;
            var bytes = Vector<u8>.create();
            bytes.extend(record.view()[payloadStart + start as usize..payloadStart + end as usize])?;
            return Ok(ObjectReader { inline: bytes, inlinePosition: 0, extents: null, pin: null });
        }
        if (this.wantsDecode(v)) { return Err(StoreError.ExtentWanted); }
        var refs = Vector<ExtentRef>.create();
        refs.extend(v.extents.view())?;
        let reader = ExtentReader.create(this.extentDir.view(), refs, start, end)?;
        return Ok(ObjectReader { inline: Vector<u8>.create(), inlinePosition: 0, extents: reader, pin: null });
    }

    /// The object's bytes `[from, to)` in memory (the whole object for 0, u64 max).
    fn getObjectRange(
        borrow this,
        bucket: StringView,
        key: StringView,
        from: u64,
        to: u64,
    ) -> Result<Vector<u8>, StoreError> {
        var reader = this.openUnpinned(bucket, key, from, to)?;
        return readRemaining(mut reader);
    }

    fn getObject(borrow this, bucket: StringView, key: StringView) -> Result<Vector<u8>, StoreError> =>
        this.getObjectRange(bucket, key, 0, 0xFFFFFFFFFFFFFFFF);

    /// Deletes the key's object. Deleting a missing key succeeds, as in S3. In a bucket with versioning, enabled or
    /// suspended, nothing is removed: a delete marker becomes the key's newest version (ADR-0041), also for a key
    /// that has no version.
    fn deleteObject(borrow mut this, bucket: StringView, key: StringView) -> Result<void, StoreError> {
        let _ = this.deleteCurrent(bucket, key)?;
        return Ok();
    }

    /// `deleteObject`, telling what it wrote: null when the bucket has no versioning (the object is gone, or was
    /// not there), else the delete marker's id.
    fn deleteCurrent(borrow mut this, bucket: StringView, key: StringView) -> Result<[u8; 16]?, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        ObjectStore.checkKey(key)?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let versioned = this.versioningOf(bucket.bytes())? != VERSIONING_OFF;
        if (!versioned && this.currentGeneration(bucket, key)?.isNull()) { return Ok(null); }
        let staged = this.stageDeleteOf(bucket.bytes(), key.bytes(), Clock.unixMillis())?;
        this.commitStaged()?;
        if (versioned) { return Ok(staged.versionId); }
        return Ok(null);
    }

    /// Removes one version of the key for good, a delete marker too (ADR-0041): what it was, or null if the key has
    /// no version with that id, which succeeds as in S3. The next older version becomes the key's newest.
    fn deleteVersion(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        versionId: [u8; 16],
    ) -> Result<VersionKind?, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        ObjectStore.checkKey(key)?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        let locks = this.lockConfigOf(bucket.bytes())?.length > 0;
        let kind = match (this.state.index.find(borrow k, versionId)) {
            Some(v) => {
                if (locks && lockHolds(lockOfMetadata(v.metadata.view()), Clock.unixMillis(), false)) {
                    return Err(StoreError.ObjectLocked);
                }
                v.kind
            }
            null => { return Ok(null); }
        };
        let _ = this.stageDeleteRecord(
            RecordType.DeleteVersion,
            bucket.bytes(),
            key.bytes(),
            versionId,
            Clock.unixMillis(),
        )?;
        this.commitStaged()?;
        return Ok(kind);
    }

    /// RenameObject (ADR-0081): the object of `from`, if its current version is still of `generation` (its
    /// `ObjectInfo.generation`, read under the same hold of the store, after `commitStaged`), becomes `to`'s, by one
    /// Rename record, committed and synced before this returns (ADR-0001). No payload is copied. A directory bucket's
    /// only: its objects have the null version id. NoSuchKey when `from` has no such version, PreconditionFailed when
    /// it has another.
    fn renameObject(
        borrow mut this,
        bucket: StringView,
        from: StringView,
        to: StringView,
        generation: u64,
        token: Slice<u8>,
    ) -> Result<void, StoreError> {
        return this.renameObjectTo(bucket, from, to, generation, token, false);
    }

    /// `renameObject`; with `toAbsent`, PreconditionFailed if `to` has an object, checked as a conditional PUT's
    /// If-None-Match is, against state with the records proposed and not yet applied (ADR-0058 §8). So two renames to
    /// one key cannot both win on a cluster's shard (S3 Tables' RenameTable, ADR-0083 §3).
    fn renameObjectTo(
        borrow mut this,
        bucket: StringView,
        from: StringView,
        to: StringView,
        generation: u64,
        token: Slice<u8>,
        toAbsent: bool,
    ) -> Result<void, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        ObjectStore.checkKey(from)?;
        ObjectStore.checkKey(to)?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        if (this.versioningOf(bucket.bytes())? != VERSIONING_OFF) { return Err(StoreError.MethodNotAllowed); }
        let k = this.state.keyFor(bucket.bytes(), from.bytes())?;
        match (this.state.index.get(borrow k)) {
            Some(v) => {
                if (isDeleteMarker(v) || !isNullVersionId(v.versionId)) { return Err(StoreError.NoSuchKey); }
                if (v.lsn != generation) { return Err(StoreError.PreconditionFailed); }
            }
            null => { return Err(StoreError.NoSuchKey); }
        }
        if (from == to) { return Ok(); }
        if (toAbsent && this.currentGeneration(bucket, to)?.isSome()) { return Err(StoreError.PreconditionFailed); }
        var meta = Vector<u8>.create();
        encodeRenameMeta(mut meta, bucket.bytes(), from.bytes(), to.bytes(), generation)?;
        let empty = [0u8; 1];
        if (this.journal.wouldOverflow(meta.length, 0) || this.journal.needsRotation()) { this.commitStaged()?; }
        this.pendingApplies.reserve(1)?;
        let pos = this.stageRecord(RecordType.Rename, meta.view(), empty[0..0])?;
        this.pendingApplies.push(PendingApply {
            kind: RecordType.Rename,
            lsn: pos.lsn,
            segment: pos.segmentId,
            offset: pos.offset,
            total: truncate<u32>(recordLength(meta.length, 0)),
            meta: meta,
            payloadLen: 0,
            manifest: Vector<u8>.create(),
        })?;
        this.commitStaged()?;
        if (token.length > 0) {
            if (this.renameTokens.length >= RENAME_TOKENS_KEPT) { let _ = this.renameTokens.remove(0); }
            this.renameTokens.push(RenameToken {
                token: copyBytes(token)?,
                bucket: copyBytes(bucket.bytes())?,
                from: copyBytes(from.bytes())?,
                to: copyBytes(to.bytes())?,
                expiresMs: Clock.unixMillis() + RENAME_TOKEN_MS,
            })?;
        }
        return Ok();
    }

    /// A RenameObject's client token (ADR-0081 §4): Done when a rename of the same keys with it succeeded in the last
    /// `RENAME_TOKEN_MS` (a retry, answered the same), Mismatch when it renamed others, else New. Memory only.
    fn renameRetry(
        borrow mut this,
        token: Slice<u8>,
        bucket: StringView,
        from: StringView,
        to: StringView,
    ) -> RenameRetry {
        let now = Clock.unixMillis();
        while (this.renameTokens.length > 0 && this.renameTokens[0].expiresMs <= now) {
            let _ = this.renameTokens.remove(0);
        }
        for (i in 0..this.renameTokens.length) {
            let t = borrow this.renameTokens[i];
            if (t.token.view() != token) { continue; }
            let same = t.bucket.view() == bucket.bytes() && t.from.view() == from.bytes() && t.to.view() == to.bytes();
            return if (same) RenameRetry.Done else RenameRetry.Mismatch;
        }
        return RenameRetry.New;
    }

    /// Stages the delete of `key` without committing it (ADR-0025), as `putFinishedDeferred` stages a PUT: the caller
    /// acknowledges it once `isPublished` says so. Returns the delete record's LSN, or null when there is nothing to
    /// write: the key is missing and no write is staged or in flight that could still create it.
    fn deleteObjectDeferred(borrow mut this, bucket: StringView, key: StringView) -> Result<u64?, StoreError> {
        this.checkWritable()?;
        ObjectStore.checkKey(key)?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        // The index shows only published writes. A PUT of this key may be staged or in its sync, and the delete
        // must then still follow it; a delete of a missing key applies as nothing.
        let unpublished = this.pendingApplies.length > 0 || this.inflightApplies.length > 0;
        let versioned = this.versioningOf(bucket.bytes())? != VERSIONING_OFF;
        if (!versioned && !unpublished && this.currentGeneration(bucket, key)?.isNull()) { return Ok(null); }
        return Ok(this.stageDelete(bucket.bytes(), key.bytes(), Clock.unixMillis())?);
    }

    /// `deleteObjectDeferred` for a request that may name a version (ADR-0041). Without one it is that, telling the
    /// delete marker it staged in a bucket with versioning. With one, the version is removed for good; the null id
    /// in a bucket without versioning names the key's one object, so that is the plain delete.
    fn deleteDeferred(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        versionId: [u8; 16]?,
        bypass: bool,
    ) -> Result<DeleteOutcome, StoreError> {
        this.checkWritable()?;
        ObjectStore.checkKey(key)?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let target = DeleteTarget { key: copyBytes(key.bytes())?, versionId: versionId, bypassGovernance: bypass };
        let unpublished = this.pendingApplies.length > 0 || this.inflightApplies.length > 0;
        return this.stageTarget(bucket.bytes(), borrow target, Clock.unixMillis(), unpublished);
    }

    /// Stages what one delete asks for, without committing it. The index shows only published writes, so a delete
    /// that finds nothing is still staged when other requests' writes are staged or in their sync (`unpublished`):
    /// it must follow a PUT of its key among them, and applies as nothing otherwise.
    fn stageTarget(
        borrow mut this,
        bucket: Slice<u8>,
        target: borrow DeleteTarget,
        now: i64,
        unpublished: bool,
    ) -> Result<DeleteOutcome, StoreError> {
        let key = target.key.view();
        let versioning = this.versioningOf(bucket)?;
        let k = this.state.keyFor(bucket, key)?;
        var named: [u8; 16]? = target.versionId;
        match (named) {
            Some(id) => {
                if (versioning == VERSIONING_OFF && isNullVersionId(id)) { named = null; }
            }
            null => {}
        }
        match (named) {
            Some(id) => {
                var found = false;
                var marker = false;
                var locked = false;
                // A version is locked only in a bucket with object lock: no other pays for the look (ADR-0047 §6).
                let locks = this.lockConfigOf(bucket)?.length > 0;
                match (this.state.index.find(borrow k, id)) {
                    Some(v) => {
                        found = true;
                        marker = isDeleteMarker(v);
                        locked = locks && lockHolds(lockOfMetadata(v.metadata.view()), now, target.bypassGovernance);
                    }
                    null => {}
                }
                var lsn: u64? = null;
                // The version stays. Its id is 16 random bytes that only its published PUT has told: a version
                // locked by a write still unpublished cannot be named here.
                if (locked) {
                    return Ok(
                        DeleteOutcome { valid: true, lsn: null, versionId: id, deleteMarker: marker, locked: true },
                    );
                }
                if (found || unpublished) {
                    lsn = this.stageDeleteRecord(RecordType.DeleteVersion, bucket, key, id, now)?;
                }
                return Ok(DeleteOutcome { valid: true, lsn: lsn, versionId: id, deleteMarker: marker, locked: false });
            }
            null => {}
        }
        if (versioning == VERSIONING_OFF) {
            var lsn: u64? = null;
            if (unpublished || this.state.current(borrow k).isSome()) { lsn = this.stageDelete(bucket, key, now)?; }
            return Ok(DeleteOutcome { valid: true, lsn: lsn, versionId: null, deleteMarker: false, locked: false });
        }
        let staged = this.stageDeleteOf(bucket, key, now)?;
        return Ok(DeleteOutcome {
            valid: true,
            lsn: staged.lsn,
            versionId: staged.versionId,
            deleteMarker: true,
            locked: false,
        });
    }

    /// `deleteObjects` for entries that may name versions (ADR-0041), telling what each did: one commit for all.
    fn deleteMany(
        borrow mut this,
        bucket: StringView,
        targets: Slice<DeleteTarget>,
    ) -> Result<Vector<DeleteOutcome>, StoreError> => this.deleteManyAt(bucket.bytes(), targets, Clock.unixMillis());

    /// `deleteMany` with the time its records carry: the clock's, or a lifecycle run's.
    fn deleteManyAt(
        borrow mut this,
        bucket: Slice<u8>,
        targets: Slice<DeleteTarget>,
        now: i64,
    ) -> Result<Vector<DeleteOutcome>, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        if (!this.state.hasBucket(bucket)?) { return Err(StoreError.NoSuchBucket); }
        var out = Vector<DeleteOutcome>.create();
        // Before the batch stages anything of its own: what is in a sync now may hold a PUT of one of its keys.
        let unpublished = this.pendingApplies.length > 0 || this.inflightApplies.length > 0;
        for (i in 0..targets.length) {
            let key = targets[i].key.view();
            if (key.length == 0 || key.length > MAX_KEY_BYTES) {
                out.push(
                    DeleteOutcome { valid: false, lsn: null, versionId: null, deleteMarker: false, locked: false },
                )?;
                continue;
            }
            match (this.stageTarget(bucket, borrow targets[i], now, unpublished)) {
                Ok(o) => { out.push(o)?; }
                Err(e) => {
                    this.journal.discardPending();
                    this.pendingApplies.clear();
                    return Err(e);
                }
            }
        }
        this.commitStaged()?;
        return Ok(out);
    }

    /// Deletes many keys of `bucket` with one commit: one journal write and one sync for the batch (ADR-0010). The
    /// result says, per key, whether it was valid; a missing key is deleted, as in S3. Nothing is acknowledged
    /// before the batch is durable: on an error none of it is.
    fn deleteObjects(borrow mut this, bucket: StringView, keys: Slice<Vector<u8>>) -> Result<Vector<bool>, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        var valid = Vector<bool>.create();
        let now = Clock.unixMillis();
        let versioned = this.versioningOf(bucket.bytes())? != VERSIONING_OFF;
        for (i in 0..keys.length) {
            let key = keys[i].view();
            if (key.length == 0 || key.length > MAX_KEY_BYTES) {
                valid.push(false)?;
                continue;
            }
            valid.push(true)?;
            let k = this.state.keyFor(bucket.bytes(), key)?;
            if (!versioned && this.state.current(borrow k).isNull()) { continue; }
            match (this.stageDelete(bucket.bytes(), key, now)) {
                Ok(_) => {}
                Err(e) => {
                    this.journal.discardPending();
                    this.pendingApplies.clear();
                    return Err(e);
                }
            }
        }
        this.commitStaged()?;
        return Ok(valid);
    }

    /// Stages the delete of `key`'s current object and returns the record's LSN.
    fn stageDelete(borrow mut this, bucket: Slice<u8>, key: Slice<u8>, now: i64) -> Result<u64, StoreError> =>
        Ok(this.stageDeleteOf(bucket, key, now)?.lsn);

    /// Stages the delete of `key`'s current object as the bucket's versioning asks (ADR-0041 §3): without versioning
    /// a DeleteVersion of the null version; enabled, a DeleteMarker with a new id; suspended, one with the null id.
    fn stageDeleteOf(borrow mut this, bucket: Slice<u8>, key: Slice<u8>, now: i64) -> Result<StagedDelete, StoreError> {
        let versioning = this.versioningOf(bucket)?;
        if (versioning == VERSIONING_OFF) {
            let lsn = this.stageDeleteRecord(RecordType.DeleteVersion, bucket, key, nullVersionId(), now)?;
            return Ok(StagedDelete { lsn: lsn, versionId: nullVersionId() });
        }
        let id = this.versionIdFor(bucket, key)?;
        let lsn = this.stageDeleteRecord(RecordType.DeleteMarker, bucket, key, id, now)?;
        return Ok(StagedDelete { lsn: lsn, versionId: id });
    }

    /// Stages a record that is all meta and returns its LSN; a full batch, or a full segment, is committed first.
    fn stageMetaRecord(borrow mut this, kind: RecordType, meta: Vector<u8>) -> Result<u64, StoreError> {
        let empty = [0u8; 1];
        if (this.journal.wouldOverflow(meta.length, 0) || this.journal.needsRotation()) { this.commitStaged()?; }
        this.pendingApplies.reserve(1)?;
        let pos = this.stageRecord(kind, meta.view(), empty[0..0])?;
        this.pendingApplies.push(PendingApply {
            kind: kind,
            lsn: pos.lsn,
            segment: pos.segmentId,
            offset: pos.offset,
            total: truncate<u32>(recordLength(meta.length, 0)),
            meta: meta,
            payloadLen: 0,
            manifest: Vector<u8>.create(),
        })?;
        return Ok(pos.lsn);
    }

    /// Stages a DeleteVersion or DeleteMarker record of `key` and returns its LSN; a full batch, or a full segment,
    /// is committed first (ADR-0022).
    fn stageDeleteRecord(
        borrow mut this,
        kind: RecordType,
        bucket: Slice<u8>,
        key: Slice<u8>,
        versionId: [u8; 16],
        now: i64,
    ) -> Result<u64, StoreError> {
        var meta = Vector<u8>.create();
        encodeDeleteMeta(mut meta, bucket, key, versionId, now)?;
        let empty = [0u8; 1];
        if (this.journal.wouldOverflow(meta.length, 0) || this.journal.needsRotation()) { this.commitStaged()?; }
        this.pendingApplies.reserve(1)?;
        let pos = this.stageRecord(kind, meta.view(), empty[0..0])?;
        this.pendingApplies.push(PendingApply {
            kind: kind,
            lsn: pos.lsn,
            segment: pos.segmentId,
            offset: pos.offset,
            total: truncate<u32>(recordLength(meta.length, 0)),
            meta: meta,
            payloadLen: 0,
            manifest: Vector<u8>.create(),
        })?;
        return Ok(pos.lsn);
    }

    // ---- Multipart uploads (ADR-0009) ----

    /// Begins a multipart upload of `key`; returns its id.
    fn createUpload(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
    ) -> Result<[u8; 16], StoreError> =>
        this.createUploadWith(bucket, key, contentType, "".bytes(), ChecksumAlgorithm.None, ChecksumType.FullObject);

    /// `createUpload` with the stored fields the completed object will have (ADR-0012), and the checksum its parts
    /// carry and how the object's comes from them (ADR-0015). A FULL_OBJECT checksum must be a CRC.
    fn createUploadWith(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        metadata: Slice<u8>,
        algorithm: ChecksumAlgorithm,
        kind: ChecksumType,
    ) -> Result<[u8; 16], StoreError> {
        this.commitStaged()?;
        if (metadata.length > MAX_METADATA_BYTES) { return Err(StoreError.MetadataTooLarge); }
        this.checkWritable()?;
        ObjectStore.checkKey(key)?;
        if (contentType.length > MAX_CONTENT_TYPE) { return Err(StoreError.InvalidKey); }
        if (!this.bucketForWrite(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        this.admit(0)?;
        var id = [0u8; 16];
        while (true) {
            Random.fill(mut id[..])!;
            let uk = UploadKey { id: id };
            if (!this.state.uploads.contains(borrow uk)) { break; }
        }
        this.scratch.clear();
        encodeUploadCreateMeta(
            mut this.scratch,
            id,
            bucket.bytes(),
            key.bytes(),
            Clock.unixMillis(),
            contentType.bytes(),
            metadata,
            algorithm,
            kind,
        )?;
        let empty = [0u8; 1];
        this.commitOne(RecordType.UploadCreate, empty[0..0])?;
        return Ok(id);
    }

    /// Whether `id` is an upload of this bucket and key.
    fn findUpload(borrow this, bucket: StringView, key: StringView, id: [u8; 16]) -> Result<void, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let uk = UploadKey { id: id };
        match (this.state.uploads.get(borrow uk)) {
            Some(u) => {
                if (u.bucket.view() != bucket.bytes() || u.key.view() != key.bytes()) {
                    return Err(StoreError.NoSuchUpload);
                }
                return Ok();
            }
            null => { return Err(StoreError.NoSuchUpload); }
        }
    }

    /// A writer for one part: it has no inline buffer, so every byte goes to extents.
    fn newPartWriter(borrow this) -> Result<ObjectWriter, StoreError> =>
        Ok(ObjectWriter.create(this.extentDir.view(), 0, this.config.extentMaxBytes, this.abandoned.clone())?);

    /// Checks that a part of `size` bytes may be uploaded: the upload exists and the size is admitted.
    fn checkPart(
        borrow this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        number: u32,
        size: u64,
    ) -> Result<void, StoreError> {
        this.checkWritable()?;
        if (number < 1 || number > MAX_PART_NUMBER) { return Err(StoreError.InvalidPartNumber); }
        this.findUpload(bucket, key, id)?;
        if (size > this.config.maxObjectBytes) { return Err(StoreError.EntityTooLarge); }
        this.admit(size)?;
        return Ok();
    }

    /// Commits a finished part of an upload, replacing a part of the same number; returns its MD5. On a refusal its
    /// extents are removed.
    fn putPart(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        number: u32,
        obj: borrow FinishedObject,
    ) -> Result<[u8; 16], StoreError> => this.putPartWith(bucket, key, id, number, "".bytes(), obj);

    /// `putPart` with the part's checksum in the upload's algorithm (ADR-0015; empty for none).
    fn putPartWith(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        number: u32,
        checksum: Slice<u8>,
        obj: borrow FinishedObject,
    ) -> Result<[u8; 16], StoreError> {
        this.commitStaged()?;
        if (checksum.length > 0 && checksum.length != checksumLength(this.uploadAlgorithm(id))) {
            this.discardFinished(obj);
            return Err(StoreError.InvalidPart);
        }
        var manifest = Vector<u8>.create();
        let checked = match (borrow obj.body) {
            ObjectBody.Extents(extents) => {
                encodeManifest(mut manifest, extents.view())?;
                this.checkPart(bucket, key, id, number, obj.size)
            }
            ObjectBody.Inline(data) => {
                // A part writer spills every byte, so only an empty part is inline.
                encodeManifest(mut manifest, Vector<ExtentRef>.create().view())?;
                if (data.length != 0) Err(StoreError.InvalidPart) else this.checkPart(bucket, key, id, number, 0)
            }
        };
        match (checked) {
            Ok() => {}
            Err(e) => {
                this.discardFinished(obj);
                return Err(e);
            }
        }
        this.scratch.clear();
        encodeUploadPartMeta(mut this.scratch, id, number, obj.size, obj.md5, Clock.unixMillis(), checksum)?;
        this.counts.payloadBytes += obj.size;
        match (borrow obj.body) {
            ObjectBody.Extents(extents) => { this.counts.extentBytesWritten += extentRefBytes(extents.view()); }
            ObjectBody.Inline(_) => {}
        }
        this.commitOne(RecordType.UploadPart, manifest.view())?;
        return Ok(obj.md5);
    }

    /// Discards an upload and its parts.
    fn abortUpload(borrow mut this, bucket: StringView, key: StringView, id: [u8; 16]) -> Result<void, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        this.findUpload(bucket, key, id)?;
        this.scratch.clear();
        encodeUploadAbortMeta(mut this.scratch, id, Clock.unixMillis())?;
        let empty = [0u8; 1];
        this.commitOne(RecordType.UploadAbort, empty[0..0])?;
        return Ok();
    }

    /// Makes the named parts, in order, the key's current version, and ends the upload. Parts it does not name are
    /// removed. The outcome's MD5 is the multipart ETag's digest.
    fn completeUpload(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        chosen: Slice<PartChoice>,
    ) -> Result<PutOutcome, StoreError> =>
        this.completeUploadIf(bucket, key, id, chosen, PutCondition.None, "".bytes());

    /// `completeUpload` if `condition` holds for the key's current version, checked with the commit (ADR-0014). A
    /// retry of a completion whose object is still current gets the first answer, whatever its parts and condition.
    fn completeUploadIf(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        chosen: Slice<PartChoice>,
        condition: PutCondition,
        expected: Slice<u8>,
    ) -> Result<PutOutcome, StoreError> => this.completeUploadAs(bucket, key, id, chosen, condition, expected, null);

    /// `completeUploadIf`, the version taking the id `asVersion` names if it is given: a replica's (ADR-0078 §4), in
    /// a bucket with versioning enabled, as `putReplica` writes one. If the key already has a version with that id
    /// (a delivery tried again), the upload is aborted and that version answers.
    fn completeUploadAs(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        chosen: Slice<PartChoice>,
        condition: PutCondition,
        expected: Slice<u8>,
        asVersion: [u8; 16]?,
    ) -> Result<PutOutcome, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        var manifest = Vector<u8>.create();
        let versionId = match (asVersion) {
            Some(v) => {
                if (isNullVersionId(v) || this.versioningOf(bucket.bytes())? != VERSIONING_ENABLED) {
                    return Err(StoreError.InvalidKey);
                }
                let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
                if (this.state.index.slotOf(borrow k, v) != NO_VERSION_SLOT) {
                    let _ = this.abortUpload(bucket, key, id);
                    let there = this.headObjectOf(bucket, key, Some(v))?;
                    return Ok(PutOutcome {
                        md5: there.md5,
                        generation: there.generation,
                        parts: there.parts,
                        extras: there.extras,
                        versionId: v,
                    });
                }
                v
            }
            null => this.versionIdFor(bucket.bytes(), key.bytes())?,
        };
        var meta = Vector<u8>.create();
        var extrasBlob = Vector<u8>.create();
        {
            match (this.findUpload(bucket, key, id)) {
                Ok() => {}
                Err(StoreError.NoSuchUpload) => {
                    match (this.repeatedCompletion(bucket, key, id)?) {
                        Some(outcome) => { return Ok(outcome); }
                        null => { return Err(StoreError.NoSuchUpload); }
                    }
                }
                Err(e) => { return Err(e); }
            }
            let current = this.currentGeneration(bucket, key)?;
            match (condition) {
                PutCondition.None => {}
                PutCondition.IfAbsent => {
                    if (current.isSome()) { return Err(StoreError.PreconditionFailed); }
                }
                PutCondition.IfGeneration(g) => {
                    if ((current ?? 0) != g) { return Err(StoreError.PreconditionFailed); }
                }
            }
            let uk = UploadKey { id: id };
            let u = match (this.state.uploads.get(borrow uk)) {
                Some(u) => u,
                null => { return Err(StoreError.NoSuchUpload); }
            };
            if (chosen.length == 0) { return Err(StoreError.InvalidPart); }
            var extents = Vector<ExtentRef>.create();
            var md5s = Vector<[u8; 16]>.create();
            // The parts' sizes and checksums, for the object's checksum and its part layout (ADR-0015).
            var extras = ObjectExtras.none();
            let checksumBytes = checksumLength(u.checksumAlgorithm);
            var allChecksummed = checksumBytes > 0;
            var size: u64 = 0;
            var next: usize = 0;
            for (c in 1..chosen.length) {
                if (chosen[c].number <= chosen[c - 1].number) { return Err(StoreError.InvalidPartOrder); }
            }
            for (c in 0..chosen.length) {
                let want = borrow chosen[c];
                // Parts are in ascending number, as are the choices: one pass finds them all.
                while (next < u.parts.length && u.parts[next].number < want.number) { next += 1; }
                if (next == u.parts.length || u.parts[next].number != want.number) {
                    return Err(StoreError.InvalidPart);
                }
                let part = borrow u.parts[next];
                if (part.md5[..] != want.md5[..]) { return Err(StoreError.InvalidPart); }
                let named = want.checksumLength as usize;
                if (named > 0 && (part.checksum.length != named || part.checksum.view() != want.checksum[0..named])) {
                    return Err(StoreError.InvalidPart);
                }
                extras.partSizes.push(part.size)?;
                if (part.checksum.length == checksumBytes && checksumBytes > 0) {
                    extras.partChecksums.extend(part.checksum.view())?;
                } else {
                    allChecksummed = false;
                }
                if (c + 1 < chosen.length && part.size < this.config.minPartBytes) {
                    return Err(StoreError.EntityTooSmall);
                }
                size += part.size;
                extents.extend(part.extents.view())?;
                md5s.push(part.md5)?;
            }
            if (size > this.config.maxUploadBytes) { return Err(StoreError.EntityTooLarge); }
            this.checkQuota(bucket.bytes(), key.bytes(), size)?;
            if (allChecksummed) {
                extras.algorithm = u.checksumAlgorithm;
                extras.kind = u.checksumType;
                extras.value = multipartChecksum(
                    u.checksumAlgorithm,
                    u.checksumType,
                    extras.partChecksums.view(),
                    extras.partSizes.view(),
                )?;
            } else {
                extras.partChecksums.clear(); // the layout alone
            }
            if (expected.length > 0 && expected != extras.value.view()) { return Err(StoreError.BadDigest); }
            extras.encode(mut extrasBlob)?;
            encodeManifest(mut manifest, extents.view())?;
            // The lock the upload was created with, or the bucket's default from now (ADR-0047 §2).
            let lockedMetadata = this.lockMetadata(bucket.bytes(), u.metadata.view())?;
            let objectMetadata = match (lockedMetadata) {
                Some(m) => m,
                null => copyBytes(u.metadata.view())?,
            };
            encodeUploadCompleteMeta(
                mut meta,
                bucket.bytes(),
                key.bytes(),
                versionId,
                Clock.unixMillis(),
                size,
                multipartEtag(md5s.view()),
                u.contentType.view(),
                objectMetadata.view(),
                id,
                truncate<u32>(chosen.length),
                extrasBlob.view(),
            )?;
        }
        this.scratch.clear();
        this.scratch.extend(meta.view())?;
        let lsn = this.commitOne(RecordType.UploadComplete, manifest.view())?;
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        let md5 = match (this.state.current(borrow k)) {
            Some(v) => v.md5,
            null => [0u8; 16],
        };
        return Ok(PutOutcome {
            md5: md5,
            generation: lsn,
            parts: truncate<u32>(chosen.length),
            extras: extrasBlob,
            versionId: versionId,
        });
    }

    /// The first answer to the completion of `id`, if its object is still the key's current version.
    fn repeatedCompletion(
        borrow this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
    ) -> Result<PutOutcome?, StoreError> {
        for (c in this.state.completions.view()) {
            if (c.id[..] != id[..] || c.bucket.view() != bucket.bytes() || c.key.view() != key.bytes()) { continue; }
            let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
            // The version the completion made, while the key has it: its newest, or, in a bucket with versioning,
            // one under later versions (ADR-0041).
            var slot = this.state.index.headSlot(borrow k);
            while (slot != NO_VERSION_SLOT) {
                let v = this.state.index.versionAt(slot);
                if (v.lsn == c.generation && !isDeleteMarker(v)) {
                    return Ok(PutOutcome {
                        md5: v.md5,
                        generation: v.lsn,
                        parts: v.parts,
                        extras: copyBytes(v.extras.view())?,
                        versionId: v.versionId,
                    });
                }
                slot = this.state.index.olderOf(slot);
            }
            return Ok(null);
        }
        return Ok(null);
    }

    /// The uploads of `bucket` whose keys start with `prefix`, in key order, then by initiation. The listing starts
    /// after `keyMarker`, or, with `idMarker`, after that upload of `keyMarker`.
    fn listUploads(
        borrow this,
        bucket: StringView,
        prefix: Slice<u8>,
        keyMarker: Slice<u8>,
        idMarker: [u8; 16]?,
        maxUploads: usize,
    ) -> Result<UploadListing, StoreError> =>
        this.listUploadsGrouped(bucket, prefix, "".bytes(), keyMarker, idMarker, maxUploads);

    /// `listUploads`, keys with `delimiter` after the prefix rolled up into common prefixes, as ListObjects rolls
    /// them (ADR-0090 §3). A common prefix counts toward `maxUploads`, and a key marker that is one skips its keys.
    fn listUploadsGrouped(
        borrow this,
        bucket: StringView,
        prefix: Slice<u8>,
        delimiter: Slice<u8>,
        keyMarker: Slice<u8>,
        idMarker: [u8; 16]?,
        maxUploads: usize,
    ) -> Result<UploadListing, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let uploads = borrow this.state.uploads;
        // Where the marker upload sorts, if it is one of this key's.
        var markerAt: i64? = null;
        match (idMarker) {
            Some(mid) => {
                let uk = UploadKey { id: mid };
                match (uploads.get(borrow uk)) {
                    Some(u) => {
                        if (u.key.view() == keyMarker) { markerAt = u.initiatedMillis; }
                    }
                    null => {}
                }
            }
            null => {}
        }
        var matches = Vector<usize>.create();
        for (i in 0..uploads.length()) {
            let u = uploads.valueAt(i);
            if (u.bucket.view() != bucket.bytes() || !startsWithBytes(u.key.view(), prefix)) { continue; }
            let order = compareBytes(u.key.view(), keyMarker);
            if (keyMarker.length > 0 && order < 0) { continue; }
            if (keyMarker.length > 0 && order == 0) {
                match (markerAt) {
                    Some(t) => {
                        let id = uploads.keyAt(i).id;
                        let after = u.initiatedMillis > t ||
                            (u.initiatedMillis == t && compareBytes(id[..], (idMarker ?? [0u8; 16])[..]) > 0);
                        if (!after) { continue; }
                    }
                    null => { continue; }
                }
            }
            matches.push(i)?;
        }
        matches.viewMut().sortBy((a, b) => {
            let ua = uploads.valueAt(a);
            let ub = uploads.valueAt(b);
            let byKey = compareBytes(ua.key.view(), ub.key.view());
            if (byKey != 0) { return byKey; }
            if (ua.initiatedMillis != ub.initiatedMillis) {
                return if (ua.initiatedMillis < ub.initiatedMillis) -1 else 1;
            }
            let ia = uploads.keyAt(a).id;
            let ib = uploads.keyAt(b).id;
            return compareBytes(ia[..], ib[..]);
        });
        var listing = UploadListing {
            uploads: Vector<UploadSummary>.create(),
            commonPrefixes: Vector<Vector<u8>>.create(),
            truncated: false,
            nextKeyMarker: Vector<u8>.create(),
        };
        for (m in matches.view()) {
            let u = uploads.valueAt(m);
            // Rolled up: the key up to the first delimiter after the prefix.
            if (delimiter.length > 0) {
                match (findBytes(u.key.view(), delimiter, prefix.length)) {
                    Some(d) => {
                        let cp = u.key.view()[0..d + delimiter.length];
                        if (keyMarker.length > 0 && compareBytes(cp, keyMarker) <= 0) { continue; }
                        let n = listing.commonPrefixes.length;
                        if (n > 0 && listing.commonPrefixes[n - 1].view() == cp) { continue; }
                        if (listing.uploads.length + n == maxUploads) {
                            listing.truncated = true;
                            break;
                        }
                        listing.commonPrefixes.push(copyBytes(cp)?)?;
                        listing.nextKeyMarker.clear();
                        listing.nextKeyMarker.extend(cp)?;
                        continue;
                    }
                    null => {}
                }
            }
            if (listing.uploads.length + listing.commonPrefixes.length == maxUploads) {
                listing.truncated = true;
                break;
            }
            listing.nextKeyMarker.clear();
            listing.nextKeyMarker.extend(u.key.view())?;
            listing.uploads.push(UploadSummary {
                key: copyBytes(u.key.view())?,
                id: uploads.keyAt(m).id,
                initiatedMillis: u.initiatedMillis,
                storageClass: storageClassIn(u.metadata.view())?,
            })?;
        }
        return Ok(listing);
    }

    /// The parts of an upload after part number `after`, at most `maxParts`.
    fn listParts(
        borrow this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        after: u32,
        maxParts: usize,
    ) -> Result<PartListing, StoreError> {
        this.findUpload(bucket, key, id)?;
        let uk = UploadKey { id: id };
        let u = match (this.state.uploads.get(borrow uk)) {
            Some(u) => u,
            null => { return Err(StoreError.NoSuchUpload); }
        };
        var listing = PartListing {
            parts: Vector<PartSummary>.create(),
            truncated: false,
            algorithm: u.checksumAlgorithm,
            kind: u.checksumType,
            storageClass: storageClassIn(u.metadata.view())?,
        };
        for (i in 0..u.parts.length) {
            let p = borrow u.parts[i];
            if (p.number <= after) { continue; }
            if (listing.parts.length == maxParts) {
                listing.truncated = true;
                break;
            }
            listing.parts.push(PartSummary {
                number: p.number,
                size: p.size,
                md5: p.md5,
                mtimeMillis: p.mtimeMillis,
                checksum: copyBytes(p.checksum.view())?,
            })?;
        }
        return Ok(listing);
    }

    fn uploadCount(borrow this) -> usize => this.state.uploads.length();

    /// The checksum algorithm and type an upload's parts carry (ADR-0015); None for an unknown upload.
    fn uploadAlgorithm(borrow this, id: [u8; 16]) -> ChecksumAlgorithm {
        let uk = UploadKey { id: id };
        return match (this.state.uploads.get(borrow uk)) {
            Some(u) => u.checksumAlgorithm,
            null => ChecksumAlgorithm.None,
        };
    }

    /// The sealed envelope an upload's object will carry (ADR-0046 §2), copied; empty for an upload in the clear or
    /// one there is not.
    fn uploadEnvelope(borrow this, id: [u8; 16]) -> Result<Vector<u8>, AllocError> {
        let uk = UploadKey { id: id };
        var out = Vector<u8>.create();
        match (this.state.uploads.get(borrow uk)) {
            Some(u) => {
                match (metadataFind(u.metadata.view(), SSE_FIELD.bytes())) {
                    Some(f) => { out.extend(f)?; }
                    null => {}
                }
            }
            null => {}
        }
        return Ok(out);
    }

    fn uploadChecksumType(borrow this, id: [u8; 16]) -> ChecksumType {
        let uk = UploadKey { id: id };
        return match (this.state.uploads.get(borrow uk)) {
            Some(u) => u.checksumType,
            null => ChecksumType.FullObject,
        };
    }

    /// The extent files the uploads' parts hold.
    fn uploadExtentCount(borrow this) -> u64 {
        var n: u64 = 0;
        for (i in 0..this.state.uploads.length()) {
            let u = this.state.uploads.valueAt(i);
            for (p in 0..u.parts.length) { n += u.parts[p].extents.length as u64; }
        }
        return n;
    }

    /// Lists keys of `bucket` that start with `prefix` and sort after `startAfter`, rolling up
    /// keys that contain `delimiter` after the prefix into common prefixes (S3 ListObjectsV2).
    /// The index is ordered (ADR-0026): the page seeks to its first key and reads on from there, and a common prefix
    /// skips the keys under it with one more seek, so a page costs its own keys, not the bucket's.
    fn listObjects(
        borrow this,
        bucket: StringView,
        prefix: StringView,
        delimiter: StringView,
        startAfter: Slice<u8>,
        startAfterIsPrefix: bool,
        maxKeys: usize,
    ) -> Result<ListPage, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let index = borrow this.state.index;
        var page = ListPage {
            keys: Vector<Vector<u8>>.create(),
            sizes: Vector<u64>.create(),
            md5s: Vector<[u8; 16]>.create(),
            mtimes: Vector<i64>.create(),
            parts: Vector<u32>.create(),
            classes: Vector<Vector<u8>>.create(),
            restores: Vector<Vector<u8>>.create(),
            commonPrefixes: Vector<Vector<u8>>.create(),
            truncated: false,
            nextMarker: Vector<u8>.create(),
            nextMarkerIsPrefix: false,
        };
        // The first candidate: the first key at or after the prefix, or past the marker if that comes later. A
        // marker that is a common prefix skips every key under it, even one that sorts before the prefix ("a" with
        // prefix "a/" skips everything).
        let first = this.state.keyFor(bucket.bytes(), prefix.bytes())?;
        var cursor = index.seek(borrow first);
        if (startAfter.length > 0) {
            cursor = laterOf(index, cursor, seekPast(index, first.bucket, startAfter, startAfterIsPrefix)?);
        }
        var returned: usize = 0;
        while (true) {
            let at = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            let entry = index.keyAt(at);
            // Keys are in (bucket, key) order: the first one outside the bucket or the prefix ends the listing.
            if (entry.bucket != first.bucket || !startsWithBytes(entry.key.view(), prefix.bytes())) { break; }
            // A key whose newest version is a delete marker has no current object (ADR-0041): it is not listed, and
            // it makes no common prefix.
            if (isDeleteMarker(index.valueAt(at))) {
                cursor = index.next(at);
                continue;
            }
            let key = entry.key.view();
            var rolled: usize? = null;
            if (delimiter.length > 0) {
                match (findBytes(key, delimiter.bytes(), prefix.length)) {
                    Some(d) => { rolled = d + delimiter.length; }
                    null => {}
                }
            }
            if (returned == maxKeys) {
                page.truncated = true;
                break;
            }
            match (rolled) {
                Some(end) => {
                    let cp = key[0..end];
                    page.commonPrefixes.push(copyBytes(cp)?)?;
                    page.nextMarker.clear();
                    page.nextMarker.extend(cp)?;
                    page.nextMarkerIsPrefix = true;
                    // The other keys under this common prefix are rolled up into it: seek past them.
                    cursor = seekPast(index, first.bucket, cp, true)?;
                }
                null => {
                    page.keys.push(copyBytes(key)?)?;
                    let v = index.valueAt(at);
                    page.sizes.push(v.size)?;
                    page.md5s.push(v.md5)?;
                    page.mtimes.push(v.mtimeMillis)?;
                    page.parts.push(v.parts)?;
                    page.classes.push(storageClassIn(v.metadata.view())?)?;
                    page.restores.push(
                        copyBytes(metadataFind(v.metadata.view(), RESTORE_FIELD.bytes()) ?? "".bytes())?,
                    )?;
                    page.nextMarker.clear();
                    page.nextMarker.extend(key)?;
                    page.nextMarkerIsPrefix = false;
                    cursor = index.next(at);
                }
            }
            returned += 1;
        }
        return Ok(page);
    }

    /// One page of the bucket's versions (ADR-0041), as ListObjectVersions asks: at most `max` versions and common
    /// prefixes together. It starts after `keyMarker`: after every version of that key, or, with `versionMarker`,
    /// after that version of it (a key that no longer has the version is passed whole).
    fn listVersions(
        borrow this,
        bucket: StringView,
        prefix: StringView,
        delimiter: StringView,
        keyMarker: Slice<u8>,
        keyMarkerIsPrefix: bool,
        versionMarker: [u8; 16]?,
        max: usize,
    ) -> Result<VersionPage, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let index = borrow this.state.index;
        var page = VersionPage {
            versions: Vector<ListedVersion>.create(),
            commonPrefixes: Vector<Vector<u8>>.create(),
            truncated: false,
            nextKey: Vector<u8>.create(),
            nextVersionId: nullVersionId(),
            nextIsPrefix: false,
        };
        let first = this.state.keyFor(bucket.bytes(), prefix.bytes())?;
        var cursor = index.seek(borrow first);
        // The key whose versions the page resumes in, if a version marker names one.
        var resume: [u8; 16]? = null;
        if (keyMarker.length > 0) {
            if (versionMarker.isSome() && !keyMarkerIsPrefix) {
                resume = versionMarker;
                let from = this.state.keyFor(bucket.bytes(), keyMarker)?;
                cursor = laterOf(index, cursor, index.seek(borrow from));
            } else {
                cursor = laterOf(index, cursor, seekPast(index, first.bucket, keyMarker, keyMarkerIsPrefix)?);
            }
        }
        var returned: usize = 0;
        while (true) {
            let at = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            let entry = index.keyAt(at);
            if (entry.bucket != first.bucket || !startsWithBytes(entry.key.view(), prefix.bytes())) { break; }
            let key = entry.key.view();
            var slot = index.slotAt(at);
            var latest = true;
            // Resuming in the marker's key: pass its versions up to the marker's.
            match (resume) {
                Some(id) => {
                    resume = null;
                    if (key == keyMarker) {
                        while (slot != NO_VERSION_SLOT) {
                            let passed = index.versionAt(slot).versionId == id;
                            slot = index.olderOf(slot);
                            latest = false;
                            if (passed) { break; }
                        }
                        if (slot == NO_VERSION_SLOT) {
                            cursor = index.next(at);
                            continue;
                        }
                    }
                }
                null => {}
            }
            var rolled: usize? = null;
            if (delimiter.length > 0) {
                match (findBytes(key, delimiter.bytes(), prefix.length)) {
                    Some(d) => { rolled = d + delimiter.length; }
                    null => {}
                }
            }
            if (returned == max) {
                page.truncated = true;
                break;
            }
            match (rolled) {
                Some(end) => {
                    let cp = key[0..end];
                    page.commonPrefixes.push(copyBytes(cp)?)?;
                    page.nextKey.clear();
                    page.nextKey.extend(cp)?;
                    page.nextIsPrefix = true;
                    cursor = seekPast(index, first.bucket, cp, true)?;
                    returned += 1;
                }
                null => {
                    while (slot != NO_VERSION_SLOT) {
                        if (returned == max) {
                            page.truncated = true;
                            break;
                        }
                        let v = index.versionAt(slot);
                        page.versions.push(ListedVersion {
                            key: copyBytes(key)?,
                            versionId: v.versionId,
                            latest: latest,
                            deleteMarker: isDeleteMarker(v),
                            size: v.size,
                            mtimeMillis: v.mtimeMillis,
                            md5: v.md5,
                            parts: v.parts,
                            storageClass: storageClassIn(v.metadata.view())?,
                        })?;
                        page.nextKey.clear();
                        page.nextKey.extend(key)?;
                        page.nextVersionId = v.versionId;
                        page.nextIsPrefix = false;
                        returned += 1;
                        latest = false;
                        slot = index.olderOf(slot);
                    }
                    if (page.truncated) { break; }
                    cursor = index.next(at);
                }
            }
        }
        return Ok(page);
    }

    /// Writes a checkpoint of the current state, so recovery replays only what follows it,
    /// and removes the previous checkpoint. Seals the active journal segment first, so the
    /// checkpoint covers whole segments (ADR-0005). Returns whether one was written (false when
    /// nothing was committed since the last one). The steps of ADR-0028 in a row, holding the store throughout; the
    /// server runs them with the lock released between steps (`serve.cee`).
    fn checkpoint(borrow mut this) -> Result<bool, StoreError> {
        var job = match (this.beginCheckpoint()?) {
            Some(j) => j,
            null => { return Ok(false); }
        };
        loop {
            let finished = match (this.checkpointStep(mut job, CHECKPOINT_STEP_ENTRIES)) {
                Ok(f) => f,
                Err(e) => {
                    job.abandon();
                    return Err(e);
                }
            };
            match (job.flush()) {
                Ok() => {}
                Err(e) => {
                    this.checkpointAbandoned(mut job);
                    return Err(e);
                }
            }
            if (finished) { break; }
        }
        match (job.publish()) {
            Ok(size) => { this.checkpointPublished(borrow job, size); }
            Err(e) => {
                this.checkpointAbandoned(mut job);
                return Err(e);
            }
        }
        return Ok(true);
    }

    /// Whether `maintain` would write a checkpoint now: `checkpointEveryBytes` committed since the last one.
    fn checkpointDue(borrow this) -> bool {
        let every = this.config.checkpointEveryBytes;
        return every > 0 && this.sinceCheckpoint >= every;
    }

    /// Starts a checkpoint (ADR-0028): commits what is staged, seals the active segment, and begins the job, with a
    /// snapshot of the index as of the last LSN. Null when nothing was committed since the last checkpoint. A job
    /// that was given up without a word (its task cancelled) is dropped first.
    fn beginCheckpoint(borrow mut this) -> Result<CheckpointJob?, StoreError> {
        if (this.state.index.snapshotActive()) { this.state.index.endSnapshot(); }
        this.commitStaged()?;
        this.checkWritable()?;
        if (this.raft) {
            // A Raft log's checkpoint is of the applied state; entries after it may follow in the same segment, which
            // recovery starts in and skips up to it (ADR-0058 §3).
            let applied = this.appliedIndex();
            if (applied == this.checkpointLsn) { return Ok(null); }
            let segment = this.segmentAfter(applied)?;
            return Ok(
                beginCheckpointJob(
                    this.dir.view(),
                    applied,
                    this.appliedTerm,
                    segment,
                    this.sinceCheckpoint,
                    mut this.state,
                )?,
            );
        }
        let segment = this.journal.sealActive()?;
        let lsn = this.journal.upcomingLsn() - 1;
        if (lsn == this.checkpointLsn) { return Ok(null); }
        return Ok(beginCheckpointJob(this.dir.view(), lsn, 0, segment, this.sinceCheckpoint, mut this.state)?);
    }

    /// Encodes the job's next `max` index entries (memory only). Returns whether it has all of them. On an error the
    /// snapshot ends; the caller abandons the job.
    fn checkpointStep(borrow mut this, job: borrow mut CheckpointJob, max: usize) -> Result<bool, StoreError> {
        let started = Clock.monotonicNanos();
        let stepped = checkpointStepOf(job, mut this.state, max);
        job.noteStep(this.upkeepHeld(started));
        return match (stepped) {
            Ok(f) => Ok(f),
            Err(e) => {
                this.state.index.endSnapshot();
                Err(e)
            }
        };
    }

    /// The job's file is published: segments before its segment may be compacted from now, and older checkpoints go.
    fn checkpointPublished(borrow mut this, job: borrow CheckpointJob, size: u64) {
        this.state.index.endSnapshot();
        this.counts.checkpointBytesWritten += size;
        this.counts.checkpoints += 1;
        this.checkpointLsn = job.lsn;
        this.checkpointSegment = job.segment;
        this.checkpointTerm = job.term;
        // What was committed during the job is not in the checkpoint.
        this.sinceCheckpoint =
            if (this.sinceCheckpoint > job.sinceBefore) this.sinceCheckpoint - job.sinceBefore else 0;
        removeCheckpoints(this.dir.view(), job.lsn, false);
    }

    /// Gives the job up: the snapshot ends, and the temporary file goes.
    fn checkpointAbandoned(borrow mut this, job: borrow mut CheckpointJob) {
        this.state.index.endSnapshot();
        job.abandon();
    }

    /// Reclaims sealed segments that the checkpoint covers and that are mostly garbage. Their
    /// live inline payloads are copied into Relocate records (keeping each version's generation),
    /// and once those are durable the segments are removed. Copies at most `maxCopyBytes` of
    /// live data, but always removes segments with nothing live.
    fn compact(borrow mut this, maxCopyBytes: u64) -> Result<CompactStats, StoreError> {
        // A cluster shard's follower copies nothing: its leader's Relocate entries do (ADR-0058 §2). It removes what
        // its checkpoint covers and holds nothing live.
        if (this.raft && this.term == 0) { return this.removeDeadSegments(); }
        // The steps of ADR-0029 in a row, holding the store throughout; the server releases it between them.
        var job = match (this.beginCompaction(maxCopyBytes)?) {
            Some(j) => j,
            null => { return Ok(CompactStats { segmentsRemoved: 0, bytesFreed: 0, relocated: 0, bytesCopied: 0 }); }
        };
        while (!this.compactionPlanStep(mut job, COMPACTION_PLAN_ENTRIES)?) {}
        while (job.readBatch(COMPACTION_COPY_BYTES)?) { this.compactionCopyStep(mut job)?; }
        return this.finishCompaction(mut job);
    }

    /// Starts a compaction (ADR-0005, in steps by ADR-0029): chooses the covered segments to reclaim, fewest live
    /// bytes first within `maxCopyBytes`, and always the empty ones. Null when none qualifies.
    fn beginCompaction(borrow mut this, maxCopyBytes: u64) -> Result<CompactionJob?, StoreError> {
        let started = Clock.monotonicNanos();
        this.commitStaged()?;
        this.checkWritable()?;
        // Candidates, fewest live bytes first.
        var candidates = Vector<SegmentFile>.create();
        for (i in 0..this.state.segments.length()) {
            let id: u64 = this.state.segments.keyAt(i);
            let u = this.state.segments.valueAt(i);
            if (id >= this.checkpointSegment) { continue; }
            // A coded segment is not copied out of (its file is pieces); it goes when nothing in it is live.
            if (this.segmentIsCoded(id) && u.liveBytes != 0) { continue; }
            if (u.liveBytes == 0 || u.liveBytes * 100 < u.totalBytes * this.config.compactBelowLivePercent) {
                candidates.push(SegmentFile { id: id, size: u.liveBytes })?;
            }
        }
        if (candidates.length == 0) {
            let _ = this.upkeepHeld(started);
            return Ok(null);
        }
        candidates.viewMut().sortBy((a, b) => if (a.size < b.size) -1 else if (a.size > b.size) 1 else 0);
        var chosen = HashMap<u64, String>.create();
        var budget: u64 = 0;
        for (i in 0..candidates.length) {
            let c = borrow candidates[i];
            if (c.size > 0 && budget + c.size > maxCopyBytes && chosen.length() > 0) { break; }
            budget += c.size;
            let path = match (this.journal.segmentFile(c.id)) {
                Ok(p) => p,
                Err(e) => { return Err(StoreError.Journal(e)); }
            };
            let _ = chosen.put(c.id, path)?;
        }
        let _ = this.upkeepHeld(started);
        return Ok(CompactionJob {
            chosen: chosen,
            plan: Vector<Relocation>.create(),
            planned: null,
            next: 0,
            batch: Vector<Vector<u8>>.create(),
            batchStart: 0,
            stats: CompactStats { segmentsRemoved: 0, bytesFreed: 0, relocated: 0, bytesCopied: 0 },
        });
    }

    /// Plans the copies of up to `max` more index entries (memory only): the live inline versions in the chosen
    /// segments. Returns whether the whole index is planned. The index may change between steps; a copy of a version
    /// that is no longer current is garbage when it is applied (ADR-0005 §9).
    fn compactionPlanStep(borrow mut this, job: borrow mut CompactionJob, max: usize) -> Result<bool, StoreError> {
        let started = Clock.monotonicNanos();
        var cursor = match (job.planned.asBorrow()) {
            Some(k) => this.state.index.seekAfter(k),
            null => this.state.index.first(),
        };
        var seen: usize = 0;
        var last: IndexKey? = null;
        while (seen < max) {
            let i = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            cursor = this.state.index.next(i);
            seen += 1;
            let k = this.state.index.keyAt(i);
            if (seen == max) { last = copyIndexKey(k)?; }
            // Every version of the key, current or not: a noncurrent inline version's record is live too.
            var slot = this.state.index.slotAt(i);
            while (slot != NO_VERSION_SLOT) {
                let v = this.state.index.versionAt(slot);
                slot = this.state.index.olderOf(slot);
                if (v.extents.length != 0 || isDeleteMarker(v) || !job.chosen.contains(borrow v.recordSegment)) {
                    continue;
                }
                job.plan.push(Relocation {
                    bucket: copyBytes(this.state.bucketName(k.bucket))?,
                    key: copyBytes(k.key.view())?,
                    versionId: v.versionId,
                    generation: v.lsn,
                    segment: v.recordSegment,
                    recordOffset: v.payload.offset +
                        v.payload.length as u64 + RECORD_TRAILER_LEN as u64 - v.recordLength as u64,
                    recordLength: v.recordLength,
                    payloadLength: v.payload.length,
                })?;
            }
        }
        let finished = cursor.isNull();
        job.planned = last;
        let _ = this.upkeepHeld(started);
        return Ok(finished);
    }

    /// Stages and commits the copies `job.readBatch` read (one batch, about COMPACTION_COPY_BYTES): one journal write
    /// and one sync under the store. What other requests staged is committed first, so a failure here discards only
    /// the copies.
    fn compactionCopyStep(borrow mut this, job: borrow mut CompactionJob) -> Result<void, StoreError> {
        let started = Clock.monotonicNanos();
        this.commitStaged()?;
        for (b in 0..job.batch.length) {
            let r = borrow job.plan[job.batchStart + b];
            match (this.stageRelocationOf(r, job.batch[b].view())) {
                Ok() => {}
                Err(e) => {
                    this.journal.discardPending();
                    this.pendingApplies.clear();
                    let _ = this.upkeepHeld(started);
                    return Err(e);
                }
            }
            job.stats.relocated += 1;
            job.stats.bytesCopied += r.payloadLength as u64;
            this.counts.compactionBytesCopied += r.payloadLength as u64;
        }
        job.batch.clear();
        let committed = this.commitStaged();
        let _ = this.upkeepHeld(started);
        let _ = committed?;
        return Ok();
    }

    /// Removes the chosen segments that hold nothing live now that every copy is durable and applied, unless a reader
    /// pins one (ADR-0024): a later pass removes that one.
    fn finishCompaction(borrow mut this, job: borrow mut CompactionJob) -> Result<CompactStats, StoreError> {
        let started = Clock.monotonicNanos();
        var stats = job.stats;
        for (i in 0..job.chosen.length()) {
            let id: u64 = job.chosen.keyAt(i);
            let usage = this.segmentUsage(id);
            if (usage.liveBytes != 0) { continue; }
            if (this.segmentPins.isPinned(id)) { continue; }
            if (this.segmentIsCoded(id)) {
                this.dropCodedSegment(id)?;
            } else {
                this.journal.removeSegment(id)?;
            }
            let _ = this.state.segments.remove(borrow id);
            stats.segmentsRemoved += 1;
            this.counts.segmentsCompacted += 1;
            stats.bytesFreed += usage.totalBytes;
        }
        if (stats.segmentsRemoved > 0) { this.journal.syncDirectory()?; }
        let _ = this.upkeepHeld(started);
        return Ok(stats);
    }

    /// Removes the segments the checkpoint covers that hold nothing live, unless a reader pins one.
    fn removeDeadSegments(borrow mut this) -> Result<CompactStats, StoreError> {
        var stats = CompactStats { segmentsRemoved: 0, bytesFreed: 0, relocated: 0, bytesCopied: 0 };
        var dead = Vector<u64>.create();
        for (i in 0..this.state.segments.length()) {
            let id: u64 = this.state.segments.keyAt(i);
            if (id < this.checkpointSegment && this.state.segments.valueAt(i).liveBytes == 0) { dead.push(id)?; }
        }
        for (k in 0..dead.length) {
            let id = dead[k];
            if (this.segmentPins.isPinned(id)) { continue; }
            let usage = this.segmentUsage(id);
            if (this.segmentIsCoded(id)) {
                this.dropCodedSegment(id)?;
            } else {
                this.journal.removeSegment(id)?;
            }
            let _ = this.state.segments.remove(borrow id);
            stats.segmentsRemoved += 1;
            this.counts.segmentsCompacted += 1;
            stats.bytesFreed += usage.totalBytes;
        }
        if (stats.segmentsRemoved > 0) { this.journal.syncDirectory()?; }
        return Ok(stats);
    }

    /// The segment that holds entry `lsn + 1`, or the active one when it is not written yet: where a checkpoint at
    /// `lsn` has recovery start (ADR-0058 §3).
    fn segmentAfter(borrow this, lsn: u64) -> Result<u64, StoreError> {
        if (lsn + 1 > this.journal.lastLsn()) { return Ok(this.journal.activeSegment()); }
        return Ok(this.journal.entryAt(lsn + 1)?.segment);
    }

    /// This replica's newest checkpoint as a snapshot for a follower (ADR-0058 §9): the checkpoint file, every
    /// segment before the one recovery starts in, and that one up to the checkpoint's last entry, byte for byte, so
    /// every locator in the checkpoint holds on the follower too. Only inline payloads: a cluster shard has no extents
    /// until item 5.
    fn snapshotBundle(borrow this) -> Result<Vector<u8>, StoreError> {
        let index = this.checkpointLsn;
        if (index == 0) { return Err(StoreError.CheckpointCorrupt); }
        var bundle = Vector<u8>.create();
        bundle.pushLE(SNAPSHOT_MAGIC)?;
        bundle.pushLE(index)?;
        bundle.pushLE(this.checkpointTerm)?;
        let countAt = bundle.length;
        bundle.pushLE(0u32)?;
        var count = 0u32;
        let checkpoint = checkpointPath(this.dir.view(), index, false)?;
        let size = sio(DurableFile.openRead(checkpoint.view()))?.size();
        appendBundleFile(mut bundle, checkpointName(index)?.view(), checkpoint.view(), sio(size)?)?;
        count += 1;
        let start = this.checkpointSegment;
        let ids = listSegmentIds(this.dir.view())?;
        for (k in 0..ids.length) {
            let id = ids[k];
            if (id > start) { continue; }
            var length = this.journal.durableEnd(id)?;
            if (id == start && index + 1 <= this.journal.lastLsn()) {
                let next = this.journal.entryAt(index + 1)?;
                if (next.segment == start) { length = next.offset; }
            }
            let path = this.journal.segmentFile(id)?;
            let name = segmentName(id)?;
            appendBundleFile(mut bundle, name.view(), path.view(), length)?;
            count += 1;
        }
        bundle.viewMut().writeLE(countAt, count);
        return Ok(bundle);
    }

    /// The newest checkpoint: its index, the term of its entry, and the segment recovery starts in.
    fn checkpointIndex(borrow this) -> u64 => this.checkpointLsn;

    fn checkpointEntryTerm(borrow this) -> u64 => this.checkpointTerm;

    fn checkpointStart(borrow this) -> u64 => this.checkpointSegment;

    /// The verified record that holds an inline version's payload.
    fn readLiveRecord(borrow this, v: borrow ObjectVersion) -> Result<Vector<u8>, StoreError> {
        if (v.extents.length == 0 && this.wantsDecode(v)) { return Err(StoreError.ExtentWanted); }
        let offset = v.payload.offset + v.payload.length as u64 + RECORD_TRAILER_LEN as u64 - v.recordLength as u64;
        return match (this.journal.readRecord(v.recordSegment, offset, v.recordLength)) {
            Ok(bytes) => Ok(bytes),
            Err(JournalError.Corrupt(_, _)) => Err(StoreError.DataCorrupt),
            Err(e) => Err(StoreError.Journal(e)),
        };
    }

    /// Reads and verifies one live record, then stages its Relocate copy.
    /// Stages the Relocate copy of `r` from its verified record (`record`, read by `CompactionJob.readBatch`).
    fn stageRelocationOf(borrow mut this, r: borrow Relocation, record: Slice<u8>) -> Result<void, StoreError> {
        let end = r.recordLength as usize - RECORD_TRAILER_LEN;
        let payload = record[end - r.payloadLength as usize..end];
        var meta = Vector<u8>.create();
        encodeRelocateMeta(mut meta, r.bucket.view(), r.key.view(), r.versionId, r.generation)?;
        if (this.journal.wouldOverflow(meta.length, payload.length) || this.journal.needsRotation()) {
            this.commitStaged()?;
        }
        this.pendingApplies.reserve(1)?;
        let pos = this.stageRecord(RecordType.Relocate, meta.view(), payload)?;
        this.pendingApplies.push(PendingApply {
            kind: RecordType.Relocate,
            lsn: pos.lsn,
            segment: pos.segmentId,
            offset: pos.offset,
            total: truncate<u32>(recordLength(meta.length, payload.length)),
            meta: meta,
            payloadLen: truncate<u32>(payload.length),
            manifest: Vector<u8>.create(),
        })?;
        return Ok();
    }

    /// Background upkeep: a checkpoint when one is due, then compaction.
    fn maintain(borrow mut this) -> Result<MaintenanceReport, StoreError> => this.upkeep(true);

    /// The compaction budget `maintain` uses.
    fn compactionBudget(borrow this) -> u64 => this.config.compactMaxCopyBytes;

    /// `maintain`, with or without its checkpoint and compaction: the server runs those in steps of its own, with the
    /// store's lock released between them (ADR-0028, ADR-0029).
    fn upkeep(borrow mut this, withSteps: bool) -> Result<MaintenanceReport, StoreError> {
        let started = Clock.monotonicNanos();
        this.measureVolume();
        this.reapDeferred();
        this.reapAbandoned();
        this.pins.prune();
        this.segmentPins.prune();
        var expired: u64 = 0;
        let expiry = this.config.uploadExpiryMillis;
        let now = Clock.unixMillis();
        if (expiry > 0 && now > truncate<i64>(expiry)) { expired = this.expireUploads(now - truncate<i64>(expiry))?; }
        let reaped = Clock.monotonicNanos();
        var checkpointed = false;
        if (withSteps && this.checkpointDue()) { checkpointed = this.checkpoint()?; }
        let checkpointDone = Clock.monotonicNanos();
        var compaction = CompactStats { segmentsRemoved: 0, bytesFreed: 0, relocated: 0, bytesCopied: 0 };
        if (withSteps) { compaction = this.compact(this.config.compactMaxCopyBytes)?; }
        let compacted = Clock.monotonicNanos();
        var lifecycle = LifecycleReport {
            objectsExpired: 0,
            uploadsAborted: 0,
            versionsExpired: 0,
            markersRemoved: 0,
            transitioned: 0,
        };
        let lifecycleEvery = this.config.lifecycleEveryMillis;
        if (lifecycleEvery > 0 && now - this.lifecycleRan >= truncate<i64>(lifecycleEvery)) {
            lifecycle = this.applyLifecycle(now)?;
            this.lifecycleRan = now;
        }
        // Restores' times (ADR-0106 §4): on `serve` here; a shard's leader runs them itself, as a write.
        // A round that fails is tried at the next upkeep; it does not stop this one (the M20 exit review).
        if (!this.raft) { let _ = this.restoreRound(now); }
        // Sealed counts not known (out of memory, ADR-0106 §2): made again, so a key removal is decided again.
        let _ = this.recountSealed();
        let total = this.upkeepHeld(started);
        let ended = Clock.monotonicNanos();
        return Ok(MaintenanceReport {
            checkpointed: checkpointed,
            compaction: compaction,
            uploadsExpired: expired,
            lifecycle: lifecycle,
            reapMicros: (reaped - started) / 1000,
            checkpointMicros: (checkpointDone - reaped) / 1000,
            compactionMicros: (compacted - checkpointDone) / 1000,
            lifecycleMicros: (ended - compacted) / 1000,
            totalMicros: total,
        });
    }

    /// An upkeep step that has held the store since `started` (`Clock.monotonicNanos`) is done: it is counted, and
    /// its time is returned in microseconds (ADR-0029).
    fn upkeepHeld(borrow mut this, started: u64) -> u64 {
        let micros = (Clock.monotonicNanos() - started) / 1000;
        this.counts.upkeepHolds += 1;
        if (micros >= UPKEEP_SLOW_MICROS) { this.counts.upkeepSlowHolds += 1; }
        if (micros > this.counts.upkeepLongestMicros) { this.counts.upkeepLongestMicros = micros; }
        return micros;
    }

    // ---- Bucket configuration (ADR-0020) ----

    /// Sets a bucket's tags (kind BUCKET_CONFIG_TAGS) or lifecycle rules (BUCKET_CONFIG_LIFECYCLE); an empty value
    /// clears it. One BucketConfig record, durable before this returns.
    fn setBucketConfig(borrow mut this, bucket: StringView, kind: u8, value: Slice<u8>) -> Result<void, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        // A bucket its request made is configured as it is made (ADR-0128 §1, the M31 exit review: S3's CreateBucket
        // with an ACL or object lock).
        if (!this.bucketForWrite(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        if (value.length > 1048576) { return Err(StoreError.MetadataTooLarge); }
        if (kind == BUCKET_CONFIG_VERSIONING && !isVersioningValue(value)) { return Err(StoreError.InvalidKey); }
        if (kind == BUCKET_CONFIG_POLICY && value.length > MAX_STORED_POLICY_BYTES) {
            return Err(StoreError.MetadataTooLarge);
        }
        if (kind == BUCKET_CONFIG_PUBLIC_ACCESS && !isPublicAccessValue(value)) { return Err(StoreError.InvalidKey); }
        if (kind == BUCKET_CONFIG_ACL && !isAclValue(value)) { return Err(StoreError.InvalidKey); }
        if (kind == BUCKET_CONFIG_NOTIFICATION &&
            (value.length > MAX_NOTIFICATION_BYTES || decodeNotification(value).isErr())) {
            return Err(StoreError.InvalidKey);
        }
        if (kind == BUCKET_CONFIG_CORS && (value.length > MAX_CORS_BYTES || decodeCors(value).isErr())) {
            return Err(StoreError.InvalidKey);
        }
        if (kind == BUCKET_CONFIG_QUOTA && !isQuotaValue(value)) { return Err(StoreError.InvalidKey); }
        if (kind == BUCKET_CONFIG_ENCRYPTION && !isEncryptionValue(value)) { return Err(StoreError.InvalidKey); }
        if (kind == BUCKET_CONFIG_LOGGING && !isLoggingValue(value)) { return Err(StoreError.InvalidKey); }
        if (kind == BUCKET_CONFIG_WEBSITE && !isWebsiteValue(value)) { return Err(StoreError.InvalidKey); }
        if (kind == BUCKET_CONFIG_INVENTORY && !isInventoryValue(value)) { return Err(StoreError.InvalidKey); }
        if (kind == BUCKET_CONFIG_ACCESS_POINTS && !isAccessPointsValue(value)) { return Err(StoreError.InvalidKey); }
        if (kind == BUCKET_CONFIG_REPLICATION && !isReplicationValue(value)) { return Err(StoreError.InvalidKey); }
        if (kind == BUCKET_CONFIG_REPLICATION_FAILURES && !isFailuresValue(value)) {
            return Err(StoreError.InvalidKey);
        }
        if (kind < BUCKET_CONFIG_TAGS || kind > BUCKET_CONFIG_REPLICATION_FAILURES) {
            return Err(StoreError.InvalidKey);
        }
        // Object lock needs versioning enabled, keeps it so, and is never taken off a bucket (ADR-0047 §1).
        let locks = this.lockConfigOf(bucket.bytes())?.length > 0;
        if (kind == BUCKET_CONFIG_OBJECT_LOCK) {
            if (value.length == 0) { return Err(if (locks) StoreError.InvalidBucketState else StoreError.InvalidKey); }
            if (decodeLockConfig(value).isNull()) { return Err(StoreError.InvalidKey); }
            if (this.versioningOf(bucket.bytes())? != VERSIONING_ENABLED) { return Err(StoreError.InvalidBucketState); }
        }
        if (kind == BUCKET_CONFIG_VERSIONING && locks && value[0] != VERSIONING_ENABLED) {
            return Err(StoreError.InvalidBucketState);
        }
        this.scratch.clear();
        encodeBucketConfigMeta(mut this.scratch, bucket.bytes(), kind, value)?;
        let empty = [0u8; 1];
        this.commitOne(RecordType.BucketConfig, empty[0..0])?;
        if (kind == BUCKET_CONFIG_VERSIONING) {
            for (i in 0..this.stagedBuckets.length) {
                if (this.stagedBuckets[i].name.view() == bucket.bytes()) {
                    this.stagedBuckets[i].versioning = value[0];
                }
            }
        }
        return Ok();
    }

    /// A bucket's tags, lifecycle rules, policy or public-access block, as stored, or its versioning state as one
    /// byte; empty for none.
    fn bucketConfig(borrow this, bucket: StringView, kind: u8) -> Result<Vector<u8>, StoreError> {
        let k = BucketKey { name: copyBytes(bucket.bytes())? };
        return match (this.state.buckets.get(borrow k)) {
            Some(b) => {
                if (kind == BUCKET_CONFIG_VERSIONING) {
                    var state = Vector<u8>.create();
                    if (b.versioning != VERSIONING_OFF) { state.push(b.versioning)?; }
                    return Ok(state);
                }
                if (kind == BUCKET_CONFIG_POLICY) { return Ok(copyBytes(b.policy.view())?); }
                if (kind == BUCKET_CONFIG_PUBLIC_ACCESS) { return Ok(copyBytes(b.publicAccess.view())?); }
                if (kind == BUCKET_CONFIG_ACL) { return Ok(copyBytes(b.acl.view())?); }
                if (kind == BUCKET_CONFIG_OBJECT_LOCK) { return Ok(copyBytes(b.objectLock.view())?); }
                if (kind == BUCKET_CONFIG_NOTIFICATION) { return Ok(copyBytes(b.notification.view())?); }
                if (kind == BUCKET_CONFIG_CORS) { return Ok(copyBytes(b.cors.view())?); }
                if (kind == BUCKET_CONFIG_QUOTA) { return Ok(copyBytes(b.quota.view())?); }
                if (kind == BUCKET_CONFIG_ENCRYPTION) { return Ok(copyBytes(b.encryption.view())?); }
                if (kind == BUCKET_CONFIG_LOGGING) { return Ok(copyBytes(b.logging.view())?); }
                if (kind == BUCKET_CONFIG_WEBSITE) { return Ok(copyBytes(b.website.view())?); }
                if (kind == BUCKET_CONFIG_INVENTORY) { return Ok(copyBytes(b.inventory.view())?); }
                if (kind == BUCKET_CONFIG_ACCESS_POINTS) { return Ok(copyBytes(b.accessPoints.view())?); }
                if (kind == BUCKET_CONFIG_REPLICATION) { return Ok(copyBytes(b.replication.view())?); }
                if (kind == BUCKET_CONFIG_REPLICATION_FAILURES) { return Ok(copyBytes(b.replicationFailures.view())?); }
                Ok(copyBytes(if (kind == BUCKET_CONFIG_TAGS) b.tags.view() else b.lifecycle.view())?)
            }
            null => Err(StoreError.NoSuchBucket),
        };
    }

    /// Every bucket's policy (ADR-0043): the names of the buckets that have one, and the documents, in no order.
    fn bucketPolicies(borrow this) -> Result<BucketPolicies, StoreError> {
        var out = BucketPolicies { names: Vector<Vector<u8>>.create(), documents: Vector<Vector<u8>>.create() };
        for (i in 0..this.state.buckets.length()) {
            let b = this.state.buckets.valueAt(i);
            if (b.policy.length == 0) { continue; }
            out.names.push(copyBytes(this.state.buckets.keyAt(i).name.view())?)?;
            out.documents.push(copyBytes(b.policy.view())?)?;
        }
        return Ok(out);
    }

    /// Applies every bucket's lifecycle rules as of `nowMillis`: deletes the objects a rule has expired (one batch per
    /// bucket, as DeleteObjects does) and aborts the uploads a rule's AbortIncompleteMultipartUpload has. In a bucket
    /// with versioning (ADR-0042) an expired current object gets a delete marker, noncurrent versions are removed
    /// by their rule, and so is a delete marker left as its key's only version. About LIFECYCLE_BATCH deletes per
    /// bucket and run, so the store's lock is never held long; the rest wait for the next.
    /// The storage class a replica to `destination` gets from the source bucket's rules that an event names (the M12
    /// exit review's B3); empty for the source's own.
    fn replicaClassOf(
        borrow this,
        source: StringView,
        ruleIds: Slice<Vector<u8>>,
        destination: Slice<u8>,
    ) -> Result<Vector<u8>, StoreError> {
        let blob = this.bucketConfig(source, BUCKET_CONFIG_REPLICATION)?;
        let rules = match (decodeReplication(blob.view())) {
            Ok(r) => r,
            Err(_) => { return Ok(Vector<u8>.create()); }
        };
        return Ok(copyBytes(replicaClassFor(rules.view(), ruleIds, destination))?);
    }

    /// Up to `max` keys after `after` (from the first when null): their versions sealed by SSE-S3 under a master key
    /// other than the one `keep` names (`v1.s3.<id>.`), to re-wrap under it (ADR-0100 §3).
    fn rewrapStep(
        borrow this,
        keep: Slice<u8>,
        after: borrow (IndexKey?),
        max: usize,
    ) -> Result<RewrapPage, StoreError> {
        var page = RewrapPage { items: Vector<RewrapItem>.create(), next: null };
        var cursor = match (after.asBorrow()) {
            Some(k) => this.state.index.seekAfter(k),
            null => this.state.index.first(),
        };
        var seen = 0usize;
        while (seen < max) {
            let i = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            cursor = this.state.index.next(i);
            seen += 1;
            let k = this.state.index.keyAt(i);
            if (seen == max && cursor.isSome()) { page.next = copyIndexKey(k)?; }
            var slot = this.state.index.slotAt(i);
            while (slot != NO_VERSION_SLOT) {
                let v = this.state.index.versionAt(slot);
                match (metadataFind(v.metadata.view(), SSE_FIELD.bytes())) {
                    Some(e) => {
                        if (startsWithBytes(e, "v1.s3.".bytes()) && !startsWithBytes(e, keep)) {
                            page.items.push(RewrapItem {
                                bucket: copyBytes(this.state.bucketName(k.bucket))?,
                                key: copyBytes(k.key.view())?,
                                versionId: v.versionId,
                                envelope: copyBytes(e)?,
                            })?;
                        }
                    }
                    null => {}
                }
                slot = this.state.index.olderOf(slot);
            }
        }
        return Ok(page);
    }

    /// A re-wrap's record staged (ADR-0100 §2): the version's envelope set to `envelope`, if it is still `from` (the
    /// envelope it was read with, so a version changed since is left). False when it was not staged. The pass commits
    /// a batch together.
    fn stageRewrap(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        from: Slice<u8>,
        envelope: Slice<u8>,
    ) -> Result<bool, StoreError> {
        if (!isRewrapValue(envelope)) { return Err(StoreError.InvalidKey); }
        if (!this.state.hasBucket(bucket.bytes())?) { return Ok(false); }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        let current = match (this.state.index.find(borrow k, id)) {
            Some(v) => match (metadataFind(v.metadata.view(), SSE_FIELD.bytes())) {
                Some(e) => e == from,
                null => false,
            },
            null => false,
        };
        if (!current) { return Ok(false); }
        this.stageFieldOf(bucket, key, Some(id), envelope, SET_ENVELOPE_FORMAT)?;
        return Ok(true);
    }

    /// How many versions, and uploads in progress, have a metadata field `field` whose value starts with `prefix`: the
    /// versions sealed under a master key, for a reload that would remove it (ADR-0096 §3). From memory, under the
    /// store's lock; it reads no object. Staged writes are committed first, so they are counted (the M15 exit
    /// review).
    fn countFieldPrefix(borrow mut this, field: Slice<u8>, prefix: Slice<u8>) -> Result<u64, StoreError> {
        this.commitStaged()?;
        var n: u64 = 0;
        // The versions' envelopes are counted by the index as it changes (ADR-0100 §1): no walk, unless its counts are
        // not known. Uploads in progress are few, and walked.
        let counted: u64? = if (field == SSE_FIELD.bytes()) this.state.index.sealedUnder(prefix) else null;
        match (counted) {
            Some(c) => { return Ok(c + this.uploadsWithPrefix(field, prefix)); }
            null => {}
        }
        var cursor = this.state.index.first();
        while (true) {
            let i = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            cursor = this.state.index.next(i);
            var slot = this.state.index.slotAt(i);
            while (slot != NO_VERSION_SLOT) {
                let v = this.state.index.versionAt(slot);
                match (metadataFind(v.metadata.view(), field)) {
                    Some(value) => {
                        if (startsWithBytes(value, prefix)) { n += 1; }
                    }
                    null => {}
                }
                slot = this.state.index.olderOf(slot);
            }
        }
        return Ok(n + this.uploadsWithPrefix(field, prefix));
    }

    /// Whether this store's writes apply when Raft commits them (a cluster's replica), not when they are made: a bucket
    /// made in a request is then not seen by a later write of the same request.
    fn appliesOnCommit(borrow this) -> bool => this.raft;

    /// How many versions and uploads in progress are sealed under envelopes of `prefix` (`v1.<mode>.<id>.`), for the
    /// stats (ADR-0100 §3): from the index's counts, staged writes not yet in them; null when they are not known.
    fn sealedCount(borrow this, prefix: Slice<u8>) -> u64? {
        let versions = this.state.index.sealedUnder(prefix) ?? { return null; };
        return Some(versions + this.uploadsWithPrefix(SSE_FIELD.bytes(), prefix));
    }

    /// What still needs each master key (ADR-0100 §4), for a cluster's count: `<prefix> <n>` lines, a prefix per key
    /// that has versions or uploads (`v1.<mode>.<id>.`), and `kms-default <id> <n>` for buckets whose default names a
    /// KMS key. Null when the counts are not known.
    fn sealedReport(borrow this) -> Result<Vector<u8>?, StoreError> {
        let counts = this.state.index.sealedCounts() ?? { return Ok(null); };
        var prefixes = Vector<Vector<u8>>.create();
        for (i in 0..counts.length) { prefixes.push(copyBytes(counts[i].prefix.view())?)?; }
        // The uploads' prefixes too, which the index does not count.
        for (u in 0..this.state.uploads.length()) {
            match (metadataFind(this.state.uploads.valueAt(u).metadata.view(), SSE_FIELD.bytes())) {
                Some(e) => {
                    var dots = 0;
                    var end = e.length;
                    for (i in 0..e.length) {
                        if (e[i] == '.') {
                            dots += 1;
                            if (dots == 3) {
                                end = i + 1;
                                break;
                            }
                        }
                    }
                    var known = false;
                    for (p in 0..prefixes.length) {
                        if (prefixes[p].view() == e[0..end]) { known = true; }
                    }
                    if (!known) { prefixes.push(copyBytes(e[0..end])?)?; }
                }
                null => {}
            }
        }
        var out = Vector<u8>.create();
        for (p in 0..prefixes.length) {
            let n = this.sealedCount(prefixes[p].view()) ?? { return Ok(null); };
            out.extend(prefixes[p].view())?;
            out.push(' ')?;
            appendDecimal(mut out, n)?;
            out.push(0x0A)?;
        }
        let buckets = this.listBuckets()?;
        for (b in 0..buckets.length) {
            let config = this.bucketConfig(StringView.fromUtf8(buckets[b].view()) ?? "", BUCKET_CONFIG_ENCRYPTION)?;
            if (startsWithBytes(config.view(), "aws:kms ".bytes())) {
                out.extend("kms-default ".bytes())?;
                out.extend(config.view()[8..])?;
                out.extend(" 1\n".bytes())?;
            }
        }
        return Ok(Some(out));
    }

    /// How many uploads in progress have the field `field` starting with `prefix`.
    private fn uploadsWithPrefix(borrow this, field: Slice<u8>, prefix: Slice<u8>) -> u64 {
        var n: u64 = 0;
        for (u in 0..this.state.uploads.length()) {
            match (metadataFind(this.state.uploads.valueAt(u).metadata.view(), field)) {
                Some(value) => {
                    if (startsWithBytes(value, prefix)) { n += 1; }
                }
                null => {}
            }
        }
        return n;
    }

    /// The sealed counts made again if they are not known (ADR-0106 §2): true when they are known. From memory, under
    /// the store's lock, as a removal's count is.
    fn recountSealed(borrow mut this) -> bool => this.state.index.recountSealed();

    /// Whether a watched restore has a change due at `nowMillis` (ADR-0106 §4): its copy ready, or expired, and not
    /// yet said; or an entry to drop. A shard's leader asks before it opens a write for `restoreRound`.
    fn restoreDue(borrow this, nowMillis: i64) -> bool {
        let watches = this.state.index.restoreWatches();
        for (i in 0..watches.length) {
            let w = borrow watches[i];
            let v = this.state.index.find(borrow w.key, w.versionId) ?? { return true; };
            let value = metadataFind(v.metadata.view(), RESTORE_FIELD.bytes()) ?? { return true; };
            let parts = restorePartsOf(value) ?? { return true; };
            if (parts.sent == RESTORE_SENT_EXPIRED) { return true; }
            if (parts.sent == RESTORE_SENT_NONE && nowMillis >= parts.readyMs) { return true; }
            if (parts.sent == RESTORE_SENT_DONE && nowMillis >= parts.expiryMs) { return true; }
        }
        return false;
    }

    /// The watches done with dropped, writing nothing: a version gone, its state done with or not readable, its class
    /// moved. A shard's followers run it, as only the leader runs `restoreRound` (the M20 exit review).
    fn pruneRestoreWatches(borrow mut this) {
        var at = this.state.index.restoreWatches().length;
        while (at > 0) {
            at -= 1;
            var done = true;
            {
                let watches = this.state.index.restoreWatches();
                let w = borrow watches[at];
                match (this.state.index.find(borrow w.key, w.versionId)) {
                    Some(v) => {
                        let stored = metadataFind(v.metadata.view(), STORAGE_CLASS_FIELD.bytes()) ?? "".bytes();
                        let value = metadataFind(v.metadata.view(), RESTORE_FIELD.bytes()) ?? "".bytes();
                        match (restorePartsOf(value)) {
                            Some(p) => {
                                let made = if (p.classAt < p.classEnd) value[p.classAt..p.classEnd] else stored;
                                done = made != stored || p.sent == RESTORE_SENT_EXPIRED;
                            }
                            null => {}
                        }
                    }
                    null => {}
                }
            }
            if (done) { this.state.index.unwatchRestore(at); }
        }
    }

    /// The watched restores whose times have come, marked (ADR-0106 §4): a copy ready gets ` c`, which raises
    /// s3:ObjectRestore:Completed as it applies; one expired after that gets ` d`, which raises :Delete. One step a
    /// version a round. Entries whose version is gone, whose state is done with, or whose class has moved are
    /// dropped. The number of marks written.
    fn restoreRound(borrow mut this, nowMillis: i64) -> Result<u64, StoreError> {
        // Watches lost to out of memory: found again from the index's versions.
        if (this.state.index.takeRestoreLoss()) {
            var keys = Vector<IndexKey>.create();
            var ids = Vector<[u8; 16]>.create();
            this.state.index.everyVersionWith(RESTORE_FIELD.bytes(), mut keys, mut ids)?;
            for (i in 0..keys.length) { this.state.index.watchRestoreOf(borrow keys[i], ids[i]); }
        }
        var buckets = Vector<Vector<u8>>.create();
        var names = Vector<Vector<u8>>.create();
        var versions = Vector<[u8; 16]>.create();
        var values = Vector<Vector<u8>>.create();
        var at = this.state.index.restoreWatches().length;
        while (at > 0) {
            at -= 1;
            var gone = false;
            var next = Vector<u8>.create();
            {
                let watches = this.state.index.restoreWatches();
                let w = borrow watches[at];
                let bucket = this.state.bucketName(w.key.bucket);
                match (this.state.index.find(borrow w.key, w.versionId)) {
                    Some(v) => {
                        let stored = metadataFind(v.metadata.view(), STORAGE_CLASS_FIELD.bytes()) ?? "".bytes();
                        let value = metadataFind(v.metadata.view(), RESTORE_FIELD.bytes()) ?? "".bytes();
                        match (restorePartsOf(value)) {
                            Some(p) => {
                                let made = if (p.classAt < p.classEnd) value[p.classAt..p.classEnd] else stored;
                                let archived = stored == "GLACIER".bytes() || stored == "DEEP_ARCHIVE".bytes();
                                if (bucket.length == 0 || !archived || made != stored ||
                                    p.sent == RESTORE_SENT_EXPIRED) {
                                    gone = true;
                                } else {
                                    let mark: Slice<u8>? =
                                        if (p.sent == RESTORE_SENT_NONE && nowMillis >= p.readyMs) Some(
                                            " c".bytes(),
                                        )
                                            else if (p.sent == RESTORE_SENT_DONE && nowMillis >= p.expiryMs) Some(
                                                " d".bytes(),
                                            )
                                            else null;
                                    match (mark) {
                                        Some(m) => {
                                            appendDecimal(mut next, truncate<u64>(p.readyMs))?;
                                            next.push(' ')?;
                                            appendDecimal(mut next, truncate<u64>(p.expiryMs))?;
                                            next.push(' ')?;
                                            next.extend(stored)?;
                                            next.extend(m)?;
                                            buckets.push(copyBytes(bucket)?)?;
                                            names.push(copyBytes(w.key.key.view())?)?;
                                            versions.push(w.versionId)?;
                                        }
                                        null => {}
                                    }
                                }
                            }
                            null => { gone = true; }
                        }
                    }
                    null => { gone = true; }
                }
            }
            if (gone) {
                this.state.index.unwatchRestore(at);
            } else if (next.length > 0) {
                values.push(next)?;
            }
        }
        var staged: u64 = 0;
        for (i in 0..values.length) {
            let b = StringView.fromUtf8(buckets[i].view()) ?? "";
            let k = StringView.fromUtf8(names[i].view()) ?? "";
            match (this.stageFieldOf(b, k, Some(versions[i]), values[i].view(), SET_RESTORE_FORMAT)) {
                Ok() => { staged += 1; }
                Err(StoreError.MetadataTooLarge) => {
                    // No room for its mark (the M20 exit review): this version's later events are not raised, and the
                    // others' still are.
                    match (this.state.indexKey(buckets[i].view(), names[i].view())?) {
                        Some(key) => { this.state.index.unwatchRestoreOf(borrow key, versions[i]); }
                        null => {}
                    }
                }
                Err(e) => { return Err(e); }
            }
        }
        if (staged > 0) { this.commitStaged()?; }
        return Ok(staged);
    }

    /// Whether the lifecycle rules are due at `nowMillis`, by the store's interval (a shard's leader runs them itself,
    /// as a write: the M12 exit review's A3).
    fn lifecycleDue(borrow this, nowMillis: i64) -> bool {
        let every = this.config.lifecycleEveryMillis;
        return every > 0 && nowMillis - this.lifecycleRan >= truncate<i64>(every);
    }

    /// The lifecycle rules applied, and the time noted for `lifecycleDue`.
    fn applyLifecycleNoted(borrow mut this, nowMillis: i64) -> Result<LifecycleReport, StoreError> {
        let report = this.applyLifecycle(nowMillis)?;
        this.lifecycleRan = nowMillis;
        return Ok(report);
    }

    fn applyLifecycle(borrow mut this, nowMillis: i64) -> Result<LifecycleReport, StoreError> {
        var report = LifecycleReport {
            objectsExpired: 0,
            uploadsAborted: 0,
            versionsExpired: 0,
            markersRemoved: 0,
            transitioned: 0,
        };
        var names = Vector<Vector<u8>>.create();
        for (i in 0..this.state.buckets.length()) {
            if (this.state.buckets.valueAt(i).lifecycle.length > 0) {
                names.push(copyBytes(this.state.buckets.keyAt(i).name.view())?)?;
            }
        }
        for (n in 0..names.length) {
            let bucketName = names[n].view();
            let k = BucketKey { name: copyBytes(bucketName)? };
            let blob = match (this.state.buckets.get(borrow k)) {
                Some(b) => copyBytes(b.lifecycle.view())?,
                null => { continue; }
            };
            let rules = match (decodeLifecycle(blob.view())) {
                Ok(r) => r,
                Err(_) => { return Err(StoreError.DataCorrupt); }
            };
            let cut = lifecycleCutoffs(rules.view(), nowMillis);
            // What the rules delete: a key (its current object) or one version of it, by id (ADR-0042 §3).
            var targets = Vector<DeleteTarget>.create();
            var moves = Vector<ClassMove>.create();
            var transitions = false;
            for (r in rules.view()) {
                if (r.enabled && (r.transitions.length > 0 || r.noncurrentTransitions.length > 0)) {
                    transitions = true;
                }
            }
            var objects: u64 = 0;
            var versions: u64 = 0;
            var markers: u64 = 0;
            // With versioning suspended, the marker over an expired object has the null id and replaces the key's
            // null version when it is applied (ADR-0041 §2).
            let suspended = match (this.state.buckets.get(borrow k)) {
                Some(b) => b.versioning == VERSIONING_SUSPENDED,
                null => false,
            };
            // The bucket's keys are one run of the index: from its first key to the next bucket's.
            let start = this.state.keyFor(bucketName, "".bytes())?;
            var cursor = this.state.index.seek(borrow start);
            while (true) {
                let i = match (cursor) {
                    Some(c) => c,
                    null => { break; }
                };
                cursor = this.state.index.next(i);
                if (targets.length + moves.length >= LIFECYCLE_BATCH) { break; }
                let key = this.state.index.keyAt(i);
                if (key.bucket != start.bucket) { break; }
                let name = key.key.view();
                let headSlot = this.state.index.slotAt(i);
                let head = this.state.index.versionAt(headSlot);
                var slot = this.state.index.olderOf(headSlot);
                var nullReplaced = false;
                if (!isDeleteMarker(head)) {
                    // The current object: deleted, or put under a delete marker, by a DELETE without a version id.
                    if (head.mtimeMillis <= cut.current &&
                        lifecycleTakes(rules.view(), name, head, false, 0, head.mtimeMillis, nowMillis)) {
                        targets.push(DeleteTarget { key: copyBytes(name)?, versionId: null, bypassGovernance: false })?;
                        objects += 1;
                        nullReplaced = suspended;
                    } else if (transitions) {
                        // Not expired: perhaps moved to another class (ADR-0090 §2).
                        let to = transitionTarget(rules.view(), name, head, false, 0, head.mtimeMillis, nowMillis)?;
                        if (to.length > 0) {
                            moves.push(
                                ClassMove { key: copyBytes(name)?, versionId: head.versionId, storageClass: to },
                            )?;
                        }
                    }
                } else if (slot == NO_VERSION_SLOT) {
                    // A delete marker that is all its key has.
                    if ((cut.markers || head.mtimeMillis <= cut.current) &&
                        lifecycleTakesLoneMarker(rules.view(), name, head.mtimeMillis, nowMillis)) {
                        targets.push(DeleteTarget {
                            key: copyBytes(name)?,
                            versionId: head.versionId,
                            bypassGovernance: false,
                        })?;
                        markers += 1;
                    }
                }
                // The noncurrent versions: each became noncurrent when the next newer one was written.
                var since = head.mtimeMillis;
                var newer: u32 = 0;
                while (slot != NO_VERSION_SLOT) {
                    let v = this.state.index.versionAt(slot);
                    // Not the null version this run's null marker replaces: a delete of the null id after that
                    // marker in the batch would remove the marker.
                    let replaced = nullReplaced && isNullVersionId(v.versionId);
                    // A version under retention or a legal hold stays until that ends (ADR-0047 §4).
                    let held = lockHolds(lockOfMetadata(v.metadata.view()), nowMillis, false);
                    if (!replaced && !held && since <= cut.noncurrent &&
                        lifecycleTakes(rules.view(), name, v, true, newer, since, nowMillis)) {
                        targets.push(DeleteTarget {
                            key: copyBytes(name)?,
                            versionId: v.versionId,
                            bypassGovernance: false,
                        })?;
                        versions += 1;
                    } else if (transitions && !replaced) {
                        let to = transitionTarget(rules.view(), name, v, true, newer, since, nowMillis)?;
                        if (to.length > 0) {
                            moves.push(ClassMove { key: copyBytes(name)?, versionId: v.versionId, storageClass: to })?;
                        }
                    }
                    since = v.mtimeMillis;
                    newer += 1;
                    slot = this.state.index.olderOf(slot);
                }
            }
            if (targets.length > 0) {
                let _ = this.deleteManyAt(bucketName, targets.view(), nowMillis)?;
                report.objectsExpired += objects;
                report.versionsExpired += versions;
                report.markersRemoved += markers;
            }
            // The transitions: each one SetTags record of the class format, staged, and all synced with one commit
            // (the M12 exit review's A4). A version a delete of this run took, or one without room for the field, is
            // skipped: one version never stops the run for every bucket (A1).
            let bucketText = StringView.fromUtf8(bucketName) ?? "";
            var staged: u64 = 0;
            for (m in 0..moves.length) {
                let keyText = StringView.fromUtf8(moves[m].key.view()) ?? { continue; };
                match (this.stageFieldOf(
                    bucketText,
                    keyText,
                    Some(moves[m].versionId),
                    moves[m].storageClass.view(),
                    SET_CLASS_FORMAT,
                )) {
                    Ok() => { staged += 1; }
                    Err(StoreError.NoSuchVersion) | Err(StoreError.NoSuchKey) | Err(StoreError.MethodNotAllowed) | Err(StoreError.MetadataTooLarge) => {}
                    Err(e) => { return Err(e); }
                }
            }
            if (staged > 0) {
                this.commitStaged()?;
                report.transitioned += staged;
            }
            // Uploads that some rule aborts.
            var old = Vector<[u8; 16]>.create();
            for (i in 0..this.state.uploads.length()) {
                let u = this.state.uploads.valueAt(i);
                if (u.bucket.view() != bucketName) { continue; }
                for (r in 0..rules.length) {
                    let rule = borrow rules[r];
                    if (!rule.enabled || rule.abortDays == 0 || !startsWithBytes(u.key.view(), rule.prefix.view())) {
                        continue;
                    }
                    if (nowMillis >= u.initiatedMillis + (rule.abortDays as i64) * DAY_MILLIS) {
                        old.push(this.state.uploads.keyAt(i).id)?;
                        break;
                    }
                }
            }
            for (id in old.view()) {
                this.checkWritable()?;
                this.scratch.clear();
                encodeUploadAbortMeta(mut this.scratch, id, nowMillis)?;
                let empty = [0u8; 1];
                this.commitOne(RecordType.UploadAbort, empty[0..0])?;
                report.uploadsAborted += 1;
            }
        }
        return Ok(report);
    }

    /// Aborts every upload initiated before `cutoffMillis` (Unix milliseconds), each with its own UploadAbort record,
    /// as AbortMultipartUpload would; returns how many.
    fn expireUploads(borrow mut this, cutoffMillis: i64) -> Result<u64, StoreError> {
        var old = Vector<[u8; 16]>.create();
        for (i in 0..this.state.uploads.length()) {
            if (this.state.uploads.valueAt(i).initiatedMillis < cutoffMillis) {
                old.push(this.state.uploads.keyAt(i).id)?;
            }
        }
        for (id in old.view()) {
            this.checkWritable()?;
            this.scratch.clear();
            encodeUploadAbortMeta(mut this.scratch, id, Clock.unixMillis())?;
            let empty = [0u8; 1];
            this.commitOne(RecordType.UploadAbort, empty[0..0])?;
        }
        return Ok(old.length as u64);
    }

    // Statistics.
    fn objectCount(borrow this) -> usize => this.state.index.length();

    /// Bytes in journal segments (records and recovered segment files), and their number.
    fn journalBytes(borrow this) -> u64 {
        var total: u64 = 0;
        for (i in 0..this.state.segments.length()) { total += this.state.segments.valueAt(i).totalBytes; }
        return total;
    }

    fn segmentCount(borrow this) -> usize => this.state.segments.length();

    /// The work upkeep has not done yet (ADR-0033): what compaction would free and copy in the segments it would
    /// choose now (covered by the checkpoint, live share under `compactBelowLivePercent`), and the journal bytes no
    /// checkpoint covers, which recovery replays.
    fn upkeepDebt(borrow this) -> UpkeepDebt {
        var debt = UpkeepDebt { compactionFrees: 0, compactionCopies: 0, uncheckpointed: 0 };
        for (i in 0..this.state.segments.length()) {
            let id: u64 = this.state.segments.keyAt(i);
            let u = this.state.segments.valueAt(i);
            if (id >= this.checkpointSegment) {
                debt.uncheckpointed += u.totalBytes;
            } else if (u.liveBytes == 0 || u.liveBytes * 100 < u.totalBytes * this.config.compactBelowLivePercent) {
                debt.compactionFrees += u.totalBytes - u.liveBytes;
                debt.compactionCopies += u.liveBytes;
            }
        }
        return debt;
    }

    /// Retired extents that wait for readers, and extents that open readers pin (ADR-0007).
    fn deferredExtentCount(borrow this) -> usize => this.deferred.length;
    fn pinnedExtentCount(borrow this) -> usize => this.pins.pinnedCount();

    /// The segments the store accounts for (a new active segment with no record yet is not among them).
    fn segmentIds(borrow this) -> Vector<u64> {
        var ids = Vector<u64>.create();
        for (i in 0..this.state.segments.length()) {
            let id: u64 = this.state.segments.keyAt(i);
            ids.push(id)!;
        }
        return ids;
    }

    /// The LSN the newest checkpoint covers (0: none).
    fn lastCheckpoint(borrow this) -> u64 => this.checkpointLsn;

    fn recordsApplied(borrow this) -> u64 => this.state.records;

    fn journalSyncs(borrow this) -> u64 => this.journal.syncCount();

    /// The I/O failure that failed the journal, if one did (ADR-0039).
    fn journalFailure(borrow this) -> IoFailure? => this.journal.failureCause();

    /// Journal rotations that failed and left it running, and group commits that synced under the store's lock
    /// because their sync handle could not be opened (ADR-0039).
    fn journalRotationFailures(borrow this) -> u64 => this.journal.rotationFailureCount();

    fn journalSyncHandleFallbacks(borrow this) -> u64 => this.journal.syncHandleFallbackCount();

    /// The cumulative counters (ADR-0021).
    fn counters(borrow this) -> StoreCounters => StoreCounters {
        payloadBytes: this.counts.payloadBytes,
        journalBytesWritten: this.counts.journalBytesWritten,
        extentBytesWritten: this.counts.extentBytesWritten,
        checkpointBytesWritten: this.counts.checkpointBytesWritten,
        compactionBytesCopied: this.counts.compactionBytesCopied,
        segmentsCompacted: this.counts.segmentsCompacted,
        checkpoints: this.counts.checkpoints,
        upkeepHolds: this.counts.upkeepHolds,
        upkeepSlowHolds: this.counts.upkeepSlowHolds,
        upkeepLongestMicros: this.counts.upkeepLongestMicros,
    };

    /// (total, live) bytes of a segment.
    /// The record bytes of every inline version, current or not: what the segments' live bytes must add up to, no
    /// more and no less (for tests of the accounting).
    fn inlineRecordBytes(borrow this) -> u64 {
        var total: u64 = 0;
        var cursor = this.state.index.first();
        while (true) {
            let i = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            cursor = this.state.index.next(i);
            var slot = this.state.index.slotAt(i);
            while (slot != NO_VERSION_SLOT) {
                let v = this.state.index.versionAt(slot);
                if (v.extents.length == 0 && !isDeleteMarker(v)) { total += v.recordLength as u64; }
                slot = this.state.index.olderOf(slot);
            }
        }
        return total;
    }

    fn segmentUsage(borrow this, segment: u64) -> SegmentUsage => match (this.state.segments.get(borrow segment)) {
        Some(u) => SegmentUsage { totalBytes: u.totalBytes, liveBytes: u.liveBytes },
        null => SegmentUsage { totalBytes: 0, liveBytes: 0 },
    };
}

/// Streams an object's bytes, from the journal (inline) or its extents.
/// An inline version's record, to be read without the store (ADR-0024).
struct InlineRecord {
    path: String;
    segment: u64;
    offset: u64;
    length: u32;
    /// The range to keep, as offsets in the record.
    from: usize;
    to: usize;
    /// Keeps the segment on disk until the record is read.
    pin: ReadPin;
}

/// A reader made by `ObjectStore.prepareReader`, opened by `open`: either the reader itself (extents, which open
/// lazily) or the inline record still to read.
struct PreparedReader {
    private reader: ObjectReader?;
    private record: InlineRecord?;

    /// An extent reader, which needs no I/O to open: async code takes it directly. Null for an inline record, which
    /// `open` reads (ADR-0034).
    fn takeReady(borrow mut this) -> ObjectReader? => replace(mut this.reader, null);

    /// Reads and verifies an inline record from its segment's own file (I/O, without the store); an extent reader
    /// is returned as it is.
    fn open(borrow mut this) -> Result<ObjectReader, StoreError> {
        match (replace(mut this.reader, null)) {
            Some(r) => { return Ok(r); }
            null => {}
        }
        let rec = match (replace(mut this.record, null)) {
            Some(r) => r,
            null => { return Err(StoreError.NoSuchKey); } // opened twice
        };
        let bytes = match (readRecordFile(rec.path.view(), rec.segment, rec.offset, rec.length)) {
            Ok(b) => b,
            Err(JournalError.Corrupt(_, _)) => { return Err(StoreError.DataCorrupt); }
            Err(e) => { return Err(StoreError.Journal(e)); }
        };
        var inline = Vector<u8>.create();
        inline.extend(bytes.view()[rec.from..rec.to])?;
        return Ok(ObjectReader { inline: inline, inlinePosition: 0, extents: null, pin: null });
    }
}

struct ObjectReader {
    private inline: Vector<u8>;
    private inlinePosition: usize;
    private extents: ExtentReader?;
    /// The extents' pins, released when the reader is dropped (ADR-0007).
    private pin: ReadPin?;

    /// An unread inline object's bytes, all at once (no I/O); null for an extent reader or one already read from.
    fn takeInline(borrow mut this) -> Vector<u8>? {
        if (this.extents.isSome() || this.inlinePosition != 0) { return null; }
        return replace(mut this.inline, Vector<u8>.create());
    }

    /// Reads the next bytes; 0 at the end.
    fn read(borrow mut this, into: SliceMut<u8>) -> Result<usize, StoreError> {
        match (this.extents.asBorrowMut()) {
            Some(r) => { return sio(r.read(into)); }
            null => {}
        }
        let left = this.inline.length - this.inlinePosition;
        let n = if (into.length < left) into.length else left;
        into[0..n].copyFrom(this.inline.view()[this.inlinePosition..this.inlinePosition + n]);
        this.inlinePosition += n;
        return Ok(n);
    }
}

/// `ObjectStore.upkeepDebt`, in bytes.
struct UpkeepDebt {
    /// Journal bytes the compactions due now would remove, net of what they copy.
    compactionFrees: u64;
    /// Live inline payloads those compactions copy first.
    compactionCopies: u64;
    /// Journal bytes in segments no checkpoint covers: what recovery replays.
    uncheckpointed: u64;
}

/// Makes the store's object writers without the store (`ObjectStore.writerFactory`): no lock and no I/O.
struct WriterFactory {
    private dir: String;
    private inlineMax: usize;
    private extentMax: u64;
    private abandoned: Channel<u64>;

    /// Whether an object of `size` bytes stays inline, so that its PUT runs on the event loop (ADR-0031).
    fn keepsInline(borrow this, size: u64) -> bool => size <= this.inlineMax as u64;

    fn newWriter(borrow this) -> Result<ObjectWriter, StoreError> =>
        Ok(ObjectWriter.create(this.dir.view(), this.inlineMax, this.extentMax, this.abandoned.clone())?);
}

/// A PUT's journal record, encoded but not staged.
struct EncodedPut {
    kind: RecordType;
    meta: Vector<u8>;
    manifest: Vector<u8>;
}

/// A replica's put record (ADR-0077 §3): `encodePut`'s, with the source's MD5, and its part count after the extras
/// section when it has parts.
fn encodeReplicaPut(
    bucket: StringView,
    key: StringView,
    contentType: StringView,
    metadata: Slice<u8>,
    extras: Slice<u8>,
    versionId: [u8; 16],
    md5: [u8; 16],
    parts: u32,
    obj: borrow FinishedObject,
) -> Result<EncodedPut, StoreError> {
    var meta = Vector<u8>.create();
    encodePutMeta(
        mut meta,
        bucket.bytes(),
        key.bytes(),
        versionId,
        Clock.unixMillis(),
        obj.size,
        md5,
        contentType.bytes(),
        metadata,
    )?;
    appendExtrasSection(mut meta, extras)?;
    if (parts > 0) { meta.pushLE(parts)?; }
    var manifest = Vector<u8>.create();
    let kind = match (borrow obj.body) {
        ObjectBody.Inline(_) => RecordType.PutInline,
        ObjectBody.Extents(extents) => {
            encodeManifest(mut manifest, extents.view())?;
            RecordType.PutExtent
        }
    };
    return Ok(EncodedPut { kind: kind, meta: meta, manifest: manifest });
}

fn encodePut(
    bucket: StringView,
    key: StringView,
    contentType: StringView,
    metadata: Slice<u8>,
    extras: Slice<u8>,
    versionId: [u8; 16],
    obj: borrow FinishedObject,
) -> Result<EncodedPut, StoreError> {
    var meta = Vector<u8>.create();
    encodePutMeta(
        mut meta,
        bucket.bytes(),
        key.bytes(),
        versionId,
        Clock.unixMillis(),
        obj.size,
        obj.md5,
        contentType.bytes(),
        metadata,
    )?;
    appendExtrasSection(mut meta, extras)?;
    var manifest = Vector<u8>.create();
    let kind = match (borrow obj.body) {
        ObjectBody.Inline(_) => RecordType.PutInline,
        ObjectBody.Extents(extents) => {
            encodeManifest(mut manifest, extents.view())?;
            RecordType.PutExtent
        }
    };
    return Ok(EncodedPut { kind: kind, meta: meta, manifest: manifest });
}
