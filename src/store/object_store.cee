// The embedded object store: one journal shard plus the v0 in-memory index (ROADMAP M1).
//
// Every change follows one path: build the record, stage it, commit the batch (one write, one
// sync), then apply it to the index with `applyRecord`, the same function recovery replays.
// So the live state and the recovered state are the same function of the journal.

struct StoreConfig {
    journal: JournalConfig;
    /// Objects up to this size are stored inline in the journal; larger ones go to extents.
    inlineMaxBytes: usize;
    /// The largest extent file (ADR-0003).
    extentMaxBytes: u64;
    /// The largest object a single PUT may store (S3: 5 GiB).
    maxObjectBytes: u64;
    /// `maintain` checkpoints once this many journal bytes were committed since the last
    /// checkpoint (0: never). It bounds recovery's replay (ADR-0005).
    checkpointEveryBytes: u64;
    /// A sealed segment covered by the checkpoint is compacted when its live inline bytes are
    /// below this percentage of its size.
    compactBelowLivePercent: u64;
    /// The most live bytes one `compact` call copies.
    compactMaxCopyBytes: u64;
    /// The most bytes the store may occupy, journal and extents together (0: no limit). Set it below the volume's
    /// free space: CeeSafe has no free-space query yet (CEESAFE_GAPS G24). ADR-0006.
    capacityBytes: u64;
    /// Kept free below `capacityBytes` for what frees space or keeps the store recoverable: deletes, checkpoints
    /// and compaction never count against it, writes do (ADR-0006).
    reserveBytes: u64;
    /// The least size of a multipart upload's parts, all but the last (S3: 5 MiB), and the largest object an upload
    /// may complete (S3: 5 TiB). ADR-0009.
    minPartBytes: u64;
    maxUploadBytes: u64;
    /// `maintain` aborts uploads started longer ago than this (0: never), so an abandoned upload does not keep its
    /// parts forever (ADR-0017).
    uploadExpiryMillis: u64;
    /// How often `maintain` applies buckets' lifecycle rules (0: never); S3 runs them about daily (ADR-0020).
    lifecycleEveryMillis: u64;

    fn defaults() -> StoreConfig => StoreConfig {
        journal: JournalConfig.defaults(),
        inlineMaxBytes: 131072,
        extentMaxBytes: 67108864,
        maxObjectBytes: 5368709120,
        checkpointEveryBytes: 67108864,
        compactBelowLivePercent: 50,
        compactMaxCopyBytes: 67108864,
        capacityBytes: 0,
        reserveBytes: 268435456,
        minPartBytes: 5242880,
        maxUploadBytes: 5497558138880,
        uploadExpiryMillis: 604800000, // 7 days
        lifecycleEveryMillis: 3600000, // an hour
    };
}

enum StoreError {
    @from Journal(JournalError),
    /// A journal record whose meta does not decode: (segment, offset).
    BadMeta(u64, u64),
    @from OutOfMemory(AllocError),
    InvalidBucketName,
    InvalidKey,
    NoSuchBucket,
    BucketAlreadyExists,
    BucketNotEmpty,
    NoSuchKey,
    EntityTooLarge,
    PreconditionFailed,
    /// Extent or directory I/O failed.
    Io(IoFailure),
    /// Stored bytes do not match their checksum.
    DataCorrupt,
    /// The newest checkpoint fails its checks (ADR-0005).
    CheckpointCorrupt,
    /// The write would take the store into its reserve (ADR-0006); deletes still work.
    InsufficientStorage,
    /// Multipart (ADR-0009): no such upload for this bucket and key; a named part is missing or has another ETag;
    /// parts not in ascending order; a part other than the last below `minPartBytes`; a part number outside 1-10000.
    NoSuchUpload,
    InvalidPart,
    InvalidPartOrder,
    EntityTooSmall,
    InvalidPartNumber,
    /// The stored fields are larger than MAX_METADATA_BYTES (ADR-0012).
    MetadataTooLarge,
    /// A completed object's checksum is not the one the client named (ADR-0015).
    BadDigest,
}

fn sio<T>(r: Result<T, IoFailure>) -> Result<T, StoreError> => match (r) {
    Ok(v) => Ok(v),
    Err(e) => Err(if (e.op == IoOp.Read && e.errno == -1) StoreError.DataCorrupt else StoreError.Io(e)),
};

/// A write's precondition, checked atomically with the write.
enum PutCondition {
    None,
    /// If-None-Match: * — only if the key has no current object.
    IfAbsent,
    /// If-Match on the generation (the LSN of the current version).
    IfGeneration(u64),
}

/// A bucket in a listing.
struct BucketEntry {
    name: Vector<u8>;
    createdMillis: i64;
}

struct BucketInfo {
    /// The bucket's number in index keys (ADR-0027): given in memory by `StoreState.addBucket`, never on disk.
    number: u32;
    createdMillis: i64;
    objects: u64;
    /// The bucket's tags (canonical, as object tags are) and lifecycle rules (`encodeLifecycle`); empty for none
    /// (ADR-0020).
    tags: Vector<u8>;
    lifecycle: Vector<u8>;
}

/// Space use of one segment, for compaction (ADR-0005). `liveBytes` counts the records that
/// hold the inline payload of a current version: once a checkpoint covers the segment, they are
/// all that must be copied before it can be removed.
struct SegmentUsage {
    totalBytes: u64;
    liveBytes: u64;
}

/// What `compact` did.
struct CompactStats {
    segmentsRemoved: u64;
    bytesFreed: u64;
    /// Live inline payloads copied into Relocate records, and their bytes.
    relocated: u64;
    bytesCopied: u64;
}

/// The store's work since it opened, for the stats endpoint and benchmarks (ADR-0021): from these, syncs per 1,000
/// writes and write amplification (bytes written per payload byte accepted).
struct StoreCounters {
    /// Object and part bytes accepted for commit.
    payloadBytes: u64;
    /// Bytes written: journal records (inline payloads included), extent files (headers included), checkpoints.
    journalBytesWritten: u64;
    extentBytesWritten: u64;
    checkpointBytesWritten: u64;
    /// Live inline payload bytes compaction copied (they are in journalBytesWritten too).
    compactionBytesCopied: u64;
    segmentsCompacted: u64;
    checkpoints: u64;
}

/// What `maintain` did.
struct MaintenanceReport {
    checkpointed: bool;
    compaction: CompactStats;
    /// Uploads aborted for their age.
    uploadsExpired: u64;
    /// What lifecycle rules did this time (zeros when they did not run).
    lifecycle: LifecycleReport;
}

/// What one application of the lifecycle rules did.
struct LifecycleReport {
    objectsExpired: u64;
    uploadsAborted: u64;
}

/// A live inline version that compaction copies.
struct Relocation {
    bucket: Vector<u8>;
    key: Vector<u8>;
    versionId: [u8; 16];
    generation: u64;
    segment: u64;
    recordOffset: u64;
    recordLength: u32;
    payloadLength: u32;
}

/// What HEAD returns.
struct ObjectInfo {
    size: u64;
    mtimeMillis: i64;
    md5: [u8; 16];
    generation: u64;
    contentType: Vector<u8>;
    /// A multipart object's part count (its ETag is `md5-parts`), else 0.
    parts: u32;
    /// User metadata and stored headers (ADR-0012), as a blob (`metadataPairs` reads it).
    metadata: Vector<u8>;
    /// The checksum and part layout (ADR-0015), as a blob (`decodeExtras` reads it).
    extras: Vector<u8>;
}

struct PutOutcome {
    md5: [u8; 16];
    generation: u64;
    parts: u32;
    /// The version's checksum and part layout (ADR-0015).
    extras: Vector<u8>;
}

/// One page of a listing: keys and rolled-up common prefixes, both in byte order.
struct ListPage {
    keys: Vector<Vector<u8>>;
    sizes: Vector<u64>;
    /// Each key's MD5 (its ETag) and modification time, in Unix milliseconds.
    md5s: Vector<[u8; 16]>;
    mtimes: Vector<i64>;
    /// Each key's part count (0: not multipart).
    parts: Vector<u32>;
    commonPrefixes: Vector<Vector<u8>>;
    truncated: bool;
    /// The last key or prefix returned, for the next page's `startAfter`.
    nextMarker: Vector<u8>;
    nextMarkerIsPrefix: bool;
}

/// Index entries a checkpoint step encodes under the store (ADR-0028): about 0.7 MB and a millisecond or two.
const CHECKPOINT_STEP_ENTRIES: usize = 4096;

/// The bucket number of a lookup key whose bucket is not there (ADR-0027): never given to a bucket.
const NO_BUCKET: u32 = 0xFFFFFFFF;

/// Everything recovery rebuilds from the journal.
struct StoreState {
    /// In (bucket, key) order, so a listing seeks to its first key and reads only its page (ADR-0026).
    index: VersionIndex;
    buckets: HashMap<BucketKey, BucketInfo>;
    /// Each bucket's name by its number, and the next number to give (ADR-0027).
    bucketNames: HashMap<u32, Vector<u8>>;
    nextBucket: u32;
    segments: HashMap<u64, SegmentUsage>;
    records: u64;
    /// Extents of versions superseded or deleted by applied records; the store removes the
    /// files once the records are durable (they always are when applied).
    deadExtents: Vector<ExtentRef>;
    /// The bytes of the live versions' and the uploads' extent files, headers included (ADR-0006).
    extentBytes: u64;
    /// Multipart uploads in progress (ADR-0009).
    uploads: HashMap<UploadKey, Upload>;
    /// The latest completions, oldest first, so a retried Complete gets its first answer (ADR-0014). Rebuilt from
    /// the journal after the newest checkpoint, and never written to one.
    completions: Vector<Completion>;

    fn create() -> StoreState => StoreState {
        index: VersionIndex.create(),
        buckets: HashMap<BucketKey, BucketInfo>.create(),
        bucketNames: HashMap<u32, Vector<u8>>.create(),
        nextBucket: 0,
        segments: HashMap<u64, SegmentUsage>.create(),
        records: 0,
        deadExtents: Vector<ExtentRef>.create(),
        extentBytes: 0,
        uploads: HashMap<UploadKey, Upload>.create(),
        completions: Vector<Completion>.create(),
    };

    /// Releases a superseded or deleted version: its record bytes and its extents.
    fn retire(borrow mut this, old: borrow ObjectVersion) -> Result<void, StoreError> {
        let freed = extentFileBytes(old);
        this.extentBytes = if (this.extentBytes > freed) this.extentBytes - freed else 0;
        if (old.extents.length == 0) { this.releaseRecord(old.recordSegment, old.recordLength); }
        for (i in 0..old.extents.length) {
            this.deadExtents.push(old.extents[i])?;
        }
        return Ok();
    }

    /// Adds bucket `name` under a new number; one that is already there keeps its number, and its info is replaced.
    /// Returns whether it was new.
    fn addBucket(borrow mut this, name: Vector<u8>, info: BucketInfo) -> Result<bool, StoreError> {
        var entry = info;
        let k = BucketKey { name: copyBytes(name.view())? };
        match (this.buckets.get(borrow k)) {
            Some(b) => {
                entry.number = b.number;
                let _ = this.buckets.put(k, entry)?;
                return Ok(false);
            }
            null => {}
        }
        if (this.nextBucket == NO_BUCKET) { return Err(StoreError.InsufficientStorage); } // 4 billion creations
        entry.number = this.nextBucket;
        // If the second put fails, the name stays under a number no bucket has, and the next add reuses the number.
        this.bucketNames.put(entry.number, name)?;
        this.buckets.put(k, entry)?;
        this.nextBucket += 1;
        return Ok(true);
    }

    /// Removes bucket `name` and its number.
    fn removeBucket(borrow mut this, name: Slice<u8>) -> Result<void, StoreError> {
        let k = BucketKey { name: copyBytes(name)? };
        match (this.buckets.remove(borrow k)) {
            Some(b) => { let _ = this.bucketNames.remove(borrow b.number); }
            null => {}
        }
        return Ok();
    }

    /// The key to look `bucket`'s `key` up by. A bucket that is not there gets NO_BUCKET, which no bucket has, so the
    /// key finds nothing, as a bucket with no keys would.
    fn keyFor(borrow this, bucket: Slice<u8>, key: Slice<u8>) -> Result<IndexKey, StoreError> {
        let k = BucketKey { name: copyBytes(bucket)? };
        let number = match (this.buckets.get(borrow k)) {
            Some(b) => b.number,
            null => NO_BUCKET,
        };
        return Ok(IndexKey { bucket: number, key: copyBytes(key)? });
    }

    /// The index key of `bucket`'s `key`, or null if there is no such bucket.
    fn indexKey(borrow this, bucket: Slice<u8>, key: Slice<u8>) -> Result<IndexKey?, StoreError> {
        let k = BucketKey { name: copyBytes(bucket)? };
        return match (this.buckets.get(borrow k)) {
            Some(b) => Ok(IndexKey { bucket: b.number, key: copyBytes(key)? }),
            null => Ok(null),
        };
    }

    /// The name of bucket number `number` (empty if there is none).
    fn bucketName(borrow this, number: u32) -> Slice<u8> => match (this.bucketNames.get(borrow number)) {
        Some(n) => n.view(),
        null => "".bytes(),
    };

    fn hasBucket(borrow this, name: Slice<u8>) -> Result<bool, StoreError> {
        let k = BucketKey { name: copyBytes(name)? };
        return Ok(this.buckets.contains(borrow k));
    }

    fn addSegmentBytes(borrow mut this, segment: u64, total: u64, live: u64) -> Result<void, StoreError> {
        match (this.segments.getMut(borrow segment)) {
            Some(u) => {
                u.totalBytes += total;
                u.liveBytes += live;
                return Ok();
            }
            null => {}
        }
        this.segments.put(segment, SegmentUsage { totalBytes: total, liveBytes: live })?;
        return Ok();
    }

    fn releaseRecord(borrow mut this, segment: u64, length: u32) {
        match (this.segments.getMut(borrow segment)) {
            Some(u) => { u.liveBytes = if (u.liveBytes > length as u64) u.liveBytes - length as u64 else 0; }
            null => {}
        }
    }

    fn bumpObjects(borrow mut this, bucket: Slice<u8>, up: bool) -> Result<void, StoreError> {
        let k = BucketKey { name: copyBytes(bucket)? };
        match (this.buckets.getMut(borrow k)) {
            Some(b) => {
                if (up) { b.objects += 1; } else { b.objects -= 1; }
            }
            null => {}
        }
        return Ok();
    }
}

/// The bytes a version's extent files occupy: each extent's data and its header.
fn extentFileBytes(v: borrow ObjectVersion) -> u64 {
    var total: u64 = 0;
    for (i in 0..v.extents.length) {
        total += v.extents[i].length + EXTENT_HEADER_LEN;
    }
    return total;
}

/// Applies one committed record to the state. Recovery and live writes both call this.
/// `meta` is the record's meta bytes; the payload starts right after it in the segment.
/// `manifest` is the payload of a PutExtent record (empty otherwise).
fn applyRecord(
    state: borrow mut StoreState,
    kind: RecordType,
    lsn: u64,
    segment: u64,
    offset: u64,
    totalLen: u32,
    meta: Slice<u8>,
    payloadLen: u32,
    manifest: Slice<u8>,
) -> Result<void, StoreError> {
    state.records += 1;
    let isPut = match (kind) {
        RecordType.PutInline => true,
        RecordType.PutExtent => true,
        _ => false,
    };
    if (isPut) {
        let m = match (decodePutMeta(meta)) {
            Ok(m) => m,
            Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
        };
        let extents = match (kind) {
            RecordType.PutExtent => match (decodeManifest(manifest)) {
                Ok(e) => e,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            },
            _ => Vector<ExtentRef>.create(),
        };
        state.extentBytes += extentRefBytes(extents.view());
        return applyPut(state, m, extents, 0, lsn, segment, offset, totalLen, meta.length, payloadLen);
    }
    match (kind) {
        RecordType.UploadComplete => {
            let c = match (decodeUploadCompleteMeta(meta)) {
                Ok(c) => c,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            let extents = match (decodeManifest(manifest)) {
                Ok(e) => e,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            if (!takeCompletedUpload(state, c.id, extents.view())?) {
                state.extentBytes += extentRefBytes(extents.view());
            }
            rememberCompletion(state, borrow c, lsn)?;
            return applyPut(state, c.put, extents, c.parts, lsn, segment, offset, totalLen, meta.length, payloadLen);
        }
        RecordType.SetTags => {
            // Like Relocate: it changes the version only if that is still the key's current one. Its record is never
            // live: the index and every later checkpoint hold the tags.
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let m = match (decodeSetTagsMeta(meta)) {
                Ok(m) => m,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            let key = match (state.indexKey(m.bucket.view(), m.key.view())?) {
                Some(k) => k,
                null => { return Ok(); } // no such bucket: no such version
            };
            let tags = m.tags;
            let generation = m.generation;
            let versionId = m.versionId;
            match (state.index.getMut(borrow key)) {
                Some(v) => {
                    if (v.lsn == generation && v.versionId[..] == versionId[..]) {
                        v.metadata = match (metadataReplace(v.metadata.view(), TAGS_FIELD.bytes(), tags.view())) {
                            Ok(b) => b,
                            Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
                        };
                    }
                }
                null => {}
            }
        }
        RecordType.UploadCreate => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            if (applyUploadCreate(state, meta).isErr()) { return Err(StoreError.BadMeta(segment, offset)); }
        }
        RecordType.UploadPart => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let extents = match (decodeManifest(manifest)) {
                Ok(e) => e,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            if (applyUploadPart(state, meta, extents).isErr()) { return Err(StoreError.BadMeta(segment, offset)); }
        }
        RecordType.UploadAbort => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            if (applyUploadAbort(state, meta).isErr()) { return Err(StoreError.BadMeta(segment, offset)); }
        }
        RecordType.DeleteVersion => {
            // The delete record itself is garbage as soon as it is applied, except as a
            // tombstone until the segments holding older versions are compacted.
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let m = match (decodeDeleteMeta(meta)) {
                Ok(m) => m,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            match (state.indexKey(m.bucket.view(), m.key.view())?) {
                Some(key) => {
                    match (state.index.remove(borrow key)) {
                        Some(old) => {
                            state.retire(borrow old)?;
                            state.bumpObjects(m.bucket.view(), false)?;
                        }
                        null => {}
                    }
                }
                null => {}
            }
        }
        RecordType.BucketCreate => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let name = match (decodeBucketName(meta)) {
                Ok(n) => n,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            let created = match (decodeBucketMillis(meta)) {
                Ok(t) => t,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            let info = BucketInfo {
                number: 0,
                createdMillis: created,
                objects: 0,
                tags: Vector<u8>.create(),
                lifecycle: Vector<u8>.create(),
            };
            let _ = state.addBucket(name, info)?;
        }
        RecordType.BucketConfig => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let m = match (decodeBucketConfigMeta(meta)) {
                Ok(m) => m,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            let configKind = m.kind;
            let value = m.value;
            let k = BucketKey { name: m.bucket };
            match (state.buckets.getMut(borrow k)) {
                Some(b) => {
                    if (configKind == BUCKET_CONFIG_TAGS) { b.tags = value; } else { b.lifecycle = value; }
                }
                null => {}
            }
        }
        RecordType.Relocate => {
            let m = match (decodeRelocateMeta(meta)) {
                Ok(m) => m,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            // The copy takes over only if the version it copied is still current; otherwise
            // it is garbage from the moment it is written.
            var moved = false;
            var oldSegment: u64 = 0;
            var oldLength: u32 = 0;
            let found = match (state.indexKey(m.bucket.view(), m.key.view())?) {
                Some(key) => state.index.getMut(borrow key),
                null => null,
            };
            match (found) {
                Some(v) => {
                    if (v.lsn == m.generation && v.versionId[..] == m.versionId[..] && v.extents.length == 0) {
                        oldSegment = v.recordSegment;
                        oldLength = v.recordLength;
                        v.payload = PayloadLocator {
                            segmentId: segment,
                            offset: offset + (RECORD_HEADER_LEN + meta.length) as u64,
                            length: payloadLen,
                        };
                        v.recordSegment = segment;
                        v.recordLength = totalLen;
                        moved = true;
                    }
                }
                null => {}
            }
            if (moved) { state.releaseRecord(oldSegment, oldLength); }
            state.addSegmentBytes(segment, totalLen as u64, if (moved) totalLen as u64 else 0)?;
        }
        RecordType.BucketDelete => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
            let name = match (decodeBucketName(meta)) {
                Ok(n) => n,
                Err(_) => { return Err(StoreError.BadMeta(segment, offset)); }
            };
            dropBucketUploads(state, name.view())?;
            state.removeBucket(name.view())?;
        }
        _ => {
            state.addSegmentBytes(segment, totalLen as u64, 0)?;
        }
    }
    return Ok();
}

/// Applies a PutInline, PutExtent or UploadComplete record whose meta is `m`. Its extents are already counted in
/// `extentBytes`.
fn applyPut(
    state: borrow mut StoreState,
    m: PutMeta,
    extents: Vector<ExtentRef>,
    parts: u32,
    lsn: u64,
    segment: u64,
    offset: u64,
    totalLen: u32,
    metaLen: usize,
    payloadLen: u32,
) -> Result<void, StoreError> {
    // Only an inline payload keeps its record live: an extent manifest is in the index, and
    // in every checkpoint (ADR-0005).
    let live = if (extents.length == 0) totalLen as u64 else 0;
    state.addSegmentBytes(segment, totalLen as u64, live)?;
    let key = state.indexKey(m.bucket.view(), m.key.view())?;
    let bucket = m.bucket;
    let version = ObjectVersion {
        versionId: m.versionId,
        lsn: lsn,
        kind: VersionKind.Object,
        size: m.size,
        mtimeMillis: m.mtimeMillis,
        md5: m.md5,
        contentType: m.contentType,
        payload: PayloadLocator {
            segmentId: segment,
            offset: offset + (RECORD_HEADER_LEN + metaLen) as u64,
            length: payloadLen,
        },
        recordSegment: segment,
        recordLength: totalLen,
        extents: extents,
        parts: parts,
        metadata: m.metadata,
        extras: m.extras,
    };
    match (key) {
        Some(k) => {
            match (state.index.put(k, version)?) {
                Some(old) => { state.retire(borrow old)?; }
                null => { state.bumpObjects(bucket.view(), true)?; }
            }
        }
        // Admission checks the bucket under the lock, so this does not happen. If it did, the version would have no
        // bucket to be listed in: it is retired at once, its extents reaped and its record dead.
        null => { state.retire(borrow version)?; }
    }
    return Ok();
}

/// A staged write waiting for its batch to commit before it is applied.
struct PendingApply {
    kind: RecordType;
    lsn: u64;
    segment: u64;
    offset: u64;
    total: u32;
    meta: Vector<u8>;
    payloadLen: u32;
    /// The PutExtent manifest (empty for other records).
    manifest: Vector<u8>;
}

/// What fsck found wrong with one object (ADR-0006).
enum VerifyFault {
    /// A record or extent fails its CRC, or an extent is short.
    Corrupt,
    /// An extent file is missing.
    Missing,
    /// The bytes read back are not the object's size or MD5.
    Mismatch,
    /// Another I/O error.
    Unreadable,
}

struct VerifyProblem {
    bucket: Vector<u8>;
    key: Vector<u8>;
    fault: VerifyFault;
}

/// What `ObjectStore.verify` found.
struct VerifyReport {
    objects: u64;
    bytes: u64;
    problems: Vector<VerifyProblem>;
    orphanExtents: usize;
}

fn verifyFault(e: StoreError) -> VerifyFault => match (e) {
    StoreError.DataCorrupt => VerifyFault.Corrupt,
    StoreError.Journal(JournalError.Corrupt(_, _)) => VerifyFault.Corrupt,
    StoreError.Io(f) =>
        if (f.isNotFound()) VerifyFault.Missing else if (f.op ==
            IoOp.Read) VerifyFault.Corrupt else VerifyFault.Unreadable,
    _ => VerifyFault.Unreadable,
};

/// What admission adds for a write's journal record and the extent headers of a small object (ADR-0006).
const ADMIT_RECORD_BYTES: u64 = 4096;

/// The most objects one bucket's lifecycle rules delete in one run (ADR-0020).
const LIFECYCLE_BATCH: usize = 1000;

/// Abandoned extents queued between reaps; more are left to the orphan sweep at open.
const ABANDONED_CAPACITY: usize = 4096;

/// Applies a durable batch's records to the state, in order.
fn applyBatch(
    state: borrow mut StoreState,
    batch: borrow Vector<PendingApply>,
    sinceCheckpoint: borrow mut u64,
    counts: borrow mut StoreCounters,
) -> Result<void, StoreError> {
    for (i in 0..batch.length) {
        let p = borrow batch[i];
        sinceCheckpoint += p.total as u64;
        counts.journalBytesWritten += p.total as u64;
        applyRecord(
            mut state,
            p.kind,
            p.lsn,
            p.segment,
            p.offset,
            p.total,
            p.meta.view(),
            p.payloadLen,
            p.manifest.view(),
        )?;
    }
    return Ok();
}

/// The later of two positions in the index; null is the end, after everything.
fn laterOf(
    index: borrow VersionIndex,
    a: OrderedCursor?,
    b: OrderedCursor?,
) -> OrderedCursor? {
    let x = match (a) {
        Some(c) => c,
        null => { return null; }
    };
    let y = match (b) {
        Some(c) => c,
        null => { return null; }
    };
    return if (index.keyAt(x).compareKey(index.keyAt(y)) >= 0) x else y;
}

/// The first index entry after `marker` in `bucket`; with `wholePrefix`, after every key that starts with `marker`
/// (the first key at or after the prefix's end: the marker without its trailing 0xFF bytes, its last byte
/// incremented). Null when nothing in the bucket follows.
fn seekPast(
    index: borrow VersionIndex,
    bucket: u32,
    marker: Slice<u8>,
    wholePrefix: bool,
) -> Result<OrderedCursor?, AllocError> {
    if (!wholePrefix) {
        let after = IndexKey { bucket: bucket, key: copyBytes(marker)? };
        return Ok(index.seekAfter(borrow after));
    }
    var end = copyBytes(marker)?;
    while (end.length > 0 && end[end.length - 1] == 0xFF) { let _ = end.pop(); }
    // Every key after an all-0xFF marker starts with it: nothing in the bucket follows.
    if (end.length == 0) { return Ok(null); }
    let last = end.length - 1;
    end[last] = end[last] + 1;
    let from = IndexKey { bucket: bucket, key: end };
    return Ok(index.seek(borrow from));
}

struct ObjectStore {
    private journal: Journal;
    private state: StoreState;
    private config: StoreConfig;
    private scratch: Vector<u8>;
    private pendingApplies: Vector<PendingApply>;
    /// The batch written by `beginGroupSync` whose sync has not finished (ADR-0022).
    private inflightApplies: Vector<PendingApply>;
    /// Every record with a lower LSN is published (durable and applied).
    private publishedNext: u64;
    private extentDir: String;
    private dir: String;
    /// The newest durable checkpoint: its LSN and the first segment it does not cover
    /// (0, 0: none). Only segments before `checkpointSegment` may be compacted.
    private checkpointLsn: u64;
    private checkpointSegment: u64;
    /// Journal bytes committed since that checkpoint.
    private sinceCheckpoint: u64;
    /// Extents that open readers may still read (ADR-0007), and the retired ones that wait for them.
    private pins: ExtentPins;
    /// Segments whose records readers are reading without the store (ADR-0024): compaction leaves them on disk.
    private segmentPins: ExtentPins;
    private deferred: Vector<DeferredExtent>;
    private deferredBytes: u64;
    /// Extents of writers dropped unfinished, for the store to remove: a drop may run in async code, which must not
    /// do I/O, so it only queues them here.
    private abandoned: Channel<u64>;
    /// When `maintain` last applied lifecycle rules (Unix milliseconds).
    private lifecycleRan: i64;
    private counts: StoreCounters;

    /// Opens the store in `dir`: loads the newest checkpoint, if any, then replays the journal
    /// records after it.
    fn open(dir: StringView, config: StoreConfig) -> Result<ObjectStore, StoreError> {
        sio(Fs.ensureDirectory(dir))?;
        removeCheckpoints(dir, 0, true); // interrupted checkpoint writes
        let complete = listCheckpoints(dir, false)?;
        var state = StoreState.create();
        var start = JournalStart.beginning();
        if (complete.length > 0) {
            let loaded = readCheckpoint(dir, complete[complete.length - 1])?;
            start = JournalStart { segment: loaded.segment, lsn: loaded.lsn };
            state = loaded.state;
            // The checkpointed versions' inline records are live in the segments they cover.
            var live = Vector<SegmentFile>.create();
            var cursor = state.index.first();
            while (true) {
                let i = match (cursor) {
                    Some(c) => c,
                    null => { break; }
                };
                cursor = state.index.next(i);
                let v = state.index.valueAt(i);
                if (v.extents.length == 0) {
                    live.push(SegmentFile { id: v.recordSegment, size: v.recordLength as u64 })?;
                }
            }
            for (i in 0..live.length) { state.addSegmentBytes(live[i].id, 0, live[i].size)?; }
        }
        var failure: StoreError? = null;
        let journal = Journal.openFrom(dir, config.journal, start, (segment, offset, header, bytes) => {
            if (failure.isSome()) { return; }
            let metaEnd = RECORD_HEADER_LEN + header.metaLen as usize;
            let payloadEnd = metaEnd + header.payloadLen as usize;
            let manifest = if (carriesManifest(header.kind)) bytes[metaEnd..payloadEnd] else bytes[0..0];
            match (applyRecord(
                mut state,
                header.kind,
                header.lsn,
                segment,
                offset,
                header.totalLen,
                bytes[RECORD_HEADER_LEN..metaEnd],
                header.payloadLen,
                manifest,
            )) {
                Ok() => {}
                Err(e) => { failure = e; }
            }
        })?;
        match (failure) {
            Some(e) => { return Err(e); }
            null => {}
        }
        let unscanned = journal.unscannedSegments();
        for (i in 0..unscanned.length) {
            // Records only, as the live store counts a segment: its header is not part of it.
            let header = SEGMENT_HEADER_LEN as u64;
            let records = if (unscanned[i].size > header) unscanned[i].size - header else 0;
            state.addSegmentBytes(unscanned[i].id, records, 0)?;
        }
        // The checkpoint can name records in segments that compaction removed after it: Relocate records later in
        // the journal, now replayed, moved those versions out. Such a segment is accounted for with nothing in it,
        // and it must not be kept, or compaction would try to remove its file again (ADR-0005; found by the soak).
        var gone = Vector<u64>.create();
        for (i in 0..state.segments.length()) {
            let id: u64 = state.segments.keyAt(i);
            if (id >= start.segment) { continue; }
            var present = false;
            for (u in unscanned) {
                if (u.id == id) { present = true; }
            }
            if (!present) { gone.push(id)?; }
        }
        for (id in gone.view()) { let _ = state.segments.remove(borrow id); }
        if (complete.length > 0) { removeCheckpoints(dir, start.lsn, false); }
        var root = String.create();
        root.append(dir)?;
        var extentDir = String.create();
        extentDir.append(dir)?;
        extentDir.append("/extents")?;
        sio(Fs.ensureDirectory(extentDir.view()))?;
        let publishedNext = journal.upcomingLsn();
        var store = ObjectStore {
            journal: journal,
            state: state,
            config: config,
            scratch: Vector<u8>.create(),
            pendingApplies: Vector<PendingApply>.create(),
            inflightApplies: Vector<PendingApply>.create(),
            publishedNext: publishedNext,
            extentDir: extentDir,
            dir: root,
            checkpointLsn: start.lsn,
            checkpointSegment: start.segment,
            sinceCheckpoint: 0,
            pins: ExtentPins.create(),
            segmentPins: ExtentPins.create(),
            abandoned: Channel<u64>.create(ABANDONED_CAPACITY)?,
            deferred: Vector<DeferredExtent>.create(),
            deferredBytes: 0,
            lifecycleRan: 0,
            counts: StoreCounters {
                payloadBytes: 0,
                journalBytesWritten: 0,
                extentBytesWritten: 0,
                checkpointBytesWritten: 0,
                compactionBytesCopied: 0,
                segmentsCompacted: 0,
                checkpoints: 0,
            },
        };
        // Every extent not referenced by a live version is garbage: superseded or deleted
        // versions, and uploads that never committed (ADR-0003).
        store.state.deadExtents.clear();
        store.sweepOrphanExtents()?;
        return Ok(store);
    }

    /// Removes extent files that no live version references. Only safe while no writer is
    /// in progress, so it runs at open.
    fn sweepOrphanExtents(borrow mut this) -> Result<usize, StoreError> {
        let orphans = this.orphanExtents()?;
        for (id in orphans.view()) {
            removeExtent(this.extentDir.view(), id);
        }
        return Ok(orphans.length);
    }

    /// The extent files that no live version references.
    fn orphanExtents(borrow this) -> Result<Vector<u64>, StoreError> {
        var live = HashMap<u64, bool>.create();
        var cursor = this.state.index.first();
        while (true) {
            let i = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            cursor = this.state.index.next(i);
            let v = this.state.index.valueAt(i);
            for (k in 0..v.extents.length) {
                let _ = live.put(v.extents[k].id, true)?;
            }
        }
        for (i in 0..this.state.uploads.length()) {
            let u = this.state.uploads.valueAt(i);
            for (p in 0..u.parts.length) {
                for (e in u.parts[p].extents.view()) { let _ = live.put(e.id, true)?; }
            }
        }
        let names = match (Directory.list(this.extentDir.view())) {
            Ok(n) => n,
            Err(_) => { return Err(StoreError.Io(IoFailure { op: IoOp.Open, errno: 0 })); }
        };
        var orphans = Vector<u64>.create();
        for (i in 0..names.length) {
            match (extentIdFromName(names[i].view())) {
                Some(id) => {
                    if (!live.contains(borrow id) && !this.isDeferred(id)) { orphans.push(id)?; }
                }
                null => {}
            }
        }
        return Ok(orphans);
    }

    /// Whether extent `id` is retired and waits for its readers (ADR-0007).
    fn isDeferred(borrow this, id: u64) -> bool {
        for (d in this.deferred.view()) {
            if (d.id == id) { return true; }
        }
        return false;
    }

    /// fsck (ADR-0006): reads every live object through the reader, which verifies each journal record and each
    /// extent's CRC, and compares the bytes' MD5 with the stored one. Also counts extent files that no version
    /// references. Changes nothing.
    fn verify(borrow this) -> Result<VerifyReport, StoreError> {
        var report = VerifyReport {
            objects: 0,
            bytes: 0,
            problems: Vector<VerifyProblem>.create(),
            orphanExtents: this.orphanExtents()?.length,
        };
        var chunk = Vector<u8>.create();
        chunk.resize(65536, 0)?;
        var cursor = this.state.index.first();
        while (true) {
            let i = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            cursor = this.state.index.next(i);
            let k = this.state.index.keyAt(i);
            let v = this.state.index.valueAt(i);
            report.objects += 1;
            let bucket = StringView.fromUtf8(this.state.bucketName(k.bucket)) ?? "";
            let key = StringView.fromUtf8(k.key.view()) ?? "";
            var fault: VerifyFault? = null;
            match (this.openUnpinned(bucket, key, 0, 0xFFFFFFFFFFFFFFFF)) {
                Ok(reader) => {
                    var r = reader;
                    var md5 = Md5.create();
                    var size: u64 = 0;
                    loop {
                        match (r.read(mut chunk.viewMut())) {
                            Ok(n) => {
                                if (n == 0) { break; }
                                md5.update(chunk.view()[0..n]);
                                size += n as u64;
                            }
                            Err(e) => {
                                fault = verifyFault(e);
                                break;
                            }
                        }
                    }
                    report.bytes += size;
                    if (fault.isNull()) {
                        let digest = md5.finish();
                        // A multipart object's MD5 is its ETag's, not its bytes' (ADR-0009): its extents' CRCs cover it.
                        if (size != v.size || (v.parts == 0 && digest[..] != v.md5[..])) {
                            fault = VerifyFault.Mismatch;
                        }
                    }
                }
                Err(e) => { fault = verifyFault(e); }
            }
            match (fault) {
                Some(f) => {
                    report.problems.push(VerifyProblem {
                        bucket: copyBytes(this.state.bucketName(k.bucket))?,
                        key: copyBytes(k.key.view())?,
                        fault: f,
                    })?;
                }
                null => {}
            }
        }
        return Ok(report);
    }

    /// Removes the extent files of versions retired by records that are now durable. An extent that an open reader
    /// pins waits in `deferred` until the reader is dropped (ADR-0007).
    fn reapExtents(borrow mut this) {
        this.reapDeferred();
        this.reapAbandoned();
        for (i in 0..this.state.deadExtents.length) {
            let ext = this.state.deadExtents[i];
            if (!this.pins.isPinned(ext.id)) {
                removeExtent(this.extentDir.view(), ext.id);
                continue;
            }
            let fileBytes = ext.length + EXTENT_HEADER_LEN;
            match (this.deferred.push(DeferredExtent { id: ext.id, fileBytes: fileBytes })) {
                Ok() => { this.deferredBytes += fileBytes; }
                // Never unlinked under its reader: the file is left for the next open's orphan sweep.
                Err(_) => {}
            }
        }
        this.state.deadExtents.clear();
    }

    /// Removes the extents that dropped writers queued.
    fn reapAbandoned(borrow mut this) {
        while (true) {
            match (this.abandoned.tryRecv()) {
                Some(id) => { removeExtent(this.extentDir.view(), id); }
                null => { return; }
            }
        }
    }

    /// Removes the deferred extents that no reader pins any more.
    fn reapDeferred(borrow mut this) {
        var i: usize = 0;
        while (i < this.deferred.length) {
            let d = this.deferred[i];
            if (this.pins.isPinned(d.id)) {
                i += 1;
                continue;
            }
            removeExtent(this.extentDir.view(), d.id);
            this.deferredBytes = if (this.deferredBytes > d.fileBytes) this.deferredBytes - d.fileBytes else 0;
            let _ = this.deferred.swapRemove(i);
        }
    }

    /// A writer for a new object's bytes; commit it with `putFinished` or `stageFinished`.
    fn newWriter(borrow this) -> Result<ObjectWriter, StoreError> =>
        Ok(ObjectWriter.create(
            this.extentDir.view(),
            this.config.inlineMaxBytes,
            this.config.extentMaxBytes,
            this.abandoned.clone(),
        )?);

    /// Removes the extents of a finished object that will not be committed.
    fn discardFinished(borrow this, obj: borrow FinishedObject) {
        match (borrow obj.body) {
            ObjectBody.Extents(extents) => {
                for (i in 0..extents.length) { removeExtent(this.extentDir.view(), extents[i].id); }
            }
            ObjectBody.Inline(_) => {}
        }
    }

    /// Stages one record, commits it durably, and applies it. Any staged batch commits with it.
    fn commitOne(borrow mut this, kind: RecordType, payload: Slice<u8>) -> Result<u64, StoreError> {
        this.commitStaged()?;
        let pos = this.journal.stage(kind, this.scratch.view(), payload)?;
        this.journal.commit()?;
        let total = truncate<u32>(recordLength(this.scratch.length, payload.length));
        this.sinceCheckpoint += total as u64;
        this.counts.journalBytesWritten += total as u64;
        applyRecord(
            mut this.state,
            kind,
            pos.lsn,
            pos.segmentId,
            pos.offset,
            total,
            this.scratch.view(),
            truncate<u32>(payload.length),
            if (carriesManifest(kind)) payload else payload[0..0],
        )?;
        this.publishedNext = pos.lsn + 1;
        this.reapExtents();
        return Ok(pos.lsn);
    }

    /// Every mutation starts here. After a journal failure the in-memory state may lag what is
    /// on disk (a failed batch may still have reached it), so no write may be acknowledged,
    /// not even one that would change nothing, such as deleting a key that looks missing.
    fn checkWritable(borrow this) -> Result<void, StoreError> {
        if (this.journal.isFailed()) { return Err(StoreError.Journal(JournalError.Failed)); }
        return Ok();
    }

    /// The bytes the store occupies: every journal segment and every live extent file (ADR-0006). Extents of
    /// retired versions are removed as soon as their records commit, so they are not counted.
    fn usedBytes(borrow this) -> u64 => this.journalBytes() + this.state.extentBytes + this.deferredBytes;

    /// Admits a write of `incoming` object bytes, plus its record, unless it would take the store into its
    /// reserve: InsufficientStorage. Deletes, checkpoints and compaction never ask (ADR-0006).
    fn admit(borrow this, incoming: u64) -> Result<void, StoreError> {
        let capacity = this.config.capacityBytes;
        if (capacity == 0) { return Ok(); }
        let need = this.usedBytes() + incoming + ADMIT_RECORD_BYTES + this.config.reserveBytes;
        if (need > capacity) { return Err(StoreError.InsufficientStorage); }
        return Ok();
    }

    fn createBucket(borrow mut this, name: StringView) -> Result<void, StoreError> {
        this.checkWritable()?;
        if (!isValidBucketName(name.bytes())) { return Err(StoreError.InvalidBucketName); }
        if (this.state.hasBucket(name.bytes())?) { return Err(StoreError.BucketAlreadyExists); }
        this.scratch.clear();
        encodeBucketMeta(mut this.scratch, name.bytes(), Clock.unixMillis())?;
        let empty = [0u8; 1];
        this.commitOne(RecordType.BucketCreate, empty[0..0])?;
        return Ok();
    }

    fn deleteBucket(borrow mut this, name: StringView) -> Result<void, StoreError> {
        this.checkWritable()?;
        let k = BucketKey { name: copyBytes(name.bytes())? };
        match (this.state.buckets.get(borrow k)) {
            Some(b) => {
                if (b.objects > 0) { return Err(StoreError.BucketNotEmpty); }
            }
            null => { return Err(StoreError.NoSuchBucket); }
        }
        this.scratch.clear();
        encodeBucketMeta(mut this.scratch, name.bytes(), Clock.unixMillis())?;
        let empty = [0u8; 1];
        this.commitOne(RecordType.BucketDelete, empty[0..0])?;
        return Ok();
    }

    fn bucketExists(borrow this, name: StringView) -> Result<bool, StoreError> => this.state.hasBucket(name.bytes());

    /// Sets the current version's tags (URL-encoded; empty removes them), without a new version: its ETag, generation
    /// and modification time stay (ADR-0017). One SetTags record, durable before this returns.
    fn setTags(borrow mut this, bucket: StringView, key: StringView, tags: Slice<u8>) -> Result<void, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        var generation: u64 = 0;
        var versionId = [0u8; 16];
        match (this.state.index.get(borrow k)) {
            Some(v) => {
                generation = v.lsn;
                versionId = v.versionId;
                let next = match (metadataReplace(v.metadata.view(), TAGS_FIELD.bytes(), tags)) {
                    Ok(b) => b,
                    Err(_) => { return Err(StoreError.DataCorrupt); }
                };
                if (next.length > MAX_METADATA_BYTES) { return Err(StoreError.MetadataTooLarge); }
            }
            null => { return Err(StoreError.NoSuchKey); }
        }
        this.scratch.clear();
        encodeSetTagsMeta(mut this.scratch, bucket.bytes(), key.bytes(), versionId, generation, tags)?;
        let empty = [0u8; 1];
        this.commitOne(RecordType.SetTags, empty[0..0])?;
        return Ok();
    }

    /// The bucket names, in byte order.
    fn listBuckets(borrow this) -> Result<Vector<Vector<u8>>, StoreError> {
        var names = Vector<Vector<u8>>.create();
        for (i in 0..this.state.buckets.length()) {
            let k = this.state.buckets.keyAt(i);
            names.push(copyBytes(k.name.view())?)?;
        }
        names.viewMut().sortBy((a, b) => compareBytes(a.view(), b.view()));
        return Ok(names);
    }

    /// The buckets in name order, with their creation times (Unix milliseconds).
    fn listBucketInfo(borrow this) -> Result<Vector<BucketEntry>, StoreError> {
        var entries = Vector<BucketEntry>.create();
        for (i in 0..this.state.buckets.length()) {
            entries.push(BucketEntry {
                name: copyBytes(this.state.buckets.keyAt(i).name.view())?,
                createdMillis: this.state.buckets.valueAt(i).createdMillis,
            })?;
        }
        entries.viewMut().sortBy((a, b) => compareBytes(a.name.view(), b.name.view()));
        return Ok(entries);
    }

    fn checkKey(key: StringView) -> Result<void, StoreError> {
        if (key.length == 0 || key.length > MAX_KEY_BYTES) { return Err(StoreError.InvalidKey); }
        return Ok();
    }

    /// The current version's generation, or null if the key has no object.
    fn currentGeneration(borrow this, bucket: StringView, key: StringView) -> Result<u64?, StoreError> {
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        return Ok(match (this.state.index.get(borrow k)) {
            Some(v) => v.lsn,
            null => null,
        });
    }

    /// Stores an object durably. When this returns Ok the object is on stable storage and
    /// visible to GET, HEAD and LIST.
    fn putObject(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        data: Slice<u8>,
        condition: PutCondition,
    ) -> Result<PutOutcome, StoreError> {
        let obj = this.writeAll(data)?;
        return this.putFinished(bucket, key, contentType, borrow obj, condition);
    }

    /// Runs `data` through a writer: inline if small, extents if not.
    fn writeAll(borrow this, data: Slice<u8>) -> Result<FinishedObject, StoreError> {
        if (data.length as u64 > this.config.maxObjectBytes) { return Err(StoreError.EntityTooLarge); }
        this.admit(data.length as u64)?; // before any byte reaches an extent
        var w = this.newWriter()?;
        sio(w.write(data))?;
        return sio(w.finish());
    }

    /// Commits a finished object as the key's current version, if `condition` holds. On a
    /// refusal its extents are removed; after a journal failure they are left for the orphan
    /// sweep, since the record may have reached the disk.
    fn putFinished(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        obj: borrow FinishedObject,
        condition: PutCondition,
    ) -> Result<PutOutcome, StoreError> =>
        this.putFinishedWith(bucket, key, contentType, "".bytes(), "".bytes(), obj, condition);

    /// `putFinished` with stored fields, a blob from `metadataAdd` (ADR-0012), and its checksum, a blob from
    /// `ObjectExtras.encode` (ADR-0015).
    /// Like `putFinishedWith`, but an unconditional PUT is only staged: it is published, and may
    /// be acknowledged, once `isPublished(outcome.generation)` (group commit, ADR-0022). A
    /// conditional PUT is checked against every earlier write, so it commits as `putFinishedWith`.
    fn putFinishedDeferred(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        metadata: Slice<u8>,
        extras: Slice<u8>,
        obj: borrow FinishedObject,
        condition: PutCondition,
    ) -> Result<PutOutcome, StoreError> {
        match (condition) {
            PutCondition.None => {}
            _ => { return this.putFinishedWith(bucket, key, contentType, metadata, extras, obj, condition); }
        }
        if (metadata.length > MAX_METADATA_BYTES) {
            this.discardFinished(obj);
            return Err(StoreError.MetadataTooLarge);
        }
        match (this.checkPut(bucket, key, contentType, obj, condition)) {
            Ok() => {}
            Err(e) => {
                this.discardFinished(obj);
                return Err(e);
            }
        }
        let lsn = this.stageFinished(bucket, key, contentType, metadata, extras, obj)?;
        return Ok(PutOutcome { md5: obj.md5, generation: lsn, parts: 0, extras: copyBytes(extras)? });
    }

    fn putFinishedWith(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        metadata: Slice<u8>,
        extras: Slice<u8>,
        obj: borrow FinishedObject,
        condition: PutCondition,
    ) -> Result<PutOutcome, StoreError> {
        // Staged writes must be visible to the precondition check.
        match (this.commitStaged()) {
            Ok(_) => {}
            Err(e) => { return Err(e); }
        }
        if (metadata.length > MAX_METADATA_BYTES) {
            this.discardFinished(obj);
            return Err(StoreError.MetadataTooLarge);
        }
        match (this.checkPut(bucket, key, contentType, obj, condition)) {
            Ok() => {}
            Err(e) => {
                this.discardFinished(obj);
                return Err(e);
            }
        }
        let lsn = this.stageFinished(bucket, key, contentType, metadata, extras, obj)?;
        this.commitStaged()?;
        return Ok(PutOutcome { md5: obj.md5, generation: lsn, parts: 0, extras: copyBytes(extras)? });
    }

    fn checkPut(
        borrow this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        obj: borrow FinishedObject,
        condition: PutCondition,
    ) -> Result<void, StoreError> {
        this.checkWritable()?;
        ObjectStore.checkKey(key)?;
        if (contentType.length > MAX_CONTENT_TYPE) { return Err(StoreError.InvalidKey); }
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        if (obj.size > this.config.maxObjectBytes) { return Err(StoreError.EntityTooLarge); }
        this.admit(obj.size)?;
        let current = this.currentGeneration(bucket, key)?;
        match (condition) {
            PutCondition.None => {}
            PutCondition.IfAbsent => {
                if (current.isSome()) { return Err(StoreError.PreconditionFailed); }
            }
            PutCondition.IfGeneration(g) => {
                if ((current ?? 0) != g) { return Err(StoreError.PreconditionFailed); }
            }
        }
        return Ok();
    }

    /// Stages an unconditional PUT into the current batch (group commit). It is neither durable
    /// nor visible until `commitStaged` returns Ok; a full batch is committed first.
    fn stagePut(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        data: Slice<u8>,
    ) -> Result<[u8; 16], StoreError> {
        let obj = this.writeAll(data)?;
        this.stageObject(bucket, key, contentType, borrow obj)?;
        return Ok(obj.md5);
    }

    /// Stages an unconditional PUT of a finished object into the current batch; on a refusal
    /// its extents are removed.
    fn stageObject(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        obj: borrow FinishedObject,
    ) -> Result<u64, StoreError> {
        match (this.checkPut(bucket, key, contentType, obj, PutCondition.None)) {
            Ok() => {}
            Err(e) => {
                this.discardFinished(obj);
                return Err(e);
            }
        }
        return this.stageFinished(bucket, key, contentType, "".bytes(), "".bytes(), obj);
    }

    /// Stages the record that publishes a finished object; returns its LSN (its generation).
    /// The object's extents are already durable (ObjectWriter.finish), as ADR-0001 requires.
    fn stageFinished(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        metadata: Slice<u8>,
        extras: Slice<u8>,
        obj: borrow FinishedObject,
    ) -> Result<u64, StoreError> {
        var meta = Vector<u8>.create();

        encodePutMeta(
            mut meta,
            bucket.bytes(),
            key.bytes(),
            nullVersionId(),
            Clock.unixMillis(),
            obj.size,
            obj.md5,
            contentType.bytes(),
            metadata,
        )?;
        appendExtrasSection(mut meta, extras)?;
        var manifest = Vector<u8>.create();
        let kind = match (borrow obj.body) {
            ObjectBody.Inline(_) => RecordType.PutInline,
            ObjectBody.Extents(extents) => {
                encodeManifest(mut manifest, extents.view())?;
                this.counts.extentBytesWritten += extentRefBytes(extents.view());
                RecordType.PutExtent
            }
        };
        this.counts.payloadBytes += obj.size;
        let payload = match (borrow obj.body) {
            ObjectBody.Inline(data) => data.view(),
            ObjectBody.Extents(_) => manifest.view(),
        };
        // A full segment rotates at a commit with nothing staged after it (ADR-0022).
        if (this.journal.wouldOverflow(meta.length, payload.length) || this.journal.needsRotation()) {
            this.commitStaged()?;
        }
        this.pendingApplies.reserve(1)?;
        let pos = this.journal.stage(kind, meta.view(), payload)?;
        let total = truncate<u32>(recordLength(meta.length, payload.length));
        let payloadLen = truncate<u32>(payload.length);
        this.pendingApplies.push(PendingApply {
            kind: kind,
            lsn: pos.lsn,
            segment: pos.segmentId,
            offset: pos.offset,
            total: total,
            meta: meta,
            payloadLen: payloadLen,
            manifest: manifest,
        })?;
        return Ok(pos.lsn);
    }

    /// Commits the staged batch, and a batch in flight, with one write and one sync, then
    /// publishes them in LSN order. Returns how many writes were published. On error nothing
    /// staged or in flight is published.
    fn commitStaged(borrow mut this) -> Result<usize, StoreError> {
        if (this.pendingApplies.length == 0 && this.inflightApplies.length == 0) { return Ok(0); }
        match (this.journal.commit()) {
            Ok() => {}
            Err(e) => {
                this.pendingApplies.clear();
                this.inflightApplies.clear();
                return Err(StoreError.Journal(e));
            }
        }
        let n = this.inflightApplies.length + this.pendingApplies.length;
        applyBatch(mut this.state, borrow this.inflightApplies, mut this.sinceCheckpoint, mut this.counts)?;
        applyBatch(mut this.state, borrow this.pendingApplies, mut this.sinceCheckpoint, mut this.counts)?;
        this.inflightApplies.clear();
        this.pendingApplies.clear();
        this.publishedNext = this.journal.upcomingLsn();
        this.reapExtents();
        return Ok(n);
    }

    /// Group commit, first half (ADR-0022): writes the staged batch to the journal without
    /// syncing it, and returns the ticket to sync it with, without the store's lock. Null when
    /// nothing is staged or a batch is already in flight.
    fn beginGroupSync(borrow mut this) -> Result<SyncTicket?, StoreError> {
        if (this.pendingApplies.length == 0 || this.inflightApplies.length > 0) { return Ok(null); }
        match (this.journal.writeStaged()) {
            Ok(Some(ticket)) => {
                let staged = replace(mut this.pendingApplies, Vector<PendingApply>.create());
                this.inflightApplies = staged;
                return Ok(ticket);
            }
            Ok(null) => { return Ok(null); }
            Err(e) => {
                this.pendingApplies.clear();
                return Err(StoreError.Journal(e));
            }
        }
    }

    /// Group commit, second half: takes the ticket's sync result and, if that made the batch
    /// durable, publishes it. A failed sync fails the journal, and the batch is never published.
    fn finishGroupSync(borrow mut this, lastLsn: u64, synced: Result<void, IoFailure>) -> Result<void, StoreError> {
        match (this.journal.finishSync(lastLsn, synced)) {
            Ok(true) => {}
            Ok(false) => { return Ok(); }
            Err(e) => {
                this.inflightApplies.clear();
                return Err(StoreError.Journal(e));
            }
        }
        applyBatch(mut this.state, borrow this.inflightApplies, mut this.sinceCheckpoint, mut this.counts)?;
        this.inflightApplies.clear();
        this.publishedNext = lastLsn + 1;
        this.reapExtents();
        return Ok();
    }

    /// Whether the record at `lsn` is published: durable, applied, and safe to acknowledge.
    fn isPublished(borrow this, lsn: u64) -> bool => lsn < this.publishedNext;

    /// The LSN after the last published record: every lower one is published.
    fn publishedBelow(borrow this) -> u64 => this.publishedNext;

    /// Whether a write that is staged or in flight can no longer be published: the journal failed.
    fn hasFailed(borrow this) -> bool => this.journal.isFailed();

    fn headObject(borrow this, bucket: StringView, key: StringView) -> Result<ObjectInfo, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        match (this.state.index.get(borrow k)) {
            Some(v) => {
                return Ok(ObjectInfo {
                    size: v.size,
                    mtimeMillis: v.mtimeMillis,
                    md5: v.md5,
                    generation: v.lsn,
                    contentType: copyBytes(v.contentType.view())?,
                    parts: v.parts,
                    metadata: copyBytes(v.metadata.view())?,
                    extras: copyBytes(v.extras.view())?,
                });
            }
            null => { return Err(StoreError.NoSuchKey); }
        }
    }

    /// A reader of the current version's bytes `[from, to)`, clamped to the object's size.
    fn openReader(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        from: u64,
        to: u64,
    ) -> Result<ObjectReader, StoreError> {
        var prepared = this.prepareReader(bucket, key, from, to)?;
        return prepared.open();
    }

    /// The first half of `openReader`, with no I/O (ADR-0024): the version's lookup and its pins. `open` then reads
    /// without the store, so it may run without the store's lock: the pins keep the version's extents, or the
    /// segment holding its inline record, on disk until the reader is dropped.
    fn prepareReader(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        from: u64,
        to: u64,
    ) -> Result<PreparedReader, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        let v = match (this.state.index.get(borrow k)) {
            Some(v) => v,
            null => { return Err(StoreError.NoSuchKey); }
        };
        let end = if (to > v.size) v.size else to;
        let start = if (from > end) end else from;
        if (v.extents.length != 0) {
            var refs = Vector<ExtentRef>.create();
            refs.extend(v.extents.view())?;
            let extents = ExtentReader.create(this.extentDir.view(), refs, start, end)?;
            let pin = this.pins.pin(v.extents.view())?;
            return Ok(PreparedReader {
                reader: ObjectReader { inline: Vector<u8>.create(), inlinePosition: 0, extents: extents, pin: pin },
                record: null,
            });
        }
        let payloadStart = v.recordLength as usize - RECORD_TRAILER_LEN - v.payload.length as usize;
        let path = match (this.journal.segmentFile(v.recordSegment)) {
            Ok(p) => p,
            Err(e) => { return Err(StoreError.Journal(e)); }
        };
        let record = InlineRecord {
            path: path,
            segment: v.recordSegment,
            offset: v.payload.offset + v.payload.length as u64 + RECORD_TRAILER_LEN as u64 - v.recordLength as u64,
            length: v.recordLength,
            from: payloadStart + start as usize,
            to: payloadStart + end as usize,
            pin: this.segmentPins.pinOne(v.recordSegment)?,
        };
        return Ok(PreparedReader { reader: null, record: record });
    }

    /// A reader that does not pin its extents: only for reads that end before the store is released (fsck,
    /// `getObjectRange`), since no reap can run while the store is borrowed.
    fn openUnpinned(
        borrow this,
        bucket: StringView,
        key: StringView,
        from: u64,
        to: u64,
    ) -> Result<ObjectReader, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        let v = match (this.state.index.get(borrow k)) {
            Some(v) => v,
            null => { return Err(StoreError.NoSuchKey); }
        };
        let end = if (to > v.size) v.size else to;
        let start = if (from > end) end else from;
        if (v.extents.length == 0) {
            // The whole record is read and verified, so a GET never serves rotted bytes:
            // recovery no longer scans the segments a checkpoint covers (ADR-0005).
            let record = this.readLiveRecord(v)?;
            let payloadStart = v.recordLength as usize - RECORD_TRAILER_LEN - v.payload.length as usize;
            var bytes = Vector<u8>.create();
            bytes.extend(record.view()[payloadStart + start as usize..payloadStart + end as usize])?;
            return Ok(ObjectReader { inline: bytes, inlinePosition: 0, extents: null, pin: null });
        }
        var refs = Vector<ExtentRef>.create();
        refs.extend(v.extents.view())?;
        let reader = ExtentReader.create(this.extentDir.view(), refs, start, end)?;
        return Ok(ObjectReader { inline: Vector<u8>.create(), inlinePosition: 0, extents: reader, pin: null });
    }

    /// The object's bytes `[from, to)` in memory (the whole object for 0, u64 max).
    fn getObjectRange(
        borrow this,
        bucket: StringView,
        key: StringView,
        from: u64,
        to: u64,
    ) -> Result<Vector<u8>, StoreError> {
        var reader = this.openUnpinned(bucket, key, from, to)?;
        var out = Vector<u8>.create();
        var chunk = Vector<u8>.create();
        chunk.resize(65536, 0)?;
        while (true) {
            let n = reader.read(mut chunk.viewMut())?;
            if (n == 0) { break; }
            out.extend(chunk.view()[0..n])?;
        }
        return Ok(out);
    }

    fn getObject(borrow this, bucket: StringView, key: StringView) -> Result<Vector<u8>, StoreError> =>
        this.getObjectRange(bucket, key, 0, 0xFFFFFFFFFFFFFFFF);

    /// Deletes the key's object. Deleting a missing key succeeds, as in S3.
    fn deleteObject(borrow mut this, bucket: StringView, key: StringView) -> Result<void, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        ObjectStore.checkKey(key)?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        if (this.currentGeneration(bucket, key)?.isNull()) { return Ok(); }
        this.scratch.clear();
        encodeDeleteMeta(mut this.scratch, bucket.bytes(), key.bytes(), nullVersionId(), Clock.unixMillis())?;
        let empty = [0u8; 1];
        this.commitOne(RecordType.DeleteVersion, empty[0..0])?;
        return Ok();
    }

    /// Stages the delete of `key` without committing it (ADR-0025), as `putFinishedDeferred` stages a PUT: the caller
    /// acknowledges it once `isPublished` says so. Returns the delete record's LSN, or null when there is nothing to
    /// write: the key is missing and no write is staged or in flight that could still create it.
    fn deleteObjectDeferred(borrow mut this, bucket: StringView, key: StringView) -> Result<u64?, StoreError> {
        this.checkWritable()?;
        ObjectStore.checkKey(key)?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        // The index shows only published writes. A PUT of this key may be staged or in its sync, and the delete
        // must then still follow it; a delete of a missing key applies as nothing.
        let unpublished = this.pendingApplies.length > 0 || this.inflightApplies.length > 0;
        if (!unpublished && this.currentGeneration(bucket, key)?.isNull()) { return Ok(null); }
        return Ok(this.stageDelete(bucket.bytes(), key.bytes(), Clock.unixMillis())?);
    }

    /// Deletes many keys of `bucket` with one commit: one journal write and one sync for the batch (ADR-0010). The
    /// result says, per key, whether it was valid; a missing key is deleted, as in S3. Nothing is acknowledged
    /// before the batch is durable: on an error none of it is.
    fn deleteObjects(borrow mut this, bucket: StringView, keys: Slice<Vector<u8>>) -> Result<Vector<bool>, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        var valid = Vector<bool>.create();
        let now = Clock.unixMillis();
        for (i in 0..keys.length) {
            let key = keys[i].view();
            if (key.length == 0 || key.length > MAX_KEY_BYTES) {
                valid.push(false)?;
                continue;
            }
            valid.push(true)?;
            let k = this.state.keyFor(bucket.bytes(), key)?;
            if (!this.state.index.contains(borrow k)) { continue; }
            match (this.stageDelete(bucket.bytes(), key, now)) {
                Ok(_) => {}
                Err(e) => {
                    this.journal.discardPending();
                    this.pendingApplies.clear();
                    return Err(e);
                }
            }
        }
        this.commitStaged()?;
        return Ok(valid);
    }

    /// Stages the DeleteVersion record of `key` and returns its LSN; a full batch, or a full segment, is committed
    /// first (ADR-0022).
    fn stageDelete(borrow mut this, bucket: Slice<u8>, key: Slice<u8>, now: i64) -> Result<u64, StoreError> {
        var meta = Vector<u8>.create();
        encodeDeleteMeta(mut meta, bucket, key, nullVersionId(), now)?;
        let empty = [0u8; 1];
        if (this.journal.wouldOverflow(meta.length, 0) || this.journal.needsRotation()) { this.commitStaged()?; }
        this.pendingApplies.reserve(1)?;
        let pos = this.journal.stage(RecordType.DeleteVersion, meta.view(), empty[0..0])?;
        this.pendingApplies.push(PendingApply {
            kind: RecordType.DeleteVersion,
            lsn: pos.lsn,
            segment: pos.segmentId,
            offset: pos.offset,
            total: truncate<u32>(recordLength(meta.length, 0)),
            meta: meta,
            payloadLen: 0,
            manifest: Vector<u8>.create(),
        })?;
        return Ok(pos.lsn);
    }

    // ---- Multipart uploads (ADR-0009) ----

    /// Begins a multipart upload of `key`; returns its id.
    fn createUpload(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
    ) -> Result<[u8; 16], StoreError> =>
        this.createUploadWith(bucket, key, contentType, "".bytes(), ChecksumAlgorithm.None, ChecksumType.FullObject);

    /// `createUpload` with the stored fields the completed object will have (ADR-0012), and the checksum its parts
    /// carry and how the object's comes from them (ADR-0015). A FULL_OBJECT checksum must be a CRC.
    fn createUploadWith(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        contentType: StringView,
        metadata: Slice<u8>,
        algorithm: ChecksumAlgorithm,
        kind: ChecksumType,
    ) -> Result<[u8; 16], StoreError> {
        this.commitStaged()?;
        if (metadata.length > MAX_METADATA_BYTES) { return Err(StoreError.MetadataTooLarge); }
        this.checkWritable()?;
        ObjectStore.checkKey(key)?;
        if (contentType.length > MAX_CONTENT_TYPE) { return Err(StoreError.InvalidKey); }
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        this.admit(0)?;
        var id = [0u8; 16];
        while (true) {
            Random.fill(mut id[..])!;
            let uk = UploadKey { id: id };
            if (!this.state.uploads.contains(borrow uk)) { break; }
        }
        this.scratch.clear();
        encodeUploadCreateMeta(
            mut this.scratch,
            id,
            bucket.bytes(),
            key.bytes(),
            Clock.unixMillis(),
            contentType.bytes(),
            metadata,
            algorithm,
            kind,
        )?;
        let empty = [0u8; 1];
        this.commitOne(RecordType.UploadCreate, empty[0..0])?;
        return Ok(id);
    }

    /// Whether `id` is an upload of this bucket and key.
    fn findUpload(borrow this, bucket: StringView, key: StringView, id: [u8; 16]) -> Result<void, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let uk = UploadKey { id: id };
        match (this.state.uploads.get(borrow uk)) {
            Some(u) => {
                if (u.bucket.view() != bucket.bytes() || u.key.view() != key.bytes()) {
                    return Err(StoreError.NoSuchUpload);
                }
                return Ok();
            }
            null => { return Err(StoreError.NoSuchUpload); }
        }
    }

    /// A writer for one part: it has no inline buffer, so every byte goes to extents.
    fn newPartWriter(borrow this) -> Result<ObjectWriter, StoreError> =>
        Ok(ObjectWriter.create(this.extentDir.view(), 0, this.config.extentMaxBytes, this.abandoned.clone())?);

    /// Checks that a part of `size` bytes may be uploaded: the upload exists and the size is admitted.
    fn checkPart(
        borrow this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        number: u32,
        size: u64,
    ) -> Result<void, StoreError> {
        this.checkWritable()?;
        if (number < 1 || number > MAX_PART_NUMBER) { return Err(StoreError.InvalidPartNumber); }
        this.findUpload(bucket, key, id)?;
        if (size > this.config.maxObjectBytes) { return Err(StoreError.EntityTooLarge); }
        this.admit(size)?;
        return Ok();
    }

    /// Commits a finished part of an upload, replacing a part of the same number; returns its MD5. On a refusal its
    /// extents are removed.
    fn putPart(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        number: u32,
        obj: borrow FinishedObject,
    ) -> Result<[u8; 16], StoreError> => this.putPartWith(bucket, key, id, number, "".bytes(), obj);

    /// `putPart` with the part's checksum in the upload's algorithm (ADR-0015; empty for none).
    fn putPartWith(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        number: u32,
        checksum: Slice<u8>,
        obj: borrow FinishedObject,
    ) -> Result<[u8; 16], StoreError> {
        this.commitStaged()?;
        if (checksum.length > 0 && checksum.length != checksumLength(this.uploadAlgorithm(id))) {
            this.discardFinished(obj);
            return Err(StoreError.InvalidPart);
        }
        var manifest = Vector<u8>.create();
        let checked = match (borrow obj.body) {
            ObjectBody.Extents(extents) => {
                encodeManifest(mut manifest, extents.view())?;
                this.checkPart(bucket, key, id, number, obj.size)
            }
            ObjectBody.Inline(data) => {
                // A part writer spills every byte, so only an empty part is inline.
                encodeManifest(mut manifest, Vector<ExtentRef>.create().view())?;
                if (data.length != 0) Err(StoreError.InvalidPart) else this.checkPart(bucket, key, id, number, 0)
            }
        };
        match (checked) {
            Ok() => {}
            Err(e) => {
                this.discardFinished(obj);
                return Err(e);
            }
        }
        this.scratch.clear();
        encodeUploadPartMeta(mut this.scratch, id, number, obj.size, obj.md5, Clock.unixMillis(), checksum)?;
        this.counts.payloadBytes += obj.size;
        match (borrow obj.body) {
            ObjectBody.Extents(extents) => { this.counts.extentBytesWritten += extentRefBytes(extents.view()); }
            ObjectBody.Inline(_) => {}
        }
        this.commitOne(RecordType.UploadPart, manifest.view())?;
        return Ok(obj.md5);
    }

    /// Discards an upload and its parts.
    fn abortUpload(borrow mut this, bucket: StringView, key: StringView, id: [u8; 16]) -> Result<void, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        this.findUpload(bucket, key, id)?;
        this.scratch.clear();
        encodeUploadAbortMeta(mut this.scratch, id, Clock.unixMillis())?;
        let empty = [0u8; 1];
        this.commitOne(RecordType.UploadAbort, empty[0..0])?;
        return Ok();
    }

    /// Makes the named parts, in order, the key's current version, and ends the upload. Parts it does not name are
    /// removed. The outcome's MD5 is the multipart ETag's digest.
    fn completeUpload(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        chosen: Slice<PartChoice>,
    ) -> Result<PutOutcome, StoreError> =>
        this.completeUploadIf(bucket, key, id, chosen, PutCondition.None, "".bytes());

    /// `completeUpload` if `condition` holds for the key's current version, checked with the commit (ADR-0014). A
    /// retry of a completion whose object is still current gets the first answer, whatever its parts and condition.
    fn completeUploadIf(
        borrow mut this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        chosen: Slice<PartChoice>,
        condition: PutCondition,
        expected: Slice<u8>,
    ) -> Result<PutOutcome, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        var manifest = Vector<u8>.create();
        var meta = Vector<u8>.create();
        var extrasBlob = Vector<u8>.create();
        {
            match (this.findUpload(bucket, key, id)) {
                Ok() => {}
                Err(StoreError.NoSuchUpload) => {
                    match (this.repeatedCompletion(bucket, key, id)?) {
                        Some(outcome) => { return Ok(outcome); }
                        null => { return Err(StoreError.NoSuchUpload); }
                    }
                }
                Err(e) => { return Err(e); }
            }
            let current = this.currentGeneration(bucket, key)?;
            match (condition) {
                PutCondition.None => {}
                PutCondition.IfAbsent => {
                    if (current.isSome()) { return Err(StoreError.PreconditionFailed); }
                }
                PutCondition.IfGeneration(g) => {
                    if ((current ?? 0) != g) { return Err(StoreError.PreconditionFailed); }
                }
            }
            let uk = UploadKey { id: id };
            let u = match (this.state.uploads.get(borrow uk)) {
                Some(u) => u,
                null => { return Err(StoreError.NoSuchUpload); }
            };
            if (chosen.length == 0) { return Err(StoreError.InvalidPart); }
            var extents = Vector<ExtentRef>.create();
            var md5s = Vector<[u8; 16]>.create();
            // The parts' sizes and checksums, for the object's checksum and its part layout (ADR-0015).
            var extras = ObjectExtras.none();
            let checksumBytes = checksumLength(u.checksumAlgorithm);
            var allChecksummed = checksumBytes > 0;
            var size: u64 = 0;
            var next: usize = 0;
            for (c in 1..chosen.length) {
                if (chosen[c].number <= chosen[c - 1].number) { return Err(StoreError.InvalidPartOrder); }
            }
            for (c in 0..chosen.length) {
                let want = borrow chosen[c];
                // Parts are in ascending number, as are the choices: one pass finds them all.
                while (next < u.parts.length && u.parts[next].number < want.number) { next += 1; }
                if (next == u.parts.length || u.parts[next].number != want.number) {
                    return Err(StoreError.InvalidPart);
                }
                let part = borrow u.parts[next];
                if (part.md5[..] != want.md5[..]) { return Err(StoreError.InvalidPart); }
                let named = want.checksumLength as usize;
                if (named > 0 && (part.checksum.length != named || part.checksum.view() != want.checksum[0..named])) {
                    return Err(StoreError.InvalidPart);
                }
                extras.partSizes.push(part.size)?;
                if (part.checksum.length == checksumBytes && checksumBytes > 0) {
                    extras.partChecksums.extend(part.checksum.view())?;
                } else {
                    allChecksummed = false;
                }
                if (c + 1 < chosen.length && part.size < this.config.minPartBytes) {
                    return Err(StoreError.EntityTooSmall);
                }
                size += part.size;
                extents.extend(part.extents.view())?;
                md5s.push(part.md5)?;
            }
            if (size > this.config.maxUploadBytes) { return Err(StoreError.EntityTooLarge); }
            if (allChecksummed) {
                extras.algorithm = u.checksumAlgorithm;
                extras.kind = u.checksumType;
                extras.value = multipartChecksum(
                    u.checksumAlgorithm,
                    u.checksumType,
                    extras.partChecksums.view(),
                    extras.partSizes.view(),
                )?;
            } else {
                extras.partChecksums.clear(); // the layout alone
            }
            if (expected.length > 0 && expected != extras.value.view()) { return Err(StoreError.BadDigest); }
            extras.encode(mut extrasBlob)?;
            encodeManifest(mut manifest, extents.view())?;
            encodeUploadCompleteMeta(
                mut meta,
                bucket.bytes(),
                key.bytes(),
                Clock.unixMillis(),
                size,
                multipartEtag(md5s.view()),
                u.contentType.view(),
                u.metadata.view(),
                id,
                truncate<u32>(chosen.length),
                extrasBlob.view(),
            )?;
        }
        this.scratch.clear();
        this.scratch.extend(meta.view())?;
        let lsn = this.commitOne(RecordType.UploadComplete, manifest.view())?;
        let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
        let md5 = match (this.state.index.get(borrow k)) {
            Some(v) => v.md5,
            null => [0u8; 16],
        };
        return Ok(PutOutcome { md5: md5, generation: lsn, parts: truncate<u32>(chosen.length), extras: extrasBlob });
    }

    /// The first answer to the completion of `id`, if its object is still the key's current version.
    fn repeatedCompletion(
        borrow this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
    ) -> Result<PutOutcome?, StoreError> {
        for (c in this.state.completions.view()) {
            if (c.id[..] != id[..] || c.bucket.view() != bucket.bytes() || c.key.view() != key.bytes()) { continue; }
            let k = this.state.keyFor(bucket.bytes(), key.bytes())?;
            match (this.state.index.get(borrow k)) {
                Some(v) => {
                    if (v.lsn == c.generation) {
                        return Ok(PutOutcome {
                            md5: v.md5,
                            generation: v.lsn,
                            parts: v.parts,
                            extras: copyBytes(v.extras.view())?,
                        });
                    }
                }
                null => {}
            }
            return Ok(null);
        }
        return Ok(null);
    }

    /// The uploads of `bucket` whose keys start with `prefix`, in key order, then by initiation. The listing starts
    /// after `keyMarker`, or, with `idMarker`, after that upload of `keyMarker`.
    fn listUploads(
        borrow this,
        bucket: StringView,
        prefix: Slice<u8>,
        keyMarker: Slice<u8>,
        idMarker: [u8; 16]?,
        maxUploads: usize,
    ) -> Result<UploadListing, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let uploads = borrow this.state.uploads;
        // Where the marker upload sorts, if it is one of this key's.
        var markerAt: i64? = null;
        match (idMarker) {
            Some(mid) => {
                let uk = UploadKey { id: mid };
                match (uploads.get(borrow uk)) {
                    Some(u) => {
                        if (u.key.view() == keyMarker) { markerAt = u.initiatedMillis; }
                    }
                    null => {}
                }
            }
            null => {}
        }
        var matches = Vector<usize>.create();
        for (i in 0..uploads.length()) {
            let u = uploads.valueAt(i);
            if (u.bucket.view() != bucket.bytes() || !startsWithBytes(u.key.view(), prefix)) { continue; }
            let order = compareBytes(u.key.view(), keyMarker);
            if (keyMarker.length > 0 && order < 0) { continue; }
            if (keyMarker.length > 0 && order == 0) {
                match (markerAt) {
                    Some(t) => {
                        let id = uploads.keyAt(i).id;
                        let after = u.initiatedMillis > t ||
                            (u.initiatedMillis == t && compareBytes(id[..], (idMarker ?? [0u8; 16])[..]) > 0);
                        if (!after) { continue; }
                    }
                    null => { continue; }
                }
            }
            matches.push(i)?;
        }
        matches.viewMut().sortBy((a, b) => {
            let ua = uploads.valueAt(a);
            let ub = uploads.valueAt(b);
            let byKey = compareBytes(ua.key.view(), ub.key.view());
            if (byKey != 0) { return byKey; }
            if (ua.initiatedMillis != ub.initiatedMillis) {
                return if (ua.initiatedMillis < ub.initiatedMillis) -1 else 1;
            }
            let ia = uploads.keyAt(a).id;
            let ib = uploads.keyAt(b).id;
            return compareBytes(ia[..], ib[..]);
        });
        var listing = UploadListing { uploads: Vector<UploadSummary>.create(), truncated: false };
        for (m in matches.view()) {
            if (listing.uploads.length == maxUploads) {
                listing.truncated = true;
                break;
            }
            let u = uploads.valueAt(m);
            listing.uploads.push(UploadSummary {
                key: copyBytes(u.key.view())?,
                id: uploads.keyAt(m).id,
                initiatedMillis: u.initiatedMillis,
            })?;
        }
        return Ok(listing);
    }

    /// The parts of an upload after part number `after`, at most `maxParts`.
    fn listParts(
        borrow this,
        bucket: StringView,
        key: StringView,
        id: [u8; 16],
        after: u32,
        maxParts: usize,
    ) -> Result<PartListing, StoreError> {
        this.findUpload(bucket, key, id)?;
        let uk = UploadKey { id: id };
        let u = match (this.state.uploads.get(borrow uk)) {
            Some(u) => u,
            null => { return Err(StoreError.NoSuchUpload); }
        };
        var listing = PartListing {
            parts: Vector<PartSummary>.create(),
            truncated: false,
            algorithm: u.checksumAlgorithm,
            kind: u.checksumType,
        };
        for (i in 0..u.parts.length) {
            let p = borrow u.parts[i];
            if (p.number <= after) { continue; }
            if (listing.parts.length == maxParts) {
                listing.truncated = true;
                break;
            }
            listing.parts.push(PartSummary {
                number: p.number,
                size: p.size,
                md5: p.md5,
                mtimeMillis: p.mtimeMillis,
                checksum: copyBytes(p.checksum.view())?,
            })?;
        }
        return Ok(listing);
    }

    fn uploadCount(borrow this) -> usize => this.state.uploads.length();

    /// The checksum algorithm and type an upload's parts carry (ADR-0015); None for an unknown upload.
    fn uploadAlgorithm(borrow this, id: [u8; 16]) -> ChecksumAlgorithm {
        let uk = UploadKey { id: id };
        return match (this.state.uploads.get(borrow uk)) {
            Some(u) => u.checksumAlgorithm,
            null => ChecksumAlgorithm.None,
        };
    }

    fn uploadChecksumType(borrow this, id: [u8; 16]) -> ChecksumType {
        let uk = UploadKey { id: id };
        return match (this.state.uploads.get(borrow uk)) {
            Some(u) => u.checksumType,
            null => ChecksumType.FullObject,
        };
    }

    /// The extent files the uploads' parts hold.
    fn uploadExtentCount(borrow this) -> u64 {
        var n: u64 = 0;
        for (i in 0..this.state.uploads.length()) {
            let u = this.state.uploads.valueAt(i);
            for (p in 0..u.parts.length) { n += u.parts[p].extents.length as u64; }
        }
        return n;
    }

    /// Lists keys of `bucket` that start with `prefix` and sort after `startAfter`, rolling up
    /// keys that contain `delimiter` after the prefix into common prefixes (S3 ListObjectsV2).
    /// The index is ordered (ADR-0026): the page seeks to its first key and reads on from there, and a common prefix
    /// skips the keys under it with one more seek, so a page costs its own keys, not the bucket's.
    fn listObjects(
        borrow this,
        bucket: StringView,
        prefix: StringView,
        delimiter: StringView,
        startAfter: Slice<u8>,
        startAfterIsPrefix: bool,
        maxKeys: usize,
    ) -> Result<ListPage, StoreError> {
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        let index = borrow this.state.index;
        var page = ListPage {
            keys: Vector<Vector<u8>>.create(),
            sizes: Vector<u64>.create(),
            md5s: Vector<[u8; 16]>.create(),
            mtimes: Vector<i64>.create(),
            parts: Vector<u32>.create(),
            commonPrefixes: Vector<Vector<u8>>.create(),
            truncated: false,
            nextMarker: Vector<u8>.create(),
            nextMarkerIsPrefix: false,
        };
        // The first candidate: the first key at or after the prefix, or past the marker if that comes later. A
        // marker that is a common prefix skips every key under it, even one that sorts before the prefix ("a" with
        // prefix "a/" skips everything).
        let first = this.state.keyFor(bucket.bytes(), prefix.bytes())?;
        var cursor = index.seek(borrow first);
        if (startAfter.length > 0) {
            cursor = laterOf(index, cursor, seekPast(index, first.bucket, startAfter, startAfterIsPrefix)?);
        }
        var returned: usize = 0;
        while (true) {
            let at = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            let entry = index.keyAt(at);
            // Keys are in (bucket, key) order: the first one outside the bucket or the prefix ends the listing.
            if (entry.bucket != first.bucket || !startsWithBytes(entry.key.view(), prefix.bytes())) { break; }
            let key = entry.key.view();
            var rolled: usize? = null;
            if (delimiter.length > 0) {
                match (findBytes(key, delimiter.bytes(), prefix.length)) {
                    Some(d) => { rolled = d + delimiter.length; }
                    null => {}
                }
            }
            if (returned == maxKeys) {
                page.truncated = true;
                break;
            }
            match (rolled) {
                Some(end) => {
                    let cp = key[0..end];
                    page.commonPrefixes.push(copyBytes(cp)?)?;
                    page.nextMarker.clear();
                    page.nextMarker.extend(cp)?;
                    page.nextMarkerIsPrefix = true;
                    // The other keys under this common prefix are rolled up into it: seek past them.
                    cursor = seekPast(index, first.bucket, cp, true)?;
                }
                null => {
                    page.keys.push(copyBytes(key)?)?;
                    let v = index.valueAt(at);
                    page.sizes.push(v.size)?;
                    page.md5s.push(v.md5)?;
                    page.mtimes.push(v.mtimeMillis)?;
                    page.parts.push(v.parts)?;
                    page.nextMarker.clear();
                    page.nextMarker.extend(key)?;
                    page.nextMarkerIsPrefix = false;
                    cursor = index.next(at);
                }
            }
            returned += 1;
        }
        return Ok(page);
    }

    /// Writes a checkpoint of the current state, so recovery replays only what follows it,
    /// and removes the previous checkpoint. Seals the active journal segment first, so the
    /// checkpoint covers whole segments (ADR-0005). Returns whether one was written (false when
    /// nothing was committed since the last one). The steps of ADR-0028 in a row, holding the store throughout; the
    /// server runs them with the lock released between steps (`serve.cee`).
    fn checkpoint(borrow mut this) -> Result<bool, StoreError> {
        var job = match (this.beginCheckpoint()?) {
            Some(j) => j,
            null => { return Ok(false); }
        };
        loop {
            let finished = match (this.checkpointStep(mut job, CHECKPOINT_STEP_ENTRIES)) {
                Ok(f) => f,
                Err(e) => {
                    job.abandon();
                    return Err(e);
                }
            };
            match (job.flush()) {
                Ok() => {}
                Err(e) => {
                    this.checkpointAbandoned(mut job);
                    return Err(e);
                }
            }
            if (finished) { break; }
        }
        match (job.publish()) {
            Ok(size) => { this.checkpointPublished(borrow job, size); }
            Err(e) => {
                this.checkpointAbandoned(mut job);
                return Err(e);
            }
        }
        return Ok(true);
    }

    /// Whether `maintain` would write a checkpoint now: `checkpointEveryBytes` committed since the last one.
    fn checkpointDue(borrow this) -> bool {
        let every = this.config.checkpointEveryBytes;
        return every > 0 && this.sinceCheckpoint >= every;
    }

    /// Starts a checkpoint (ADR-0028): commits what is staged, seals the active segment, and begins the job, with a
    /// snapshot of the index as of the last LSN. Null when nothing was committed since the last checkpoint. A job
    /// that was given up without a word (its task cancelled) is dropped first.
    fn beginCheckpoint(borrow mut this) -> Result<CheckpointJob?, StoreError> {
        if (this.state.index.snapshotActive()) { this.state.index.endSnapshot(); }
        this.commitStaged()?;
        this.checkWritable()?;
        let segment = this.journal.sealActive()?;
        let lsn = this.journal.upcomingLsn() - 1;
        if (lsn == this.checkpointLsn) { return Ok(null); }
        return Ok(beginCheckpointJob(this.dir.view(), lsn, segment, this.sinceCheckpoint, mut this.state)?);
    }

    /// Encodes the job's next `max` index entries (memory only). Returns whether it has all of them. On an error the
    /// snapshot ends; the caller abandons the job.
    fn checkpointStep(borrow mut this, job: borrow mut CheckpointJob, max: usize) -> Result<bool, StoreError> {
        return match (checkpointStepOf(job, mut this.state, max)) {
            Ok(f) => Ok(f),
            Err(e) => {
                this.state.index.endSnapshot();
                Err(e)
            }
        };
    }

    /// The job's file is published: segments before its segment may be compacted from now, and older checkpoints go.
    fn checkpointPublished(borrow mut this, job: borrow CheckpointJob, size: u64) {
        this.state.index.endSnapshot();
        this.counts.checkpointBytesWritten += size;
        this.counts.checkpoints += 1;
        this.checkpointLsn = job.lsn;
        this.checkpointSegment = job.segment;
        // What was committed during the job is not in the checkpoint.
        this.sinceCheckpoint =
            if (this.sinceCheckpoint > job.sinceBefore) this.sinceCheckpoint - job.sinceBefore else 0;
        removeCheckpoints(this.dir.view(), job.lsn, false);
    }

    /// Gives the job up: the snapshot ends, and the temporary file goes.
    fn checkpointAbandoned(borrow mut this, job: borrow mut CheckpointJob) {
        this.state.index.endSnapshot();
        job.abandon();
    }

    /// Reclaims sealed segments that the checkpoint covers and that are mostly garbage. Their
    /// live inline payloads are copied into Relocate records (keeping each version's generation),
    /// and once those are durable the segments are removed. Copies at most `maxCopyBytes` of
    /// live data, but always removes segments with nothing live.
    fn compact(borrow mut this, maxCopyBytes: u64) -> Result<CompactStats, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        var stats = CompactStats { segmentsRemoved: 0, bytesFreed: 0, relocated: 0, bytesCopied: 0 };
        // Candidates, fewest live bytes first.
        var candidates = Vector<SegmentFile>.create();
        for (i in 0..this.state.segments.length()) {
            let id: u64 = this.state.segments.keyAt(i);
            let u = this.state.segments.valueAt(i);
            if (id >= this.checkpointSegment) { continue; }
            if (u.liveBytes == 0 || u.liveBytes * 100 < u.totalBytes * this.config.compactBelowLivePercent) {
                candidates.push(SegmentFile { id: id, size: u.liveBytes })?;
            }
        }
        if (candidates.length == 0) { return Ok(stats); }
        candidates.viewMut().sortBy((a, b) => if (a.size < b.size) -1 else if (a.size > b.size) 1 else 0);
        var chosen = HashMap<u64, bool>.create();
        var budget: u64 = 0;
        for (i in 0..candidates.length) {
            let c = borrow candidates[i];
            if (c.size > 0 && budget + c.size > maxCopyBytes && chosen.length() > 0) { break; }
            budget += c.size;
            let _ = chosen.put(c.id, true)?;
        }
        // The live inline versions in the chosen segments.
        var plan = Vector<Relocation>.create();
        var cursor = this.state.index.first();
        while (true) {
            let i = match (cursor) {
                Some(c) => c,
                null => { break; }
            };
            cursor = this.state.index.next(i);
            let k = this.state.index.keyAt(i);
            let v = this.state.index.valueAt(i);
            if (v.extents.length != 0 || !chosen.contains(borrow v.recordSegment)) { continue; }
            plan.push(Relocation {
                bucket: copyBytes(this.state.bucketName(k.bucket))?,
                key: copyBytes(k.key.view())?,
                versionId: v.versionId,
                generation: v.lsn,
                segment: v.recordSegment,
                recordOffset: v.payload.offset +
                    v.payload.length as u64 + RECORD_TRAILER_LEN as u64 - v.recordLength as u64,
                recordLength: v.recordLength,
                payloadLength: v.payload.length,
            })?;
        }
        for (i in 0..plan.length) {
            match (this.stageRelocation(borrow plan[i])) {
                Ok() => {}
                Err(e) => {
                    this.journal.discardPending();
                    this.pendingApplies.clear();
                    return Err(e);
                }
            }
            stats.relocated += 1;
            stats.bytesCopied += plan[i].payloadLength as u64;
            this.counts.compactionBytesCopied += plan[i].payloadLength as u64;
        }
        this.commitStaged()?;
        // Every copy is durable and applied: the chosen segments hold nothing live.
        for (i in 0..chosen.length()) {
            let id: u64 = chosen.keyAt(i);
            let usage = this.segmentUsage(id);
            if (usage.liveBytes != 0) { continue; }
            // A reader still reads a record of it (ADR-0024): a later pass removes it, as after a crash here.
            if (this.segmentPins.isPinned(id)) { continue; }
            this.journal.removeSegment(id)?;
            let _ = this.state.segments.remove(borrow id);
            stats.segmentsRemoved += 1;
            this.counts.segmentsCompacted += 1;
            stats.bytesFreed += usage.totalBytes;
        }
        if (stats.segmentsRemoved > 0) { this.journal.syncDirectory()?; }
        return Ok(stats);
    }

    /// The verified record that holds an inline version's payload.
    fn readLiveRecord(borrow this, v: borrow ObjectVersion) -> Result<Vector<u8>, StoreError> {
        let offset = v.payload.offset + v.payload.length as u64 + RECORD_TRAILER_LEN as u64 - v.recordLength as u64;
        return match (this.journal.readRecord(v.recordSegment, offset, v.recordLength)) {
            Ok(bytes) => Ok(bytes),
            Err(JournalError.Corrupt(_, _)) => Err(StoreError.DataCorrupt),
            Err(e) => Err(StoreError.Journal(e)),
        };
    }

    /// Reads and verifies one live record, then stages its Relocate copy.
    fn stageRelocation(borrow mut this, r: borrow Relocation) -> Result<void, StoreError> {
        let record = match (this.journal.readRecord(r.segment, r.recordOffset, r.recordLength)) {
            Ok(bytes) => bytes,
            Err(JournalError.Corrupt(_, _)) => { return Err(StoreError.DataCorrupt); }
            Err(e) => { return Err(StoreError.Journal(e)); }
        };
        let end = r.recordLength as usize - RECORD_TRAILER_LEN;
        let payload = record.view()[end - r.payloadLength as usize..end];
        var meta = Vector<u8>.create();
        encodeRelocateMeta(mut meta, r.bucket.view(), r.key.view(), r.versionId, r.generation)?;
        if (this.journal.wouldOverflow(meta.length, payload.length)) { this.commitStaged()?; }
        this.pendingApplies.reserve(1)?;
        let pos = this.journal.stage(RecordType.Relocate, meta.view(), payload)?;
        this.pendingApplies.push(PendingApply {
            kind: RecordType.Relocate,
            lsn: pos.lsn,
            segment: pos.segmentId,
            offset: pos.offset,
            total: truncate<u32>(recordLength(meta.length, payload.length)),
            meta: meta,
            payloadLen: truncate<u32>(payload.length),
            manifest: Vector<u8>.create(),
        })?;
        return Ok();
    }

    /// Background upkeep: a checkpoint when one is due, then compaction.
    fn maintain(borrow mut this) -> Result<MaintenanceReport, StoreError> => this.upkeep(true);

    /// `maintain`, with or without its checkpoint: the server writes checkpoints in steps of its own (ADR-0028).
    fn upkeep(borrow mut this, withCheckpoint: bool) -> Result<MaintenanceReport, StoreError> {
        this.reapDeferred();
        this.reapAbandoned();
        this.pins.prune();
        this.segmentPins.prune();
        var expired: u64 = 0;
        let expiry = this.config.uploadExpiryMillis;
        let now = Clock.unixMillis();
        if (expiry > 0 && now > truncate<i64>(expiry)) { expired = this.expireUploads(now - truncate<i64>(expiry))?; }
        var checkpointed = false;
        if (withCheckpoint && this.checkpointDue()) { checkpointed = this.checkpoint()?; }
        let compaction = this.compact(this.config.compactMaxCopyBytes)?;
        var lifecycle = LifecycleReport { objectsExpired: 0, uploadsAborted: 0 };
        let lifecycleEvery = this.config.lifecycleEveryMillis;
        if (lifecycleEvery > 0 && now - this.lifecycleRan >= truncate<i64>(lifecycleEvery)) {
            lifecycle = this.applyLifecycle(now)?;
            this.lifecycleRan = now;
        }
        return Ok(MaintenanceReport {
            checkpointed: checkpointed,
            compaction: compaction,
            uploadsExpired: expired,
            lifecycle: lifecycle,
        });
    }

    // ---- Bucket configuration (ADR-0020) ----

    /// Sets a bucket's tags (kind BUCKET_CONFIG_TAGS) or lifecycle rules (BUCKET_CONFIG_LIFECYCLE); an empty value
    /// clears it. One BucketConfig record, durable before this returns.
    fn setBucketConfig(borrow mut this, bucket: StringView, kind: u8, value: Slice<u8>) -> Result<void, StoreError> {
        this.commitStaged()?;
        this.checkWritable()?;
        if (!this.state.hasBucket(bucket.bytes())?) { return Err(StoreError.NoSuchBucket); }
        if (value.length > 1048576) { return Err(StoreError.MetadataTooLarge); }
        this.scratch.clear();
        encodeBucketConfigMeta(mut this.scratch, bucket.bytes(), kind, value)?;
        let empty = [0u8; 1];
        this.commitOne(RecordType.BucketConfig, empty[0..0])?;
        return Ok();
    }

    /// A bucket's tags or lifecycle rules, as stored; empty for none.
    fn bucketConfig(borrow this, bucket: StringView, kind: u8) -> Result<Vector<u8>, StoreError> {
        let k = BucketKey { name: copyBytes(bucket.bytes())? };
        return match (this.state.buckets.get(borrow k)) {
            Some(b) => Ok(copyBytes(if (kind == BUCKET_CONFIG_TAGS) b.tags.view() else b.lifecycle.view())?),
            null => Err(StoreError.NoSuchBucket),
        };
    }

    /// Applies every bucket's lifecycle rules as of `nowMillis`: deletes the objects a rule has expired (one batch per
    /// bucket, as DeleteObjects does) and aborts the uploads a rule's AbortIncompleteMultipartUpload has. At most
    /// LIFECYCLE_BATCH objects per bucket and run, so the store's lock is never held long; the rest wait for the next.
    fn applyLifecycle(borrow mut this, nowMillis: i64) -> Result<LifecycleReport, StoreError> {
        var report = LifecycleReport { objectsExpired: 0, uploadsAborted: 0 };
        var names = Vector<Vector<u8>>.create();
        for (i in 0..this.state.buckets.length()) {
            if (this.state.buckets.valueAt(i).lifecycle.length > 0) {
                names.push(copyBytes(this.state.buckets.keyAt(i).name.view())?)?;
            }
        }
        for (n in 0..names.length) {
            let bucketName = names[n].view();
            let k = BucketKey { name: copyBytes(bucketName)? };
            let blob = match (this.state.buckets.get(borrow k)) {
                Some(b) => copyBytes(b.lifecycle.view())?,
                null => { continue; }
            };
            let rules = match (decodeLifecycle(blob.view())) {
                Ok(r) => r,
                Err(_) => { return Err(StoreError.DataCorrupt); }
            };
            // Objects that some rule has expired.
            var expired = Vector<Vector<u8>>.create();
            // The bucket's keys are one run of the index: from its first key to the next bucket's.
            let start = this.state.keyFor(bucketName, "".bytes())?;
            var cursor = this.state.index.seek(borrow start);
            while (true) {
                let i = match (cursor) {
                    Some(c) => c,
                    null => { break; }
                };
                cursor = this.state.index.next(i);
                if (expired.length == LIFECYCLE_BATCH) { break; }
                let key = this.state.index.keyAt(i);
                if (key.bucket != start.bucket) { break; }
                let v = this.state.index.valueAt(i);
                let tags = match (metadataValue(v.metadata.view(), TAGS_FIELD.bytes())) {
                    Ok(t) => t,
                    Err(_) => Vector<u8>.create(),
                };
                for (r in 0..rules.length) {
                    if (!ruleMatches(borrow rules[r], key.key.view(), v.size, tags.view())) { continue; }
                    match (expiresAt(borrow rules[r], v.mtimeMillis)) {
                        Some(at) => {
                            if (nowMillis >= at) {
                                expired.push(copyBytes(key.key.view())?)?;
                                break;
                            }
                        }
                        null => {}
                    }
                }
            }
            if (expired.length > 0) {
                let bucketText = StringView.fromUtf8(bucketName) ?? "";
                let _ = this.deleteObjects(bucketText, expired.view())?;
                report.objectsExpired += expired.length as u64;
            }
            // Uploads that some rule aborts.
            var old = Vector<[u8; 16]>.create();
            for (i in 0..this.state.uploads.length()) {
                let u = this.state.uploads.valueAt(i);
                if (u.bucket.view() != bucketName) { continue; }
                for (r in 0..rules.length) {
                    let rule = borrow rules[r];
                    if (!rule.enabled || rule.abortDays == 0 || !startsWithBytes(u.key.view(), rule.prefix.view())) {
                        continue;
                    }
                    if (nowMillis >= u.initiatedMillis + (rule.abortDays as i64) * DAY_MILLIS) {
                        old.push(this.state.uploads.keyAt(i).id)?;
                        break;
                    }
                }
            }
            for (id in old.view()) {
                this.checkWritable()?;
                this.scratch.clear();
                encodeUploadAbortMeta(mut this.scratch, id, nowMillis)?;
                let empty = [0u8; 1];
                this.commitOne(RecordType.UploadAbort, empty[0..0])?;
                report.uploadsAborted += 1;
            }
        }
        return Ok(report);
    }

    /// Aborts every upload initiated before `cutoffMillis` (Unix milliseconds), each with its own UploadAbort record,
    /// as AbortMultipartUpload would; returns how many.
    fn expireUploads(borrow mut this, cutoffMillis: i64) -> Result<u64, StoreError> {
        var old = Vector<[u8; 16]>.create();
        for (i in 0..this.state.uploads.length()) {
            if (this.state.uploads.valueAt(i).initiatedMillis < cutoffMillis) {
                old.push(this.state.uploads.keyAt(i).id)?;
            }
        }
        for (id in old.view()) {
            this.checkWritable()?;
            this.scratch.clear();
            encodeUploadAbortMeta(mut this.scratch, id, Clock.unixMillis())?;
            let empty = [0u8; 1];
            this.commitOne(RecordType.UploadAbort, empty[0..0])?;
        }
        return Ok(old.length as u64);
    }

    // Statistics.
    fn objectCount(borrow this) -> usize => this.state.index.length();

    /// Bytes in journal segments (records and recovered segment files), and their number.
    fn journalBytes(borrow this) -> u64 {
        var total: u64 = 0;
        for (i in 0..this.state.segments.length()) { total += this.state.segments.valueAt(i).totalBytes; }
        return total;
    }

    fn segmentCount(borrow this) -> usize => this.state.segments.length();

    /// Retired extents that wait for readers, and extents that open readers pin (ADR-0007).
    fn deferredExtentCount(borrow this) -> usize => this.deferred.length;
    fn pinnedExtentCount(borrow this) -> usize => this.pins.pinnedCount();

    /// The segments the store accounts for (a new active segment with no record yet is not among them).
    fn segmentIds(borrow this) -> Vector<u64> {
        var ids = Vector<u64>.create();
        for (i in 0..this.state.segments.length()) {
            let id: u64 = this.state.segments.keyAt(i);
            ids.push(id)!;
        }
        return ids;
    }

    /// The LSN the newest checkpoint covers (0: none).
    fn lastCheckpoint(borrow this) -> u64 => this.checkpointLsn;

    fn recordsApplied(borrow this) -> u64 => this.state.records;

    fn journalSyncs(borrow this) -> u64 => this.journal.syncCount();

    /// The cumulative counters (ADR-0021).
    fn counters(borrow this) -> StoreCounters => StoreCounters {
        payloadBytes: this.counts.payloadBytes,
        journalBytesWritten: this.counts.journalBytesWritten,
        extentBytesWritten: this.counts.extentBytesWritten,
        checkpointBytesWritten: this.counts.checkpointBytesWritten,
        compactionBytesCopied: this.counts.compactionBytesCopied,
        segmentsCompacted: this.counts.segmentsCompacted,
        checkpoints: this.counts.checkpoints,
    };

    /// (total, live) bytes of a segment.
    fn segmentUsage(borrow this, segment: u64) -> SegmentUsage => match (this.state.segments.get(borrow segment)) {
        Some(u) => SegmentUsage { totalBytes: u.totalBytes, liveBytes: u.liveBytes },
        null => SegmentUsage { totalBytes: 0, liveBytes: 0 },
    };
}

/// Streams an object's bytes, from the journal (inline) or its extents.
/// An inline version's record, to be read without the store (ADR-0024).
struct InlineRecord {
    path: String;
    segment: u64;
    offset: u64;
    length: u32;
    /// The range to keep, as offsets in the record.
    from: usize;
    to: usize;
    /// Keeps the segment on disk until the record is read.
    pin: ReadPin;
}

/// A reader made by `ObjectStore.prepareReader`, opened by `open`: either the reader itself (extents, which open
/// lazily) or the inline record still to read.
struct PreparedReader {
    private reader: ObjectReader?;
    private record: InlineRecord?;

    /// Reads and verifies an inline record from its segment's own file (I/O, without the store); an extent reader
    /// is returned as it is.
    fn open(borrow mut this) -> Result<ObjectReader, StoreError> {
        match (replace(mut this.reader, null)) {
            Some(r) => { return Ok(r); }
            null => {}
        }
        let rec = match (replace(mut this.record, null)) {
            Some(r) => r,
            null => { return Err(StoreError.NoSuchKey); } // opened twice
        };
        let bytes = match (readRecordFile(rec.path.view(), rec.segment, rec.offset, rec.length)) {
            Ok(b) => b,
            Err(JournalError.Corrupt(_, _)) => { return Err(StoreError.DataCorrupt); }
            Err(e) => { return Err(StoreError.Journal(e)); }
        };
        var inline = Vector<u8>.create();
        inline.extend(bytes.view()[rec.from..rec.to])?;
        return Ok(ObjectReader { inline: inline, inlinePosition: 0, extents: null, pin: null });
    }
}

struct ObjectReader {
    private inline: Vector<u8>;
    private inlinePosition: usize;
    private extents: ExtentReader?;
    /// The extents' pins, released when the reader is dropped (ADR-0007).
    private pin: ReadPin?;

    /// An unread inline object's bytes, all at once (no I/O); null for an extent reader or one already read from.
    fn takeInline(borrow mut this) -> Vector<u8>? {
        if (this.extents.isSome() || this.inlinePosition != 0) { return null; }
        return replace(mut this.inline, Vector<u8>.create());
    }

    /// Reads the next bytes; 0 at the end.
    fn read(borrow mut this, into: SliceMut<u8>) -> Result<usize, StoreError> {
        match (this.extents.asBorrowMut()) {
            Some(r) => { return sio(r.read(into)); }
            null => {}
        }
        let left = this.inline.length - this.inlinePosition;
        let n = if (into.length < left) into.length else left;
        into[0..n].copyFrom(this.inline.view()[this.inlinePosition..this.inlinePosition + n]);
        this.inlinePosition += n;
        return Ok(n);
    }
}
