// The restore record (ADR-0102 §4): SetTags format 6 sets a version's restore state, its bytes untouched; its
// decode refuses what is not a state; and its fault sweep (ADR-0004).

const RESTORE_VALUE: StringView = "1000 90000";

fn putArchivedSeed(s: borrow mut ObjectStore) -> Result<void, StoreError> {
    var meta = Vector<u8>.create();
    metadataAdd(mut meta, STORAGE_CLASS_FIELD.bytes(), "GLACIER".bytes())?;
    let obj = s.writeAll(patterned(40000, 7).view())?;
    let _ = s.putFinishedWith("bkt", "archived", "", meta.view(), "".bytes(), borrow obj, PutCondition.None)?;
    return Ok();
}

fn restoreValueOf(s: borrow ObjectStore) -> Vector<u8>? {
    let info = s.headObject("bkt", "archived").ok() ?? { return null; };
    return match (metadataFind(info.metadata.view(), RESTORE_FIELD.bytes())) {
        Some(v) => copyBytes(v).ok(),
        null => null,
    };
}

/// A restore's state set, and read back after the journal and a checkpoint; a value that is not a state refused.
@test
fn restoreStatesAreKept() -> Result<void, TestFailure> {
    let dir = scratchDirectory("restore-state");
    {
        var s = ObjectStore.open(dir.view(), faultStoreConfig())!;
        s.createBucket("bkt")!;
        putArchivedSeed(mut s)!;
        let before = s.headObject("bkt", "archived")!;
        s.setFieldOf("bkt", "archived", null, RESTORE_VALUE.bytes(), SET_RESTORE_FORMAT)!;
        let after = s.headObject("bkt", "archived")!;
        Check.equalU64(before.generation, after.generation)?;
        // A value that is not a state is refused before it is written: the journal never holds a record that does not
        // decode (it would stop the store's next open).
        Check.isTrue(
            s.setFieldOf("bkt", "archived", null, "later sooner".bytes(), SET_RESTORE_FORMAT).isErr(),
            "refused",
        )?;
    }
    {
        let s = ObjectStore.open(dir.view(), faultStoreConfig())!;
        Check.equalBytes(RESTORE_VALUE.bytes(), restoreValueOf(borrow s)!.view())?;
    }
    Check.isFalse(isRestoreValue("later sooner".bytes()), "not a state")?;
    Check.isFalse(isRestoreValue("9 1".bytes()), "ready after its expiry")?;
    Check.isTrue(isRestoreValue(RESTORE_VALUE.bytes()), "a state")?;
    return Ok();
}

/// The workload: an archived version put, then its restore state set, then the upkeep's marks for its copy ready and
/// expired (ADR-0106 §4).
fn restoreWorkload(dir: StringView) {
    var s = match (ObjectStore.open(dir, faultStoreConfig())) {
        Ok(s) => s,
        Err(_) => { return; }
    };
    if (s.createBucket("bkt").isErr() || putArchivedSeed(mut s).isErr()) { return; }
    if (s.setFieldOf("bkt", "archived", null, RESTORE_VALUE.bytes(), SET_RESTORE_FORMAT).isErr()) { return; }
    if (s.restoreRound(1000).isErr()) { return; }
    let _ = s.restoreRound(90000);
}

/// The states a recovered store may hold: as set, or with either of the upkeep's marks.
fn isSweptRestore(v: Slice<u8>) -> bool =>
    v == RESTORE_VALUE.bytes() || v == "1000 90000 GLACIER c".bytes() || v == "1000 90000 GLACIER d".bytes();

/// A recovered store: the version, if there, holds its bytes, and no restore state or exactly the one set.
fn checkRestored(s: borrow ObjectStore) -> Result<void, TestFailure> {
    if (!s.bucketExists("bkt")!) { return Ok(); }
    match (s.getObject("bkt", "archived")) {
        Ok(bytes) => {
            Check.equalBytes(patterned(40000, 7).view(), bytes.view())?;
            match (restoreValueOf(s)) {
                Some(v) => { Check.isTrue(isSweptRestore(v.view()), "a state set, or marked")?; }
                null => {}
            }
        }
        Err(StoreError.NoSuchKey) => {}
        Err(_) => { return Check.fail("a version that does not read"); }
    }
    return Ok();
}

fn sweepRestore(name: StringView, mode: SweepMode) -> Result<void, TestFailure> {
    Faults.elideSyncs(true);
    let dir = scratchDirectory(name);
    Faults.countOperations();
    restoreWorkload(dir.view());
    Faults.disarm();
    let points = Faults.seen();
    Check.isTrue(points > 10, "the workload performs I/O")?;
    {
        let s = ObjectStore.open(dir.view(), faultStoreConfig())!;
        Check.equalBytes("1000 90000 GLACIER d".bytes(), restoreValueOf(borrow s)!.view())?;
    }
    for (n in 1..points + 1) {
        removeTree(dir.view());
        Fs.ensureDirectory(dir.view())!;
        armMode(borrow mode, n);
        restoreWorkload(dir.view());
        Faults.disarm();
        if (isCrash(borrow mode)) {
            Check.equalU64(0, Faults.violations())?;
            Faults.crash(dir.view())!;
        }
        {
            var s = ObjectStore.open(dir.view(), faultStoreConfig())!;
            checkRestored(borrow s)?;
            let _ = s.checkpoint()!;
        }
        let s = ObjectStore.open(dir.view(), faultStoreConfig())!;
        checkRestored(borrow s)?;
    }
    removeTree(dir.view());
    Faults.elideSyncs(false);
    return Ok();
}

@test
fn restoreFaultsOnce() -> Result<void, TestFailure> => sweepRestore("restore-once", SweepMode.Once);

@test
fn restoreFaultsSticky() -> Result<void, TestFailure> => sweepRestore("restore-sticky", SweepMode.Sticky);

@test
fn restoreFaultsTorn() -> Result<void, TestFailure> => sweepRestore("restore-torn", SweepMode.StickyTorn);

@test
fn restoreFaultsCrash() -> Result<void, TestFailure> => sweepRestore("restore-crash", SweepMode.Crash);

/// The kinds of the waiting events, as their numbers, in order.
fn restoreKinds(s: borrow ObjectStore) -> Vector<u8> {
    var out = Vector<u8>.create();
    let events = s.pendingEvents(1000)!;
    for (i in 0..events.length) {
        if (i > 0) { out.push(' ')!; }
        appendDecimal(mut out, events[i].kind as u64)!;
    }
    return out;
}

/// A restore's events (ADR-0106 §4): asked (:Post, 16), its copy ready (:Completed, 32) and expired (:Delete, 64),
/// each once, the upkeep marking the state as their times come; the watch found again after a reopen, and dropped
/// once it is done with.
@test
fn restoresRaiseTheirEvents() -> Result<void, TestFailure> {
    let dir = scratchDirectory("restore-events");
    {
        var s = ObjectStore.open(dir.view(), faultStoreConfig())!;
        s.createBucket("bkt")!;
        var rules = Vector<NotificationRule>.create();
        rules.push(notifyRule("r", "hook", EVENT_RESTORE_POST | EVENT_RESTORE_DONE | EVENT_RESTORE_DELETE, "", ""))!;
        setNotification(mut s, "bkt", borrow rules);
        putArchivedSeed(mut s)!;
        s.setFieldOf("bkt", "archived", null, "1000 90000 GLACIER".bytes(), SET_RESTORE_FORMAT)!;
        Check.equalBytes("16".bytes(), restoreKinds(borrow s).view())?;
        Check.isFalse(s.restoreDue(999), "not ready yet")?;
        Check.equalU64(0, s.restoreRound(999)!)?;
        Check.isTrue(s.restoreDue(1000), "ready")?;
        Check.equalU64(1, s.restoreRound(1000)!)?;
        Check.equalBytes("1000 90000 GLACIER c".bytes(), restoreValueOf(borrow s)!.view())?;
        Check.equalBytes("16 32".bytes(), restoreKinds(borrow s).view())?;
        Check.equalU64(0, s.restoreRound(5000)!)?; // said once
        // A state set again with the same times raises nothing.
        s.setFieldOf("bkt", "archived", null, "1000 90000 GLACIER c".bytes(), SET_RESTORE_FORMAT)!;
        Check.equalBytes("16 32".bytes(), restoreKinds(borrow s).view())?;
    }
    {
        // Reopened: the version is watched again, from its state as kept.
        var s = ObjectStore.open(dir.view(), faultStoreConfig())!;
        Check.equalU64(1, s.restoreRound(90000)!)?;
        Check.equalBytes("1000 90000 GLACIER d".bytes(), restoreValueOf(borrow s)!.view())?;
        let kinds = restoreKinds(borrow s);
        Check.isTrue(kinds.view().endsWith("64".bytes()), "its :Delete raised")?;
        Check.isTrue(s.restoreDue(100000), "an entry to drop")?;
        Check.equalU64(0, s.restoreRound(100000)!)?;
        Check.isFalse(s.restoreDue(100000), "dropped")?;
        // A new restore after it expired is asked again.
        s.setFieldOf("bkt", "archived", null, "200000 300000 GLACIER".bytes(), SET_RESTORE_FORMAT)!;
        Check.isTrue(restoreKinds(borrow s).view().endsWith("16".bytes()), "a new :Post")?;
        Check.isTrue(s.restoreDue(200000), "watched again")?;
    }
    Check.isTrue(isRestoreValue("1 2 GLACIER c".bytes()), "a mark")?;
    Check.isFalse(isRestoreValue("1 2 c".bytes()), "a mark needs its class")?;
    Check.isFalse(isRestoreValue("1 2 GLACIER x".bytes()), "a mark that is not one")?;
    removeTree(dir.view());
    return Ok();
}
