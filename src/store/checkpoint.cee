// Checkpoint files (ADR-0005). A checkpoint is the store's whole state (buckets and the current
// version of every key, with locators) after LSN `lsn`. It is taken right after the journal
// sealed its active segment, so every record up to `lsn` is in a segment before `segment`.
// Recovery loads the newest checkpoint and replays only segments from `segment` on.
//
// File `ckpt-<lsn as 16 hex>.ck` in the store directory. It is written as `ckpt-<lsn>.tmp`,
// synced, renamed, and then the directory is synced, so a file with the final name is
// complete. A final-named checkpoint that fails its checks is corruption: open fails rather
// than fall back, because segments it covered may already be gone. Little-endian:
//
// Header (64 bytes):
//   0 u64 magic "CSCKPT01"   8 u16 format (5; 1 to 4 still load)   10 u16 header length (64)   12 u32 flags (0)
//  16 u64 lsn   24 u64 segment   32 u64 bucket count   40 u64 object count   48 i64 created ms
//  56 u32 upload count (format 2; reserved, 0, in format 1)   60 u32 crc32c of bytes 0..60
// Entries, buckets, then objects, then uploads: u8 kind (1 bucket, 2 object, 3 upload), u32 body length, body.
//   bucket: u16+bytes name, i64 created ms, and in format 5 u32+bytes tags and u32+bytes lifecycle rules (ADR-0020)
//   object: u16+bytes bucket, u16+bytes key, 16 version id, u64 lsn, u64 size, i64 mtime ms,
//           16 md5, u16+bytes content type, u64 payload segment, u64 payload offset,
//           u32 payload length, u64 record segment, u32 record length, manifest (u32 count,
//           then u64 id, u64 length, u32 crc32c per extent), in format 2 a u32 part count (ADR-0009), and in
//           format 3 the metadata section (u16 pairs, each u16+bytes name, u16+bytes value; ADR-0012), and in
//           format 4 the extras section (u32 length + the blob of ADR-0015)
//   upload (format 2): 16 upload id, u16+bytes bucket, u16+bytes key, i64 initiated ms, u16+bytes content type,
//           u32 part count, then per part u32 number, u64 size, 16 md5, i64 mtime ms, manifest; in format 3 the
//           metadata section; in format 4 u8 checksum algorithm, u8 checksum type, then per part u8 length and its
//           checksum (ADR-0015)
// Trailer (16 bytes): u32 "CKND", u32 crc32c of every entry byte, u64 entry count.

const CHECKPOINT_MAGIC: u64 = 0x313054504B434353; // "CSCKPT01" in file order
const CHECKPOINT_TRAILER_MAGIC: u32 = 0x444E4B43; // "CKND" in file order
const CHECKPOINT_HEADER_LEN: usize = 64;
const CHECKPOINT_TRAILER_LEN: usize = 16;
const CHECKPOINT_FORMAT: u16 = 5;
const CHECKPOINT_BUCKET: u8 = 1;
const CHECKPOINT_OBJECT: u8 = 2;
const CHECKPOINT_UPLOAD: u8 = 3;
const CHECKPOINT_IO_CHUNK: usize = 1048576;
/// No single entry is larger: an upload of 10,000 parts of 5 GiB each, every part in 64 MiB extents, needs about
/// 16 MiB.
const CHECKPOINT_MAX_ENTRY: usize = 33554432;

/// `<dir>/ckpt-<lsn>.ck`, or `.tmp` while it is being written.
fn checkpointPath(dir: StringView, lsn: u64, temporary: bool) -> Result<String, AllocError> {
    var s = String.create();
    s.append(dir)?;
    s.append("/ckpt-")?;
    appendHex16Text(mut s, lsn)?;
    s.append(if (temporary) ".tmp" else ".ck")?;
    return Ok(s);
}

/// The checkpoint files in `dir`: complete ones (`temporary` false), or leftovers of
/// interrupted writes. Ascending LSN.
fn listCheckpoints(dir: StringView, temporary: bool) -> Result<Vector<u64>, StoreError> {
    let names = match (Directory.list(dir)) {
        Ok(n) => n,
        Err(_) => { return Err(StoreError.Io(IoFailure { op: IoOp.Open, errno: 0 })); }
    };
    let suffix = if (temporary) ".tmp" else ".ck";
    var lsns = Vector<u64>.create();
    for (i in 0..names.length) {
        let name = names[i].view();
        if (name.length == 21 + suffix.length && name.startsWith("ckpt-") && name.endsWith(suffix)) {
            match (name[5..21].parseIntRadix<u64>(16)) {
                Some(lsn) => { lsns.push(lsn)?; }
                null => {}
            }
        }
    }
    lsns.viewMut().sortBy((a, b) => if (a < b) -1 else if (a > b) 1 else 0);
    return Ok(lsns);
}

/// Removes checkpoint files: every complete one older than `keep`, or every leftover `.tmp`.
/// Best effort; a file that survives is harmless and removed next time.
fn removeCheckpoints(dir: StringView, keep: u64, temporary: bool) {
    let lsns = match (listCheckpoints(dir, temporary)) {
        Ok(l) => l,
        Err(_) => { return; }
    };
    var removed = false;
    for (i in 0..lsns.length) {
        if (temporary || lsns[i] < keep) {
            match (checkpointPath(dir, lsns[i], temporary)) {
                Ok(p) => {
                    let _ = Fs.unlink(p.view());
                    removed = true;
                }
                Err(_) => {}
            }
        }
    }
    if (removed) { let _ = Fs.syncDirectory(dir); }
}

/// Appends checkpoint bytes to a file through a buffer, keeping the entry CRC.
struct CheckpointWriter {
    file: DurableFile;
    offset: u64;
    buffer: Vector<u8>;
    crc: Crc32c;
    entries: u64;

    fn add(borrow mut this, kind: u8, body: Slice<u8>) -> Result<void, StoreError> {
        let start = this.buffer.length;
        this.buffer.pushLE(kind)?;
        this.buffer.pushLE(truncate<u32>(body.length))?;
        this.buffer.extend(body)?;
        this.crc.update(this.buffer.view()[start..]);
        this.entries += 1;
        return Ok(); // the caller flushes, without the store's lock (ADR-0028)
    }

    fn flush(borrow mut this) -> Result<void, StoreError> {
        sio(this.file.writeAt(this.buffer.view(), this.offset))?;
        this.offset += this.buffer.length as u64;
        this.buffer.clear();
        return Ok();
    }
}

fn encodeCheckpointHeader(lsn: u64, segment: u64, buckets: u64, objects: u64, uploads: u32) -> [u8; 64] {
    var h = [0u8; 64];
    h.writeLE(0, CHECKPOINT_MAGIC);
    h.writeLE(8, CHECKPOINT_FORMAT);
    h.writeLE(10, truncate<u16>(CHECKPOINT_HEADER_LEN));
    h.writeLE(12, 0u32);
    h.writeLE(16, lsn);
    h.writeLE(24, segment);
    h.writeLE(32, buckets);
    h.writeLE(40, objects);
    h.writeLE(48, Clock.unixMillis());
    h.writeLE(56, uploads);
    let crc = Crc32c.of(h[0..60]);
    h.writeLE(60, crc);
    return h;
}

fn encodeObjectEntry(
    out: borrow mut Vector<u8>,
    bucket: Slice<u8>,
    k: borrow IndexKey,
    v: borrow ObjectVersion,
) -> Result<void, AllocError> {
    out.clear();
    pushText16(out, bucket)?; // the name: bucket numbers are not on disk (ADR-0027)
    pushText16(out, k.key.view())?;
    out.extend(v.versionId[..])?;
    out.pushLE(v.lsn)?;
    out.pushLE(v.size)?;
    out.pushLE(v.mtimeMillis)?;
    out.extend(v.md5[..])?;
    pushText16(out, v.contentType.view())?;
    out.pushLE(v.payload.segmentId)?;
    out.pushLE(v.payload.offset)?;
    out.pushLE(v.payload.length)?;
    out.pushLE(v.recordSegment)?;
    out.pushLE(v.recordLength)?;
    encodeManifest(out, v.extents.view())?;
    out.pushLE(v.parts)?;
    appendMetadataSection(out, v.metadata.view())?;
    appendExtrasSection(out, v.extras.view())?;
    return Ok();
}

fn encodeUploadEntry(out: borrow mut Vector<u8>, id: [u8; 16], u: borrow Upload) -> Result<void, AllocError> {
    out.clear();
    out.extend(id[..])?;
    pushText16(out, u.bucket.view())?;
    pushText16(out, u.key.view())?;
    out.pushLE(u.initiatedMillis)?;
    pushText16(out, u.contentType.view())?;
    out.pushLE(truncate<u32>(u.parts.length))?;
    for (i in 0..u.parts.length) {
        let p = borrow u.parts[i];
        out.pushLE(p.number)?;
        out.pushLE(p.size)?;
        out.extend(p.md5[..])?;
        out.pushLE(p.mtimeMillis)?;
        encodeManifest(out, p.extents.view())?;
    }
    appendMetadataSection(out, u.metadata.view())?;
    out.pushLE(checksumCode(u.checksumAlgorithm))?;
    out.pushLE(checksumTypeCode(u.checksumType))?;
    for (i in 0..u.parts.length) {
        out.pushLE(truncate<u8>(u.parts[i].checksum.length))?;
        out.extend(u.parts[i].checksum.view())?;
    }
    return Ok();
}

/// A checkpoint written in steps (ADR-0028): the state as of `lsn`, while the store keeps changing. It begins under the
/// store (`beginCheckpointJob`: the header, the buckets and uploads, and a snapshot of the index), encodes the index a
/// step at a time under the store (`checkpointStepOf`, memory only), and does its I/O without it (`flush`,
/// `publish`).
struct CheckpointJob {
    lsn: u64;
    /// The first segment the checkpoint does not cover: replay starts there.
    segment: u64;
    /// The journal bytes committed between the previous checkpoint and `lsn`.
    sinceBefore: u64;
    private dir: String;
    private tmp: String;
    private done: String;
    private writer: CheckpointWriter;
    /// The entries the header promises: buckets, objects and uploads at `lsn`.
    private expected: u64;
    /// The bucket names by number at `lsn`, for object entries: a bucket may go before its keys are written.
    private names: HashMap<u32, Vector<u8>>;
    /// The upload entries at `lsn`, encoded; they follow the objects.
    private uploads: Vector<Vector<u8>>;
    private body: Vector<u8>;

    /// Writes what the steps have encoded so far (I/O, without the store).
    fn flush(borrow mut this) -> Result<void, StoreError> => this.writer.flush();

    /// Writes the uploads and the trailer and syncs the file. Then checks that it holds the entries its header
    /// promises, and publishes it: rename, then directory sync (I/O, without the store). Returns the file's size.
    /// Until the directory sync returns, a crash may lose the new name: recovery then uses the previous checkpoint,
    /// whose segments are all still there.
    fn publish(borrow mut this) -> Result<u64, StoreError> {
        for (i in 0..this.uploads.length) { this.writer.add(CHECKPOINT_UPLOAD, this.uploads[i].view())?; }
        // A snapshot that gave each key at `lsn` exactly once fills the header's count; anything else is a bug, and
        // such a file must never be published.
        if (this.writer.entries != this.expected) { return Err(StoreError.CheckpointCorrupt); }
        this.writer.buffer.pushLE(CHECKPOINT_TRAILER_MAGIC)?;
        this.writer.buffer.pushLE(this.writer.crc.finish())?;
        this.writer.buffer.pushLE(this.writer.entries)?;
        this.writer.flush()?;
        sio(this.writer.file.syncData())?;
        sio(Fs.rename(this.tmp.view(), this.done.view()))?;
        sio(Fs.syncDirectory(this.dir.view()))?;
        return Ok(this.writer.offset);
    }

    /// Removes the temporary file of a checkpoint given up.
    fn abandon(borrow mut this) { let _ = Fs.unlink(this.tmp.view()); }
}

/// Starts a checkpoint of `state` as of `lsn`, whose replay starts at `segment`. Creates its temporary file with the
/// header, encodes the buckets and uploads, and begins a snapshot of the index.
fn beginCheckpointJob(
    dir: StringView,
    lsn: u64,
    segment: u64,
    sinceBefore: u64,
    state: borrow mut StoreState,
) -> Result<CheckpointJob, StoreError> {
    let tmp = checkpointPath(dir, lsn, true)?;
    let done = checkpointPath(dir, lsn, false)?;
    let _ = Fs.unlink(tmp.view()); // a leftover of an interrupted attempt
    let file = sio(DurableFile.createNew(tmp.view()))?;
    let objects = state.index.length() as u64;
    let header = encodeCheckpointHeader(
        lsn,
        segment,
        state.buckets.length() as u64,
        objects,
        truncate<u32>(state.uploads.length()),
    );
    match (file.writeAt(header[..], 0)) {
        Ok() => {}
        Err(e) => {
            let _ = Fs.unlink(tmp.view());
            return Err(StoreError.Io(e));
        }
    }
    var w = CheckpointWriter {
        file: file,
        offset: CHECKPOINT_HEADER_LEN as u64,
        buffer: Vector<u8>.create(),
        crc: Crc32c.create(),
        entries: 0,
    };
    var body = Vector<u8>.create();
    for (i in 0..state.buckets.length()) {
        let k = state.buckets.keyAt(i);
        let b = state.buckets.valueAt(i);
        body.clear();
        pushText16(mut body, k.name.view())?;
        body.pushLE(b.createdMillis)?;
        body.pushLE(truncate<u32>(b.tags.length))?;
        body.extend(b.tags.view())?;
        body.pushLE(truncate<u32>(b.lifecycle.length))?;
        body.extend(b.lifecycle.view())?;
        w.add(CHECKPOINT_BUCKET, body.view())?;
    }
    var uploads = Vector<Vector<u8>>.create();
    for (i in 0..state.uploads.length()) {
        encodeUploadEntry(mut body, state.uploads.keyAt(i).id, state.uploads.valueAt(i))?;
        uploads.push(copyBytes(body.view())?)?;
    }
    var names = HashMap<u32, Vector<u8>>.create();
    for (i in 0..state.bucketNames.length()) {
        let _ = names.put(state.bucketNames.keyAt(i), copyBytes(state.bucketNames.valueAt(i).view())?)?;
    }
    state.index.beginSnapshot();
    var dirCopy = String.create();
    dirCopy.append(dir)?;
    return Ok(CheckpointJob {
        lsn: lsn,
        segment: segment,
        sinceBefore: sinceBefore,
        dir: dirCopy,
        tmp: tmp,
        done: done,
        writer: w,
        expected: state.buckets.length() as u64 + objects + state.uploads.length() as u64,
        names: names,
        uploads: uploads,
        body: body,
    });
}

/// Encodes up to `max` object entries of the index's snapshot into the job (memory only: under the store). Returns
/// whether the snapshot is done.
fn checkpointStepOf(
    job: borrow mut CheckpointJob,
    state: borrow mut StoreState,
    max: usize,
) -> Result<bool, StoreError> {
    // A version the snapshot could not keep (out of memory): this checkpoint cannot be whole.
    if (state.index.snapshotBroken()) { return Err(StoreError.OutOfMemory(AllocError.OutOfMemory)); }
    var n: usize = 0;
    while (n < max) {
        let at = match (state.index.snapshotPeek()) {
            Some(a) => a,
            null => { return Ok(true); }
        };
        if (!state.index.snapshotSkips(at)) {
            let k = state.index.snapshotKey(at);
            let name = match (job.names.get(borrow k.bucket)) {
                Some(b) => b.view(),
                null => { return Err(StoreError.CheckpointCorrupt); } // a key of no bucket at `lsn`: a bug
            };
            encodeObjectEntry(mut job.body, name, k, state.index.snapshotVersion(at))?;
            job.writer.add(CHECKPOINT_OBJECT, job.body.view())?;
            n += 1;
        }
        state.index.snapshotAdvance(at)?;
    }
    return Ok(false);
}

/// A loaded checkpoint: where replay starts, and the state to replay onto.
struct LoadedCheckpoint {
    lsn: u64;
    segment: u64;
    state: StoreState;
}

/// Reads a file sequentially through a buffer.
struct ChunkReader {
    file: DurableFile;
    size: u64;
    /// File offset of the byte after the buffer's last.
    next: u64;
    buffer: Vector<u8>;
    position: usize;

    /// Makes at least `n` unread bytes available, or fails if the file ends first.
    fn ensure(borrow mut this, n: usize) -> Result<void, StoreError> {
        if (this.buffer.length - this.position >= n) { return Ok(); }
        var kept = Vector<u8>.create();
        kept.extend(this.buffer.view()[this.position..])?;
        this.buffer = kept;
        this.position = 0;
        while (this.buffer.length < n) {
            let left = this.size - this.next;
            if (left == 0) { return Err(StoreError.CheckpointCorrupt); }
            let want = if (left < CHECKPOINT_IO_CHUNK as u64) truncate<usize>(left) else CHECKPOINT_IO_CHUNK;
            let at = this.buffer.length;
            this.buffer.resize(at + want, 0)?;
            sio(this.file.readExactAt(mut this.buffer.viewMut()[at..], this.next))?;
            this.next += want as u64;
        }
        return Ok();
    }

    /// The next `n` bytes, after `ensure(n)`.
    fn take(borrow mut this, n: usize) -> Slice<u8> {
        let start = this.position;
        this.position += n;
        return this.buffer.view()[start..start + n];
    }

    fn atEnd(borrow this) -> bool => this.position == this.buffer.length && this.next == this.size;
}

fn corrupt<T>(r: Result<T, MetaFault>) -> Result<T, StoreError> => match (r) {
    Ok(v) => Ok(v),
    Err(MetaFault.OutOfMemory(e)) => Err(StoreError.OutOfMemory(e)),
    Err(_) => Err(StoreError.CheckpointCorrupt),
};

fn decodeObjectEntry(bytes: Slice<u8>, state: borrow mut StoreState, format: u16) -> Result<void, StoreError> {
    var at: usize = 0;
    let bucket = corrupt(readText16(bytes, mut at))?;
    let key = corrupt(readText16(bytes, mut at))?;
    let versionId = corrupt(readId16(bytes, mut at))?;
    let lsn = corrupt(readU64(bytes, mut at))?;
    let size = corrupt(readU64(bytes, mut at))?;
    let mtime = corrupt(readI64(bytes, mut at))?;
    let md5 = corrupt(readId16(bytes, mut at))?;
    let contentType = corrupt(readText16(bytes, mut at))?;
    corrupt(need(bytes, at, 32))?;
    let payloadSegment = bytes.readLE<u64>(at);
    let payloadOffset = bytes.readLE<u64>(at + 8);
    let payloadLength = bytes.readLE<u32>(at + 16);
    let recordSegment = bytes.readLE<u64>(at + 20);
    let recordLength = bytes.readLE<u32>(at + 28);
    at += 32;
    let extents = corrupt(decodeManifestPrefix(bytes[at..]))?;
    at += manifestLength(extents.length);
    var parts: u32 = 0;
    if (format >= 2) { parts = corrupt(readU32(bytes, mut at))?; }
    var metadata = Vector<u8>.create();
    if (format >= 3) { metadata = corrupt(readMetadataSection(bytes, mut at))?; }
    var extras = Vector<u8>.create();
    if (format >= 4) { extras = corrupt(readExtrasSection(bytes, mut at))?; }
    if (at != bytes.length) { return Err(StoreError.CheckpointCorrupt); }
    if (!state.hasBucket(bucket.view())?) { return Err(StoreError.CheckpointCorrupt); }
    state.bumpObjects(bucket.view(), true)?;
    let version = ObjectVersion {
        versionId: versionId,
        lsn: lsn,
        kind: VersionKind.Object,
        size: size,
        mtimeMillis: mtime,
        md5: md5,
        contentType: contentType,
        payload: PayloadLocator { segmentId: payloadSegment, offset: payloadOffset, length: payloadLength },
        recordSegment: recordSegment,
        recordLength: recordLength,
        extents: extents,
        parts: parts,
        metadata: metadata,
        extras: extras,
    };
    state.extentBytes += extentFileBytes(borrow version);
    let indexKey = match (state.indexKey(bucket.view(), key.view())?) {
        Some(k) => k,
        null => { return Err(StoreError.CheckpointCorrupt); }
    };
    match (state.index.put(indexKey, version)?) {
        Some(_) => { return Err(StoreError.CheckpointCorrupt); } // a key twice
        null => {}
    }
    return Ok();
}

fn decodeUploadEntry(bytes: Slice<u8>, state: borrow mut StoreState, format: u16) -> Result<void, StoreError> {
    var at: usize = 0;
    let id = corrupt(readId16(bytes, mut at))?;
    let bucket = corrupt(readText16(bytes, mut at))?;
    let key = corrupt(readText16(bytes, mut at))?;
    let initiated = corrupt(readI64(bytes, mut at))?;
    let contentType = corrupt(readText16(bytes, mut at))?;
    let count = corrupt(readU32(bytes, mut at))?;
    if (!state.hasBucket(bucket.view())?) { return Err(StoreError.CheckpointCorrupt); }
    var parts = Vector<UploadedPart>.create();
    for (i in 0..count) {
        let number = corrupt(readU32(bytes, mut at))?;
        let size = corrupt(readU64(bytes, mut at))?;
        let md5 = corrupt(readId16(bytes, mut at))?;
        let mtime = corrupt(readI64(bytes, mut at))?;
        let extents = corrupt(decodeManifestPrefix(bytes[at..]))?;
        at += manifestLength(extents.length);
        let n = parts.length;
        if (n > 0 && parts[n - 1].number >= number) { return Err(StoreError.CheckpointCorrupt); }
        state.extentBytes += extentRefBytes(extents.view());
        parts.push(UploadedPart {
            number: number,
            size: size,
            md5: md5,
            mtimeMillis: mtime,
            extents: extents,
            checksum: Vector<u8>.create(),
        })?;
    }
    var metadata = Vector<u8>.create();
    if (format >= 3) { metadata = corrupt(readMetadataSection(bytes, mut at))?; }
    var algorithm = ChecksumAlgorithm.None;
    var kind = ChecksumType.FullObject;
    if (format >= 4) {
        corrupt(need(bytes, at, 2))?;
        algorithm = match (checksumFromCode(bytes[at])) {
            Some(a) => a,
            null => { return Err(StoreError.CheckpointCorrupt); }
        };
        kind = checksumTypeFromCode(bytes[at + 1]);
        at += 2;
        for (i in 0..parts.length) {
            corrupt(need(bytes, at, 1))?;
            let n = bytes[at] as usize;
            at += 1;
            corrupt(need(bytes, at, n))?;
            let part = borrow mut parts[i];
            part.checksum.extend(bytes[at..at + n])?;
            at += n;
        }
    }
    if (at != bytes.length) { return Err(StoreError.CheckpointCorrupt); }
    let upload = Upload {
        bucket: bucket,
        key: key,
        contentType: contentType,
        metadata: metadata,
        checksumAlgorithm: algorithm,
        checksumType: kind,
        initiatedMillis: initiated,
        parts: parts,
    };
    match (state.uploads.put(UploadKey { id: id }, upload)?) {
        Some(_) => { return Err(StoreError.CheckpointCorrupt); } // an upload twice
        null => {}
    }
    return Ok();
}

fn readBlob32(bytes: Slice<u8>, at: borrow mut usize) -> Result<Vector<u8>, MetaFault> {
    let n = readU32(bytes, at)? as usize;
    need(bytes, at, n)?;
    let v = copyBytes(bytes[at..at + n])?;
    at += n;
    return Ok(v);
}

/// Loads and verifies the checkpoint of `lsn`.
fn readCheckpoint(dir: StringView, lsn: u64) -> Result<LoadedCheckpoint, StoreError> {
    let path = checkpointPath(dir, lsn, false)?;
    let file = sio(DurableFile.openRead(path.view()))?;
    let size = sio(file.size())?;
    var r = ChunkReader { file: file, size: size, next: 0, buffer: Vector<u8>.create(), position: 0 };
    r.ensure(CHECKPOINT_HEADER_LEN)?;
    let h = r.take(CHECKPOINT_HEADER_LEN);
    if (h.readLE<u32>(60) != Crc32c.of(h[0..60])) { return Err(StoreError.CheckpointCorrupt); }
    let format = h.readLE<u16>(8);
    if (h.readLE<u64>(0) != CHECKPOINT_MAGIC || format < 1 || format > CHECKPOINT_FORMAT) {
        return Err(StoreError.CheckpointCorrupt);
    }
    if (h.readLE<u64>(16) != lsn) { return Err(StoreError.CheckpointCorrupt); }
    let segment = h.readLE<u64>(24);
    let buckets = h.readLE<u64>(32);
    let objects = h.readLE<u64>(40);
    let uploads = if (format >= 2) h.readLE<u32>(56) as u64 else 0;
    var state = StoreState.create();
    var crc = Crc32c.create();
    var entries: u64 = 0;
    while (entries < buckets + objects + uploads) {
        r.ensure(5)?;
        let prefix = r.take(5);
        let kind = prefix[0];
        let length = prefix.readLE<u32>(1) as usize;
        crc.update(prefix);
        if (length > CHECKPOINT_MAX_ENTRY) { return Err(StoreError.CheckpointCorrupt); }
        let expected = if (entries < buckets) CHECKPOINT_BUCKET else if (entries <
            buckets + objects) CHECKPOINT_OBJECT else CHECKPOINT_UPLOAD;
        if (kind != expected) { return Err(StoreError.CheckpointCorrupt); }
        r.ensure(length)?;
        let body = r.take(length);
        crc.update(body);
        if (kind == CHECKPOINT_BUCKET) {
            var at: usize = 0;
            let name = corrupt(readText16(body, mut at))?;
            let created = corrupt(readI64(body, mut at))?;
            var info = BucketInfo {
                number: 0,
                createdMillis: created,
                objects: 0,
                tags: Vector<u8>.create(),
                lifecycle: Vector<u8>.create(),
            };
            if (format >= 5) {
                info.tags = corrupt(readBlob32(body, mut at))?;
                info.lifecycle = corrupt(readBlob32(body, mut at))?;
            }
            if (at != body.length) { return Err(StoreError.CheckpointCorrupt); }
            if (!state.addBucket(name, info)?) { return Err(StoreError.CheckpointCorrupt); } // a bucket twice
        } else if (kind == CHECKPOINT_OBJECT) {
            decodeObjectEntry(body, mut state, format)?;
        } else {
            decodeUploadEntry(body, mut state, format)?;
        }
        entries += 1;
    }
    r.ensure(CHECKPOINT_TRAILER_LEN)?;
    let t = r.take(CHECKPOINT_TRAILER_LEN);
    if (t.readLE<u32>(
        0,
    ) != CHECKPOINT_TRAILER_MAGIC || t.readLE<u32>(4) != crc.finish() || t.readLE<u64>(8) != entries) {
        return Err(StoreError.CheckpointCorrupt);
    }
    if (!r.atEnd()) { return Err(StoreError.CheckpointCorrupt); }
    return Ok(LoadedCheckpoint { lsn: lsn, segment: segment, state: state });
}
