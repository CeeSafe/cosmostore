// A bucket's replication rules (ADR-0077) as the store keeps them; the S3 layer reads and writes them as XML, and
// the outbox's delivery writes the replicas (`src/s3/replication.cee`).

/// A bucket's replication rules, in the compact form below; empty for none.
const BUCKET_CONFIG_REPLICATION: u8 = 16;
const MAX_REPLICATION_RULES: usize = 1000;
/// An outbox target that is a replication destination, not a webhook: this byte, then the destination bucket.
const REPLICATION_TARGET: u8 = 0;

/// A source version's status (ADR-0077 §4).
const REPLICATION_NONE: u8 = 0;
const REPLICATION_PENDING: u8 = 1;
const REPLICATION_COMPLETED: u8 = 2;
const REPLICATION_FAILED: u8 = 3;

struct ReplicationRule {
    id: Vector<u8>;
    priority: u32;
    enabled: bool;
    prefix: Vector<u8>;
    deleteMarkers: bool;
    /// The destination bucket's name (its ARN's last part).
    destination: Vector<u8>;
    /// The storage class its replicas get (ADR-0090 §1, the M12 exit review's B3); empty: the source's.
    storageClass: Vector<u8>;
}

/// Replication v1: u8 version, u16 count, then per rule the id, u32 priority, u8 flags (1: enabled, 2: delete
/// markers), the prefix and the destination (each text u16+bytes). Version 2, written only when a rule gives its
/// replicas a storage class, adds per rule that class (text u16+bytes, empty for the source's).
fn encodeReplication(rules: Slice<ReplicationRule>, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    if (rules.length == 0) { return Ok(); }
    var version: u8 = 1;
    for (i in 0..rules.length) {
        if (rules[i].storageClass.length > 0) { version = 2; }
    }
    out.push(version)?;
    out.pushLE(truncate<u16>(rules.length))?;
    for (i in 0..rules.length) {
        let r = borrow rules[i];
        pushText16(out, r.id.view())?;
        out.pushLE(r.priority)?;
        out.push((if (r.enabled) 1u8 else 0u8) | (if (r.deleteMarkers) 2u8 else 0u8))?;
        pushText16(out, r.prefix.view())?;
        pushText16(out, r.destination.view())?;
        if (version == 2) { pushText16(out, r.storageClass.view())?; }
    }
    return Ok();
}

fn decodeReplication(b: Slice<u8>) -> Result<Vector<ReplicationRule>, MetaFault> {
    var out = Vector<ReplicationRule>.create();
    if (b.length == 0) { return Ok(out); }
    if (b[0] != 1 && b[0] != 2) { return Err(MetaFault.BadVersion); }
    let version = b[0];
    need(b, 1, 2)?;
    let n = b.readLE<u16>(1) as usize;
    if (n == 0 || n > MAX_REPLICATION_RULES) { return Err(MetaFault.TooLong); }
    var at: usize = 3;
    for (i in 0..n) {
        let id = readText16(b, mut at)?;
        need(b, at, 5)?;
        let priority = b.readLE<u32>(at);
        let flags = b[at + 4];
        at += 5;
        let prefix = readText16(b, mut at)?;
        let destination = readText16(b, mut at)?;
        if (destination.length == 0) { return Err(MetaFault.TooLong); }
        var storageClass = Vector<u8>.create();
        if (version == 2) {
            storageClass = readText16(b, mut at)?;
            if (!isStoredClassValue(storageClass.view())) { return Err(MetaFault.TooLong); }
        }
        out.push(ReplicationRule {
            id: id,
            priority: priority,
            enabled: (flags & 1) != 0,
            prefix: prefix,
            deleteMarkers: (flags & 2) != 0,
            destination: destination,
            storageClass: storageClass,
        })?;
    }
    if (at != b.length) { return Err(MetaFault.TooLong); }
    return Ok(out);
}

fn isReplicationValue(value: Slice<u8>) -> bool => decodeReplication(value).isOk();

/// The storage class a replica to `destination` gets, by the rules the event names (`ruleIds`): the deciding rule's
/// class, or empty for the source's.
fn replicaClassFor<region a>(
    rules: Slice<a, ReplicationRule>,
    ruleIds: Slice<Vector<u8>>,
    destination: Slice<u8>,
) -> Slice<a, u8> {
    for (i in 0..rules.length) {
        if (rules[i].destination.view() != destination) { continue; }
        for (k in 0..ruleIds.length) {
            if (ruleIds[k].view() == rules[i].id.view()) { return rules[i].storageClass.view(); }
        }
    }
    return "".bytes();
}

/// Whether a rule replicates an event of `kind` for `key` (ADR-0077 §2): new objects and completed uploads, delete
/// markers if it says so, never a version's removal.
fn replicationTakes(r: borrow ReplicationRule, kind: u8, key: Slice<u8>) -> bool {
    if (!r.enabled || !startsWithBytes(key, r.prefix.view())) { return false; }
    if (kind == EVENT_PUT || kind == EVENT_COMPLETE) { return true; }
    return kind == EVENT_MARKER && r.deleteMarkers;
}

/// Whether rule `i` is the one that decides for `key` at its destination: AWS's rule, the enabled rule whose filter
/// takes the key with the highest priority among those of the same destination (the M7 review's A3); priorities are
/// unique (PutBucketReplication refuses two the same), so there is one.
fn replicationRuleDecides(rules: Slice<ReplicationRule>, i: usize, key: Slice<u8>) -> bool {
    let r = borrow rules[i];
    if (!r.enabled || !startsWithBytes(key, r.prefix.view())) { return false; }
    for (j in 0..rules.length) {
        let o = borrow rules[j];
        if (j == i || !o.enabled || o.destination.view() != r.destination.view()) { continue; }
        if (!startsWithBytes(key, o.prefix.view())) { continue; }
        if (o.priority > r.priority || (o.priority == r.priority && j < i)) { return false; }
    }
    return true;
}

/// The outbox target of a destination: REPLICATION_TARGET, then its name.
fn replicationTarget(destination: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var t = Vector<u8>.create();
    t.push(REPLICATION_TARGET)?;
    t.extend(destination)?;
    return Ok(t);
}

fn isReplicationTarget(target: Slice<u8>) -> bool => target.length > 1 && target[0] == REPLICATION_TARGET;

/// A source bucket's replications that a remote destination refused (ADR-0077 §7): its newest 1,000, each its key
/// and version id, so that their status is FAILED, also after a restart.
const BUCKET_CONFIG_REPLICATION_FAILURES: u8 = 17;
const MAX_REPLICATION_FAILURES: usize = 1000;

/// Whether a destination is on another endpoint: `<target id>:<bucket>` (a bucket's name has no `:`).
fn isRemoteDestination(destination: Slice<u8>) -> bool {
    for (c in destination) {
        if (c == ':') { return true; }
    }
    return false;
}

/// Failures v1: u8 version, u16 count, then per failure the key (u16+bytes) and the 16-byte version id.
fn failuresWith(
    stored: Slice<u8>,
    key: Slice<u8>,
    versionId: [u8; 16],
    out: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    var keys = Vector<Vector<u8>>.create();
    var ids = Vector<[u8; 16]>.create();
    if (stored.length >= 3 && stored[0] == 1) {
        let n = stored.readLE<u16>(1) as usize;
        var at: usize = 3;
        for (i in 0..n) {
            let k = match (readText16(stored, mut at)) {
                Ok(k) => k,
                Err(_) => { break; }
            };
            if (at + 16 > stored.length) { break; }
            var id = [0u8; 16];
            for (j in 0..16) { id[j] = stored[at + j]; }
            at += 16;
            if (k.view() == key && id[..] == versionId[..]) { continue; }
            keys.push(k)?;
            ids.push(id)?;
        }
    }
    keys.push(copyBytes(key)?)?;
    ids.push(versionId)?;
    let from = if (keys.length > MAX_REPLICATION_FAILURES) keys.length - MAX_REPLICATION_FAILURES else 0;
    out.push(1)?;
    out.pushLE(truncate<u16>(keys.length - from))?;
    for (i in from..keys.length) {
        pushText16(out, keys[i].view())?;
        out.extend(ids[i][..])?;
    }
    return Ok();
}

fn failuresHave(stored: Slice<u8>, key: Slice<u8>, versionId: [u8; 16]) -> bool {
    if (stored.length < 3 || stored[0] != 1) { return false; }
    let n = stored.readLE<u16>(1) as usize;
    var at: usize = 3;
    for (i in 0..n) {
        let k = match (readText16(stored, mut at)) {
            Ok(k) => k,
            Err(_) => { return false; }
        };
        if (at + 16 > stored.length) { return false; }
        if (k.view() == key && stored[at..at + 16] == versionId[..]) { return true; }
        at += 16;
    }
    return false;
}

fn isFailuresValue(value: Slice<u8>) -> bool {
    if (value.length == 0) { return true; }
    if (value.length < 3 || value[0] != 1) { return false; }
    let n = value.readLE<u16>(1) as usize;
    if (n > MAX_REPLICATION_FAILURES) { return false; }
    var at: usize = 3;
    for (i in 0..n) {
        match (readText16(value, mut at)) {
            Ok(_) => {}
            Err(_) => { return false; }
        }
        if (at + 16 > value.length) { return false; }
        at += 16;
    }
    return at == value.length;
}
