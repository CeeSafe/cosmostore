// Bucket configuration (ADR-0020): a bucket's tags and its lifecycle rules, kept with the bucket and set or cleared by
// BucketConfig records. Lifecycle rules expire objects (by days or date, filtered by prefix, tags and size) and abort
// old multipart uploads; `ObjectStore.applyLifecycle` enforces them.

const BUCKET_CONFIG_TAGS: u8 = 1;
const BUCKET_CONFIG_LIFECYCLE: u8 = 2;
/// A bucket's versioning state (ADR-0041): one byte, VERSIONING_ENABLED or VERSIONING_SUSPENDED.
const BUCKET_CONFIG_VERSIONING: u8 = 3;
/// A bucket policy (ADR-0043): its JSON, as it was put.
const BUCKET_CONFIG_POLICY: u8 = 4;
/// The largest policy S3 takes.
const MAX_POLICY_BYTES: usize = 20480;
/// A bucket's public-access block (ADR-0044): one byte, the PUBLIC_ACCESS bits of the settings that are on.
const BUCKET_CONFIG_PUBLIC_ACCESS: u8 = 5;
const PUBLIC_ACCESS_BLOCK_ACLS: u8 = 1;
const PUBLIC_ACCESS_IGNORE_ACLS: u8 = 2;
const PUBLIC_ACCESS_BLOCK_POLICY: u8 = 4;
const PUBLIC_ACCESS_RESTRICT_BUCKETS: u8 = 8;
/// A bucket's ACL (ADR-0045): its three characters, as a version's `ACL_FIELD` holds one; empty for the private one.
const BUCKET_CONFIG_ACL: u8 = 6;
/// A bucket's object lock configuration (ADR-0047): `E` for enabled, then for a default retention a dot, its mode
/// (`G`, `C`), a dot, and its period, `d` or `y` and a number of days or years. Never cleared once it is set.
const BUCKET_CONFIG_OBJECT_LOCK: u8 = 7;
/// S3's longest default retention: 100 years, in days.
const MAX_LOCK_DAYS: u32 = 36500;
const MAX_LOCK_YEARS: u32 = 100;
const VERSIONING_OFF: u8 = 0;
const VERSIONING_ENABLED: u8 = 1;
const VERSIONING_SUSPENDED: u8 = 2;
const DAY_MILLIS: i64 = 86400000;

/// BucketConfig meta v1: u8 format version, u16+bytes bucket, u8 kind (1 tags, 2 lifecycle, 3 versioning, 4 policy,
/// 5 public-access block, 6 ACL, 7 object lock, 8 notification rules, 9 CORS rules, 10 quota), u32+bytes the value (empty: cleared; versioning and the public-access
/// block: one byte; the ACL: three).
fn encodeBucketConfigMeta(
    out: borrow mut Vector<u8>,
    bucket: Slice<u8>,
    kind: u8,
    value: Slice<u8>,
) -> Result<void, AllocError> {
    out.pushLE(META_FORMAT_VERSION)?;
    pushText16(out, bucket)?;
    out.pushLE(kind)?;
    out.pushLE(truncate<u32>(value.length))?;
    out.extend(value)?;
    return Ok();
}

struct BucketConfigMeta {
    bucket: Vector<u8>;
    kind: u8;
    value: Vector<u8>;
}

fn decodeBucketConfigMeta(bytes: Slice<u8>) -> Result<BucketConfigMeta, MetaFault> {
    var at: usize = 0;
    checkVersion(bytes, mut at)?;
    let bucket = readText16(bytes, mut at)?;
    need(bytes, at, 1)?;
    let kind = bytes[at];
    at += 1;
    let n = readU32(bytes, mut at)? as usize;
    need(bytes, at, n)?;
    let value = copyBytes(bytes[at..at + n])?;
    at += n;
    if (at != bytes.length) { return Err(MetaFault.TooLong); }
    if (kind == BUCKET_CONFIG_VERSIONING) {
        if (!isVersioningValue(value.view())) { return Err(MetaFault.TooLong); }
    } else if (kind == BUCKET_CONFIG_POLICY) {
        if (value.length > MAX_POLICY_BYTES) { return Err(MetaFault.TooLong); }
    } else if (kind == BUCKET_CONFIG_PUBLIC_ACCESS) {
        if (!isPublicAccessValue(value.view())) { return Err(MetaFault.TooLong); }
    } else if (kind == BUCKET_CONFIG_ACL) {
        if (!isAclValue(value.view())) { return Err(MetaFault.TooLong); }
    } else if (kind == BUCKET_CONFIG_OBJECT_LOCK) {
        if (decodeLockConfig(value.view()).isNull()) { return Err(MetaFault.TooLong); }
    } else if (kind == BUCKET_CONFIG_NOTIFICATION) {
        if (decodeNotification(value.view()).isErr()) { return Err(MetaFault.TooLong); }
    } else if (kind == BUCKET_CONFIG_CORS) {
        if (decodeCors(value.view()).isErr()) { return Err(MetaFault.TooLong); }
    } else if (kind == BUCKET_CONFIG_QUOTA) {
        if (!isQuotaValue(value.view())) { return Err(MetaFault.TooLong); }
    } else if (kind != BUCKET_CONFIG_TAGS && kind != BUCKET_CONFIG_LIFECYCLE) {
        return Err(MetaFault.TooLong);
    }
    return Ok(BucketConfigMeta { bucket: bucket, kind: kind, value: value });
}

/// Whether `value` is a versioning state a bucket can be given: it is never unversioned again.
fn isVersioningValue(value: Slice<u8>) -> bool =>
    value.length == 1 && (value[0] == VERSIONING_ENABLED || value[0] == VERSIONING_SUSPENDED);

/// Whether `value` is a public-access block as it is stored: empty for none, or one byte of the four settings.
fn isPublicAccessValue(value: Slice<u8>) -> bool => value.length == 0 || (value.length == 1 && value[0] < 16);

/// A bucket's default retention: none (`LOCK_NONE`), or a mode and a period in days or in years.
struct LockDefault {
    mode: u8;
    days: u32;
    years: u32;
}

/// A bucket's object lock configuration as it is stored.
fn encodeLockConfig(d: LockDefault, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    out.push('E')?;
    if (d.mode == LOCK_NONE) { return Ok(); }
    out.push('.')?;
    out.push(d.mode)?;
    out.push('.')?;
    out.push(if (d.years > 0) 'y' else 'd')?;
    var digits = [0u8; 10];
    var n: usize = 0;
    var v = if (d.years > 0) d.years else d.days;
    while (true) {
        digits[n] = '0' + truncate<u8>(v % 10);
        n += 1;
        v = v / 10;
        if (v == 0) { break; }
    }
    while (n > 0) {
        n -= 1;
        out.push(digits[n])?;
    }
    return Ok();
}

/// A stored object lock configuration's default retention; null for a value that is not one (an empty one too).
fn decodeLockConfig(value: Slice<u8>) -> LockDefault? {
    if (value.length == 0 || value[0] != 'E') { return null; }
    var d = LockDefault { mode: LOCK_NONE, days: 0, years: 0 };
    if (value.length == 1) { return Some(d); }
    if (value.length < 6 || value.length > 10 || value[1] != '.' || value[3] != '.') { return null; }
    if (value[2] != LOCK_GOVERNANCE && value[2] != LOCK_COMPLIANCE) { return null; }
    if (value[4] != 'd' && value[4] != 'y') { return null; }
    var n: u32 = 0;
    for (i in 5..value.length) {
        if (value[i] < '0' || value[i] > '9') { return null; }
        n = n * 10 + ((value[i] - '0') as u32);
    }
    let most = if (value[4] == 'y') MAX_LOCK_YEARS else MAX_LOCK_DAYS;
    if (n == 0 || n > most) { return null; }
    d.mode = value[2];
    if (value[4] == 'y') {
        d.years = n;
    } else {
        d.days = n;
    }
    return Some(d);
}

/// When a default retention that starts at `now` ends: a year is 365 days, as S3 counts it.
fn lockDefaultUntil(d: LockDefault, now: i64) -> i64 =>
    now + ((d.days as i64) + (d.years as i64) * 365) * DAY_MILLIS;

/// A bucket's quota (ADR-0052): 16 bytes, u64 the most bytes of its versions and u64 the most versions, 0 for no
/// limit of that kind; empty for no quota.
const BUCKET_CONFIG_QUOTA: u8 = 10;

/// Whether `value` is a quota as it is stored: empty, or its two limits, not both 0.
fn isQuotaValue(value: Slice<u8>) -> bool =>
    value.length == 0 || (value.length == 16 && (value.readLE<u64>(0) != 0 || value.readLE<u64>(8) != 0));

// ---- Lifecycle rules ----

/// One rule. Its filter: a key prefix, tags (each a canonical `k=v` piece, as tags are stored, ADR-0017), and object
/// sizes; every part must hold. Its actions: expire objects (after `expirationDays`, or from `expirationDate`), and
/// abort uploads `abortDays` after they began. 0 means no such action.
struct LifecycleRule {
    id: Vector<u8>;
    enabled: bool;
    prefix: Vector<u8>;
    tags: Vector<Vector<u8>>;
    hasSizeAbove: bool;
    sizeAbove: u64;
    hasSizeBelow: bool;
    sizeBelow: u64;
    expirationDays: u32;
    /// Unix milliseconds, midnight UTC.
    expirationDate: i64;
    abortDays: u32;
    /// Given as the legacy top-level `<Prefix>`, so written back that way, as S3 does.
    legacyPrefix: bool;
    /// `ExpiredObjectDeleteMarker`: a delete marker that is its key's only version is removed (ADR-0042).
    expiredDeleteMarker: bool;
    /// `NoncurrentVersionExpiration` (ADR-0042): a version is removed this many days after it stopped being the
    /// current one (0: no such action), if at least `newerNoncurrent` noncurrent versions of its key are newer.
    noncurrentDays: u32;
    newerNoncurrent: u32;
}

/// Rules blob v1: u8 version (1), u16 rule count, then per rule: u16+bytes id, u8 flags (1 enabled, 2 a size floor,
/// 4 a size ceiling, 8 a legacy prefix, 16 ExpiredObjectDeleteMarker), u16+bytes prefix, u8 tag count and each u16+bytes, u64 size floor, u64 size ceiling,
/// u32 expiration days, i64 expiration date, u32 abort days. Version 2 (ADR-0042), written only when a rule expires
/// noncurrent versions, adds per rule: u32 noncurrent days, u32 newer noncurrent versions.
fn encodeLifecycle(rules: Slice<LifecycleRule>, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    out.clear();
    var version: u8 = 1;
    for (r in rules) {
        if (r.noncurrentDays > 0) { version = 2; }
    }
    out.pushLE(version)?;
    out.pushLE(truncate<u16>(rules.length))?;
    for (r in rules) {
        pushText16(out, r.id.view())?;
        var flags: u8 = 0;
        if (r.enabled) { flags |= 1; }
        if (r.hasSizeAbove) { flags |= 2; }
        if (r.hasSizeBelow) { flags |= 4; }
        if (r.legacyPrefix) { flags |= 8; }
        if (r.expiredDeleteMarker) { flags |= 16; }
        out.pushLE(flags)?;
        pushText16(out, r.prefix.view())?;
        out.pushLE(truncate<u8>(r.tags.length))?;
        for (t in r.tags.view()) { pushText16(out, t.view())?; }
        out.pushLE(r.sizeAbove)?;
        out.pushLE(r.sizeBelow)?;
        out.pushLE(r.expirationDays)?;
        out.pushLE(r.expirationDate)?;
        out.pushLE(r.abortDays)?;
        if (version == 2) {
            out.pushLE(r.noncurrentDays)?;
            out.pushLE(r.newerNoncurrent)?;
        }
    }
    return Ok();
}

fn decodeLifecycle(blob: Slice<u8>) -> Result<Vector<LifecycleRule>, MetaFault> {
    var rules = Vector<LifecycleRule>.create();
    if (blob.length == 0) { return Ok(rules); }
    var at: usize = 0;
    need(blob, at, 3)?;
    let version = blob[0];
    if (version != 1 && version != 2) { return Err(MetaFault.BadVersion); }
    let count = blob.readLE<u16>(1);
    at = 3;
    for (i in 0..count) {
        let id = readText16(blob, mut at)?;
        need(blob, at, 1)?;
        let flags = blob[at];
        at += 1;
        let prefix = readText16(blob, mut at)?;
        need(blob, at, 1)?;
        let tagCount = blob[at];
        at += 1;
        var tags = Vector<Vector<u8>>.create();
        for (t in 0..tagCount) { tags.push(readText16(blob, mut at)?)?; }
        let above = readU64(blob, mut at)?;
        let below = readU64(blob, mut at)?;
        let days = readU32(blob, mut at)?;
        let date = readI64(blob, mut at)?;
        let abort = readU32(blob, mut at)?;
        var noncurrentDays: u32 = 0;
        var newerNoncurrent: u32 = 0;
        if (version == 2) {
            noncurrentDays = readU32(blob, mut at)?;
            newerNoncurrent = readU32(blob, mut at)?;
        }
        rules.push(LifecycleRule {
            id: id,
            enabled: (flags & 1) != 0,
            prefix: prefix,
            tags: tags,
            hasSizeAbove: (flags & 2) != 0,
            sizeAbove: above,
            hasSizeBelow: (flags & 4) != 0,
            sizeBelow: below,
            expirationDays: days,
            expirationDate: date,
            abortDays: abort,
            legacyPrefix: (flags & 8) != 0,
            expiredDeleteMarker: (flags & 16) != 0,
            noncurrentDays: noncurrentDays,
            newerNoncurrent: newerNoncurrent,
        })?;
    }
    if (at != blob.length) { return Err(MetaFault.TooLong); }
    return Ok(rules);
}

/// Whether every tag of `wanted` (canonical `k=v` pieces) is one of `canonical`'s `&`-separated pieces.
fn tagsInclude(canonical: Slice<u8>, wanted: Slice<Vector<u8>>) -> bool {
    for (w in wanted) {
        var found = false;
        var at: usize = 0;
        while (at <= canonical.length && canonical.length > 0) {
            let end = pieceEnd(canonical, at, '&');
            if (canonical[at..end] == w.view()) { found = true; }
            at = end + 1;
        }
        if (!found) { return false; }
    }
    return true;
}

/// Whether an enabled rule's filter takes this object.
fn ruleMatches(r: borrow LifecycleRule, key: Slice<u8>, size: u64, tags: Slice<u8>) -> bool {
    if (!r.enabled || !startsWithBytes(key, r.prefix.view())) { return false; }
    if (r.hasSizeAbove && !(size > r.sizeAbove)) { return false; }
    if (r.hasSizeBelow && !(size < r.sizeBelow)) { return false; }
    return tagsInclude(tags, r.tags.view());
}

/// When a rule expires an object made at `mtimeMillis`: S3 adds the days and rounds up to the next midnight UTC; a
/// date is its own time. null: the rule does not expire objects.
fn expiresAt(r: borrow LifecycleRule, mtimeMillis: i64) -> i64? {
    if (r.expirationDays > 0) {
        let t = mtimeMillis + (r.expirationDays as i64) * DAY_MILLIS;
        return ((t + DAY_MILLIS - 1) / DAY_MILLIS) * DAY_MILLIS;
    }
    if (r.expirationDate > 0) { return r.expirationDate; }
    return null;
}

/// Whether an enabled rule's filter takes a delete marker of this key (ADR-0042 §4): a marker has no size and no
/// tags, so only a rule that filters by neither can.
fn ruleTakesMarker(r: borrow LifecycleRule, key: Slice<u8>) -> bool =>
    r.enabled && startsWithBytes(key, r.prefix.view()) && !r.hasSizeAbove && !r.hasSizeBelow && r.tags.length == 0;

/// When a rule removes a version that stopped being the current one at `sinceMillis`: the days added, rounded up to
/// the next midnight UTC, as `expiresAt`. null: the rule does not expire noncurrent versions.
fn noncurrentExpiresAt(r: borrow LifecycleRule, sinceMillis: i64) -> i64? {
    if (r.noncurrentDays == 0) { return null; }
    let t = sinceMillis + (r.noncurrentDays as i64) * DAY_MILLIS;
    return ((t + DAY_MILLIS - 1) / DAY_MILLIS) * DAY_MILLIS;
}

@test
fn lifecycleRulesRoundTripAndMatch() -> Result<void, TestFailure> {
    var tags = Vector<Vector<u8>>.create();
    tags.push(copyBytes("team=blue".bytes())!)!;
    let rule = LifecycleRule {
        id: copyBytes("logs".bytes())!,
        enabled: true,
        prefix: copyBytes("logs/".bytes())!,
        tags: tags,
        hasSizeAbove: true,
        sizeAbove: 10,
        hasSizeBelow: false,
        sizeBelow: 0,
        expirationDays: 30,
        expirationDate: 0,
        abortDays: 7,
        legacyPrefix: false,
        expiredDeleteMarker: false,
        noncurrentDays: 0,
        newerNoncurrent: 0,
    };
    var rules = Vector<LifecycleRule>.create();
    rules.push(rule)!;
    var blob = Vector<u8>.create();
    encodeLifecycle(rules.view(), mut blob)!;
    let back = decodeLifecycle(blob.view())!;
    Check.equalU64(1, back.length as u64)?;
    let r = borrow back[0];
    Check.equalBytes("logs/".bytes(), r.prefix.view())?;
    Check.equalU64(7, r.abortDays as u64)?;
    for (n in 0..blob.length) {
        Check.isTrue(decodeLifecycle(blob.view()[0..n]).isErr() || n == 0, "a truncated blob")?;
    }
    Check.isTrue(ruleMatches(r, "logs/a".bytes(), 11, "a=1&team=blue".bytes()), "prefix, size and tag")?;
    Check.isTrue(!ruleMatches(r, "data/a".bytes(), 11, "team=blue".bytes()), "another prefix")?;
    Check.isTrue(!ruleMatches(r, "logs/a".bytes(), 10, "team=blue".bytes()), "not above the floor")?;
    Check.isTrue(!ruleMatches(r, "logs/a".bytes(), 11, "team=bluegreen".bytes()), "a tag must match whole")?;
    Check.isTrue(!ruleMatches(r, "logs/a".bytes(), 11, "".bytes()), "no tags")?;
    // 2026-11-09T15:00Z plus 30 days is 2026-12-09T15:00Z: expired from midnight on 2026-12-10.
    let made: i64 = 1794236400000;
    Check.isTrue(expiresAt(r, made)! == 1796860800000, "the next midnight UTC after 30 days")?;
    return Ok();
}
