// Extent pins (ADR-0007): readers count up the version whose extents they may still open, and the store does not
// unlink a retired extent while its version's count is above zero.
//
// A reader may be dropped anywhere, including in async code, which must not block (type-system.md §40.1). So a pin
// is an atomic count shared through an `Arc`, and its drop only counts down: no lock, no I/O. Pins are only made
// by the store (in `openReader`), so once the store sees a count of zero no reader can raise it again.

/// The store's side: one count per pinned version, reachable from each of its extent ids.
struct ExtentPins {
    private counts: HashMap<u64, Arc<AtomicU64>>;

    fn create() -> ExtentPins => ExtentPins { counts: HashMap<u64, Arc<AtomicU64>>.create() };

    /// Pins the version made of `extents` (not empty) for one reader.
    fn pin(borrow mut this, extents: Slice<ExtentRef>) -> Result<ReadPin, AllocError> {
        if (this.counts.length() > PIN_PRUNE_ABOVE) { this.prune(); }
        match (this.counts.get(borrow extents[0].id)) {
            Some(c) => {
                c.get().fetchAdd(1);
                return Ok(ReadPin { count: c.clone() });
            }
            null => {}
        }
        let count = Arc<AtomicU64>.create(AtomicU64.create(0))?;
        for (i in 0..extents.length) {
            match (this.counts.put(extents[i].id, count.clone())) {
                Ok(_) => {}
                Err(e) => {
                    // Not every extent is reachable: take none, so no reap can see a partial pin.
                    for (k in 0..i) { let _ = this.counts.remove(borrow extents[k].id); }
                    return Err(e);
                }
            }
        }
        count.get().fetchAdd(1);
        return Ok(ReadPin { count: count });
    }

    /// Pins one id (a journal segment, ADR-0024) for one reader.
    fn pinOne(borrow mut this, id: u64) -> Result<ReadPin, AllocError> {
        if (this.counts.length() > PIN_PRUNE_ABOVE) { this.prune(); }
        match (this.counts.get(borrow id)) {
            Some(c) => {
                c.get().fetchAdd(1);
                return Ok(ReadPin { count: c.clone() });
            }
            null => {}
        }
        let count = Arc<AtomicU64>.create(AtomicU64.create(0))?;
        let _ = this.counts.put(id, count.clone())?;
        count.get().fetchAdd(1);
        return Ok(ReadPin { count: count });
    }

    /// Whether a reader may still open extent `id`.
    fn isPinned(borrow this, id: u64) -> bool => match (this.counts.get(borrow id)) {
        Some(c) => c.get().load() > 0,
        null => false,
    };

    /// Forgets the versions no reader holds.
    fn prune(borrow mut this) {
        var idle = Vector<u64>.create();
        for (i in 0..this.counts.length()) {
            if (this.counts.valueAt(i).get().load() == 0) {
                match (idle.push(this.counts.keyAt(i))) {
                    Ok() => {}
                    Err(_) => { break; }
                }
            }
        }
        for (id in idle.view()) { let _ = this.counts.remove(borrow id); }
    }

    /// The number of extents that open readers pin.
    fn pinnedCount(borrow this) -> usize {
        var n: usize = 0;
        for (i in 0..this.counts.length()) {
            if (this.counts.valueAt(i).get().load() > 0) { n += 1; }
        }
        return n;
    }
}

/// Above this many entries, `pin` first forgets the idle ones.
const PIN_PRUNE_ABOVE: usize = 4096;

/// One reader's pin; dropping it counts down. No lock and no I/O: the store unlinks what is left.
@noncopy
struct ReadPin {
    private count: Arc<AtomicU64>;

    drop {
        this.count.get().fetchSub(1);
    }
}

/// A retired extent that a reader still pins, and the bytes its file occupies.
struct DeferredExtent {
    id: u64;
    fileBytes: u64;
}
