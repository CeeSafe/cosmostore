// Stored fields (ADR-0012): user metadata and headers kept with a version, through PUT, multipart, the journal and
// checkpoints.

fn sampleMetadata() -> Vector<u8> {
    var m = Vector<u8>.create();
    metadataAdd(mut m, "x-amz-meta-mtime".bytes(), "1731000000.5".bytes())!;
    metadataAdd(mut m, "content-encoding".bytes(), "gzip".bytes())!;
    return m;
}

fn checkSample(blob: Slice<u8>) -> Result<void, TestFailure> {
    let pairs = metadataPairs(blob)!;
    Check.equalU64(2, pairs.length as u64)?;
    Check.equalBytes("x-amz-meta-mtime".bytes(), pairs[0].name.view())?;
    Check.equalBytes("1731000000.5".bytes(), pairs[0].value.view())?;
    Check.equalBytes("gzip".bytes(), pairs[1].value.view())?;
    return Ok();
}

@test
fn metadataSurvivesReplayAndCheckpoints() -> Result<void, TestFailure> {
    let dir = scratchDirectory("metadata");
    let meta = sampleMetadata();
    var upload = [0u8; 16];
    {
        var s = ObjectStore.open(dir.view(), uploadConfig())!;
        s.createBucket("bkt")!;
        for (k in ["small", "large"]) {
            var w = s.newWriter()!;
            w.write(patterned(if (k == "small") 100 else 100000, 3).view())!;
            let obj = w.finish()!;
            let _ = s.putFinishedWith("bkt", k, "text/plain", meta.view(), "".bytes(), borrow obj, PutCondition.None)!;
        }
        checkSample(s.headObject("bkt", "small")!.metadata.view())?;
        putText(mut s, "bkt", "plain", "no metadata");
        Check.equalU64(0, s.headObject("bkt", "plain")!.metadata.length as u64)?;
        upload = s.createUploadWith(
            "bkt",
            "multi",
            "a/b",
            meta.view(),
            ChecksumAlgorithm.None,
            ChecksumType.FullObject,
        )!;
        // Too much is refused, and its extents removed.
        var huge = Vector<u8>.create();
        for (i in 0..17) { metadataAdd(mut huge, "x-amz-meta-big".bytes(), patterned(1000, 1).view())!; }
        var w = s.newWriter()!;
        w.write(patterned(100000, 4).view())!;
        let obj = w.finish()!;
        let files = extentFiles(dir.view());
        match (s.putFinishedWith("bkt", "huge", "", huge.view(), "".bytes(), borrow obj, PutCondition.None)) {
            Err(StoreError.MetadataTooLarge) => {}
            _ => { return Check.fail("metadata over the limit"); }
        }
        Check.equalU64(files - 2, extentFiles(dir.view()))?;
    }
    for (round in 0..3) {
        var s = ObjectStore.open(dir.view(), uploadConfig())!;
        checkSample(s.headObject("bkt", "small")!.metadata.view())?;
        checkSample(s.headObject("bkt", "large")!.metadata.view())?;
        Check.equalU64(0, s.headObject("bkt", "plain")!.metadata.length as u64)?;
        if (round == 0) { let _ = s.checkpoint()!; } // the upload, with its metadata, in a checkpoint
        if (round == 1) {
            let m1 = sendPart(mut s, "bkt", "multi", upload, 1, patterned(10, 5).view())!;
            let chosen = [choice(1, m1)];
            let _ = s.completeUpload("bkt", "multi", upload, chosen[..])!;
            let _ = s.checkpoint()!;
        }
        if (round == 2) {
            let info = s.headObject("bkt", "multi")!;
            checkSample(info.metadata.view())?;
            Check.equalText("a/b", StringView.fromUtf8(info.contentType.view())!)?;
        }
    }
    removeTree(dir.view());
    return Ok();
}

fn tagsOf(s: borrow ObjectStore, key: StringView) -> Vector<u8> =>
    metadataValue(s.headObject("bkt", key)!.metadata.view(), TAGS_FIELD.bytes())!;

@test
fn tagsChangeInPlace() -> Result<void, TestFailure> {
    let dir = scratchDirectory("tags");
    var generation: u64 = 0;
    {
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        s.createBucket("bkt")!;
        var meta = Vector<u8>.create();
        metadataAdd(mut meta, "x-amz-meta-a".bytes(), "1".bytes())!;
        metadataAdd(mut meta, TAGS_FIELD.bytes(), "team=blue".bytes())!;
        var w = s.newWriter()!;
        w.write("tagged".bytes())!;
        let obj = w.finish()!;
        generation = s.putFinishedWith(
            "bkt",
            "k",
            "",
            meta.view(),
            "".bytes(),
            borrow obj,
            PutCondition.None,
        )!.generation;
        Check.equalBytes("team=blue".bytes(), tagsOf(borrow s, "k").view())?;
        // New tags keep the version: its generation, ETag and other fields.
        s.setTags("bkt", "k", "team=red&tier=gold".bytes())!;
        let info = s.headObject("bkt", "k")!;
        Check.equalU64(generation, info.generation)?;
        Check.equalBytes("1".bytes(), metadataValue(info.metadata.view(), "x-amz-meta-a".bytes())!.view())?;
        Check.equalBytes("team=red&tier=gold".bytes(), tagsOf(borrow s, "k").view())?;
        match (s.setTags("bkt", "missing", "a=b".bytes())) {
            Err(StoreError.NoSuchKey) => {}
            _ => { return Check.fail("tags on a missing key"); }
        }
        putText(mut s, "bkt", "plain", "x");
        s.setTags("bkt", "plain", "x=y".bytes())!;
        s.setTags("bkt", "plain", "".bytes())!; // DeleteObjectTagging
        Check.equalU64(0, tagsOf(borrow s, "plain").length as u64)?;
    }
    // From the journal; then a checkpoint; then an overwrite, which brings its own (no) tags.
    for (round in 0..3) {
        var s = ObjectStore.open(dir.view(), storeConfig())!;
        if (round < 2) {
            Check.equalBytes("team=red&tier=gold".bytes(), tagsOf(borrow s, "k").view())?;
            Check.equalU64(0, tagsOf(borrow s, "plain").length as u64)?;
        } else {
            Check.equalU64(0, tagsOf(borrow s, "k").length as u64)?;
        }
        if (round == 0) { let _ = s.checkpoint()!; }
        if (round == 1) { putText(mut s, "bkt", "k", "overwritten"); }
    }
    removeTree(dir.view());
    return Ok();
}
